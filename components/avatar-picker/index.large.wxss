/* 自动生成，请勿手改：index.wxss 在平板、电脑大屏（窗口宽 ≥ 450px）下的样式。
   rpx 按 1rpx = 0.6px 换算，固定定位元素收进居中栏；改完源文件后运行 node scripts/build-large-screen-styles.mjs */
@media (min-width: 450px) {
.ap-layer{top:0;right:max(0px, 50% - var(--lg-col) / 2);bottom:0;left:max(0px, 50% - var(--lg-col) / 2);box-shadow:0 0 0 100vmax rgba(20, 28, 24, .42)}
.ap-sheet{right:0;bottom:0;left:0;padding:18px 21px 0;border-radius:24px 24px 0 0}
.ap-title{font-size:20px;font-weight:700;line-height:1.3}
.ap-close{width:33px;height:33px;border-radius:50%}
.ap-close::before, .ap-close::after{top:50%;left:50%;width:14px;height:1px;border-radius:1px}
.ap-subtitle{margin-top:4px;font-size:13px;line-height:1.4}
.ap-grid{margin:14px -6px 0}
.ap-item{width:25%;padding:6px;box-sizing:border-box}
.ap-photo{width:76px;height:76px;box-sizing:border-box;border:2px solid transparent;border-radius:50%}
.ap-item.is-picked .ap-photo{border-color:#FD7C02}
.ap-image{width:100%;height:100%;border-radius:50%}
.ap-label{margin-top:4px;font-size:12px;line-height:1.3}
.ap-item.is-picked .ap-label{font-weight:600}
.ap-empty{padding:28px 0;font-size:14px}
.ap-wechat{margin:14px 0 0;padding:0;border-radius:599px;font-size:16px;font-weight:600;line-height:52px}
.ap-wechat::after{border:0}
.ap-safe{height:calc(16px + env(safe-area-inset-bottom))}
}
