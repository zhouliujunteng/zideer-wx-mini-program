/* 自动生成，请勿手改：index.wxss 在平板、电脑大屏（窗口宽 ≥ 450px）下的样式。
   rpx 按 1rpx = 0.6px 换算，固定定位元素收进居中栏；改完源文件后运行 node scripts/build-large-screen-styles.mjs */
@media (min-width: 450px) {
.mc-layer{top:0;right:max(0px, 50% - var(--lg-col) / 2);bottom:0;left:max(0px, 50% - var(--lg-col) / 2);padding:0 33px;box-sizing:border-box;box-shadow:0 0 0 100vmax rgba(20, 28, 24, .48)}
.mc-card{width:100%;max-width:372px;padding:28px 24px 16px;box-sizing:border-box;border-radius:24px;box-shadow:0 14px 36px rgba(20, 28, 24, .18)}
.mc-close{top:14px;right:14px;width:31px;height:31px;border-radius:50%}
.mc-close::before, .mc-close::after{top:50%;left:50%;width:15px;height:1px;border-radius:1px}
.mc-kicker{padding:3px 10px;border-radius:599px;font-size:12px;font-weight:600;line-height:1.4}
.mc-title{margin-top:10px;font-size:21px;font-weight:700;line-height:1.35}
.mc-copy{margin-top:8px;font-size:15px;line-height:1.6}
.mc-qr{width:240px;height:240px;margin:18px auto 0;padding:9px;box-sizing:border-box;border:1px solid #EEF0ED;border-radius:16px}
.mc-qr-image{width:100%;height:100%}
.mc-hint{margin-top:10px;font-size:13px;font-weight:600;line-height:1.5}
.mc-later{margin-top:12px;padding:10px 0;font-size:15px;line-height:1.4}
}
