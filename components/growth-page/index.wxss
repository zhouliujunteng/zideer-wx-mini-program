.growth-page { min-height: 100vh; padding: 48rpx 28rpx calc(env(safe-area-inset-bottom) + 48rpx); background: var(--canvas); }
.growth-skeleton { height: 620rpx; }
.growth-head { margin-bottom: 32rpx; }.growth-eyebrow,.growth-hero__label,.growth-row__meta { display:block; color:var(--muted); font-size:23rpx; }.growth-title { display:block; margin-top:8rpx; font-size:42rpx; font-weight:700; line-height:1.2; }
.growth-hero { padding:30rpx; }.growth-hero__value { display:block; margin-top:14rpx; font-size:46rpx; font-weight:700; }.growth-hero__copy,.growth-empty__copy { display:block; margin-top:12rpx; color:var(--ink-soft); font-size:24rpx; line-height:1.55; }.growth-facts { display:flex; gap:18rpx; margin-top:22rpx; color:var(--muted); font-size:23rpx; flex-wrap:wrap; }
.growth-primary,.growth-outline { display:flex; align-items:center; justify-content:center; min-height:78rpx; margin-top:24rpx; padding:0 26rpx; border-radius:39rpx; font-size:25rpx; font-weight:700; }.growth-primary { background:var(--accent); color:var(--surface); }.growth-outline { border:1rpx solid var(--line-strong); background:var(--surface); }
.growth-nav { margin-top:22rpx; overflow:hidden; }.growth-nav__row { display:flex; width:100%; min-height:96rpx; padding:0 26rpx; align-items:center; justify-content:space-between; border-bottom:1rpx solid var(--line); font-size:27rpx; text-align:left; }.growth-nav__row:last-child { border-bottom:0; }.growth-nav__row text { color:var(--muted); font-size:36rpx; }
.growth-section { margin-top:34rpx; }.growth-section__title { display:block; margin-bottom:16rpx; font-size:30rpx; font-weight:700; }.growth-empty { padding:28rpx; }.growth-empty__title { display:block; font-weight:700; }.growth-list { overflow:hidden; }.growth-row { display:flex; min-height:104rpx; padding:18rpx 24rpx; align-items:center; justify-content:space-between; border-bottom:1rpx solid var(--line); font-size:25rpx; gap:20rpx; }.growth-row:last-child { border-bottom:0; }.growth-row__meta { margin-top:6rpx; }
.growth-redemption-form { padding: 28rpx; }.growth-redemption-form__label { display: block; color: var(--ink-soft); font-size: 23rpx; font-weight: 700; }.growth-redemption-form__code-row { display: flex; gap: 16rpx; margin-top: 16rpx; align-items: center; }.growth-redemption-form__input { flex: 1; min-width: 0; box-sizing: border-box; height: 88rpx; padding: 0 20rpx; border: 1rpx solid var(--line-strong); border-radius: 8rpx; background: var(--surface); color: var(--ink); font-size: 30rpx; text-transform: uppercase; }.growth-redemption-form__scan { flex: 0 0 112rpx; height: 88rpx; padding: 0; border: 1rpx solid var(--line-strong); border-radius: 8rpx; background: var(--surface); color: var(--ink); font-size: 24rpx; }.growth-redemption-form__hint { display: block; margin-top: 16rpx; color: var(--muted); font-size: 22rpx; line-height: 1.6; }.growth-redemption-form .growth-primary { width: 100%; margin-top: 24rpx; }.growth-redemption-result { margin-top: 20rpx; padding: 28rpx; }.growth-redemption-result__title { display: block; color: var(--ink); font-size: 28rpx; font-weight: 700; }.growth-redemption-result__copy, .growth-redemption-result__record { display: block; margin-top: 10rpx; color: var(--muted); font-size: 23rpx; line-height: 1.55; }.growth-redemption-result__benefit { display: block; margin-top: 10rpx; color: var(--accent-deep); font-size: 24rpx; font-weight: 700; }
.growth-poster-form { padding: 28rpx; }.growth-poster-form__input { display:block; width:100%; min-height:170rpx; box-sizing:border-box; margin-top:16rpx; padding:20rpx; border:1rpx solid var(--line-strong); border-radius:8rpx; background:var(--surface); color:var(--ink); font-size:28rpx; line-height:1.5; }.growth-poster-form .growth-primary { width:100%; margin-top:24rpx; }.growth-poster-form__status,.growth-poster-result__meta { display:block; margin-top:16rpx; color:var(--muted); font-size:23rpx; line-height:1.55; }.growth-poster-result { margin-top:20rpx; padding:20rpx; }.growth-poster-result__image { display:block; width:100%; border-radius:8rpx; background:var(--canvas); }
