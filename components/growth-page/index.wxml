<view class="growth-page">
  <view class="growth-skeleton skeleton" wx:if="{{loading}}"></view>
  <view class="state-panel" wx:elif="{{failed}}"><view class="state-panel__mark">!</view><text class="state-panel__title">{{title}}暂时无法加载</text><text class="state-panel__copy">请检查网络和登录状态后重试。</text><button class="state-panel__action pressable" bindtap="loadPage">重新加载</button></view>
  <block wx:elif="{{center}}">
    <view class="growth-head"><text class="growth-eyebrow">知鹿成长</text><text class="growth-title">{{title}}</text></view>
    <block wx:if="{{isPartnerPage}}">
      <view class="growth-empty surface" wx:if="{{!center.promoter && mode !== 'application'}}"><text class="growth-empty__title">尚未开通推广伙伴</text><text class="growth-empty__copy">购买后由服务端自动开通。当前账户没有有效推广伙伴档案。</text><button class="growth-outline pressable" data-url="/agent/application/index" bindtap="navigate">查看资格</button></view>
      <block wx:else>
        <view class="growth-hero surface" wx:if="{{mode === 'application'}}"><text class="growth-hero__label">推广伙伴状态</text><text class="growth-hero__value">{{center.promoter ? (center.promoter.status === 'active' ? '已开通' : '暂不可用') : '未开通'}}</text><text class="growth-hero__copy">结算实名认证和税务协议完成前，可以分享推广内容，但不能发起现金提现。</text><button class="growth-primary pressable" data-url="/account/identity/index" bindtap="navigate">查看身份核验</button></view>
        <view class="growth-hero surface" wx:if="{{mode === 'dashboard' && center.promoter}}"><text class="growth-hero__label">{{center.promoter.display_name || '推广伙伴'}}</text><text class="growth-hero__value">{{center.rewards.length}} 笔奖励记录</text><text class="growth-hero__copy">锁定期、奖励用途和追偿均以服务端账本为准。</text></view>
        <view class="growth-nav surface" wx:if="{{mode === 'dashboard' && center.promoter}}"><button class="growth-nav__row pressable" data-url="/agent/clients/index" bindtap="navigate">直属用户<text>›</text></button><button class="growth-nav__row pressable" data-url="/agent/share-tools/index" bindtap="navigate">推广工具<text>›</text></button><button class="growth-nav__row pressable" data-url="/agent/deep-assessment-gift/index" bindtap="navigate">深测赠送<text>›</text></button><button class="growth-nav__row pressable" data-url="/growth/coin-withdrawal/index" bindtap="navigate">奖励与提现<text>›</text></button></view>
        <view class="growth-section" wx:if="{{mode === 'clients'}}"><text class="growth-section__title">客户隐私保护</text><view class="growth-empty surface" wx:if="{{!center.clients.length}}"><text class="growth-empty__title">暂无可展示的直属用户</text><text class="growth-empty__copy">此处仅展示服务端返回的脱敏归因摘要，不展示试卷、诊断、课程积分或教师记录。</text></view><view class="growth-list surface" wx:else><button class="growth-row pressable" wx:for="{{center.clients}}" wx:key="id" data-id="{{item.id}}" bindtap="openClient"><view><text>{{item.displayName}}</text><text class="growth-row__meta">{{item.source_type}} · {{item.status}}</text></view><text>{{item.stageLabel}} ›</text></button></view></view>
        <view class="growth-section" wx:if="{{mode === 'client-detail'}}"><text class="growth-section__title">直属用户详情</text><view class="growth-empty surface" wx:if="{{!selectedClient}}"><text class="growth-empty__title">未找到直属用户</text><text class="growth-empty__copy">请从直属用户列表进入。归因变化后会立即失去访问权限。</text><button class="growth-outline pressable" data-url="/agent/clients/index" bindtap="navigate">返回直属用户</button></view><view class="growth-empty surface" wx:else><text class="growth-empty__title">{{selectedClient.displayName}}</text><text class="growth-empty__copy">来源：{{selectedClient.source_type}}；当前仅提供粗粒度学习学段：{{selectedClient.stageLabel}}。</text><button class="growth-outline pressable" data-url="/agent/share-tools/index" bindtap="navigate">创建推广邀请</button></view></view>
        <view class="growth-section" wx:if="{{mode === 'share-tools'}}"><text class="growth-section__title">已生成邀请</text><view class="growth-empty surface" wx:if="{{!center.invitations.length}}">暂无有效邀请记录</view><view class="growth-list surface" wx:else><view class="growth-row" wx:for="{{center.invitations}}" wx:key="id"><view><text>{{item.invitation_code}}</text><text class="growth-row__meta">{{item.scene_type}} · {{item.status}}</text></view><text>{{item.timeLabel}}</text></view></view><button class="growth-outline pressable" loading="{{creatingInvitation}}" disabled="{{creatingInvitation}}" bindtap="createInvitation">生成推广链接</button><view class="growth-redemption-result surface" wx:if="{{invitationResult}}"><text class="growth-redemption-result__title">邀请已创建</text><text class="growth-redemption-result__copy">邀请路径已复制，可用于小程序卡片或二维码配置。</text><text class="growth-redemption-result__record">邀请码：{{invitationResult.invitation.code}}</text></view></view>
        <view class="growth-section" wx:if="{{mode === 'ai-poster'}}"><text class="growth-section__title">海报背景生成</text><view class="growth-poster-form surface"><text class="growth-redemption-form__label">海报主题</text><textarea class="growth-poster-form__input" value="{{posterTheme}}" maxlength="160" placeholder="例如：初中数学学习规划" bindinput="updatePosterTheme" /><button class="growth-primary pressable" loading="{{generatingPoster}}" disabled="{{generatingPoster}}" bindtap="generatePoster">生成背景图</button><text class="growth-poster-form__status" wx:if="{{posterStatus}}">{{posterStatus}}</text></view><view class="growth-poster-result surface" wx:if="{{posterResult}}"><image class="growth-poster-result__image" src="{{posterResult.imageUrl}}" mode="widthFix" /><text class="growth-poster-result__meta">背景图已由 Zion 私有素材服务返回。</text></view></view>
        <view class="growth-section" wx:if="{{mode === 'material-library'}}">
          <text class="growth-section__title">宣传素材</text>
          <view class="growth-empty surface" wx:if="{{materialLoading}}"><text class="growth-empty__copy">正在读取已发布素材...</text></view>
          <view class="growth-empty surface" wx:elif="{{materialFailed}}"><text class="growth-empty__title">素材暂时无法读取</text><button class="growth-outline pressable" bindtap="loadPage">重新加载</button></view>
          <view class="growth-empty surface" wx:elif="{{materialStatus === 'promoter_inactive'}}"><text class="growth-empty__title">尚未开通推广伙伴</text><text class="growth-empty__copy">开通后可查看平台为你发布的宣传素材。</text></view>
          <view class="growth-empty surface" wx:elif="{{!materialAssets.length}}"><text class="growth-empty__title">暂无已发布素材</text><text class="growth-empty__copy">平台发布后会自动显示在这里。</text></view>
          <view class="growth-list surface" wx:else>
            <view class="growth-material" wx:for="{{materialAssets}}" wx:key="id">
              <image wx:if="{{item.coverImage}}" class="growth-poster-result__image pressable" src="{{item.coverImage.url}}" mode="widthFix" data-url="{{item.coverImage.url}}" bindtap="previewMaterialImage" />
              <text class="growth-material__title">{{item.title}}</text>
              <text class="growth-row__meta" wx:if="{{item.campaignKey}}">{{item.campaignKey}}</text>
              <text class="growth-material__copy" wx:if="{{item.copyText}}">{{item.copyText}}</text>
              <button class="growth-outline pressable" wx:if="{{item.copyText}}" data-text="{{item.copyText}}" bindtap="copyMaterialText">复制文案</button>
            </view>
          </view>
        </view>
        <view class="growth-section" wx:if="{{mode === 'deep-assessment-gift'}}"><text class="growth-section__title">深测赠送</text><view class="growth-empty surface" wx:if="{{!center.clients.length}}"><text class="growth-empty__title">暂无可赠送的直属用户</text><text class="growth-empty__copy">仅展示当前仍有效归因的脱敏用户。资格、接收条件和全平台唯一性均由服务端确认。</text></view><block wx:else><view class="growth-list surface"><button class="growth-row pressable" wx:for="{{center.clients}}" wx:key="id" data-id="{{item.id}}" bindtap="selectGiftClient"><view><text>{{item.displayName}}</text><text class="growth-row__meta">{{item.source_type}} · {{item.stageLabel}}</text></view><text>{{giftingAttributionId == item.id ? '已选择' : '选择'}}</text></button></view><button class="growth-primary pressable" loading="{{gifting}}" disabled="{{gifting}}" bindtap="submitDeepAssessmentGift">确认赠送深测</button><text class="growth-gift-result" wx:if="{{giftResult}}">{{giftResult}}</text></block></view>
      </block>
    </block>
    <block wx:if="{{isCoinPage}}">
      <view class="growth-hero surface" wx:if="{{mode === 'coins'}}"><text class="growth-hero__label">{{center.student.nickname || '当前学生'}}的可用金币</text><text class="growth-hero__value">{{center.coinAccount.available}}</text><view class="growth-facts"><text>冻结 {{center.coinAccount.frozen}}</text><text>已提现 {{center.coinAccount.withdrawn}}</text><text>已过期 {{center.coinAccount.expired}}</text></view></view>
      <view class="growth-nav surface" wx:if="{{mode === 'coins'}}"><button class="growth-nav__row pressable" data-url="/growth/coin-tasks/index" bindtap="navigate">金币任务<text>›</text></button><button class="growth-nav__row pressable" data-url="/growth/coin-withdrawal/index" bindtap="navigate">提现记录<text>›</text></button><button class="growth-nav__row pressable" data-url="/growth/redemption/index" bindtap="navigate">兑换码<text>›</text></button></view>
      <view class="growth-section" wx:if="{{mode === 'coins'}}"><text class="growth-section__title">金币流水</text><view class="growth-empty surface" wx:if="{{!center.coinLedger.length}}">暂无金币流水</view><view class="growth-list surface" wx:else><view class="growth-row" wx:for="{{center.coinLedger}}" wx:key="id"><view><text>{{item.business_type || item.entry_type}}</text><text class="growth-row__meta">{{item.timeLabel}}</text></view><text>{{item.coins > 0 ? '+' : ''}}{{item.coins}}</text></view></view></view>
      <view class="growth-section" wx:if="{{mode === 'coin-tasks'}}"><text class="growth-section__title">金币任务</text><view class="growth-empty surface"><text class="growth-empty__title">每日签到</text><text class="growth-empty__copy">奖励金额、有效期和每日限制均以服务端当前发布规则为准。</text><button class="growth-primary pressable" loading="{{checkingIn}}" disabled="{{checkingIn}}" bindtap="claimDailyCheckin">{{checkingIn ? '正在签到' : '立即签到'}}</button><text class="growth-row__meta" wx:if="{{checkinResult}}">{{checkinResult.status === 'checked_in' ? ('已获得 ' + checkinResult.rewardCoins + ' 金币') : '今天已完成签到'}}，可用 {{checkinResult.availableCoins}} 金币</text></view><view class="growth-empty surface"><text class="growth-empty__title">学习奖励</text><text class="growth-empty__copy">知识点奖励仅在老师最终核验通过后由服务端自动发放，客户端不能自行领取或重复奖励。</text></view></view>
      <view class="growth-section" wx:if="{{mode === 'coin-withdrawal'}}"><text class="growth-section__title">提现申请</text><view class="growth-empty surface" wx:if="{{!center.withdrawals.length}}">暂无提现申请</view><view class="growth-list surface" wx:else><view class="growth-row" wx:for="{{center.withdrawals}}" wx:key="id"><view><text>{{item.request_no}}</text><text class="growth-row__meta">{{item.status}} · {{item.timeLabel}}</text></view><text>{{item.requested_coins}} 金币</text></view></view><button class="growth-outline pressable" bindtap="unavailable">申请提现</button></view>
      <view class="growth-section" wx:if="{{mode === 'redemption'}}">
        <text class="growth-section__title">兑换权益</text>
        <view class="growth-redemption-form surface">
          <text class="growth-redemption-form__label">兑换码</text>
          <view class="growth-redemption-form__code-row"><input class="growth-redemption-form__input" value="{{redemptionCode}}" maxlength="128" placeholder="输入兑换码" bindinput="updateRedemptionCode" /><button class="growth-redemption-form__scan pressable" bindtap="scanRedemptionCode">扫码</button></view>
          <text class="growth-redemption-form__hint">课程积分、金币和体验权益均由服务端校验并发放。</text>
          <button class="growth-primary pressable" loading="{{redeeming}}" disabled="{{redeeming}}" bindtap="submitRedemption">确认兑换</button>
        </view>
        <view class="growth-redemption-result surface" wx:if="{{redemptionResult}}">
          <text class="growth-redemption-result__title">兑换已提交</text>
          <text class="growth-redemption-result__copy">{{redemptionResult.message}}</text>
          <text class="growth-redemption-result__benefit" wx:for="{{redemptionResult.benefits}}" wx:key="*this">{{item}}</text>
          <text class="growth-redemption-result__record" wx:if="{{redemptionResult.recordNo}}">记录号：{{redemptionResult.recordNo}}</text>
        </view>
        <text class="growth-section__title">兑换记录</text>
        <view class="growth-empty surface" wx:if="{{!center.redemptionRecords.length}}">暂无兑换记录</view>
        <view class="growth-list surface" wx:else><view class="growth-row" wx:for="{{center.redemptionRecords}}" wx:key="id"><view><text>{{item.record_no}}</text><text class="growth-row__meta">{{item.status}} · {{item.timeLabel}}</text></view></view></view>
      </view>
    </block>
  </block>
</view>
