<wxs module="UA" src="../../utils/ui-asset.wxs" />
<!-- 首次读取失败：给出原因和重试，不显示空状态 -->
<template name="growth-failed">
  <view class="state-panel"><view class="state-panel__mark">!</view><text class="state-panel__title">{{title}}暂时无法加载</text><text class="state-panel__copy">请检查网络和登录状态后重试。</text><button class="state-panel__action pressable" bindtap="loadPage">重新加载</button></view>
</template>
<view class="growth-page">
  <view class="growth-head"><text class="growth-eyebrow">知鹿成长</text><text class="growth-title">{{title}}</text></view>
  <block wx:if="{{isPartnerPage}}">
    <block wx:if="{{failed}}"><template is="growth-failed" data="{{title: title}}" /></block>
    <block wx:elif="{{!loaded}}">
      <view class="growth-hero surface" wx:if="{{mode === 'application' || mode === 'dashboard'}}"><view class="sk sk-line sk-short"></view><view class="sk growth-sk-value"></view><view class="sk sk-line growth-sk-copy"></view><view class="sk sk-line sk-mid"></view><view class="sk growth-sk-button" wx:if="{{mode === 'application'}}"></view></view>
      <view class="growth-nav surface" wx:if="{{mode === 'dashboard'}}"><view class="growth-sk-row" wx:for="{{[0, 1, 2]}}" wx:key="*this"><view class="sk sk-line sk-short"></view></view></view>
      <view class="growth-section" wx:if="{{mode === 'clients'}}"><view class="sk growth-sk-title"></view><view class="growth-list surface"><view class="growth-row" wx:for="{{[0, 1, 2]}}" wx:key="*this"><view class="growth-sk-row-copy"><view class="sk sk-line sk-short"></view><view class="sk sk-line sk-mid"></view></view><view class="sk growth-sk-tail"></view></view></view></view>
      <view class="growth-section" wx:if="{{mode === 'client-detail'}}"><view class="sk growth-sk-title"></view><view class="growth-empty surface"><view class="sk sk-line sk-short"></view><view class="sk sk-line growth-sk-copy"></view><view class="sk sk-line sk-mid"></view><view class="sk growth-sk-button"></view></view></view>
      <view class="growth-section" wx:if="{{mode === 'ai-poster'}}"><view class="sk growth-sk-title"></view><view class="growth-poster-form surface"><view class="sk sk-line sk-short"></view><view class="sk growth-sk-textarea"></view><view class="sk growth-sk-button"></view></view></view>
      <view class="growth-section" wx:if="{{mode === 'material-library'}}"><view class="sk growth-sk-title"></view><view class="growth-list surface"><view class="growth-sk-material" wx:for="{{[0, 1]}}" wx:key="*this"><view class="sk growth-sk-poster"></view><view class="sk sk-line sk-mid growth-sk-material-title"></view><view class="sk sk-line"></view><view class="sk sk-line sk-short"></view></view></view></view>
    </block>
    <view class="growth-empty surface" wx:elif="{{!center.promoter && mode !== 'application'}}"><text class="growth-empty__title">尚未开通推广伙伴</text><text class="growth-empty__copy">购买后由服务端自动开通。当前账户没有有效推广伙伴档案。</text><button class="growth-outline pressable" data-url="/agent/application/index" bindtap="navigate">查看资格</button></view>
    <block wx:else>
      <view class="growth-hero surface" wx:if="{{mode === 'application'}}"><text class="growth-hero__label">推广伙伴状态</text><text class="growth-hero__value">{{center.promoter ? (center.promoter.status === 'active' ? '已开通' : '暂不可用') : '未开通'}}</text><text class="growth-hero__copy">{{center.promoter && center.promoter.status === 'active' ? '推广奖励可以在结算中心提现或兑换课程积分。' : '申请成为推广伙伴：核验身份证后提交，平台审核开通。开通前也可以分享推广内容。'}}</text><button wx:if="{{center.promoter && center.promoter.status === 'active'}}" class="growth-primary pressable" data-url="/agent/settlement/index" bindtap="navigate">去结算中心</button><button wx:else class="growth-primary pressable" data-url="/agent/partner-apply/index" bindtap="navigate">申请成为推广伙伴</button></view>
      <view class="growth-hero surface" wx:if="{{mode === 'dashboard' && center.promoter}}"><text class="growth-hero__label">{{center.promoter.display_name || '推广伙伴'}}</text><text class="growth-hero__value">{{center.rewards.length}} 笔奖励记录</text><text class="growth-hero__copy">锁定期、奖励用途和追偿均以服务端账本为准。</text></view>
      <view class="growth-nav surface" wx:if="{{mode === 'dashboard' && center.promoter}}"><button class="growth-nav__row pressable" data-url="/agent/clients/index" bindtap="navigate">直属用户<text>›</text></button><button class="growth-nav__row pressable" data-url="/agent/share-link/index" bindtap="navigate">小程序链接<text>›</text></button><button class="growth-nav__row pressable" data-url="/growth/coin-withdrawal/index" bindtap="navigate">奖励与提现<text>›</text></button></view>
      <view class="growth-section" wx:if="{{mode === 'clients'}}"><text class="growth-section__title">客户隐私保护</text><view class="growth-empty surface" wx:if="{{!center.clients.length}}"><text class="growth-empty__title">暂无可展示的直属用户</text><text class="growth-empty__copy">此处仅展示服务端返回的脱敏归因摘要，不展示试卷、诊断、课程积分或教师记录。</text></view><view class="growth-list surface" wx:else><button class="growth-row pressable" wx:for="{{center.clients}}" wx:key="id" data-id="{{item.id}}" bindtap="openClient"><view><text>{{item.displayName}}</text><text class="growth-row__meta">{{item.sourceLabel}} · {{item.statusLabel}}</text></view><text>{{item.stageLabel}} ›</text></button></view></view>
      <view class="growth-section" wx:if="{{mode === 'client-detail'}}"><text class="growth-section__title">直属用户详情</text><view class="growth-empty surface" wx:if="{{!selectedClient}}"><text class="growth-empty__title">未找到直属用户</text><text class="growth-empty__copy">请从直属用户列表进入。归因变化后会立即失去访问权限。</text><button class="growth-outline pressable" data-url="/agent/clients/index" bindtap="navigate">返回直属用户</button></view><view class="growth-empty surface" wx:else><text class="growth-empty__title">{{selectedClient.displayName}}</text><text class="growth-empty__copy">来源：{{selectedClient.sourceLabel}}；当前仅提供粗粒度学习学段：{{selectedClient.stageLabel}}。</text><button class="growth-outline pressable" data-url="/agent/share-link/index" bindtap="navigate">小程序链接</button></view></view>
      <view class="growth-section" wx:if="{{mode === 'ai-poster'}}"><text class="growth-section__title">海报背景生成</text><view class="growth-poster-form surface"><text class="growth-redemption-form__label">海报主题</text><textarea class="growth-poster-form__input" value="{{posterTheme}}" maxlength="160" placeholder="例如：初中数学学习规划" bindinput="updatePosterTheme" /><button class="growth-primary pressable" loading="{{generatingPoster}}" disabled="{{generatingPoster}}" bindtap="generatePoster">生成背景图</button><text class="growth-poster-form__status" wx:if="{{posterStatus}}">{{posterStatus}}</text></view><view class="growth-poster-result surface" wx:if="{{posterResult}}"><image class="growth-poster-result__image" src="{{UA.src(ui, posterResult.imageUrl)}}" mode="widthFix" /><text class="growth-poster-result__meta">海报背景已生成。</text></view></view>
      <view class="growth-section" wx:if="{{mode === 'material-library'}}">
        <text class="growth-section__title">宣传素材</text>
        <view class="growth-empty surface" wx:if="{{materialStatus === 'promoter_inactive'}}"><text class="growth-empty__title">尚未开通推广伙伴</text><text class="growth-empty__copy">开通后可查看平台为你发布的宣传素材。</text></view>
        <view class="growth-empty surface" wx:elif="{{!materialAssets.length}}"><text class="growth-empty__title">暂无已发布素材</text><text class="growth-empty__copy">平台发布后会自动显示在这里。</text></view>
        <view class="growth-list surface" wx:else>
          <view class="growth-material" wx:for="{{materialAssets}}" wx:key="id">
            <image wx:if="{{item.coverImage}}" class="growth-poster-result__image pressable" src="{{UA.src(ui, item.coverImage.url)}}" mode="widthFix" data-url="{{item.coverImage.url}}" bindtap="previewMaterialImage" />
            <text class="growth-material__title">{{item.title}}</text>
            <text class="growth-row__meta" wx:if="{{item.campaignKey}}">{{item.campaignKey}}</text>
            <text class="growth-material__copy" wx:if="{{item.copyText}}">{{item.copyText}}</text>
            <button class="growth-outline pressable" wx:if="{{item.copyText}}" data-text="{{item.copyText}}" bindtap="copyMaterialText">复制文案</button>
          </view>
        </view>
      </view>
    </block>
  </block>
  <block wx:if="{{isCoinPage}}">
    <block wx:if="{{failed && mode !== 'coin-tasks' && mode !== 'redemption'}}"><template is="growth-failed" data="{{title: title}}" /></block>
    <view class="growth-hero surface" wx:elif="{{mode === 'coins' && !loaded}}"><view class="sk sk-line sk-mid"></view><view class="sk growth-sk-value"></view><view class="sk sk-line growth-sk-copy"></view></view>
    <view class="growth-hero surface" wx:elif="{{mode === 'coins'}}"><text class="growth-hero__label">{{center.student.nickname || '当前学生'}}的可用金币</text><text class="growth-hero__value">{{center.coinAccount.available}}</text><view class="growth-facts"><text>冻结 {{center.coinAccount.frozen}}</text><text>已提现 {{center.coinAccount.withdrawn}}</text><text>已过期 {{center.coinAccount.expired}}</text></view></view>
    <view class="growth-nav surface" wx:if="{{mode === 'coins'}}"><button class="growth-nav__row pressable" data-url="/growth/coin-tasks/index" bindtap="navigate">金币任务<text>›</text></button><button class="growth-nav__row pressable" data-url="/growth/coin-withdrawal/index" bindtap="navigate">提现记录<text>›</text></button><button class="growth-nav__row pressable" data-url="/pages/redemption/index" bindtap="navigate">兑换码<text>›</text></button></view>
    <view class="growth-section" wx:if="{{mode === 'coins' && !failed}}"><text class="growth-section__title">金币流水</text><view class="growth-list surface" wx:if="{{!loaded}}"><view class="growth-row" wx:for="{{[0, 1, 2]}}" wx:key="*this"><view class="growth-sk-row-copy"><view class="sk sk-line sk-mid"></view><view class="sk sk-line sk-short"></view></view><view class="sk growth-sk-tail"></view></view></view><view class="growth-empty surface" wx:elif="{{!center.coinLedger.length}}">暂无金币流水</view><view class="growth-list surface" wx:else><view class="growth-row" wx:for="{{center.coinLedger}}" wx:key="id"><view><text>{{item.businessLabel}}</text><text class="growth-row__meta">{{item.timeLabel}}</text></view><text>{{item.coins > 0 ? '+' : ''}}{{item.coins}}</text></view></view></view>
    <view class="growth-section" wx:if="{{mode === 'coin-tasks'}}"><text class="growth-section__title">金币任务</text><view class="growth-empty surface"><text class="growth-empty__title">每日签到</text><text class="growth-empty__copy">奖励金额、有效期和每日限制均以服务端当前发布规则为准。</text><button class="growth-primary pressable" loading="{{checkingIn}}" disabled="{{checkingIn}}" bindtap="claimDailyCheckin">{{checkingIn ? '正在签到' : '立即签到'}}</button><text class="growth-row__meta" wx:if="{{checkinResult}}">{{checkinResult.status === 'checked_in' ? ('已获得 ' + checkinResult.rewardCoins + ' 金币') : '今天已完成签到'}}，可用 {{checkinResult.availableCoins}} 金币</text></view><view class="growth-empty surface"><text class="growth-empty__title">学习奖励</text><text class="growth-empty__copy">知识点奖励仅在老师最终核验通过后由服务端自动发放，客户端不能自行领取或重复奖励。</text></view></view>
    <view class="growth-section" wx:if="{{mode === 'coin-withdrawal'}}"><text class="growth-section__title">金币兑换现金</text><block wx:if="{{failed}}"><template is="growth-failed" data="{{title: title}}" /></block><view class="growth-list surface" wx:elif="{{!loaded}}"><view class="growth-row" wx:for="{{[0, 1, 2]}}" wx:key="*this"><view class="growth-sk-row-copy"><view class="sk sk-line sk-mid"></view><view class="sk sk-line sk-short"></view></view><view class="sk growth-sk-tail"></view></view></view><view class="growth-empty surface" wx:elif="{{!center.withdrawals.length}}">暂无兑换申请</view><view class="growth-list surface" wx:else><view class="growth-row" wx:for="{{center.withdrawals}}" wx:key="id"><view><text>兑换现金 {{item.amountLabel}}</text><text class="growth-row__meta">{{item.statusLabel}} · {{item.timeLabel}}</text></view><text>{{item.requested_coins}} 金币</text></view></view><text class="growth-row__meta" wx:if="{{loaded && !failed}}">待确认收款的兑换请回到「我的金币」点「去确认收款」；未到账或取消的兑换，金币会自动退回。</text></view>
    <view class="growth-section" wx:if="{{mode === 'redemption'}}">
      <text class="growth-section__title">兑换权益</text>
      <view class="growth-redemption-form surface">
        <text class="growth-redemption-form__label">兑换码</text>
        <view class="growth-redemption-form__code-row"><input class="growth-redemption-form__input" value="{{redemptionCode}}" maxlength="128" placeholder="输入兑换码" bindinput="updateRedemptionCode" /><button class="growth-redemption-form__scan pressable" bindtap="scanRedemptionCode">扫码</button></view>
        <text class="growth-redemption-form__hint">课程积分、金币和体验权益均由服务端校验并发放。</text>
        <button class="growth-primary pressable" loading="{{redeeming}}" disabled="{{redeeming}}" bindtap="submitRedemption">确认兑换</button>
      </view>
      <view class="growth-redemption-result surface" wx:if="{{redemptionResult}}">
        <text class="growth-redemption-result__title">{{redemptionResult.title || '兑换已提交'}}</text>
        <text class="growth-redemption-result__copy">{{redemptionResult.message}}</text>
        <text class="growth-redemption-result__benefit" wx:for="{{redemptionResult.benefits}}" wx:key="*this">{{item}}</text>
        <text class="growth-redemption-result__record" wx:if="{{redemptionResult.recordNo}}">记录号：{{redemptionResult.recordNo}}</text>
      </view>
      <text class="growth-section__title">兑换记录</text>
      <block wx:if="{{failed}}"><template is="growth-failed" data="{{title: title}}" /></block>
      <view class="growth-list surface" wx:elif="{{!loaded}}"><view class="growth-row" wx:for="{{[0, 1, 2]}}" wx:key="*this"><view class="growth-sk-row-copy"><view class="sk sk-line sk-mid"></view><view class="sk sk-line sk-short"></view></view></view></view>
      <view class="growth-empty surface" wx:elif="{{!center.redemptionRecords.length}}">暂无兑换记录</view>
      <view class="growth-list surface" wx:else><view class="growth-row" wx:for="{{center.redemptionRecords}}" wx:key="id"><view><text>兑换记录 {{item.id}}</text><text class="growth-row__meta">{{item.statusLabel}} · {{item.timeLabel}}</text></view></view></view>
    </view>
  </block>
</view>
