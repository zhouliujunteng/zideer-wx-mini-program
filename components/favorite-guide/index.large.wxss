/* 自动生成，请勿手改：index.wxss 在平板、电脑大屏（窗口宽 ≥ 450px）下的样式。
   rpx 按 1rpx = 0.6px 换算，固定定位元素收进居中栏；改完源文件后运行 node scripts/build-large-screen-styles.mjs */
@media (min-width: 450px) {
.fg-mask{top:0;right:max(0px, 50% - var(--lg-col) / 2);bottom:0;left:max(0px, 50% - var(--lg-col) / 2);box-shadow:0 0 0 100vmax rgba(24, 28, 26, .5)}
.fg-ring{box-sizing:border-box;border:2px solid #FD7C02;border-radius:50%}
.fg-card{width:372px;max-width:calc(100vw - 28px);padding:24px 21px 19px;box-sizing:border-box;border-radius:21px;box-shadow:0 18px 48px rgba(24, 28, 26, .22)}
.fg-arrow{top:-8px;width:16px;height:16px;border-radius:2px}
.fg-title{font-size:20px;font-weight:700;line-height:1.35}
.fg-subtitle{margin-top:6px;font-size:14px;line-height:1.55}
.fg-menu{margin-top:14px;padding:13px 4px 10px;border-radius:13px}
.fg-menu-item{width:25%;flex-direction:column;font-size:11px;line-height:1.3}
.fg-menu-icon{width:48px;height:48px;margin-bottom:6px;border-radius:12px}
.fg-menu-item.is-hot{font-weight:600}
.fg-menu-item.is-hot .fg-menu-icon{box-shadow:0 0 0 3px rgba(253, 124, 2, .22)}
.fg-icon-send{width:16px;height:16px;box-sizing:border-box;border:2px solid currentColor;border-radius:50% 50% 50% 4px}
.fg-icon-star{width:20px;height:20px}
.fg-icon-desktop{width:19px;height:19px;box-sizing:border-box;border:2px solid currentColor;border-radius:5px}
.fg-icon-desktop::before, .fg-icon-desktop::after{top:50%;left:50%;border-radius:1px}
.fg-icon-desktop::before{width:8px;height:2px}
.fg-icon-desktop::after{width:2px;height:8px}
.fg-icon-more{gap:3px}
.fg-icon-more view{width:4px;height:4px;border-radius:50%}
.fg-option{gap:10px;margin-top:14px}
.fg-option-badge{flex:0 0 33px;height:33px;border-radius:9px}
.fg-option-copy{min-width:0;flex-direction:column}
.fg-option-title{font-size:16px;font-weight:600;line-height:1.4}
.fg-option-hint{margin-top:2px;font-size:13px;line-height:1.55}
.fg-actions{gap:10px;margin-top:19px}
.fg-secondary, .fg-primary{height:48px;flex:1;border-radius:599px;font-size:16px;font-weight:600}
@keyframes fg-pop{from{opacity:0;transform:scale(.9) translateY(-8px)}to{opacity:1;transform:scale(1) translateY(0)}}
}
