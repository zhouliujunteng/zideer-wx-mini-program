/* finesse · register=h5 · morph=A.1-native-study-app · A=snow+coral+ink
 * B=system-700/400 · C=single-focus+grouped-rows+native-tabbar · D=tap-feedback-only
 * E=quiet-study-desk · SOUL=4 SPECTACLE=1 DENSITY=4 */

page {
  --canvas: #F6F7F9;
  --surface: #FEFEFC;
  --surface-soft: #F1F3F5;
  --ink: #17191C;
  --ink-soft: #4F545B;
  --muted: #8B9097;
  --line: rgba(23, 25, 28, 0.08);
  --line-strong: rgba(23, 25, 28, 0.13);
  --accent: #F05A3C;
  --accent-deep: #C9462D;
  --accent-soft: #FDEBE6;
  --blue: #4C72E8;
  --blue-soft: #EAF0FF;
  --green: #2F9A6C;
  --green-soft: #E7F5EE;
  --yellow: #B87920;
  --yellow-soft: #FFF4D8;
  min-height: 100%;
  background: var(--canvas);
  color: var(--ink);
  font-family: "PingFang SC", "Helvetica Neue", Arial, sans-serif;
  font-size: 28rpx;
  letter-spacing: 0;
}

view,
text,
image,
button,
scroll-view,
movable-area,
movable-view {
  box-sizing: border-box;
}

button {
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: 0;
  background: transparent;
  color: inherit;
  font: inherit;
  line-height: normal;
}

button::after {
  border: 0;
}

.screen {
  min-height: 100vh;
  background: var(--canvas);
}

.screen-scroll {
  min-height: 100vh;
  padding: 0 28rpx calc(env(safe-area-inset-bottom) + 152rpx);
  overflow-x: clip;
}

.app-nav {
  display: flex;
  min-height: 88rpx;
  align-items: center;
}

.app-nav__main {
  min-width: 0;
  flex: 1;
}

.app-nav__brand,
.app-nav__title {
  display: block;
  min-width: 0;
  color: var(--ink);
  font-size: 38rpx;
  font-weight: 700;
  line-height: 1.2;
  overflow-wrap: anywhere;
}

.app-nav__caption {
  display: block;
  margin-top: 4rpx;
  color: var(--muted);
  font-size: 21rpx;
}

.icon-button {
  display: flex;
  width: 72rpx;
  height: 72rpx;
  align-items: center;
  justify-content: center;
  flex: none;
  border-radius: 36rpx;
}

.icon-button:active,
.pressable:active {
  opacity: 0.62;
}

.icon-button image {
  width: 36rpx;
  height: 36rpx;
}

.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 18rpx;
}

.section-title {
  min-width: 0;
  color: var(--ink);
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1.3;
  overflow-wrap: anywhere;
}

.section-link {
  min-height: 64rpx;
  padding: 0 2rpx;
  color: var(--muted);
  font-size: 23rpx;
  white-space: nowrap;
}

.pressable {
  transition: opacity 120ms ease;
}

.surface {
  border: 1rpx solid var(--line);
  border-radius: 24rpx;
  background: var(--surface);
}

.skeleton {
  overflow: hidden;
  position: relative;
  border-radius: 18rpx;
  background: #E9EBEE;
}

.skeleton::after {
  position: absolute;
  inset: 0;
  background: linear-gradient(90deg, transparent, rgba(254, 254, 252, 0.72), transparent);
  content: "";
  transform: translateX(-100%);
  animation: shimmer 1.5s ease infinite;
}

.state-panel {
  margin-top: 120rpx;
  padding: 36rpx 28rpx;
  text-align: center;
}

.state-panel__mark {
  display: flex;
  width: 68rpx;
  height: 68rpx;
  align-items: center;
  justify-content: center;
  margin: 0 auto;
  border-radius: 34rpx;
  background: var(--accent-soft);
  color: var(--accent-deep);
  font-size: 30rpx;
  font-weight: 700;
}

.state-panel__title {
  display: block;
  margin-top: 24rpx;
  font-size: 30rpx;
  font-weight: 700;
}

.state-panel__copy {
  display: block;
  max-width: 520rpx;
  margin: 12rpx auto 0;
  color: var(--muted);
  font-size: 24rpx;
  line-height: 1.55;
}

.state-panel__action {
  display: flex;
  width: 204rpx;
  min-height: 84rpx;
  align-items: center;
  justify-content: center;
  margin: 28rpx auto 0;
  border-radius: 42rpx;
  background: var(--accent);
  color: var(--surface);
  font-size: 25rpx;
  font-weight: 700;
}

.state-panel__secondary {
  display: flex;
  width: 260rpx;
  min-height: 76rpx;
  align-items: center;
  justify-content: center;
  margin: 16rpx auto 0;
  border: 1rpx solid var(--line-strong);
  border-radius: 38rpx;
  background: var(--surface);
  color: var(--ink);
  font-size: 23rpx;
  font-weight: 600;
}

@keyframes shimmer {
  to { transform: translateX(100%); }
}

@media (prefers-reduced-motion: reduce) {
  .pressable,
  .icon-button,
  .skeleton::after {
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.01ms !important;
  }
}
