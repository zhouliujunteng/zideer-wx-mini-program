/* 全站共用的骨架块：真实数据第一次到达前，数据位只显示灰块，不显示演示数据、默认值或空状态文案。
   固定入口（菜单、按钮、标题、表单结构）照常渲染；读到过一次后再回到页面保留旧数据，后台静默刷新。
   用法：在页面 wxss 顶部用 import 引入本文件（写相对路径），按真实内容的形状拼 .sk 块。 */
.sk {
  display: block;
  border-radius: 12rpx;
  background: linear-gradient(90deg, #ECEEEB 25%, #F5F6F4 37%, #ECEEEB 63%);
  background-size: 400% 100%;
  animation: sk-shimmer 1.4s ease infinite;
}
.sk-line { height: 28rpx; }
.sk-line + .sk-line { margin-top: 14rpx; }
.sk-short { width: 40%; }
.sk-mid { width: 64%; }
.sk-inline { display: inline-block; vertical-align: middle; }
.sk-round { border-radius: 50%; }
/* 一张卡片大小的骨架（列表项、信息卡），高度可在页面里覆盖 */
.sk-card { height: 160rpx; border-radius: 24rpx; }
.sk-card + .sk-card { margin-top: 20rpx; }
@keyframes sk-shimmer {
  0% { background-position: 100% 50%; }
  100% { background-position: 0 50%; }
}
