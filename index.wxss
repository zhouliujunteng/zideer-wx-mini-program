.me-notice-button { position: fixed; z-index: 21; display: flex; align-items: center; justify-content: center; box-sizing: border-box; border: 1rpx solid #e7ebe6; border-radius: 50%; background: #fff; }
.me-message-icon { display: block; width: 34rpx; height: 34rpx; }
.me-notice-badge { position: absolute; top: -8rpx; right: -8rpx; min-width: 27rpx; height: 27rpx; padding: 0 6rpx; box-sizing: border-box; border: 3rpx solid #FAFAFA; border-radius: 999rpx; background: #FD5A5F; color: #fff; font-size: 17rpx; line-height: 21rpx; text-align: center; }

.page-scroll { height: 100vh; box-sizing: border-box; background: #FAFAFA; }
.page-shell { min-height: 100%; padding: 16rpx 36rpx 180rpx; box-sizing: border-box; }
.profile { display: flex; align-items: center; padding: 24rpx 0 34rpx; }.avatar { width: 106rpx; height: 106rpx; border-radius: 50%; background: #d8e7d9; color: #1d5945; font-size: 42rpx; line-height: 106rpx; text-align: center; }.profile-copy { flex: 1; margin-left: 22rpx; }.profile-name,.profile-role { display: block; }.profile-name { font-size: 38rpx; font-weight: 700; }.profile-role { margin-top: 8rpx; color: #717b73; font-size: 23rpx; }.verified { display: inline-block; margin-top: 13rpx; padding: 5rpx 12rpx; border-radius: 999rpx; background: #edf4ed; color: #397057; font-size: 19rpx; }.arrow,.menu-arrow { color: #a2a9a1; font-size: 42rpx; font-weight: 300; }.summary { display: flex; padding: 28rpx 8rpx; border-radius: 28rpx; background: #1d5945; color: #fff; }.summary-item { flex: 1; text-align: center; }.summary-value,.summary-label { display: block; }.summary-value { font-size: 38rpx; font-weight: 700; }.summary-label { margin-top: 8rpx; color: #d6e4d9; font-size: 21rpx; }.group { margin-top: 42rpx; }.group-title { display: block; margin-bottom: 18rpx; color: #6f7972; font-size: 24rpx; }.menu { overflow: hidden; border-radius: 28rpx; background: #fff; }.menu-item { display: flex; align-items: center; justify-content: space-between; min-height: 100rpx; padding: 0 28rpx; border-bottom: 1rpx solid #f0f1ed; font-size: 29rpx; }.menu-item:last-child { border: 0; }.support { display: flex; justify-content: space-between; margin-top: 42rpx; padding: 28rpx; border-radius: 24rpx; background: #f6ecd4; color: #786338; font-size: 23rpx; }
.profile { padding-bottom: 38rpx; }
.avatar { flex: 0 0 auto; width: 144rpx; height: 144rpx; font-size: 48rpx; line-height: 144rpx; }
.profile-copy { min-width: 0; margin-left: 28rpx; }
.profile-name-row, .profile-id-row { display: flex; align-items: center; min-width: 0; }
.profile-name { flex: 1; min-width: 0; overflow: hidden; color: #24332d; font-size: 38rpx; font-weight: 700; line-height: 1.2; text-overflow: ellipsis; white-space: nowrap; }
.profile-id-row { margin-top: 18rpx; }
.profile-id-label, .profile-id { color: #8a958d; font-size: 23rpx; line-height: 1; }
