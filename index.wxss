page { background: #FAFAFA; }

.me-page { height: 100vh; overflow: hidden; background: #FAFAFA; color: #24332d; }

.me-topbar { position: fixed; top: 0; left: 0; z-index: 20; width: 100%; box-sizing: border-box; background: #FAFAFA; }
