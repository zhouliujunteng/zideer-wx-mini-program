.profile-pencil-icon::after { top: 8rpx; left: -4rpx; border-top-width: 2.5rpx; border-bottom-width: 2.5rpx; border-right-width: 6rpx; }
.profile-copy-icon { width: 22rpx; height: 24rpx; }
