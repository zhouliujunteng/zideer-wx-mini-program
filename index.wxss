/* 个人资料摘要：头像、姓名和 ID 纵向居中，使用独立的淡橙色底卡与账户区域分层。 */
.profile {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  margin: -16rpx -36rpx 0;
  padding: 42rpx 36rpx 44rpx;
  box-sizing: border-box;
  border-radius: 0 0 40rpx 40rpx;
  background: #FFF1E6;
}
.profile-avatar-wrap { flex: 0 0 auto; width: 168rpx; height: 168rpx; }
.avatar {
  width: 168rpx;
  height: 168rpx;
  box-sizing: border-box;
  border: 6rpx solid #fff;
  border-radius: 50%;
  background: #E4E7E5;
  box-shadow: none;
  line-height: 148rpx;
}
.profile-copy { width: 100%; margin: 22rpx 0 0; }
.profile-name-row, .profile-id-row { position: relative; justify-content: center; width: 100%; }
.profile-name { max-width: calc(100% - 96rpx); color: #24332D; text-align: center; }
.profile-id-row { margin-top: 20rpx; }
.profile-id-label, .profile-id { color: #8A958D; }
.profile-id { flex: 0 0 auto; max-width: calc(100% - 96rpx); }
.profile-action { position: absolute; top: 50%; margin-left: 0; background: rgba(255, 255, 255, .72); transform: translateY(-50%); }
.profile-edit-action, .profile-copy-action { right: 0; }
.profile-copy-action { position: relative; top: auto; right: auto; width: 28rpx; height: 28rpx; margin-left: 12rpx; background: transparent; transform: none; }
.profile-copy-action .profile-copy-icon { width: 22rpx; height: 24rpx; }
.profile-copy-action .profile-copy-icon::after { background: #FFF1E6; }
.wallet-grid { margin-top: 24rpx; }
.page-scroll { position: relative; z-index: 2; background: transparent; }
.page-shell { padding-top: 0; }
.profile { margin: 0 -36rpx; padding-bottom: 160rpx; box-shadow: inset 0 -8rpx 18rpx rgba(218, 133, 38, .07); }
.me-topbar { background-color: transparent; transition: background-color .08s ease-out; }
.me-edit-profile-pill { position: fixed; z-index: 22; display: flex; align-items: center; justify-content: center; width: 132rpx; box-sizing: border-box; border: 0; border-radius: 999rpx; background: rgba(255, 255, 255, .88); color: #1F2722; font-size: 20rpx; font-weight: 600; line-height: 1; white-space: nowrap; transition: opacity .08s ease-out, transform .08s ease-out; }
.me-edit-profile-pill:active { opacity: .68; }
.me-edit-profile-pill.is-hidden { opacity: 0; pointer-events: none; transform: translateY(-2rpx); }
.membership-card { position: relative; z-index: 1; display: flex; align-items: center; min-height: 176rpx; margin-top: -104rpx; padding: 0 32rpx; box-sizing: border-box; overflow: hidden; border: 2rpx solid #fff; border-radius: 44rpx; background: linear-gradient(105deg, #fff 0%, #fff 38%, #FFF5E6 62%, #FFE8BA 100%); }
.membership-copy { position: relative; z-index: 2; display: flex; flex-direction: column; align-items: flex-start; }
.membership-title { color: #3A3427; font-size: 34rpx; font-weight: 700; line-height: 1.2; }
.membership-subtitle { margin-top: 12rpx; color: #9B8A63; font-size: 22rpx; line-height: 1.2; }
.membership-art { position: absolute; top: 0; right: 0; width: 270rpx; height: 100%; }
.membership-crown { position: absolute; z-index: 2; top: 20rpx; right: 28rpx; width: 210rpx; height: 138rpx; transform: rotate(9deg) scale(1.02); }
.membership-ring { position: absolute; z-index: 1; box-sizing: border-box; border: 2rpx solid rgba(226, 174, 45, .54); border-radius: 50%; }
.membership-ring-back { right: 28rpx; bottom: 18rpx; width: 150rpx; height: 42rpx; transform: rotate(-13deg); }
.membership-ring-front { right: 70rpx; bottom: 4rpx; width: 118rpx; height: 32rpx; transform: rotate(10deg); }
.wallet-module { position: relative; display: flex; align-items: center; min-height: 116rpx; padding: 18rpx; box-sizing: border-box; overflow: visible; }
.wallet-module-illustration { position: relative; top: auto; left: auto; z-index: 1; flex: 0 0 auto; width: 96rpx; height: 96rpx; filter: drop-shadow(0 3rpx 4rpx rgba(36, 51, 45, .12)); transform: translate(-6rpx, 0); }
.wallet-module-copy { position: relative; z-index: 2; min-width: 0; margin-left: 18rpx; }
.wallet-module-copy { flex: 1; }
.wallet-module-go { display: flex; flex: 0 0 auto; align-items: center; justify-content: center; width: 26rpx; height: 32rpx; margin-left: 6rpx; }
.wallet-module-chevron { width: 12rpx; height: 12rpx; border-top: 3rpx solid #C3CAC4; border-right: 3rpx solid #C3CAC4; transform: rotate(45deg); }
.wallet-label { display: block; overflow: hidden; color: #6F7D74; font-size: 23rpx; line-height: 1.2; text-overflow: ellipsis; white-space: nowrap; }
.wallet-value { display: block; margin-top: 8rpx; color: #24332D; font-size: 36rpx; font-weight: 700; line-height: 1.05; }
.menu { border-radius: 40rpx; }
