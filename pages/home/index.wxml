<wxs module="UA" src="../../utils/ui-asset.wxs" />
<!-- 结构取自 UI 设计仓库 d9627f0 的首页；数据与跳转沿用正式小程序（见 index.js）。 -->
<view class="home-viewport home-flat-viewport member-mode">
  <view class="topbar topbar-solid home-flat-topbar">
    <view class="topbar-inner" style="height: {{navigationBarHeight}}px; padding-top: {{statusBarHeight}}px;"><image class="brand-logo" src="{{UA.src(ui, '/assets/home/brand-logo.png')}}" mode="aspectFit" aria-label="知鹿学习 iDeer"></image></view>
    <view class="notice-button" style="top: {{notificationTop}}px; right: {{notificationRight}}px; width: {{menuButtonHeight}}px; height: {{menuButtonHeight}}px;" bindtap="showNotifications" role="button" aria-label="打开消息"><image class="message-icon" src="{{UA.src(ui, '/assets/topbar/message.png')}}" mode="aspectFit"></image><view wx:if="{{model.notifications.count > 0}}" class="notice-badge">{{model.notifications.count}}</view></view>
  </view>

  <scroll-view class="home-flat-scroll" scroll-y="true" show-scrollbar="false" refresher-enabled="{{true}}" refresher-triggered="{{refreshing}}" refresher-default-style="white" refresher-background="#FAFAFA" bindrefresherrefresh="handleRefresh">
    <view class="home-flat-content" style="padding-top: {{contentTop}}px;">
      <view class="home-priority-tools" aria-label="重点 AI 提分工具">
        <view wx:for="{{primaryTools}}" wx:key="id" class="home-priority-tool home-priority-tool-{{item.tone}}" data-label="{{item.label}}" bindtap="handleScoreToolTap" role="button" aria-label="{{item.label}}">
          <view class="home-priority-tool-copy"><text class="home-priority-tool-label">{{item.label}}</text><text class="home-priority-tool-hint">{{item.hint}}</text></view>
          <view class="home-priority-tool-icon"><image class="score-tool-icon-image" src="{{UA.src(ui, '/assets/home/score-tools/' + (item.id) + '.png')}}" mode="aspectFit" aria-hidden="true"></image></view>
        </view>
      </view>
      <swiper class="home-secondary-swiper" duration="260" circular="{{false}}" indicator-dots="{{false}}" bindchange="handleSecondaryToolsChange" aria-label="更多 AI 提分工具">
        <swiper-item class="home-secondary-swiper-item" wx:for="{{secondaryToolPages}}" wx:for-item="page" wx:for-index="pageIndex" wx:key="pageIndex">
          <view class="home-secondary-tools">
            <view wx:for="{{page}}" wx:for-item="tool" wx:key="id" class="home-secondary-tool" data-label="{{tool.label}}" bindtap="handleScoreToolTap" role="button" aria-label="{{tool.label}}">
              <view class="learning-tool-icon learning-tool-icon-{{tool.tone}}"><image class="score-tool-icon-image score-tool-icon-image-small" src="{{UA.src(ui, '/assets/home/score-tools/' + (tool.id) + '.png')}}" mode="aspectFit" aria-hidden="true"></image></view><text class="learning-tool-label">{{tool.label}}</text>
            </view>
          </view>
        </swiper-item>
      </swiper>
      <view wx:if="{{secondaryToolPages.length > 1}}" class="home-secondary-indicator" aria-label="轻入口分页">
        <view wx:for="{{secondaryToolPages}}" wx:for-index="pageIndex" wx:key="pageIndex" class="home-secondary-indicator-segment {{secondaryPage === pageIndex ? 'is-active' : ''}}"></view>
      </view>

      <view class="home-flat-course-section">
        <view class="section-heading"><text class="section-title">会员课程</text><view class="task-all-link" bindtap="openMembershipCatalog" role="button" aria-label="查看全部会员课程"><text>查看全部</text><view class="task-all-icon" aria-hidden="true"></view></view></view>
        <view wx:if="{{model.moreCourses && model.moreCourses.length}}" class="more-courses-grid home-flat-course-grid">
          <view wx:for="{{model.moreCourses}}" wx:key="id" class="more-course-card" data-id="{{item.id}}" bindtap="openLibraryCourse" role="button" aria-label="打开课程 {{item.title}}">
            <view class="more-course-cover"></view>
            <view class="more-course-info"><view class="more-course-copy"><text class="more-course-title">{{item.title}}</text><text class="more-course-subtitle">{{item.subtitle}}</text></view><text wx:if="{{!item.isMember}}" class="more-course-tag">会员</text></view>
          </view>
        </view>
        <view wx:else class="home-course-empty"><view class="home-course-empty-copy"><text class="home-course-empty-title">课程正在上架</text><text class="home-course-empty-subtitle">已发布的公共课程会出现在这里。</text></view><view class="home-course-empty-action" bindtap="openLibraryList" role="button" aria-label="进入课程库">去课程库 ›</view></view>
      </view>
      <view class="home-flat-safe-space"></view>
    </view>
  </scroll-view>
</view>
<dev-reset-fab />
