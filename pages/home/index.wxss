/* 首页 · 设计师浅色设计语言（功能结构不变，仅视觉重置） */
page { background: #FAFAFA; }

.agent-home { position: relative; height: 100vh; overflow: hidden; background: #FAFAFA; color: #24332D; }

/* 顶栏：品牌 lockup 原图 + 圆形操作钮 */
.agent-topbar { position: fixed; top: 0; right: 0; left: 0; z-index: 20; display: flex; align-items: center; justify-content: space-between; padding: 0 36rpx 16rpx; box-sizing: content-box; background: #FAFAFA; }
.agent-topbar::after { position: absolute; right: 0; bottom: 0; left: 0; height: 1rpx; background: #E8EBE8; content: ''; }
.agent-brand { display: flex; align-items: center; }
.agent-brand-lockup { display: block; width: 168rpx; height: 66rpx; }
.agent-top-actions { display: flex; align-items: center; gap: 18rpx; }
.agent-top-action { position: relative; display: flex; align-items: center; justify-content: center; width: 58rpx; height: 58rpx; border: 1rpx solid #E7EBE6; border-radius: 50%; background: #FFFFFF; }
.agent-top-action image { width: 30rpx; height: 30rpx; }
.agent-notice-dot { position: absolute; top: 8rpx; right: 8rpx; width: 10rpx; height: 10rpx; border-radius: 50%; background: #FD7C02; }

.agent-scroll { position: absolute; top: 0; right: 0; bottom: 0; left: 0; box-sizing: border-box; }
.agent-content { padding: 44rpx 36rpx 0; box-sizing: border-box; }

/* 开场介绍 */
.agent-intro { display: flex; align-items: center; flex-direction: column; padding-top: 10rpx; text-align: center; }
.agent-eyebrow { color: #98A49C; font-size: 21rpx; letter-spacing: 2rpx; line-height: 1.4; }
.agent-avatar { display: flex; align-items: center; justify-content: center; width: 164rpx; height: 164rpx; margin-top: 38rpx; border-radius: 47% 53% 52% 48%; background: #FD7C02; color: #FFFFFF; transform: rotate(-9deg); box-shadow: 0 14rpx 44rpx rgba(253, 124, 2, .22); }
.agent-avatar text { display: block; font-size: 60rpx; font-weight: 700; line-height: 1; transform: rotate(9deg); }
.agent-title { display: block; margin-top: 34rpx; color: #24332D; font-size: 29rpx; font-weight: 650; line-height: 1.5; }
.agent-subtitle { display: block; margin-top: 12rpx; color: #7D8981; font-size: 22rpx; line-height: 1.6; }

/* 输入卡 */
.agent-composer { margin-top: 42rpx; padding: 26rpx 28rpx 22rpx; border: 2rpx solid #F0F2EE; border-radius: 30rpx; background: #FFFFFF; }
.agent-input { display: block; width: 100%; min-height: 54rpx; max-height: 180rpx; color: #24332D; font-size: 28rpx; line-height: 1.55; }
.agent-input-placeholder { color: #B4BCB6; }
.agent-composer-footer { display: flex; align-items: center; justify-content: space-between; margin-top: 22rpx; }
.agent-context { display: flex; align-items: center; min-width: 0; max-width: 76%; color: #98A49C; font-size: 21rpx; line-height: 1.3; }
.agent-context image { flex: 0 0 auto; width: 32rpx; height: 32rpx; margin-right: 12rpx; }
.agent-context-active { color: #E78435; font-weight: 600; }
.agent-send { display: flex; align-items: center; justify-content: center; flex: 0 0 auto; width: 64rpx; height: 64rpx; border-radius: 50%; background: rgba(253, 124, 2, .14); color: #FD7C02; transition: background .18s ease, color .18s ease; }
.agent-send-ready { background: #FD7C02; color: #FFFFFF; }
.agent-send text { font-size: 42rpx; font-weight: 300; line-height: 1; transform: translateY(-3rpx); }
.agent-helper { display: block; margin-top: 22rpx; color: #A2ABA4; font-size: 20rpx; line-height: 1.5; text-align: center; }

/* 分区 */
.agent-section { margin-top: 54rpx; }
.agent-section-head { display: flex; align-items: center; justify-content: space-between; }
.agent-section-title { color: #24332D; font-size: 30rpx; font-weight: 700; line-height: 1.35; }
.agent-section-caption { color: #98A49C; font-size: 20rpx; }
.agent-section-link { color: #FD7C02; font-size: 21rpx; font-weight: 650; line-height: 1.35; }
.agent-section-link text { padding-left: 6rpx; font-size: 32rpx; line-height: 0; }

/* 学习工具 */
.agent-tools-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 28rpx 12rpx; margin-top: 28rpx; }
.agent-tool-item { display: flex; align-items: center; min-width: 0; flex-direction: column; text-align: center; }
.agent-tool-icon { display: flex; align-items: center; justify-content: center; width: 68rpx; height: 68rpx; border: 2rpx solid #F0F2EE; border-radius: 22rpx; background: #FFFFFF; }
.agent-tool-icon image { width: 34rpx; height: 34rpx; }
.agent-tool-title { display: block; margin-top: 13rpx; overflow: hidden; color: #34443A; font-size: 21rpx; font-weight: 600; line-height: 1.3; text-overflow: ellipsis; white-space: nowrap; }
.agent-tool-description { display: block; width: 100%; margin-top: 6rpx; overflow: hidden; color: #98A49C; font-size: 16rpx; line-height: 1.3; text-overflow: ellipsis; white-space: nowrap; }

/* 会员课程 */
.agent-courses-section { margin-top: 62rpx; }
.agent-course-list { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16rpx; margin-top: 24rpx; }
.agent-course-card { min-width: 0; overflow: hidden; border: 2rpx solid #F0F2EE; border-radius: 24rpx; background: #FFFFFF; }
/* 封面：浅色底 + 程序化「课件版式」装饰（对齐 OpenMAIC 课程库封面语言） */
.agent-course-cover { position: relative; height: 220rpx; border-radius: 22rpx 22rpx 0 0; overflow: hidden; background: linear-gradient(135deg, #E7F0FF 0%, #F3F7FF 100%); }
.agent-course-cover-1 { background: linear-gradient(135deg, #E4F6EA 0%, #F2FBF5 100%); }
.agent-course-cover-2 { background: linear-gradient(135deg, #FFF1E2 0%, #FFFAF2 100%); }
.agent-course-cover-art { position: absolute; top: 26rpx; left: 26rpx; right: 26rpx; }
.agent-course-cover-line { height: 12rpx; border-radius: 6rpx; background: rgba(36, 51, 45, .16); }
.agent-course-cover-line-title { width: 62%; }
.agent-course-cover-line-sub { width: 38%; margin-top: 12rpx; opacity: .6; }
.agent-course-cover-block { margin-top: 22rpx; width: 46%; height: 84rpx; border-radius: 12rpx; background: rgba(255, 255, 255, .85); box-shadow: 0 8rpx 22rpx rgba(36, 51, 45, .08); }
.agent-course-cover-block::after { display: block; width: 60%; height: 10rpx; margin: 16rpx 0 0 14rpx; border-radius: 5rpx; background: rgba(36, 51, 45, .12); content: ''; }
.agent-course-lock { position: absolute; top: 14rpx; right: 14rpx; display: flex; align-items: center; justify-content: center; min-width: 76rpx; height: 40rpx; padding: 0 14rpx; box-sizing: border-box; border-radius: 999rpx; background: rgba(36, 51, 45, .55); color: #FFFFFF; font-size: 18rpx; font-weight: 650; letter-spacing: 2rpx; backdrop-filter: blur(6rpx); }
.agent-course-caption { padding: 18rpx 20rpx 22rpx; }
.agent-course-title { display: block; overflow: hidden; color: #24332D; font-size: 26rpx; font-weight: 700; line-height: 1.4; text-overflow: ellipsis; white-space: nowrap; }
.agent-course-meta { display: block; margin-top: 8rpx; overflow: hidden; color: #98A49C; font-size: 19rpx; line-height: 1.35; text-overflow: ellipsis; white-space: nowrap; }
.agent-course-empty { display: flex; align-items: center; justify-content: space-between; gap: 18rpx; margin-top: 24rpx; padding: 24rpx 22rpx; border: 2rpx solid #F0F2EE; border-radius: 24rpx; background: #FFFFFF; }
.agent-course-empty-copy { min-width: 0; }
.agent-course-empty-title { display: block; color: #24332D; font-size: 24rpx; font-weight: 650; line-height: 1.4; }
.agent-course-empty-subtitle { display: block; margin-top: 8rpx; color: #98A49C; font-size: 19rpx; line-height: 1.4; }
.agent-course-empty-action { flex: 0 0 auto; color: #FD7C02; font-size: 20rpx; font-weight: 650; }
.agent-course-empty-action text { padding-left: 4rpx; font-size: 30rpx; }
.agent-safe-space { height: 150rpx; }
