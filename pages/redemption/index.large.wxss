/* 自动生成，请勿手改：index.wxss 在平板、电脑大屏（窗口宽 ≥ 450px）下的样式。
   rpx 按 1rpx = 0.6px 换算，固定定位元素收进居中栏；改完源文件后运行 node scripts/build-large-screen-styles.mjs */
@media (min-width: 450px) {
.sk{border-radius:7px}
.sk-line{height:16px}
.sk-line + .sk-line{margin-top:8px}
.sk-short{width:40%}
.sk-mid{width:64%}
.sk-round{border-radius:50%}
.sk-card{height:96px;border-radius:14px}
.sk-card + .sk-card{margin-top:12px}
.redemption-page{height:100vh}
.redemption-topbar{top:0;left:max(0px, 50% - var(--lg-col) / 2);width:min(100%, var(--lg-col))}
.redemption-topbar-inner{box-sizing:content-box;padding:0 21px 9px}
.redemption-back, .redemption-topbar-placeholder{width:33px;height:33px}
.redemption-back-icon{width:13px;height:13px;border-bottom:2px solid #27332D;border-left:2px solid #27332D;transform:rotate(45deg) translate(2px, -3px)}
.redemption-topbar-title{left:50%;font-size:21px;font-weight:700;letter-spacing:-1px;transform:translateX(-50%)}
.redemption-scroll{height:100vh;box-sizing:border-box}
.redemption-shell{min-height:100%;padding:18px 21px calc(48px + env(safe-area-inset-bottom));box-sizing:border-box}
.redemption-hero{min-height:115px;padding:4px 0 4px 4px;box-sizing:border-box}
.redemption-hero-copy{min-width:0;height:105px;flex:1;flex-direction:column}
.redemption-hero-title{max-width:240px;font-size:22px;font-weight:700;letter-spacing:-1px;line-height:1.3}
.redemption-hero-subtitle{margin-top:9px;font-size:13px;line-height:1.35}
.redemption-hero-image{flex:0 0 105px;width:105px;height:105px;margin:0 -5px 0 4px;transform:translateY(-12px)}
.redemption-entry{padding-top:7px}
.redemption-code-row{gap:9px}
.redemption-code-input{flex:1;min-width:0;height:60px;padding:0 16px;box-sizing:border-box;border-radius:599px;font-size:17px;line-height:60px}
.redemption-scan-button{flex:0 0 60px;width:60px;height:60px;border-radius:50%}
.redemption-scan-button:active{transform:scale(.96)}
.redemption-scan-icon{width:25px;height:25px}
.redemption-submit{width:100%;height:55px;margin:16px 0 0;padding:0;border:0;border-radius:599px;font-size:17px;font-weight:650;line-height:55px}
.redemption-submit::after{border:0}
.redemption-feedback{margin:13px 4px 0;font-size:12px;line-height:1.45}
.redemption-feedback-dot{flex:0 0 auto;width:4px;height:4px;margin:6px 6px 0 0;border-radius:50%}
.redemption-history-section{margin-top:28px}
.redemption-section-heading{padding:0 2px}
.redemption-heading-copy{min-width:0}
.redemption-section-title{font-size:16px;font-weight:700;line-height:1.3}
.redemption-section-count{margin-left:7px;font-size:12px;line-height:1.3}
.redemption-history-link{padding:6px 0 6px 12px;font-size:12px;line-height:1}
.redemption-history-link-arrow{width:6px;height:6px;margin-left:4px;box-sizing:border-box;border-top:1px solid #A0AAA3;border-right:1px solid #A0AAA3;transform:rotate(135deg)}
.redemption-history-link.is-expanded .redemption-history-link-arrow{transform:rotate(-45deg)}
.redemption-history-list{margin-top:12px}
.redemption-history-item{min-height:81px;margin-top:10px;padding:16px 18px;box-sizing:border-box;border-radius:24px}
.redemption-history-item:first-child{margin-top:0}
.redemption-history-main{min-width:0;flex:1}
.redemption-history-title{font-size:15px;font-weight:650;line-height:1.35}
.redemption-history-description{margin-top:7px;font-size:12px;line-height:1.35}
.redemption-history-side{flex:0 0 auto;flex-direction:column;margin-left:12px}
.redemption-history-status{padding:3px 9px;border-radius:599px;font-size:11px;line-height:1.3}
.redemption-history-time{margin-top:7px;font-size:11px;line-height:1.3}
.redemption-history-empty{margin-top:12px;padding:33px 16px;border-radius:24px;font-size:15px;line-height:1.4}
.redemption-history-empty-hint{margin-top:7px;font-size:12px}
.redemption-notice-trigger{margin-top:10px;font-size:12px;line-height:1.3}
.redemption-notice-trigger-arrow{width:5px;height:5px;margin-left:4px;border-top:1px solid #B1BBB4;border-right:1px solid #B1BBB4;transform:rotate(45deg)}
.redemption-sheet-layer{top:0;right:max(0px, 50% - var(--lg-col) / 2);bottom:0;left:max(0px, 50% - var(--lg-col) / 2);box-shadow:0 0 0 100vmax rgba(28, 38, 32, .28)}
.redemption-notice-sheet{right:0;bottom:0;left:0;height:62vh;padding:9px 16px calc(14px + env(safe-area-inset-bottom));box-sizing:border-box;border-radius:24px 24px 0 0}
.redemption-sheet-handle{width:43px;height:4px;margin:0 auto 16px;border-radius:599px}
.redemption-sheet-title{font-size:19px;font-weight:700;line-height:1.2}
.redemption-sheet-close{width:31px;height:31px;margin-top:-5px;border-radius:50%;font-size:22px;font-weight:300;line-height:1}
.redemption-sheet-scroll{height:calc(62vh - 85px);margin-top:16px}
.redemption-sheet-intro{font-size:14px;line-height:1.5}
.redemption-sheet-row{margin-top:14px;font-size:13px;line-height:1.55}
.redemption-sheet-dot{flex:0 0 auto;width:4px;height:4px;margin:7px 7px 0 0;border-radius:50%}
.redemption-result-sheet-layer{top:0;right:max(0px, 50% - var(--lg-col) / 2);bottom:0;left:max(0px, 50% - var(--lg-col) / 2);box-shadow:0 0 0 100vmax rgba(28, 38, 32, .28)}
.redemption-result-sheet{right:0;bottom:0;left:0;min-height:52vh;padding:9px 0 0;box-sizing:border-box;border-radius:20px 20px 0 0}
.redemption-result-sheet-handle{width:43px;height:4px;margin:0 auto 16px;border-radius:599px}
.redemption-result-content{top:43%;right:28px;left:28px;flex-direction:column;transform:translateY(-50%)}
.redemption-result-mark{width:86px;height:86px;margin:0 auto;border-radius:50%}
.redemption-result-emoji{font-size:43px;line-height:1}
.redemption-result-title{margin-top:19px;font-size:21px;font-weight:700;line-height:1.25}
.redemption-result-subtitle{margin-top:8px;font-size:13px;line-height:1.5}
.redemption-result-actionbar{right:0;bottom:0;left:0;padding:10px 16px calc(13px + env(safe-area-inset-bottom));box-sizing:border-box}
.redemption-result-button{width:100%;height:57px;margin:0;padding:0;border:0;border-radius:599px;font-size:17px;font-weight:650;line-height:57px}
.redemption-result-button::after{border:0}
@keyframes redemption-result-copy-in{from{opacity:0;transform:translateY(9px)}to{opacity:1;transform:translateY(0)}}
.redemption-history-retry{margin-top:12px;padding:7px 21px;border-radius:599px;font-size:14px}
}
