<view class="map-page">
  <view class="map-topbar">
    <view class="map-topbar-inner" style="height: {{navigationBarHeight}}px; padding-top: {{statusBarHeight}}px;"><text class="map-topbar-title">图谱</text></view>
    <view class="map-notice-button" style="top: {{notificationTop}}px; right: {{notificationRight}}px; width: {{menuButtonHeight}}px; height: {{menuButtonHeight}}px;" bindtap="showNotifications">
      <image class="map-message-icon" src="../../assets/topbar/message.png" mode="aspectFit"></image>
      <view wx:if="{{model.notifications.count}}" class="map-notice-badge">{{model.notifications.count}}</view>
    </view>
  </view>
  <view class="map-canvas-region {{sheetSnapping ? 'map-canvas-region-snapping' : ''}}" style="top: {{contentTop}}px; height: {{canvasClipHeight}}px;">
    <view class="map-viewport" style="height: {{canvasHeight}}px;">
      <canvas id="knowledge-map-canvas" type="2d" class="knowledge-map-canvas {{sheetSnapping ? 'map-canvas-follow-snapping' : ''}}" style="transform: translate3d(0, -{{canvasFollowOffset}}px, 0);" disable-scroll="true" bindtouchstart="handleMapTouchStart" bindtouchmove="handleMapTouchMove" bindtouchend="handleMapTouchEnd" bindtouchcancel="handleMapTouchEnd"></canvas>
      <view wx:if="{{metricsVisible}}" class="map-metrics {{metricsCollapsed ? 'map-metrics-collapsed' : ''}}" catchtap="toggleMetricsPanel"><view class="map-metrics-header"><text class="map-metrics-title">{{metricsCollapsed ? '性能' : '性能监测'}}</text><view class="map-metrics-toggle {{metricsCollapsed ? 'map-metrics-toggle-collapsed' : ''}}"></view></view><block wx:if="{{!metricsCollapsed}}"><text wx:for="{{metricsRows}}" wx:key="*this" class="map-metrics-row">{{item}}</text></block></view>
      <view class="map-gesture-tip {{sheetSnapping ? 'map-control-snapping' : ''}}" style="transform: translate3d(0, -{{sheetVisualOffset}}px, 0);"><text>{{zoomPercent}}% · 双指缩放 · 单指移动</text></view><view class="map-reset {{sheetSnapping ? 'map-control-snapping' : ''}}" style="transform: translate3d(0, -{{sheetVisualOffset}}px, 0);" bindtap="resetMap"><view class="map-reset-icon"><view class="map-reset-icon-center"></view></view></view>
    </view>
  </view>
  <view class="map-sheet {{sheetSnapping ? 'map-sheet-snapping' : ''}}" style="top: {{sheetStart}}rpx; transform: translate3d(0, -{{sheetVisualOffset}}px, 0);" bindtouchstart="handleMapSheetTouchStart" bindtouchmove="handleMapSheetTouchMove" bindtouchend="handleMapSheetTouchEnd" bindtouchcancel="handleMapSheetTouchEnd">
    <view class="map-sheet-handle"></view>
    <view class="map-section-heading"><text class="map-section-title">选择查看</text></view>
    <scroll-view class="map-course-strip" scroll-x show-scrollbar="false" enhanced="true"><view class="map-course-list">
      <view wx:for="{{model.courses}}" wx:key="id" class="map-course-card {{item.id === model.activeCourseId ? 'map-course-card-active' : ''}} {{item.isStressFixture ? 'map-course-card-stress' : ''}}" data-id="{{item.id}}" bindtap="selectCourse"><view class="map-course-card-top"><text class="map-course-title">{{item.title}}</text><text class="map-course-status">{{item.progressLabel}}</text></view><text class="map-course-meta">{{item.meta}}</text><view wx:if="{{item.hasProgress}}" class="map-course-track"><view class="map-course-bar" style="width: {{item.progress}}%;"></view></view><view wx:else class="map-course-stress-meta"><view class="map-course-stress-line"></view><text>性能验证</text></view></view>
    </view></scroll-view>
    <view class="map-legend"><view wx:for="{{model.legend}}" wx:key="key" class="map-legend-item"><view class="map-legend-mark map-legend-{{item.key}}"><text wx:if="{{item.key === 'mastered'}}">✓</text></view><text>{{item.label}}</text></view></view>
    <text class="map-learning-summary">{{model.learningSummary}}</text>
    <text class="map-note">{{model.tip}}</text>
  </view>
</view>
