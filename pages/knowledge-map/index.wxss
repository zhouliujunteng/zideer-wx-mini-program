page { background: #FAFAFA; }
.map-page { position: relative; height: 100vh; overflow: hidden; background: #FAFAFA; color: #24332d; }
.map-topbar { position: fixed; top: 0; left: 0; z-index: 30; width: 100%; background: #FAFAFA; }.map-topbar::after { position: absolute; right: 0; bottom: 0; left: 0; height: 1rpx; background: #e7ebe6; content: ''; pointer-events: none; }.map-topbar-inner { display: flex; align-items: center; box-sizing: content-box; padding: 0 36rpx 16rpx; }.map-topbar-title { color: #24332d; font-size: 36rpx; font-weight: 700; letter-spacing: -1rpx; line-height: 1; }
.map-notice-button { position: fixed; z-index: 31; display: flex; align-items: center; justify-content: center; box-sizing: border-box; border: 1rpx solid #e7ebe6; border-radius: 50%; background: #fff; }.map-message-icon { display: block; width: 34rpx; height: 34rpx; }.map-notice-badge { position: absolute; top: -8rpx; right: -8rpx; min-width: 27rpx; height: 27rpx; padding: 0 6rpx; box-sizing: border-box; border: 3rpx solid #FAFAFA; border-radius: 999rpx; background: #FD7C02; color: #fff; font-size: 17rpx; line-height: 21rpx; text-align: center; }
.map-canvas-region { position: absolute; right: 0; left: 0; z-index: 11; overflow: hidden; transition: none; }.map-canvas-region-snapping { transition: height .42s cubic-bezier(.25, .1, .25, 1); }.map-viewport { position: relative; width: 100%; overflow: hidden; }.knowledge-map-canvas { display: block; width: 100%; height: 100%; transition: none; will-change: transform; }.map-canvas-follow-snapping { transition: transform .42s cubic-bezier(.25, .1, .25, 1); }.map-metrics { position: absolute; top: 18rpx; left: 24rpx; z-index: 6; display: flex; flex-direction: column; gap: 3rpx; max-width: 410rpx; padding: 12rpx 15rpx; border: 1rpx solid rgba(253, 124, 2, .22); border-radius: 16rpx; background: rgba(255, 255, 255, .9); color: #70401c; font-size: 16rpx; line-height: 1.35; pointer-events: none; }.map-metrics-row { display: block; white-space: nowrap; }.map-gesture-tip { position: absolute; bottom: 28rpx; left: 36rpx; z-index: 5; display: flex; align-items: center; height: 54rpx; padding: 0 18rpx; box-sizing: border-box; border-radius: 999rpx; background: #fff; color: #8a958d; font-size: 19rpx; line-height: 1; pointer-events: none; transition: none; will-change: transform; }.map-reset { position: absolute; right: 36rpx; bottom: 28rpx; z-index: 5; display: flex; align-items: center; justify-content: center; width: 54rpx; height: 54rpx; padding: 0; box-sizing: border-box; border: 1rpx solid #e5ebe5; border-radius: 50%; background: #fff; transition: none; will-change: transform; }.map-reset-icon { position: relative; width: 23rpx; height: 23rpx; box-sizing: border-box; border: 2rpx solid #718077; border-radius: 50%; }.map-reset-icon::before, .map-reset-icon::after { position: absolute; top: 50%; left: 50%; background: #718077; content: ''; transform: translate(-50%, -50%); }.map-reset-icon::before { width: 31rpx; height: 2rpx; }.map-reset-icon::after { width: 2rpx; height: 31rpx; }.map-reset-icon-center { position: absolute; top: 50%; left: 50%; width: 5rpx; height: 5rpx; border-radius: 50%; background: #718077; transform: translate(-50%, -50%); }.map-control-snapping { transition: transform .42s cubic-bezier(.25, .1, .25, 1); }
.map-sheet { position: absolute; right: 0; left: 0; z-index: 20; min-height: 720rpx; padding: 18rpx 36rpx calc(180rpx + env(safe-area-inset-bottom)); box-sizing: border-box; border-radius: 48rpx 48rpx 0 0; background: #FAFAFA; box-shadow: 0 -10rpx 30rpx rgba(36, 51, 45, .08); transition: none; will-change: transform; backface-visibility: hidden; }.map-sheet-snapping { transition: transform .42s cubic-bezier(.25, .1, .25, 1); }.map-sheet-handle { width: 74rpx; height: 12rpx; margin: 0 auto 30rpx; border-radius: 999rpx; background: #d9dfda; }.map-section-heading, .map-section-title { display: block; }.map-section-title { color: #1c2821; font-size: 32rpx; font-weight: 700; line-height: 1.2; }
.map-course-strip { width: calc(100% + 72rpx); height: 150rpx; margin: 24rpx 0 0 -36rpx; white-space: nowrap; }.map-course-list { display: inline-flex; min-width: 100%; padding: 0 36rpx; box-sizing: border-box; gap: 18rpx; vertical-align: top; }.map-course-card { display: flex; flex: 0 0 286rpx; flex-direction: column; height: 128rpx; padding: 20rpx 22rpx; box-sizing: border-box; border: 2rpx solid transparent; border-radius: 26rpx; background: #fff; box-shadow: none; transition: background 180ms ease, border-color 180ms ease; }.map-course-card-active { border-color: #FD7C02; background: #fff; }.map-course-card-stress { background: #fff9f4; }.map-course-card-top { display: flex; align-items: center; justify-content: space-between; line-height: 32rpx; }.map-course-title { color: #28372f; font-size: 25rpx; font-weight: 700; }.map-course-status { color: #FD7C02; font-size: 21rpx; font-weight: 500; }.map-course-meta { display: block; margin-top: 6rpx; overflow: hidden; color: #7f8a82; font-size: 19rpx; font-weight: 400; line-height: 26rpx; text-overflow: ellipsis; white-space: nowrap; }.map-course-track { flex: 0 0 auto; width: 100%; height: 10rpx; margin-top: 10rpx; overflow: hidden; border-radius: 999rpx; background: #e2e8e2; }.map-course-bar { height: 100%; border-radius: inherit; background: #FD7C02; }.map-course-stress-meta { display: flex; align-items: center; gap: 8rpx; margin-top: 8rpx; color: #b35a10; font-size: 17rpx; line-height: 20rpx; }.map-course-stress-line { width: 36rpx; height: 4rpx; border-radius: 999rpx; background: #fd7c02; }
.map-legend { display: flex; flex-wrap: wrap; gap: 14rpx 22rpx; padding-top: 28rpx; }.map-legend-item { display: flex; align-items: center; gap: 8rpx; color: #7e8881; font-size: 20rpx; }.map-legend-mark { position: relative; display: flex; align-items: center; justify-content: center; width: 14rpx; height: 14rpx; box-sizing: border-box; color: #24332d; font-size: 13rpx; font-weight: 800; line-height: 1; }.map-legend-unknown { border: 2rpx solid #8c918d; border-radius: 50%; }.map-legend-reinforce::after { width: 14rpx; height: 3rpx; border-radius: 999rpx; background: #b85a08; content: ''; }.map-legend-learning { border-radius: 50%; background: #fd7c02; }.map-legend-mastered { width: 16rpx; height: 16rpx; }.map-learning-summary { display: block; margin-top: 24rpx; padding: 22rpx 24rpx; border-radius: 24rpx; background: #fff; color: #4f5e55; font-size: 22rpx; line-height: 1.7; }.map-note { display: block; padding-top: 16rpx; color: #a1a9a3; font-size: 19rpx; line-height: 1.5; }

.map-metrics { pointer-events: auto; transition: width 180ms ease, padding 180ms ease, border-radius 180ms ease; }
.map-metrics-header { display: flex; align-items: center; justify-content: space-between; gap: 12rpx; min-height: 24rpx; }
.map-metrics-title { color: #8f4a16; font-size: 17rpx; font-weight: 600; white-space: nowrap; }
.map-metrics-toggle { width: 10rpx; height: 10rpx; border-right: 2rpx solid #b3652a; border-bottom: 2rpx solid #b3652a; transform: rotate(225deg); transition: transform 180ms ease; }
.map-metrics-toggle-collapsed { transform: rotate(45deg); }
.map-metrics-collapsed { width: auto; min-width: 92rpx; padding: 9rpx 14rpx; border-radius: 999rpx; }
.map-metrics-collapsed .map-metrics-header { gap: 10rpx; }
