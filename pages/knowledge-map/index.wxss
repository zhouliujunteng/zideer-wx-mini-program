page { background: #FAFAFA; }
.map-page { position: relative; height: 100vh; overflow: hidden; background: #FAFAFA; color: #24332d; }
.map-topbar { position: fixed; top: 0; left: 0; z-index: 30; width: 100%; background: #FAFAFA; }.map-topbar::after { position: absolute; right: 0; bottom: 0; left: 0; height: 1rpx; background: #e7ebe6; content: ''; pointer-events: none; }.map-topbar-inner { display: flex; align-items: center; box-sizing: content-box; padding: 0 36rpx 16rpx; }.map-view-switch { display: inline-flex; align-items: center; min-width: 276rpx; height: 58rpx; padding: 4rpx; box-sizing: border-box; border-radius: 10rpx; background: #eef1ed; }.map-view-switch-item { display: flex; flex: 1; align-items: center; justify-content: center; height: 50rpx; border-radius: 7rpx; color: #7e8881; font-size: 24rpx; font-weight: 600; line-height: 1; }.map-view-switch-item-active { background: #fff; color: #24332d; box-shadow: 0 2rpx 8rpx rgba(36, 51, 45, .1); }
.map-notice-button { position: fixed; z-index: 31; display: flex; align-items: center; justify-content: center; box-sizing: border-box; border: 1rpx solid #e7ebe6; border-radius: 50%; background: #fff; }.map-message-icon { display: block; width: 34rpx; height: 34rpx; }.map-notice-badge { position: absolute; top: -8rpx; right: -8rpx; min-width: 27rpx; height: 27rpx; padding: 0 6rpx; box-sizing: border-box; border: 3rpx solid #FAFAFA; border-radius: 999rpx; background: #FD7C02; color: #fff; font-size: 17rpx; line-height: 21rpx; text-align: center; }
.map-assessment-button { position: fixed; z-index: 31; display: flex; align-items: center; justify-content: center; box-sizing: border-box; border: 1rpx solid #e7ebe6; border-radius: 50%; background: #fff; }
.map-assessment-icon { display: block; width: 36rpx; height: 36rpx; }
.map-canvas-region { position: absolute; right: 0; left: 0; z-index: 11; overflow: hidden; transition: none; }.map-canvas-region-snapping { transition: height .42s cubic-bezier(.25, .1, .25, 1); }.map-viewport { position: relative; width: 100%; overflow: hidden; }.knowledge-map-canvas { display: block; width: 100%; height: 100%; transition: none; will-change: transform; }.map-canvas-follow-snapping { transition: transform .42s cubic-bezier(.25, .1, .25, 1); }.map-metrics { position: absolute; top: 18rpx; left: 24rpx; z-index: 6; display: flex; flex-direction: column; gap: 3rpx; max-width: 410rpx; padding: 12rpx 15rpx; border: 1rpx solid rgba(253, 124, 2, .22); border-radius: 16rpx; background: rgba(255, 255, 255, .9); color: #70401c; font-size: 16rpx; line-height: 1.35; pointer-events: none; }.map-metrics-row { display: block; white-space: nowrap; }.map-gesture-tip { position: absolute; bottom: 28rpx; left: 36rpx; z-index: 5; display: flex; align-items: center; height: 54rpx; padding: 0 18rpx; box-sizing: border-box; border-radius: 999rpx; background: #fff; color: #8a958d; font-size: 19rpx; line-height: 1; pointer-events: none; transition: none; will-change: transform; }.map-reset { position: absolute; right: 36rpx; bottom: 28rpx; z-index: 5; display: flex; align-items: center; justify-content: center; width: 54rpx; height: 54rpx; padding: 0; box-sizing: border-box; border: 1rpx solid #e5ebe5; border-radius: 50%; background: #fff; transition: none; will-change: transform; }.map-reset-icon { position: relative; width: 23rpx; height: 23rpx; box-sizing: border-box; border: 2rpx solid #718077; border-radius: 50%; }.map-reset-icon::before, .map-reset-icon::after { position: absolute; top: 50%; left: 50%; background: #718077; content: ''; transform: translate(-50%, -50%); }.map-reset-icon::before { width: 31rpx; height: 2rpx; }.map-reset-icon::after { width: 2rpx; height: 31rpx; }.map-reset-icon-center { position: absolute; top: 50%; left: 50%; width: 5rpx; height: 5rpx; border-radius: 50%; background: #718077; transform: translate(-50%, -50%); }.map-control-snapping { transition: transform .42s cubic-bezier(.25, .1, .25, 1); }
.universe-scroll { position: absolute; right: 0; bottom: 0; left: 0; z-index: 10; }.universe-content { padding: 32rpx 36rpx calc(180rpx + env(safe-area-inset-bottom)); }.universe-heading { display: flex; align-items: baseline; justify-content: space-between; gap: 20rpx; }.universe-title { color: #1c2821; font-size: 38rpx; font-weight: 700; line-height: 1.25; }.universe-scope { overflow: hidden; color: #8a958d; font-size: 21rpx; line-height: 1.2; text-overflow: ellipsis; white-space: nowrap; }.universe-summary { display: block; margin-top: 20rpx; color: #4f5e55; font-size: 24rpx; line-height: 1.75; }.universe-section-heading { display: flex; align-items: baseline; justify-content: space-between; gap: 16rpx; margin-top: 42rpx; }.universe-section-title { color: #1c2821; font-size: 30rpx; font-weight: 700; line-height: 1.2; }.universe-section-meta { color: #8a958d; font-size: 20rpx; line-height: 1.2; }.universe-topic-list { margin-top: 20rpx; }.universe-topic-card { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; min-height: 102rpx; padding: 20rpx 22rpx; border-bottom: 1rpx solid #e7ebe6; background: #fff; }.universe-topic-card:first-child { border-radius: 8rpx 8rpx 0 0; }.universe-topic-card:last-child { border-bottom: 0; border-radius: 0 0 8rpx 8rpx; }.universe-topic-title { display: block; color: #28372f; font-size: 25rpx; font-weight: 700; line-height: 1.35; }.universe-topic-evidence { display: block; max-width: 470rpx; margin-top: 7rpx; overflow: hidden; color: #8a958d; font-size: 20rpx; line-height: 1.35; text-overflow: ellipsis; white-space: nowrap; }.universe-empty { margin-top: 20rpx; padding: 32rpx 28rpx; border-radius: 8rpx; background: #fff; }.universe-empty-title { display: block; color: #28372f; font-size: 26rpx; font-weight: 700; line-height: 1.4; }.universe-empty-copy { display: block; margin-top: 12rpx; color: #7e8881; font-size: 22rpx; line-height: 1.7; }.universe-note { display: block; margin-top: 32rpx; color: #8a958d; font-size: 21rpx; line-height: 1.6; }
.map-sheet { position: absolute; right: 0; left: 0; z-index: 20; min-height: 720rpx; padding: 18rpx 36rpx calc(180rpx + env(safe-area-inset-bottom)); box-sizing: border-box; border-radius: 48rpx 48rpx 0 0; background: #FAFAFA; box-shadow: 0 -10rpx 30rpx rgba(36, 51, 45, .08); transition: none; will-change: transform; backface-visibility: hidden; }.map-sheet-snapping { transition: transform .42s cubic-bezier(.25, .1, .25, 1); }.map-sheet-handle { width: 74rpx; height: 12rpx; margin: 0 auto 30rpx; border-radius: 999rpx; background: #d9dfda; }.map-section-heading { display: flex; align-items: baseline; justify-content: space-between; gap: 20rpx; }.map-section-title { display: block; color: #1c2821; font-size: 32rpx; font-weight: 700; line-height: 1.2; }.map-section-scope { overflow: hidden; color: #8a958d; font-size: 20rpx; line-height: 1.2; text-overflow: ellipsis; white-space: nowrap; }.map-universe-stats { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); height: 108rpx; margin-top: 24rpx; border-top: 1rpx solid #e7ebe6; border-bottom: 1rpx solid #e7ebe6; }.map-universe-stat { display: flex; align-items: center; justify-content: center; flex-direction: column; min-width: 0; }.map-universe-stat + .map-universe-stat { border-left: 1rpx solid #e7ebe6; }.map-universe-value { color: #1f3027; font-size: 36rpx; font-weight: 700; line-height: 1; }.map-universe-label { margin-top: 10rpx; color: #7e8881; font-size: 19rpx; line-height: 1; }
.map-course-strip { width: calc(100% + 72rpx); height: 150rpx; margin: 24rpx 0 0 -36rpx; white-space: nowrap; }.map-course-list { display: inline-flex; min-width: 100%; padding: 0 36rpx; box-sizing: border-box; gap: 18rpx; vertical-align: top; }.map-course-card { display: flex; flex: 0 0 286rpx; flex-direction: column; height: 128rpx; padding: 20rpx 22rpx; box-sizing: border-box; border: 2rpx solid transparent; border-radius: 26rpx; background: #fff; box-shadow: none; transition: background 180ms ease, border-color 180ms ease; }.map-course-card-active { border-color: #FD7C02; background: #FD7C02; }.map-course-card-stress { background: #fff9f4; }.map-course-card-top { display: flex; align-items: center; justify-content: space-between; line-height: 32rpx; }.map-course-title { color: #28372f; font-size: 25rpx; font-weight: 700; }.map-course-status { color: #FD7C02; font-size: 21rpx; font-weight: 500; }.map-course-meta { display: block; margin-top: 6rpx; overflow: hidden; color: #7f8a82; font-size: 19rpx; font-weight: 400; line-height: 26rpx; text-overflow: ellipsis; white-space: nowrap; }.map-course-track { flex: 0 0 auto; width: 100%; height: 10rpx; margin-top: 10rpx; overflow: hidden; border-radius: 999rpx; background: #e2e8e2; }.map-course-bar { height: 100%; border-radius: inherit; background: #FD7C02; }.map-course-stress-meta { display: flex; align-items: center; gap: 8rpx; margin-top: 8rpx; color: #b35a10; font-size: 17rpx; line-height: 20rpx; }.map-course-stress-line { width: 36rpx; height: 4rpx; border-radius: 999rpx; background: #fd7c02; }.map-course-card-active.map-course-card-stress { background: #FD7C02; }.map-course-card-active .map-course-title { color: #fff; }.map-course-card-active .map-course-status { color: rgba(255, 255, 255, .92); }.map-course-card-active .map-course-meta { color: rgba(255, 255, 255, .8); }.map-course-card-active .map-course-track { background: rgba(255, 255, 255, .32); }.map-course-card-active .map-course-bar { background: #fff; }.map-course-card-active .map-course-stress-meta { color: rgba(255, 255, 255, .9); }.map-course-card-active .map-course-stress-line { background: #fff; }
.map-legend { display: flex; flex-wrap: wrap; gap: 14rpx 22rpx; padding-top: 28rpx; }.map-legend-item { display: flex; align-items: center; gap: 8rpx; color: #7e8881; font-size: 20rpx; }.map-legend-mark { position: relative; display: flex; align-items: center; justify-content: center; width: 14rpx; height: 14rpx; box-sizing: border-box; color: #24332d; font-size: 13rpx; font-weight: 800; line-height: 1; }.map-legend-unknown { border: 2rpx solid #8c918d; border-radius: 50%; }.map-legend-reinforce::after { width: 14rpx; height: 3rpx; border-radius: 999rpx; background: #b85a08; content: ''; }.map-legend-learning { border-radius: 50%; background: #fd7c02; }.map-legend-mastered { width: 16rpx; height: 16rpx; }.map-learning-summary { display: block; margin-top: 24rpx; padding: 22rpx 24rpx; border-radius: 24rpx; background: #fff; color: #4f5e55; font-size: 22rpx; line-height: 1.7; }.map-note { display: block; padding-top: 16rpx; color: #a1a9a3; font-size: 19rpx; line-height: 1.5; }

.map-metrics { pointer-events: auto; transition: width 180ms ease, padding 180ms ease, border-radius 180ms ease; }
.map-metrics-header { display: flex; align-items: center; justify-content: space-between; gap: 12rpx; min-height: 24rpx; }
.map-metrics-title { color: #8f4a16; font-size: 17rpx; font-weight: 600; white-space: nowrap; }
.map-metrics-toggle { width: 10rpx; height: 10rpx; border-right: 2rpx solid #b3652a; border-bottom: 2rpx solid #b3652a; transform: rotate(225deg); transition: transform 180ms ease; }
.map-metrics-toggle-collapsed { transform: rotate(45deg); }
.map-metrics-collapsed { width: auto; min-width: 92rpx; padding: 9rpx 14rpx; border-radius: 999rpx; }
.map-metrics-collapsed .map-metrics-header { gap: 10rpx; }

/* Relation-mode topic detail inside the bottom sheet. */
.map-topic-head { display: flex; align-items: flex-start; gap: 14rpx; }
.map-topic-back { display: flex; flex: 0 0 auto; align-items: center; justify-content: center; width: 56rpx; height: 56rpx; margin-top: 4rpx; border: 1rpx solid #e5ebe5; border-radius: 50%; background: #fff; }
.map-topic-back-arrow { width: 15rpx; height: 15rpx; margin-left: 4rpx; border-left: 3rpx solid #24332d; border-bottom: 3rpx solid #24332d; transform: rotate(45deg); }
.map-topic-head-main { flex: 1; min-width: 0; padding-top: 2rpx; }
.map-topic-title { display: block; color: #1c2821; font-size: 31rpx; font-weight: 700; line-height: 1.3; }
.map-topic-meta { display: block; margin-top: 8rpx; overflow: hidden; color: #7f8a82; font-size: 20rpx; line-height: 26rpx; text-overflow: ellipsis; white-space: nowrap; }
.map-topic-status { flex: 0 0 auto; margin-top: 8rpx; padding: 8rpx 16rpx; border-radius: 999rpx; font-size: 19rpx; font-weight: 600; line-height: 1; }
.map-topic-status-unknown { background: #F0F2F0; color: #7c847e; }
.map-topic-status-provisional { background: #EDF2F7; color: #5E7186; }
.map-topic-status-reinforce { background: #FFF2E8; color: #B35A10; }
.map-topic-status-assessed_stable { background: #EDF5EF; color: #4B8764; }
.map-topic-status-learning { background: #FFF2E8; color: #C05E0B; }
.map-topic-status-mastered { background: #FD7C02; color: #fff; }
.map-topic-body { height: 500rpx; margin-top: 22rpx; }
.map-topic-block { padding: 22rpx 24rpx; border-radius: 24rpx; background: #fff; }
.map-topic-block + .map-topic-block { margin-top: 16rpx; }
.map-topic-block-title { display: block; color: #b35a10; font-size: 20rpx; font-weight: 700; letter-spacing: 1rpx; }
.map-topic-copy { display: block; margin-top: 12rpx; color: #4f5e55; font-size: 22rpx; line-height: 1.7; }
.map-topic-copy-muted { color: #a1a9a3; }
.map-topic-link { display: flex; align-items: baseline; justify-content: space-between; gap: 16rpx; padding: 16rpx 0 14rpx; border-bottom: 1rpx solid #f0f2ef; }
.map-topic-link:last-child { padding-bottom: 2rpx; border-bottom: 0; }
.map-topic-link-label { flex: 1; min-width: 0; overflow: hidden; color: #28372f; font-size: 23rpx; font-weight: 600; line-height: 1.4; text-overflow: ellipsis; white-space: nowrap; }
.map-topic-link-meta { flex: 0 0 auto; color: #a1a9a3; font-size: 19rpx; }
.map-topic-state { display: flex; align-items: center; justify-content: center; gap: 14rpx; min-height: 160rpx; margin-top: 22rpx; padding: 20rpx; border-radius: 24rpx; background: #fff; color: #7f8a82; font-size: 22rpx; }
.map-topic-state-dot { flex: 0 0 auto; width: 12rpx; height: 12rpx; border-radius: 50%; background: #FD7C02; animation: map-topic-pulse 1s ease-in-out infinite; }
.map-topic-retry { flex: 0 0 auto; padding: 12rpx 34rpx; border-radius: 999rpx; background: #FD7C02; color: #fff; font-size: 22rpx; font-weight: 600; }
@keyframes map-topic-pulse { 0%, 100% { opacity: .25; } 50% { opacity: 1; } }
