<view class="galaxy-host" wx:if="{{failed}}">
  <view class="state-panel">
    <view class="state-panel__mark">!</view>
    <text class="state-panel__title">知识星河暂时无法打开</text>
    <text class="state-panel__copy">{{errorMessage}}</text>
    <button class="state-panel__action pressable" bindtap="retry">重新加载</button>
    <button class="state-panel__secondary pressable" bindtap="copyGalaxyLink">复制网页链接</button>
    <button class="state-panel__secondary pressable" bindtap="goBack">返回学习宇宙</button>
  </view>
</view>

<web-view wx:if="{{launchUrl}}" src="{{launchUrl}}" binderror="onWebViewError"></web-view>
<dev-reset-fab />
