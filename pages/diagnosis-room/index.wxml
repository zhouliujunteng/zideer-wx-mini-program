<wxs module="UA" src="../../utils/ui-asset.wxs" />
<view wx:if="{{entryBlocked}}" class="agent-page">
  <view class="agent-topbar">
    <view class="agent-topbar-inner" style="height: {{navigationBarHeight}}px; padding-top: {{statusBarHeight}}px;">
      <view class="agent-back-button" bindtap="handleBack" aria-role="button" aria-label="返回">
        <view class="agent-back-icon" aria-hidden="true"></view>
      </view>
      <text class="agent-topbar-title" style="top: {{statusBarHeight}}px; height: {{navigationBarHeight}}px; line-height: {{navigationBarHeight}}px;">知鹿学习</text>
    </view>
  </view>
  <view class="agent-entry-gate" style="padding-top: {{contentTop}}px;">
    <text class="agent-entry-gate-title">请从老师的邀请进入</text>
    <text class="agent-entry-gate-copy">这个页面只能通过老师发给你的预约邀请打开。</text>
    <view class="agent-entry-gate-button" bindtap="handleEntryHome" aria-role="button" aria-label="回到首页">回到首页</view>
  </view>
</view>
<view wx:else class="agent-page">
  <view class="agent-ambient" aria-hidden="true"></view>
  <view class="agent-topbar">
    <view class="agent-topbar-inner" style="height: {{navigationBarHeight}}px; padding-top: {{statusBarHeight}}px;">
      <view class="agent-back-button" bindtap="handleBack" aria-role="button" aria-label="{{model.header.backLabel}}">
        <view class="agent-back-icon" aria-hidden="true"></view>
      </view>
      <view wx:if="{{!liveMode}}" class="agent-new-chat-button" style="width: {{menuButtonHeight}}px; height: {{menuButtonHeight}}px;" bindtap="handleNewConversation" aria-role="button" aria-label="{{model.header.newConversationLabel}}">
        <image class="agent-new-chat-icon" src="{{UA.src(ui, '../../assets/new-chat.svg')}}" mode="aspectFit" aria-hidden="true"></image>
      </view>
      <text class="agent-topbar-title" style="top: {{statusBarHeight}}px; height: {{navigationBarHeight}}px; line-height: {{navigationBarHeight}}px;">{{liveMode ? liveRoom.title : model.header.title}}</text>
    </view>
    <view wx:if="{{!liveMode}}" class="agent-history-button" style="top: {{historyTop}}px; right: {{historyRight}}px; width: {{menuButtonHeight}}px; height: {{menuButtonHeight}}px;" bindtap="openHistory" aria-role="button" aria-label="{{model.header.historyLabel}}">
      <image class="agent-history-icon" src="{{UA.src(ui, '../../assets/history.svg')}}" mode="aspectFit" aria-hidden="true"></image>
    </view>
  </view>

  <scroll-view
    class="diagnosis-room-scroll"
    scroll-y
    enhanced
    show-scrollbar="false"
    scroll-into-view="{{scrollIntoView}}"
    scroll-top="{{scrollTop}}"
    scroll-with-animation="{{false}}"
    bindscroll="handleChatScroll"
    bindtouchstart="handleChatTouchStart"
    bindtouchmove="handleChatTouchMove"
    bindtouchend="handleChatTouchEnd"
    bindtouchcancel="handleChatTouchEnd"
    style="padding-top: {{contentTop}}px;"
  >
    <view class="diagnosis-room-shell">
      <!-- 回放上一次对话时，第一条消息出来前只画气泡骨架，不先闪欢迎页 -->
      <view wx:if="{{restoring && !messages.length && !liveMode}}" class="agent-restore-skeleton" aria-hidden="true">
        <view class="sk agent-restore-bubble is-user"></view>
        <view class="sk agent-restore-bubble"></view>
        <view class="sk agent-restore-bubble is-short"></view>
      </view>
      <view wx:if="{{!messages.length && !liveMode && !restoring}}" class="agent-welcome">
        <view class="agent-welcome-avatar" aria-role="img" aria-label="知鹿智能体头像">
          <view class="agent-welcome-avatar-shape">
            <view class="agent-welcome-eye agent-welcome-eye-left"></view>
            <view class="agent-welcome-eye agent-welcome-eye-right"></view>
          </view>
        </view>
        <text class="agent-welcome-title">{{model.welcome.title}}</text>
        <view class="agent-welcome-history" bindtap="openHistory" aria-role="button" aria-label="查看历史对话">
          <image class="agent-welcome-history-icon" src="{{UA.src(ui, '../../assets/history.svg')}}" mode="aspectFit" aria-hidden="true"></image>
          <text>查看历史对话</text>
        </view>
        <view wx:if="{{model.suggestedPromptRows && model.suggestedPromptRows.length}}" class="agent-prompt-marquees" aria-label="快捷提问示例">
          <view wx:for="{{model.suggestedPromptRows}}" wx:for-item="row" wx:for-index="rowIndex" wx:key="id" class="agent-prompt-marquee agent-prompt-marquee-{{rowIndex}}">
            <view class="agent-prompt-track {{row.direction === 'reverse' ? 'is-reverse' : ''}}">
              <view wx:for="{{row.loopItems}}" wx:for-item="prompt" wx:key="id" class="agent-prompt-chip" data-id="{{prompt.sourceId || prompt.id}}" bindtap="handleSuggestion" aria-hidden="{{prompt.isClone ? 'true' : 'false'}}">
                <text>{{prompt.label}}</text>
              </view>
            </view>
          </view>
        </view>
      </view>

      <!-- 诊断室：老师约的时间还没到。可以打字，但发不出去。 -->
      <view wx:if="{{liveMode && liveRoom.phase === 'waiting'}}" class="live-room-standby" aria-live="polite">
        <image wx:if="{{liveRoom.teacherAvatarUrl}}" class="live-room-standby-avatar" src="{{liveRoom.teacherAvatarUrl}}" mode="aspectFill" aria-label="{{liveRoom.teacherName}}头像"></image>
        <view wx:else class="live-room-standby-avatar" aria-hidden="true"></view>
        <text class="live-room-standby-title">{{liveRoom.waitingTitle}}</text>
        <text class="live-room-standby-hint">{{liveRoom.waitingHint}}</text>
      </view>
      <view wx:if="{{liveMode && liveRoom.blocked}}" class="live-room-standby">
        <text class="live-room-standby-title">{{liveRoom.stateTitle}}</text>
        <text class="live-room-standby-hint">{{liveRoom.stateCopy}}</text>
        <view wx:if="{{liveRoom.retryable}}" class="agent-entry-gate-button" bindtap="retryInviteRoom" aria-role="button" aria-label="重试">重试</view>
      </view>

      <view wx:if="{{messages.length}}" class="agent-message-list">
        <view wx:for="{{messages}}" wx:key="id" id="message-{{item.id}}" class="agent-message {{item.kind ? 'agent-message-activity' : 'agent-message-' + item.role}} {{item.pending ? 'is-pending' : ''}} {{liveMode && item.role === 'assistant' && item.kind !== 'notice' ? 'is-live-stacked' : ''}}">
          <!-- 诊断室里老师的每条消息都带上他的小头像和名字 -->
          <view wx:if="{{liveMode && item.role === 'assistant' && item.kind !== 'notice'}}" class="live-msg-sender">
            <image wx:if="{{liveRoom.teacherAvatarUrl}}" class="live-msg-avatar" src="{{liveRoom.teacherAvatarUrl}}" mode="aspectFill" aria-hidden="true"></image>
            <view wx:else class="live-msg-avatar live-msg-avatar-placeholder" aria-hidden="true"></view>
            <text class="live-msg-name">{{liveRoom.teacherName}}</text>
          </view>

          <view wx:if="{{item.kind === 'thinking'}}" class="agent-activity-think {{item.streaming ? 'is-streaming' : ''}}" aria-label="思考过程">
            <view class="agent-activity-think-head">
              <view class="agent-activity-think-spinner" aria-hidden="true"></view>
              <text class="agent-activity-think-label">{{item.streaming ? '思考中' : '思考完成'}}</text>
              <text class="agent-activity-think-preview">{{item.preview || (item.streaming ? '正在梳理你的问题' : '整理好了回答')}}</text>
            </view>
          </view>

          <view wx:elif="{{item.kind === 'tool'}}" class="agent-activity-tool">
            <!-- 过程步骤只展示状态，不提供详情：调用参数与返回结果对学生没有意义 -->
            <view class="agent-activity-tool-row" aria-label="{{item.label}}">
              <view class="agent-activity-tool-dot is-{{item.state}}" aria-hidden="true"></view>
              <text class="agent-activity-tool-label">{{item.label}}</text>
              <text class="agent-activity-tool-duration" wx:if="{{item.durationText}}">{{item.durationText}}</text>
            </view>
          </view>

          <view wx:elif="{{item.kind === 'question'}}" class="agent-activity-question {{item.answered ? 'is-answered' : ''}}">
            <text class="agent-activity-question-title">{{item.question}}</text>
            <block wx:for="{{item.options}}" wx:for-item="option" wx:key="id">
              <view wx:if="{{!item.answered || option.selected || item.readonly}}" class="agent-activity-question-option {{option.selected ? 'is-selected' : ''}} {{option.isConfirm ? 'is-confirm' : ''}} {{item.multiSelect ? 'is-multi' : 'is-single'}}" data-id="{{option.id}}" data-question-id="{{item.id}}" bindtap="handleQuestionOptionTap" aria-role="{{item.multiSelect ? 'checkbox' : 'radio'}}" aria-checked="{{option.selected ? 'true' : 'false'}}" aria-label="{{option.label}}">
                <view wx:if="{{!item.answered}}" class="agent-activity-question-mark" aria-hidden="true"></view>
                <text>{{option.label}}</text>
              </view>
            </block>
            <view class="agent-activity-question-answer" wx:if="{{item.answered && item.answerText && !item.selectedCount}}">
              <text>我的回答：{{item.answerText}}</text>
            </view>
            <view class="agent-activity-question-confirm {{item.selectedCount ? '' : 'is-disabled'}}" wx:if="{{!item.answered && item.options.length}}" data-question-id="{{item.id}}" bindtap="handleQuestionConfirm" aria-role="button" aria-disabled="{{item.selectedCount ? 'false' : 'true'}}" aria-label="{{item.confirmLabel}}">
              <text>{{item.confirmLabel}}</text>
            </view>
            <text class="agent-activity-question-hint" wx:if="{{!item.answered}}">{{item.options.length ? '如果还有其他情况，也可以直接打字补充' : '直接在下方输入框打字回答即可'}}</text>
          </view>

          <view wx:elif="{{item.kind === 'stage'}}" class="agent-activity-stage {{item.generating ? 'is-generating' : ''}}" data-stage-id="{{item.stageId}}" bindtap="handleStageOpen" aria-role="link" aria-label="{{item.title}}，{{item.subtitle}}">
            <view class="agent-activity-stage-body">
              <text class="agent-activity-stage-title">{{item.title}}</text>
              <view class="agent-activity-stage-url">
                <text>{{item.subtitle}}</text>
              </view>
            </view>
            <view class="agent-activity-stage-copy">
              <text>{{item.actionLabel}}</text>
            </view>
          </view>

          <view wx:elif="{{item.kind === 'notice'}}" class="agent-activity-notice is-{{item.tone}}">
            <text>{{item.text}}</text>
          </view>

          <view wx:elif="{{item.kind === 'plan'}}" class="agent-activity-plan" aria-label="{{item.label}}：{{item.title}}，{{item.countText}}">
            <!-- 老师登记的课程方案（utils/course-plan-card.js）：系列标题 + 一两句概括 + 每节标题（2026-10-10 用户要求：不打印小纲细节），学生确认前一定看得到 -->
            <view class="agent-activity-plan-head">
              <text class="agent-activity-plan-label">{{item.label}}</text>
              <text class="agent-activity-plan-count">{{item.countText}}</text>
            </view>
            <text class="agent-activity-plan-title">{{item.title}}</text>
            <text wx:if="{{item.summary}}" class="agent-activity-plan-findings">{{item.summary}}</text>
            <view wx:for="{{item.lessons}}" wx:for-item="lesson" wx:key="key" class="agent-activity-plan-lesson">
              <view class="agent-activity-plan-lesson-head">
                <text class="agent-activity-plan-number">{{lesson.numberText}}</text>
                <text class="agent-activity-plan-lesson-title">{{lesson.title}}</text>
              </view>
            </view>
          </view>

          <view wx:elif="{{item.kind === 'voice'}}" class="agent-voice-row">
            <!-- 老师课前录好的语音：老师上线时发出来，没点开听过就带红点。
                 说明只能写在元素内部：兄弟节点之间夹注释会切断条件分支链，
                 注释后面的分支（包括最后那个兜底的文字气泡）全部不渲染。 -->
            <view class="agent-voice-line">
              <view class="agent-activity-voice {{item.playing ? 'is-playing' : ''}}" data-id="{{item.id}}" bindtap="handleVoicePlay" aria-role="button" aria-label="{{item.label}}，{{item.durationText}}{{item.unread ? '，未播放' : ''}}">
                <view class="agent-activity-voice-wave" aria-hidden="true">
                  <view class="agent-activity-voice-bar"></view>
                  <view class="agent-activity-voice-bar"></view>
                  <view class="agent-activity-voice-bar"></view>
                </view>
                <text wx:if="{{item.durationText}}" class="agent-activity-voice-duration">{{item.durationText}}</text>
              </view>
              <view wx:if="{{item.unread}}" class="agent-voice-unread" aria-hidden="true"></view>
            </view>
          </view>

          <view wx:else class="agent-message-column">
            <!-- 气泡内容三选一。诊断室里老师的文字走最后那条兜底的 wx:else，
                 和学生自己的气泡完全同一条路径：正文进 data 之前就剥成了纯文本，
                 不需要 rich-text，也不依赖 liveMode 这个标志位。
                 只有普通对话页、且确实有 markdownNodes 时才走富文本；其余一律兜底到纯文本，
                 这样任何一种情况下气泡里都不会是空的。
                 注释只能写在链外面：夹在分支之间会把链切断（tests/wxml-if-chain 盯着这件事）。 -->
            <view class="agent-message-bubble {{item.isTyping ? 'is-typing' : ''}}">
              <block wx:if="{{item.isTyping && !item.text}}">
                <view class="agent-typing"><view class="typing-dots"><view></view><view></view><view></view></view><text wx:if="{{item.typingLabel}}" class="agent-typing-label">{{item.typingLabel}}</text></view>
              </block>
              <rich-text wx:elif="{{item.role === 'assistant' && !liveMode && item.markdownNodes}}" class="agent-message-markdown" nodes="{{item.markdownNodes}}"></rich-text>
              <text wx:else class="agent-message-text">{{item.text}}</text>
              <view wx:if="{{item.role === 'assistant' && item.streamReserveLine}}" class="agent-message-stream-reserve" aria-hidden="true"><text> </text></view>
            </view>
            <view wx:if="{{liveMode && item.role === 'assistant' && !item.isTyping && !item.pending && item.text}}" class="live-msg-meta">
              <text class="live-msg-time">{{item.createdAtLabel}}</text>
              <text class="live-msg-read">已读</text>
              <view class="live-speak {{item.speakState ? 'is-' + item.speakState : ''}}" data-id="{{item.id}}" catchtap="handleSpeak" aria-role="button" aria-label="{{item.speakState === 'playing' ? '停止朗读' : '朗读这句话'}}">
                <view class="live-speak-icon" aria-hidden="true"><view class="live-speak-wave"></view></view>
                <text>{{item.speakState === 'loading' ? '准备中' : item.speakState === 'playing' ? '停止' : '朗读'}}</text>
              </view>
            </view>
            <view wx:if="{{!liveMode && item.role === 'assistant' && !item.isTyping && item.text}}" class="agent-message-actions">
              <view class="agent-message-action" data-id="{{item.id}}" data-action="copy" bindtap="handleMessageAction" aria-role="button" aria-label="复制回答">
                <image class="agent-message-action-icon" src="{{UA.src(ui, '../../assets/chat-copy.svg')}}" mode="aspectFit" aria-hidden="true"></image>
              </view>
              <view class="agent-message-action {{item.feedback === 'like' ? 'is-active' : ''}}" data-id="{{item.id}}" data-action="like" bindtap="handleMessageAction" aria-role="button" aria-label="赞">
                <image class="agent-message-action-icon" src="{{UA.src(ui, '../../assets/chat-like.svg')}}" mode="aspectFit" aria-hidden="true"></image>
              </view>
              <view class="agent-message-action {{item.feedback === 'dislike' ? 'is-active' : ''}}" data-id="{{item.id}}" data-action="dislike" bindtap="handleMessageAction" aria-role="button" aria-label="踩">
                <image class="agent-message-action-icon" src="{{UA.src(ui, '../../assets/chat-dislike.svg')}}" mode="aspectFit" aria-hidden="true"></image>
              </view>
              <view class="agent-message-action" data-id="{{item.id}}" data-action="share" bindtap="handleMessageAction" aria-role="button" aria-label="分享回答">
                <image class="agent-message-action-icon" src="{{UA.src(ui, '../../assets/chat-share.svg')}}" mode="aspectFit" aria-hidden="true"></image>
              </view>
              <text class="agent-message-time">{{item.createdAtLabel}}</text>
            </view>
          </view>
        </view>
      </view>

      <!-- 「会议已结束」固定跟在最后一条消息后面：重新打开看历史时，记录可能晚一点才到，
           写成列表里的一条消息会被后到的记录压到上面去 -->
      <view wx:if="{{liveMode && liveRoom.phase === 'closed'}}" class="agent-message agent-message-activity">
        <view class="agent-activity-notice"><text>{{liveRoom.closedNotice}}</text></view>
      </view>

      <!-- 这场已经自动结束：紧接在对话最后一条之后说明原因，学生正看着这儿，
           不用往上翻，也不再对着输入框空等 -->
      <view wx:if="{{liveMode && liveRoom.phase === 'closed'}}" class="live-room-closed" aria-live="polite">
        <text class="live-room-closed-title">诊断已结束</text>
        <text class="live-room-closed-copy">{{liveRoom.closedReason}}</text>
      </view>
    </view>
    <view id="chat-bottom" class="diagnosis-room-bottom"></view>
  </scroll-view>

  <view wx:if="{{showScrollToBottom}}" class="agent-scroll-bottom-button" style="bottom: {{scrollButtonBottom}}px;" bindtap="handleScrollToBottom" aria-role="button" aria-label="回到底部">
    <view class="agent-scroll-bottom-icon" aria-hidden="true"></view>
  </view>

  <view wx:if="{{voiceRecognizing}}" class="voice-demo-status {{voiceCancel ? 'is-canceling' : ''}}" aria-live="polite">
    <text class="voice-demo-label">{{voiceCancel ? '松手取消' : '松手发送，上移取消'}}</text>
    <view class="voice-demo-wave {{voiceSoundActive ? 'is-speaking' : 'is-silent'}}">
      <view wx:for="{{voiceBars}}" wx:key="id" class="voice-demo-bar" style="--bar-height: {{item.height}}; opacity: {{item.opacity}};"></view>
    </view>
  </view>

  <view class="keyboard-occlusion-fill" style="height: {{keyboardHeight}}px;"></view>

  <view wx:if="{{!liveRoom.observer && !liveRoom.blocked}}" class="agent-composer {{keyboardHeight > 0 ? 'is-keyboard-visible' : ''}}" style="bottom: {{keyboardHeight > 0 ? keyboardHeight : composerBottomOffset}}px;">
    <scroll-view wx:if="{{!liveMode}}" class="agent-learning-options" scroll-x enhanced show-scrollbar="{{false}}" aria-label="学习选项">
      <view class="agent-learning-options-track">
        <view class="agent-learning-chip {{includeUniverse ? 'is-active' : ''}}" catchtap="toggleUniverseOption" aria-role="switch" aria-checked="{{includeUniverse}}" aria-label="参考我的宇宙">
          <image class="agent-learning-chip-icon" src="{{UA.src(ui, '/assets/icons/network.svg')}}" mode="aspectFit" aria-hidden="true"></image>
          <text>参考我的宇宙</text>
        </view>
        <view wx:for="{{learningModes}}" wx:key="id" class="agent-learning-chip {{activeLearningMode === item.id ? 'is-active' : ''}}" data-id="{{item.id}}" catchtap="handleLearningModeTap" aria-role="radio" aria-checked="{{activeLearningMode === item.id}}" aria-label="{{item.label}}">
          <text>{{item.label}}</text>
        </view>
      </view>
    </scroll-view>
    <view
      class="agent-composer-bar {{inputActive ? 'is-input-active' : ''}} {{voiceRecognizing ? 'is-voice-active' : ''}}"
      bindtap="handleComposerTap"
      bindtouchstart="handleComposerTouchStart"
      bindtouchmove="handleComposerTouchMove"
      bindtouchend="handleComposerTouchEnd"
      bindtouchcancel="handleComposerTouchEnd"
      bindlongpress="handleComposerLongPress"
      aria-role="button"
      aria-label="{{voiceMode ? '语音输入' : (inputActive ? '输入消息' : model.composer.voiceLabel)}}"
    >
      <view wx:if="{{voiceMode}}" class="agent-voice-button agent-keyboard-button" data-control="mode-toggle" catchtap="handleKeyboardButtonTap" aria-role="button" aria-label="{{model.composer.keyboardLabel}}">
        <image class="agent-voice-icon" src="{{UA.src(ui, '../../assets/keyboard-icon.svg')}}" mode="aspectFit" data-control="mode-toggle" aria-hidden="true"></image>
      </view>
      <view wx:if="{{!voiceMode}}" class="agent-voice-button {{voiceHolding ? 'is-holding' : ''}} {{inputValue ? 'is-collapsing' : ''}}" data-control="mode-toggle" catchtap="handleVoiceButtonTap" aria-role="button" aria-label="切换到语音模式">
        <image class="agent-voice-icon" src="{{UA.src(ui, '../../assets/agent-voice.svg')}}" mode="aspectFit" data-control="mode-toggle" aria-hidden="true"></image>
      </view>
      <view wx:if="{{voiceMode}}" class="agent-voice-speak-button" data-voice-trigger="true" catchtouchstart="handleComposerTouchStart" catchtouchmove="handleComposerTouchMove" catchtouchend="handleComposerTouchEnd" catchtouchcancel="handleComposerTouchEnd" catchlongpress="handleComposerLongPress" aria-role="button" aria-label="{{model.composer.speakLabel}}">
        <text>{{model.composer.speakLabel}}</text>
      </view>
      <text wx:if="{{!voiceMode && !inputValue && !inputActive}}" class="agent-input agent-input-placeholder">{{model.composer.placeholder}}</text>
      <input
        wx:if="{{!voiceMode && (inputActive || inputValue)}}"
        class="agent-input"
        value="{{inputValue}}"
        maxlength="{{model.composer.maxLength}}"
        focus="{{inputFocus}}"
        adjust-position="{{false}}"
        cursor-spacing="24"
        show-confirm-bar="{{false}}"
        confirm-type="send"
        bindinput="handleInput"
        bindconfirm="handleSend"
        bindfocus="handleInputFocus"
        bindblur="handleInputBlur"
        bindkeyboardheightchange="handleKeyboardHeightChange"
        disabled="{{isSending}}"
      />
      <!-- 诊断室里对面是老师：老师回话时发送键只是暂时灰着，不变成「停止生成」 -->
      <view class="agent-send-button {{canSend ? 'is-enabled' : ''}} " catchtap="handleSendOrStop" aria-role="button" aria-label="{{model.composer.sendLabel}}">
        <image class="agent-send-icon" src="{{UA.src(ui, '../../assets/agent-send.svg')}}" mode="aspectFit" aria-hidden="true"></image>
      </view>
    </view>
  </view>
  <view wx:if="{{!liveRoom.blocked}}" class="agent-composer-note-background" aria-hidden="true"></view>
  <text wx:if="{{!liveRoom.blocked && (voiceRecognizing || !liveMode || liveRoom.phase === 'waiting' || liveRoom.composerNote)}}" class="agent-composer-note">{{voiceRecognizing ? model.composer.voiceActiveNote : (liveMode ? (liveRoom.phase === 'waiting' ? liveRoom.sendBlockedHint : liveRoom.composerNote) : model.privacy.warningLabel)}}</text>

  <view wx:if="{{historyVisible}}" class="history-sheet-layer {{historyClosing ? 'is-closing' : ''}}" catchtap="closeHistory">
    <view class="history-sheet" catchtap="stopTap" aria-modal="true" aria-label="{{model.history.title}}">
      <view class="history-sheet-handle"></view>
      <view class="history-sheet-header">
        <text class="history-sheet-title">{{model.history.title}}</text>
        <view class="history-sheet-close" bindtap="closeHistory" aria-label="关闭">×</view>
      </view>
      <view class="history-search">
        <view class="history-search-icon" aria-hidden="true"></view>
        <input class="history-search-input" value="{{historySearch}}" placeholder="{{model.history.searchPlaceholder}}" placeholder-class="history-search-placeholder" bindinput="handleHistorySearch" />
        <text wx:if="{{historySearch}}" class="history-search-clear" bindtap="clearHistorySearch">×</text>
      </view>
      <scroll-view class="history-list" scroll-y enhanced show-scrollbar="false">
        <view wx:if="{{historyLoading}}" class="history-section" aria-hidden="true">
          <view wx:for="{{[1, 2, 3, 4]}}" wx:key="*this" class="history-item"><view class="history-item-copy"><view class="sk sk-line sk-mid"></view><view class="sk sk-line sk-short"></view></view></view>
        </view>
        <view wx:elif="{{historySections.length}}">
          <view wx:for="{{historySections}}" wx:for-item="section" wx:key="key" class="history-section">
            <text class="history-section-title">{{section.label}}</text>
            <view wx:for="{{section.items}}" wx:for-item="item" wx:key="id" class="history-item {{item.id === activeHistoryId ? 'is-active' : ''}}" data-id="{{item.id}}" bindtap="handleHistoryPick">
              <view class="history-item-copy"><text class="history-item-title">{{item.title}}</text><text class="history-item-time">{{item.time}}</text></view>
              <view class="history-item-arrow"></view>
            </view>
          </view>
        </view>
        <view wx:else class="history-empty">{{historyNotice || model.history.emptyText}}</view>
      </scroll-view>
      <text class="history-sheet-note">点选任意一条，继续之前的对话</text>
    </view>
  </view>
</view>

<dev-reset-fab />
