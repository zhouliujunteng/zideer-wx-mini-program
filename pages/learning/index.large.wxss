.quest-banner-title{margin-top:2px;font-size:18px;font-weight:800;line-height:1.35}
.quest-banner-sub{margin-top:3px;font-size:13px;line-height:1.45}
.quest-banner-progress{flex:0 0 auto;padding:4px 10px;border-radius:599px;background:rgba(255, 255, 255, .22);font-size:14px;font-weight:800}
.quest-track{padding:12px 0 4px}
.quest-row{flex-direction:column}
.quest-lesson{max-width:80%;margin:15px 0 3px;padding:3px 12px;border-radius:599px;background:#F2F1EE;font-size:13px;text-align:center;text-overflow:ellipsis}
.quest-node-wrap{flex-direction:column;margin:8px 0;transform:translateX(calc(var(--x) * 600px / 1000))}
.quest-node{width:79px;height:74px;border-radius:50%;background:#E5E3DF;box-shadow:0 6px 0 #CBC8C2}
.quest-node:active{transform:translateY(3px);box-shadow:0 2px 0 #CBC8C2}
.quest-node.is-done{background:var(--tone);box-shadow:0 6px 0 var(--tone-deep)}
.quest-node.is-open, .quest-node.is-current{background:var(--tone);box-shadow:0 6px 0 var(--tone-deep)}
.quest-node.is-current{outline:4px solid var(--tone-soft)}
.quest-node.is-done:active, .quest-node.is-open:active, .quest-node.is-current:active{box-shadow:0 2px 0 var(--tone-deep)}
.quest-node.kind-chest, .quest-node.kind-review{border-radius:20px}
.quest-node.kind-review.is-open{background:#23A391;box-shadow:0 6px 0 #17806F}
.quest-node.kind-chest.is-done{background:#F5B301;box-shadow:0 6px 0 #C98F00}
.quest-node-label{margin-top:10px;font-size:14px;font-weight:700}
.quest-node-detail{margin-top:1px;max-width:180px;font-size:12px;text-align:center}
.quest-start{top:-35px;padding:4px 13px;border:1px solid #ECE9E4;border-radius:9px;background:#FFFFFF;font-size:14px;font-weight:800}
.quest-start::after{bottom:-8px;left:50%;width:10px;height:10px;border-right:1px solid #ECE9E4;border-bottom:1px solid #ECE9E4;background:#FFFFFF;transform:translateX(-50%) rotate(45deg)}
@keyframes quest-bob{0%, 100%{transform:translateY(0)}50%{transform:translateY(-5px)}}
.quest-icon{width:31px;height:31px}
.icon-play::before{top:3px;left:8px;border-top:12px solid transparent;border-bottom:12px solid transparent;border-left:18px solid #FFFFFF}
.icon-pencil::before{top:2px;left:12px;width:8px;height:24px;border-radius:2px 2px 0 0;background:#FFFFFF;transform:rotate(40deg)}
.icon-pencil::after{top:22px;left:4px;border-top:4px solid transparent;border-bottom:4px solid transparent;border-right:7px solid #FFFFFF;transform:rotate(-50deg)}
.icon-mic::before{top:0;left:9px;width:13px;height:19px;border-radius:6px;background:#FFFFFF}
.icon-mic::after{top:10px;left:4px;width:18px;height:13px;border:3px solid #FFFFFF;border-top:0;border-radius:0 0 10px 10px}
.icon-check::before{top:1px;left:9px;width:9px;height:19px;border-right:4px solid #FFFFFF;border-bottom:4px solid #FFFFFF;transform:rotate(45deg)}
.icon-lock::before{top:1px;left:7px;width:12px;height:12px;border:3px solid #A9A59E;border-bottom:0;border-radius:9px 9px 0 0}
.icon-lock::after{top:13px;left:3px;width:24px;height:16px;border-radius:3px;background:#A9A59E}
.icon-review::before{top:2px;left:2px;width:20px;height:20px;border:4px solid #FFFFFF;border-right-color:transparent;border-radius:50%}
.icon-review::after{top:2px;right:2px;border-top:6px solid transparent;border-bottom:6px solid transparent;border-left:8px solid #FFFFFF;transform:rotate(60deg)}
.icon-chest::before, .icon-chest-open::before{top:10px;left:1px;width:28px;height:18px;border-radius:2px 2px 4px 4px;background:#A9A59E}
.icon-chest::after{top:3px;left:1px;width:28px;height:8px;border-radius:7px 7px 1px 1px;background:#BDB9B2}
.icon-chest-open::before{background:#FFFFFF}
.icon-chest-open::after{top:-3px;left:1px;width:28px;height:8px;border-radius:7px 7px 1px 1px;background:#FFF4C7;transform:rotate(-16deg)}
.quest-start{top:-58px}
.quest-ring{top:-15px;left:50%;width:108px;height:108px;margin-left:-54px;border-radius:50%;background:conic-gradient(var(--tone) calc(var(--ring) * 1%), #E5E3DF 0);-webkit-mask:radial-gradient(circle, transparent 45px, #000 46px);mask:radial-gradient(circle, transparent 45px, #000 46px)}
.quest-halo{top:-4px;right:-4px;bottom:-4px;left:-4px;border:3px solid var(--tone);border-radius:50%}
.quest-anchor{top:-252px;width:0.5px;height:0.5px}
.quest-burst{top:-6px;left:50%;width:91px;height:91px;margin-left:-46px;border:6px solid var(--tone);border-radius:50%;box-sizing:border-box}
.quest-burst::after{top:-6px;right:-6px;bottom:-6px;left:-6px;border:3px solid var(--tone);border-radius:50%}
.quest-node.kind-lesson-chest{border-radius:20px}
.quest-node.kind-lesson-chest.is-open{background:#F5B301;box-shadow:0 6px 0 #C98F00}
.quest-node.kind-lesson-chest.is-open:active{box-shadow:0 2px 0 #C98F00}
.quest-node.kind-lesson-chest.is-done{background:#FCE7A6;box-shadow:0 6px 0 #E3C468}
.quest-node.kind-lesson-chest.is-open .icon-chest::before{background:#FFFFFF}
.quest-node.kind-lesson-chest.is-open .icon-chest::after{background:#FFF4C7}
.quest-node.kind-lesson-chest.is-done .icon-chest-open::before{background:#E0A800}
.quest-node.kind-lesson-chest.is-done .icon-chest-open::after{background:#F5C842}
.quest-pop{top:90px;left:50%;width:360px;padding:18px 19px 19px;border-radius:16px;background:var(--tone);box-sizing:border-box;transform:translateX(calc(-50% - var(--x) * 600px / 1000));transform-origin:calc(50% + var(--x) * 600px / 1000) 0}
@keyframes quest-pop-in{from{opacity:0;transform:translateX(calc(-50% - var(--x) * 600px / 1000)) scale(.7)}to{opacity:1;transform:translateX(calc(-50% - var(--x) * 600px / 1000)) scale(1)}}
.quest-pop-arrow{top:-9px;left:calc(50% + var(--x) * 600px / 1000);width:18px;height:18px;margin-left:-9px;border-radius:2px;background:var(--tone);transform:rotate(45deg)}
.quest-pop-title{font-size:19px;font-weight:800}
.quest-pop-course{margin-top:3px;font-size:14px;font-weight:600}
.quest-pop-meta{margin-top:3px;font-size:13px}
.quest-pop-button{height:50px;margin-top:14px;border-radius:13px;background:#FFFFFF;box-shadow:0 4px 0 rgba(0, 0, 0, .14);font-size:18px;font-weight:800;letter-spacing:1px}
.quest-pop-button:active{transform:translateY(3px);box-shadow:0 1px 0 rgba(0, 0, 0, .14)}
.quest-pop.is-muted{border:1px solid #ECE9E4;background:#FFFFFF}
.quest-pop.is-muted .quest-pop-arrow{top:-11px;border-top:1px solid #ECE9E4;border-left:1px solid #ECE9E4;background:#FFFFFF}
.quest-pop-note{margin-top:10px;padding:10px 12px;border-radius:10px;background:#F4F3F0;font-size:14px;line-height:1.5}
.quest-jump{right:calc(max(0px, 50% - var(--lg-col) / 2) + 19px);bottom:calc(49px + env(safe-area-inset-bottom) + 16px);width:57px;height:57px;border:1px solid #ECE9E4;border-radius:50%;background:#FFFFFF;box-shadow:0 3px 0 #E1DED8}
.quest-jump:active{transform:translateY(2px);box-shadow:0 1px 0 #E1DED8}
.quest-jump-arrow{width:15px;height:15px;margin-top:-6px;border-right:4px solid #FD7C02;border-bottom:4px solid #FD7C02;border-radius:1px;transform:rotate(45deg)}
.chest-reveal{top:0;right:max(0px, 50% - var(--lg-col) / 2);bottom:0;left:max(0px, 50% - var(--lg-col) / 2);flex-direction:column;padding:0 38px;background:rgba(20, 26, 24, .78);box-shadow:0 0 0 100vmax rgba(20, 26, 24, .78)}
.chest-stage{width:276px;height:276px}
.chest-rays{top:-36px;right:-36px;bottom:-36px;left:-36px;border-radius:50%;background:repeating-conic-gradient(rgba(255, 214, 120, .42) 0deg 11deg, rgba(255, 214, 120, 0) 11deg 30deg);-webkit-mask:radial-gradient(circle, #000 30%, transparent 70%);mask:radial-gradient(circle, #000 30%, transparent 70%)}
.chest-box{bottom:42px;left:50%;width:144px;height:120px;margin-left:-72px}
@keyframes chest-drop{0%{opacity:0;transform:translateY(-192px)}60%{opacity:1;transform:translateY(7px)}100%{transform:translateY(0)}}
.chest-lid{top:0;left:0;width:144px;height:50px;border-radius:24px 24px 7px 7px;background:linear-gradient(180deg, #FFC56B, #FD7C02);box-shadow:inset 0 -5px 0 rgba(0, 0, 0, .12);transform-origin:12px 50px}
.chest-lid-band, .chest-body::before{top:0;bottom:0;left:50%;width:21px;margin-left:-11px;background:#F5C842}
@keyframes chest-lid-off{0%{transform:translate(0, 0) rotate(0)}100%{opacity:.0;transform:translate(-54px, -144px) rotate(-42deg)}}
.chest-body{bottom:0;left:0;width:144px;height:76px;border-radius:6px 6px 16px 16px;background:linear-gradient(180deg, #F08A12, #C95F00);box-shadow:0 7px 0 rgba(0, 0, 0, .25)}
.chest-lock{top:10px;left:50%;width:31px;height:33px;margin-left:-16px;border-radius:7px;background:#FFF4C7;box-shadow:inset 0 -4px 0 #E0B84A}
.chest-spark{top:50%;left:50%;width:13px;height:13px;margin:-7px 0 0 -7px;border-radius:50%;background:#FFE08A}
.spark-1{background:#FFFFFF}
.spark-3{background:#FFB25B}
.spark-5{background:#FFFFFF}
.spark-7{background:#FFB25B}
@keyframes chest-spark{0%{opacity:1;transform:rotate(var(--a)) translateY(0) scale(1)}100%{opacity:0;transform:rotate(var(--a)) translateY(-138px) scale(.4)}}
.chest-reward{top:24px;left:50%;width:120px;margin-left:-60px;flex-direction:column}
@keyframes chest-reward{0%{opacity:0;transform:translateY(90px) scale(.3)}100%{opacity:1;transform:translateY(0) scale(1)}}
.chest-reward-card{width:67px;height:88px;border:3px solid #FFFFFF;border-radius:10px;background:linear-gradient(150deg, #7C9CFF, #FD7C02);box-shadow:0 6px 14px rgba(0, 0, 0, .3);transform:rotate(-8deg)}
.chest-reward-count{margin-top:7px;font-size:33px;font-weight:900;text-shadow:0 2px 0 rgba(0, 0, 0, .25)}
.chest-title{margin-top:7px;font-size:26px;font-weight:900}
.chest-copy{margin-top:7px;font-size:16px;text-align:center;line-height:1.5}
.chest-opening{margin-top:14px}
.chest-wallet{margin-top:13px;gap:6px;padding:7px 15px;border-radius:599px;background:rgba(255, 255, 255, .12);font-size:15px}
.chest-wallet-num{font-size:20px;font-weight:900}
@keyframes chest-num{0%{transform:translateY(-15px) scale(1.5);opacity:.3}100%{transform:translateY(0) scale(1);opacity:1}}
.chest-button{width:100%;max-width:336px;height:55px;margin-top:31px;border-radius:14px;background:#FD7C02;box-shadow:0 4px 0 #C95F00;font-size:19px;font-weight:800}
.chest-button:active{transform:translateY(3px);box-shadow:0 1px 0 #C95F00}
.chest-secondary{margin-top:16px;padding:7px 14px;font-size:16px;font-weight:700}
.learning-page .my-courses-section{max-width:720px;margin-left:auto;margin-right:auto}
}
