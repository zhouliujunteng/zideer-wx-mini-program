<wxs module="UA" src="../../utils/ui-asset.wxs" />
<view class="learning-page">
  <view class="learning-topbar {{topbarOnHero ? 'learning-topbar-hero' : ''}}">
    <view class="learning-topbar-inner" style="height: {{navigationBarHeight}}px; padding-top: {{statusBarHeight}}px;">
      <text class="learning-topbar-title">学习</text>
    </view>
    <streak-entry top="{{streakEntryTop}}" right="{{streakEntryRight}}" size="{{menuButtonHeight}}" />
  </view>

<scroll-view class="page-scroll" scroll-y scroll-with-animation scroll-into-view="{{courseScrollAnchor}}" bindscroll="handlePageScroll" upper-threshold="60" bindscrolltoupper="handleScrollToUpper" style="padding-top: {{contentTop}}px;">
  <view class="page-shell">
    <!-- 学习页头图 + 成就卡横条（2026-10-13，参考某运动 App 首页）：一句话由后台「成就卡」页维护、按天轮换；
         右侧一叠卡片是纯样式。点横条里的卡直接在本页翻转飞出详情（components/card-reveal）。 -->
    <view class="learn-hero">
      <!-- 一句话由后台按天轮换；没登录、没建档、读取失败时用固定文案 -->
      <view class="learn-hero-copy">
        <view wx:if="{{!loaded || (access === 'ready' && !cardsLoaded && !cardsFailed)}}" class="sk learn-hero-pill-sk"></view>
        <view wx:elif="{{access === 'ready' && cardsLoaded}}" class="learn-hero-pill {{cards.drawsAvailable ? '' : 'learn-hero-pill-empty'}}" bindtap="openAllCards" role="button">
          <view class="learn-hero-pill-card"></view>
          <text class="learn-hero-pill-count">×{{cards.drawsAvailable}}</text>
          <view class="learn-hero-pill-split"></view>
          <text>去抽卡</text>
          <text class="learn-hero-pill-chevron">›</text>
        </view>
        <block wx:if="{{!loaded || (access === 'ready' && !cardsLoaded && !cardsFailed)}}"><view class="sk sk-line learn-hero-sk"></view><view class="sk sk-line sk-mid learn-hero-sk"></view></block>
        <text wx:elif="{{access === 'ready' && cardsLoaded && cards.quote}}" class="learn-hero-quote">{{cards.quote}}</text>
        <text wx:else class="learn-hero-quote">学一点点，集一张张，攒出你的成就卡。</text>
      </view>
      <!-- 右侧一叠斜放的卡片（纯样式，不用图片素材）；有卡图时最上面那张换成最近点亮的卡 -->
      <view class="learn-hero-deck" bindtap="openAllCards" aria-hidden="true">
        <view class="learn-hero-deck-card learn-hero-deck-back2"></view>
        <view class="learn-hero-deck-card learn-hero-deck-back1"></view>
        <view class="learn-hero-deck-card learn-hero-deck-front" style="--ac-color: {{heroCard ? heroCard.color : '#FD7C02'}};">
          <image wx:if="{{heroCard && heroCard.cover}}" class="learn-hero-deck-image" src="{{heroCard.cover}}" mode="aspectFill"></image>
          <text wx:else class="learn-hero-deck-mark">知鹿</text>
        </view>
      </view>
    </view>

    <view wx:if="{{!(cardsLoaded && access === 'ready' && !cards.series.length)}}" class="ach-strip-section">
      <view class="ach-strip-head" bindtap="openAllCards" role="button" aria-label="查看全部成就卡">
        <text class="ach-strip-title">成就卡<text wx:if="{{cardsLoaded && access === 'ready'}}" class="ach-strip-count"> {{cards.ownedLevels}}</text></text>
        <view class="ach-strip-line"></view>
        <text class="ach-strip-all">全部</text>
        <text class="ach-strip-chevron">›</text>
      </view>
      <view wx:if="{{loaded && access !== 'ready'}}" class="access-prompt ach-access-prompt">
        <view class="access-prompt-copy">
          <text class="access-prompt-title">{{access === 'guest' ? '登录后开始集卡' : '完善学习资料后开始集卡'}}</text>
          <text class="access-prompt-subtitle">学完课程、坚持打卡、通过验收，都能拿到抽卡机会</text>
        </view>
        <view class="access-prompt-action" bindtap="openAccessStep" role="button">{{access === 'guest' ? '去登录' : '去完善'}}</view>
      </view>
      <view wx:elif="{{!cardsLoaded && !cardsFailed}}" class="ach-strip-scroll ach-strip-sk-row" aria-hidden="true">
        <view class="ach-strip">
          <view wx:for="{{[0, 1, 2, 3, 4]}}" wx:key="*this" class="ach-strip-item"><view class="sk ach-strip-sk"></view></view>
        </view>
      </view>
      <text wx:elif="{{!cardsLoaded}}" class="ach-strip-empty" bindtap="loadCards">成就卡暂时没有读到，点这里重试</text>
      <scroll-view wx:else class="ach-strip-scroll" scroll-x="true" show-scrollbar="false" enhanced="true">
        <view class="ach-strip">
          <view wx:for="{{stripCards}}" wx:key="id" class="ach-strip-item" id="strip-card-{{item.id}}" data-id="{{item.id}}" bindtap="openStripCard">
            <view class="ach-strip-card {{openCardId === item.id ? 'ach-strip-away' : ''}}" style="--ac-color: {{item.color}};">
              <view class="ac-face {{item.ownedLevels ? '' : 'ac-face-dim'}}">
                <text class="ac-face-tag">{{item.title}}</text>
                <view class="ac-face-art">
                  <image wx:if="{{item.cover}}" class="ac-face-image" src="{{item.cover}}" mode="aspectFill"></image>
                  <view wx:else class="ac-face-placeholder"><text class="ac-face-placeholder-title">{{item.title}}</text><text class="ac-face-placeholder-no">#{{item.coverNo}}</text></view>
                </view>
              </view>
            </view>
          </view>
        </view>
      </scroll-view>
    </view>

    <view class="tablet-study-summary">
    <view class="calendar-heading">
      <text class="calendar-title">{{model.calendarTitle}}</text>
      <view class="calendar-chevron">›</view>
      <view wx:if="{{model.calendarShortcutLabel}}" class="calendar-shortcut-pill">{{model.calendarShortcutLabel}}</view>
      <text wx:if="{{model.canReturnToToday}}" class="calendar-return-today" bindtap="returnToToday">回到今日</text>
    </view>

    <view class="calendar-days-slot">
      <scroll-view class="study-date-strip" scroll-x="true" show-scrollbar="false" enhanced="true" scroll-into-view="{{calendarScrollAnchor}}">
        <view class="study-date-list">
          <view wx:for="{{model.studyTaskCalendar}}" wx:for-index="dayIndex" wx:key="id" id="study-day-{{dayIndex}}" class="study-date {{item.hasTask ? 'study-date-has-task' : ''}}" data-index="{{dayIndex}}" bindtap="handleStudyDateSelect">
            <view class="study-date-tile {{item.isSelected ? 'study-date-selected' : ''}}">
              <text class="study-date-value">{{item.date}}</text>
              <text class="study-date-label">{{item.label}}</text>
            </view>
            <view wx:if="{{item.hasTask}}" class="study-date-task-dot"></view>
          </view>
        </view>
      </scroll-view>
    </view>

    <view class="learning-overview-panel {{showTodayOverview ? 'learning-overview-expanded' : 'learning-overview-collapsed'}}">
      <view class="overview-grid">
        <view wx:for="{{model.overview}}" wx:key="label" class="overview-item" aria-label="{{item.label}}">
          <image class="overview-icon" src="{{UA.src(ui, item.icon)}}" mode="aspectFit"></image>
          <view class="overview-copy">
            <view wx:if="{{!loaded}}" class="overview-value"><view class="sk sk-inline overview-value-skeleton"></view></view>
            <view wx:elif="{{access !== 'ready'}}" class="overview-value"><text class="overview-value-empty">—</text></view>
            <view wx:else class="overview-value">
              <view wx:for="{{item.rollDigits}}" wx:for-item="digit" wx:for-index="digitIndex" wx:key="digitIndex" class="overview-digit-window">
                <view class="overview-digit-track {{item.rollDirection}} {{numberRollClass}}">
                  <text class="overview-digit">{{digit.first}}</text>
                  <text class="overview-digit">{{digit.second}}</text>
                </view>
              </view>
              <text class="overview-unit">{{item.unit}}</text>
            </view>
            <text class="overview-label">{{item.label}}</text>
          </view>
        </view>
      </view>
    </view>

    <view class="study-tasks-section {{showTodayOverview ? 'study-tasks-with-overview' : ''}}">
      <view class="tasks-heading">
        <text class="tasks-title">学习任务</text>
      </view>
      <!-- 未登录、没完善学习资料（2026-09-27 起未登录也能浏览）：没有学习任务可读，换成去登录 / 去完善的提示 -->
      <view wx:if="{{loaded && access !== 'ready'}}" class="access-prompt study-access-prompt">
        <view class="access-prompt-copy">
          <text class="access-prompt-title">{{access === 'guest' ? '登录后查看学习任务' : '请先完善学习资料'}}</text>
          <text class="access-prompt-subtitle">{{access === 'guest' ? '学习任务、我的课程和学习数据都会显示在这里' : '完善后，学习任务和你的课程会显示在这里'}}</text>
        </view>
        <view class="access-prompt-action" bindtap="openAccessStep" role="button" aria-label="{{access === 'guest' ? '去登录' : '去完善学习资料'}}">{{access === 'guest' ? '去登录' : '去完善'}}</view>
      </view>
      <view wx:else class="study-task-list-card">
        <view class="study-task-list-shell {{taskListClass}}" style="--list-height: {{taskListHeight}};">
          <view wx:if="{{!loaded && !loadFailed}}" class="study-task-item" aria-label="学习任务加载中">
            <view class="study-task-side-pill sk"></view>
            <view class="study-task-body"><view class="sk sk-line sk-mid"></view><view class="sk sk-line sk-short study-task-skeleton-meta"></view></view>
          </view>
          <text wx:elif="{{!loaded}}" class="study-task-empty">学习数据暂时没有读到，下拉刷新重试</text>
          <block wx:elif="{{model.studyTasks.length > 0}}">
            <view wx:for="{{model.studyTasks}}" wx:key="id" class="study-task-item" data-id="{{item.id}}" data-kind="{{item.kind}}" data-stage-id="{{item.stageId}}" data-scene-id="{{item.sceneId}}" data-done="{{item.done}}" bindtap="openTask">
              <view class="study-task-side-pill" style="background: {{item.sidePillColor}};"></view>
              <view class="study-task-body">
                <text class="study-task-title">{{item.title}}</text>
                <text class="study-task-meta">{{item.meta}}</text>
              </view>
              <view class="progress-ring study-task-ring" style="background: conic-gradient(#FD7C02 {{item.progress}}%, rgba(253, 124, 2, 0.14) 0);">
                <view class="progress-ring-inner"><text>{{item.progress}}%</text></view>
              </view>
            </view>
          </block>
          <text wx:else class="study-task-empty">{{model.studyTaskEmptyText}}</text>
        </view>
      </view>
    </view>

    </view>
    <!-- 「我的课程」与首页「会员课程」同一套卡片（styles/course-grid.wxss），搜索框同会员课程全部页。
         点课程进入课程页（学习课程 / 去验收），卡片上不放验收按钮。 -->
    <!-- 闯关学习（2026-11-11 用户规则，多邻国式）：「我的定制课程」默认画成闯关路径——定制课程按目标导图分段，每节课三关
         （看课 → 互动练习 → AI 老师验收），段末复习关和宝箱。数据 /api/learn/quest-path，模型 utils/quest-path-view.js；
         搜索时仍按课程卡片列出。 -->
    <view id="my-courses-anchor" class="my-courses-section">
      <view class="tasks-heading">
        <text class="tasks-title">我的课程</text>
        <view class="task-all-link" bindtap="openLibrary" role="button" aria-label="进入课程库"><text>课程库</text><view class="task-all-icon" aria-hidden="true"></view></view>
      </view>
      <!-- 原「我的 › 知鹿服务」的企微服务卡片，2026-09-25 移到这里并改名（用户要求）。只有一个客服入口时直接打开企微客服，否则进服务入口页。 -->
      <view class="enterprise-service-card" bindtap="openEnterpriseService" role="button" aria-label="联系老师定制课程">
        <image class="enterprise-service-avatar" src="{{UA.src(ui, '/assets/me/service-advisor.png')}}" mode="aspectFill"></image>
        <view class="enterprise-service-copy">
          <text class="enterprise-service-title">联系老师定制课程</text>
          <text class="enterprise-service-description">老师按你的学习情况定制课程</text>
        </view>
        <view class="enterprise-service-action">
          <text class="enterprise-service-hours">9:00-18:00</text>
          <view class="enterprise-service-go"><text class="enterprise-service-arrow">›</text></view>
        </view>
      </view>
      <view wx:if="{{!loaded || access === 'ready'}}" class="course-search my-courses-search">
        <image class="course-search-icon" src="{{UA.src(ui, '/assets/course-library/search.svg')}}" mode="aspectFit" aria-hidden="true"></image>
        <input class="course-search-input" value="{{courseSearch}}" placeholder="搜索课程" confirm-type="search" maxlength="100" bindinput="searchMyCourses" bindconfirm="searchMyCourses" />
        <view wx:if="{{courseSearch}}" class="course-search-clear" bindtap="clearMyCourseSearch" role="button" aria-label="清除搜索">×</view>
      </view>
      <!-- 「我的课程」两栏（2026-10-06）：全部课程 / 我的定制课程。「我的定制课程」分未学、已学，按系列（一次定制的几节课）分组。 -->
      <view wx:if="{{loaded && access === 'ready'}}" class="my-course-tabs" role="tablist">
        <view wx:for="{{myCourseTabs}}" wx:key="id" class="my-course-tab {{item.active ? 'is-active' : ''}}" data-id="{{item.id}}" bindtap="switchMyCourseTab" role="tab" aria-selected="{{item.active}}">{{item.label}}</view>
      </view>
      <text wx:if="{{loaded && access !== 'ready'}}" class="my-courses-empty">{{access === 'guest' ? '登录后，制作中和已完成的课程都会显示在这里' : '完善学习资料后，你的课程会显示在这里'}}</text>
      <view wx:elif="{{!loaded && !loadFailed}}" class="more-courses-grid" aria-label="课程加载中">
        <view wx:for="{{[0, 1]}}" wx:key="*this" class="more-course-card">
          <view class="more-course-cover sk"></view>
          <view class="more-course-info"><view class="more-course-copy my-course-skeleton-copy"><view class="sk sk-line sk-mid"></view><view class="sk sk-line sk-short my-course-skeleton-sub"></view></view></view>
        </view>
      </view>
      <text wx:elif="{{!loaded}}" class="my-courses-empty">课程暂时没有读到，下拉刷新重试</text>
      <view wx:elif="{{myCourseTab === 'custom' && !courseSearch}}" class="quest">
        <view wx:if="{{!questLoaded && !questFailed}}" class="quest-sk" aria-label="闯关路径加载中">
          <view class="sk quest-sk-goal"></view>
          <view wx:for="{{[0, 90, 150, 90, 0]}}" wx:key="index" class="quest-node-wrap" style="--x: {{item}};"><view class="sk sk-round quest-sk-node"></view></view>
        </view>
        <text wx:elif="{{!questLoaded}}" class="my-courses-empty" bindtap="retryQuest">闯关路径暂时没有读到，点这里重试</text>
        <block wx:else>
          <view wx:if="{{quest.goal}}" class="quest-goal">
            <text class="quest-goal-label">我的目标</text>
            <text class="quest-goal-title">{{quest.goal.title}}</text>
            <view wx:if="{{quest.hasLessons}}" class="quest-goal-bar"><view class="quest-goal-fill" style="width: {{quest.percent}}%;"></view></view>
            <text wx:if="{{quest.progressText}}" class="quest-goal-progress">{{quest.progressText}}</text>
          </view>
          <view wx:if="{{!quest.sections.length}}" class="quest-empty">
            <text class="quest-empty-title">还没有定制课程</text>
            <text class="quest-empty-copy">先在「目标」里定好目标、做个测评，老师会按你的目标一段一段定制课程，学完一关解锁下一关。</text>
          </view>
          <view wx:for="{{quest.sections}}" wx:for-item="section" wx:key="id" class="quest-section tone-{{section.tone}}">
            <view class="quest-banner">
              <view class="quest-banner-copy">
                <text class="quest-banner-no">第 {{section.number}} 段</text>
                <text class="quest-banner-title">{{section.title}}</text>
                <text wx:if="{{section.subtitle}}" class="quest-banner-sub">{{section.subtitle}}</text>
              </view>
              <text wx:if="{{section.progress}}" class="quest-banner-progress">{{section.progress}}</text>
            </view>
            <view class="quest-track">
              <view wx:for="{{section.nodes}}" wx:key="id" class="quest-row">
                <text wx:if="{{item.lessonTitle}}" class="quest-lesson">{{item.lessonTitle}}</text>
                <view class="quest-node-wrap" style="--x: {{item.offset}};">
                  <view wx:if="{{item.id === quest.currentId}}" class="quest-start">开始</view>
                  <view class="quest-node is-{{item.state}} kind-{{item.kind}}" data-id="{{item.id}}" bindtap="openQuestNode" role="button" aria-label="{{item.label}}，{{item.detail}}">
                    <view class="quest-icon icon-{{item.icon}}"></view>
                  </view>
                  <text class="quest-node-label">{{item.label}}</text>
                  <text wx:if="{{item.detail}}" class="quest-node-detail">{{item.detail}}</text>
                </view>
              </view>
            </view>
          </view>
        </block>
      </view>
      <block wx:elif="{{myCourseTab === 'custom'}}">
        <view class="custom-filter-row" role="tablist" aria-label="定制课程学习状态">
          <view wx:for="{{customView.filters}}" wx:key="id" class="custom-filter {{item.active ? 'is-active' : ''}}" data-id="{{item.id}}" bindtap="switchCustomFilter" role="tab" aria-selected="{{item.active}}"><text>{{item.label}}</text><text class="custom-filter-count">{{item.count}}</text></view>
        </view>
        <view wx:if="{{customView.count > 0}}" class="custom-series-list">
          <view wx:for="{{customView.groups}}" wx:for-item="group" wx:key="id" class="custom-series-group">
            <view wx:if="{{group.title}}" class="custom-series-heading"><text class="custom-series-title">{{group.title}}</text><text class="custom-series-meta">{{group.meta}}</text></view>
            <view class="more-courses-grid">
              <view wx:for="{{group.courses}}" wx:key="id" class="more-course-card {{item.id === focusCourseId ? 'is-focused' : ''}}" data-id="{{item.id}}" data-kind="{{item.kind}}" bindtap="openMyCourse" role="button" aria-label="打开课程 {{item.title}}">
                <view class="more-course-cover more-course-cover-{{item.tone}}"><image wx:if="{{item.coverUrl}}" class="more-course-cover-image" src="{{UA.src(ui, item.coverUrl)}}" mode="aspectFill" lazy-load="true"></image><text wx:else class="more-course-cover-mark">知鹿</text><text wx:if="{{item.tag}}" class="more-course-tag">{{item.tag}}</text></view>
                <view class="more-course-info"><view class="more-course-copy"><text class="more-course-title">{{item.title}}</text><text class="more-course-subtitle">{{item.subtitle}}</text></view></view>
              </view>
            </view>
          </view>
        </view>
        <text wx:else class="my-courses-empty">{{courseSearch ? '没有找到相关课程' : customView.emptyText}}</text>
      </block>
      <block wx:elif="{{visibleMyCourses.length > 0}}">
        <scroll-view wx:if="{{seriesTabs.length}}" class="series-filter-strip" scroll-x="true" show-scrollbar="false" enhanced="true">
          <view class="series-filter-row" role="tablist" aria-label="按系列查看">
            <view wx:for="{{seriesTabs}}" wx:key="id" class="custom-filter series-filter {{item.active ? 'is-active' : ''}}" data-id="{{item.id}}" bindtap="switchMySeries" role="tab" aria-selected="{{item.active}}"><text class="series-filter-label">{{item.label}}</text><text class="custom-filter-count">{{item.count}}</text></view>
          </view>
        </scroll-view>
        <view class="more-courses-grid">
          <view wx:for="{{seriesCourses}}" wx:key="id" class="more-course-card {{item.id === focusCourseId ? 'is-focused' : ''}}" data-id="{{item.id}}" data-kind="{{item.kind}}" bindtap="openMyCourse" role="button" aria-label="打开课程 {{item.title}}">
            <view class="more-course-cover more-course-cover-{{item.tone}}"><image wx:if="{{item.coverUrl}}" class="more-course-cover-image" src="{{UA.src(ui, item.coverUrl)}}" mode="aspectFill" lazy-load="true"></image><text wx:else class="more-course-cover-mark">知鹿</text><text wx:if="{{item.tag}}" class="more-course-tag">{{item.tag}}</text><text wx:if="{{item.seriesTitle}}" class="more-course-series">{{item.seriesTitle}}</text></view>
            <view class="more-course-info"><view class="more-course-copy"><text class="more-course-title">{{item.title}}</text><text class="more-course-subtitle">{{item.subtitle}}</text></view></view>
          </view>
        </view>
      </block>
      <text wx:else class="my-courses-empty">{{courseSearch ? '没有找到相关课程' : '制作中和已完成的课程都会显示在这里'}}</text>
    </view>
  </view>
</scroll-view>
<view class="calendar-overlay {{calendarPinned ? 'calendar-overlay-visible' : ''}}" style="top: {{contentTop}}px;">
  <scroll-view class="study-date-strip" scroll-x="true" show-scrollbar="false" enhanced="true" scroll-into-view="{{calendarScrollAnchor}}">
    <view class="study-date-list">
      <view wx:for="{{model.studyTaskCalendar}}" wx:for-index="dayIndex" wx:key="id" id="study-day-{{dayIndex}}" class="study-date {{item.hasTask ? 'study-date-has-task' : ''}}" data-index="{{dayIndex}}" bindtap="handleStudyDateSelect">
        <view class="study-date-tile {{item.isSelected ? 'study-date-selected' : ''}}">
          <text class="study-date-value">{{item.date}}</text>
          <text class="study-date-label">{{item.label}}</text>
        </view>
        <view wx:if="{{item.hasTask}}" class="study-date-task-dot"></view>
      </view>
    </view>
  </scroll-view>
</view>
</view>
<card-reveal wx:if="{{openCard}}" card="{{openCard}}" series="{{openSeries}}" mode="detail" origin="{{openOrigin}}" bind:close="handleRevealClose" bind:drawn="handleDrawn" bind:stale="loadCards" />
<dev-reset-fab />
