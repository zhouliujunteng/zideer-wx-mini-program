<view class="learning-page">
  <view class="learning-topbar">
    <view class="learning-topbar-inner" style="height: {{navigationBarHeight}}px; padding-top: {{statusBarHeight}}px;">
      <text class="learning-topbar-title">学习</text>
    </view>
    <view class="learning-notice-button" style="top: {{notificationTop}}px; right: {{notificationRight}}px; width: {{menuButtonHeight}}px; height: {{menuButtonHeight}}px;" bindtap="showNotifications">
      <image class="learning-message-icon" src="../../assets/topbar/message.png" mode="aspectFit"></image>
      <view wx:if="{{model.notifications.count}}" class="learning-notice-badge">{{model.notifications.count}}</view>
    </view>
  </view>

<scroll-view class="page-scroll" scroll-y bindscroll="handlePageScroll" style="padding-top: {{contentTop}}px;">
  <view class="page-shell">
    <view class="calendar-heading">
      <text class="calendar-title">{{model.calendarTitle}}</text>
      <view class="calendar-chevron">›</view>
      <view wx:if="{{model.calendarShortcutLabel}}" class="calendar-shortcut-pill">{{model.calendarShortcutLabel}}</view>
      <text wx:if="{{model.canReturnToToday}}" class="calendar-return-today" bindtap="returnToToday">回到今日</text>
    </view>

    <view class="calendar-days-slot">
      <view class="calendar-days">
        <view wx:for="{{model.studyTaskCalendar}}" wx:key="id" class="calendar-day" data-index="{{index}}" bindtap="handleStudyDateSelect">
          <text class="calendar-weekday">{{item.weekday}}</text>
          <view class="calendar-date {{item.isToday ? 'calendar-date-today' : ''}} {{item.isSelected ? 'calendar-date-selected' : ''}} {{!item.hasTask ? 'calendar-date-no-task' : ''}}">
            <text>{{item.date}}</text>
          </view>
          <view wx:if="{{item.hasTask}}" class="calendar-task-dot"></view>
        </view>
      </view>
    </view>

    <view class="learning-overview-panel {{showTodayOverview ? 'learning-overview-expanded' : 'learning-overview-collapsed'}}">
      <view class="overview-grid">
        <view wx:for="{{model.overview}}" wx:key="label" class="overview-item">
          <image class="overview-icon" src="{{item.icon}}" mode="aspectFit"></image>
          <view class="overview-copy">
            <view class="overview-value">
              <view wx:for="{{item.rollDigits}}" wx:for-item="digit" wx:for-index="digitIndex" wx:key="digitIndex" class="overview-digit-window">
                <view class="overview-digit-track {{item.rollDirection}} {{numberRollClass}}">
                  <text class="overview-digit">{{digit.first}}</text>
                  <text class="overview-digit">{{digit.second}}</text>
                </view>
              </view>
              <text class="overview-unit">{{item.unit}}</text>
            </view>
            <text class="overview-label">{{item.label}}</text>
          </view>
        </view>
      </view>
    </view>

    <view class="study-tasks-section {{showTodayOverview ? 'study-tasks-with-overview' : ''}}">
      <view class="tasks-heading">
        <text class="tasks-title">学习任务</text>
      </view>
      <view class="study-task-list-card">
        <view class="study-task-list-shell {{taskListClass}}" style="height: {{taskListHeight}}rpx;">
          <block wx:if="{{model.studyTasks.length > 0}}">
            <view wx:for="{{model.studyTasks}}" wx:key="id" class="study-task-item" data-id="{{item.id}}" bindtap="openTask">
              <view class="study-task-side-pill" style="background: {{item.sidePillColor}};"></view>
              <view class="study-task-body">
                <text class="study-task-title">{{item.title}}</text>
                <text class="study-task-meta">{{item.meta}}</text>
              </view>
              <view class="progress-ring study-task-ring" style="background: conic-gradient(#FD7C02 {{item.progress}}%, rgba(253, 124, 2, 0.14) 0);">
                <view class="progress-ring-inner"><text>{{item.progress}}%</text></view>
              </view>
            </view>
          </block>
          <text wx:else class="study-task-empty">{{model.studyTaskEmptyText}}</text>
        </view>
      </view>
    </view>

    <view class="todo-section">
      <view class="tasks-heading">
        <text class="tasks-title">待办事项</text>
      </view>
      <view class="todo-list-card">
        <view class="todo-list">
          <block wx:if="{{model.todoItems.length > 0}}">
            <view wx:for="{{model.todoItems}}" wx:key="id" class="todo-item" data-id="{{item.id}}" bindtap="openTask">
              <view class="todo-copy">
                <text class="todo-title">{{item.title}}</text>
                <text class="todo-meta">{{item.meta}}</text>
              </view>
              <view class="todo-status todo-status-{{item.status}}">
                <view wx:if="{{item.status === 'in-progress'}}" class="todo-status-dot"></view>
                <text wx:if="{{item.status === 'completed'}}" class="todo-status-check">✓</text>
              </view>
            </view>
          </block>
          <text wx:else class="todo-empty">暂无待办事项</text>
        </view>
      </view>
    </view>
  </view>
</scroll-view>
<view class="calendar-overlay {{calendarPinned ? 'calendar-overlay-visible' : ''}}" style="top: {{contentTop}}px;">
  <view wx:for="{{model.studyTaskCalendar}}" wx:key="id" class="calendar-day" data-index="{{index}}" bindtap="handleStudyDateSelect">
    <text class="calendar-weekday">{{item.weekday}}</text>
    <view class="calendar-date {{item.isToday ? 'calendar-date-today' : ''}} {{item.isSelected ? 'calendar-date-selected' : ''}} {{!item.hasTask ? 'calendar-date-no-task' : ''}}">
      <text>{{item.date}}</text>
    </view>
    <view wx:if="{{item.hasTask}}" class="calendar-task-dot"></view>
  </view>
</view>
</view>
