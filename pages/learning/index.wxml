<wxs module="UA" src="../../utils/ui-asset.wxs" />
<!-- 学习页（2026-11-11 晚用户要求，照多邻国）：顶上一行状态栏（成就卡、课程库、联系老师；连续学习在右上角火苗），
     下面一条吸顶的「第 N 阶段，第 M 部分」横幅（随滚动换成当前看到的部分），其余全是闯关路径。
     原来的头图、成就卡横条、我的课程标题、联系老师卡片、搜索框都收进了顶栏的小入口。
     路径：一节课 = 一个部分（最多 7 关），模型 utils/quest-path-view.js，动效见 docs/闯关学习动效设计记录.md。 -->
<view class="learning-page" style="--top: {{contentTop}};">
  <view class="learning-topbar">
    <view class="learning-topbar-inner" style="height: {{navigationBarHeight}}px; padding-top: {{statusBarHeight}}px;">
      <view class="lp-stats">
        <view class="lp-stat" bindtap="openAllCards" role="button" aria-label="成就卡，可以抽 {{cards.drawsAvailable || 0}} 次">
          <view class="lp-stat-card" aria-hidden="true"></view>
          <text class="lp-stat-num {{cards.drawsAvailable ? '' : 'is-zero'}}">{{cardsLoaded && access === 'ready' ? cards.drawsAvailable : 0}}</text>
        </view>
        <view class="lp-stat" bindtap="openLibrary" role="button" aria-label="课程库">
          <view class="lp-stat-book" aria-hidden="true"></view>
        </view>
        <view class="lp-stat" bindtap="openEnterpriseService" role="button" aria-label="联系老师定制课程">
          <image class="lp-stat-avatar" src="{{UA.src(ui, '/assets/me/service-advisor.png')}}" mode="aspectFill"></image>
        </view>
      </view>
    </view>
    <streak-entry top="{{streakEntryTop}}" right="{{streakEntryRight}}" size="{{menuButtonHeight}}" />
  </view>

  <!-- 吸顶横幅：当前看到的部分（多邻国的单元横幅）；右边按钮打开这节课的课程页 -->
  <view wx:if="{{access === 'ready' && questLoaded && activePart}}" class="lp-banner tone-{{activePart.tone}}" style="top: {{contentTop}}px;">
    <view class="lp-banner-copy">
      <text class="lp-banner-no">{{activePart.banner}}</text>
      <text class="lp-banner-title">{{activePart.title}}</text>
    </view>
    <view wx:if="{{activePart.stageId}}" class="lp-banner-guide" data-stage-id="{{activePart.stageId}}" bindtap="openPartGuide" role="button" aria-label="这节课的课程页"><view class="lp-guide-icon" aria-hidden="true"></view></view>
  </view>

<scroll-view class="page-scroll {{access === 'ready' && questLoaded && activePart ? 'has-banner' : ''}}" scroll-y scroll-with-animation scroll-into-view="{{courseScrollAnchor}}" bindscroll="handlePageScroll">
  <view class="page-shell">
    <view wx:if="{{loaded && access !== 'ready'}}" class="access-prompt study-access-prompt">
      <view class="access-prompt-copy">
        <text class="access-prompt-title">{{access === 'guest' ? '登录后开始闯关学习' : '请先完善学习资料'}}</text>
        <text class="access-prompt-subtitle">{{access === 'guest' ? '你的闯关路径和定制课程都会显示在这里' : '完善后，你的闯关路径会显示在这里'}}</text>
      </view>
      <view class="access-prompt-action" bindtap="openAccessStep" role="button" aria-label="{{access === 'guest' ? '去登录' : '去完善学习资料'}}">{{access === 'guest' ? '去登录' : '去完善'}}</view>
    </view>
    <view wx:elif="{{!loaded || (!questLoaded && !questFailed)}}" class="quest-sk" aria-label="闯关路径加载中">
      <view class="sk quest-sk-goal"></view>
      <view wx:for="{{[0, 90, 150, 90, 0, -90]}}" wx:key="index" class="quest-node-wrap" style="--x: {{item}};"><view class="sk sk-round quest-sk-node"></view></view>
    </view>
    <text wx:elif="{{!questLoaded}}" class="my-courses-empty" bindtap="retryQuest">闯关路径暂时没有读到，点这里重试</text>
    <view wx:elif="{{!quest.parts.length}}" class="quest-empty">
      <text class="quest-empty-title">还没有定制课程</text>
      <text class="quest-empty-copy">先在「目标」里定好目标、做个测评，老师会按你的目标一部分一部分定制课程，学完一关解锁下一关。</text>
      <view class="quest-empty-action" bindtap="openEnterpriseService" role="button">联系老师定制课程</view>
    </view>
    <view wx:else class="quest" bindtap="closeQuestPopover">
      <view wx:if="{{quest.goal}}" class="quest-goal-line">
        <text class="quest-goal-label">目标</text><text class="quest-goal-title">{{quest.goal.title}}</text><text wx:if="{{quest.progressText}}" class="quest-goal-progress">{{quest.progressText}}</text>
      </view>
      <view wx:for="{{quest.parts}}" wx:for-item="part" wx:key="id" id="{{part.id}}" class="quest-part tone-{{part.tone}}" data-index="{{index}}">
        <!-- 阶段开头：大分隔；同一阶段里换部分：带课名的细分隔（多邻国两个单元之间那条线） -->
        <view wx:if="{{part.firstOfPhase}}" class="quest-phase"><text class="quest-phase-no">{{part.phaseNo}}</text><text class="quest-phase-title">{{part.phaseTitle}}</text></view>
        <view wx:if="{{index > 0}}" class="quest-divider"><view class="quest-divider-line"></view><text class="quest-divider-text">{{part.title}}</text><text wx:if="{{part.tag}}" class="quest-divider-tag">{{part.tag}}</text><view class="quest-divider-line"></view></view>
        <view class="quest-track">
          <!-- 路径旁的小鹿（多邻国部分中间的角色）：三颗星 = 看完 / 练习通关 / 验收通过；还没开始的课暗着 -->
          <view wx:if="{{part.mascot}}" class="quest-mascot side-{{part.mascot.side}} {{part.mascot.dim ? 'is-dim' : ''}}" aria-hidden="true">
            <image class="quest-mascot-img" src="{{UA.src(ui, '/assets/quest/deer.svg')}}" mode="aspectFit"></image>
            <view class="quest-mascot-stars">
              <image wx:for="{{part.mascot.stars}}" wx:for-item="lit" wx:key="index" class="quest-mascot-star star-{{index}}" src="{{UA.src(ui, lit ? '/assets/quest/rating-star.svg' : '/assets/quest/rating-star-empty.svg')}}" mode="aspectFit"></image>
            </view>
          </view>
          <view wx:for="{{part.nodes}}" wx:key="id" class="quest-row {{questPopover && questPopover.id === item.id ? 'has-popover' : ''}}">
            <view class="quest-node-wrap {{item.id === quest.currentId ? 'is-here-wrap' : ''}}" style="--x: {{item.offset}};">
              <view wx:if="{{item.id === quest.currentId}}" id="quest-current" class="quest-anchor"></view>
              <view wx:if="{{item.id === quest.currentId}}" class="quest-start">开始</view>
              <!-- 当前关：分段进度环（这节课几关过了几关）+ 外圈闪电（多邻国当前关的电光） -->
              <view wx:if="{{item.id === quest.currentId}}" class="quest-ring" style="--ring: {{item.ring}}; --segs: {{item.segs}};"></view>
              <block wx:if="{{item.id === quest.currentId}}">
                <image class="quest-zap zap-a" src="{{UA.src(ui, '/assets/quest/lightning-a.svg')}}" mode="aspectFit" aria-hidden="true"></image>
                <image class="quest-zap zap-b" src="{{UA.src(ui, '/assets/quest/lightning-b.svg')}}" mode="aspectFit" aria-hidden="true"></image>
              </block>
              <view wx:if="{{item.id === questFx.unlockId}}" class="quest-burst" aria-hidden="true"></view>
              <block wx:if="{{item.kind === 'chest' && item.state === 'done'}}">
                <image wx:for="{{[0, 1, 2, 3]}}" wx:for-item="spark" wx:key="*this" class="quest-sparkle sparkle-{{spark}}" src="{{UA.src(ui, '/assets/quest/sparkle.svg')}}" mode="aspectFit" aria-hidden="true"></image>
              </block>
              <view id="{{item.id === quest.currentId ? 'quest-current-node' : ''}}" class="quest-node is-{{item.state}} kind-{{item.kind}} {{item.id === quest.currentId ? 'is-here' : ''}} {{item.id === questFx.doneId ? 'fx-done' : ''}} {{item.id === questFx.unlockId ? 'fx-unlock' : ''}}" data-id="{{item.id}}" catchtap="openQuestNode" role="button" aria-label="{{item.label}}，{{item.detail}}">
                <image class="quest-glyph" src="{{UA.src(ui, item.glyph)}}" mode="aspectFit"></image>
                <text wx:if="{{item.badge}}" class="quest-badge-no">{{item.badge}}</text>
              </view>
              <!-- 点关卡弹出的说明卡（多邻国式），箭头对着关卡，卡片本身回到中线 -->
              <view wx:if="{{questPopover && questPopover.id === item.id}}" class="quest-pop {{questPopover.action ? '' : 'is-muted'}}" catchtap="noop">
                <view class="quest-pop-arrow"></view>
                <text class="quest-pop-title">{{questPopover.title}}</text>
                <text wx:if="{{questPopover.course}}" class="quest-pop-course">{{questPopover.course}}</text>
                <text wx:if="{{questPopover.position}}" class="quest-pop-meta">{{questPopover.position}}<block wx:if="{{questPopover.detail}}"> · {{questPopover.detail}}</block></text>
                <text wx:elif="{{questPopover.detail}}" class="quest-pop-meta">{{questPopover.detail}}</text>
                <view wx:if="{{questPopover.action}}" class="quest-pop-button" catchtap="startQuestNode" role="button">{{questPopover.action}}</view>
                <text wx:else class="quest-pop-note">{{questPopover.note}}</text>
              </view>
            </view>
          </view>
        </view>
      </view>
    </view>
  </view>
</scroll-view>
</view>
<!-- 当前关滚出屏幕时：回到当前关 -->
<view wx:if="{{quest && quest.currentId && !questCurrentVisible && access === 'ready'}}" class="quest-jump" bindtap="jumpToQuestCurrent" role="button" aria-label="回到当前关"><view class="quest-jump-arrow"></view></view>
<!-- 开宝箱：箱子落下抖动 → 盖子飞开、光芒旋转、奖励弹出（动效设计见 docs/闯关学习动效设计记录.md） -->
<view wx:if="{{chestReveal}}" class="chest-reveal phase-{{chestReveal.phase}}" catchtouchmove="noop">
  <view class="chest-stage">
    <view class="chest-rays" aria-hidden="true"></view>
    <view wx:for="{{[0, 1, 2, 3, 4, 5, 6, 7]}}" wx:key="*this" class="chest-spark spark-{{item}}" aria-hidden="true"></view>
    <view class="chest-box" aria-hidden="true">
      <view class="chest-lid"><view class="chest-lid-band"></view></view>
      <view class="chest-body"><view class="chest-lock"></view></view>
    </view>
    <view wx:if="{{chestReveal.phase === 'open'}}" class="chest-reward">
      <view wx:if="{{chestReveal.kind === 'coins'}}" class="chest-reward-coin"><view class="chest-reward-coin-face"></view></view>
      <view wx:else class="chest-reward-card"></view>
      <text class="chest-reward-count">+{{chestReveal.kind === 'coins' ? chestReveal.coins : chestReveal.draws}}</text>
    </view>
  </view>
  <block wx:if="{{chestReveal.phase === 'open' && chestReveal.kind === 'coins'}}">
    <text class="chest-title">打开宝箱！</text>
    <text class="chest-copy">送你 {{chestReveal.coins}} 金币</text>
    <view class="chest-wallet"><text>今天宝箱金币</text><text class="chest-wallet-num is-final">{{chestReveal.coinsToday}}</text><text>/ {{chestReveal.coinCap}}</text></view>
    <view class="chest-button" bindtap="closeChestReveal" role="button">继续闯关</view>
    <view class="chest-secondary" bindtap="openCoinsFromChest" role="button">看我的金币</view>
  </block>
  <block wx:elif="{{chestReveal.phase === 'open'}}">
    <text class="chest-title">打开宝箱！</text>
    <text class="chest-copy">送你 {{chestReveal.draws}} 次成就卡抽卡机会</text>
    <view class="chest-wallet"><text>现在可以抽</text><view class="chest-wallet-roll"><text class="chest-wallet-num {{chestReveal.bonusShown === chestReveal.bonusDraws ? 'is-final' : ''}}">{{chestReveal.bonusShown}}</text></view><text>次</text></view>
    <view class="chest-button" bindtap="openCardsFromChest" role="button">去抽卡</view>
    <view class="chest-secondary" bindtap="closeChestReveal" role="button">继续闯关</view>
  </block>
  <block wx:elif="{{chestReveal.phase === 'error'}}">
    <text class="chest-title">宝箱没打开</text>
    <text class="chest-copy">{{chestReveal.error}}</text>
    <view class="chest-button" bindtap="closeChestReveal" role="button">知道了</view>
  </block>
  <text wx:else class="chest-copy chest-opening">正在打开…</text>
</view>
<card-reveal wx:if="{{openCard}}" card="{{openCard}}" series="{{openSeries}}" mode="detail" origin="{{openOrigin}}" bind:close="handleRevealClose" bind:drawn="handleDrawn" bind:stale="loadCards" />
<dev-reset-fab />
