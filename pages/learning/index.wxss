page {
  background: #FAFAFA;
}

.learning-page {
  height: 100vh;
  overflow: hidden;
  background: #FAFAFA;
  color: #24332d;
}

.learning-topbar {
  position: fixed;
  top: 0;
  left: 0;
  z-index: 20;
  width: 100%;
  box-sizing: border-box;
  background: #FAFAFA;
}

.learning-topbar-inner {
  display: flex;
  align-items: center;
  box-sizing: content-box;
  padding: 0 36rpx 16rpx;
}

.learning-topbar-title {
  color: #24332d;
  font-size: 36rpx;
  font-weight: 700;
  letter-spacing: -1rpx;
  line-height: 1;
}

.learning-notice-button {
  position: fixed;
  z-index: 21;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  border: 1rpx solid #e7ebe6;
  border-radius: 50%;
  background: #fff;
}

.learning-message-icon {
  display: block;
  width: 34rpx;
  height: 34rpx;
}

.learning-notice-badge {
  position: absolute;
  top: -8rpx;
  right: -8rpx;
  min-width: 27rpx;
  height: 27rpx;
  padding: 0 6rpx;
  box-sizing: border-box;
  border: 3rpx solid #FAFAFA;
  border-radius: 999rpx;
  background: #FD7C02;
  color: #fff;
  font-size: 17rpx;
  line-height: 21rpx;
  text-align: center;
}

.page-scroll {
  height: 100vh;
  box-sizing: border-box;
  background: #FAFAFA;
}

.page-shell {
  min-height: 100%;
  padding: 16rpx 36rpx 180rpx;
  box-sizing: border-box;
}

.calendar-heading {
  display: flex;
  align-items: center;
}

.calendar-title {
  color: #111613;
  font-size: 38rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
  line-height: 1.25;
}

.calendar-chevron {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 30rpx;
  height: 46rpx;
  margin-left: 12rpx;
  color: #7d8580;
  font-size: 36rpx;
  line-height: 1;
}

.calendar-shortcut-pill {
  margin-left: 20rpx;
  padding: 10rpx 22rpx;
  border-radius: 999rpx;
  background: rgba(253, 124, 2, 0.10);
  color: #FD7C02;
  font-size: 25rpx;
  font-weight: 700;
  line-height: 1.1;
}

.calendar-return-today {
  margin-left: auto;
  color: #a3aaa5;
  font-size: 22rpx;
  line-height: 1.2;
}

.calendar-days-slot {
  box-sizing: border-box;
  height: 154rpx;
  margin-top: 30rpx;
  margin-right: -36rpx;
  margin-left: -36rpx;
  padding: 0 36rpx;
  border-bottom: 1rpx solid #e7ebe7;
}

.calendar-days {
  display: flex;
  padding: 8rpx 0 4rpx;
  box-sizing: border-box;
  background: #FAFAFA;
}

.calendar-overlay {
  position: fixed;
  left: 0;
  right: 0;
  z-index: 19;
  display: flex;
  padding: 8rpx 36rpx 4rpx;
  box-sizing: border-box;
  border-bottom: 1rpx solid #e7ebe7;
  background: #FAFAFA;
  opacity: 0;
  visibility: hidden;
  pointer-events: none;
  transition: opacity 80ms ease, visibility 0s linear 80ms;
}

.calendar-overlay-visible {
  opacity: 1;
  visibility: visible;
  pointer-events: auto;
  transition-delay: 0s;
}

.calendar-day {
  position: relative;
  display: flex;
  flex: 1;
  flex-direction: column;
  align-items: center;
  min-width: 0;
  height: 142rpx;
}

.calendar-weekday {
  display: block;
  color: #888f8a;
  font-size: 22rpx;
  font-weight: 500;
  line-height: 1.2;
  white-space: nowrap;
}

.calendar-date {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 62rpx;
  height: 62rpx;
  margin-top: 16rpx;
  border-radius: 50%;
  color: #202521;
  font-size: 30rpx;
  font-weight: 500;
  line-height: 1;
}

.calendar-date-selected {
  background: rgba(253, 124, 2, 0.10);
  color: #252b27;
}

.calendar-date-today {
  color: #FD7C02;
}

.calendar-date-selected.calendar-date-today {
  color: #252b27;
}

.calendar-date-no-task,
.calendar-date-selected.calendar-date-no-task {
  color: #aeb5af;
}

.calendar-date-selected.calendar-date-no-task {
  color: #252b27;
}

.calendar-task-dot {
  position: absolute;
  top: 110rpx;
  left: 50%;
  width: 8rpx;
  height: 8rpx;
  margin-left: -4rpx;
  border-radius: 50%;
  background: #FD7C02;
}

.study-tasks-section {
  margin-top: 34rpx;
  transition: margin-top 260ms ease;
}

.study-tasks-section.study-tasks-with-overview {
  margin-top: 42rpx;
}

.study-task-list-shell {
  overflow: hidden;
  transition: height 260ms cubic-bezier(.22, .78, .32, 1), opacity 150ms ease;
}

.study-task-list-card,
.todo-list-card {
  margin-top: 20rpx;
  padding: 20rpx 30rpx;
  box-sizing: border-box;
  border-radius: 36rpx;
  background: #fff;
}

.study-task-list-shell.study-task-list-leaving,
.study-task-list-shell.study-task-list-enter-prep {
  opacity: 0;
  pointer-events: none;
}

.study-task-list-shell.study-task-list-enter {
  opacity: 1;
  pointer-events: auto;
}

.learning-overview-panel {
  max-height: 170rpx;
  margin-top: 34rpx;
  overflow: hidden;
  opacity: 1;
  transition: max-height 260ms cubic-bezier(.22, .78, .32, 1), margin-top 260ms cubic-bezier(.22, .78, .32, 1), opacity 180ms ease;
}

.learning-overview-panel.learning-overview-collapsed {
  max-height: 0;
  margin-top: 0;
  opacity: 0;
  pointer-events: none;
}

.overview-grid {
  display: flex;
  gap: 14rpx;
}

.overview-item {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  padding: 22rpx 14rpx;
  border: 0;
  border-radius: 22rpx;
  background: #fff;
}

.overview-icon {
  flex: 0 0 auto;
  width: 62rpx;
  height: 62rpx;
  margin-right: 10rpx;
}

.overview-copy {
  flex: 1;
  min-width: 0;
}

.overview-value {
  display: flex;
  align-items: baseline;
  color: #24332d;
  font-size: 33rpx;
  font-weight: 700;
}

.overview-digit-window {
  display: block;
  min-width: 20rpx;
  height: 40rpx;
  overflow: hidden;
  text-align: center;
}

.overview-digit-track {
  display: flex;
  flex-direction: column;
  will-change: transform;
}

.overview-digit-track.up.overview-digit-settled {
  transform: translate3d(0, -50%, 0);
}

.overview-digit-track.down.overview-digit-settled {
  transform: translate3d(0, 0, 0);
}

.overview-digit-track.up.overview-digit-roll-a {
  animation: overview-digit-roll-up-a 460ms cubic-bezier(.22, .78, .32, 1) both;
}

.overview-digit-track.up.overview-digit-roll-b {
  animation: overview-digit-roll-up-b 460ms cubic-bezier(.22, .78, .32, 1) both;
}

.overview-digit-track.down.overview-digit-roll-a {
  animation: overview-digit-roll-down-a 460ms cubic-bezier(.22, .78, .32, 1) both;
}

.overview-digit-track.down.overview-digit-roll-b {
  animation: overview-digit-roll-down-b 460ms cubic-bezier(.22, .78, .32, 1) both;
}

.overview-digit {
  height: 40rpx;
  font-size: 33rpx;
  line-height: 40rpx;
}

@keyframes overview-digit-roll-up-a {
  from { transform: translate3d(0, 0, 0); }
  to { transform: translate3d(0, -50%, 0); }
}

@keyframes overview-digit-roll-up-b {
  from { transform: translate3d(0, 0, 0); }
  to { transform: translate3d(0, -50%, 0); }
}

@keyframes overview-digit-roll-down-a {
  from { transform: translate3d(0, -50%, 0); }
  to { transform: translate3d(0, 0, 0); }
}

@keyframes overview-digit-roll-down-b {
  from { transform: translate3d(0, -50%, 0); }
  to { transform: translate3d(0, 0, 0); }
}

.overview-unit {
  margin-left: 3rpx;
  font-size: 18rpx;
  font-weight: 400;
}

.overview-label {
  display: block;
  margin-top: 6rpx;
  overflow: hidden;
  color: #818c84;
  font-size: 19rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.tasks-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.tasks-title {
  color: #24332d;
  font-size: 34rpx;
  font-weight: 700;
}

.study-task-item {
  display: flex;
  align-items: center;
  height: 96rpx;
  min-height: 96rpx;
  margin-top: 0;
  padding: 0;
  box-sizing: border-box;
  border-bottom: 0;
}

.study-task-item + .study-task-item {
  margin-top: 20rpx;
}

.study-task-body {
  flex: 1;
  min-width: 0;
}

.study-task-title,
.study-task-meta {
  display: block;
}

.study-task-title {
  overflow: hidden;
  color: #2c312e;
  font-size: 28rpx;
  font-weight: 700;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.study-task-meta {
  margin-top: 10rpx;
  color: #9aa49d;
  font-size: 21rpx;
}

.study-task-side-pill {
  flex: 0 0 auto;
  width: 10rpx;
  height: 46rpx;
  margin: 0 18rpx 0 2rpx;
  border-radius: 999rpx;
  background: #e3e8e4;
}

.progress-ring {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
}

.progress-ring-inner {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 54rpx;
  height: 54rpx;
  border-radius: 50%;
  background: #fff;
}

.progress-ring-inner text {
  color: #24332d;
  font-size: 18rpx;
  font-weight: 700;
}

.study-task-ring {
  flex: 0 0 auto;
  margin: 0 4rpx 0 18rpx;
}

.study-task-empty {
  display: block;
  color: #77827a;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 96rpx;
  text-align: center;
}

.todo-section {
  margin-top: 46rpx;
}

.todo-list {
  margin: 0;
}

.todo-item {
  display: flex;
  align-items: center;
  min-height: 76rpx;
  padding: 0;
  box-sizing: border-box;
  border-bottom: 0;
}

.todo-item + .todo-item {
  margin-top: 12rpx;
}

.todo-empty {
  display: block;
  color: #77827a;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 76rpx;
  text-align: center;
}

.todo-copy {
  flex: 1;
  min-width: 0;
}

.todo-title,
.todo-meta {
  display: block;
}

.todo-title {
  overflow: hidden;
  color: #2c312e;
  font-size: 28rpx;
  font-weight: 700;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.todo-meta {
  margin-top: 8rpx;
  overflow: hidden;
  color: #9aa49d;
  font-size: 21rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.todo-status {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 auto;
  width: 38rpx;
  height: 38rpx;
  margin-left: 16rpx;
  box-sizing: border-box;
  border: 1rpx solid #dfe4df;
  border-radius: 50%;
  background: #fff;
}

.todo-status-dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: #FD7C02;
}

.todo-status-in-progress {
  border-color: #FD7C02;
  background: #fff;
}

.todo-status-completed {
  border-color: #58a878;
  background: #edf8f0;
}

.todo-status-check {
  color: #58a878;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1;
}
