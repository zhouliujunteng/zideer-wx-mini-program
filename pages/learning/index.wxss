@import "../../styles/skeleton.wxss";
@import "../../styles/course-grid.wxss";
@import "../../styles/access-prompt.wxss";
@import "../../styles/achievement-card.wxss";
page {
  background: #FAFAFA;
}

.learning-page {
  height: 100vh;
  overflow: hidden;
  background: #FAFAFA;
  color: #24332d;
}

.learning-topbar {
  position: fixed;
  top: 0;
  left: 0;
  z-index: 20;
  width: 100%;
  box-sizing: border-box;
  background: #FAFAFA;
}

.learning-topbar-inner {
  display: flex;
  align-items: center;
  box-sizing: content-box;
  padding: 0 36rpx 16rpx;
}

.learning-topbar-title {
  color: #24332d;
  font-size: 36rpx;
  font-weight: 700;
  letter-spacing: -1rpx;
  line-height: 1;
}

.page-scroll {
  height: 100vh;
  box-sizing: border-box;
  /* 顶栏下面那段内边距也铺成顶栏同色，接上 .page-shell 的渐变 */
  background: linear-gradient(#FFF3E6, #FFF3E6) top / 100% 400rpx no-repeat, #FAFAFA;
}

.page-shell {
  min-height: 100%;
  padding: 16rpx 36rpx 180rpx;
  box-sizing: border-box;
}

.calendar-heading {
  display: flex;
  align-items: center;
}

.calendar-title {
  color: #111613;
  font-size: 38rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
  line-height: 1.25;
}

.calendar-chevron {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 30rpx;
  height: 46rpx;
  margin-left: 12rpx;
  color: #7d8580;
  font-size: 36rpx;
  line-height: 1;
}

.calendar-shortcut-pill {
  margin-left: 20rpx;
  padding: 10rpx 22rpx;
  border-radius: 999rpx;
  background: rgba(253, 124, 2, 0.10);
  color: #FD7C02;
  font-size: 25rpx;
  font-weight: 700;
  line-height: 1.1;
}

.calendar-return-today {
  margin-left: auto;
  color: #a3aaa5;
  font-size: 22rpx;
  line-height: 1.2;
}

.calendar-days-slot {
  box-sizing: border-box;
  margin-top: 30rpx;
  margin-right: -36rpx;
  margin-left: -36rpx;
  padding: 14rpx 36rpx 16rpx;
  border-bottom: 1rpx solid #e7ebe7;
}

.calendar-overlay {
  position: fixed;
  left: 0;
  right: 0;
  z-index: 19;
  padding: 14rpx 36rpx 16rpx;
  box-sizing: border-box;
  border-bottom: 1rpx solid #e7ebe7;
  background: #FAFAFA;
  opacity: 0;
  visibility: hidden;
  pointer-events: none;
  transition: opacity 80ms ease, visibility 0s linear 80ms;
}

.calendar-overlay-visible {
  opacity: 1;
  visibility: visible;
  pointer-events: auto;
  transition-delay: 0s;
}

.study-date-strip {
  width: 100%;
  white-space: nowrap;
}

.study-date-list {
  display: inline-flex;
  min-width: 100%;
  height: 121rpx;
  padding: 0 6rpx;
  box-sizing: border-box;
  gap: 14rpx;
}

.study-date {
  position: relative;
  display: flex;
  flex: 0 0 112rpx;
  flex-direction: column;
  align-items: center;
}

.study-date-tile {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  width: 104rpx;
  height: 104rpx;
  box-sizing: border-box;
  border: 0;
  border-radius: 20rpx;
  background: #fff;
  color: #252b27;
}

.study-date-value,
.study-date-label {
  display: block;
}

.study-date-value {
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1.2;
}

.study-date-label {
  margin-top: 8rpx;
  color: #a2a8a3;
  font-size: 20rpx;
  line-height: 1.2;
}

.study-date-has-task .study-date-label {
  color: #68716a;
}

.study-date-selected {
  border: 1rpx solid #FD7C02;
  background: rgba(253, 124, 2, 0.10);
}

.study-date-selected .study-date-value {
  color: #252b27;
}

.study-date-selected .study-date-label {
  color: #969d97;
}

/* 无任务日期不表达可执行状态，日期数字与辅助标签统一弱化。 */
.study-date:not(.study-date-has-task) .study-date-value {
  color: #b1b8b2;
}

.study-date:not(.study-date-has-task) .study-date-selected .study-date-value {
  color: #252b27;
}

.study-date-task-dot {
  position: absolute;
  z-index: 1;
  top: 88rpx;
  left: 50%;
  width: 8rpx;
  height: 8rpx;
  margin: 0;
  border-radius: 50%;
  background: #FD7C02;
  transform: translateX(-50%);
}

.study-tasks-section {
  margin-top: 34rpx;
  transition: margin-top 260ms ease;
}

.study-tasks-section.study-tasks-with-overview {
  margin-top: 42rpx;
}

/* 高度是行内传入的 rpx 设计值（--list-height），在这里换算，大屏下才会跟着固定比例（见 utils/screen.js） */
.study-task-list-shell {
  height: calc(var(--list-height) * 1000rpx / 1000);
  overflow: hidden;
  transition: height 260ms cubic-bezier(.22, .78, .32, 1), opacity 150ms ease;
}

.study-task-list-card,
.todo-list-card {
  margin-top: 20rpx;
  padding: 20rpx 30rpx;
  box-sizing: border-box;
  border-radius: 36rpx;
  background: #fff;
}

/* 「我的课程」：和首页「会员课程」一样直接铺在页面底色上（卡片、搜索框样式在 styles/course-grid.wxss） */
.my-courses-section { margin-top: 42rpx; }
.my-courses-search { margin-top: 22rpx; }
/* 「联系老师定制课程」卡片（原「我的」页企微服务卡片，样式照搬） */
.enterprise-service-card { display: flex; align-items: center; min-height: 140rpx; margin-top: 22rpx; padding: 26rpx 30rpx 26rpx 28rpx; box-sizing: border-box; border-radius: 40rpx; background: #fff; }
.enterprise-service-avatar { flex: 0 0 auto; width: 72rpx; height: 72rpx; border-radius: 50%; background: #eef1ee; }
.enterprise-service-copy { min-width: 0; flex: 1; margin-left: 22rpx; }
.enterprise-service-title { display: block; overflow: hidden; color: #24332d; font-size: 26rpx; font-weight: 600; line-height: 1.3; text-overflow: ellipsis; white-space: nowrap; }
.enterprise-service-description { display: block; margin-top: 12rpx; overflow: hidden; color: #adb5af; font-size: 21rpx; line-height: 1.2; text-overflow: ellipsis; white-space: nowrap; }
.enterprise-service-action { display: flex; flex: 0 0 auto; align-items: center; min-height: 42rpx; margin-left: 20rpx; }
.enterprise-service-hours { display: inline-flex; align-items: center; justify-content: center; min-width: 112rpx; height: 32rpx; padding: 0 13rpx; box-sizing: border-box; border-radius: 999rpx; background: rgba(253, 124, 2, 0.10); color: #FD7C02; font-size: 18rpx; line-height: 32rpx; white-space: nowrap; }
.enterprise-service-go { display: flex; align-items: center; justify-content: center; width: 42rpx; height: 42rpx; margin-left: 12rpx; }
.enterprise-service-arrow { display: block; color: #a2a9a1; font-size: 42rpx; font-weight: 300; line-height: 42rpx; transform: translateY(-1rpx); }
/* 从对话的课程链接跳过来时，短暂高亮这门课的封面 */
.more-course-card.is-focused .more-course-cover { box-shadow: 0 0 0 4rpx rgba(253, 124, 2, .55), 0 10rpx 28rpx rgba(253, 124, 2, .18); transition: box-shadow .24s ease; }
/* 学习任务位上的去登录 / 去完善提示（styles/access-prompt.wxss），与任务卡同样的上边距和圆角 */
.study-access-prompt { margin-top: 20rpx; border-radius: 36rpx; }
.my-courses-empty { display: block; margin-top: 20rpx; padding: 44rpx 20rpx; border-radius: 22rpx; background: #fff; color: #8a938d; font-size: 24rpx; text-align: center; }
/* 「我的课程」两栏：全部课程 / 我的定制课程（2026-10-06）；「我的定制课程」下再分未学、已学，按系列分组 */
.my-course-tabs { display: flex; margin-top: 24rpx; padding: 6rpx; border-radius: 999rpx; background: #EEF0ED; }
.my-course-tab { flex: 1; height: 62rpx; border-radius: 999rpx; color: #7E8882; font-size: 24rpx; font-weight: 600; line-height: 62rpx; text-align: center; transition: background .2s ease, color .2s ease; }
.my-course-tab.is-active { background: #fff; color: #24332D; box-shadow: 0 2rpx 10rpx rgba(36, 51, 45, .08); }
.custom-filter-row { display: flex; margin-top: 22rpx; gap: 16rpx; }
.custom-filter { display: flex; align-items: center; height: 56rpx; padding: 0 24rpx; border-radius: 999rpx; background: #fff; color: #7E8882; font-size: 23rpx; line-height: 56rpx; }
.custom-filter.is-active { background: #FFF1E6; color: #FD7C02; font-weight: 600; }
.custom-filter-count { margin-left: 8rpx; font-size: 21rpx; opacity: .75; }
/* 「全部课程」按系列筛（2026-10-09）：系列名长，横向滑动，单个标签最长 360rpx */
.series-filter-strip { width: 100%; margin-top: 22rpx; white-space: nowrap; }
.series-filter-row { display: inline-flex; gap: 16rpx; padding-right: 8rpx; }
.series-filter { flex: none; }
.series-filter-label { display: block; overflow: hidden; max-width: 360rpx; text-overflow: ellipsis; white-space: nowrap; }
.custom-series-group { margin-top: 30rpx; }
.custom-series-group .more-courses-grid { margin-top: 18rpx; }
.custom-series-heading { display: flex; align-items: baseline; justify-content: space-between; padding: 0 4rpx; }
.custom-series-title { min-width: 0; flex: 1; overflow: hidden; color: #34423B; font-size: 26rpx; font-weight: 700; line-height: 1.35; text-overflow: ellipsis; white-space: nowrap; }
.custom-series-meta { flex: 0 0 auto; margin-left: 16rpx; color: #9AA49D; font-size: 21rpx; }

.study-task-list-shell.study-task-list-leaving,
.study-task-list-shell.study-task-list-enter-prep {
  opacity: 0;
  pointer-events: none;
}

.study-task-list-shell.study-task-list-enter {
  opacity: 1;
  pointer-events: auto;
}

.learning-overview-panel {
  max-height: 170rpx;
  margin-top: 34rpx;
  overflow: hidden;
  opacity: 1;
  transition: max-height 260ms cubic-bezier(.22, .78, .32, 1), margin-top 260ms cubic-bezier(.22, .78, .32, 1), opacity 180ms ease;
}

.learning-overview-panel.learning-overview-collapsed {
  max-height: 0;
  margin-top: 0;
  opacity: 0;
  pointer-events: none;
}

.overview-grid {
  display: flex;
  gap: 14rpx;
}

.overview-item {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  padding: 22rpx 14rpx;
  border: 0;
  border-radius: 22rpx;
  background: #fff;
}

.overview-icon {
  flex: 0 0 auto;
  width: 62rpx;
  height: 62rpx;
  margin-right: 10rpx;
}

.overview-copy {
  flex: 1;
  min-width: 0;
}

.overview-value {
  display: flex;
  align-items: baseline;
  color: #24332d;
  font-size: 33rpx;
  font-weight: 700;
}

.overview-digit-window {
  display: block;
  min-width: 20rpx;
  height: 40rpx;
  overflow: hidden;
  text-align: center;
}

.overview-digit-track {
  display: flex;
  flex-direction: column;
  will-change: transform;
}

.overview-digit-track.up.overview-digit-settled {
  transform: translate3d(0, -50%, 0);
}

.overview-digit-track.down.overview-digit-settled {
  transform: translate3d(0, 0, 0);
}

.overview-digit-track.up.overview-digit-roll-a {
  animation: overview-digit-roll-up-a 460ms cubic-bezier(.22, .78, .32, 1) both;
}

.overview-digit-track.up.overview-digit-roll-b {
  animation: overview-digit-roll-up-b 460ms cubic-bezier(.22, .78, .32, 1) both;
}

.overview-digit-track.down.overview-digit-roll-a {
  animation: overview-digit-roll-down-a 460ms cubic-bezier(.22, .78, .32, 1) both;
}

.overview-digit-track.down.overview-digit-roll-b {
  animation: overview-digit-roll-down-b 460ms cubic-bezier(.22, .78, .32, 1) both;
}

.overview-digit {
  height: 40rpx;
  font-size: 33rpx;
  line-height: 40rpx;
}

@keyframes overview-digit-roll-up-a {
  from { transform: translate3d(0, 0, 0); }
  to { transform: translate3d(0, -50%, 0); }
}

@keyframes overview-digit-roll-up-b {
  from { transform: translate3d(0, 0, 0); }
  to { transform: translate3d(0, -50%, 0); }
}

@keyframes overview-digit-roll-down-a {
  from { transform: translate3d(0, -50%, 0); }
  to { transform: translate3d(0, 0, 0); }
}

@keyframes overview-digit-roll-down-b {
  from { transform: translate3d(0, -50%, 0); }
  to { transform: translate3d(0, 0, 0); }
}

.overview-unit {
  margin-left: 3rpx;
  font-size: 18rpx;
  font-weight: 400;
}

/* 未登录、没完善学习资料时没有数字可读（2026-09-27） */
.overview-value-empty {
  color: #9aa39c;
  line-height: 40rpx;
}

.overview-label {
  display: block;
  margin-top: 6rpx;
  overflow: hidden;
  color: #818c84;
  font-size: 19rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.tasks-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.tasks-title {
  color: #24332d;
  font-size: 34rpx;
  font-weight: 700;
}

.study-task-item {
  display: flex;
  align-items: center;
  height: 96rpx;
  min-height: 96rpx;
  margin-top: 0;
  padding: 0;
  box-sizing: border-box;
  border-bottom: 0;
}

.study-task-item + .study-task-item {
  margin-top: 20rpx;
}

.study-task-body {
  flex: 1;
  min-width: 0;
}

.study-task-title,
.study-task-meta {
  display: block;
}

.study-task-title {
  overflow: hidden;
  color: #2c312e;
  font-size: 28rpx;
  font-weight: 700;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.study-task-meta {
  margin-top: 10rpx;
  color: #9aa49d;
  font-size: 21rpx;
}

.study-task-side-pill {
  flex: 0 0 auto;
  width: 10rpx;
  height: 46rpx;
  margin: 0 18rpx 0 2rpx;
  border-radius: 999rpx;
  background: #e3e8e4;
}

.progress-ring {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
}

.progress-ring-inner {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 54rpx;
  height: 54rpx;
  border-radius: 50%;
  background: #fff;
}

.progress-ring-inner text {
  color: #24332d;
  font-size: 18rpx;
  font-weight: 700;
}

.study-task-ring {
  flex: 0 0 auto;
  margin: 0 4rpx 0 18rpx;
}

.study-task-empty {
  display: block;
  color: #77827a;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 96rpx;
  text-align: center;
}

.todo-section {
  margin-top: 46rpx;
}

.todo-list {
  margin: 0;
}

.todo-item {
  display: flex;
  align-items: center;
  min-height: 76rpx;
  padding: 0;
  box-sizing: border-box;
  border-bottom: 0;
}

.todo-item + .todo-item {
  margin-top: 12rpx;
}

.todo-empty {
  display: block;
  color: #77827a;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 76rpx;
  text-align: center;
}

.todo-copy {
  flex: 1;
  min-width: 0;
}

.todo-title,
.todo-meta {
  display: block;
}

.todo-title {
  overflow: hidden;
  color: #2c312e;
  font-size: 28rpx;
  font-weight: 700;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.todo-meta {
  margin-top: 8rpx;
  overflow: hidden;
  color: #9aa49d;
  font-size: 21rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.todo-status {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 auto;
  width: 38rpx;
  height: 38rpx;
  margin-left: 16rpx;
  box-sizing: border-box;
  border: 1rpx solid #dfe4df;
  border-radius: 50%;
  background: #fff;
}

.todo-status-dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: #FD7C02;
}

.todo-status-in-progress {
  border-color: #FD7C02;
  background: #fff;
}

.todo-status-completed {
  border-color: #58a878;
  background: #edf8f0;
}

.todo-status-check {
  color: #58a878;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1;
}

/* 「连续学习」统计格可点击进入每日打卡（设计仓库 7ebabb2）。 */

/* 首次加载骨架（styles/skeleton.wxss） */
.overview-value-skeleton { width: 72rpx; height: 36rpx; }
.study-task-skeleton-meta { height: 22rpx; margin-top: 12rpx; }
.my-course-skeleton-copy { flex: 1; }
.my-course-skeleton-sub { height: 22rpx; margin-top: 12rpx; }

/* 平板、电脑大屏（窗口宽 ≥ 450px，见 utils/screen.js）：和首页一样放宽到 1040px（LARGE_SCREEN_WIDE_COLUMN）。
   一周 7 天在宽屏下一行放得下，均匀铺满这一行，不挤在左边；我的课程的三列、四列在 styles/course-grid.wxss。 */
@media (min-width: 450px) {
  page { --lg-col: 1040px; }
  .study-date-list { justify-content: space-between; }
}




@media (min-width:450px) {
.tablet-study-summary { padding:18px; border-radius:20px; background:#fff; }
.calendar-heading { margin-top:0; }
.study-date-list { gap:8px; }
.study-date { min-width:0; }
.study-date-tile { width:38px; height:50px; border-radius:12px; }
.study-date-value { font-size:18px; }
.study-date-label { font-size:11px; }
.overview-grid { gap:10px; }
.overview-icon { width:28px; height:28px; }
}
@media (min-width:760px) {
.page-shell { display:grid; grid-template-columns:290px minmax(0,1fr); column-gap:24px; align-items:start; }
.tablet-study-summary { margin-top:14px; }
.my-courses-section { margin-top:14px; }
.more-course-card { width:calc((100% - 13px)/2); }
}


@media (min-width:760px) {
.study-date { flex:0 0 38px; width:38px; }
.overview-item { flex-direction:column; align-items:flex-start; gap:10px; }
.overview-copy { width:100%; margin-left:0; }
.overview-label { white-space:normal; text-overflow:clip; font-size:11px; }
.study-access-prompt { flex-direction:column; align-items:flex-start; gap:16px; }
.access-prompt-copy { width:100%; }
}


@media (min-width:450px) {
.learning-page .page-shell { display:grid; grid-template-columns:180px minmax(0,1fr); gap:16px; padding-left:16px; padding-right:16px; align-items:start; }
.learning-page .tablet-study-summary { padding:14px; margin-top:14px; }
.learning-page .calendar-heading { flex-wrap:wrap; gap:8px; }
.learning-page .calendar-title { font-size:17px; }
.learning-page .calendar-shortcut-pill { margin-left:0; }
.learning-page .study-date { flex:0 0 38px; width:38px; }
.learning-page .overview-grid { display:grid; grid-template-columns:minmax(0,1fr); gap:14px; }
.learning-page .learning-overview-panel.learning-overview-expanded { max-height:300px; }
.learning-page .overview-item { padding:8px; display:flex; flex-direction:row; align-items:center; gap:10px; }
.learning-page .overview-copy { flex:1; width:auto; margin-left:0; }
.learning-page .overview-label { white-space:normal; font-size:12px; }
.learning-page .study-access-prompt { flex-direction:column; align-items:flex-start; gap:14px; padding:12px; }
.learning-page .access-prompt-copy { width:100%; }
.learning-page .my-courses-section { margin-top:14px; min-width:0; }
.learning-page .enterprise-service-card { flex-wrap:wrap; gap:10px; padding:14px; }
.learning-page .enterprise-service-copy { flex:1; min-width:90px; margin:0; }
.learning-page .enterprise-service-title { font-size:14px; white-space:normal; }
.learning-page .enterprise-service-description { font-size:11px; white-space:normal; }
.learning-page .more-course-card { width:100%; }
.learning-page .calendar-overlay { right:auto; left:max(16px,calc((100% - 1040px)/2 + 16px)); width:180px; }
}
@media (min-width:600px) {
.learning-page .page-shell { grid-template-columns:210px minmax(0,1fr); }
.learning-page .more-course-card { width:calc((100% - 13px)/2); }
.learning-page .calendar-overlay { width:210px; }
}
@media (min-width:1000px) {
.learning-page .page-shell { grid-template-columns:260px minmax(0,1fr); }
.learning-page .calendar-overlay { width:260px; }
}

/* ---------- 头图 + 成就卡横条（2026-10-13） ---------- */

.learning-topbar {
  transition: background-color 200ms ease;
}

.learning-topbar.learning-topbar-hero {
  background: #FFF3E6;
}

/* 头图不单独画底：整段内容顶部一层从顶栏同色开始、慢慢淡到页面底色的渐变，顶栏 → 头图 → 成就卡之间没有接缝 */
.page-shell {
  background:
    radial-gradient(360rpx 240rpx at 84% 280rpx, rgba(253, 124, 2, 0.12), rgba(253, 124, 2, 0)),
    linear-gradient(180deg, #FFF3E6 0rpx, #FFF6EE 260rpx, #FAFAFA 640rpx);
  background-repeat: no-repeat;
}

.learn-hero {
  position: relative;
  display: flex;
  align-items: center;
  min-height: 260rpx;
  padding: 8rpx 0 28rpx;
  box-sizing: border-box;
}

.learn-hero-copy {
  position: relative;
  z-index: 1;
  flex: 1;
  min-width: 0;
  padding-right: 24rpx;
}

.learn-hero-pill {
  display: inline-flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 26rpx;
  padding: 12rpx 24rpx 12rpx 18rpx;
  border: 3rpx solid transparent;
  border-radius: 999rpx;
  background: linear-gradient(#FFFFFF, #FFFFFF) padding-box, linear-gradient(90deg, #7C9CFF, #FD7C02) border-box;
  color: #24332d;
  font-size: 26rpx;
  font-weight: 700;
  box-shadow: 0 8rpx 20rpx rgba(253, 124, 2, 0.14);
}

/* 没有抽卡机会也显示，×0，颜色收一点 */
.learn-hero-pill-empty {
  box-shadow: none;
  color: #7d8580;
}

.learn-hero-pill-empty .learn-hero-pill-card {
  background: linear-gradient(150deg, #E3E6E4, #C9CECB);
}

.learn-hero-pill-sk {
  width: 230rpx;
  height: 68rpx;
  margin-bottom: 26rpx;
  border-radius: 999rpx;
}

.learn-hero-pill:active {
  transform: scale(0.97);
}

.learn-hero-pill-card {
  width: 26rpx;
  height: 34rpx;
  border-radius: 5rpx;
  background: linear-gradient(150deg, #FFC27A, #FD7C02);
  transform: rotate(-10deg);
}

.learn-hero-pill-count {
  font-size: 28rpx;
}

.learn-hero-pill-split {
  width: 2rpx;
  height: 26rpx;
  background: rgba(36, 51, 45, 0.15);
}

.learn-hero-pill-chevron {
  color: #a3aaa5;
}

.learn-hero-quote {
  display: block;
  color: #24332d;
  font-size: 44rpx;
  font-weight: 800;
  line-height: 1.35;
  letter-spacing: 1rpx;
}

/* 两行骨架与两行一句话同高（字号 44rpx、行高 1.35） */
.learn-hero-sk {
  height: 44rpx;
  margin: 0 0 15rpx;
}

.sk-line.learn-hero-sk + .sk-line.learn-hero-sk {
  margin-top: 0;
}

.learn-hero-deck {
  position: relative;
  flex: none;
  width: 200rpx;
  height: 210rpx;
}

.learn-hero-deck-card {
  position: absolute;
  top: 18rpx;
  left: 48rpx;
  width: 128rpx;
  height: 176rpx;
  border-radius: 16rpx;
  box-shadow: 0 12rpx 26rpx rgba(36, 51, 45, 0.12);
}

.learn-hero-deck-back2 {
  background: #FFD9B0;
  transform: rotate(16deg) translate(30rpx, 4rpx);
}

.learn-hero-deck-back1 {
  background: #FFE9D2;
  transform: rotate(6deg) translate(14rpx, 0);
}

.learn-hero-deck-front {
  display: flex;
  align-items: center;
  justify-content: center;
  border: 6rpx solid var(--ac-color, #FD7C02);
  box-sizing: border-box;
  overflow: hidden;
  background: #FFFFFF;
  transform: rotate(-8deg);
  animation: learn-hero-float 4.6s ease-in-out infinite;
}

.learn-hero-deck-image {
  width: 100%;
  height: 100%;
}

.learn-hero-deck-mark {
  color: var(--ac-color, #FD7C02);
  font-size: 34rpx;
  font-weight: 800;
  letter-spacing: 4rpx;
}

@keyframes learn-hero-float {
  0%, 100% { transform: rotate(-8deg) translateY(0); }
  50% { transform: rotate(-6deg) translateY(-8rpx); }
}

.ach-strip-section {
  margin: 8rpx 0 28rpx;
}

.ach-strip-head {
  display: flex;
  align-items: center;
  gap: 18rpx;
  margin-bottom: 20rpx;
}

.ach-strip-title {
  flex: none;
  color: #111613;
  font-size: 36rpx;
  font-weight: 800;
}

.ach-strip-count {
  font-weight: 800;
}

.ach-strip-line {
  flex: 1;
  height: 3rpx;
  border-radius: 2rpx;
  background: rgba(36, 51, 45, 0.08);
}

.ach-strip-all {
  color: #4b5563;
  font-size: 28rpx;
}

.ach-strip-chevron {
  margin-left: -8rpx;
  color: #a3aaa5;
  font-size: 34rpx;
}

.ach-strip-scroll {
  width: auto;
  margin: 0 -36rpx;
  white-space: nowrap;
}

.ach-strip {
  display: flex;
  gap: 20rpx;
  padding: 14rpx 36rpx 18rpx;
}

.ach-strip-item {
  flex: none;
  width: 150rpx;
}

.ach-strip-item:active .ach-strip-card {
  transform: scale(0.95);
}

.ach-strip-card {
  position: relative;
  width: 150rpx;
  height: 210rpx;
  border-radius: 16rpx;
  box-shadow: 0 8rpx 20rpx rgba(36, 51, 45, 0.1);
  transition: transform 160ms ease, opacity 120ms ease;
}

.ach-strip-away {
  opacity: 0;
}

/* 骨架与读到后的横条同一套外边距、内边距，位置一致；多出的格子被裁掉 */
.ach-strip-sk-row {
  overflow: hidden;
}

.ach-strip-sk {
  width: 150rpx;
  height: 210rpx;
  border-radius: 16rpx;
}

.ach-strip-empty {
  display: block;
  padding: 24rpx 0;
  color: #8a928e;
  font-size: 26rpx;
}

.ach-access-prompt {
  margin-top: 4rpx;
}

@media (min-width: 450px) {
  .learning-page .learn-hero,
  .learning-page .ach-strip-section {
    grid-column: 1 / -1;
  }
  .learning-page .page-shell,
  .learning-page .page-scroll {
    background: #FAFAFA;
  }
  .learning-page .learn-hero {
    padding: 12px 20px;
    border-radius: 20px;
    background: linear-gradient(135deg, #FFF3E6 0%, #FFFFFF 100%);
  }
  /* 大屏头图是圆角卡片，不贴顶栏，顶栏保持页面底色 */
  .learning-page .learning-topbar.learning-topbar-hero {
    background: #FAFAFA;
  }
  .learning-page .ach-strip-scroll {
    margin: 0;
  }
  .learning-page .ach-strip {
    padding-left: 0;
    padding-right: 0;
  }
}

/* 闯关学习路径（2026-11-11，多邻国式）：大目标卡 + 每段横幅 + 左右摆动的圆形关卡。
   关卡偏移来自 utils/quest-path-view.js 的 ZIGZAG（rpx 设计值，经 CSS 变量换算，行内 style 不写 rpx）。
   完成是实心橙，当前关有「开始」气泡和外圈，没开放是灰色；按下有立体下沉感。 */
.quest { margin-top: 12rpx; }
.quest-sk { display: flex; flex-direction: column; align-items: center; }
.quest-sk-goal { width: 100%; height: 150rpx; margin-bottom: 24rpx; border-radius: 28rpx; }
.quest-sk-node { width: 132rpx; height: 132rpx; margin: 18rpx 0; }
.quest-goal { padding: 28rpx 30rpx; border-radius: 28rpx; background: linear-gradient(135deg, #FFF3E6, #FFE4C8); }
.quest-goal-label { display: block; color: #E06A00; font-size: 22rpx; font-weight: 700; letter-spacing: 2rpx; }
.quest-goal-title { display: block; margin-top: 8rpx; color: #24332D; font-size: 32rpx; font-weight: 800; line-height: 1.4; }
.quest-goal-bar { height: 16rpx; margin-top: 20rpx; overflow: hidden; border-radius: 999rpx; background: rgba(255, 255, 255, .8); }
.quest-goal-fill { height: 100%; min-width: 16rpx; border-radius: 999rpx; background: linear-gradient(90deg, #FFB25B, #FD7C02); }
.quest-goal-progress { display: block; margin-top: 10rpx; color: #8A6A4A; font-size: 22rpx; }
.quest-empty { margin-top: 24rpx; padding: 40rpx 32rpx; border-radius: 28rpx; background: #FFFFFF; text-align: center; }
.quest-empty-title { display: block; color: #24332D; font-size: 30rpx; font-weight: 700; }
.quest-empty-copy { display: block; margin-top: 12rpx; color: #7E8A82; font-size: 25rpx; line-height: 1.6; }

.quest-section { margin-top: 36rpx; --tone: #FD7C02; --tone-soft: #FFF0E2; --tone-deep: #D96400; }
.quest-section.tone-blue { --tone: #3E8BF0; --tone-soft: #EAF3FF; --tone-deep: #2A6CC4; }
.quest-section.tone-violet { --tone: #8A63D9; --tone-soft: #F2ECFF; --tone-deep: #6C47B8; }
.quest-section.tone-teal { --tone: #23A391; --tone-soft: #E6F7F4; --tone-deep: #17806F; }
.quest-section.tone-rose { --tone: #E2577A; --tone-soft: #FDECF1; --tone-deep: #B83C5B; }
.quest-banner { display: flex; align-items: center; gap: 20rpx; padding: 24rpx 28rpx; border-radius: 26rpx; background: var(--tone); box-shadow: 0 8rpx 0 var(--tone-deep); }
.quest-banner-copy { flex: 1; min-width: 0; }
.quest-banner-no { display: block; color: rgba(255, 255, 255, .82); font-size: 22rpx; font-weight: 700; }
.quest-banner-title { display: block; margin-top: 4rpx; color: #FFFFFF; font-size: 30rpx; font-weight: 800; line-height: 1.35; }
.quest-banner-sub { display: block; margin-top: 6rpx; color: rgba(255, 255, 255, .86); font-size: 22rpx; line-height: 1.45; }
.quest-banner-progress { flex: 0 0 auto; padding: 8rpx 18rpx; border-radius: 999rpx; background: rgba(255, 255, 255, .22); color: #FFFFFF; font-size: 24rpx; font-weight: 800; }

.quest-track { padding: 20rpx 0 8rpx; }
.quest-row { display: flex; flex-direction: column; align-items: center; }
.quest-lesson { max-width: 80%; margin: 26rpx 0 6rpx; padding: 6rpx 20rpx; border-radius: 999rpx; background: #F2F1EE; color: #5D6862; font-size: 22rpx; text-align: center; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.quest-node-wrap { position: relative; display: flex; flex-direction: column; align-items: center; margin: 14rpx 0; transform: translateX(calc(var(--x) * 1000rpx / 1000)); }
.quest-node { display: flex; width: 132rpx; height: 124rpx; align-items: center; justify-content: center; border-radius: 50%; background: #E5E3DF; box-shadow: 0 10rpx 0 #CBC8C2; }
.quest-node:active { transform: translateY(6rpx); box-shadow: 0 4rpx 0 #CBC8C2; }
.quest-node.is-done { background: var(--tone); box-shadow: 0 10rpx 0 var(--tone-deep); }
.quest-node.is-open, .quest-node.is-current { background: var(--tone); box-shadow: 0 10rpx 0 var(--tone-deep); }
.quest-node.is-current { outline: 8rpx solid var(--tone-soft); }
.quest-node.is-done:active, .quest-node.is-open:active, .quest-node.is-current:active { box-shadow: 0 4rpx 0 var(--tone-deep); }
.quest-node.kind-chest, .quest-node.kind-review { border-radius: 34rpx; }
.quest-node.kind-review.is-open { background: #23A391; box-shadow: 0 10rpx 0 #17806F; }
.quest-node.kind-chest.is-done { background: #F5B301; box-shadow: 0 10rpx 0 #C98F00; }
.quest-node-label { margin-top: 18rpx; color: #24332D; font-size: 24rpx; font-weight: 700; }
.quest-node-detail { margin-top: 2rpx; max-width: 300rpx; color: #8A948D; font-size: 20rpx; text-align: center; }
.quest-start { position: absolute; top: -58rpx; z-index: 2; padding: 8rpx 22rpx; border: 3rpx solid #ECE9E4; border-radius: 16rpx; background: #FFFFFF; color: var(--tone); font-size: 24rpx; font-weight: 800; animation: quest-bob 1.4s ease-in-out infinite; }
.quest-start::after { position: absolute; bottom: -12rpx; left: 50%; width: 18rpx; height: 18rpx; border-right: 3rpx solid #ECE9E4; border-bottom: 3rpx solid #ECE9E4; background: #FFFFFF; content: ''; transform: translateX(-50%) rotate(45deg); }
@keyframes quest-bob { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-8rpx); } }

/* 关卡图标：CSS 画，白色；没开放时灰 */
.quest-icon { position: relative; width: 52rpx; height: 52rpx; }
.quest-node.is-locked .quest-icon { opacity: .9; }
.icon-play::before { position: absolute; top: 6rpx; left: 14rpx; border-top: 20rpx solid transparent; border-bottom: 20rpx solid transparent; border-left: 30rpx solid #FFFFFF; content: ''; }
.icon-pencil::before { position: absolute; top: 4rpx; left: 20rpx; width: 14rpx; height: 40rpx; border-radius: 4rpx 4rpx 0 0; background: #FFFFFF; content: ''; transform: rotate(40deg); }
.icon-pencil::after { position: absolute; top: 38rpx; left: 8rpx; border-top: 8rpx solid transparent; border-bottom: 8rpx solid transparent; border-right: 12rpx solid #FFFFFF; content: ''; transform: rotate(-50deg); }
.icon-mic::before { position: absolute; top: 0; left: 15rpx; width: 22rpx; height: 32rpx; border-radius: 11rpx; background: #FFFFFF; content: ''; }
.icon-mic::after { position: absolute; top: 18rpx; left: 8rpx; width: 30rpx; height: 22rpx; border: 5rpx solid #FFFFFF; border-top: 0; border-radius: 0 0 18rpx 18rpx; content: ''; }
.icon-check::before { position: absolute; top: 2rpx; left: 16rpx; width: 16rpx; height: 32rpx; border-right: 8rpx solid #FFFFFF; border-bottom: 8rpx solid #FFFFFF; content: ''; transform: rotate(45deg); }
.icon-lock::before { position: absolute; top: 2rpx; left: 12rpx; width: 20rpx; height: 20rpx; border: 6rpx solid #A9A59E; border-bottom: 0; border-radius: 16rpx 16rpx 0 0; content: ''; }
.icon-lock::after { position: absolute; top: 22rpx; left: 6rpx; width: 40rpx; height: 28rpx; border-radius: 6rpx; background: #A9A59E; content: ''; }
.icon-review::before { position: absolute; top: 4rpx; left: 4rpx; width: 34rpx; height: 34rpx; border: 7rpx solid #FFFFFF; border-right-color: transparent; border-radius: 50%; content: ''; }
.icon-review::after { position: absolute; top: 4rpx; right: 4rpx; border-top: 10rpx solid transparent; border-bottom: 10rpx solid transparent; border-left: 14rpx solid #FFFFFF; content: ''; transform: rotate(60deg); }
.icon-chest::before, .icon-chest-open::before { position: absolute; top: 18rpx; left: 2rpx; width: 48rpx; height: 30rpx; border-radius: 4rpx 4rpx 8rpx 8rpx; background: #A9A59E; content: ''; }
.icon-chest::after { position: absolute; top: 6rpx; left: 2rpx; width: 48rpx; height: 14rpx; border-radius: 12rpx 12rpx 2rpx 2rpx; background: #BDB9B2; content: ''; }
.icon-chest-open::before { background: #FFFFFF; }
.icon-chest-open::after { position: absolute; top: -4rpx; left: 2rpx; width: 48rpx; height: 14rpx; border-radius: 12rpx 12rpx 2rpx 2rpx; background: #FFF4C7; content: ''; transform: rotate(-16deg); }

/* 2026-11-11 学习页去掉了左栏（日历、今日统计、学习任务）：大屏不再分两栏，闯关路径居中铺开 */
@media (min-width:450px) {
.learning-page .page-shell { display:block; }
.learning-page .my-courses-section { max-width:720px; margin-left:auto; margin-right:auto; }
}

@import "./index.large.wxss"; /* 平板、电脑大屏样式：由 scripts/build-large-screen-styles.mjs 生成，改完本文件后重跑；这一行须留在文件末尾 */
