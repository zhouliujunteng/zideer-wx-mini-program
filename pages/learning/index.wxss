page {
  background: #FAFAFA;
}

.learning-page {
  height: 100vh;
  overflow: hidden;
  background: #FAFAFA;
  color: #24332d;
}

.learning-topbar {
  position: fixed;
  top: 0;
  left: 0;
  z-index: 20;
  width: 100%;
  box-sizing: border-box;
  background: #FAFAFA;
}

.learning-topbar-inner {
  display: flex;
  align-items: center;
  box-sizing: content-box;
  padding: 0 36rpx 16rpx;
}

.learning-topbar-title {
  color: #24332d;
  font-size: 36rpx;
  font-weight: 700;
  letter-spacing: -1rpx;
  line-height: 1;
}

.learning-notice-button {
  position: fixed;
  z-index: 21;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  border: 1rpx solid #e7ebe6;
  border-radius: 50%;
  background: #fff;
}

.learning-message-icon {
  display: block;
  width: 34rpx;
  height: 34rpx;
}

.learning-notice-badge {
  position: absolute;
  top: -8rpx;
  right: -8rpx;
  min-width: 27rpx;
  height: 27rpx;
  padding: 0 6rpx;
  box-sizing: border-box;
  border: 3rpx solid #FAFAFA;
  border-radius: 999rpx;
  background: #FD5A5F;
  color: #fff;
  font-size: 17rpx;
  line-height: 21rpx;
  text-align: center;
}

.page-scroll {
  height: 100vh;
  box-sizing: border-box;
  background: #FAFAFA;
}

.page-shell {
  min-height: 100%;
  padding: 16rpx 36rpx 180rpx;
  box-sizing: border-box;
}

.calendar-heading {
  display: flex;
  align-items: center;
}

.calendar-title {
  color: #111613;
  font-size: 38rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
  line-height: 1.25;
}

.calendar-chevron {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 30rpx;
  height: 46rpx;
  margin-left: 12rpx;
  color: #7d8580;
  font-size: 36rpx;
  line-height: 1;
}

.calendar-shortcut-pill {
  margin-left: 20rpx;
  padding: 10rpx 22rpx;
  border-radius: 999rpx;
  background: rgba(253, 124, 2, 0.10);
  color: #FD7C02;
  font-size: 25rpx;
  font-weight: 700;
  line-height: 1.1;
}

.calendar-return-today {
  margin-left: auto;
  color: #a3aaa5;
  font-size: 22rpx;
  line-height: 1.2;
}

.calendar-days-slot {
  box-sizing: border-box;
  margin-top: 30rpx;
  margin-right: -36rpx;
  margin-left: -36rpx;
  padding: 14rpx 36rpx 16rpx;
  border-bottom: 1rpx solid #e7ebe7;
}

.calendar-overlay {
  position: fixed;
  left: 0;
  right: 0;
  z-index: 19;
  padding: 14rpx 36rpx 16rpx;
  box-sizing: border-box;
  border-bottom: 1rpx solid #e7ebe7;
  background: #FAFAFA;
  opacity: 0;
  visibility: hidden;
  pointer-events: none;
  transition: opacity 80ms ease, visibility 0s linear 80ms;
}

.calendar-overlay-visible {
  opacity: 1;
  visibility: visible;
  pointer-events: auto;
  transition-delay: 0s;
}

.study-date-strip {
  width: 100%;
  white-space: nowrap;
}

.study-date-list {
  display: inline-flex;
  min-width: 100%;
  height: 121rpx;
  padding: 0 6rpx;
  box-sizing: border-box;
  gap: 14rpx;
}

.study-date {
  position: relative;
  display: flex;
  flex: 0 0 112rpx;
  flex-direction: column;
  align-items: center;
}

.study-date-tile {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  width: 104rpx;
  height: 104rpx;
  box-sizing: border-box;
  border: 0;
  border-radius: 20rpx;
  background: #fff;
  color: #252b27;
}

.study-date-value,
.study-date-label {
  display: block;
}

.study-date-value {
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1.2;
}

.study-date-label {
  margin-top: 8rpx;
  color: #a2a8a3;
  font-size: 20rpx;
  line-height: 1.2;
}

.study-date-has-task .study-date-label {
  color: #68716a;
}

.study-date-selected {
  border: 1rpx solid #FD7C02;
  background: rgba(253, 124, 2, 0.10);
}

.study-date-selected .study-date-value {
  color: #252b27;
}

.study-date-selected .study-date-label {
  color: #969d97;
}

/* 无任务日期不表达可执行状态，日期数字与辅助标签统一弱化。 */
.study-date:not(.study-date-has-task) .study-date-value {
  color: #b1b8b2;
}

.study-date:not(.study-date-has-task) .study-date-selected .study-date-value {
  color: #252b27;
}

.study-date-task-dot {
  position: absolute;
  z-index: 1;
  top: 88rpx;
  left: 50%;
  width: 8rpx;
  height: 8rpx;
  margin: 0;
  border-radius: 50%;
  background: #FD7C02;
  transform: translateX(-50%);
}

.study-tasks-section {
  margin-top: 34rpx;
  transition: margin-top 260ms ease;
}

.study-tasks-section.study-tasks-with-overview {
  margin-top: 42rpx;
}

.study-task-list-shell {
  overflow: hidden;
  transition: height 260ms cubic-bezier(.22, .78, .32, 1), opacity 150ms ease;
}

.study-task-list-card,
.todo-list-card,
.my-courses-section {
  margin-top: 20rpx;
  padding: 20rpx 30rpx;
  box-sizing: border-box;
  border-radius: 36rpx;
  background: #fff;
}

.my-courses-heading { align-items: center; }
.my-courses-library-link { margin-left: auto; color: #7d8580; font-size: 23rpx; }
.my-courses-search { box-sizing: border-box; width: 100%; height: 72rpx; margin-top: 18rpx; padding: 0 24rpx; border: 1rpx solid #e1e6e2; border-radius: 18rpx; background: #fafcfb; color: #24332d; font-size: 25rpx; }
.my-courses-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 18rpx; margin-top: 18rpx; }
.my-course-card { overflow: hidden; min-width: 0; border-radius: 22rpx; background: #fff; box-shadow: 0 8rpx 24rpx rgba(36, 51, 45, .05); }
/* 从对话的课程链接跳过来时，短暂高亮这门课的卡片 */
.my-course-card.is-focused { box-shadow: 0 0 0 4rpx rgba(253, 124, 2, .55), 0 10rpx 28rpx rgba(253, 124, 2, .18); transition: box-shadow .24s ease; }
.my-course-cover { display: flex; align-items: center; justify-content: center; height: 150rpx; }
.my-course-cover-mint { background: #dcefe8; color: #267348; }
.my-course-cover-peach { background: #f8e1d5; color: #b55d3d; }
.my-course-cover-lilac { background: #e5e1f4; color: #6f62a6; }
.my-course-cover-image { width: 100%; height: 100%; }
.my-course-cover-mark { font-size: 34rpx; font-weight: 700; letter-spacing: 4rpx; }
.my-course-copy { padding: 18rpx 18rpx 20rpx; }
.my-course-title { display: block; overflow: hidden; color: #24332d; font-size: 27rpx; font-weight: 700; line-height: 1.45; text-overflow: ellipsis; white-space: nowrap; }
.my-course-meta { display: block; overflow: hidden; margin-top: 8rpx; color: #7d8580; font-size: 22rpx; text-overflow: ellipsis; white-space: nowrap; }
.my-course-footer { display: flex; justify-content: space-between; gap: 8rpx; margin-top: 16rpx; color: #fd7c02; font-size: 21rpx; }
.my-course-footer text:last-child { color: #8a938d; }
.my-courses-empty { display: block; margin-top: 20rpx; padding: 44rpx 20rpx; border-radius: 22rpx; background: #fff; color: #8a938d; font-size: 24rpx; text-align: center; }

.study-task-list-shell.study-task-list-leaving,
.study-task-list-shell.study-task-list-enter-prep {
  opacity: 0;
  pointer-events: none;
}

.study-task-list-shell.study-task-list-enter {
  opacity: 1;
  pointer-events: auto;
}

.learning-overview-panel {
  max-height: 170rpx;
  margin-top: 34rpx;
  overflow: hidden;
  opacity: 1;
  transition: max-height 260ms cubic-bezier(.22, .78, .32, 1), margin-top 260ms cubic-bezier(.22, .78, .32, 1), opacity 180ms ease;
}

.learning-overview-panel.learning-overview-collapsed {
  max-height: 0;
  margin-top: 0;
  opacity: 0;
  pointer-events: none;
}

.overview-grid {
  display: flex;
  gap: 14rpx;
}

.overview-item {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  padding: 22rpx 14rpx;
  border: 0;
  border-radius: 22rpx;
  background: #fff;
}

.overview-icon {
  flex: 0 0 auto;
  width: 62rpx;
  height: 62rpx;
  margin-right: 10rpx;
}

.overview-copy {
  flex: 1;
  min-width: 0;
}

.overview-value {
  display: flex;
  align-items: baseline;
  color: #24332d;
  font-size: 33rpx;
  font-weight: 700;
}

.overview-digit-window {
  display: block;
  min-width: 20rpx;
  height: 40rpx;
  overflow: hidden;
  text-align: center;
}

.overview-digit-track {
  display: flex;
  flex-direction: column;
  will-change: transform;
}

.overview-digit-track.up.overview-digit-settled {
  transform: translate3d(0, -50%, 0);
}

.overview-digit-track.down.overview-digit-settled {
  transform: translate3d(0, 0, 0);
}

.overview-digit-track.up.overview-digit-roll-a {
  animation: overview-digit-roll-up-a 460ms cubic-bezier(.22, .78, .32, 1) both;
}

.overview-digit-track.up.overview-digit-roll-b {
  animation: overview-digit-roll-up-b 460ms cubic-bezier(.22, .78, .32, 1) both;
}

.overview-digit-track.down.overview-digit-roll-a {
  animation: overview-digit-roll-down-a 460ms cubic-bezier(.22, .78, .32, 1) both;
}

.overview-digit-track.down.overview-digit-roll-b {
  animation: overview-digit-roll-down-b 460ms cubic-bezier(.22, .78, .32, 1) both;
}

.overview-digit {
  height: 40rpx;
  font-size: 33rpx;
  line-height: 40rpx;
}

@keyframes overview-digit-roll-up-a {
  from { transform: translate3d(0, 0, 0); }
  to { transform: translate3d(0, -50%, 0); }
}

@keyframes overview-digit-roll-up-b {
  from { transform: translate3d(0, 0, 0); }
  to { transform: translate3d(0, -50%, 0); }
}

@keyframes overview-digit-roll-down-a {
  from { transform: translate3d(0, -50%, 0); }
  to { transform: translate3d(0, 0, 0); }
}

@keyframes overview-digit-roll-down-b {
  from { transform: translate3d(0, -50%, 0); }
  to { transform: translate3d(0, 0, 0); }
}

.overview-unit {
  margin-left: 3rpx;
  font-size: 18rpx;
  font-weight: 400;
}

.overview-label {
  display: block;
  margin-top: 6rpx;
  overflow: hidden;
  color: #818c84;
  font-size: 19rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.tasks-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.tasks-title {
  color: #24332d;
  font-size: 34rpx;
  font-weight: 700;
}

.study-task-item {
  display: flex;
  align-items: center;
  height: 96rpx;
  min-height: 96rpx;
  margin-top: 0;
  padding: 0;
  box-sizing: border-box;
  border-bottom: 0;
}

.study-task-item + .study-task-item {
  margin-top: 20rpx;
}

.study-task-body {
  flex: 1;
  min-width: 0;
}

.study-task-title,
.study-task-meta {
  display: block;
}

.study-task-title {
  overflow: hidden;
  color: #2c312e;
  font-size: 28rpx;
  font-weight: 700;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.study-task-meta {
  margin-top: 10rpx;
  color: #9aa49d;
  font-size: 21rpx;
}

.study-task-side-pill {
  flex: 0 0 auto;
  width: 10rpx;
  height: 46rpx;
  margin: 0 18rpx 0 2rpx;
  border-radius: 999rpx;
  background: #e3e8e4;
}

.progress-ring {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
}

.progress-ring-inner {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 54rpx;
  height: 54rpx;
  border-radius: 50%;
  background: #fff;
}

.progress-ring-inner text {
  color: #24332d;
  font-size: 18rpx;
  font-weight: 700;
}

.study-task-ring {
  flex: 0 0 auto;
  margin: 0 4rpx 0 18rpx;
}

.study-task-empty {
  display: block;
  color: #77827a;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 96rpx;
  text-align: center;
}

.todo-section {
  margin-top: 46rpx;
}

.todo-list {
  margin: 0;
}

.todo-item {
  display: flex;
  align-items: center;
  min-height: 76rpx;
  padding: 0;
  box-sizing: border-box;
  border-bottom: 0;
}

.todo-item + .todo-item {
  margin-top: 12rpx;
}

.todo-empty {
  display: block;
  color: #77827a;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 76rpx;
  text-align: center;
}

.todo-copy {
  flex: 1;
  min-width: 0;
}

.todo-title,
.todo-meta {
  display: block;
}

.todo-title {
  overflow: hidden;
  color: #2c312e;
  font-size: 28rpx;
  font-weight: 700;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.todo-meta {
  margin-top: 8rpx;
  overflow: hidden;
  color: #9aa49d;
  font-size: 21rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.todo-status {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 auto;
  width: 38rpx;
  height: 38rpx;
  margin-left: 16rpx;
  box-sizing: border-box;
  border: 1rpx solid #dfe4df;
  border-radius: 50%;
  background: #fff;
}

.todo-status-dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: #FD7C02;
}

.todo-status-in-progress {
  border-color: #FD7C02;
  background: #fff;
}

.todo-status-completed {
  border-color: #58a878;
  background: #edf8f0;
}

.todo-status-check {
  color: #58a878;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1;
}
.my-course-state { display: flex; align-items: center; min-width: 0; }
.my-course-footer .my-course-state .my-course-state-label { color: #fd7c02; }
.my-course-live-dot { flex: 0 0 auto; width: 10rpx; height: 10rpx; margin-right: 8rpx; border-radius: 50%; background: #fd7c02; animation: my-course-live 1.4s ease-in-out infinite; }
.my-course-progress-track { height: 6rpx; margin-top: 12rpx; overflow: hidden; border-radius: 999rpx; background: rgba(253, 124, 2, 0.14); }
.my-course-progress-bar { height: 100%; border-radius: 999rpx; background: #fd7c02; transition: width 0.4s ease; }
@keyframes my-course-live { 0%, 100% { opacity: 1; } 50% { opacity: 0.3; } }
