.intro-page { min-height:100vh; padding:52rpx 28rpx calc(env(safe-area-inset-bottom) + 48rpx); }.intro-hero { padding:20rpx 8rpx 28rpx; }.intro-eyebrow { display:block; color:var(--accent-deep); font-size:23rpx; font-weight:700; }.intro-title { display:block; margin-top:16rpx; font-size:44rpx; font-weight:700; line-height:1.25; overflow-wrap:anywhere; }.intro-copy { display:block; margin-top:18rpx; color:var(--muted); font-size:24rpx; line-height:1.65; }.intro-primary { width:100%; min-height:90rpx; margin-top:32rpx; border-radius:8rpx; background:var(--ink); color:#fff; font-size:28rpx; font-weight:700; }.intro-section { margin-top:42rpx; }.intro-section__title { display:block; padding:0 8rpx; font-size:28rpx; font-weight:700; }.intro-flow { margin-top:18rpx; padding:0 26rpx; background:var(--surface); border:1rpx solid var(--line); border-radius:8rpx; }.intro-flow__item { display:flex; gap:18rpx; padding:28rpx 0; border-bottom:1rpx solid var(--line); }.intro-flow__item:last-child { border-bottom:0; }.intro-flow__number { display:flex; width:42rpx; height:42rpx; align-items:center; justify-content:center; flex:none; border-radius:50%; background:var(--blue-soft); color:var(--blue); font-size:20rpx; font-weight:700; }.intro-flow__title,.intro-flow__copy { display:block; }.intro-flow__title { font-size:25rpx; font-weight:700; }.intro-flow__copy { margin-top:8rpx; color:var(--muted); font-size:21rpx; line-height:1.55; }.intro-actions { margin-top:18rpx; }.intro-action { display:flex; width:100%; min-height:112rpx; align-items:center; gap:18rpx; margin-top:16rpx; padding:20rpx 22rpx; text-align:left; }.intro-action image { width:46rpx; height:46rpx; flex:none; }.intro-action view { min-width:0; flex:1; }.intro-action text { display:block; }.intro-action text:nth-child(1) { font-size:24rpx; font-weight:700; }.intro-action text:nth-child(2) { overflow:hidden; margin-top:7rpx; color:var(--muted); font-size:20rpx; text-overflow:ellipsis; white-space:nowrap; }.intro-action > text:last-child { flex:none; color:var(--muted); font-size:32rpx; }
