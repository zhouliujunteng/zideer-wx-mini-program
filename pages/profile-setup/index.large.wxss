/* 自动生成，请勿手改：index.wxss 在平板、电脑大屏（窗口宽 ≥ 450px）下的样式。
   rpx 按 1rpx = 0.6px 换算，固定定位元素收进居中栏；改完源文件后运行 node scripts/build-large-screen-styles.mjs */
@media (min-width: 450px) {
.sk{border-radius:7px}
.sk-line{height:16px}
.sk-line + .sk-line{margin-top:8px}
.sk-short{width:40%}
.sk-mid{width:64%}
.sk-round{border-radius:50%}
.sk-card{height:96px;border-radius:14px}
.sk-card + .sk-card{margin-top:12px}
.profile-setup-page{height:100vh}
.profile-setup-topbar{top:0;left:max(0px, 50% - var(--lg-col) / 2);width:min(100%, var(--lg-col));box-sizing:border-box}
.profile-setup-topbar::after{right:0;bottom:0;left:0;height:0.5px}
.profile-setup-topbar-inner{box-sizing:content-box;padding:0 21px 9px}
.profile-setup-back{flex:0 0 auto;width:26px;height:26px;margin-right:6px}
.profile-setup-back-icon{width:13px;height:13px;border-bottom:1px solid #24332d;border-left:1px solid #24332d;transform:rotate(45deg) scale(.72)}
.profile-setup-title{left:50%;font-size:21px;font-weight:700;letter-spacing:-1px;transform:translateX(-50%)}
.profile-setup-progress{margin-left:auto;font-size:13px;line-height:1}
.profile-setup-scroll{height:100vh;box-sizing:border-box}
.profile-setup-shell{min-height:100%;padding:12px 21px 138px;box-sizing:border-box}
.profile-setup-stepbar{gap:7px;width:calc(100% - 4px);padding:4px 2px 0}
.profile-setup-step-dot{flex:1;width:auto;height:4px;border-radius:599px}
.profile-setup-step-dot.is-active{flex:1.8}
.profile-setup-hero{flex-direction:column;padding:30px 2px 24px}
.profile-setup-hero-title{font-size:20px;font-weight:700;line-height:1.25}
.profile-setup-hero-subtitle{margin-top:7px;font-size:13px;line-height:1.45}
.profile-setup-field{padding:0 0 18px}
.profile-setup-field + .profile-setup-field{padding-top:7px}
.profile-setup-field-label-row{margin-bottom:9px}
.profile-setup-field-label{font-size:13px;line-height:1.2}
.profile-setup-required{margin-left:3px;font-size:14px;line-height:1}
.profile-setup-optional{margin-left:6px;font-size:12px;line-height:1}
.profile-setup-verified{min-height:20px;margin-left:6px;padding:0 7px;border-radius:599px;font-size:11px;line-height:1}
.profile-setup-pill-input, .profile-setup-pill-picker{width:100%;height:55px;padding:0 16px;box-sizing:border-box;border-radius:599px;font-size:16px;line-height:1.3}
.profile-setup-pill-input{height:55px}
.profile-setup-chevron{flex:0 0 auto;width:7px;height:7px;border-top:1px solid #AAB3AC;border-right:1px solid #AAB3AC;transform:rotate(45deg)}
.profile-textbook-grid{grid-template-columns:repeat(2, minmax(0, 1fr));gap:12px}
.profile-role-picker{flex-direction:column;padding:0 0 15px}
.profile-role-pair{width:100%;padding-top:82.63%}
.profile-role-pair-surface{top:-2px;right:-2px;bottom:-2px;left:-2px;width:calc(100% + 3px);height:calc(100% + 3px)}
.profile-role-half{top:0;bottom:0;width:50%}
.profile-role-half-student{left:0}
.profile-role-half-parent{right:0}
.profile-role-content{right:6%;left:6%;flex-direction:column;gap:24px}
.profile-role-content-student{top:50%;transform:translateY(-50%)}
.profile-role-content-parent{top:50%;bottom:auto;transform:translateY(calc(-50% + 6px))}
.profile-role-card-label{width:100%;font-size:19px;font-weight:700;line-height:1.2}
.profile-role-character-clip{width:100%;height:180px;flex:0 0 180px}
.profile-role-character{top:50%;left:50%;width:156px;height:156px;transform:translate(-50%, -50%) scale(1);transform-origin:center center}
.profile-role-content-student .profile-role-character{left:calc(50% - 6px)}
.profile-role-content-parent .profile-role-character{width:144px;height:144px;left:calc(50% + 6px)}
.profile-role-half.is-selected .profile-role-character{transform:translate(-50%, -50%) scale(1.1)}
.profile-role-notice{width:100%;padding-top:24px}
.profile-role-notice-card{width:auto;min-height:43px;padding:9px 16px;box-sizing:border-box;border-radius:599px}
.profile-role-notice-text{margin:0;font-size:13px;line-height:1.45}
.profile-textbook-card{height:100px;padding:0 9px;box-sizing:border-box;border:1px solid transparent;border-radius:20px}
.profile-textbook-card:active{transform:scale(1.012)}
.profile-textbook-card.is-selected{border-color:#FD7C02}
.profile-textbook-label{font-size:16px;font-weight:650;line-height:1.2}
.profile-textbook-fan{right:-8px;bottom:-9px;width:66px;height:52px;transform:rotate(-7deg);transform-origin:right bottom}
.profile-textbook-fan-card{right:0;bottom:0;width:25px;height:36px;box-sizing:border-box;border:1px solid rgba(255, 255, 255, .9);border-radius:5px;transform-origin:right bottom}
.profile-textbook-fan .fan-card-back{transform:translate(-18px, -3px) rotate(-7deg)}
.profile-textbook-fan .fan-card-middle{transform:translate(-9px, -2px) rotate(-3deg)}
.profile-textbook-fan .fan-card-front{transform:translate(0, 0) rotate(0)}
.profile-textbook-fan.is-expanded{transform:rotate(-7deg) translateY(3px) scale(1.2)}
.profile-textbook-fan.is-expanded .fan-card-back{border-color:#F8C28F;transform:translate(-30px, -10px) rotate(-18deg)}
.profile-textbook-fan.is-expanded .fan-card-middle{border-color:#F5AA63;transform:translate(-16px, -15px) rotate(-8deg)}
.profile-textbook-fan.is-expanded .fan-card-front{border-color:#FD7C02;transform:translate(0, -17px) rotate(3deg)}
.profile-textbook-grid-error .profile-textbook-card{box-shadow:0 0 0 1px rgba(227, 107, 85, .18)}
@keyframes profile-textbook-fan-back{0%{transform:translate(-18px, -3px) rotate(-7deg)}48%{transform:translate(-34px, -12px) rotate(-21deg)}100%{transform:translate(-30px, -10px) rotate(-18deg)}}
@keyframes profile-textbook-fan-middle{0%{transform:translate(-9px, -2px) rotate(-3deg)}48%{transform:translate(-18px, -17px) rotate(-10deg)}100%{transform:translate(-16px, -15px) rotate(-8deg)}}
@keyframes profile-textbook-fan-front{0%{transform:translate(0, 0) rotate(0)}48%{transform:translate(0, -20px) rotate(5deg)}100%{transform:translate(0, -17px) rotate(3deg)}}
.profile-setup-error-wrap{max-height:0;transform:translateY(-4px)}
.profile-setup-error-wrap.is-visible{max-height:28px;transform:translateY(0)}
.profile-setup-error-wrap-inset{padding-left:4px}
.profile-setup-error{margin:7px 4px 0;font-size:12px;line-height:1.2}
.profile-setup-region-row{gap:9px}
.profile-setup-region-picker{min-width:0;flex:1}
.profile-setup-location-button{flex:0 0 auto;width:86px;height:55px;gap:4px;border-radius:599px;font-size:14px;font-weight:600}
.profile-setup-location-image{width:20px;height:20px}
.profile-setup-actionbar{right:max(0px, 50% - var(--lg-col) / 2);bottom:0;left:max(0px, 50% - var(--lg-col) / 2);padding:10px 16px calc(13px + env(safe-area-inset-bottom))}
.profile-setup-actions{gap:12px}
.profile-setup-back-slot{flex:0 0 0;min-width:0}
.profile-setup-actions-with-back .profile-setup-back-slot, .profile-setup-actions-with-back .profile-setup-next-slot{flex:1 1 0;flex-basis:0}
.profile-setup-back-action{width:100%;height:57px;border-radius:599px;font-size:17px;font-weight:600;line-height:57px}
.profile-setup-next-slot{min-width:0;flex:1}
.profile-setup-next{width:100%;height:57px;padding:0;border:0;border-radius:599px;font-size:17px;font-weight:650;line-height:57px}
.profile-setup-next::after{border:0}
.profile-setup-sheet-layer{top:0;right:max(0px, 50% - var(--lg-col) / 2);bottom:0;left:max(0px, 50% - var(--lg-col) / 2);box-shadow:0 0 0 100vmax rgba(28, 38, 32, .28)}
.profile-setup-grade-sheet{right:0;bottom:0;left:0;height:58vh;padding:8px 21px calc(14px + env(safe-area-inset-bottom));box-sizing:border-box;border-radius:20px 20px 0 0}
.profile-setup-sheet-handle{width:43px;height:4px;margin:0 auto 16px;border-radius:599px}
.profile-setup-sheet-title{font-size:18px;font-weight:700;line-height:1.2}
.profile-setup-sheet-close{width:31px;height:31px;margin-top:-5px;border-radius:50%;font-size:22px;font-weight:300;line-height:1}
.profile-setup-grade-list{height:calc(58vh - 108px);margin-top:14px}
.profile-setup-grade-row{padding:16px 0 18px;border-bottom:0.5px solid #F1F3F0}
.profile-setup-grade-row:last-child{border-bottom:0}
.profile-setup-grade-label{font-size:15px;font-weight:650;line-height:1.2}
.profile-setup-grade-options{gap:9px;margin-top:12px}
.profile-setup-grade-option{flex:1;width:auto;height:38px;border-radius:599px;font-size:12px}
.profile-setup-grade-option.is-selected{font-weight:650}
.profile-success-sheet-layer{top:0;right:max(0px, 50% - var(--lg-col) / 2);bottom:0;left:max(0px, 50% - var(--lg-col) / 2);box-shadow:0 0 0 100vmax rgba(28, 38, 32, .28)}
.profile-success-sheet{right:0;bottom:0;left:0;min-height:52vh;padding:9px 0 0;box-sizing:border-box;border-radius:20px 20px 0 0}
.profile-success-sheet-handle{width:43px;height:4px;margin:0 auto 16px;border-radius:599px}
.profile-success-content{top:43%;right:28px;left:28px;flex-direction:column;transform:translateY(-50%)}
.profile-success-mark{width:86px;height:86px;margin:0 auto;border-radius:50%}
.profile-success-check{width:27px;height:45px;border-right:6px solid #72B783;border-bottom:6px solid #72B783;transform:rotate(45deg) translate(-5px, -5px) scale(.72)}
.profile-success-title{margin-top:19px;font-size:21px;font-weight:700;line-height:1.25}
.profile-success-subtitle{margin-top:8px;font-size:13px;line-height:1.5}
.profile-success-reward{margin-top:10px;padding:6px 14px;border-radius:599px;font-size:14px;font-weight:650;line-height:1.4}
.profile-success-actionbar{right:0;bottom:0;left:0;padding:10px 16px calc(13px + env(safe-area-inset-bottom));box-sizing:border-box}
.profile-success-button{width:100%;height:57px;margin:0;padding:0;border:0;border-radius:599px;font-size:17px;font-weight:650;line-height:57px}
.profile-success-button::after{border:0}
@keyframes profile-success-copy-in{from{opacity:0;transform:translateY(9px)}to{opacity:1;transform:translateY(0)}}
.profile-load-state{padding:36px 14px;border-radius:16px;font-size:15px}
.profile-load-state button{margin-top:14px;border-radius:599px;font-size:15px}
.profile-setup-progress{margin-left:14px}
.profile-setup-shell{padding-bottom:calc(138px + env(safe-area-inset-bottom))}
.profile-personal-avatar-row{width:100%;padding:9px 16px;border-radius:19px;font-size:15px}
.profile-personal-avatar{width:48px;height:48px;border-radius:50%}
.profile-personal-avatar image{width:100%;height:100%}
.profile-personal-avatar-row::after, .profile-birthday-clear::after, .profile-load-state button::after{border:0}
.profile-birthday-row{gap:9px}
.profile-birthday-row picker{min-width:0;flex:1}
.profile-birthday-clear{margin:0;padding:0 16px;border-radius:599px;font-size:14px;line-height:55px}
.profile-legacy-textbook{margin-top:12px}
.profile-setup-grade-list{height:calc(58vh - 108px - env(safe-area-inset-bottom))}
.profile-gender-options{gap:9px}
.profile-gender-option{flex:1;height:55px;border-radius:599px;font-size:16px;line-height:1.3}
.profile-gender-option.is-selected{font-weight:650}
.profile-setup-input-hint{margin-top:6px;margin-left:4px;font-size:11px;line-height:1.3}
.profile-setup-grade-none{gap:7px;min-height:55px;margin:12px 2px 4px;padding:0 19px;border:1px solid #E5EAE5;border-radius:599px;font-size:15px;font-weight:600;line-height:1.3}
.profile-setup-grade-none:active{transform:scale(.99)}
.profile-setup-grade-none.is-selected{border-color:rgba(253, 124, 2, .72)}
.profile-setup-grade-none-mark{flex:0 0 auto;width:21px;height:21px;border:1px solid #C7CEC8;border-radius:50%;box-sizing:border-box}
.profile-setup-grade-none.is-selected .profile-setup-grade-none-mark{border-color:#FD7C02}
.profile-setup-grade-none-cross{width:8px;height:8px}
.profile-setup-grade-none-cross::before, .profile-setup-grade-none-cross::after{top:50%;left:-1px;width:9px;height:1px;border-radius:1px;transform:rotate(45deg);transform-origin:center}
.profile-setup-grade-none-cross::after{transform:rotate(-45deg)}
.profile-role-pair-sk{width:100%;height:0;padding-top:82.63%;border-radius:24px}
.profile-switch-notice{margin:-8px 0 21px;padding:13px 16px;border-radius:16px;font-size:13px;line-height:1.55}
.profile-switch-notice-sk{height:52px;margin:-8px 0 21px;border-radius:16px}
.profile-switch-field-sk{height:55px;margin-top:9px;border-radius:599px}
}
