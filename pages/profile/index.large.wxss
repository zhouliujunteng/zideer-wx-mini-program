/* 自动生成，请勿手改：index.wxss 在平板、电脑大屏（窗口宽 ≥ 450px）下的样式。
   rpx 按 1rpx = 0.6px 换算，固定定位元素收进居中栏；改完源文件后运行 node scripts/build-large-screen-styles.mjs */
@media (min-width: 450px) {
.sk{border-radius:7px}
.sk-line{height:16px}
.sk-line + .sk-line{margin-top:8px}
.sk-short{width:40%}
.sk-mid{width:64%}
.sk-round{border-radius:50%}
.sk-card{height:96px;border-radius:14px}
.sk-card + .sk-card{margin-top:12px}
.profile-page{height:100vh}
.profile-topbar{top:0;left:max(0px, 50% - var(--lg-col) / 2);width:min(100%, var(--lg-col))}
.profile-topbar-inner{box-sizing:content-box;padding:0 21px 9px}
.profile-back, .profile-topbar-placeholder{width:33px;height:33px}
.profile-back-icon{width:13px;height:13px;border-bottom:2px solid #27332d;border-left:2px solid #27332d;transform:rotate(45deg) translate(2px, -3px)}
.profile-topbar-title{left:50%;font-size:21px;font-weight:700;letter-spacing:-1px;transform:translateX(-50%)}
.profile-scroll{height:100vh;box-sizing:border-box}
.profile-shell{min-height:100%;padding:18px 21px calc(96px + env(safe-area-inset-bottom));box-sizing:border-box}
.profile-hero{flex-direction:column;padding:25px 0 22px}
.profile-avatar-wrap{flex:0 0 127px;width:127px;height:127px}
.profile-avatar{flex:0 0 127px;width:127px;min-width:127px;max-width:127px;height:127px;min-height:127px;max-height:127px;margin:0;padding:0;box-sizing:border-box;border:3px solid #fff;border-radius:50%;box-shadow:0 1px 0 rgba(39, 51, 45, .03)}
.profile-avatar::after, .profile-avatar-edit-button::after{border:0}
.profile-avatar-image{width:100%;height:100%;border-radius:50%}
.profile-avatar-edit{right:-2px;bottom:1px;width:36px;height:36px;margin:0;padding:0;box-sizing:border-box;border-radius:50%}
.profile-avatar-edit-button{flex:0 0 36px;width:36px;min-width:36px;max-width:36px;height:36px;min-height:36px;max-height:36px;margin:0;padding:0;box-sizing:border-box;border:0;border-radius:50%;line-height:36px}
.profile-avatar-change-icon{width:18px;height:18px}
.profile-pencil{width:15px;height:15px;margin-left:0;transform:rotate(-45deg)}
.profile-pencil-small{width:12px;height:12px}
.profile-pencil::before{top:6px;left:1px;width:15px;height:4px;border-radius:1px}
.profile-pencil::after{top:6px;left:-3px;width:0;height:0;border-top:2px solid transparent;border-bottom:2px solid transparent;border-right:4px solid #27332d}
.profile-pencil-small::before{top:4px;left:1px;width:11px;height:3px}
.profile-pencil-small::after{top:4px;left:-3px;border-top-width:1px;border-bottom-width:1px;border-right-width:3px}
.profile-card{border-radius:24px;box-shadow:0 4px 18px rgba(56, 75, 64, .025)}
.profile-name-item{min-height:67px;padding:0 19px;box-sizing:border-box}
.profile-name-item::after{right:16px;bottom:0;left:16px;height:0.5px}
.profile-name-label{font-size:15px;font-weight:600;line-height:1.3}
.profile-name-item .profile-row-value{max-width:222px;font-weight:400}
.profile-row{min-height:67px;padding:0 19px;box-sizing:border-box}
.profile-row:not(.is-last)::after{right:16px;bottom:0;left:16px;height:0.5px}
.profile-row-label{font-size:15px;font-weight:600;line-height:1.3}
.profile-row-value-wrap{min-width:0;margin-left:13px}
.profile-row-value{max-width:222px;font-size:15px;line-height:1.3}
.profile-row-verified{flex:0 0 auto;min-height:21px;margin-left:7px;padding:0 7px;border-radius:599px;font-size:12px;line-height:1}
.profile-chevron{flex:0 0 auto;width:8px;height:8px;margin-left:9px;border-top:1px solid #C3CAC4;border-right:1px solid #C3CAC4;transform:rotate(45deg)}
.profile-note{margin:13px 4px 0;font-size:12px;line-height:1.5}
.profile-note-dot{flex:0 0 auto;width:4px;height:4px;margin:6px 6px 0 0;border-radius:50%}
.profile-actionbar{right:max(0px, 50% - var(--lg-col) / 2);bottom:0;left:max(0px, 50% - var(--lg-col) / 2);padding:10px 16px calc(13px + env(safe-area-inset-bottom))}
.profile-save-button{width:100%;height:57px;margin:0;padding:0;box-sizing:border-box;border:0;border-radius:599px;font-size:17px;font-weight:650;line-height:57px}
.profile-save-button::after{border:0}
.profile-sheet-layer{top:0;right:max(0px, 50% - var(--lg-col) / 2);bottom:0;left:max(0px, 50% - var(--lg-col) / 2);box-shadow:0 0 0 100vmax rgba(28, 38, 32, .28)}
.profile-input-sheet, .profile-grade-sheet, .profile-textbook-sheet{right:0;bottom:0;left:0;box-sizing:border-box;border-radius:24px 24px 0 0}
.profile-input-sheet{padding:9px 16px calc(14px + env(safe-area-inset-bottom))}
.profile-sheet-handle{width:43px;height:4px;margin:0 auto 16px;border-radius:599px}
.profile-sheet-title{font-size:19px;font-weight:700;line-height:1.2}
.profile-sheet-input{width:100%;height:60px;margin-top:18px;padding:0 16px;box-sizing:border-box;border-radius:599px;font-size:19px;line-height:60px}
.profile-sheet-actions{gap:9px;margin-top:14px}
.profile-sheet-cancel, .profile-sheet-confirm{flex:1;height:52px;border-radius:599px;font-size:16px;font-weight:650;line-height:52px}
.profile-grade-sheet{height:58vh;padding:9px 21px calc(14px + env(safe-area-inset-bottom))}
.profile-sheet-header .profile-sheet-title{flex:1}
.profile-sheet-close{width:31px;height:31px;margin-top:-5px;border-radius:50%;font-size:22px;font-weight:300;line-height:1}
.profile-grade-list{height:calc(58vh - 90px);margin-top:14px}
.profile-grade-row{padding:16px 0 18px;border-bottom:0.5px solid #E5EAE5}
.profile-grade-row:last-child{border-bottom:0}
.profile-grade-label{font-size:15px;font-weight:650;line-height:1.2}
.profile-grade-options{gap:9px;margin-top:12px}
.profile-grade-option{flex:1;height:38px;border-radius:599px;font-size:12px}
.profile-grade-option.is-selected{font-weight:650}
.profile-textbook-sheet{height:68vh;padding:9px 16px calc(13px + env(safe-area-inset-bottom))}
.profile-textbook-list{height:calc(68vh - 90px);margin-top:14px}
.profile-textbook-grid{grid-template-columns:repeat(2, minmax(0, 1fr));gap:12px;padding-bottom:132px}
.profile-textbook-card{height:100px;padding:0 9px;box-sizing:border-box;border:1px solid transparent;border-radius:20px}
.profile-textbook-card:active{transform:scale(1.012)}
.profile-textbook-card.is-selected{border-color:#FD7C02}
.profile-textbook-label{font-size:16px;font-weight:650;line-height:1.2}
.profile-textbook-fan{right:-8px;bottom:-9px;width:66px;height:52px;transform:rotate(-7deg);transform-origin:right bottom}
.profile-textbook-fan-card{right:0;bottom:0;width:25px;height:36px;box-sizing:border-box;border:1px solid rgba(255, 255, 255, .9);border-radius:5px;transform-origin:right bottom}
.profile-textbook-fan .fan-card-back{transform:translate(-18px, -3px) rotate(-7deg)}
.profile-textbook-fan .fan-card-middle{transform:translate(-9px, -2px) rotate(-3deg)}
.profile-textbook-fan .fan-card-front{transform:translate(0, 0) rotate(0)}
.profile-textbook-fan.is-expanded{transform:rotate(-7deg) translateY(3px) scale(1.2)}
.profile-textbook-fan.is-expanded .fan-card-back{border-color:#F8C28F;transform:translate(-30px, -10px) rotate(-18deg)}
.profile-textbook-fan.is-expanded .fan-card-middle{border-color:#F5AA63;transform:translate(-16px, -15px) rotate(-8deg)}
.profile-textbook-fan.is-expanded .fan-card-front{border-color:#FD7C02;transform:translate(0, -17px) rotate(3deg)}
.profile-textbook-actions{right:0;bottom:0;left:0;padding:10px 16px calc(13px + env(safe-area-inset-bottom));box-sizing:border-box}
.profile-textbook-confirm{width:100%;height:57px;margin:0;padding:0;line-height:57px}
.profile-avatar-sk{width:100%;height:100%;border-radius:50%}
.profile-value-sk{width:108px}
.profile-load-failed{padding:16px 19px;font-size:15px}
.profile-load-retry{font-weight:600}
.profile-group-title{margin:24px 7px 9px;font-size:13px;font-weight:600;line-height:1.3}
.profile-row.is-address{min-height:79px;padding-top:13px;padding-bottom:13px}
.profile-address{flex-direction:column;min-width:0;max-width:252px}
.profile-address-contact{font-size:15px;line-height:1.35}
.profile-address-line{max-width:252px;margin-top:3px;font-size:13px;line-height:1.45;-webkit-line-clamp:2;-webkit-box-orient:vertical}
}
