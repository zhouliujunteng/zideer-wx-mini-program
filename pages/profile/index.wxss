page { background: #FAFAFA; }

.profile-page { height: 100vh; overflow: hidden; background: #FAFAFA; color: #27332d; }
.profile-topbar { position: fixed; top: 0; left: 0; z-index: 20; width: 100%; background: #FAFAFA; }
.profile-topbar-inner { position: relative; display: flex; align-items: center; justify-content: space-between; box-sizing: content-box; padding: 0 36rpx 16rpx; }
.profile-back, .profile-topbar-placeholder { display: flex; align-items: center; justify-content: center; width: 56rpx; height: 56rpx; }
.profile-back:active { opacity: .65; }
.profile-back-icon { width: 22rpx; height: 22rpx; border-bottom: 4rpx solid #27332d; border-left: 4rpx solid #27332d; transform: rotate(45deg) translate(4rpx, -4rpx); }
.profile-topbar-title { position: absolute; left: 50%; display: block; color: #27332d; font-size: 36rpx; font-weight: 700; letter-spacing: -1rpx; transform: translateX(-50%); white-space: nowrap; }
.profile-scroll { height: 100vh; box-sizing: border-box; background: #FAFAFA; }
.profile-shell { min-height: 100%; padding: 30rpx 36rpx calc(160rpx + env(safe-area-inset-bottom)); box-sizing: border-box; }

.profile-hero { display: flex; flex-direction: column; align-items: center; padding: 42rpx 0 38rpx; }
.profile-avatar-wrap { position: relative; flex: 0 0 212rpx; width: 212rpx; height: 212rpx; }
.profile-avatar { display: block; flex: 0 0 212rpx; width: 212rpx; min-width: 212rpx; max-width: 212rpx; height: 212rpx; min-height: 212rpx; max-height: 212rpx; margin: 0; padding: 0; box-sizing: border-box; overflow: hidden; border: 6rpx solid #fff; border-radius: 50%; background: #DDE1DF; box-shadow: 0 3rpx 0 rgba(39, 51, 45, .03); }
.profile-avatar::after, .profile-avatar-edit-button::after { border: 0; }
.profile-avatar-image { display: block; width: 100%; height: 100%; border-radius: 50%; }
.profile-avatar-edit { position: absolute; right: -2rpx; bottom: 2rpx; display: flex; align-items: center; justify-content: center; width: 60rpx; height: 60rpx; margin: 0; padding: 0; box-sizing: border-box; overflow: hidden; border-radius: 50%; background: #fff; }
.profile-avatar-edit-button { display: flex; flex: 0 0 60rpx; align-items: center; justify-content: center; width: 60rpx; min-width: 60rpx; max-width: 60rpx; height: 60rpx; min-height: 60rpx; max-height: 60rpx; margin: 0; padding: 0; box-sizing: border-box; border: 0; border-radius: 50%; background: transparent; line-height: 60rpx; }
.profile-avatar-change-icon { width: 30rpx; height: 30rpx; }
.profile-pencil { position: relative; width: 25rpx; height: 25rpx; margin-left: 0; transform: rotate(-45deg); }
.profile-pencil-small { width: 21rpx; height: 21rpx; }
.profile-pencil::before { position: absolute; top: 11rpx; left: 3rpx; width: 26rpx; height: 7rpx; border-radius: 3rpx; background: #27332d; content: ''; }
.profile-pencil::after { position: absolute; top: 11rpx; left: -5rpx; width: 0; height: 0; border-top: 3.5rpx solid transparent; border-bottom: 3.5rpx solid transparent; border-right: 8rpx solid #27332d; content: ''; }
.profile-pencil-small::before { top: 8rpx; left: 2rpx; width: 19rpx; height: 5rpx; }
.profile-pencil-small::after { top: 8rpx; left: -4rpx; border-top-width: 2.5rpx; border-bottom-width: 2.5rpx; border-right-width: 6rpx; }

.profile-card { overflow: hidden; border-radius: 40rpx; background: #fff; box-shadow: 0 8rpx 30rpx rgba(56, 75, 64, .025); }
.profile-name-item { position: relative; display: flex; align-items: center; justify-content: space-between; min-height: 112rpx; padding: 0 32rpx; box-sizing: border-box; }
.profile-name-item::after { position: absolute; right: 28rpx; bottom: 0; left: 28rpx; height: 1rpx; background: #F0F2EF; content: ''; }
.profile-name-label { color: #3B4941; font-size: 26rpx; font-weight: 600; line-height: 1.3; }
.profile-name-item .profile-row-value { max-width: 370rpx; color: #7E8A82; font-weight: 400; }
.profile-name-item:active { background: #FCFDFC; }
.profile-row { position: relative; display: flex; align-items: center; justify-content: space-between; min-height: 112rpx; padding: 0 32rpx; box-sizing: border-box; }
.profile-row:not(.is-last)::after { position: absolute; right: 28rpx; bottom: 0; left: 28rpx; height: 1rpx; background: #F0F2EF; content: ''; }
.profile-row:active { background: #FCFDFC; }
.profile-row-label { color: #3B4941; font-size: 26rpx; font-weight: 600; line-height: 1.3; }
.profile-row-value-wrap { display: flex; align-items: center; min-width: 0; margin-left: 22rpx; }
.profile-row-value { max-width: 370rpx; overflow: hidden; color: #7E8A82; font-size: 26rpx; line-height: 1.3; text-align: right; text-overflow: ellipsis; white-space: nowrap; }
.profile-row-value.is-empty { color: #B8C0B9; }
.profile-chevron { flex: 0 0 auto; width: 14rpx; height: 14rpx; margin-left: 16rpx; border-top: 3rpx solid #C3CAC4; border-right: 3rpx solid #C3CAC4; transform: rotate(45deg); }
.profile-note { display: flex; align-items: flex-start; margin: 22rpx 8rpx 0; color: #99A39C; font-size: 21rpx; line-height: 1.5; }
.profile-note-dot { flex: 0 0 auto; width: 8rpx; height: 8rpx; margin: 11rpx 10rpx 0 0; border-radius: 50%; background: #FD7C02; }
.profile-actionbar { position: fixed; right: 0; bottom: 0; left: 0; z-index: 30; padding: 18rpx 28rpx calc(22rpx + env(safe-area-inset-bottom)); background: rgba(250, 250, 250, .96); }
.profile-save-button { display: flex; align-items: center; justify-content: center; width: 100%; height: 96rpx; margin: 0; padding: 0; box-sizing: border-box; border: 0; border-radius: 999rpx; background: rgba(253, 124, 2, .14); color: #FD7C02; font-size: 29rpx; font-weight: 650; line-height: 96rpx; }
.profile-save-button::after { border: 0; }

.profile-sheet-layer { position: fixed; top: 0; right: 0; bottom: 0; left: 0; z-index: 50; background: rgba(28, 38, 32, .28); animation: profile-sheet-fade-in .24s ease-out; }
.profile-sheet-layer.is-closing { animation: profile-sheet-fade-out .28s ease-in forwards; }
.profile-sheet-layer.is-closing .profile-input-sheet, .profile-sheet-layer.is-closing .profile-grade-sheet, .profile-sheet-layer.is-closing .profile-textbook-sheet { animation: profile-sheet-down .28s cubic-bezier(.55, .1, .7, .2) forwards; }
.profile-input-sheet, .profile-grade-sheet, .profile-textbook-sheet { position: absolute; right: 0; bottom: 0; left: 0; box-sizing: border-box; border-radius: 40rpx 40rpx 0 0; background: #F4F5F3; animation: profile-sheet-up .28s cubic-bezier(.22, .8, .24, 1); }
.profile-input-sheet { padding: 16rpx 28rpx calc(24rpx + env(safe-area-inset-bottom)); transition: bottom .2s ease-out; }
.profile-sheet-handle { width: 72rpx; height: 8rpx; margin: 0 auto 28rpx; border-radius: 999rpx; background: #DCE2DD; }
.profile-sheet-title { display: block; color: #24332D; font-size: 32rpx; font-weight: 700; line-height: 1.2; text-align: center; }
.profile-sheet-input { display: block; width: 100%; height: 100rpx; margin-top: 30rpx; padding: 0 28rpx; box-sizing: border-box; border-radius: 999rpx; background: #fff; color: #24332D; font-size: 32rpx; line-height: 100rpx; text-align: center; }
.profile-sheet-placeholder { color: #B4BCB6; }
.profile-sheet-actions { display: flex; gap: 16rpx; margin-top: 24rpx; }
.profile-sheet-cancel, .profile-sheet-confirm { display: flex; align-items: center; justify-content: center; flex: 1; height: 88rpx; border-radius: 999rpx; font-size: 28rpx; font-weight: 650; line-height: 88rpx; text-align: center; }
.profile-sheet-cancel { background: #fff; color: #65736A; }
.profile-sheet-confirm { background: rgba(253, 124, 2, .14); color: #FD7C02; }
.profile-grade-sheet { height: 58vh; padding: 16rpx 36rpx calc(24rpx + env(safe-area-inset-bottom)); }
.profile-sheet-header { display: flex; align-items: center; justify-content: space-between; }
.profile-sheet-header .profile-sheet-title { flex: 1; text-align: left; }
.profile-sheet-close { display: flex; align-items: center; justify-content: center; width: 52rpx; height: 52rpx; margin-top: -8rpx; border-radius: 50%; background: #E9EDE9; color: #829087; font-size: 38rpx; font-weight: 300; line-height: 1; }
.profile-grade-list { height: calc(58vh - 150rpx); margin-top: 24rpx; }
.profile-grade-row { display: block; padding: 28rpx 0 30rpx; border-bottom: 1rpx solid #E5EAE5; }
.profile-grade-row:last-child { border-bottom: 0; }
.profile-grade-label { display: block; color: #536158; font-size: 25rpx; font-weight: 650; line-height: 1.2; }
.profile-grade-options { display: flex; gap: 16rpx; margin-top: 20rpx; }
.profile-grade-option { display: flex; flex: 1; align-items: center; justify-content: center; height: 64rpx; border-radius: 999rpx; background: #fff; color: #6E7C73; font-size: 21rpx; }
.profile-grade-option.is-selected { background: rgba(253, 124, 2, .12); color: #FD7C02; font-weight: 650; }
.profile-textbook-sheet { height: 68vh; padding: 16rpx 28rpx calc(22rpx + env(safe-area-inset-bottom)); }
.profile-textbook-list { height: calc(68vh - 150rpx); margin-top: 24rpx; }
.profile-textbook-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 20rpx; padding-bottom: 220rpx; }
.profile-textbook-card { position: relative; display: flex; align-items: center; justify-content: center; height: 168rpx; padding: 0 16rpx; box-sizing: border-box; overflow: hidden; border: 3rpx solid transparent; border-radius: 34rpx; background: #fff; }
.profile-textbook-card:active { transform: scale(1.012); }
.profile-textbook-card.is-selected { border-color: #FD7C02; }
.profile-textbook-label { color: #24332D; font-size: 28rpx; font-weight: 650; line-height: 1.2; text-align: center; }
.profile-textbook-fan { position: absolute; right: -12rpx; bottom: -14rpx; width: 110rpx; height: 88rpx; transform: rotate(-7deg); transform-origin: right bottom; transition: transform .34s cubic-bezier(.22, .8, .24, 1); }
.profile-textbook-fan-card { position: absolute; right: 0; bottom: 0; display: block; width: 42rpx; height: 60rpx; box-sizing: border-box; border: 2rpx solid rgba(255, 255, 255, .9); border-radius: 9rpx; background: #fff; object-fit: cover; transform-origin: right bottom; transition: transform .34s cubic-bezier(.22, .8, .24, 1), border-color .24s ease; }
.profile-textbook-fan .fan-card-back { transform: translate(-30rpx, -5rpx) rotate(-7deg); }
.profile-textbook-fan .fan-card-middle { transform: translate(-15rpx, -2rpx) rotate(-3deg); }
.profile-textbook-fan .fan-card-front { transform: translate(0, 0) rotate(0); }
.profile-textbook-fan.is-expanded { transform: rotate(-7deg) translateY(6rpx) scale(1.2); }
.profile-textbook-fan.is-expanded .fan-card-back { border-color: #F8C28F; transform: translate(-50rpx, -16rpx) rotate(-18deg); }
.profile-textbook-fan.is-expanded .fan-card-middle { border-color: #F5AA63; transform: translate(-26rpx, -24rpx) rotate(-8deg); }
.profile-textbook-fan.is-expanded .fan-card-front { border-color: #FD7C02; transform: translate(0, -27rpx) rotate(3deg); }
.profile-textbook-actions { position: absolute; right: 0; bottom: 0; left: 0; z-index: 2; padding: 18rpx 28rpx calc(22rpx + env(safe-area-inset-bottom)); box-sizing: border-box; background: rgba(244, 245, 243, .96); }
.profile-textbook-confirm { width: 100%; height: 96rpx; margin: 0; padding: 0; line-height: 96rpx; }

@keyframes profile-sheet-fade-in {
  from { opacity: 0; }
  to { opacity: 1; }
}

@keyframes profile-sheet-fade-out {
  from { opacity: 1; }
  to { opacity: 0; }
}

@keyframes profile-sheet-up {
  from { transform: translateY(100%); }
  to { transform: translateY(0); }
}

@keyframes profile-sheet-down {
  from { transform: translateY(0); }
  to { transform: translateY(100%); }
}
