page { background: #FAFAFA; }

.me-page { height: 100vh; overflow: hidden; background: #FAFAFA; color: #24332d; }

.me-topbar { position: fixed; top: 0; left: 0; z-index: 20; width: 100%; box-sizing: border-box; background: #FAFAFA; }
.me-topbar-inner { display: flex; align-items: center; box-sizing: content-box; padding: 0 36rpx 16rpx; }
.me-topbar-title { color: #24332d; font-size: 36rpx; font-weight: 700; letter-spacing: -1rpx; line-height: 1; }
.me-notice-button { position: fixed; z-index: 21; display: flex; align-items: center; justify-content: center; box-sizing: border-box; border: 1rpx solid #e7ebe6; border-radius: 50%; background: #fff; }
.me-message-icon { display: block; width: 34rpx; height: 34rpx; }
.me-notice-badge { position: absolute; top: -8rpx; right: -8rpx; min-width: 27rpx; height: 27rpx; padding: 0 6rpx; box-sizing: border-box; border: 3rpx solid #FAFAFA; border-radius: 999rpx; background: #FD7C02; color: #fff; font-size: 17rpx; line-height: 21rpx; text-align: center; }

.page-scroll { height: 100vh; box-sizing: border-box; background: #FAFAFA; }
.page-shell { min-height: 100%; padding: 16rpx 36rpx 180rpx; box-sizing: border-box; }
.profile { display: flex; align-items: center; padding: 24rpx 0 34rpx; }.avatar { width: 106rpx; height: 106rpx; border-radius: 50%; background: #d8e7d9; color: #1d5945; font-size: 42rpx; line-height: 106rpx; text-align: center; }.profile-copy { flex: 1; margin-left: 22rpx; }.profile-name,.profile-role { display: block; }.profile-name { font-size: 38rpx; font-weight: 700; }.profile-role { margin-top: 8rpx; color: #717b73; font-size: 23rpx; }.verified { display: inline-block; margin-top: 13rpx; padding: 5rpx 12rpx; border-radius: 999rpx; background: #edf4ed; color: #397057; font-size: 19rpx; }.arrow,.menu-arrow { color: #a2a9a1; font-size: 42rpx; font-weight: 300; }.summary { display: flex; padding: 28rpx 8rpx; border-radius: 28rpx; background: #1d5945; color: #fff; }.summary-item { flex: 1; text-align: center; }.summary-value,.summary-label { display: block; }.summary-value { font-size: 38rpx; font-weight: 700; }.summary-label { margin-top: 8rpx; color: #d6e4d9; font-size: 21rpx; }.group { margin-top: 42rpx; }.group-title { display: block; margin-bottom: 18rpx; color: #6f7972; font-size: 24rpx; }.menu { overflow: hidden; border-radius: 28rpx; background: #fff; }.menu-item { display: flex; align-items: center; justify-content: space-between; min-height: 100rpx; padding: 0 28rpx; border-bottom: 1rpx solid #f0f1ed; font-size: 29rpx; }.menu-item:last-child { border: 0; }.support { display: flex; justify-content: space-between; margin-top: 42rpx; padding: 28rpx; border-radius: 24rpx; background: #f6ecd4; color: #786338; font-size: 23rpx; }
.profile { padding-bottom: 38rpx; }
.avatar { flex: 0 0 auto; width: 144rpx; height: 144rpx; font-size: 48rpx; line-height: 144rpx; }
.profile-copy { min-width: 0; margin-left: 28rpx; }
.profile-name-row, .profile-id-row { display: flex; align-items: center; min-width: 0; }
.profile-name { flex: 1; min-width: 0; overflow: hidden; color: #24332d; font-size: 38rpx; font-weight: 700; line-height: 1.2; text-overflow: ellipsis; white-space: nowrap; }
.profile-id-row { margin-top: 18rpx; }
.profile-id-label, .profile-id { color: #8a958d; font-size: 23rpx; line-height: 1; }
.profile-id-label { flex: 0 0 auto; margin-right: 8rpx; letter-spacing: .5rpx; }
.profile-id { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.profile-action { display: flex; flex: 0 0 auto; align-items: center; justify-content: center; width: 54rpx; height: 54rpx; margin-left: 16rpx; border-radius: 50%; background: #eef1ee; }
.profile-copy-action { margin-left: 12rpx; }
.profile-pencil-icon { position: relative; width: 28rpx; height: 28rpx; transform: rotate(-45deg); }
.profile-pencil-icon::before { position: absolute; top: 10rpx; left: 2rpx; width: 24rpx; height: 7rpx; border-radius: 2rpx; background: #7f8a82; content: ''; }
.profile-pencil-icon::after { position: absolute; top: 10rpx; left: -5rpx; width: 0; height: 0; border-top: 3.5rpx solid transparent; border-bottom: 3.5rpx solid transparent; border-right: 7rpx solid #7f8a82; content: ''; }
.profile-copy-icon { position: relative; width: 25rpx; height: 27rpx; }
.profile-copy-icon::before, .profile-copy-icon::after { position: absolute; width: 18rpx; height: 21rpx; border: 2rpx solid #7f8a82; border-radius: 4rpx; content: ''; }
.profile-copy-icon::before { top: 0; left: 0; }
.profile-copy-icon::after { top: 6rpx; left: 6rpx; background: #eef1ee; }
.me-page, .me-topbar, .page-scroll, page { background: #FAFAFA; }
.me-notice-badge { border-color: #FAFAFA; }
.avatar { background: #e4e7e5; color: transparent; }
.profile-id-row { margin-top: 4rpx; }
.profile-action { width: 48rpx; height: 48rpx; margin-left: 14rpx; }
.profile-edit-action { width: 44rpx; height: 44rpx; margin-left: 12rpx; }
.profile-copy-action { width: 48rpx; height: 48rpx; margin-left: 10rpx; }
.profile-pencil-icon { width: 22rpx; height: 22rpx; }
.profile-pencil-icon::before { top: 8rpx; left: 1rpx; width: 19rpx; height: 5rpx; }
.profile-pencil-icon::after { top: 8rpx; left: -4rpx; border-top-width: 2.5rpx; border-bottom-width: 2.5rpx; border-right-width: 6rpx; }
.profile-copy-icon { width: 22rpx; height: 24rpx; }
.profile-copy-icon::before, .profile-copy-icon::after { width: 15rpx; height: 18rpx; }
.profile-copy-icon::after { top: 5rpx; left: 5rpx; }
.profile-name { flex: 0 0 auto; max-width: calc(100% - 58rpx); }
.profile-status-row { display: flex; align-items: center; margin-top: 14rpx; }
.profile-school-pill, .profile-verified-pill { display: inline-flex; align-items: center; height: 34rpx; padding: 0 12rpx; box-sizing: border-box; border-radius: 999rpx; font-size: 19rpx; line-height: 1; }
.profile-school-pill { background: rgba(253, 124, 2, 0.10); color: #FD7C02; }
.profile-verified-pill { margin-left: 10rpx; background: #edf7ef; color: #5c956e; }
.avatar { width: 144rpx; height: 144rpx; line-height: 144rpx; }
.profile-status-row { margin-top: 8rpx; }
.profile-school-pill { padding: 0 16rpx; justify-content: center; }
.profile-verified-pill { background: rgba(253, 124, 2, 0.10); color: #FD7C02; }
.wallet-grid { display: flex; gap: 16rpx; margin-top: 2rpx; }
.wallet-module { flex: 1; min-width: 0; padding: 22rpx 24rpx 24rpx; border-radius: 22rpx; background: #fff; }
.wallet-module-heading { display: flex; align-items: center; min-width: 0; }
.wallet-module-icon { flex: 0 0 auto; width: 42rpx; height: 42rpx; margin-right: 12rpx; }
.wallet-value, .wallet-label { display: block; }
.wallet-label { overflow: hidden; color: #6f7d74; font-size: 24rpx; line-height: 1.2; text-overflow: ellipsis; white-space: nowrap; }
.wallet-module-heading { align-items: center; }
.wallet-module-meta { flex: 0 0 auto; margin-left: auto; color: #a2aba4; font-size: 19rpx; line-height: 1.2; }
.wallet-value-row { display: flex; align-items: baseline; justify-content: space-between; margin-top: 24rpx; }
.wallet-value { color: #24332d; font-size: 40rpx; font-weight: 700; line-height: 1.1; }
.wallet-module-action { display: flex; flex: 0 0 auto; align-items: center; margin-left: 12rpx; color: #87928a; font-size: 22rpx; }
.wallet-module-action .wallet-action-arrow { margin-left: 4rpx; color: #9fa8a1; font-size: 38rpx; line-height: 20rpx; transform: translateY(-1rpx); }
.quick-section { margin-top: 34rpx; }
.quick-section-title { display: block; margin-bottom: 16rpx; color: #6f7972; font-size: 24rpx; }
.quick-grid { display: flex; flex-wrap: wrap; overflow: hidden; border-radius: 22rpx; background: #fff; }
.quick-item { display: flex; align-items: center; width: 50%; min-height: 116rpx; padding: 0 28rpx; box-sizing: border-box; }
.quick-item:nth-child(odd) { border-right: 1rpx solid #f0f2ef; }
.quick-item:nth-child(-n + 2) { border-bottom: 1rpx solid #f0f2ef; }
.quick-item-icon { flex: 0 0 auto; width: 40rpx; height: 40rpx; margin-right: 16rpx; }
.quick-item-label { color: #38473f; font-size: 26rpx; }
.quick-grid { flex-wrap: nowrap; padding: 22rpx 0; border-radius: 30rpx; }
.quick-item { flex-direction: column; justify-content: center; width: 25%; min-height: 112rpx; padding: 0 4rpx; border: 0; }
.quick-item:nth-child(odd), .quick-item:nth-child(-n + 2) { border: 0; }
.quick-item-icon { width: 42rpx; height: 42rpx; margin: 0 0 12rpx; }
.quick-item-label { font-size: 22rpx; line-height: 1.2; white-space: nowrap; }
.quick-item-icon-wrap { position: relative; display: flex; align-items: center; justify-content: center; flex: 0 0 auto; width: 72rpx; height: 72rpx; margin-bottom: 12rpx; border-radius: 50%; background: #FAFAFA; }
.quick-item-icon { width: 46rpx; height: 46rpx; margin: 0; }
.quick-item-badge { position: absolute; top: -7rpx; right: -6rpx; min-width: 29rpx; height: 29rpx; padding: 0 6rpx; box-sizing: border-box; border: 3rpx solid #fff; border-radius: 999rpx; background: #FD7C02; color: #fff; font-size: 16rpx; font-weight: 600; line-height: 23rpx; text-align: center; }
.service-item-copy { display: flex; min-width: 0; flex: 1; flex-direction: column; }
.service-item-title, .service-item-description { display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.service-item-title { color: #24332d; font-size: 26rpx; font-weight: 600; line-height: 1.3; }
.service-item-description { margin-top: 14rpx; color: #adb5af; font-size: 21rpx; line-height: 1.2; }
.menu-item { min-height: 124rpx; }
.menu-item { position: relative; border-bottom: 0; }
.menu-item:not(:last-child)::after { position: absolute; right: 28rpx; bottom: 0; left: 28rpx; border-bottom: 1rpx solid #f0f1ed; content: ''; }
.menu-item:last-child { border: 0; }
.enterprise-service-card { display: flex; align-items: center; min-height: 132rpx; margin-bottom: 20rpx; padding: 22rpx 28rpx 22rpx 24rpx; box-sizing: border-box; border-radius: 26rpx; background: linear-gradient(to top right, #fff 0%, #fff 76%, rgba(254, 240, 215, 0.58) 100%); }
.enterprise-service-avatar { flex: 0 0 auto; width: 72rpx; height: 72rpx; border-radius: 50%; background: #eef1ee; }
.enterprise-service-copy { min-width: 0; flex: 1; margin-left: 22rpx; }
.enterprise-service-title { display: block; overflow: hidden; color: #24332d; font-size: 26rpx; font-weight: 600; line-height: 1.3; text-overflow: ellipsis; white-space: nowrap; }
.enterprise-service-description { display: block; margin-top: 12rpx; overflow: hidden; color: #adb5af; font-size: 21rpx; line-height: 1.2; text-overflow: ellipsis; white-space: nowrap; }
.enterprise-service-action { display: flex; flex: 0 0 auto; align-items: center; min-height: 42rpx; margin-left: 20rpx; }
.enterprise-service-hours { display: inline-flex; align-items: center; justify-content: center; min-width: 112rpx; height: 32rpx; padding: 0 13rpx; box-sizing: border-box; border-radius: 999rpx; background: rgba(253, 124, 2, 0.10); color: #FD7C02; font-size: 18rpx; line-height: 32rpx; white-space: nowrap; }
.enterprise-service-go { display: flex; align-items: center; justify-content: center; width: 42rpx; height: 42rpx; margin-left: 12rpx; color: #87928a; font-size: 22rpx; line-height: 1; }
.enterprise-service-go .menu-arrow { display: block; line-height: 42rpx; transform: translateY(-1rpx); }
