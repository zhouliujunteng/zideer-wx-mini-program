@import "../../styles/skeleton.wxss";
page { background: #FAFAFA; }

.me-page { position: relative; height: 100vh; overflow: hidden; background: #FAFAFA; color: #24332d; }
/* 顶部橡皮筋的常驻底色：仅覆盖资料区高度，绝不能延伸到页面底部。 */
.me-page::before { position: absolute; z-index: 0; top: 0; right: 0; left: 0; height: 720rpx; background: #FFF1E6; content: ''; pointer-events: none; }

.me-topbar { position: fixed; top: 0; left: 0; z-index: 20; width: 100%; box-sizing: border-box; background: #FFF1E6; }
.me-topbar-inner { display: flex; align-items: center; box-sizing: content-box; padding: 0 36rpx 16rpx; }
.me-topbar-title { color: #24332d; font-size: 36rpx; font-weight: 700; letter-spacing: -1rpx; line-height: 1; }
.me-notice-button { position: fixed; z-index: 21; display: flex; align-items: center; justify-content: center; box-sizing: border-box; border: 1rpx solid #e7ebe6; border-radius: 50%; background: #fff; }
.me-message-icon { display: block; width: 34rpx; height: 34rpx; }
.me-notice-badge { position: absolute; top: -8rpx; right: -8rpx; min-width: 27rpx; height: 27rpx; padding: 0 6rpx; box-sizing: border-box; border: 3rpx solid #FAFAFA; border-radius: 999rpx; background: #FD5A5F; color: #fff; font-size: 17rpx; line-height: 21rpx; text-align: center; }

.page-scroll { height: 100vh; box-sizing: border-box; background: #FAFAFA; }
.page-shell { min-height: 100%; padding: 16rpx 36rpx 180rpx; box-sizing: border-box; }
.profile { display: flex; align-items: center; padding: 24rpx 0 34rpx; }.avatar { width: 106rpx; height: 106rpx; border-radius: 50%; background: #d8e7d9; color: #1d5945; font-size: 42rpx; line-height: 106rpx; text-align: center; }.profile-copy { flex: 1; margin-left: 22rpx; }.profile-name,.profile-role { display: block; }.profile-name { font-size: 38rpx; font-weight: 700; }.profile-role { margin-top: 8rpx; color: #717b73; font-size: 23rpx; }.verified { display: inline-block; margin-top: 13rpx; padding: 5rpx 12rpx; border-radius: 999rpx; background: #edf4ed; color: #397057; font-size: 19rpx; }.arrow,.menu-arrow { color: #a2a9a1; font-size: 42rpx; font-weight: 300; }.summary { display: flex; padding: 28rpx 8rpx; border-radius: 28rpx; background: #1d5945; color: #fff; }.summary-item { flex: 1; text-align: center; }.summary-value,.summary-label { display: block; }.summary-value { font-size: 38rpx; font-weight: 700; }.summary-label { margin-top: 8rpx; color: #d6e4d9; font-size: 21rpx; }.group { margin-top: 42rpx; }.group-title { display: block; margin-bottom: 18rpx; color: #6f7972; font-size: 24rpx; }.menu { overflow: hidden; border-radius: 28rpx; background: #fff; }.menu-item { display: flex; align-items: center; justify-content: space-between; min-height: 100rpx; padding: 0 28rpx; border-bottom: 1rpx solid #f0f1ed; font-size: 29rpx; }.menu-item:last-child { border: 0; }.support { display: flex; justify-content: space-between; margin-top: 42rpx; padding: 28rpx; border-radius: 24rpx; background: #f6ecd4; color: #786338; font-size: 23rpx; }
.profile { padding-bottom: 38rpx; }
.avatar { flex: 0 0 auto; width: 144rpx; height: 144rpx; font-size: 48rpx; line-height: 144rpx; }
.profile-copy { min-width: 0; margin-left: 28rpx; }
.profile-name-row, .profile-id-row { display: flex; align-items: center; min-width: 0; }
.profile-name { flex: 1; min-width: 0; overflow: hidden; color: #24332d; font-size: 38rpx; font-weight: 700; line-height: 1.2; text-overflow: ellipsis; white-space: nowrap; }
.profile-id-row { margin-top: 18rpx; }
.profile-id-label, .profile-id { color: #8a958d; font-size: 23rpx; line-height: 1; }
.profile-id-label { flex: 0 0 auto; margin-right: 8rpx; letter-spacing: .5rpx; }
.profile-id { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.profile-action { display: flex; flex: 0 0 auto; align-items: center; justify-content: center; width: 54rpx; height: 54rpx; margin-left: 16rpx; border-radius: 50%; background: #eef1ee; }
.profile-copy-action { margin-left: 12rpx; }
.profile-pencil-icon { position: relative; width: 28rpx; height: 28rpx; transform: rotate(-45deg); }
.profile-pencil-icon::before { position: absolute; top: 10rpx; left: 2rpx; width: 24rpx; height: 7rpx; border-radius: 2rpx; background: #7f8a82; content: ''; }
.profile-pencil-icon::after { position: absolute; top: 10rpx; left: -5rpx; width: 0; height: 0; border-top: 3.5rpx solid transparent; border-bottom: 3.5rpx solid transparent; border-right: 7rpx solid #7f8a82; content: ''; }
.profile-copy-icon { position: relative; width: 25rpx; height: 27rpx; }
.profile-copy-icon::before, .profile-copy-icon::after { position: absolute; width: 18rpx; height: 21rpx; border: 2rpx solid #7f8a82; border-radius: 4rpx; content: ''; }
.profile-copy-icon::before { top: 0; left: 0; }
.profile-copy-icon::after { top: 6rpx; left: 6rpx; background: #eef1ee; }
.page-scroll, page { background: #FAFAFA; }
.me-notice-badge { border-color: #FAFAFA; }
.avatar { background: #e4e7e5; color: transparent; }
.profile-id-row { margin-top: 4rpx; }
.profile-action { width: 48rpx; height: 48rpx; margin-left: 14rpx; }
.profile-edit-action { width: 44rpx; height: 44rpx; margin-left: 12rpx; }
.profile-copy-action { width: 48rpx; height: 48rpx; margin-left: 10rpx; }
.profile-pencil-icon { width: 22rpx; height: 22rpx; }
.profile-pencil-icon::before { top: 8rpx; left: 1rpx; width: 19rpx; height: 5rpx; }
.profile-pencil-icon::after { top: 8rpx; left: -4rpx; border-top-width: 2.5rpx; border-bottom-width: 2.5rpx; border-right-width: 6rpx; }
.profile-copy-icon { width: 22rpx; height: 24rpx; }
.profile-copy-icon::before, .profile-copy-icon::after { width: 15rpx; height: 18rpx; }
.profile-copy-icon::after { top: 5rpx; left: 5rpx; }
.profile-name { flex: 0 0 auto; max-width: calc(100% - 58rpx); }
.profile-status-row { display: flex; align-items: center; margin-top: 14rpx; }
.profile-school-pill, .profile-verified-pill { display: inline-flex; align-items: center; height: 34rpx; padding: 0 12rpx; box-sizing: border-box; border-radius: 999rpx; font-size: 19rpx; line-height: 1; }
.profile-school-pill { background: rgba(253, 124, 2, 0.10); color: #FD7C02; }
.profile-verified-pill { margin-left: 10rpx; background: #edf7ef; color: #5c956e; }
.avatar { width: 144rpx; height: 144rpx; line-height: 144rpx; }
.profile-status-row { margin-top: 8rpx; }
.profile-school-pill { padding: 0 16rpx; justify-content: center; }
.profile-verified-pill { background: rgba(253, 124, 2, 0.10); color: #FD7C02; }
/* 代理身份标签（2026-11-10）：资料区 ID 下方居中一行，可换行；团长深橙底白字，爱心妈妈、导师妈妈淡橙底 */
.profile-agent-row { display: flex; flex-wrap: wrap; align-items: center; justify-content: center; gap: 10rpx; width: 100%; margin-top: 16rpx; }
.profile-agent-row:active { opacity: .7; }
.profile-agent-pill { display: inline-flex; align-items: center; height: 40rpx; padding: 0 16rpx; box-sizing: border-box; border-radius: 999rpx; background: rgba(253, 124, 2, 0.10); color: #FD7C02; font-size: 21rpx; font-weight: 600; line-height: 1; white-space: nowrap; }
.profile-agent-pill-team_leader { background: #FD7C02; color: #fff; }
.profile-agent-chevron { width: 12rpx; height: 12rpx; margin-left: 2rpx; border-top: 3rpx solid #FDB066; border-right: 3rpx solid #FDB066; transform: rotate(45deg); }
.wallet-grid { display: flex; gap: 24rpx; margin-top: 2rpx; }
.wallet-module { flex: 1; min-width: 0; padding: 22rpx 24rpx 24rpx; border-radius: 40rpx; background: #fff; }
.wallet-module-heading { display: flex; align-items: center; min-width: 0; }
.wallet-module-icon { flex: 0 0 auto; width: 42rpx; height: 42rpx; margin-right: 12rpx; }
.wallet-value, .wallet-label { display: block; }
.wallet-label { overflow: hidden; color: #6f7d74; font-size: 24rpx; line-height: 1.2; text-overflow: ellipsis; white-space: nowrap; }
.wallet-module-heading { align-items: center; }
.wallet-module-meta { flex: 0 0 auto; margin-left: auto; color: #a2aba4; font-size: 19rpx; line-height: 1.2; }
.wallet-value-row { display: flex; align-items: baseline; justify-content: space-between; margin-top: 24rpx; }
.wallet-value { color: #24332d; font-size: 40rpx; font-weight: 700; line-height: 1.1; }
.wallet-module-action { display: flex; flex: 0 0 auto; align-items: center; margin-left: 12rpx; color: #87928a; font-size: 22rpx; }
.wallet-module-action .wallet-action-arrow { margin-left: 4rpx; color: #9fa8a1; font-size: 38rpx; line-height: 20rpx; transform: translateY(-1rpx); }
.quick-section { margin-top: 34rpx; }
.quick-section-title { display: block; margin-bottom: 16rpx; color: #6f7972; font-size: 24rpx; }
.quick-grid { display: flex; flex-wrap: wrap; overflow: hidden; border-radius: 22rpx; background: #fff; }
.quick-item { display: flex; align-items: center; width: 50%; min-height: 116rpx; padding: 0 28rpx; box-sizing: border-box; }
.quick-item:nth-child(odd) { border-right: 1rpx solid #f0f2ef; }
.quick-item:nth-child(-n + 2) { border-bottom: 1rpx solid #f0f2ef; }
.quick-item-icon { flex: 0 0 auto; width: 40rpx; height: 40rpx; margin-right: 16rpx; }
.quick-item-label { color: #38473f; font-size: 26rpx; }
.quick-grid { flex-wrap: nowrap; padding: 26rpx 8rpx; border-radius: 40rpx; }
.quick-item { flex-direction: column; justify-content: center; width: 25%; min-height: 116rpx; padding: 0 6rpx; border: 0; }
.quick-item:nth-child(odd), .quick-item:nth-child(-n + 2) { border: 0; }
.quick-item-icon { width: 42rpx; height: 42rpx; margin: 0 0 12rpx; }
.quick-item-label { font-size: 22rpx; line-height: 1.2; white-space: nowrap; }
.quick-item-icon-wrap { position: relative; display: flex; align-items: center; justify-content: center; flex: 0 0 auto; width: 72rpx; height: 72rpx; margin-bottom: 12rpx; border-radius: 50%; background: #FAFAFA; }
.quick-item-icon { width: 46rpx; height: 46rpx; margin: 0; }
.quick-item-badge { position: absolute; top: -7rpx; right: -6rpx; min-width: 29rpx; height: 29rpx; padding: 0 6rpx; box-sizing: border-box; border: 3rpx solid #fff; border-radius: 999rpx; background: #FD5A5F; color: #fff; font-size: 16rpx; font-weight: 600; line-height: 23rpx; text-align: center; }
.service-item-copy { display: flex; min-width: 0; flex: 1; flex-direction: column; }
.service-item-title, .service-item-description { display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.service-item-title { color: #24332d; font-size: 26rpx; font-weight: 600; line-height: 1.3; }
.service-item-description { margin-top: 14rpx; color: #adb5af; font-size: 21rpx; line-height: 1.2; }
/* 标题后的小标签（如「推广伙伴」后的「邀请码」）：浅橙底橙字，与头像下的学校标签同色 */
.service-item-title-row { display: flex; align-items: center; min-width: 0; }
.service-item-title-row .service-item-title { flex: 0 1 auto; min-width: 0; }
.service-item-tag { flex: none; height: 30rpx; margin-left: 12rpx; padding: 0 12rpx; box-sizing: border-box; border-radius: 999rpx; background: rgba(253, 124, 2, 0.10); color: #FD7C02; font-size: 18rpx; font-weight: 500; line-height: 30rpx; }
.menu-item { min-height: 132rpx; padding-right: 32rpx; padding-left: 32rpx; }
.menu-item { position: relative; border-bottom: 0; }
.menu-item:not(:last-child)::after { position: absolute; right: 28rpx; bottom: 0; left: 28rpx; border-bottom: 1rpx solid #f0f1ed; content: ''; }
.menu-item:last-child { border: 0; }
.developer-previews { overflow: hidden; margin: 48rpx 0 14rpx; border-top: 1rpx solid #eef0ed; border-bottom: 1rpx solid #eef0ed; }
.developer-entry { position: relative; display: flex; align-items: center; min-height: 74rpx; padding: 0 8rpx; }
.developer-entry:not(:last-child)::after { position: absolute; right: 8rpx; bottom: 0; left: 8rpx; border-bottom: 1rpx solid #f0f1ee; content: ''; }
.developer-entry-code { display: inline-flex; flex: 0 0 auto; align-items: center; justify-content: center; min-width: 50rpx; height: 30rpx; margin-right: 14rpx; padding: 0 7rpx; box-sizing: border-box; border-radius: 999rpx; background: #eff1ef; color: #8c958e; font-size: 17rpx; line-height: 30rpx; }
.developer-entry-label { color: #7D8981; font-size: 23rpx; line-height: 1.2; }
.developer-entry-hint { margin-left: 12rpx; color: #B1BAB2; font-size: 19rpx; line-height: 1.2; }
.developer-entry-arrow { margin-left: auto; color: #b0b7b1; font-size: 32rpx; font-weight: 300; line-height: 1; }

/* 个人资料摘要：头像、姓名和 ID 纵向居中，使用独立的淡橙色底卡与账户区域分层。 */
.profile {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  margin: -16rpx -36rpx 0;
  padding: 42rpx 36rpx 44rpx;
  box-sizing: border-box;
  border-radius: 0 0 40rpx 40rpx;
  background: #FFF1E6;
}
.profile-avatar-wrap { flex: 0 0 auto; width: 168rpx; height: 168rpx; }
.avatar {
  width: 168rpx;
  height: 168rpx;
  box-sizing: border-box;
  border: 6rpx solid #fff;
  border-radius: 50%;
  background: #E4E7E5;
  box-shadow: none;
  line-height: 148rpx;
}
.profile-copy { width: 100%; margin: 22rpx 0 0; }
.profile-name-row, .profile-id-row { position: relative; justify-content: center; width: 100%; }
.profile-name { max-width: calc(100% - 96rpx); color: #24332D; text-align: center; }
.profile-id-row { margin-top: 20rpx; }
.profile-id-label, .profile-id { color: #8A958D; }
.profile-id { flex: 0 0 auto; max-width: calc(100% - 96rpx); }
/* 未登录、没完善学习资料的一行提示（2026-09-27）：主题橙，点资料区去登录 / 去完善 */
.profile-access-hint { color: #FD7C02; font-size: 23rpx; line-height: 1.2; text-align: center; }
.profile-action { position: absolute; top: 50%; margin-left: 0; background: rgba(255, 255, 255, .72); transform: translateY(-50%); }
.profile-edit-action, .profile-copy-action { right: 0; }
.profile-copy-action { position: relative; top: auto; right: auto; width: 28rpx; height: 28rpx; margin-left: 12rpx; background: transparent; transform: none; }
.profile-copy-action .profile-copy-icon { width: 22rpx; height: 24rpx; }
.profile-copy-action .profile-copy-icon::after { background: #FFF1E6; }
.wallet-grid { margin-top: 24rpx; }
.page-scroll { position: absolute; z-index: 2; top: 0; right: 0; bottom: 0; left: 0; height: auto; overflow: hidden; background: transparent; }
.page-shell { position: relative; min-height: 100%; padding-top: 0; padding-bottom: 0; background: #FAFAFA; }
/* 淡橙色资料层随内容滚动；根层另有仅限顶部的回弹底色，页面底部始终由灰白色承接。 */
.me-profile-ambient { position: absolute; z-index: 0; top: 0; right: 0; left: 0; height: 720rpx; background: #FFF1E6; pointer-events: none; }
/* 回弹由四边钉死的原生滚动容器承接；此处只保留内容与安全区所需的正常尾部留白。
   自定义底栏（custom-tab-bar，高 49px + 底部安全区）盖在页面上，尾部留白要把它算进去；
   另留的 42rpx 与版本号上方的 .me-version-row margin-top 相同，滚到底时版本号离上面的卡片和底栏一样远。 */
.me-content-panel { position: relative; z-index: 1; margin: -88rpx -36rpx 0; padding: 112rpx 36rpx calc(49px + 42rpx + env(safe-area-inset-bottom)); box-sizing: border-box; border-radius: 0; background: #FAFAFA; }
.me-content-panel-corner {
  position: absolute;
  z-index: 1;
  top: -48rpx;
  width: 48rpx;
  height: 48rpx;
  background: #FAFAFA;
  -webkit-mask-image: radial-gradient(100% 100% at center, transparent calc(50% - .5rpx), #000 calc(50% + .5rpx));
  -webkit-mask-repeat: no-repeat;
  -webkit-mask-size: 200% 200%;
  mask-image: radial-gradient(100% 100% at center, transparent calc(50% - .5rpx), #000 calc(50% + .5rpx));
  mask-repeat: no-repeat;
  mask-size: 200% 200%;
  pointer-events: none;
}
.me-content-panel-corner-left { left: 0; -webkit-mask-position: 0 100%; mask-position: 0 100%; }
.me-content-panel-corner-right { right: 0; -webkit-mask-position: 100% 100%; mask-position: 100% 100%; }
.profile { z-index: 1; margin: 0 -36rpx; padding-bottom: 160rpx; border-radius: 0; box-shadow: none; }
.me-topbar { background-color: #FFF1E6; transition: background-color .08s ease-out; }
.me-edit-profile-pill { position: fixed; z-index: 22; display: flex; align-items: center; justify-content: center; width: 132rpx; box-sizing: border-box; border: 0; border-radius: 999rpx; background: rgba(255, 255, 255, .88); color: #1F2722; font-size: 20rpx; font-weight: 600; line-height: 1; white-space: nowrap; transition: opacity .08s ease-out, transform .08s ease-out; }
.me-edit-profile-pill:active { opacity: .68; }
.me-edit-profile-pill.is-hidden { opacity: 0; pointer-events: none; transform: translateY(-2rpx); }
.membership-card { position: relative; z-index: 2; display: flex; align-items: center; min-height: 176rpx; margin-top: -104rpx; padding: 0 32rpx; box-sizing: border-box; overflow: hidden; border: 2rpx solid #fff; border-radius: 44rpx; background: linear-gradient(105deg, #fff 0%, #fff 38%, #FFF5E6 62%, #FFE8BA 100%); }
.membership-copy { position: relative; z-index: 2; display: flex; flex-direction: column; align-items: flex-start; }
.membership-title { color: #3A3427; font-size: 34rpx; font-weight: 700; line-height: 1.2; }
.membership-subtitle { margin-top: 12rpx; color: #9B8A63; font-size: 22rpx; line-height: 1.2; }
.membership-art { position: absolute; top: 0; right: 0; width: 270rpx; height: 100%; }
.membership-crown { position: absolute; z-index: 2; top: 14rpx; right: 22rpx; width: 210rpx; height: 138rpx; transform: rotate(9deg) scale(1.02); }
.membership-ring { position: absolute; z-index: 1; box-sizing: border-box; border: 2rpx solid rgba(226, 174, 45, .54); border-radius: 50%; }
.membership-ring-back { right: 28rpx; bottom: 18rpx; width: 150rpx; height: 42rpx; transform: rotate(-13deg); }
.membership-ring-front { right: 70rpx; bottom: 4rpx; width: 118rpx; height: 32rpx; transform: rotate(10deg); }
/* 尚未付费开通任何会员：灰色卡片与灰色皇冠，开通后才显示金色「知鹿会员」。 */
.membership-card-plain { background: linear-gradient(105deg, #fff 0%, #fff 38%, #F3F4F5 62%, #E1E3E6 100%); }
.membership-card-plain .membership-title { color: #3B3E42; }
.membership-card-plain .membership-subtitle { color: #8C9096; }
.membership-card-plain .membership-ring { border-color: rgba(150, 154, 160, .5); }
.wallet-module { position: relative; display: flex; align-items: center; min-height: 116rpx; padding: 18rpx; box-sizing: border-box; overflow: visible; }
.wallet-module-illustration { position: relative; top: auto; left: auto; z-index: 1; flex: 0 0 auto; width: 96rpx; height: 96rpx; filter: drop-shadow(0 3rpx 4rpx rgba(36, 51, 45, .12)); transform: translate(-6rpx, 0); }
.wallet-module-copy { position: relative; z-index: 2; min-width: 0; margin-left: 18rpx; }
.wallet-module-copy { flex: 1; overflow: hidden; }
.wallet-module-go { display: flex; flex: 0 0 auto; align-items: center; justify-content: center; width: 26rpx; height: 32rpx; margin-left: 6rpx; }
.wallet-module-chevron { width: 12rpx; height: 12rpx; border-top: 3rpx solid #C3CAC4; border-right: 3rpx solid #C3CAC4; transform: rotate(45deg); }
.wallet-label { display: block; overflow: hidden; color: #6F7D74; font-size: 23rpx; line-height: 1.2; text-overflow: ellipsis; white-space: nowrap; }
/* 积分、金币数字：位数多时由 index.js 的 fitWalletValues 按卡内可用宽度缩小字号（行内 font-size，px）。
   inline-block + 不换行才能量到文字本身的宽度；行高固定，字号变小时卡片高度不变。 */
.wallet-value { display: inline-block; max-width: none; height: 38rpx; margin-top: 8rpx; color: #24332D; font-size: 36rpx; font-weight: 700; line-height: 38rpx; white-space: nowrap; vertical-align: top; }
.menu { border-radius: 40rpx; }

/* 页面最底部的小程序版本号：浅主题色胶囊、主题色文字（同 .service-item-tag）；上方间距与 .me-content-panel 底部另留的 42rpx 相同 */
.me-version-row { display: flex; justify-content: center; margin-top: 42rpx; }
.me-version { height: 44rpx; padding: 0 22rpx; box-sizing: border-box; border-radius: 999rpx; background: rgba(253, 124, 2, 0.10); color: #FD7C02; font-size: 22rpx; font-weight: 500; line-height: 44rpx; }

/* 首次加载骨架（styles/skeleton.wxss） */
.profile-name-skeleton { width: 220rpx; height: 40rpx; }
.profile-id-skeleton { width: 260rpx; height: 24rpx; }
.membership-title-skeleton { width: 160rpx; height: 32rpx; }
.membership-subtitle-skeleton { width: 260rpx; height: 22rpx; margin-top: 14rpx; }
.wallet-value-skeleton { width: 80rpx; height: 34rpx; margin-top: 8rpx; }

/* 平板、电脑大屏（窗口宽 ≥ 450px，见 utils/screen.js）：和首页一样放宽到 1040px（LARGE_SCREEN_WIDE_COLUMN）。 */
@media (min-width: 450px) {
  page { --lg-col: 1040px; }
}



@media (min-width:450px) {
.me-page::before,.me-profile-ambient,.me-content-panel-corner { display:none; }
.page-shell { padding-left:20px; padding-right:20px; padding-bottom:80px; }
.tablet-account-summary { position:relative; z-index:2; display:grid; grid-template-columns:minmax(0,1fr) minmax(0,1fr); gap:14px; margin-top:14px; }
.profile { margin:0; padding:18px 14px!important; border-radius:18px; min-width:0; background:#FFF1E6; flex-direction:row; align-items:center; }
.profile-avatar-wrap,.avatar { width:48px; height:48px; }
.avatar { border-width:2px; }
.profile-copy { flex:1; min-width:0; width:auto; margin:0 0 0 10px; }
.profile-name-row,.profile-id-row { justify-content:flex-start; }
.profile-name { max-width:100%; font-size:18px; text-align:left; }
.profile-id-row { margin-top:10px; }
.profile-id,.profile-id-label { font-size:10px; }
.profile-id { max-width:100%; }
.profile-copy-action { margin-left:5px; }
.membership-card { margin:0; padding:16px; min-height:108px; border-radius:18px; align-items:flex-start; }
.membership-copy { padding-bottom:22px; }
.membership-title { font-size:17px; }
.membership-subtitle { font-size:11px; line-height:1.5; margin-top:7px; }
.membership-art { width:70px; top:auto; bottom:0; height:50px; }
.membership-crown { width:68px; height:46px; right:4px; top:0; }
.membership-ring { display:none; }
.me-content-panel { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:20px 14px; margin:20px 0 0; padding:0; background:transparent; }
.wallet-grid,.tablet-streak-slot,.quick-section,.developer-previews,.me-version-row { grid-column:1/-1; margin:0; min-width:0; }
.wallet-grid { gap:14px; }
.wallet-module { border-radius:18px; min-height:80px; padding:12px; }
.wallet-module-illustration { width:42px; height:42px; transform:none; }
.wallet-module-copy { margin-left:10px; }
.wallet-value { font-size:24px; }
.wallet-label { font-size:12px; }
.quick-grid { border-radius:18px; padding:16px 6px; }
.quick-item { min-height:64px; }
.quick-item-icon-wrap { width:34px; height:34px; }
.quick-item-icon { width:25px; height:25px; }
.quick-item-label { font-size:12px; }
.group { grid-column:1/-1; margin:0; min-width:0; }
.menu { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); }
.menu { border-radius:18px; }
.menu-item { min-height:74px; padding:14px; }
.service-item-title,.service-item-description { white-space:normal; }
.service-item-title { font-size:14px; }
.service-item-description { font-size:11px; line-height:1.5; margin-top:5px; }
}
@media (min-width:680px) {
.page-shell { display:grid; grid-template-columns:210px minmax(0,1fr); gap:24px; align-items:start; }
.tablet-account-summary { display:flex; flex-direction:column; gap:16px; margin-top:18px; }
.profile { padding:24px 16px!important; flex-direction:column; }
.profile-avatar-wrap,.avatar { width:68px; height:68px; }
.profile-copy { margin:14px 0 0; width:100%; }
.profile-name-row,.profile-id-row { justify-content:center; }
.profile-name { text-align:center; }
.membership-card { min-height:140px; }
.membership-art { width:94px; height:68px; }
.membership-crown { width:90px; height:60px; }
.me-content-panel { margin-top:18px; }
}

