/* finesse · register=h5 · morph=A.1-native-study-app · A=snow+coral+ink
 * B=system-700/400 · C=single-focus+grouped-rows+native-tabbar · D=tap-feedback-only
 * E=quiet-study-desk · SOUL=4 SPECTACLE=1 DENSITY=4 */

.me-loading { display: flex; align-items: center; margin-top: 52rpx; flex-direction: column; }
.skeleton-avatar { width: 132rpx; height: 132rpx; border-radius: 66rpx; }
.skeleton-name { width: 38%; height: 40rpx; margin-top: 24rpx; }
.skeleton-assets { width: 100%; height: 220rpx; margin-top: 68rpx; border-radius: 24rpx; }
.skeleton-menu { width: 100%; height: 360rpx; margin-top: 34rpx; border-radius: 24rpx; }

.profile-head {
  display: flex;
  align-items: center;
  margin-top: 36rpx;
  flex-direction: column;
}

.profile-avatar {
  display: flex;
  width: 132rpx;
  height: 132rpx;
  align-items: center;
  justify-content: center;
  border-radius: 66rpx;
  background: var(--blue-soft);
  color: var(--blue);
  font-size: 42rpx;
  font-weight: 700;
}

.profile-name {
  display: flex;
  min-height: 64rpx;
  align-items: center;
  margin-top: 16rpx;
  font-size: 34rpx;
  font-weight: 700;
}

.profile-name__arrow { margin-left: 8rpx; color: var(--muted); font-size: 36rpx; font-weight: 400; }
.profile-meta { color: var(--muted); font-size: 21rpx; }

.student-row {
  display: flex;
  width: 100%;
  min-height: 104rpx;
  align-items: center;
  margin-top: 34rpx;
  padding: 16rpx 22rpx;
  text-align: left;
}

.student-row__avatar {
  display: flex;
  width: 56rpx;
  height: 56rpx;
  align-items: center;
  justify-content: center;
  flex: none;
  border-radius: 28rpx;
  background: var(--accent-soft);
  color: var(--accent-deep);
  font-size: 20rpx;
  font-weight: 700;
}

.student-row__copy { min-width: 0; flex: 1; margin-left: 17rpx; }
.student-row__label,
.student-row__name { display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.student-row__label { color: var(--muted); font-size: 18rpx; }
.student-row__name { margin-top: 5rpx; font-size: 24rpx; font-weight: 600; }
.student-row__action { flex: none; color: var(--muted); font-size: 20rpx; }

.asset-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 18rpx; margin-top: 18rpx; }
.asset-grid--single { grid-template-columns: minmax(0, 1fr); }
.asset-card { display: block; min-width: 0; min-height: 200rpx; padding: 24rpx; text-align: left; }
.asset-card__head { display: flex; min-width: 0; align-items: center; color: var(--ink-soft); font-size: 21rpx; }
.asset-card__head image { width: 30rpx; height: 30rpx; flex: none; margin-right: 10rpx; }
.asset-card__head text:nth-child(2) { overflow: hidden; min-width: 0; flex: 1; text-overflow: ellipsis; white-space: nowrap; }
.asset-card__arrow { flex: none; color: #B0B4BA; font-size: 30rpx; }
.asset-card__value { display: flex; align-items: baseline; margin-top: 26rpx; }
.asset-card__value > text:first-child { font-size: 38rpx; font-weight: 700; }
.asset-card__unit { margin-left: 7rpx; color: var(--muted); font-size: 19rpx; }
.asset-card__meta { display: block; overflow: hidden; margin-top: 7rpx; color: var(--muted); font-size: 18rpx; text-overflow: ellipsis; white-space: nowrap; }

.me-section { margin-top: 36rpx; }
.update-row {
  display: flex;
  width: 100%;
  min-height: 122rpx;
  align-items: center;
  padding: 20rpx 22rpx;
  text-align: left;
}
.update-row__mark { width: 14rpx; height: 14rpx; flex: none; border-radius: 7rpx; background: var(--green); }
.update-row__copy { min-width: 0; flex: 1; margin-left: 18rpx; }
.update-row__title,
.update-row__meta { display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.update-row__title { font-size: 24rpx; font-weight: 600; }
.update-row__meta { margin-top: 8rpx; color: var(--muted); font-size: 19rpx; }

.menu-list { overflow: hidden; padding: 0 22rpx; }
.menu-row {
  display: flex;
  width: 100%;
  min-height: 108rpx;
  align-items: center;
  border-bottom: 1rpx solid var(--line);
  text-align: left;
}
.menu-row:last-child { border-bottom: 0; }
.menu-row__icon { display: flex; width: 54rpx; height: 54rpx; align-items: center; justify-content: center; flex: none; border-radius: 15rpx; background: var(--surface-soft); }
.menu-row__icon image { width: 29rpx; height: 29rpx; }
.menu-row__icon--users,
.menu-row__icon--message { background: var(--blue-soft); }
.menu-row__icon--bag,
.menu-row__icon--gift { background: var(--accent-soft); }
.menu-row__icon--shield { background: var(--green-soft); }
.menu-row__icon--headphones { background: var(--yellow-soft); }
.menu-row__copy { min-width: 0; flex: 1; margin-left: 17rpx; }
.menu-row__title,
.menu-row__meta { display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.menu-row__title { font-size: 24rpx; font-weight: 600; }
.menu-row__meta { margin-top: 6rpx; color: var(--muted); font-size: 19rpx; }
.menu-row__arrow { flex: none; margin-left: 12rpx; color: #B0B4BA; font-size: 32rpx; }

@media (max-width: 340px) {
  .asset-card { padding: 20rpx; }
  .asset-card__meta { font-size: 17rpx; }
}
