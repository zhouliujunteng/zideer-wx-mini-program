.developer-entry-arrow{margin-left:auto;font-size:19px;font-weight:300;line-height:1}
.profile{margin:-10px -22px 0;padding:25px 21px 26px;border-radius:0 0 24px 24px}
.profile-avatar-wrap{width:100px;height:100px}
.avatar{width:100px;height:100px;border:3px solid #fff;border-radius:50%;line-height:88px}
