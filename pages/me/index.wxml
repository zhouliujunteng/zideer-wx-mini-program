<view class="screen">
  <view class="screen-scroll me" style="padding-top: {{navigation.statusBarHeight || 20}}px;">
    <view class="app-nav" style="height: {{navigation.navigationBarHeight || 44}}px;">
      <view class="app-nav__main"><text class="app-nav__title">我的</text></view>
    </view>

    <block wx:if="{{loading}}">
      <view class="me-loading">
        <view class="skeleton skeleton-avatar"></view>
        <view class="skeleton skeleton-name"></view>
        <view class="skeleton skeleton-assets"></view>
        <view class="skeleton skeleton-menu"></view>
      </view>
    </block>

    <view class="state-panel" wx:elif="{{loadFailed}}">
      <view class="state-panel__mark">!</view>
      <text class="state-panel__title">账户资料暂时没有加载出来</text>
      <text class="state-panel__copy">网络恢复后，可以重新读取身份、余额和家庭信息。</text>
      <button class="state-panel__action pressable" bindtap="loadPage">重新加载</button>
    </view>

    <block wx:elif="{{profile && currentStudent}}">
      <view class="profile-head">
        <view class="profile-avatar">{{profile.initial}}</view>
        <button class="profile-name pressable" data-id="identity" bindtap="handleEntry">
          <text>{{profile.displayName}}</text><text class="profile-name__arrow">›</text>
        </button>
        <text class="profile-meta">{{profile.gradeLabel}} · {{profile.roleLabel}}</text>
      </view>

      <button class="student-row surface pressable" bindtap="chooseStudent">
        <view class="student-row__avatar">{{currentStudent.initial}}</view>
        <view class="student-row__copy">
          <text class="student-row__label">当前学生</text>
          <text class="student-row__name">{{currentStudent.name}} · {{currentStudent.relation}}</text>
        </view>
        <text class="student-row__action">切换</text>
        <text class="menu-row__arrow">›</text>
      </button>

      <view class="asset-grid asset-grid--single" wx:if="{{balances}}">
        <button class="asset-card surface pressable" data-id="points" bindtap="handleEntry">
          <view class="asset-card__head"><image src="/assets/icons/wallet.svg" mode="aspectFit" /><text>课程积分</text><text class="asset-card__arrow">›</text></view>
          <view class="asset-card__value"><text>{{balances.coursePoints}}</text><text class="asset-card__unit">积分</text></view>
          <text class="asset-card__meta">冻结 {{balances.frozenPoints}}</text>
        </button>
      </view>
      <button class="student-row surface pressable" wx:else data-id="points" bindtap="handleEntry"><view class="student-row__copy"><text class="student-row__label">课程积分</text><text class="student-row__name">支付履约成功后会自动开通积分账户</text></view><text class="menu-row__arrow">›</text></button>
      <button class="student-row surface pressable" data-id="coins" bindtap="handleEntry"><view class="student-row__copy"><text class="student-row__label">金币</text><text class="student-row__name">任务奖励、流水和提现状态</text></view><text class="menu-row__arrow">›</text></button>

      <view class="me-section">
        <view class="section-head"><text class="section-title">最近学习</text></view>
        <button class="update-row surface pressable" wx:if="{{childUpdate}}" data-id="child" bindtap="handleEntry">
          <view class="update-row__mark"></view>
          <view class="update-row__copy">
            <text class="update-row__title">{{childUpdate.title}}</text>
            <text class="update-row__meta">{{childUpdate.detail}}</text>
          </view>
          <text class="menu-row__arrow">›</text>
        </button><view class="update-row surface" wx:else><view class="update-row__mark"></view><view class="update-row__copy"><text class="update-row__title">暂时没有学习动态</text><text class="update-row__meta">开始课程或完成验收后会同步最新状态。</text></view></view>
      </view>

      <view class="me-section">
        <view class="section-head"><text class="section-title">账户</text></view>
        <view class="menu-list surface">
          <button class="menu-row pressable" wx:for="{{accountItems}}" wx:key="id" data-id="{{item.id}}" bindtap="handleEntry">
            <view class="menu-row__icon menu-row__icon--{{item.icon}}"><image src="/assets/icons/{{item.icon}}.svg" mode="aspectFit" /></view>
            <view class="menu-row__copy"><text class="menu-row__title">{{item.label}}</text><text class="menu-row__meta">{{item.meta}}</text></view>
            <text class="menu-row__arrow">›</text>
          </button>
        </view>
      </view>

      <view class="me-section">
        <view class="section-head"><text class="section-title">服务</text></view>
        <view class="menu-list surface">
          <button class="menu-row pressable" wx:for="{{serviceItems}}" wx:key="id" data-id="{{item.id}}" bindtap="handleEntry">
            <view class="menu-row__icon menu-row__icon--{{item.icon}}"><image src="/assets/icons/{{item.icon}}.svg" mode="aspectFit" /></view>
            <view class="menu-row__copy"><text class="menu-row__title">{{item.label}}</text><text class="menu-row__meta">{{item.meta}}</text></view>
            <text class="menu-row__arrow">›</text>
          </button>
        </view>
      </view>
    </block>
  </view>
</view>
