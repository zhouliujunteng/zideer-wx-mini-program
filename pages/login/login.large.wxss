/* 自动生成，请勿手改：login.wxss 在平板、电脑大屏（窗口宽 ≥ 450px）下的样式。
   rpx 按 1rpx = 0.6px 换算，固定定位元素收进居中栏；改完源文件后运行 node scripts/build-large-screen-styles.mjs */
@media (min-width: 450px) {
page{height:100%}
.login-page{width:100%;height:100vh}
.login-background{top:0;left:0;width:100%;height:100%}
.login-back-button{left:10px;border-radius:50%;box-shadow:0 1px 4px rgba(36, 51, 45, .12)}
.login-back-arrow{width:13px;height:13px;box-sizing:border-box;border-bottom:2px solid #000000;border-left:2px solid #000000}
.login-brand-wrap{top:calc(50vh - 110px);left:50%;width:240px;height:136px}
.login-brand-logo{width:100%;height:100%;filter:drop-shadow(-4px 0 0 #fff) drop-shadow(3px 0 0 #fff) drop-shadow(0 -4px 0 #fff) drop-shadow(0 3px 0 #fff) drop-shadow(-3px -3px 0 #fff) drop-shadow(2px -3px 0 #fff) drop-shadow(-3px 2px 0 #fff) drop-shadow(2px 2px 0 #fff) drop-shadow(0 4px 7px rgba(110, 52, 0, .22))}
.login-actions{right:calc(max(0px, 50% - var(--lg-col) / 2) + 9px);bottom:calc(17vh + env(safe-area-inset-bottom) - 80px);left:calc(max(0px, 50% - var(--lg-col) / 2) + 9px)}
.login-error{margin:0 19px 12px;font-size:15px;line-height:1.6}
.login-button{width:336px;height:50px;margin:0 auto;padding:0;border:0;border-radius:599px;font-size:18px;font-weight:600;line-height:50px}
.login-button::after{border:0}
.agreement-row{min-height:38px;gap:4px;margin-top:16px;font-size:13px;line-height:1.5}
.agreement-checkbox{width:18px;height:18px;flex:0 0 18px;box-sizing:border-box;border:1px solid #A9A9A9;border-radius:50%;font-size:12px;line-height:1}
.agreement-checkbox.is-checked{border-color:#FD7C02}
.login-browse{width:144px;margin:7px auto 0;font-size:15px;line-height:38px}
.agreement-modal-mask{top:0;right:max(0px, 50% - var(--lg-col) / 2);bottom:0;left:max(0px, 50% - var(--lg-col) / 2);padding:28px;box-sizing:border-box;box-shadow:0 0 0 100vmax rgba(0, 0, 0, .42)}
.agreement-modal{width:100%;max-height:78vh;flex-direction:column;border-radius:19px;box-shadow:0 12px 36px rgba(36, 51, 45, .18)}
.agreement-modal-header{min-height:62px;padding:0 43px;box-sizing:border-box;border-bottom:0.5px solid #F0F0F0}
.agreement-modal-title{font-size:19px;font-weight:700}
.agreement-modal-close{top:9px;right:12px;width:43px;height:43px;font-size:28px;line-height:1}
.agreement-modal-content{height:56vh;padding:16px 19px;box-sizing:border-box}
.agreement-modal-meta{margin-bottom:14px;font-size:14px;line-height:1.6}
.agreement-modal-section{margin-bottom:4px}
.agreement-modal-heading{margin-bottom:7px;font-size:16px;font-weight:700;line-height:1.6}
.agreement-modal-paragraph{margin-bottom:14px;font-size:16px;line-height:1.75}
.agreement-modal-confirm{min-height:52px;margin:0 19px 16px;border-radius:599px;font-size:18px;font-weight:600}
.agreement-prompt{padding:28px 24px 21px;box-sizing:border-box}
.agreement-prompt-title{font-size:19px;font-weight:700}
.agreement-prompt-copy{margin-top:12px;font-size:16px;line-height:1.75}
.agreement-prompt-actions{gap:12px;margin-top:24px}
.agreement-prompt-button{min-width:0;height:52px;flex:1;margin:0;padding:0;border:0;border-radius:599px;font-size:18px;font-weight:600;line-height:52px}
.agreement-prompt-button::after{border:0}
}
@media (min-width: 450px) and (max-height: 680px) {
.login-brand-wrap{width:216px;height:122px}
.login-actions{bottom:calc(12vh + env(safe-area-inset-bottom) - 80px)}
}
