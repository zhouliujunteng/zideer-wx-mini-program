.login-page {
  min-height: 100vh;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  padding: 88rpx 48rpx 64rpx;
}

.login-brand {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.brand-mark {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 76rpx;
  height: 76rpx;
  box-sizing: border-box;
  border: 2rpx solid #FD7C02;
  color: #FD7C02;
  font-size: 36rpx;
  font-weight: 600;
}

.brand-name {
  color: #20231F;
  font-size: 34rpx;
  font-weight: 600;
}

.login-content {
  margin-top: 230rpx;
}

.login-title {
  display: block;
  color: #20231F;
  font-size: 52rpx;
  font-weight: 600;
  line-height: 1.35;
}

.login-copy {
  display: block;
  margin-top: 24rpx;
  color: #72746C;
  font-size: 28rpx;
  line-height: 1.7;
}

.login-footer {
  margin-top: auto;
}

.phone-button {
  height: 96rpx;
  line-height: 96rpx;
  border-radius: 20rpx;
  background: #FD7C02;
  color: #FFFFFF;
  font-size: 32rpx;
  font-weight: 500;
}

.login-notice,
.checking-copy {
  display: block;
  margin-top: 24rpx;
  color: #8C8E85;
  font-size: 24rpx;
  line-height: 1.6;
  text-align: center;
}

.checking-copy {
  margin-top: auto;
}
.login-error { display: block; margin-bottom: 24rpx; color: #B65314; font-size: 25rpx; line-height: 1.6; }
.privacy-link { display: block; padding: 22rpx 0; color: #A5540A; font-size: 24rpx; text-align: center; }
.phone-button::after { border: 0; }
