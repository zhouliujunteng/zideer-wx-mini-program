/* 自动生成，请勿手改：index.wxss 在平板、电脑大屏（窗口宽 ≥ 450px）下的样式。
   rpx 按 1rpx = 0.6px 换算，固定定位元素收进居中栏；改完源文件后运行 node scripts/build-large-screen-styles.mjs */
@media (min-width: 450px) {
.sk{border-radius:7px}
.sk-line{height:16px}
.sk-line + .sk-line{margin-top:8px}
.sk-short{width:40%}
.sk-mid{width:64%}
.sk-round{border-radius:50%}
.sk-card{height:96px;border-radius:14px}
.sk-card + .sk-card{margin-top:12px}
.messages-page{height:100vh}
.messages-topbar{top:0;left:max(0px, 50% - var(--lg-col) / 2);width:min(100%, var(--lg-col))}
.messages-topbar::after{right:0;bottom:0;left:0;height:0.5px}
.messages-topbar-inner{padding:0 21px 9px}
.messages-back-button{width:26px;height:26px;margin-right:6px}
.messages-back-icon{width:13px;height:13px;border-bottom:1px solid #24332d;border-left:1px solid #24332d;transform:rotate(45deg) scale(.72)}
.messages-topbar-title{font-size:21px;font-weight:700;letter-spacing:-1px;line-height:1}
.messages-search-button{border:0.5px solid #e7ebe6;border-radius:50%}
.messages-search-icon{width:15px;height:15px}
.messages-search-icon::before{top:0.5px;left:0.5px;width:8px;height:8px;border:1px solid #7f8a82;border-radius:50%}
.messages-search-icon::after{right:0.5px;bottom:1px;width:5px;height:1px;border-radius:599px;transform:rotate(45deg);transform-origin:right center}
.messages-scroll{height:100vh}
.messages-shell{min-height:100%;padding:9px 21px 90px}
.messages-search-field{height:45px;margin-bottom:13px;padding:0 14px;border-radius:13px}
.messages-search-field .messages-search-icon{margin-right:8px}
.messages-search-input{min-width:0;font-size:14px}
.messages-search-clear{margin-left:7px;font-size:21px;line-height:1}
.message-shortcuts{gap:7px}
.message-shortcut{min-width:0;min-height:57px;padding:12px;border-radius:15px}
.shortcut-icon-wrap{width:33px;height:33px;margin-right:10px}
.shortcut-icon{width:33px;height:33px}
.shortcut-copy{min-width:0}
.shortcut-title{font-size:14px;font-weight:650;line-height:1.2}
.message-badge{border:1px solid #fff;border-radius:599px;font-size:10px;font-weight:650;line-height:1}
.message-badge-circle{width:19px;height:19px;padding:0}
.message-badge-pill{min-width:25px;height:19px;padding:0 4px}
.shortcut-badge{top:-8px;right:-8px}
.message-section-heading{margin:18px 2px 9px;font-size:16px;font-weight:650}
.message-section-count{margin-left:auto;font-size:12px;font-weight:400}
.system-heading{margin-top:20px}
.teacher-list{border-radius:16px}
.teacher-row{min-height:75px;padding:12px 14px}
.teacher-row{border-bottom:0.5px solid #f0f2ef}
.teacher-row:last-child{border-bottom:0}
.teacher-avatar-wrap{margin-right:10px}
.teacher-avatar{width:44px;height:44px;border-radius:50%}
.teacher-avatar-wrap > .message-badge{top:-5px;right:-6px}
.teacher-avatar-person{width:18px;height:18px;border:1px solid #B8C1BB;border-radius:50%;transform:translateY(-6px)}
.teacher-avatar-person::after{top:18px;left:-6px;width:27px;height:14px;border:1px solid #B8C1BB;border-bottom:0;border-radius:16px 16px 0 0}
.teacher-copy{min-width:0}
.teacher-title-row{min-width:0}
.teacher-name{font-size:15px;font-weight:650;line-height:1.25}
.teacher-subject{height:19px;margin-left:6px;padding:0 6px;border-radius:599px;font-size:10px;line-height:1}
.teacher-preview{margin-top:6px;font-size:12px;line-height:1.3}
.teacher-meta{margin-left:8px}
.teacher-time{font-size:11px;line-height:1.2}
.system-summary-row{min-height:70px;margin-top:20px;padding:13px 14px;border-radius:16px}
.system-summary-icon{width:40px;height:40px;margin-right:10px;border-radius:50%}
.system-summary-icon-image{width:25px;height:25px}
.system-summary-copy{min-width:0}
.system-summary-title{font-size:15px;font-weight:650;line-height:1.25}
.system-summary-preview{margin-top:6px;font-size:12px;line-height:1.3}
.system-summary-meta{margin-left:9px}
.system-summary-count{font-size:12px}
.system-summary-arrow{width:8px;height:8px;margin-left:8px;border-top:1px solid #b4bbb5;border-right:1px solid #b4bbb5;transform:rotate(45deg)}
.message-empty{padding:31px 14px;border-radius:16px;font-size:13px}
.message-empty-all{margin-top:15px}
.message-state{margin-top:14px;padding:31px 14px;border-radius:16px;font-size:14px}
.message-state button{margin-top:14px;border-radius:599px;font-size:15px}
.message-state button::after{border:0}
.messages-shell{padding-bottom:calc(48px + env(safe-area-inset-bottom))}
.message-summary-skeleton{min-height:70px;margin-top:15px;padding:13px 14px;border-radius:16px}
.message-summary-skeleton-icon{width:43px;height:43px;margin-right:12px}
.message-summary-skeleton-copy{min-width:0}
}
