.messages-page { min-height: 100vh; padding: 48rpx 28rpx calc(env(safe-area-inset-bottom) + 48rpx); }.messages-skeleton { height: 540rpx; }.messages-head { padding: 0 8rpx; }.messages-eyebrow { display: block; color: var(--accent-deep); font-size: 22rpx; font-weight: 700; }.messages-title { display: block; margin-top: 12rpx; font-size: 42rpx; font-weight: 700; }.message-filters { width: 100%; margin-top: 30rpx; white-space: nowrap; }.message-filter { display: inline-flex; min-width: 104rpx; min-height: 58rpx; align-items: center; justify-content: center; margin-right: 14rpx; padding: 0 18rpx; border: 1rpx solid var(--line); border-radius: 8rpx; background: var(--surface); color: var(--muted); font-size: 21rpx; }.message-filter--active { border-color: var(--accent); background: var(--accent-soft); color: var(--accent-deep); font-weight: 700; }.messages-list { overflow: hidden; margin-top: 20rpx; padding: 0 24rpx; }.message-row { display: flex; width: 100%; min-height: 128rpx; align-items: center; border-bottom: 1rpx solid var(--line); text-align: left; }.message-row:last-child { border-bottom: 0; }.message-row__dot { width: 12rpx; height: 12rpx; flex: none; border-radius: 6rpx; background: transparent; }.message-row__dot--unread { background: var(--accent); }.message-row__copy { min-width: 0; flex: 1; margin-left: 14rpx; }.message-row__title, .message-row__summary, .message-row__time { display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }.message-row__title { font-size: 24rpx; font-weight: 700; }.message-row__summary { margin-top: 7rpx; color: var(--ink-soft); font-size: 20rpx; }.message-row__time { margin-top: 6rpx; color: var(--muted); font-size: 18rpx; }.message-row__arrow { margin-left: 12rpx; color: var(--muted); font-size: 32rpx; }.messages-empty { margin-top: 28rpx; padding: 30rpx 26rpx; }.messages-empty__title { display: block; font-size: 28rpx; font-weight: 700; }.messages-empty__copy { display: block; margin-top: 12rpx; color: var(--muted); font-size: 22rpx; line-height: 1.6; }
