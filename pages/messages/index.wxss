page { background: #FAFAFA; }

.messages-page { height: 100vh; overflow: hidden; background: #FAFAFA; color: #24332d; }
.messages-topbar { position: fixed; top: 0; left: 0; z-index: 20; width: 100%; box-sizing: border-box; background: #FAFAFA; }
.messages-topbar::after { position: absolute; right: 0; bottom: 0; left: 0; height: 1rpx; background: #e8ebe8; content: ''; }
.messages-topbar-inner { display: flex; align-items: center; box-sizing: content-box; padding: 0 36rpx 16rpx; }
.messages-back-button { display: flex; flex: 0 0 auto; align-items: center; justify-content: center; width: 44rpx; height: 44rpx; margin-right: 10rpx; }
.messages-back-icon { position: relative; width: 22rpx; height: 22rpx; border-bottom: 3rpx solid #24332d; border-left: 3rpx solid #24332d; transform: rotate(45deg) scale(.72); }
.messages-topbar-title { color: #24332d; font-size: 36rpx; font-weight: 700; letter-spacing: -1rpx; line-height: 1; }
.messages-search-button { position: fixed; z-index: 21; display: flex; align-items: center; justify-content: center; box-sizing: border-box; border: 1rpx solid #e7ebe6; border-radius: 50%; background: #fff; }
.messages-search-icon { position: relative; flex: 0 0 auto; width: 25rpx; height: 25rpx; }
.messages-search-icon::before { position: absolute; top: 1rpx; left: 1rpx; width: 14rpx; height: 14rpx; border: 2rpx solid #7f8a82; border-radius: 50%; content: ''; }
.messages-search-icon::after { position: absolute; right: 1rpx; bottom: 2rpx; width: 9rpx; height: 2rpx; border-radius: 999rpx; background: #7f8a82; content: ''; transform: rotate(45deg); transform-origin: right center; }
.messages-scroll { height: 100vh; box-sizing: border-box; background: #FAFAFA; }
.messages-shell { min-height: 100%; padding: 16rpx 36rpx 150rpx; box-sizing: border-box; }

.messages-search-field { display: flex; align-items: center; height: 76rpx; margin-bottom: 22rpx; padding: 0 24rpx; box-sizing: border-box; border-radius: 22rpx; background: #fff; color: #8b958e; }
.messages-search-field .messages-search-icon { margin-right: 14rpx; }
.messages-search-input { flex: 1; min-width: 0; color: #24332d; font-size: 24rpx; }
.messages-search-clear { flex: 0 0 auto; margin-left: 12rpx; color: #9ba39d; font-size: 36rpx; line-height: 1; }

.message-shortcuts { display: flex; gap: 12rpx; }
.message-shortcut { position: relative; display: flex; flex: 1; align-items: center; justify-content: flex-start; min-width: 0; min-height: 96rpx; padding: 20rpx; box-sizing: border-box; border-radius: 26rpx; overflow: visible; }
.shortcut-tone-cyan { background: #E6F8F5; }
.shortcut-tone-blue { background: #EAF1FF; }
.shortcut-tone-pink { background: #FCEAF1; }
.shortcut-icon-wrap { position: relative; flex: 0 0 auto; width: 56rpx; height: 56rpx; margin-right: 18rpx; }
.shortcut-icon { display: block; width: 56rpx; height: 56rpx; }
.shortcut-copy { display: flex; min-width: 0; flex: 0 0 auto; flex-direction: column; }
.shortcut-title { color: #263b37; font-size: 24rpx; font-weight: 650; line-height: 1.2; white-space: nowrap; }
.message-badge { position: absolute; z-index: 2; display: inline-flex; align-items: center; justify-content: center; box-sizing: border-box; border: 3rpx solid #fff; border-radius: 999rpx; background: #FD5A5F; color: #fff; font-size: 17rpx; font-weight: 650; line-height: 1; white-space: nowrap; }
.message-badge-circle { width: 32rpx; height: 32rpx; padding: 0; }
.message-badge-pill { min-width: 42rpx; height: 32rpx; padding: 0 8rpx; }
.shortcut-badge { top: -12rpx; right: -12rpx; }

.message-section-heading { display: flex; align-items: center; justify-content: space-between; margin: 30rpx 4rpx 16rpx; color: #24332d; font-size: 28rpx; font-weight: 650; }
.message-section-count { margin-left: auto; color: #a1aaa3; font-size: 20rpx; font-weight: 400; }
.system-heading { margin-top: 34rpx; }
.teacher-list { overflow: hidden; border-radius: 28rpx; background: #fff; }
.teacher-row { position: relative; display: flex; align-items: center; min-height: 126rpx; padding: 20rpx 24rpx; box-sizing: border-box; }
.teacher-row { border-bottom: 1rpx solid #f0f2ef; background: #fff; }
.teacher-row:last-child { border-bottom: 0; }
.teacher-avatar-wrap { position: relative; flex: 0 0 auto; margin-right: 18rpx; }
.teacher-avatar { position: relative; display: flex; align-items: center; justify-content: center; width: 74rpx; height: 74rpx; border-radius: 50%; background: #E9ECEA; }
.teacher-avatar-wrap > .message-badge { top: -7rpx; right: -10rpx; }
.teacher-avatar-person { position: relative; width: 31rpx; height: 31rpx; border: 3rpx solid #B8C1BB; border-radius: 50%; transform: translateY(-9rpx); }
.teacher-avatar-person::after { position: absolute; top: 30rpx; left: -10rpx; width: 45rpx; height: 24rpx; border: 3rpx solid #B8C1BB; border-bottom: 0; border-radius: 28rpx 28rpx 0 0; content: ''; }
.teacher-copy { min-width: 0; flex: 1; }
.teacher-title-row { display: flex; align-items: center; min-width: 0; }
.teacher-name { overflow: hidden; color: #31463f; font-size: 26rpx; font-weight: 650; line-height: 1.25; text-overflow: ellipsis; white-space: nowrap; }
.teacher-subject { display: inline-flex; flex: 0 0 auto; align-items: center; height: 32rpx; margin-left: 10rpx; padding: 0 11rpx; box-sizing: border-box; border-radius: 999rpx; font-size: 18rpx; line-height: 1; white-space: nowrap; }
.teacher-subject-cyan { background: rgba(45, 151, 143, .14); color: #357F79; }
.teacher-subject-lavender { background: rgba(118, 91, 196, .13); color: #7253A8; }
.teacher-subject-peach { background: rgba(222, 116, 69, .14); color: #B96745; }
.teacher-preview { display: block; margin-top: 10rpx; overflow: hidden; color: #718079; font-size: 21rpx; line-height: 1.3; text-overflow: ellipsis; white-space: nowrap; }
.teacher-meta { display: flex; flex: 0 0 auto; flex-direction: column; align-items: flex-end; align-self: flex-start; justify-content: flex-start; margin-left: 14rpx; }
.teacher-time { color: #9ca59f; font-size: 19rpx; line-height: 1.2; white-space: nowrap; }

.system-summary-row { display: flex; align-items: center; min-height: 118rpx; margin-top: 34rpx; padding: 22rpx 24rpx; box-sizing: border-box; border-radius: 28rpx; background: #fff; }
.system-summary-icon { display: flex; flex: 0 0 auto; align-items: center; justify-content: center; width: 68rpx; height: 68rpx; margin-right: 18rpx; border-radius: 50%; background: #FCECEF; }
.system-summary-icon-image { display: block; width: 42rpx; height: 42rpx; }
.system-summary-copy { min-width: 0; flex: 1; }
.system-summary-title { display: block; color: #31463f; font-size: 26rpx; font-weight: 650; line-height: 1.25; }
.system-summary-preview { display: block; margin-top: 10rpx; overflow: hidden; color: #718079; font-size: 21rpx; line-height: 1.3; text-overflow: ellipsis; white-space: nowrap; }
.system-summary-meta { display: flex; flex: 0 0 auto; align-items: center; margin-left: 16rpx; }
.system-summary-count { color: #9ca59f; font-size: 20rpx; white-space: nowrap; }
.system-summary-arrow { width: 14rpx; height: 14rpx; margin-left: 14rpx; border-top: 3rpx solid #b4bbb5; border-right: 3rpx solid #b4bbb5; transform: rotate(45deg); }
.message-empty { padding: 52rpx 24rpx; border-radius: 28rpx; background: #fff; color: #a4ada6; font-size: 23rpx; text-align: center; }
.message-empty-all { margin-top: 26rpx; }

/* Live loading/error states and safe-area padding. */
.message-state { margin-top: 24rpx; padding: 52rpx 24rpx; border-radius: 28rpx; background: #fff; color: #718079; font-size: 24rpx; text-align: center; }
.message-state text { display: block; }
.message-state button { margin-top: 24rpx; border-radius: 999rpx; background: #fff0e2; color: #FD7C02; font-size: 26rpx; }
.message-state button::after { border: 0; }
.messages-shell { padding-bottom: calc(80rpx + env(safe-area-inset-bottom)); }
