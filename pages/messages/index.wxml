<view class="messages-page"><view class="messages-skeleton skeleton" wx:if="{{loading}}"></view><view class="state-panel" wx:elif="{{failed}}"><view class="state-panel__mark">!</view><text class="state-panel__title">消息暂时无法加载</text><button class="state-panel__action pressable" bindtap="loadPage">重新加载</button></view><block wx:else><view class="messages-head"><text class="messages-eyebrow">服务通知</text><text class="messages-title">消息中心</text></view><scroll-view class="message-filters" scroll-x show-scrollbar="{{false}}"><button class="message-filter pressable {{activeFilter === item.id ? 'message-filter--active' : ''}}" wx:for="{{filters}}" wx:key="id" data-filter="{{item.id}}" bindtap="setFilter">{{item.label}}</button></scroll-view><view class="messages-empty surface" wx:if="{{!visibleNotifications.length}}"><text class="messages-empty__title">{{notifications.length ? '当前筛选下没有消息' : '暂时没有新消息'}}</text><text class="messages-empty__copy">{{notifications.length ? '切换筛选条件查看其他服务消息。' : '有新的服务消息时，会显示在这里。'}}</text></view><view class="messages-list surface" wx:else><button class="message-row pressable" wx:for="{{visibleNotifications}}" wx:key="id" data-id="{{item.id}}" bindtap="openNotification"><view class="message-row__dot {{item.unread ? 'message-row__dot--unread' : ''}}"></view><view class="message-row__copy"><text class="message-row__title">{{item.title}}</text><text class="message-row__summary">{{item.summary}}</text><text class="message-row__time">{{item.timeLabel}}</text></view><text class="message-row__arrow">›</text></button></view></block></view>
