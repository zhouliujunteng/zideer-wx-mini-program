<view class="page-shell">
  <view class="topline">
    <text class="brand">知鹿私课</text>
    <button class="profile-trigger" bindtap="openProfile" aria-label="查看个人资料">我</button>
  </view>

  <view class="welcome" wx:if="{{!loading}}">
    <text class="eyebrow">继续学习</text>
    <text class="welcome-title">你好，{{nickname}}</text>
    <text class="welcome-copy">你的专属课程将在这里出现。</text>
  </view>

  <view class="plan-list" wx:if="{{!loading && hasActivePlan}}">
    <view class="section-heading">
      <text class="section-title">近期课程</text>
      <text class="section-note">已购计划</text>
    </view>
    <view class="plan-card" wx:for="{{plans}}" wx:key="id">
      <text class="plan-title">{{item.course.title || item.plan_name}}</text>
      <view class="schedule-row" wx:for="{{item.schedules}}" wx:for-item="schedule" wx:key="id">
        <text class="schedule-dot"></text>
        <text class="schedule-title">{{schedule.title}}</text>
        <text class="schedule-duration">{{schedule.duration_minutes}} 分钟</text>
      </view>
    </view>
  </view>

  <view class="course-list" wx:if="{{!loading && !hasActivePlan}}">
    <view class="section-heading">
      <text class="section-title">课程介绍</text>
      <text class="section-note">选择适合的私课</text>
    </view>
    <view class="course-card" wx:for="{{courses}}" wx:key="id">
      <view class="course-mark">知</view>
      <view class="course-content">
        <text class="course-title">{{item.title}}</text>
        <text class="course-copy">{{item.introduction}}</text>
      </view>
    </view>
    <view class="course-empty" wx:if="{{!courses.length}}">
      <text class="empty-title">课程即将上线</text>
      <text class="empty-copy">开课信息会在这里发布。</text>
    </view>
  </view>

  <view class="loading-copy" wx:if="{{loading}}">正在读取学习资料</view>
</view>
