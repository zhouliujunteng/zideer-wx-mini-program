<view class="page-shell">
  <view class="topline">
    <text class="brand">知鹿私课</text>
    <button class="profile-trigger" bindtap="openProfile" aria-label="查看个人资料">我</button>
  </view>

  <view class="welcome" wx:if="{{!loading}}">
    <text class="eyebrow">继续学习</text>
    <text class="welcome-title">你好，{{nickname}}</text>
    <text class="welcome-copy">你的专属课程将在这里出现。</text>
  </view>

  <view class="course-empty" wx:if="{{!loading}}">
    <view class="course-mark">知</view>
    <text class="empty-title">还没有可学习的课程</text>
    <text class="empty-copy">课程开通后，会按学习进度显示在这里。</text>
  </view>

  <view class="loading-copy" wx:if="{{loading}}">正在读取学习资料</view>
</view>
