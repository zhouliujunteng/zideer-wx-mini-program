.referral-page { min-height:100vh; padding:88rpx 28rpx; background:var(--canvas); }.referral-eyebrow { display:block; color:var(--accent); font-size:24rpx; font-weight:700; }.referral-title { display:block; margin-top:10rpx; font-size:46rpx; font-weight:700; }.referral-card { margin-top:48rpx; padding:32rpx 28rpx; }.referral-card__title { display:block; font-size:30rpx; font-weight:700; }.referral-card__copy { display:block; margin-top:16rpx; color:var(--ink-soft); font-size:25rpx; line-height:1.6; }.referral-primary,.referral-secondary { display:flex; width:100%; min-height:86rpx; align-items:center; justify-content:center; margin-top:28rpx; border-radius:43rpx; font-size:26rpx; font-weight:700; }.referral-primary { background:var(--accent); color:var(--surface); }.referral-secondary { margin-top:14rpx; border:1rpx solid var(--line-strong); background:var(--surface); }
