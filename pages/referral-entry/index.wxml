<view class="referral-page"><view class="referral-head"><text class="referral-eyebrow">知鹿私课</text><text class="referral-title">推广伙伴邀请</text></view><view class="referral-card surface"><text class="referral-card__title">{{completed ? (isDeepGift ? '深测资格已领取' : '邀请已确认') : '正在核验邀请'}}</text><text class="referral-card__copy" wx:if="{{tokenProvided}}">{{message || '正在由服务端核验邀请有效性。'}}</text><text class="referral-card__copy" wx:else>请通过推广伙伴分享的小程序卡片、海报码或链接进入。</text><button class="referral-primary pressable" wx:if="{{!completed && tokenProvided}}" loading="{{processing}}" disabled="{{processing}}" bindtap="retry">重新核验</button><button class="referral-secondary pressable" bindtap="goHome">返回首页</button></view></view>
