/* 自动生成，请勿手改：index.wxss 在平板、电脑大屏（窗口宽 ≥ 450px）下的样式。
   rpx 按 1rpx = 0.6px 换算，固定定位元素收进居中栏；改完源文件后运行 node scripts/build-large-screen-styles.mjs */
@media (min-width: 450px) {
.sk{border-radius:7px}
.sk-line{height:16px}
.sk-line + .sk-line{margin-top:8px}
.sk-short{width:40%}
.sk-mid{width:64%}
.sk-round{border-radius:50%}
.sk-card{height:96px;border-radius:14px}
.sk-card + .sk-card{margin-top:12px}
.system-messages-page{height:100vh}
.system-messages-topbar{top:0;left:max(0px, 50% - var(--lg-col) / 2);width:min(100%, var(--lg-col))}
.system-messages-topbar::after{right:0;bottom:0;left:0;height:0.5px}
.system-messages-topbar-inner{padding:0 21px 9px}
.system-messages-back-button{width:26px;height:26px;margin-right:6px}
.system-messages-back-icon{width:13px;height:13px;border-bottom:1px solid #24332d;border-left:1px solid #24332d}
.system-messages-topbar-title{font-size:21px;font-weight:700;letter-spacing:-1px;line-height:1}
.system-messages-scroll{height:100vh}
.system-messages-shell{min-height:100%;padding:9px 21px 90px}
.system-detail-list{border-radius:16px}
.system-detail-row{min-height:75px;padding:13px 14px;border-bottom:0.5px solid #f0f2ef}
.system-detail-row:last-child{border-bottom:0}
.system-detail-main{min-width:0}
.system-detail-title-row{min-width:0}
.system-detail-title{min-width:0;font-size:15px;font-weight:650;line-height:1.25}
.message-badge{border:1px solid #fff;border-radius:599px;font-size:10px;font-weight:650;line-height:1}
.message-badge-circle{width:19px;height:19px;padding:0}
.message-badge-pill{min-width:25px;height:19px;padding:0 4px}
.system-detail-meta{margin-left:8px}
.system-detail-badge{margin-left:7px}
.system-detail-unread-dot{width:8px;height:8px;margin-left:8px;border-radius:50%}
.system-detail-preview{margin-top:6px;font-size:12px;line-height:1.35}
.system-detail-time{font-size:11px;line-height:1.25}
.system-detail-empty{padding:31px 14px;border-radius:16px;font-size:13px}
.message-state{margin-top:14px;padding:31px 14px;border-radius:16px;font-size:14px}
.message-state button{margin-top:14px;border-radius:599px;font-size:15px}
.message-state button::after{border:0}
.system-messages-shell{padding-bottom:calc(48px + env(safe-area-inset-bottom))}
.system-time-skeleton{width:38px}
}
