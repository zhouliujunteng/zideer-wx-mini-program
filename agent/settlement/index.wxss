/* 结算中心：样式取自设计仓库 b5dda68 的 package-promotion/pages/settlement，
   「提现」相关类改名为「可选择奖励」，加载态、失败态与资格提示条沿用推广伙伴工作台。 */
@import "../../styles/skeleton.wxss";

page { background: #FAFAFA; }

.settlement-page { position: relative; height: 100vh; overflow: hidden; background: #FAFAFA; color: #24332D; }
.settlement-topbar { position: fixed; top: 0; right: 0; left: 0; z-index: 20; box-sizing: border-box; background: transparent; }
.settlement-topbar-surface { position: absolute; top: 0; right: 0; bottom: 0; left: 0; z-index: 0; background: #FAFAFA; pointer-events: none; transition: opacity .16s linear; }
.settlement-topbar-inner { position: relative; z-index: 1; display: flex; align-items: center; box-sizing: content-box; padding: 0 36rpx 8rpx; }
.settlement-back { position: relative; display: flex; width: 44rpx; height: 44rpx; align-items: center; justify-content: center; }
.settlement-back:active { opacity: .65; }
.settlement-back-icon { position: absolute; width: 20rpx; height: 20rpx; border-bottom: 3rpx solid #FFFFFF; border-left: 3rpx solid #FFFFFF; transition: opacity .16s linear; transform: rotate(45deg) scale(.72); }
.settlement-back-icon-dark { border-color: #24332D; }
.settlement-topbar-title { position: absolute; left: 50%; z-index: 2; display: block; color: #FFFFFF; font-size: 36rpx; font-weight: 700; letter-spacing: -1rpx; transition: opacity .16s linear; transform: translateX(-50%); white-space: nowrap; }
.settlement-topbar-title-dark { color: #24332D; }
.settlement-scroll { position: absolute; top: 0; right: 0; bottom: 0; left: 0; z-index: 1; box-sizing: border-box; background: #FAFAFA; }
.settlement-refresh-capsule { position: fixed; left: 50%; z-index: 35; display: flex; height: 48rpx; align-items: center; padding: 0 18rpx; box-sizing: border-box; border-radius: 999rpx; background: rgba(255, 255, 255, .94); color: #D65F68; font-size: 18rpx; font-weight: 600; line-height: 1; box-shadow: 0 8rpx 20rpx rgba(183, 68, 82, .12); transform: translateX(-50%); }
.settlement-refresh-spinner { width: 18rpx; height: 18rpx; margin-right: 8rpx; box-sizing: border-box; border: 2rpx solid rgba(214, 95, 104, .28); border-top-color: #D65F68; border-radius: 50%; animation: settlement-refresh-spin .72s linear infinite; }
.settlement-shell { position: relative; min-height: 100%; padding: 0 32rpx calc(72rpx + env(safe-area-inset-bottom)); box-sizing: border-box; background: linear-gradient(180deg, #F14677 0%, #EF3E3A 48%, #F5A4A7 68%, #FBE4DF 79%, #FAFAFA 88%, #FAFAFA 100%); background-repeat: no-repeat; background-size: 100% 480rpx; }
.settlement-shell::before { position: absolute; top: 112rpx; right: -150rpx; z-index: 0; width: 650rpx; height: 3rpx; background: linear-gradient(90deg, transparent 0%, rgba(255, 255, 255, .32) 22%, rgba(255, 244, 222, .82) 68%, rgba(255, 255, 255, .12) 100%); content: ''; pointer-events: none; transform: rotate(-16deg); }
.settlement-shell::after { position: absolute; top: 42rpx; right: -100rpx; z-index: 0; width: 500rpx; height: 210rpx; border: 2rpx solid rgba(255, 255, 255, .28); border-left-color: transparent; border-bottom-color: transparent; border-radius: 50%; content: ''; opacity: .8; pointer-events: none; transform: rotate(-16deg); }
.settlement-ambient-icon { position: absolute; top: -26rpx; right: -80rpx; z-index: 0; width: 390rpx; height: 390rpx; opacity: .11; pointer-events: none; transform: rotate(13deg); }

.settlement-profile { display: flex; align-items: center; padding: 6rpx 4rpx 22rpx; color: #FFFFFF; }
.settlement-profile-avatar { display: flex; width: 64rpx; height: 64rpx; align-items: center; justify-content: center; overflow: hidden; border: 3rpx solid rgba(255, 255, 255, .78); border-radius: 50%; background: rgba(255, 255, 255, .32); color: #FFFFFF; font-size: 25rpx; font-weight: 700; }
.settlement-profile-avatar-image { display: block; width: 100%; height: 100%; }
.settlement-profile-name { margin-left: 16rpx; color: #FFFFFF; font-size: 27rpx; font-weight: 650; line-height: 1.2; }
.settlement-profile, .settlement-state, .settlement-wallet-card-stack, .settlement-wallet-card, .settlement-selectable-card, .settlement-status-notice, .settlement-entry-card, .settlement-records-card, .settlement-rules-card, .settlement-service-card { position: relative; z-index: 1; }

/* 骨架：头像圆、昵称、各金额位、记录行与客服说明行（金额卡、标题等固定部分照常显示） */
.settlement-sk-avatar { width: 64rpx; height: 64rpx; background: rgba(255, 255, 255, .42); animation: none; }
.settlement-sk-name { width: 150rpx; height: 30rpx; margin-left: 16rpx; background: rgba(255, 255, 255, .42); animation: none; }
.settlement-sk-daily { width: 90rpx; height: 26rpx; margin-left: 10rpx; }
.settlement-sk-balance { width: 200rpx; height: 56rpx; margin-top: 14rpx; }
.settlement-sk-selectable { width: 150rpx; height: 36rpx; margin-top: 10rpx; }
.settlement-sk-metric { width: 90rpx; height: 27rpx; margin-top: 9rpx; }
.settlement-sk-date { height: 17rpx; }
.settlement-sk-amount { flex: 0 0 auto; width: 90rpx; height: 25rpx; margin-left: 16rpx; }
.settlement-sk-service { width: 240rpx; height: 21rpx; margin-top: 8rpx; }
.settlement-state { padding: 90rpx 24rpx 40rpx; text-align: center; }
.settlement-state-title { display: block; color: #24332D; font-size: 32rpx; font-weight: 600; }
.settlement-state-copy { display: block; margin: 22rpx 0 32rpx; color: #7D877F; font-size: 25rpx; line-height: 1.6; }
.settlement-state-action { display: inline-flex; height: 76rpx; align-items: center; padding: 0 44rpx; border-radius: 20rpx; background: #FD7C02; color: #FFFFFF; font-size: 26rpx; }
.settlement-state-action:active { opacity: .78; }

.settlement-wallet-card, .settlement-selectable-card { border-radius: 28rpx; background: #FFFFFF; }
.settlement-wallet-card-stack { min-height: 220rpx; padding-bottom: 60rpx; box-sizing: border-box; }
.settlement-wallet-card-back { position: absolute; top: 28rpx; right: 0; left: 0; z-index: 0; height: 190rpx; box-sizing: border-box; border: 1rpx solid rgba(255, 255, 255, .72); border-radius: 28rpx; background: #FFF0EE; }
.settlement-wallet-daily-summary { position: absolute; right: 30rpx; bottom: 18rpx; left: 30rpx; display: flex; }
.settlement-wallet-daily-item { display: flex; min-width: 0; flex: 1; align-items: baseline; white-space: nowrap; }
.settlement-wallet-daily-item + .settlement-wallet-daily-item { position: relative; padding-left: 20rpx; }
.settlement-wallet-daily-item + .settlement-wallet-daily-item::before { position: absolute; top: 4rpx; bottom: 2rpx; left: 0; width: 2rpx; border-radius: 999rpx; background: rgba(255, 255, 255, .72); content: ''; }
.settlement-wallet-daily-label { display: block; color: #887572; font-size: 22rpx; font-weight: 600; line-height: 1.2; }
.settlement-wallet-daily-value { display: block; margin-left: 10rpx; color: #24332D; font-size: 26rpx; font-weight: 700; line-height: 1; }
.settlement-wallet-card { position: relative; z-index: 1; padding: 22rpx 30rpx 24rpx; }
.settlement-wallet-label, .settlement-selectable-label, .settlement-selectable-metric-label { color: #A1AAA4; font-size: 22rpx; font-weight: 600; }
.settlement-wallet-value { display: flex; align-items: baseline; margin-top: 14rpx; color: #24332D; font-size: 56rpx; font-weight: 700; letter-spacing: -1rpx; line-height: 1; }

.settlement-selectable-card { margin-top: 18rpx; padding: 26rpx 30rpx 24rpx; }
.settlement-selectable-heading { display: flex; align-items: center; justify-content: space-between; }
.settlement-selectable-value { display: block; margin-top: 10rpx; color: #24332D; font-size: 36rpx; font-weight: 700; line-height: 1; }
.settlement-selectable-metrics { display: flex; margin-top: 24rpx; padding-top: 20rpx; border-top: 1rpx solid #F0F2F0; }
.settlement-selectable-metric { min-width: 0; flex: 1; }
.settlement-selectable-metric + .settlement-selectable-metric { padding-left: 16rpx; border-left: 1rpx solid #EDF0ED; }
.settlement-selectable-metric-label { display: block; line-height: 1.2; white-space: nowrap; }
.settlement-selectable-metric-value { display: block; margin-top: 9rpx; color: #24332D; font-size: 27rpx; font-weight: 700; line-height: 1; }
.settlement-gift-row { display: flex; align-items: center; justify-content: space-between; margin-top: 20rpx; padding-top: 18rpx; border-top: 1rpx solid #F0F2F0; }
.settlement-gift-label { color: #A1AAA4; font-size: 21rpx; font-weight: 600; }
.settlement-gift-copy { text-align: right; }
.settlement-gift-value { display: block; color: #24332D; font-size: 26rpx; font-weight: 700; line-height: 1.1; }
.settlement-gift-hint { display: block; margin-top: 6rpx; color: #A0AAA3; font-size: 17rpx; }
.settlement-selectable-action { display: flex; height: 70rpx; margin-top: 24rpx; align-items: center; justify-content: center; border-radius: 999rpx; background: linear-gradient(90deg, #F14677, #EF3E3A); color: #FFFFFF; font-size: 23rpx; font-weight: 700; }
.settlement-selectable-action:active { opacity: .72; }

.settlement-status-notice { display: flex; min-height: 78rpx; margin-top: 18rpx; align-items: center; box-sizing: border-box; padding: 14rpx 18rpx; border-radius: 22rpx; background: #FFF8EC; }
.settlement-status-notice-failed { background: #FFF0EE; }
.settlement-status-notice-icon { display: flex; width: 32rpx; height: 32rpx; flex: 0 0 auto; align-items: center; justify-content: center; margin-right: 12rpx; border-radius: 50%; background: #F5A53D; color: #FFFFFF; font-size: 22rpx; font-weight: 700; line-height: 1; }
.settlement-status-notice-failed .settlement-status-notice-icon { background: #E58A7B; }
.settlement-status-notice-copy { min-width: 0; flex: 1; }
.settlement-status-notice-title { display: block; overflow: hidden; color: #604934; font-size: 22rpx; font-weight: 700; line-height: 1.3; text-overflow: ellipsis; white-space: nowrap; }
.settlement-status-notice-failed .settlement-status-notice-title { color: #994F47; }
/* 说明文字可以折行写全，不截成省略号（窄屏上也要看得到「联系企微客服开通」） */
.settlement-status-notice-detail { display: block; margin-top: 5rpx; color: #9B8068; font-size: 20rpx; line-height: 1.4; }
.settlement-status-notice-failed .settlement-status-notice-detail { color: #B77D76; }
.settlement-status-notice-arrow { width: 13rpx; height: 13rpx; flex: 0 0 auto; margin-left: 10rpx; border-top: 2rpx solid #B29170; border-right: 2rpx solid #B29170; transform: rotate(45deg); }
.settlement-status-notice-failed .settlement-status-notice-arrow { border-color: #D39A92; }
.settlement-status-notice:active { opacity: .72; }

/* 我的结算记录入口（2026-09-26）：与底部客服卡同一套白卡样式 */
.settlement-entry-card { display: flex; min-height: 112rpx; margin-top: 18rpx; align-items: center; padding: 22rpx 26rpx; box-sizing: border-box; border-radius: 30rpx; background: #FFFFFF; }
.settlement-entry-card:active { opacity: .78; }
.settlement-entry-icon { display: flex; width: 64rpx; height: 64rpx; flex: 0 0 auto; align-items: center; justify-content: center; border-radius: 18rpx; background: #FFF0EE; }
.settlement-entry-icon image { width: 36rpx; height: 36rpx; }
.settlement-entry-copy { min-width: 0; flex: 1; margin-left: 18rpx; }
.settlement-entry-title { display: block; color: #35433B; font-size: 27rpx; font-weight: 650; line-height: 1.25; }
.settlement-entry-meta { display: block; margin-top: 8rpx; overflow: hidden; color: #98A39B; font-size: 21rpx; line-height: 1.3; text-overflow: ellipsis; white-space: nowrap; }
.settlement-section-heading { position: relative; z-index: 1; display: flex; align-items: center; justify-content: space-between; margin: 34rpx 4rpx 0; }
.settlement-section-title { color: #24332D; font-size: 29rpx; font-weight: 700; line-height: 1.25; }
.settlement-view-all { display: flex; align-items: center; color: #8B958E; font-size: 23rpx; line-height: 1; }
.settlement-view-all:active { opacity: .7; }
.settlement-view-all-icon { display: block; width: 13rpx; height: 13rpx; margin-left: 12rpx; box-sizing: border-box; border-top: 2rpx solid #A6AFA9; border-right: 2rpx solid #A6AFA9; transform: rotate(45deg); }
.settlement-records-card { min-height: 0; padding: 20rpx 0 2rpx; box-sizing: border-box; border-radius: 0 0 30rpx 30rpx; background: transparent; }
.settlement-record-group { display: block; }
.settlement-record-item { display: flex; min-height: 104rpx; margin: 0 0 14rpx; padding: 20rpx 24rpx; box-sizing: border-box; align-items: center; border-radius: 24rpx; background: #FFFFFF; }
.settlement-record-copy { min-width: 0; flex: 1; box-sizing: border-box; }
.settlement-record-title-row { display: flex; align-items: center; justify-content: space-between; }
.settlement-record-left { min-width: 0; flex: 1; }
.settlement-record-title { display: block; min-width: 0; overflow: hidden; color: #35433B; font-size: 24rpx; font-weight: 600; line-height: 1.2; text-overflow: ellipsis; white-space: nowrap; }
.settlement-record-date { display: block; margin-top: 9rpx; color: #A0AAA3; font-size: 17rpx; line-height: 1; white-space: nowrap; }
.settlement-record-amount { flex: 0 0 auto; align-self: center; margin-left: 16rpx; color: #E2843B; font-size: 25rpx; font-weight: 600; line-height: 1; white-space: nowrap; }
.settlement-record-amount.recovering, .settlement-record-amount.reversed { color: #24332D; }
.settlement-records-empty { display: flex; min-height: 220rpx; align-items: center; justify-content: center; flex-direction: column; color: #8C9991; }
.settlement-records-empty text:first-child { color: #4E6157; font-size: 26rpx; font-weight: 650; }
.settlement-records-empty text:last-child { margin-top: 12rpx; font-size: 19rpx; }

/* 规则文案设计稿只有 18rpx，真机上太小，按用户 2026-09-21 要求整体放大一档。 */
.settlement-rules-card { margin-top: 18rpx; padding: 28rpx 26rpx; border-radius: 30rpx; background: #FFFFFF; }
.settlement-rules-title { display: block; color: #35433B; font-size: 28rpx; font-weight: 700; line-height: 1.3; }
.settlement-rule-item { display: flex; margin-top: 18rpx; color: #7E8A83; font-size: 24rpx; line-height: 1.6; }
.settlement-rule-dot { width: 10rpx; height: 10rpx; flex: 0 0 auto; margin: 14rpx 14rpx 0 2rpx; border-radius: 50%; background: #FD7C02; }

.settlement-service-card { display: flex; min-height: 112rpx; margin-top: 18rpx; align-items: center; padding: 22rpx 26rpx; box-sizing: border-box; border-radius: 30rpx; background: #FFFFFF; }
.settlement-service-card:active { opacity: .78; }
.settlement-service-icon { display: flex; width: 64rpx; height: 64rpx; flex: 0 0 auto; align-items: center; justify-content: center; border-radius: 18rpx; background: #FFF1E5; }
.settlement-service-icon image { width: 34rpx; height: 34rpx; }
.settlement-service-copy { min-width: 0; flex: 1; margin-left: 18rpx; }
.settlement-service-title { display: block; overflow: hidden; color: #35433B; font-size: 27rpx; font-weight: 650; line-height: 1.25; text-overflow: ellipsis; white-space: nowrap; }
.settlement-service-meta { display: block; margin-top: 8rpx; overflow: hidden; color: #98A39B; font-size: 21rpx; line-height: 1.3; text-overflow: ellipsis; white-space: nowrap; }
.settlement-service-arrow { width: 14rpx; height: 14rpx; flex: 0 0 auto; margin-left: 12rpx; box-sizing: border-box; border-top: 2rpx solid #B6BFB9; border-right: 2rpx solid #B6BFB9; transform: rotate(45deg); }

@keyframes settlement-refresh-spin { to { transform: rotate(360deg); } }

@media (max-width: 350px) {
  .settlement-shell { padding-right: 28rpx; padding-left: 28rpx; }
  .settlement-wallet-card { padding-right: 24rpx; padding-left: 24rpx; }
  .settlement-selectable-metric-value { font-size: 25rpx; }
}

@import "./index.large.wxss"; /* 平板、电脑大屏样式：由 scripts/build-large-screen-styles.mjs 生成，改完本文件后重跑；这一行须留在文件末尾 */
