/* 自动生成，请勿手改：index.wxss 在平板、电脑大屏（窗口宽 ≥ 450px）下的样式。
   rpx 按 1rpx = 0.6px 换算，固定定位元素收进居中栏；改完源文件后运行 node scripts/build-large-screen-styles.mjs */
@media (min-width: 450px) {
.sk{border-radius:7px}
.sk-line{height:16px}
.sk-line + .sk-line{margin-top:8px}
.sk-short{width:40%}
.sk-mid{width:64%}
.sk-round{border-radius:50%}
.sk-card{height:96px;border-radius:14px}
.sk-card + .sk-card{margin-top:12px}
.apply-page{height:100vh}
.apply-topbar{top:0;left:max(0px, 50% - var(--lg-col) / 2);width:min(100%, var(--lg-col))}
.apply-topbar-inner{padding:0 21px 9px}
.apply-back{width:26px;height:26px}
.apply-back-icon{width:12px;height:12px;border-bottom:1px solid #24332D;border-left:1px solid #24332D}
.apply-topbar-title{left:50%;font-size:21px;font-weight:700;letter-spacing:-1px}
.apply-scroll{height:100vh}
.apply-shell{padding:3px 19px calc(48px + env(safe-area-inset-bottom))}
.apply-hero{padding:20px 18px 19px;border-radius:18px}
.apply-hero-icon{top:-18px;right:-28px;width:150px;height:150px}
.apply-hero-title{font-size:21px;font-weight:700;line-height:1.3}
.apply-hero-copy{margin-top:8px;font-size:14px;line-height:1.6}
.apply-state{padding:48px 14px 24px}
.apply-state-title{font-size:19px;font-weight:600}
.apply-state-copy{margin:13px 0 19px;font-size:15px;line-height:1.6}
.apply-state-action{height:45px;padding:0 26px;border-radius:12px;font-size:15px}
.apply-steps{margin-top:15px;padding:14px 7px 12px;border-radius:18px}
.apply-step{min-width:0}
.apply-step + .apply-step::before{top:14px;right:calc(50% + 20px);left:calc(-50% + 20px);height:1px}
.apply-step-dot{width:28px;height:28px;border:1px solid #D5DBD7;border-radius:50%;font-size:14px;font-weight:700}
.apply-step.is-active .apply-step-dot{border-color:#EF3E3A}
.apply-step.is-done .apply-step-dot{border-color:#EF3E3A}
.apply-step-check{width:10px;height:6px;margin-top:-4px;border-bottom:1px solid #FFFFFF;border-left:1px solid #FFFFFF}
.apply-step-title{margin-top:7px;font-size:14px;font-weight:650;line-height:1.3}
.apply-step-copy{margin-top:2px;font-size:12px;line-height:1.35}
.apply-sk-dot{width:28px;height:28px}
.apply-sk-step{width:66px;margin-top:8px}
.apply-card{margin-top:10px;padding:16px;border:1px solid transparent;border-radius:18px}
.apply-card.is-active{border-color:rgba(239, 62, 58, .22)}
.apply-card-title{font-size:17px;font-weight:700;line-height:1.3}
.apply-card-copy{margin-top:7px;font-size:14px;line-height:1.6}
.apply-badge{padding:2px 9px;border-radius:599px;font-size:12px;font-weight:600}
.apply-sk-copy{width:88%;margin-top:10px}
.apply-sk-input{height:52px;margin-top:12px;border-radius:12px}
.apply-sk-button{height:50px;margin-top:16px;border-radius:599px}
.apply-field{margin-top:12px;padding:0 14px;border-radius:12px}
.apply-field-top{padding-top:12px;padding-bottom:12px}
.apply-field-label{width:90px;font-size:15px;font-weight:600}
.apply-field-top .apply-field-label{width:auto}
.apply-input{min-width:0;height:52px;font-size:16px}
.apply-textarea{width:100%;min-height:57px;margin-top:7px;font-size:15px;line-height:1.5}
.apply-error{margin-top:8px;font-size:13px;line-height:1.5}
.apply-privacy{margin-top:8px;font-size:12px;line-height:1.5}
.apply-primary{height:50px;margin-top:15px;border-radius:599px;font-size:16px;font-weight:700}
.apply-secondary{height:48px;margin-top:14px;border:1px solid #F3C4C6;border-radius:599px;font-size:15px;font-weight:650}
.apply-link{margin-top:13px;font-size:14px;font-weight:600}
.apply-notice{margin-top:15px;padding:15px 16px;border-radius:18px}
.apply-notice-icon{width:21px;height:21px;margin-right:7px;border-radius:50%;font-size:14px;font-weight:700;line-height:1}
.apply-notice-title{min-width:0;font-size:16px;font-weight:700}
.apply-notice-time{font-size:12px}
.apply-notice-copy{margin-top:6px;font-size:13px;line-height:1.6}
.apply-result{margin-top:15px;padding:24px 18px 19px;border-radius:18px}
.apply-result-mark{width:57px;height:57px;border-radius:50%;font-size:28px;font-weight:700}
.apply-result-check{width:22px;height:12px;margin-top:-6px;border-bottom:3px solid #FFFFFF;border-left:3px solid #FFFFFF}
.apply-result-clock{width:26px;height:26px;border:3px solid #EF3E3A;border-radius:50%}
.apply-result-clock::after{top:4px;left:9px;width:6px;height:7px;border-bottom:2px solid #EF3E3A;border-left:2px solid #EF3E3A}
.apply-result-title{margin-top:13px;font-size:19px;font-weight:700}
.apply-result-copy{margin-top:7px;font-size:14px;line-height:1.6}
.apply-result .apply-primary, .apply-result .apply-secondary{width:100%}
.apply-rows{width:100%;margin-top:14px}
.apply-row{min-height:43px;border-bottom:0.5px solid #F2F4F2}
.apply-row:last-child{border-bottom:0}
.apply-row-label{font-size:15px}
.apply-row-value{min-width:0;margin-left:12px;font-size:15px;font-weight:600;line-height:1.4}
.apply-role-label{width:auto;margin-top:14px}
.apply-roles{gap:9px;margin-top:9px}
.apply-role{padding:13px 14px;border:1px solid #ECEFEC;border-radius:14px}
.apply-role.is-picked{border-color:#EF3E3A}
.apply-role-name{font-size:16px;font-weight:700}
.apply-role-check{width:22px;height:22px;border:1px solid #D3D9D4;border-radius:50%}
.apply-role.is-picked .apply-role-check{border-color:#EF3E3A}
.apply-role-line{margin-top:7px;font-size:13px;line-height:1.6}
.apply-role-tag{margin-right:6px;padding:1px 6px;border-radius:4px;font-size:12px}
}
