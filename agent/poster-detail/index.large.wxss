/* 自动生成，请勿手改：index.wxss 在平板、电脑大屏（窗口宽 ≥ 450px）下的样式。
   rpx 按 1rpx = 0.6px 换算，固定定位元素收进居中栏；改完源文件后运行 node scripts/build-large-screen-styles.mjs */
@media (min-width: 450px) {
.sk{border-radius:7px}
.sk-line{height:16px}
.sk-line + .sk-line{margin-top:8px}
.sk-short{width:40%}
.sk-mid{width:64%}
.sk-round{border-radius:50%}
.sk-card{height:96px;border-radius:14px}
.sk-card + .sk-card{margin-top:12px}
.poster-detail-page{height:100vh}
.poster-detail-topbar{top:0;right:max(0px, 50% - var(--lg-col) / 2);left:max(0px, 50% - var(--lg-col) / 2);box-sizing:border-box}
.poster-detail-topbar-inner{box-sizing:content-box;padding:0 21px 4px}
.poster-detail-back{flex:0 0 auto;width:26px;height:26px;margin-right:6px}
.poster-detail-back-icon{width:12px;height:12px;border-bottom:1px solid #24332D;border-left:1px solid #24332D;transform:rotate(45deg) scale(.72)}
.poster-detail-topbar-title{left:50%;font-size:21px;font-weight:700;letter-spacing:-1px;transform:translateX(-50%)}
.poster-detail-state{padding-right:21px;padding-left:21px}
.poster-detail-sk-wrap{flex-direction:column}
.poster-detail-sk-poster{max-width:100%;border-radius:16px}
.poster-detail-sk-copy{width:100%;margin-top:24px}
.poster-detail-sk-title{height:20px;margin-bottom:13px}
.poster-detail-state-title{margin-top:72px;font-size:19px;font-weight:600}
.poster-detail-state-copy{margin:13px 0 19px;font-size:15px;line-height:1.6}
.poster-detail-state-action{height:45px;padding:0 26px;border-radius:12px;font-size:15px}
.poster-detail-invite{flex-direction:column;box-sizing:border-box;padding:96px 33px 0}
.poster-detail-invite-icon{width:86px;height:86px;border-radius:21px}
.poster-detail-invite-icon image{width:100%;height:100%}
.poster-detail-invite-title{margin-top:24px;font-size:21px;font-weight:700}
.poster-detail-invite-copy{margin-top:12px;font-size:15px;line-height:1.7}
.poster-detail-stage{top:0;right:0;bottom:0;left:0;box-sizing:border-box}
.poster-detail-preview{flex:0 0 auto;border-radius:16px;font-size:12px;letter-spacing:1px;max-width:calc(100% - 43px);max-height:100%}
.poster-detail-image, .poster-detail-placeholder{width:100%;height:100%}
.poster-detail-preview-copy{top:50%;left:50%;font-size:12px;letter-spacing:1px;transform:translate(-50%, -50%)}
.poster-detail-sheet{top:0;right:0;bottom:0;left:0;padding:0 19px;box-sizing:border-box;border-radius:26px 26px 0 0;box-shadow:0 -8px 22px rgba(36, 51, 45, .10)}
.poster-detail-sheet-handle{height:32px}
.poster-detail-sheet-handle view{width:44px;height:4px;border-radius:599px}
.poster-detail-sheet-summary{min-height:49px}
.poster-detail-sheet-summary-copy{min-width:0;flex-direction:column;padding-right:10px}
.poster-detail-sheet-title{font-size:18px;font-weight:700;line-height:1.35;-webkit-box-orient:vertical;-webkit-line-clamp:3}
.poster-detail-sheet-meta{min-width:0;flex-direction:column;gap:6px;margin-top:15px}
.poster-detail-sheet-meta-row{min-width:0}
.poster-detail-sheet-meta-icon{flex:0 0 auto;width:20px;height:20px;margin-right:7px}
.poster-detail-sheet-meta-item{min-width:0;font-size:12px;line-height:1.3}
.poster-detail-sheet-content{padding-bottom:79px}
.poster-detail-ended-note{height:44px;margin-top:12px;border-radius:599px;font-size:13px}
.poster-detail-notices{margin-top:12px}
.poster-detail-notice-item{flex-direction:column}
.poster-detail-notice-item + .poster-detail-notice-item{margin-top:12px}
.poster-detail-notice-title{font-size:12px;font-weight:700;line-height:1.3}
.poster-detail-notice-copy{margin-top:3px;font-size:10px;line-height:1.5}
.poster-detail-notice-action{height:31px;margin-top:8px;padding:0 14px;border:0.5px solid #E1E6E1;border-radius:599px;font-size:12px}
.poster-detail-actionbar{right:0;bottom:0;left:0;min-height:64px;padding:8px 19px calc(9px + env(safe-area-inset-bottom));box-sizing:border-box;border-top:0.5px solid #E9EDE9}
.poster-detail-actionbar-actions{gap:14px}
.poster-detail-promote-button{min-width:0;flex:1;height:46px;border-radius:599px;font-size:16px;font-weight:700;letter-spacing:0.5px}
.poster-detail-share-action{width:92px;height:46px;flex:0 0 auto;flex-direction:column;font-size:10px;line-height:1.2}
.poster-detail-actionbar-icon{width:28px;height:28px;margin-bottom:3px}
.poster-detail-native-share{top:0;right:0;bottom:14px;left:0;padding:0;border:0}
.promotion-share-mask{top:0;right:max(0px, 50% - var(--lg-col) / 2);bottom:0;left:max(0px, 50% - var(--lg-col) / 2);box-shadow:0 0 0 100vmax rgba(25, 31, 28, .72)}
.promotion-share-poster-stage{top:0;right:0;bottom:219px;left:0;padding:calc(25px + env(safe-area-inset-top)) 16px 12px;box-sizing:border-box}
.promotion-share-mask.has-promotion-code .promotion-share-poster-stage{bottom:324px}
.promotion-share-poster-card{flex:0 0 auto;border-radius:15px}
.promotion-share-poster-image, .promotion-share-poster-placeholder{width:100%;height:100%}
.promotion-share-sheet{right:0;bottom:0;left:0;padding:14px 22px calc(21px + env(safe-area-inset-bottom));box-sizing:border-box;border-radius:20px 20px 0 0}
.promotion-share-sheet-header{height:30px}
.promotion-share-sheet-title{font-size:15px;font-weight:750;line-height:1.2}
.promotion-share-sheet-note{margin-top:14px;font-size:11px}
.promotion-share-code-float{right:22px;bottom:calc(277px + env(safe-area-inset-bottom));left:22px;padding:13px 13px 12px;box-sizing:border-box;border:0.5px solid #EEF1EE;border-radius:19px}
.promotion-share-code-title{font-size:12px;font-weight:700;line-height:1.3}
.promotion-share-code-row{margin-top:5px}
.promotion-share-code-value{font-size:18px;font-weight:700;letter-spacing:0.5px;line-height:1.2}
.promotion-share-code-copy{width:28px;height:28px;flex:0 0 auto;margin-left:12px;border-radius:50%}
.promotion-share-code-copy-icon{width:14px;height:14px;border:1px solid #6F7C73;border-radius:3px;box-sizing:border-box}
.promotion-share-code-copy-icon::before{top:-5px;left:-5px;width:14px;height:14px;border:1px solid #6F7C73;border-radius:3px;box-sizing:border-box}
.promotion-share-code-copy.is-copied .promotion-share-code-copy-icon{width:16px;height:9px;border:0;border-bottom:2px solid #6F7C73;border-left:2px solid #6F7C73;border-radius:0;transform:translateY(-2px) rotate(-45deg)}
.promotion-share-actions{gap:15px;margin:14px auto 0}
.promotion-share-action{flex:0 0 76px;flex-direction:column;font-size:13px;line-height:1.2}
.promotion-share-action-icon{width:48px;height:48px;margin-bottom:9px;border-radius:50%}
.promotion-share-action-icon image{width:72%;height:72%}
.promotion-share-link-glyph{width:33px;height:33px;transform:rotate(-45deg)}
.promotion-share-link-glyph::before, .promotion-share-link-glyph::after{top:10px;width:18px;height:12px;box-sizing:border-box;border:3px solid #7E8981;border-radius:6px}
.promotion-share-link-glyph::before{left:0.5px}
.promotion-share-link-glyph::after{right:0.5px}
.promotion-share-action-friend .promotion-share-action-icon image{width:100%;height:100%}
.promotion-share-native-button{top:0;right:0;bottom:12px;left:0;padding:0;border:0}
.promotion-share-sheet-cancel{height:32px;margin-top:24px;font-size:14px;line-height:32px}
.promotion-share-canvas{top:0;left:calc(max(0px, 50% - var(--lg-col) / 2) + -9999px);width:1px;height:1px}
.promotion-share-qr-pending{right:14px;bottom:14px;max-width:70%;padding:6px 10px;border-radius:599px;font-size:12px;line-height:1.3}
}
