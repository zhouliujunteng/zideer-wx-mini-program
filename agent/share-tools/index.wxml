<view class="share-tools-page">
  <view class="share-tools-ambient" aria-hidden="true"><view class="share-tools-ambient-ribbon"><view class="share-tools-ambient-ribbon-inner"></view></view></view>
  <view class="share-tools-topbar">
    <view class="share-tools-topbar-inner" style="height: {{navigationBarHeight}}px; padding-top: {{statusBarHeight}}px;">
      <view class="share-tools-back" bindtap="handleBack" aria-label="返回推广伙伴" aria-role="button">
        <view class="share-tools-back-icon"></view>
      </view>
      <text class="share-tools-topbar-title" style="top: {{statusBarHeight}}px; height: {{navigationBarHeight}}px; line-height: {{navigationBarHeight}}px;">{{title}}</text>
    </view>
  </view>

  <scroll-view class="share-tools-scroll" scroll-y enhanced="{{true}}" show-scrollbar="{{false}}" style="padding-top: {{contentTop}}px;">
    <view class="share-tools-content">
      <!-- 首次读到邀请码前：卡片标题照常显示，邀请码、小程序码与提示位只放骨架 -->
      <view class="share-tools-card" wx:if="{{loadState === 'loading'}}" aria-label="正在读取邀请码">
        <text class="share-tools-card-label">我的邀请码</text>
        <view class="sk share-tools-sk-code"></view>
        <view class="sk share-tools-sk-qr"></view>
        <view class="sk sk-line share-tools-sk-hint"></view>
      </view>

      <view class="share-tools-state" wx:elif="{{loadState === 'failed'}}">
        <text class="share-tools-state-title">邀请码暂时无法加载</text>
        <text class="share-tools-state-copy">{{loadError}}</text>
        <view class="share-tools-state-action" bindtap="loadPage" aria-role="button">重新加载</view>
      </view>

      <view class="share-tools-card" wx:else>
        <text class="share-tools-card-label">我的邀请码</text>
        <view class="share-tools-code-row" bindtap="copyCode" aria-role="button" aria-label="复制我的邀请码">
          <text class="share-tools-code {{code ? '' : 'is-empty'}}">{{code || '暂不可用'}}</text>
          <text wx:if="{{code}}" class="share-tools-copy">复制</text>
        </view>
        <image wx:if="{{qrUrl}}" class="share-tools-qr" src="{{qrUrl}}" mode="aspectFit" bindtap="previewQr" aria-label="我的小程序码，点击放大"></image>
        <view wx:else class="share-tools-qr is-placeholder" aria-hidden="true"></view>
        <text class="share-tools-qr-hint">{{qrUrl ? '点开小程序码可放大保存' : '小程序码稍后可用，请下拉刷新重试'}}</text>
      </view>

      <!-- 小程序链接教程：固定内容，读邀请码时照常显示 -->
      <view wx:if="{{loadState !== 'failed'}}" class="share-tools-link-card">
        <view class="share-tools-link-head">
          <text class="share-tools-card-label">小程序链接</text>
          <text class="share-tools-link-badge">图文教程</text>
        </view>
        <text class="share-tools-link-copy">复制一条带你邀请码的蓝色链接，发给好友、微信群或贴进朋友圈，好友一点就能打开知鹿学习。</text>
        <view class="share-tools-link-sample" aria-hidden="true">
          <view class="share-tools-link-glyph"></view>
          <text>#小程序://知鹿学习/…</text>
        </view>
        <view class="share-tools-link-steps">
          <view class="share-tools-link-step"><text class="share-tools-link-step-no">1</text><text>点右上角「···」</text></view>
          <view class="share-tools-link-step"><text class="share-tools-link-step-no">2</text><text>选「复制链接」</text></view>
          <view class="share-tools-link-step"><text class="share-tools-link-step-no">3</text><text>粘贴发出去</text></view>
        </view>
        <view class="share-tools-link-action" bindtap="openShareLink" aria-role="button">去复制链接</view>
      </view>
    </view>
  </scroll-view>
</view>
<dev-reset-fab />
