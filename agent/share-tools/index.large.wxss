/* 自动生成，请勿手改：index.wxss 在平板、电脑大屏（窗口宽 ≥ 450px）下的样式。
   rpx 按 1rpx = 0.6px 换算，固定定位元素收进居中栏；改完源文件后运行 node scripts/build-large-screen-styles.mjs */
@media (min-width: 450px) {
.sk{border-radius:7px}
.sk-line{height:16px}
.sk-line + .sk-line{margin-top:8px}
.sk-short{width:40%}
.sk-mid{width:64%}
.sk-round{border-radius:50%}
.sk-card{height:96px;border-radius:14px}
.sk-card + .sk-card{margin-top:12px}
.share-tools-page{height:100vh}
.share-tools-ambient{top:0;left:max(0px, 50% - var(--lg-col) / 2);width:min(100%, var(--lg-col));height:100%}
.share-tools-ambient-ribbon{top:-84px;left:-258px;width:888px;height:432px;box-sizing:border-box;border:14px solid rgba(255, 255, 255, .72);border-top-color:transparent;border-right-color:transparent;border-radius:50%}
.share-tools-ambient-ribbon-inner{top:22px;right:22px;bottom:22px;left:22px;box-sizing:border-box;border:6px solid rgba(255, 255, 255, .38);border-top-color:transparent;border-right-color:transparent;border-radius:50%}
.share-tools-topbar{top:0;right:max(0px, 50% - var(--lg-col) / 2);left:max(0px, 50% - var(--lg-col) / 2);box-sizing:border-box}
.share-tools-topbar-inner{box-sizing:content-box;padding:0 21px 4px}
.share-tools-back{width:26px;height:26px}
.share-tools-back-icon{width:12px;height:12px;border-bottom:1px solid #24332D;border-left:1px solid #24332D}
.share-tools-topbar-title{left:50%;font-size:21px;font-weight:700;letter-spacing:-1px}
.share-tools-scroll{top:0;right:0;bottom:0;left:0;box-sizing:border-box}
.share-tools-content{min-height:100%;padding:14px 21px calc(48px + env(safe-area-inset-bottom));box-sizing:border-box}
.share-tools-sk-code{width:168px;height:34px;margin-top:10px}
.share-tools-sk-qr{width:216px;height:216px;margin-top:24px;border-radius:14px}
.share-tools-sk-hint{width:192px;height:13px;margin-top:14px}
.share-tools-state{padding:54px 14px 24px}
.share-tools-state-title{font-size:19px;font-weight:600}
.share-tools-state-copy{margin:13px 0 19px;font-size:15px;line-height:1.6}
.share-tools-state-action{height:45px;padding:0 26px;border-radius:12px;font-size:15px}
.share-tools-card{padding:28px 21px 26px;border-radius:21px;box-shadow:0 4px 18px rgba(56, 75, 64, .04)}
.share-tools-card-label{font-size:15px;font-weight:600;line-height:1.3}
.share-tools-code-row{max-width:100%;gap:9px;margin-top:10px}
.share-tools-code{min-width:0;font-size:28px;font-weight:700;letter-spacing:2px}
.share-tools-code.is-empty{font-size:18px;font-weight:400;letter-spacing:0}
.share-tools-copy{padding:4px 13px;border-radius:599px;font-size:13px}
.share-tools-qr{width:216px;height:216px;margin-top:24px;border-radius:14px}
.share-tools-qr.is-placeholder{border:1px dashed #E2E7E3}
.share-tools-qr-hint{margin-top:14px;font-size:12px;line-height:1.5}
.share-tools-link-card{margin-top:14px;padding:21px 21px 20px;border-radius:21px;box-shadow:0 4px 18px rgba(56, 75, 64, .04)}
.share-tools-link-badge{padding:2px 9px;border-radius:599px;font-size:12px;line-height:1.5}
.share-tools-link-copy{margin-top:8px;font-size:14px;line-height:1.65}
.share-tools-link-sample{gap:6px;margin-top:12px;padding:9px 12px;border-radius:9px;font-size:15px;line-height:1.3}
.share-tools-link-glyph{width:20px;height:20px}
.share-tools-link-glyph::before, .share-tools-link-glyph::after{top:6px;width:11px;height:8px;box-sizing:border-box;border:2px solid #576B95;border-radius:4px}
.share-tools-link-glyph::before{left:0.5px}
.share-tools-link-glyph::after{right:0.5px}
.share-tools-link-steps{gap:7px;margin-top:13px}
.share-tools-link-step{min-width:0;gap:6px;padding:10px 4px;border-radius:10px;font-size:12px;line-height:1.35}
.share-tools-link-step-no{width:21px;height:21px;border-radius:50%;font-size:12px;font-weight:700;line-height:1}
.share-tools-link-action{height:50px;margin-top:15px;border-radius:13px;font-size:16px;font-weight:600}
}
