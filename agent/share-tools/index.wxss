/* 推广工具：只展示「我的邀请码」。页面外壳（底纹、顶栏、滚动区）与「我的推广」同一套，
   从推广伙伴页进来视觉连续。 */
@import "../../styles/skeleton.wxss";

page { background: #FAFAFA; }

.share-tools-page { position: relative; height: 100vh; overflow: hidden; background: #FAFAFA; color: #24332D; }
.share-tools-ambient { position: fixed; top: 0; left: 0; z-index: 0; width: 100%; height: 100%; overflow: hidden; pointer-events: none; background: radial-gradient(125% 52% at 100% 0, rgba(255, 205, 194, .84) 0%, rgba(255, 230, 224, .5) 40%, rgba(250, 250, 250, 0) 76%), #FAFAFA; }
.share-tools-ambient-ribbon { position: absolute; top: -140rpx; left: -430rpx; width: 1480rpx; height: 720rpx; box-sizing: border-box; border: 24rpx solid rgba(255, 255, 255, .72); border-top-color: transparent; border-right-color: transparent; border-radius: 50%; opacity: .84; transform: rotate(-18deg); }
.share-tools-ambient-ribbon-inner { position: absolute; top: 38rpx; right: 38rpx; bottom: 38rpx; left: 38rpx; box-sizing: border-box; border: 10rpx solid rgba(255, 255, 255, .38); border-top-color: transparent; border-right-color: transparent; border-radius: 50%; }
.share-tools-topbar { position: fixed; top: 0; right: 0; left: 0; z-index: 20; box-sizing: border-box; background: transparent; }
.share-tools-topbar-inner { position: relative; display: flex; align-items: center; box-sizing: content-box; padding: 0 36rpx 8rpx; }
.share-tools-back { display: flex; width: 44rpx; height: 44rpx; align-items: center; justify-content: center; }
.share-tools-back:active { opacity: .65; }
.share-tools-back-icon { width: 20rpx; height: 20rpx; border-bottom: 3rpx solid #24332D; border-left: 3rpx solid #24332D; transform: rotate(45deg) scale(.72); }
.share-tools-topbar-title { position: absolute; left: 50%; display: block; color: #24332D; font-size: 36rpx; font-weight: 700; letter-spacing: -1rpx; transform: translateX(-50%); white-space: nowrap; }
.share-tools-scroll { position: absolute; top: 0; right: 0; bottom: 0; left: 0; z-index: 1; box-sizing: border-box; background: transparent; }
.share-tools-content { min-height: 100%; padding: 24rpx 36rpx calc(80rpx + env(safe-area-inset-bottom)); box-sizing: border-box; }

.share-tools-sk-code { width: 280rpx; height: 58rpx; margin-top: 18rpx; }
.share-tools-sk-qr { width: 360rpx; height: 360rpx; margin-top: 40rpx; border-radius: 24rpx; }
.share-tools-sk-hint { width: 320rpx; height: 22rpx; margin-top: 24rpx; }
.share-tools-state { padding: 90rpx 24rpx 40rpx; text-align: center; }
.share-tools-state-title { display: block; color: #24332D; font-size: 32rpx; font-weight: 600; }
.share-tools-state-copy { display: block; margin: 22rpx 0 32rpx; color: #7D877F; font-size: 25rpx; line-height: 1.6; }
.share-tools-state-action { display: inline-flex; height: 76rpx; align-items: center; padding: 0 44rpx; border-radius: 20rpx; background: #FD7C02; color: #FFFFFF; font-size: 26rpx; }
.share-tools-state-action:active { opacity: .78; }

.share-tools-card { display: flex; flex-direction: column; align-items: center; padding: 48rpx 36rpx 44rpx; border-radius: 36rpx; background: #FFFFFF; box-shadow: 0 8rpx 30rpx rgba(56, 75, 64, .04); }
.share-tools-card-label { color: #3B4941; font-size: 26rpx; font-weight: 600; line-height: 1.3; }
.share-tools-code-row { display: flex; max-width: 100%; align-items: center; gap: 16rpx; margin-top: 18rpx; }
.share-tools-code-row:active { opacity: .6; }
.share-tools-code { min-width: 0; overflow: hidden; color: #24332D; font-size: 48rpx; font-weight: 700; letter-spacing: 4rpx; text-overflow: ellipsis; white-space: nowrap; }
.share-tools-code.is-empty { color: #B8C0B9; font-size: 30rpx; font-weight: 400; letter-spacing: 0; }
.share-tools-copy { flex: 0 0 auto; padding: 8rpx 22rpx; border-radius: 999rpx; background: #FFF1E3; color: #C25A02; font-size: 22rpx; }
.share-tools-qr { width: 360rpx; height: 360rpx; margin-top: 40rpx; border-radius: 24rpx; background: #FFFFFF; }
.share-tools-qr.is-placeholder { border: 2rpx dashed #E2E7E3; }
.share-tools-qr-hint { margin-top: 24rpx; color: #99A39C; font-size: 21rpx; line-height: 1.5; }

/* 小程序链接教程卡片：点「去复制链接」进小程序链接页，完整图文步骤在那一页 */
.share-tools-link-card { margin-top: 24rpx; padding: 36rpx 36rpx 34rpx; border-radius: 36rpx; background: #FFFFFF; box-shadow: 0 8rpx 30rpx rgba(56, 75, 64, .04); }
.share-tools-link-head { display: flex; align-items: center; justify-content: space-between; }
.share-tools-link-badge { padding: 4rpx 16rpx; border-radius: 999rpx; background: #FFF1E3; color: #C25A02; font-size: 20rpx; line-height: 1.5; }
.share-tools-link-copy { display: block; margin-top: 14rpx; color: #6B766F; font-size: 24rpx; line-height: 1.65; }
.share-tools-link-sample { display: flex; align-items: center; gap: 10rpx; margin-top: 20rpx; padding: 16rpx 20rpx; border-radius: 16rpx; background: #F3F5F8; color: #576B95; font-size: 25rpx; line-height: 1.3; }
.share-tools-link-glyph { position: relative; flex: 0 0 auto; width: 34rpx; height: 34rpx; transform: rotate(-45deg); }
.share-tools-link-glyph::before, .share-tools-link-glyph::after { position: absolute; top: 10rpx; width: 19rpx; height: 14rpx; box-sizing: border-box; border: 4rpx solid #576B95; border-radius: 7rpx; content: ''; }
.share-tools-link-glyph::before { left: 1rpx; }
.share-tools-link-glyph::after { right: 1rpx; }
.share-tools-link-steps { display: flex; gap: 12rpx; margin-top: 22rpx; }
.share-tools-link-step { display: flex; min-width: 0; flex: 1; flex-direction: column; align-items: center; gap: 10rpx; padding: 18rpx 8rpx; border-radius: 18rpx; background: #FAFAF8; color: #3B4941; font-size: 21rpx; line-height: 1.35; text-align: center; }
.share-tools-link-step-no { display: flex; width: 36rpx; height: 36rpx; align-items: center; justify-content: center; border-radius: 50%; background: #FD7C02; color: #FFFFFF; font-size: 20rpx; font-weight: 700; line-height: 1; }
.share-tools-link-action { display: flex; height: 84rpx; align-items: center; justify-content: center; margin-top: 26rpx; border-radius: 22rpx; background: #FD7C02; color: #FFFFFF; font-size: 28rpx; font-weight: 600; }
.share-tools-link-action:active { opacity: .82; }

@import "./index.large.wxss"; /* 平板、电脑大屏样式：由 scripts/build-large-screen-styles.mjs 生成，改完本文件后重跑；这一行须留在文件末尾 */
