/* 自动生成，请勿手改：index.wxss 在平板、电脑大屏（窗口宽 ≥ 450px）下的样式。
   rpx 按 1rpx = 0.6px 换算，固定定位元素收进居中栏；改完源文件后运行 node scripts/build-large-screen-styles.mjs */
@media (min-width: 450px) {
.sk{border-radius:7px}
.sk-line{height:16px}
.sk-line + .sk-line{margin-top:8px}
.sk-short{width:40%}
.sk-mid{width:64%}
.sk-round{border-radius:50%}
.sk-card{height:96px;border-radius:14px}
.sk-card + .sk-card{margin-top:12px}
.applications-page{height:100vh}
.applications-topbar{top:0;right:max(0px, 50% - var(--lg-col) / 2);left:max(0px, 50% - var(--lg-col) / 2)}
.applications-topbar-inner{padding:0 21px 4px}
.applications-back{width:26px;height:26px}
.applications-back-icon{width:12px;height:12px;border-bottom:1px solid #24332D;border-left:1px solid #24332D}
.applications-topbar-title{left:50%;font-size:21px;font-weight:700;letter-spacing:-1px}
.applications-shell{min-height:100%;padding:0 19px 19px}
.applications-state{padding:72px 14px 24px}
.applications-state-title{font-size:19px;font-weight:600}
.applications-state-copy{margin:13px 0 19px;font-size:15px;line-height:1.6}
.applications-state-action{height:45px;padding:0 26px;border-radius:12px;font-size:15px}
.applications-module{margin-top:12px;border-radius:24px}
.applications-tabs{width:100%;height:45px;border-radius:15px 15px 0 0}
.applications-tab{height:45px;font-size:13px;line-height:1}
.applications-tab.is-selected{border-radius:15px 15px 0 0;font-weight:650}
.applications-tab.is-selected::before, .applications-tab.is-selected::after{bottom:0;width:19px;height:19px}
.applications-tab.is-selected::before{left:-20px}
.applications-tab.is-selected::after{right:-20px}
.applications-sk-card, .applications-list-card{padding:4px 14px;border-radius:0 0 24px 24px}
.applications-sk-date{height:10px}
.applications-sk-amount{width:66px;height:16px;margin-left:9px}
.applications-item{min-height:87px}
.applications-item-copy{min-width:0;padding:18px 0 14px;border-bottom:1px solid #F0F3F0}
.applications-item:last-child .applications-item-copy{border-bottom:0}
.applications-item-left{min-width:0}
.applications-item-title{font-size:15px;font-weight:600;line-height:1.2}
.applications-status{margin-left:7px;padding:2px 7px;border-radius:599px;font-size:11px;line-height:1.3}
.applications-item-meta{margin-top:7px;font-size:11px;line-height:1.2}
.applications-item-right{margin-left:9px}
.applications-item-amount{font-size:16px;font-weight:650;line-height:1.1}
.applications-item-sub{margin-top:6px;font-size:11px;line-height:1.2}
.applications-arrow{width:7px;height:7px;margin-left:8px;border-top:1px solid #B6BFB9;border-right:1px solid #B6BFB9}
.applications-empty{min-height:192px;padding:18px 12px}
.applications-empty text:first-child{font-size:15px;font-weight:650}
.applications-empty text:nth-child(2){margin-top:7px;font-size:12px;line-height:1.5}
.applications-empty-action{margin-top:15px;padding:9px 28px;border-radius:599px;font-size:14px;font-weight:650}
}
