/* 自动生成，请勿手改：index.wxss 在平板、电脑大屏（窗口宽 ≥ 450px）下的样式。
   rpx 按 1rpx = 0.6px 换算，固定定位元素收进居中栏；改完源文件后运行 node scripts/build-large-screen-styles.mjs */
@media (min-width: 450px) {
.sk{border-radius:7px;background:linear-gradient(90deg, #ECEEEB 25%, #F5F6F4 37%, #ECEEEB 63%);background-size:400% 100%}
.sk-line{height:16px}
.sk-line + .sk-line{margin-top:8px}
.sk-short{width:40%}
.sk-mid{width:64%}
.sk-round{border-radius:50%}
.sk-card{height:96px;border-radius:14px}
.sk-card + .sk-card{margin-top:12px}
page{background:#FAFAFA}
.withdraw-page{height:100vh;background:#FAFAFA}
.withdraw-topbar{top:0;right:max(0px, 50% - var(--lg-col) / 2);left:max(0px, 50% - var(--lg-col) / 2);box-sizing:border-box;background:transparent}
.withdraw-topbar-surface{top:0;right:0;bottom:0;left:0;background:#FAFAFA}
.withdraw-topbar-inner{box-sizing:content-box;padding:0 21px 4px}
.withdraw-back{width:26px;height:26px}
.withdraw-back-icon{width:12px;height:12px;border-bottom:1px solid #FFFFFF;border-left:1px solid #FFFFFF}
.withdraw-back-icon-dark{border-color:#24332D}
.withdraw-topbar-title{left:50%;font-size:21px;font-weight:700;letter-spacing:-1px}
.withdraw-scroll{top:0;right:0;bottom:0;left:0;box-sizing:border-box;background:#FAFAFA}
.withdraw-shell{min-height:100%;padding:0 19px calc(43px + env(safe-area-inset-bottom));box-sizing:border-box;background:linear-gradient(180deg, #F14677 0%, #EF3E3A 48%, #F5A4A7 68%, #FBE4DF 79%, #FAFAFA 88%, #FAFAFA 100%);background-repeat:no-repeat;background-size:100% 288px}
.withdraw-ambient-icon{top:-16px;right:-48px;width:234px;height:234px}
.withdraw-state{padding:54px 14px 24px}
.withdraw-state-title{font-size:19px;font-weight:600}
.withdraw-state-copy{margin:13px 0 19px;font-size:15px;line-height:1.6}
.withdraw-state-action{height:45px;padding:0 26px;border-radius:12px;background:#FD7C02;font-size:15px}
.withdraw-hero{padding:15px 18px 14px;border-radius:16px;background:#FFFFFF}
.withdraw-hero-label{font-size:13px;font-weight:600}
.withdraw-hero-value{margin-top:8px;font-size:33px;font-weight:700;letter-spacing:-1px;line-height:1}
.withdraw-hero-metrics{margin-top:14px;padding-top:12px;border-top:0.5px solid #F0F2F0}
.withdraw-hero-metric{min-width:0}
.withdraw-hero-metric + .withdraw-hero-metric{padding-left:9px;border-left:0.5px solid #EDF0ED}
.withdraw-hero-metric-label{font-size:12px;font-weight:600;line-height:1.2}
.withdraw-hero-metric-value{margin-top:5px;font-size:16px;font-weight:700;line-height:1}
.withdraw-hero-hint{margin-top:10px;font-size:12px;line-height:1.4}
.withdraw-sk-hero{width:132px;height:33px;margin-top:8px}
.withdraw-sk-metric{width:54px;height:16px;margin-top:5px}
.withdraw-sk-tab{width:90px;height:14px}
.withdraw-sk-value{width:132px}
.withdraw-sk-block{height:96px;margin-top:12px;border-radius:12px}
.withdraw-sk-service{width:144px;height:12px;margin-top:4px}
.withdraw-tabs{height:48px;margin-top:13px;padding:3px;box-sizing:border-box;border-radius:599px;background:#EEF1EF}
.withdraw-tab{border-radius:599px;font-size:15px;font-weight:600}
.withdraw-tab.is-selected{background:#FFFFFF;box-shadow:0 2px 8px rgba(72, 82, 75, .08)}
.withdraw-card{margin-top:10px;padding:15px 16px;box-sizing:border-box;border-radius:18px;background:#FFFFFF}
.withdraw-card-head{margin-bottom:3px}
.withdraw-card-title{font-size:16px;font-weight:700;line-height:1.3}
.withdraw-card-tip{font-size:12px}
.withdraw-card-note{margin-top:10px;font-size:12px;line-height:1.6}
.withdraw-card-note-top{margin-top:3px}
.withdraw-row{min-height:43px;border-bottom:0.5px solid #F2F4F2}
.withdraw-row:last-child{border-bottom:0}
.withdraw-row-top{min-height:0;padding:12px 0}
.withdraw-row-left{min-width:0}
.withdraw-row-label{font-size:15px;line-height:1.3}
.withdraw-row-note{margin-top:3px;font-size:12px;line-height:1.4}
.withdraw-row-value{min-width:0;margin-left:12px;font-size:15px;font-weight:600;line-height:1.4}
.withdraw-net-row{margin-top:4px;padding-top:12px;border-top:0.5px dashed #E7EBE8}
.withdraw-net-label{font-size:15px;font-weight:650}
.withdraw-net-value{font-size:24px;font-weight:700;letter-spacing:-1px}
.withdraw-badge{padding:2px 8px;border-radius:599px;background:#F1F4F2;font-size:12px}
.withdraw-badge.is-required{background:#FFF0EE}
.withdraw-files{margin:7px -5px 0}
.withdraw-file{width:calc((100% - 28px) / 3);height:108px;margin:4px;box-sizing:border-box}
.withdraw-file-body{width:100%;height:100%;border-radius:12px;background:#F5F7F5}
.withdraw-file-image{width:100%;height:100%}
.withdraw-file-pdf{height:100%;padding:9px;box-sizing:border-box}
.withdraw-file-pdf-badge{padding:3px 8px;border-radius:6px;background:#E6414C;font-size:13px;font-weight:700}
.withdraw-file-name{margin-top:7px;font-size:11px;line-height:1.35;-webkit-box-orient:vertical;-webkit-line-clamp:2}
.withdraw-file-mask{top:0;right:0;bottom:0;left:0;border-radius:12px;background:rgba(36, 51, 45, .45);font-size:13px}
.withdraw-file-remove{top:-6px;right:-6px;width:24px;height:24px;border-radius:50%;background:rgba(36, 51, 45, .72);font-size:16px;line-height:1}
.withdraw-file-add{border:1px dashed #D5DBD7;border-radius:12px}
.withdraw-file-add-plus{font-size:28px;line-height:1}
.withdraw-file-add-label{margin-top:4px;font-size:12px}
.withdraw-agreement{padding-bottom:12px;border-bottom:0.5px solid #F2F4F2}
.withdraw-agreement-icon, .withdraw-entry-icon{width:38px;height:38px;border-radius:10px;background:#FFF0EE}
.withdraw-agreement-icon image, .withdraw-entry-icon image{width:21px;height:21px}
.withdraw-entry-icon-service{background:#FFF1E5}
.withdraw-agreement-copy, .withdraw-entry-copy{min-width:0;margin-left:10px}
.withdraw-agreement-title, .withdraw-entry-title{font-size:16px;font-weight:650;line-height:1.3}
.withdraw-agreement-meta, .withdraw-entry-meta{margin-top:4px;font-size:12px;line-height:1.35}
.withdraw-agreement-read{margin-left:7px;padding:4px 12px;border-radius:599px;background:#FFF0EE;font-size:13px;font-weight:600}
.withdraw-agree{padding-top:12px}
.withdraw-check{width:19px;height:19px;margin:2px 8px 0 0;box-sizing:border-box;border:1px solid #C5CDC8;border-radius:50%}
.withdraw-check.is-checked{border-color:#E6414C;background:#E6414C}
.withdraw-check.is-checked::after{top:3px;left:6px;width:4px;height:7px;border-right:1px solid #FFFFFF;border-bottom:1px solid #FFFFFF}
.withdraw-agree-copy{font-size:13px;line-height:1.55}
.withdraw-notice-card{margin-top:10px;padding:18px 16px;box-sizing:border-box;border-radius:18px;background:#FFFFFF}
.withdraw-notice-icon{width:21px;height:21px;margin-right:7px;border-radius:50%;background:#F5A53D;font-size:14px;font-weight:700;line-height:1}
.withdraw-notice-title{font-size:17px;font-weight:700;line-height:1.3}
.withdraw-notice-copy{margin-top:8px;font-size:14px;line-height:1.65}
.withdraw-link{margin-top:13px;font-size:14px;font-weight:600}
.withdraw-credits-card{padding-top:18px}
.withdraw-credits-value{margin-top:9px;font-size:38px;font-weight:700;letter-spacing:-1px;line-height:1}
.withdraw-credits-unit{margin-left:6px;font-size:15px;font-weight:650;letter-spacing:0}
.withdraw-credits-rate{margin-top:8px;font-size:13px}
.withdraw-rules{margin-top:12px;padding-top:9px;border-top:0.5px solid #F2F4F2}
.withdraw-rule{margin-top:6px;font-size:13px;line-height:1.6}
.withdraw-rule-dot{width:6px;height:6px;margin:8px 8px 0 1px;border-radius:50%;background:#FD7C02}
.withdraw-primary{height:50px;margin-top:15px;border-radius:599px;background:linear-gradient(90deg, #F14677, #EF3E3A);font-size:16px;font-weight:700}
.withdraw-primary.is-disabled{background:#E3E7E4}
.withdraw-submit-hint{margin-top:8px;font-size:12px}
.withdraw-pending{margin-top:10px;padding:12px 14px;border-radius:13px;background:#FFF8EC;font-size:13px;line-height:1.5}
.withdraw-entry-card{min-height:67px;margin-top:10px;padding:13px 15px;box-sizing:border-box;border-radius:18px;background:#FFFFFF}
.withdraw-entry-first{margin-top:20px}
.withdraw-arrow{width:8px;height:8px;margin-left:7px;box-sizing:border-box;border-top:1px solid #B6BFB9;border-right:1px solid #B6BFB9}
}
