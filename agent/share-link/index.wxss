/* 小程序链接：页面外壳（底纹、顶栏、滚动区）与「我的邀请码」同一套；
   三张步骤示意图用样式画成（胶囊、微信菜单、聊天气泡），不占图片素材。 */
@import "../../styles/skeleton.wxss";

page { background: #FAFAFA; }

.share-link-page { position: relative; height: 100vh; overflow: hidden; background: #FAFAFA; color: #24332D; }
.share-link-ambient { position: fixed; top: 0; left: 0; z-index: 0; width: 100%; height: 100%; overflow: hidden; pointer-events: none; background: radial-gradient(125% 52% at 100% 0, rgba(255, 205, 194, .84) 0%, rgba(255, 230, 224, .5) 40%, rgba(250, 250, 250, 0) 76%), #FAFAFA; }
.share-link-ambient-ribbon { position: absolute; top: -140rpx; left: -430rpx; width: 1480rpx; height: 720rpx; box-sizing: border-box; border: 24rpx solid rgba(255, 255, 255, .72); border-top-color: transparent; border-right-color: transparent; border-radius: 50%; opacity: .84; transform: rotate(-18deg); }
.share-link-ambient-ribbon-inner { position: absolute; top: 38rpx; right: 38rpx; bottom: 38rpx; left: 38rpx; box-sizing: border-box; border: 10rpx solid rgba(255, 255, 255, .38); border-top-color: transparent; border-right-color: transparent; border-radius: 50%; }
.share-link-topbar { position: fixed; top: 0; right: 0; left: 0; z-index: 20; box-sizing: border-box; background: transparent; }
.share-link-topbar-inner { position: relative; display: flex; align-items: center; box-sizing: content-box; padding: 0 36rpx 8rpx; }
.share-link-back { display: flex; width: 44rpx; height: 44rpx; align-items: center; justify-content: center; }
.share-link-back:active { opacity: .65; }
.share-link-back-icon { width: 20rpx; height: 20rpx; border-bottom: 3rpx solid #24332D; border-left: 3rpx solid #24332D; transform: rotate(45deg) scale(.72); }
.share-link-topbar-title { position: absolute; left: 50%; display: block; color: #24332D; font-size: 36rpx; font-weight: 700; letter-spacing: -1rpx; transform: translateX(-50%); white-space: nowrap; }
.share-link-scroll { position: absolute; top: 0; right: 0; bottom: 0; left: 0; z-index: 1; box-sizing: border-box; background: transparent; }
.share-link-content { min-height: 100%; padding: 44rpx 36rpx calc(80rpx + env(safe-area-inset-bottom)); box-sizing: border-box; }

/* 指向真实胶囊「···」的提示：位置由页面按胶囊实际坐标给出（行内 px），这里只管样子 */
.share-link-pointer { position: fixed; z-index: 30; display: flex; flex-direction: column; align-items: center; transform: translateX(-50%); animation: share-link-bob 1.4s ease-in-out infinite; pointer-events: none; }
.share-link-pointer-arrow { width: 0; height: 0; border-right: 12rpx solid transparent; border-bottom: 14rpx solid #FD7C02; border-left: 12rpx solid transparent; }
.share-link-pointer-text { padding: 8rpx 18rpx; border-radius: 999rpx; background: #FD7C02; color: #FFFFFF; font-size: 21rpx; font-weight: 600; line-height: 1.3; white-space: nowrap; box-shadow: 0 6rpx 16rpx rgba(253, 124, 2, .28); }
@keyframes share-link-bob { 0%, 100% { margin-top: 0; } 50% { margin-top: 8rpx; } }

.share-link-state { padding: 90rpx 24rpx 40rpx; text-align: center; }
.share-link-state-title { display: block; color: #24332D; font-size: 32rpx; font-weight: 600; }
.share-link-state-copy { display: block; margin: 22rpx 0 32rpx; color: #7D877F; font-size: 25rpx; line-height: 1.6; }
.share-link-state-action { display: inline-flex; height: 76rpx; align-items: center; padding: 0 44rpx; border-radius: 20rpx; background: #FD7C02; color: #FFFFFF; font-size: 26rpx; }
.share-link-state-action:active { opacity: .78; }

/* 链接图标：两节圆角链环，斜放 */
.share-link-glyph { position: relative; flex: 0 0 auto; width: 36rpx; height: 36rpx; transform: rotate(-45deg); }
.share-link-glyph::before, .share-link-glyph::after { position: absolute; top: 11rpx; width: 20rpx; height: 14rpx; box-sizing: border-box; border: 4rpx solid currentColor; border-radius: 7rpx; content: ''; }
.share-link-glyph::before { left: 1rpx; }
.share-link-glyph::after { right: 1rpx; }
.share-link-glyph.is-blue { color: #576B95; }
.share-link-glyph.is-white { color: #FFFFFF; }

.share-link-hero { position: relative; padding: 40rpx 36rpx 36rpx; border-radius: 36rpx; background: #FFFFFF; box-shadow: 0 8rpx 30rpx rgba(56, 75, 64, .04); }
.share-link-hero-title { display: block; color: #24332D; font-size: 36rpx; font-weight: 700; line-height: 1.3; }
.share-link-hero-copy { display: block; margin-top: 14rpx; color: #6B766F; font-size: 25rpx; line-height: 1.65; }
.share-link-hero-sample { display: flex; align-items: center; gap: 10rpx; margin-top: 26rpx; padding: 18rpx 22rpx; border-radius: 18rpx; background: #F3F5F8; color: #576B95; font-size: 26rpx; line-height: 1.3; }
.share-link-hero-code { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; margin-top: 22rpx; }
.share-link-hero-code-label { flex: 0 0 auto; color: #7D877F; font-size: 23rpx; }
.share-link-hero-code-row { display: flex; min-width: 0; align-items: center; gap: 14rpx; }
.share-link-hero-code-row:active { opacity: .6; }
.share-link-hero-code-value { min-width: 0; overflow: hidden; color: #24332D; font-size: 30rpx; font-weight: 700; letter-spacing: 3rpx; text-overflow: ellipsis; white-space: nowrap; }
.share-link-hero-code-copy { flex: 0 0 auto; padding: 6rpx 20rpx; border-radius: 999rpx; background: #FFF1E3; color: #C25A02; font-size: 21rpx; }
.share-link-sk-code { width: 220rpx; height: 36rpx; }

.share-link-step { margin-top: 24rpx; padding: 32rpx 32rpx 30rpx; border-radius: 32rpx; background: #FFFFFF; box-shadow: 0 8rpx 30rpx rgba(56, 75, 64, .04); }
.share-link-step-head { display: flex; align-items: flex-start; gap: 18rpx; }
.share-link-step-no { display: flex; flex: 0 0 44rpx; height: 44rpx; align-items: center; justify-content: center; border-radius: 50%; background: #FD7C02; color: #FFFFFF; font-size: 24rpx; font-weight: 700; line-height: 1; }
.share-link-step-copy { display: flex; min-width: 0; flex-direction: column; }
.share-link-step-title { color: #24332D; font-size: 29rpx; font-weight: 600; line-height: 44rpx; }
.share-link-step-hint { margin-top: 6rpx; color: #8A948D; font-size: 22rpx; line-height: 1.55; }

/* 示意图公共底板 */
.share-link-figure { position: relative; margin-top: 24rpx; overflow: hidden; border-radius: 24rpx; background: #F4F5F4; }

/* 图 1：手机顶部 + 胶囊，「···」高亮 */
.slf-phone-top { padding: 14rpx 24rpx 22rpx; background: linear-gradient(180deg, #FFF3EC 0%, #FAFAFA 100%); }
.slf-status { display: flex; align-items: center; justify-content: space-between; height: 34rpx; padding: 0 8rpx; color: #24332D; font-size: 20rpx; font-weight: 600; }
.slf-status-icons { display: flex; align-items: center; gap: 8rpx; }
.slf-status-icons view { width: 26rpx; height: 14rpx; border-radius: 4rpx; background: #24332D; }
.slf-status-icons view:first-child { width: 18rpx; opacity: .7; }
.slf-bar { position: relative; display: flex; align-items: center; height: 72rpx; margin-top: 8rpx; }
.slf-back { width: 16rpx; height: 16rpx; margin-left: 10rpx; border-bottom: 3rpx solid #24332D; border-left: 3rpx solid #24332D; transform: rotate(45deg); }
.slf-bar-title { position: absolute; left: 50%; color: #24332D; font-size: 26rpx; font-weight: 700; transform: translateX(-50%); white-space: nowrap; }
.slf-capsule { position: absolute; top: 50%; right: 0; display: flex; align-items: center; width: 174rpx; height: 64rpx; box-sizing: border-box; border: 1rpx solid rgba(0, 0, 0, .10); border-radius: 999rpx; background: rgba(255, 255, 255, .9); transform: translateY(-50%); }
.slf-capsule-dots { position: relative; display: flex; flex: 1; height: 100%; align-items: center; justify-content: center; gap: 7rpx; }
.slf-capsule-dots view { width: 9rpx; height: 9rpx; border-radius: 50%; background: #24332D; }
.slf-capsule-dots view:nth-child(2) { width: 12rpx; height: 12rpx; }
.slf-capsule-dots.is-hot::after { position: absolute; top: 50%; left: 50%; width: 84rpx; height: 84rpx; box-sizing: border-box; border: 4rpx solid #FD7C02; border-radius: 50%; content: ''; transform: translate(-50%, -50%); animation: slf-pulse 1.6s ease-out infinite; }
.slf-capsule-divider { width: 1rpx; height: 36rpx; background: rgba(0, 0, 0, .12); }
.slf-capsule-close { display: flex; flex: 1; height: 100%; align-items: center; justify-content: center; }
.slf-capsule-close view { width: 26rpx; height: 26rpx; box-sizing: border-box; border: 4rpx solid #24332D; border-radius: 50%; box-shadow: inset 0 0 0 5rpx #FFFFFF, inset 0 0 0 10rpx #24332D; }
@keyframes slf-pulse { 0% { opacity: 1; transform: translate(-50%, -50%) scale(.7); } 100% { opacity: 0; transform: translate(-50%, -50%) scale(1.25); } }

/* 图 2：微信右上角菜单，「复制链接」高亮 */
.share-link-figure.is-menu { padding: 28rpx 20rpx 0; background: #E9EBEA; }
.slf-sheet { padding: 22rpx 12rpx 30rpx; border-radius: 24rpx 24rpx 0 0; background: #F7F7F7; }
.slf-sheet-head { display: flex; align-items: center; gap: 12rpx; padding: 0 12rpx 22rpx; color: #7A7F7C; font-size: 21rpx; }
.slf-sheet-logo { width: 32rpx; height: 32rpx; border-radius: 8rpx; background: linear-gradient(135deg, #FFB25C 0%, #FD7C02 100%); }
.slf-sheet-row { display: flex; justify-content: space-around; }
.slf-sheet-item { display: flex; width: 25%; flex-direction: column; align-items: center; color: #5E6360; font-size: 19rpx; line-height: 1.3; white-space: nowrap; }
.slf-sheet-icon { display: flex; width: 88rpx; height: 88rpx; align-items: center; justify-content: center; margin-bottom: 12rpx; border-radius: 22rpx; background: #FFFFFF; color: #5E6360; }
.slf-sheet-item.is-hot { color: #C25A02; font-weight: 600; }
.slf-sheet-item.is-hot .slf-sheet-icon { background: #FD7C02; box-shadow: 0 0 0 6rpx rgba(253, 124, 2, .22); }
.slf-icon-send { width: 30rpx; height: 30rpx; box-sizing: border-box; border: 4rpx solid currentColor; border-radius: 50% 50% 50% 8rpx; }
.slf-icon-moments { width: 34rpx; height: 34rpx; box-sizing: border-box; border: 4rpx dotted currentColor; border-radius: 50%; }
.slf-icon-more { display: flex; gap: 6rpx; }
.slf-icon-more view { width: 8rpx; height: 8rpx; border-radius: 50%; background: currentColor; }

/* 图 3：聊天里的蓝色链接 */
.share-link-figure.is-chat { padding: 26rpx 22rpx; background: #EDEDED; }
.slf-chat-row { display: flex; align-items: flex-start; justify-content: flex-end; gap: 14rpx; }
.slf-chat-row.is-friend { justify-content: flex-start; margin-top: 20rpx; }
.slf-avatar { flex: 0 0 60rpx; height: 60rpx; border-radius: 12rpx; background: linear-gradient(135deg, #D9E4DD 0%, #BFCFC5 100%); }
.slf-avatar.is-mine { background: linear-gradient(135deg, #FFD2A8 0%, #FFB069 100%); }
.slf-bubble { position: relative; max-width: 72%; padding: 16rpx 20rpx; border-radius: 12rpx; background: #FFFFFF; color: #1F2421; font-size: 24rpx; line-height: 1.5; word-break: break-all; }
.slf-bubble.is-mine { background: #95EC69; }
.slf-bubble-text { color: #1F2421; }
.slf-link { color: #576B95; }
.slf-tap { position: absolute; right: 26rpx; bottom: -6rpx; width: 34rpx; height: 34rpx; box-sizing: border-box; border: 4rpx solid rgba(253, 124, 2, .9); border-radius: 50%; background: rgba(253, 124, 2, .18); animation: slf-tap 1.6s ease-out infinite; }
@keyframes slf-tap { 0% { opacity: 1; transform: scale(.6); } 100% { opacity: 0; transform: scale(1.4); } }

.share-link-tips { margin-top: 24rpx; padding: 28rpx 32rpx; border-radius: 28rpx; background: rgba(255, 255, 255, .7); }
.share-link-tips-title { display: block; color: #3B4941; font-size: 25rpx; font-weight: 600; }
.share-link-tip { position: relative; display: block; margin-top: 12rpx; padding-left: 22rpx; color: #7D877F; font-size: 22rpx; line-height: 1.6; }
.share-link-tip::before { position: absolute; top: 15rpx; left: 2rpx; width: 8rpx; height: 8rpx; border-radius: 50%; background: #C9D0CB; content: ''; }

/* 朋友圈单页落地 */
.share-link-invite { display: flex; flex-direction: column; align-items: center; box-sizing: border-box; padding: 160rpx 56rpx 0; text-align: center; }
.share-link-invite-icon { width: 144rpx; height: 144rpx; overflow: hidden; border-radius: 36rpx; background: #F1EFEA; }
.share-link-invite-icon image { display: block; width: 100%; height: 100%; }
.share-link-invite-title { display: block; margin-top: 40rpx; color: #24332D; font-size: 36rpx; font-weight: 700; }
.share-link-invite-copy { display: block; margin-top: 20rpx; color: #7D877F; font-size: 26rpx; line-height: 1.7; }

@import "./index.large.wxss"; /* 平板、电脑大屏样式：由 scripts/build-large-screen-styles.mjs 生成，改完本文件后重跑；这一行须留在文件末尾 */
