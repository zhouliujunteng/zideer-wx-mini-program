/* 自动生成，请勿手改：index.wxss 在平板、电脑大屏（窗口宽 ≥ 450px）下的样式。
   rpx 按 1rpx = 0.6px 换算，固定定位元素收进居中栏；改完源文件后运行 node scripts/build-large-screen-styles.mjs */
@media (min-width: 450px) {
.sk{border-radius:7px}
.sk-line{height:16px}
.sk-line + .sk-line{margin-top:8px}
.sk-short{width:40%}
.sk-mid{width:64%}
.sk-round{border-radius:50%}
.sk-card{height:96px;border-radius:14px}
.sk-card + .sk-card{margin-top:12px}
.share-link-page{height:100vh}
.share-link-ambient{top:0;left:max(0px, 50% - var(--lg-col) / 2);width:min(100%, var(--lg-col));height:100%}
.share-link-ambient-ribbon{top:-84px;left:-258px;width:888px;height:432px;box-sizing:border-box;border:14px solid rgba(255, 255, 255, .72);border-top-color:transparent;border-right-color:transparent;border-radius:50%}
.share-link-ambient-ribbon-inner{top:22px;right:22px;bottom:22px;left:22px;box-sizing:border-box;border:6px solid rgba(255, 255, 255, .38);border-top-color:transparent;border-right-color:transparent;border-radius:50%}
.share-link-topbar{top:0;right:max(0px, 50% - var(--lg-col) / 2);left:max(0px, 50% - var(--lg-col) / 2);box-sizing:border-box}
.share-link-topbar-inner{box-sizing:content-box;padding:0 21px 4px}
.share-link-back{width:26px;height:26px}
.share-link-back-icon{width:12px;height:12px;border-bottom:1px solid #24332D;border-left:1px solid #24332D}
.share-link-topbar-title{left:50%;font-size:21px;font-weight:700;letter-spacing:-1px}
.share-link-scroll{top:0;right:0;bottom:0;left:0;box-sizing:border-box}
.share-link-content{min-height:100%;padding:26px 21px calc(48px + env(safe-area-inset-bottom));box-sizing:border-box}
.share-link-pointer{flex-direction:column}
.share-link-pointer-arrow{width:0;height:0;border-right:7px solid transparent;border-bottom:8px solid #FD7C02;border-left:7px solid transparent}
.share-link-pointer-text{padding:4px 10px;border-radius:599px;font-size:12px;font-weight:600;line-height:1.3;box-shadow:0 3px 9px rgba(253, 124, 2, .28)}
@keyframes share-link-bob{0%, 100%{margin-top:0}50%{margin-top:4px}}
.share-link-state{padding:54px 14px 24px}
.share-link-state-title{font-size:19px;font-weight:600}
.share-link-state-copy{margin:13px 0 19px;font-size:15px;line-height:1.6}
.share-link-state-action{height:45px;padding:0 26px;border-radius:12px;font-size:15px}
.share-link-glyph{flex:0 0 auto;width:21px;height:21px}
.share-link-glyph::before, .share-link-glyph::after{top:6px;width:12px;height:8px;box-sizing:border-box;border:2px solid currentColor;border-radius:4px}
.share-link-glyph::before{left:0.5px}
.share-link-glyph::after{right:0.5px}
.share-link-hero{padding:24px 21px 21px;border-radius:21px;box-shadow:0 4px 18px rgba(56, 75, 64, .04)}
.share-link-hero-title{font-size:21px;font-weight:700;line-height:1.3}
.share-link-hero-copy{margin-top:8px;font-size:15px;line-height:1.65}
.share-link-hero-sample{gap:6px;margin-top:15px;padding:10px 13px;border-radius:10px;font-size:15px;line-height:1.3}
.share-link-hero-code{gap:12px;margin-top:13px}
.share-link-hero-code-label{flex:0 0 auto;font-size:13px}
.share-link-hero-code-row{min-width:0;gap:8px}
.share-link-hero-code-value{min-width:0;font-size:18px;font-weight:700;letter-spacing:1px}
.share-link-hero-code-copy{flex:0 0 auto;padding:3px 12px;border-radius:599px;font-size:12px}
.share-link-sk-code{width:132px;height:21px}
.share-link-step{margin-top:14px;padding:19px 19px 18px;border-radius:19px;box-shadow:0 4px 18px rgba(56, 75, 64, .04)}
.share-link-step-head{gap:10px}
.share-link-step-no{flex:0 0 26px;height:26px;border-radius:50%;font-size:14px;font-weight:700;line-height:1}
.share-link-step-copy{min-width:0;flex-direction:column}
.share-link-step-title{font-size:17px;font-weight:600;line-height:26px}
.share-link-step-hint{margin-top:3px;font-size:13px;line-height:1.55}
.share-link-figure{margin-top:14px;border-radius:14px}
.slf-phone-top{padding:8px 14px 13px}
.slf-status{height:20px;padding:0 4px;font-size:12px;font-weight:600}
.slf-status-icons{gap:4px}
.slf-status-icons view{width:15px;height:8px;border-radius:2px}
.slf-status-icons view:first-child{width:10px}
.slf-bar{height:43px;margin-top:4px}
.slf-back{width:9px;height:9px;margin-left:6px;border-bottom:1px solid #24332D;border-left:1px solid #24332D}
.slf-bar-title{left:50%;font-size:15px;font-weight:700}
.slf-capsule{top:50%;right:0;width:104px;height:38px;box-sizing:border-box;border:0.5px solid rgba(0, 0, 0, .10);border-radius:599px}
.slf-capsule-dots{flex:1;height:100%;gap:4px}
.slf-capsule-dots view{width:5px;height:5px;border-radius:50%}
.slf-capsule-dots view:nth-child(2){width:7px;height:7px}
.slf-capsule-dots.is-hot::after{top:50%;left:50%;width:50px;height:50px;box-sizing:border-box;border:2px solid #FD7C02;border-radius:50%}
.slf-capsule-divider{width:0.5px;height:21px}
.slf-capsule-close{flex:1;height:100%}
.slf-capsule-close view{width:15px;height:15px;box-sizing:border-box;border:2px solid #24332D;border-radius:50%;box-shadow:inset 0 0 0 3px #FFFFFF, inset 0 0 0 6px #24332D}
.share-link-figure.is-menu{padding:16px 12px 0}
.slf-sheet{padding:13px 7px 18px;border-radius:14px 14px 0 0}
.slf-sheet-head{gap:7px;padding:0 7px 13px;font-size:12px}
.slf-sheet-logo{width:19px;height:19px;border-radius:4px}
.slf-sheet-item{width:25%;flex-direction:column;font-size:11px;line-height:1.3}
.slf-sheet-icon{width:52px;height:52px;margin-bottom:7px;border-radius:13px}
.slf-sheet-item.is-hot{font-weight:600}
.slf-sheet-item.is-hot .slf-sheet-icon{box-shadow:0 0 0 3px rgba(253, 124, 2, .22)}
.slf-icon-send{width:18px;height:18px;box-sizing:border-box;border:2px solid currentColor;border-radius:50% 50% 50% 4px}
.slf-icon-moments{width:20px;height:20px;box-sizing:border-box;border:2px dotted currentColor;border-radius:50%}
.slf-icon-more{gap:3px}
.slf-icon-more view{width:4px;height:4px;border-radius:50%}
.share-link-figure.is-chat{padding:15px 13px}
.slf-chat-row{gap:8px}
.slf-chat-row.is-friend{margin-top:12px}
.slf-avatar{flex:0 0 36px;height:36px;border-radius:7px}
.slf-bubble{max-width:72%;padding:9px 12px;border-radius:7px;font-size:14px;line-height:1.5}
.slf-tap{right:15px;bottom:-4px;width:20px;height:20px;box-sizing:border-box;border:2px solid rgba(253, 124, 2, .9);border-radius:50%}
.share-link-tips{margin-top:14px;padding:16px 19px;border-radius:16px}
.share-link-tips-title{font-size:15px;font-weight:600}
.share-link-tip{margin-top:7px;padding-left:13px;font-size:13px;line-height:1.6}
.share-link-tip::before{top:9px;left:1px;width:4px;height:4px;border-radius:50%}
.share-link-invite{flex-direction:column;box-sizing:border-box;padding:96px 33px 0}
.share-link-invite-icon{width:86px;height:86px;border-radius:21px}
.share-link-invite-icon image{width:100%;height:100%}
.share-link-invite-title{margin-top:24px;font-size:21px;font-weight:700}
.share-link-invite-copy{margin-top:12px;font-size:15px;line-height:1.7}
}
