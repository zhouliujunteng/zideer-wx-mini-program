@import "../../styles/skeleton.wxss";
/* 免费体验：顶栏、小节标题与白色大圆角卡片照「绑定家庭」（agent/bind-family），主题橙 #FD7C02。 */
page { background: #FAFAFA; }

.ft-page { position: relative; height: 100vh; overflow: hidden; background: #FAFAFA; color: #24332D; }
.ft-ambient { position: fixed; top: 0; left: 0; z-index: 0; width: 100%; height: 100%; pointer-events: none; background: radial-gradient(125% 52% at 100% 0, rgba(255, 222, 190, .84) 0%, rgba(255, 236, 218, .48) 40%, rgba(250, 250, 250, 0) 76%), #FAFAFA; }
.ft-topbar { position: fixed; top: 0; left: 0; z-index: 20; width: 100%; box-sizing: border-box; background: transparent; }
.ft-topbar-inner { position: relative; display: flex; align-items: center; box-sizing: content-box; padding: 0 32rpx 16rpx; }
.ft-back { display: flex; flex: 0 0 auto; align-items: center; justify-content: center; width: 54rpx; height: 54rpx; border-radius: 50%; }
.ft-back:active { background: #F0F2EF; }
.ft-back-icon { width: 22rpx; height: 22rpx; border-bottom: 4rpx solid #24332D; border-left: 4rpx solid #24332D; transform: rotate(45deg) scale(.7); }
.ft-topbar-title { position: absolute; left: 50%; display: block; color: #24332D; font-size: 36rpx; font-weight: 700; letter-spacing: -1rpx; transform: translateX(-50%); white-space: nowrap; }
.ft-scroll { position: relative; z-index: 1; height: 100vh; box-sizing: border-box; background: transparent; }
.ft-shell { min-height: 100%; padding: 0 32rpx calc(48rpx + env(safe-area-inset-bottom)); box-sizing: border-box; }

.ft-section { margin-top: 38rpx; }
.ft-heading { display: flex; align-items: center; gap: 12rpx; padding: 0 4rpx; color: #24332D; font-size: 30rpx; font-weight: 700; line-height: 1.2; }
.ft-no { display: inline-flex; align-items: center; justify-content: center; width: 38rpx; height: 38rpx; border-radius: 50%; background: #FD7C02; color: #fff; font-size: 22rpx; }
.ft-card { margin-top: 22rpx; padding: 26rpx; border-radius: 36rpx; background: #fff; }
.ft-shell > .ft-card:first-child { margin-top: 20rpx; }
.ft-family { display: flex; flex-direction: column; gap: 8rpx; }
.ft-name { color: #24332D; font-size: 32rpx; font-weight: 700; }
.ft-sub { color: #7E8A82; font-size: 22rpx; line-height: 1.5; }
.ft-card-title { color: #24332D; font-size: 28rpx; font-weight: 700; margin-bottom: 14rpx; }
.ft-tip { display: block; margin-top: 10rpx; color: #7E8A82; font-size: 23rpx; line-height: 1.65; }
.ft-status { display: flex; align-items: center; gap: 12rpx; color: #24332D; font-size: 27rpx; font-weight: 600; }
.ft-dot { width: 14rpx; height: 14rpx; border-radius: 50%; }
.ft-dot.is-wait { background: #FFB466; }
.ft-dot.is-done { background: #46A35E; }
.ft-steps { display: flex; flex-direction: column; gap: 6rpx; margin-top: 14rpx; padding: 18rpx 20rpx; border-radius: 22rpx; background: #FFF6EC; color: #8A5A22; font-size: 23rpx; line-height: 1.6; }
.ft-chips { display: flex; flex-wrap: wrap; gap: 16rpx; margin-top: 22rpx; }
.ft-chip { padding: 14rpx 26rpx; border: 2rpx solid #E6EAE6; border-radius: 999rpx; color: #4B5A51; font-size: 25rpx; }
.ft-chip.is-on { border-color: #FD7C02; background: rgba(253, 124, 2, .08); color: #D96A00; font-weight: 600; }
.ft-empty { margin-top: 18rpx; color: #9AA39C; font-size: 23rpx; line-height: 1.6; }
.ft-button { flex: 0 0 auto; padding: 0 30rpx; height: 72rpx; border-radius: 999rpx; background: #FD7C02; color: #fff; font-size: 25rpx; font-weight: 600; line-height: 72rpx; text-align: center; }
.ft-button:active { opacity: .7; }
.ft-button.is-disabled { opacity: .5; }
.ft-button.ft-ghost { background: #FFF1E2; color: #D96A00; }
.ft-block { margin-top: 24rpx; height: 84rpx; line-height: 84rpx; font-size: 27rpx; }
.ft-link { margin-top: 16rpx; color: #D96A00; font-size: 24rpx; }
.ft-goal { display: block; margin-top: 14rpx; color: #4B5A51; font-size: 24rpx; line-height: 1.6; }
.ft-stats { display: flex; gap: 16rpx; margin-top: 20rpx; }
.ft-stats > view { flex: 1; display: flex; flex-direction: column; align-items: center; gap: 4rpx; padding: 18rpx 0; border-radius: 22rpx; background: #FAFAF8; }
.ft-stat-num { color: #FD7C02; font-size: 40rpx; font-weight: 700; line-height: 1.2; }
.ft-stat-num.is-gray { color: #8F9891; }
.ft-stat-label { color: #7E8A82; font-size: 21rpx; }
.ft-gaps { display: flex; flex-wrap: wrap; gap: 12rpx; margin-top: 18rpx; }
.ft-gap { padding: 6rpx 18rpx; border-radius: 999rpx; background: #FDEDEA; color: #C24E3E; font-size: 22rpx; }
.ft-script { display: block; padding: 22rpx; border-radius: 22rpx; background: #FAFAF8; color: #24332D; font-size: 26rpx; line-height: 1.75; white-space: pre-wrap; }
.ft-actions { display: flex; justify-content: flex-end; gap: 16rpx; margin-top: 20rpx; }
.ft-error { display: block; margin-top: 14rpx; color: #E5484D; font-size: 23rpx; }
.ft-textarea { box-sizing: border-box; width: 100%; min-height: 150rpx; margin-top: 20rpx; padding: 20rpx 24rpx; border-radius: 22rpx; background: #F5F7F5; color: #24332D; font-size: 26rpx; line-height: 1.6; }
.ft-placeholder { color: #B0B8B2; }
.ft-state { display: flex; flex-direction: column; align-items: center; gap: 22rpx; padding: 24rpx; text-align: center; }
.ft-state-text { color: #7E8A82; font-size: 24rpx; line-height: 1.5; }
.ft-sk-block { height: 120rpx; margin-top: 22rpx; border-radius: 22rpx; }

@media (min-width: 450px) {
  page { --lg-col: 760px; }
}

@import "./index.large.wxss"; /* 平板、电脑大屏样式：由 scripts/build-large-screen-styles.mjs 生成，改完本文件后重跑；这一行须留在文件末尾 */
