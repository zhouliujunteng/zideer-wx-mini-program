/* 自动生成，请勿手改：index.wxss 在平板、电脑大屏（窗口宽 ≥ 450px）下的样式。
   rpx 按 1rpx = 0.6px 换算，固定定位元素收进居中栏；改完源文件后运行 node scripts/build-large-screen-styles.mjs */
@media (min-width: 450px) {
.sk{border-radius:7px}
.sk-line{height:16px}
.sk-line + .sk-line{margin-top:8px}
.sk-short{width:40%}
.sk-mid{width:64%}
.sk-round{border-radius:50%}
.sk-card{height:96px;border-radius:14px}
.sk-card + .sk-card{margin-top:12px}
.ai-poster-page{height:100vh}
.ai-poster-topbar{top:0;left:max(0px, 50% - var(--lg-col) / 2);width:min(100%, var(--lg-col));box-sizing:border-box}
.ai-poster-topbar-inner{padding:0 21px 4px;box-sizing:content-box}
.ai-poster-back{width:26px;height:26px;flex:0 0 auto;margin-right:6px}
.ai-poster-back-icon{width:13px;height:13px;border-bottom:1px solid #24332D;border-left:1px solid #24332D;transform:rotate(45deg) scale(.72)}
.ai-poster-topbar-title{left:50%;font-size:21px;font-weight:700;letter-spacing:-1px;transform:translateX(-50%)}
.ai-poster-history-button{box-sizing:border-box;border:0.5px solid #E7EBE6;border-radius:50%}
.ai-poster-history-icon{width:18px;height:18px}
.ai-poster-scroll{top:0;right:0;bottom:0;left:0;box-sizing:border-box}
.ai-poster-content{padding:18px 19px calc(198px + env(safe-area-inset-bottom));box-sizing:border-box}
.ai-poster-search{height:46px;margin-bottom:18px;padding:0 13px;box-sizing:border-box;border:0;border-radius:13px;box-shadow:none}
.ai-poster-search-icon{width:16px;height:16px;flex:0 0 16px;margin-right:8px}
.ai-poster-search-input{min-width:0;height:100%;flex:1;font-size:14px;line-height:46px}
.ai-poster-section-heading{padding:0 1px}
.ai-poster-section-title{font-size:18px;font-weight:700;line-height:1.3}
.ai-poster-activity-grid{grid-template-columns:repeat(2, minmax(0, 1fr));column-gap:12px;row-gap:18px;margin-top:12px}
.ai-poster-activity-card{min-width:0;padding:0;box-sizing:border-box;border:0;border-radius:0}
.ai-poster-activity-media{width:100%;box-sizing:border-box;border:1px solid transparent;border-radius:12px}
.ai-poster-activity-image{width:100%;height:100%}
.ai-poster-activity-card.is-selected .ai-poster-activity-media{border-color:#FD7C02;transform:scale(.985)}
.ai-poster-activity-card-body{min-width:0;padding:8px 1px 1px;box-sizing:border-box}
.ai-poster-activity-copy{min-width:0;flex:1}
.ai-poster-activity-select-mark{width:20px;height:20px;flex:0 0 20px;margin-left:4px;box-sizing:border-box;border:1px solid #C8D0CA;border-radius:5px}
.ai-poster-activity-card.is-selected .ai-poster-activity-select-mark{border-color:#FD7C02}
.ai-poster-activity-select-check{width:7px;height:4px;border-bottom:1px solid transparent;border-left:1px solid transparent;transform:rotate(-45deg) translate(0.5px, -1px)}
.ai-poster-activity-card.is-selected .ai-poster-activity-select-check{border-color:#FFFFFF}
.ai-poster-activity-name{font-size:15px;font-weight:700;line-height:1.3}
.ai-poster-activity-detail{margin-top:4px;font-size:11px;line-height:1.25}
.ai-poster-sk-name{width:78%;height:18px}
.ai-poster-sk-detail{height:13px;margin-top:6px}
.ai-poster-search-empty{padding:45px 0;font-size:13px}
.ai-poster-state{margin-top:12px;padding:54px 21px;border-radius:16px}
.ai-poster-state-title{font-size:17px;font-weight:700;line-height:1.3}
.ai-poster-state-copy{margin-top:9px;font-size:13px;line-height:1.6}
.ai-poster-state-action{height:43px;margin-top:18px;padding:0 26px;border-radius:599px;font-size:15px;font-weight:650}
.ai-poster-bottom-fade{right:max(0px, 50% - var(--lg-col) / 2);bottom:0;left:max(0px, 50% - var(--lg-col) / 2);height:216px}
.ai-poster-settings-dock{right:calc(max(0px, 50% - var(--lg-col) / 2) + 19px);bottom:calc(78px + env(safe-area-inset-bottom));left:calc(max(0px, 50% - var(--lg-col) / 2) + 19px)}
.ai-poster-settings-card{min-height:58px;padding:9px 13px;box-sizing:border-box;border-radius:14px;box-shadow:0 3px 12px rgba(36, 51, 45, .07)}
.ai-poster-settings-size{min-width:0;flex-direction:column}
.ai-poster-settings-label{font-size:11px;line-height:1.2}
.ai-poster-settings-value{margin-top:4px;font-size:15px;font-weight:650;line-height:1.2}
.ai-poster-settings-more{width:25px;height:25px;flex:0 0 25px}
.ai-poster-settings-chevron{width:7px;height:7px;border-top:1px solid #9AA59D;border-right:1px solid #9AA59D;transform:rotate(45deg)}
.ai-poster-actionbar{right:max(0px, 50% - var(--lg-col) / 2);bottom:0;left:max(0px, 50% - var(--lg-col) / 2);padding:10px 19px calc(13px + env(safe-area-inset-bottom));box-sizing:border-box}
.ai-poster-generate-button{width:100%;height:57px;border-radius:599px;font-size:16px;font-weight:650;line-height:57px}
.poster-result-page{top:0;right:0;bottom:0;left:0}
.poster-result-stage{top:0;right:0;bottom:79px;left:0;padding-right:14px;padding-bottom:12px;padding-left:14px;box-sizing:border-box}
.poster-result-card{flex:0 0 auto;border-radius:15px}
.poster-result-image{width:100%;height:100%}
.poster-result-pending, .poster-result-failed{width:100%;height:100%;flex-direction:column;padding:0 33px;box-sizing:border-box;border-radius:0}
.poster-result-pending-title, .poster-result-failed-title{font-size:16px;font-weight:700;line-height:1.3}
.poster-result-pending-copy, .poster-result-failed-copy{margin-top:8px;font-size:13px;line-height:1.55}
.poster-result-actionbar{right:0;bottom:0;left:0;padding:10px 19px calc(13px + env(safe-area-inset-bottom));box-sizing:border-box}
.poster-result-share-button{width:100%;height:57px;border-radius:599px;font-size:16px;font-weight:650}
.poster-share-canvas{top:-9999px;left:calc(max(0px, 50% - var(--lg-col) / 2) + -9999px);width:10px;height:10px}
.poster-result-share-mask{top:0;right:max(0px, 50% - var(--lg-col) / 2);bottom:0;left:max(0px, 50% - var(--lg-col) / 2);box-shadow:0 0 0 100vmax rgba(25, 31, 28, .72)}
.poster-result-share-stage{top:0;right:0;bottom:calc(252px + env(safe-area-inset-bottom));left:0;padding:25px 16px 12px;box-sizing:border-box}
.poster-result-share-card{flex:0 0 auto;border-radius:15px}
.poster-result-share-pending{right:0;bottom:0;left:0;padding:8px 12px;font-size:12px;line-height:1.4}
.poster-result-share-sheet{right:0;bottom:0;left:0;padding:14px 22px calc(21px + env(safe-area-inset-bottom));box-sizing:border-box;border-radius:20px 20px 0 0}
.poster-result-share-header{height:30px}
.poster-result-share-title{font-size:15px;font-weight:750;line-height:1.2}
.poster-result-share-actions{gap:15px;margin:14px auto 0}
.poster-result-share-action{flex:0 0 76px;flex-direction:column;font-size:13px;line-height:1.2}
.poster-result-share-action-icon{width:48px;height:48px;margin-bottom:9px;border-radius:50%}
.poster-result-share-action-icon image{width:72%;height:72%}
.poster-result-link-glyph{width:33px;height:33px;transform:rotate(-45deg)}
.poster-result-link-glyph::before, .poster-result-link-glyph::after{top:10px;width:18px;height:12px;box-sizing:border-box;border:3px solid #7E8981;border-radius:6px}
.poster-result-link-glyph::before{left:0.5px}
.poster-result-link-glyph::after{right:0.5px}
.poster-result-share-note{margin-top:15px;font-size:12px;line-height:1.4}
.poster-result-share-cancel{height:32px;margin-top:18px;font-size:14px;line-height:32px}
.poster-history-layer{top:0;right:max(0px, 50% - var(--lg-col) / 2);bottom:0;left:max(0px, 50% - var(--lg-col) / 2);box-shadow:0 0 0 100vmax rgba(28, 38, 32, .28)}
.poster-history-sheet{right:0;bottom:0;left:0;height:64vh;padding:9px 18px calc(13px + env(safe-area-inset-bottom));box-sizing:border-box;border-radius:24px 24px 0 0}
.poster-history-handle{width:44px;height:4px;margin:0 auto 14px;border-radius:599px}
.poster-history-title{font-size:19px;font-weight:700;line-height:1.2}
.poster-history-close{width:31px;height:31px;border-radius:50%;font-size:22px;font-weight:300;line-height:1}
.poster-history-list{height:calc(64vh - 82px);margin-top:9px;padding:4px 4px 16px;box-sizing:border-box}
.poster-history-item{min-height:110px;margin:9px 0 12px;padding:10px;box-sizing:border-box;border:1px solid transparent;border-radius:16px}
.poster-history-item.is-active{border-color:#E8D4C1}
.poster-history-art{width:64px;height:86px;flex:0 0 64px;margin-right:24px;box-sizing:border-box;border-radius:7px;transform:rotate(-5deg)}
.poster-history-art-image{width:100%;height:100%}
.poster-history-copy{min-width:0;height:86px;flex:1;flex-direction:column}
.poster-history-heading{min-width:0}
.poster-history-title-copy{min-width:0;flex:1;flex-direction:column}
.poster-history-activity{min-width:0;font-size:15px;font-weight:650;line-height:1.3}
.poster-history-time{flex:0 0 auto;margin-left:4px;font-size:10px;line-height:1.3}
.poster-history-params{margin-top:7px}
.poster-history-param{font-size:10px;line-height:1.3}
.poster-history-param-divider{flex:0 0 auto;margin:0 4px;font-size:10px}
.poster-history-status{margin-top:8px;padding:2px 8px;border-radius:599px;font-size:10px;line-height:1.4}
.poster-history-empty{padding:43px 10px;font-size:13px}
.poster-size-layer{top:0;right:max(0px, 50% - var(--lg-col) / 2);bottom:0;left:max(0px, 50% - var(--lg-col) / 2);box-shadow:0 0 0 100vmax rgba(28, 38, 32, .28)}
.poster-size-sheet{right:0;bottom:0;left:0;min-height:42vh;padding:9px 18px calc(14px + env(safe-area-inset-bottom));box-sizing:border-box;border-radius:24px 24px 0 0}
.poster-size-handle{width:44px;height:4px;margin:0 auto 14px;border-radius:599px}
.poster-size-title{font-size:19px;font-weight:700;line-height:1.2}
.poster-size-options{margin-top:14px}
.poster-size-option{min-height:60px;margin-top:8px;padding:10px 13px;box-sizing:border-box;border:1px solid transparent;border-radius:13px}
.poster-size-option:first-child{margin-top:0}
.poster-size-option.is-selected{border-color:#E8D4C1}
.poster-size-option-ratio{font-size:15px;font-weight:700}
.poster-size-option-label{margin-left:9px;font-size:12px}
.poster-size-option-radio{width:20px;height:20px;box-sizing:border-box;border:1px solid #D5DDD7;border-radius:50%}
.poster-size-option.is-selected .poster-size-option-radio{border-color:#FD7C02}
.poster-size-option-radio view{width:9px;height:9px;border-radius:50%}
}
