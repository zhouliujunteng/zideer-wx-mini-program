/* 自动生成，请勿手改：index.wxss 在平板、电脑大屏（窗口宽 ≥ 450px）下的样式。
   rpx 按 1rpx = 0.6px 换算，固定定位元素收进居中栏；改完源文件后运行 node scripts/build-large-screen-styles.mjs */
@media (min-width: 450px) {
.sk{border-radius:7px;background:linear-gradient(90deg, #ECEEEB 25%, #F5F6F4 37%, #ECEEEB 63%);background-size:400% 100%}
.sk-line{height:16px}
.sk-line + .sk-line{margin-top:8px}
.sk-short{width:40%}
.sk-mid{width:64%}
.sk-round{border-radius:50%}
.sk-card{height:96px;border-radius:14px}
.sk-card + .sk-card{margin-top:12px}
page{background:#FAFAFA}
.application-page{height:100vh;background:#FAFAFA}
.application-topbar{top:0;right:max(0px, 50% - var(--lg-col) / 2);left:max(0px, 50% - var(--lg-col) / 2);background:transparent}
.application-topbar-surface{top:0;right:0;bottom:0;left:0;background:#FAFAFA}
.application-topbar-inner{padding:0 21px 4px}
.application-back{width:26px;height:26px}
.application-back-icon{width:12px;height:12px;border-bottom:1px solid #FFFFFF;border-left:1px solid #FFFFFF}
.application-back-icon-dark{border-color:#24332D}
.application-topbar-title{left:50%;font-size:21px;font-weight:700;letter-spacing:-1px}
.application-scroll{top:0;right:0;bottom:0;left:0;background:#FAFAFA}
.application-shell{min-height:100%;padding:0 19px calc(43px + env(safe-area-inset-bottom));background:linear-gradient(180deg, #F14677 0%, #EF3E3A 48%, #F5A4A7 68%, #FBE4DF 79%, #FAFAFA 88%, #FAFAFA 100%);background-repeat:no-repeat;background-size:100% 288px}
.application-ambient-icon{top:-16px;right:-48px;width:234px;height:234px}
.application-state{padding:54px 14px 24px}
.application-state-title{font-size:19px;font-weight:600}
.application-state-copy{margin:13px 0 19px;font-size:15px;line-height:1.6}
.application-state-action{height:45px;padding:0 26px;border-radius:12px;background:#FD7C02;font-size:15px}
.application-hero{padding:16px 18px 15px;border-radius:16px;background:#FFFFFF}
.application-hero-title{font-size:16px;font-weight:700}
.application-status{padding:3px 9px;border-radius:599px;font-size:12px;line-height:1.3}
.application-status-pending{background:#FFF4E5}
.application-status-done{background:#EAF6EE}
.application-status-rejected{background:#FFF0EE}
.application-hero-label{margin-top:14px;font-size:13px;font-weight:600}
.application-hero-value{margin-top:7px;font-size:33px;font-weight:700;letter-spacing:-1px;line-height:1}
.application-hero-unit{margin-left:6px;font-size:15px;font-weight:650;letter-spacing:0}
.application-hero-meta{margin-top:12px;padding-top:10px;border-top:0.5px solid #F0F2F0;font-size:12px}
.application-copy{margin-left:8px;font-weight:600}
.application-sk-value{width:132px;height:33px;margin-top:14px}
.application-sk-meta{margin-top:14px}
.application-sk-row{width:120px}
.application-card{margin-top:10px;padding:15px 16px;border-radius:18px;background:#FFFFFF}
.application-card-title{margin-bottom:3px;font-size:16px;font-weight:700;line-height:1.3}
.application-row{min-height:42px;border-bottom:0.5px solid #F2F4F2}
.application-row:last-child{border-bottom:0}
.application-row-label{font-size:15px}
.application-row-value{min-width:0;margin-left:12px;font-size:15px;font-weight:600}
.application-row-value.is-strong{font-size:18px;font-weight:700}
.application-divider{height:0.5px;margin:3px 0;border-top:0.5px dashed #E2E7E3}
.application-steps{margin-top:7px}
.application-step{padding-bottom:15px}
.application-step:last-child{padding-bottom:2px}
.application-step::before{top:15px;bottom:-2px;left:6px;width:1px;background:#E6EAE7}
.application-step-dot{width:14px;height:14px;margin-top:2px;border:2px solid #D3D9D5;border-radius:50%;background:#FFFFFF}
.application-step-done .application-step-dot{border-color:#3E8B5A;background:#3E8B5A}
.application-step-current .application-step-dot{border-color:#F5A53D}
.application-step-rejected .application-step-dot{border-color:#D6505A;background:#D6505A}
.application-step-copy{min-width:0;margin-left:10px}
.application-step-label{font-size:15px;font-weight:600;line-height:1.3}
.application-step-todo .application-step-label{font-weight:500}
.application-step-time{margin-top:3px;font-size:12px}
.application-callout{margin-top:9px;padding:10px 12px;border-radius:12px;background:#F6F8F6}
.application-callout-rejected{background:#FFF0EE}
.application-callout-title{font-size:13px;font-weight:700}
.application-callout-copy{margin-top:4px;font-size:13px;line-height:1.6}
.application-files{margin:7px -5px 0}
.application-file{width:calc((100% - 28px) / 3);height:108px;margin:4px;border-radius:12px;background:#F5F7F5}
.application-file-image{width:100%;height:100%}
.application-file-pdf{height:100%;padding:9px}
.application-file-pdf-badge{padding:3px 8px;border-radius:6px;background:#E6414C;font-size:13px;font-weight:700}
.application-file-name{margin-top:7px;font-size:11px;line-height:1.35;-webkit-line-clamp:2}
.application-empty{padding:9px 0 2px;font-size:13px}
.application-entry-card{min-height:67px;margin-top:10px;padding:13px 15px;border-radius:18px;background:#FFFFFF}
.application-entry-icon{width:38px;height:38px;border-radius:10px;background:#FFF1E5}
.application-entry-icon image{width:20px;height:20px}
.application-entry-copy{min-width:0;margin-left:10px}
.application-entry-title{font-size:16px;font-weight:650;line-height:1.25}
.application-entry-meta{margin-top:4px;font-size:12px;line-height:1.3}
.application-arrow{width:8px;height:8px;margin-left:7px;border-top:1px solid #B6BFB9;border-right:1px solid #B6BFB9}
}
