/* 我的推广：样式取自设计仓库 b5dda68 的 package-promotion/pages/my-promotion，
   去掉本地预览菜单，另加加载态与失败态（与推广伙伴工作台一致）。 */
@import "../../styles/skeleton.wxss";

page { background: #FAFAFA; }

.my-promotion-page { position: relative; height: 100vh; overflow: hidden; background: #FAFAFA; color: #24332D; }
.my-promotion-ambient { position: fixed; top: 0; left: 0; z-index: 0; width: 100%; height: 100%; overflow: hidden; pointer-events: none; background: radial-gradient(125% 52% at 100% 0, rgba(255, 205, 194, .84) 0%, rgba(255, 230, 224, .5) 40%, rgba(250, 250, 250, 0) 76%), #FAFAFA; }
.my-promotion-ambient-ribbon { position: absolute; top: -140rpx; left: -430rpx; width: 1480rpx; height: 720rpx; box-sizing: border-box; border: 24rpx solid rgba(255, 255, 255, .72); border-top-color: transparent; border-right-color: transparent; border-radius: 50%; opacity: .84; transform: rotate(-18deg); }
.my-promotion-ambient-ribbon-inner { position: absolute; top: 38rpx; right: 38rpx; bottom: 38rpx; left: 38rpx; box-sizing: border-box; border: 10rpx solid rgba(255, 255, 255, .38); border-top-color: transparent; border-right-color: transparent; border-radius: 50%; }
.my-promotion-topbar { position: fixed; top: 0; right: 0; left: 0; z-index: 20; box-sizing: border-box; background: transparent; }
.my-promotion-topbar-inner { position: relative; display: flex; align-items: center; box-sizing: content-box; padding: 0 36rpx 8rpx; }
.my-promotion-back { display: flex; width: 44rpx; height: 44rpx; align-items: center; justify-content: center; }
.my-promotion-back:active { opacity: .65; }
.my-promotion-back-icon { width: 20rpx; height: 20rpx; border-bottom: 3rpx solid #24332D; border-left: 3rpx solid #24332D; transform: rotate(45deg) scale(.72); }
.my-promotion-topbar-title { position: absolute; left: 50%; display: block; color: #24332D; font-size: 36rpx; font-weight: 700; letter-spacing: -1rpx; transform: translateX(-50%); white-space: nowrap; }
.my-promotion-scroll { position: absolute; top: 0; right: 0; bottom: 0; left: 0; z-index: 1; box-sizing: border-box; background: transparent; }
.my-promotion-content { min-height: 100%; padding: 0 36rpx calc(80rpx + env(safe-area-inset-bottom)); box-sizing: border-box; }

/* 骨架：人数大字、说明行、记录条数与记录行头像 */
.my-promotion-sk-value { width: 120rpx; height: 90rpx; margin-top: 14rpx; }
.my-promotion-sk-note { width: 260rpx; height: 22rpx; margin-top: 16rpx; }
.my-promotion-sk-count { width: 90rpx; height: 20rpx; }
.my-promotion-sk-avatar { flex: 0 0 auto; width: 76rpx; height: 76rpx; margin: 30rpx 18rpx 0 0; }
.my-promotion-state { padding: 90rpx 24rpx 40rpx; text-align: center; }
.my-promotion-state-title { display: block; color: #24332D; font-size: 32rpx; font-weight: 600; }
.my-promotion-state-copy { display: block; margin: 22rpx 0 32rpx; color: #7D877F; font-size: 25rpx; line-height: 1.6; }
.my-promotion-state-action { display: inline-flex; height: 76rpx; align-items: center; padding: 0 44rpx; border-radius: 20rpx; background: #FD7C02; color: #FFFFFF; font-size: 26rpx; }
.my-promotion-state-action:active { opacity: .78; }

.my-promotion-overview { padding: 8rpx 8rpx 24rpx; }
.my-promotion-overview-main { display: flex; min-height: 0; align-items: flex-start; justify-content: space-between; }
.my-promotion-overview-copy { min-width: 0; flex: 1; }
.my-promotion-overview-label { display: block; color: #24332D; font-size: 29rpx; font-weight: 700; line-height: 1.25; }
.my-promotion-overview-value { display: block; margin-top: 14rpx; color: #24332D; font-size: 96rpx; font-weight: 500; letter-spacing: -2rpx; line-height: .95; }
.my-promotion-overview-note { display: block; padding-top: 16rpx; color: #98A49C; font-size: 21rpx; line-height: 1.2; }
.my-promotion-section-heading { display: flex; align-items: baseline; justify-content: space-between; margin: 42rpx 4rpx 0; }
.my-promotion-section-title { color: #24332D; font-size: 30rpx; font-weight: 700; line-height: 1.25; }
.my-promotion-section-count { color: #A2ACA5; font-size: 19rpx; }

.record-tabs { display: flex; width: 100%; height: 76rpx; margin-top: 22rpx; align-items: flex-end; border-radius: 26rpx 26rpx 0 0; background: #EEF1EF; overflow: visible; }
.record-tab { position: relative; display: flex; flex: 1; height: 76rpx; align-items: center; justify-content: center; color: #89948D; font-size: 23rpx; line-height: 1; text-align: center; }
.record-tab.is-selected { z-index: 2; border-radius: 26rpx 26rpx 0 0; background: #FFFFFF; color: #4A514C; font-weight: 650; }
/* 与金币页保持一致：选中标签底部用遮罩补齐外侧圆角。 */
.record-tab.is-selected::before, .record-tab.is-selected::after { position: absolute; bottom: 0; width: 32rpx; height: 32rpx; background: inherit; content: ''; pointer-events: none; -webkit-mask-image: radial-gradient(100% 100% at center, transparent 49%, #000 51%); mask-image: radial-gradient(100% 100% at center, transparent 49%, #000 51%); -webkit-mask-size: 200% 200%; mask-size: 200% 200%; }
.record-tab.is-selected::before { left: -32rpx; -webkit-mask-position: 100% 100%; mask-position: 100% 100%; }
.record-tab.is-selected::after { right: -32rpx; -webkit-mask-position: 0 100%; mask-position: 0 100%; }
.record-tab:first-child.is-selected::before { display: none; }
.record-tab:last-child.is-selected::after { display: none; }

.records-card { min-height: 0; margin-top: 0; padding: 8rpx 24rpx; box-sizing: border-box; border: 0; border-radius: 0 0 36rpx 36rpx; background: #FFFFFF; }
.record-group { display: block; }
.record-item { display: flex; min-height: 146rpx; }
.my-promotion-record-avatar { display: block; flex: 0 0 auto; width: 76rpx; height: 76rpx; margin: 30rpx 18rpx 0 0; overflow: hidden; border: 4rpx solid rgba(255, 255, 255, .92); border-radius: 50%; background: #E4E7E5; }
.record-copy { min-width: 0; flex: 1; padding: 30rpx 0 24rpx; }
.record-title-row, .record-meta { display: flex; align-items: center; justify-content: space-between; }
.my-promotion-record-name-row { display: flex; min-width: 0; flex: 1; align-items: center; }
.record-title { min-width: 0; overflow: hidden; color: #24332D; font-size: 26rpx; font-weight: 600; line-height: 1.2; text-overflow: ellipsis; white-space: nowrap; }
.vip-mark { display: inline-flex; flex: 0 0 auto; align-items: center; justify-content: center; height: 34rpx; margin-left: 10rpx; padding: 0 12rpx; border-radius: 999rpx; background: linear-gradient(135deg, #A66431, #E2A83E); color: #FFF8E8; font-family: Georgia, serif; font-size: 21rpx; font-style: italic; font-weight: 700; line-height: 34rpx; }
.vip-mark.is-inactive { background: #E1E5E2; color: #8F9992; }
.record-detail { display: block; margin-top: 12rpx; overflow: hidden; color: #4A514C; font-size: 20rpx; line-height: 1.2; text-overflow: ellipsis; white-space: nowrap; }
.record-meta { margin-top: 13rpx; color: #98A39B; font-size: 18rpx; line-height: 1; }
.record-status { padding: 6rpx 12rpx; border-radius: 999rpx; background: #F1F3F1; color: #7E8982; font-size: 17rpx; }
.records-empty { display: flex; align-items: center; justify-content: center; min-height: 280rpx; flex-direction: column; color: #8C9991; }
.records-empty-title { color: #4E6157; font-size: 28rpx; font-weight: 650; }
.records-empty-hint { margin-top: 14rpx; font-size: 20rpx; }
.my-promotion-records-card { margin-top: 0; }
.my-promotion-records-card .record-item:active { opacity: .7; }

@media (max-width: 350px) {
  .my-promotion-content { padding-right: 28rpx; padding-left: 28rpx; }
  .my-promotion-overview-value { font-size: 84rpx; }
  .record-tabs { height: 72rpx; }
  .record-tab { height: 72rpx; }
}

@import "./index.large.wxss"; /* 平板、电脑大屏样式：由 scripts/build-large-screen-styles.mjs 生成，改完本文件后重跑；这一行须留在文件末尾 */
