<wxs module="UA" src="../../utils/ui-asset.wxs" />
<view class="my-promotion-page">
  <view class="my-promotion-ambient" aria-hidden="true"><view class="my-promotion-ambient-ribbon"><view class="my-promotion-ambient-ribbon-inner"></view></view></view>
  <view class="my-promotion-topbar">
    <view class="my-promotion-topbar-inner" style="height: {{navigationBarHeight}}px; padding-top: {{statusBarHeight}}px;">
      <view class="my-promotion-back" bindtap="handleBack" aria-label="返回推广伙伴" aria-role="button">
        <view class="my-promotion-back-icon"></view>
      </view>
      <text class="my-promotion-topbar-title" style="top: {{statusBarHeight}}px; height: {{navigationBarHeight}}px; line-height: {{navigationBarHeight}}px;">{{title}}</text>
    </view>
  </view>

  <scroll-view class="my-promotion-scroll" scroll-y enhanced="{{true}}" show-scrollbar="{{false}}" style="padding-top: {{contentTop}}px;">
    <view class="my-promotion-content">
      <view class="my-promotion-state" wx:if="{{loadState === 'failed'}}">
        <text class="my-promotion-state-title">我的推广暂时无法加载</text>
        <text class="my-promotion-state-copy">{{loadError}}</text>
        <view class="my-promotion-state-action" bindtap="loadPage" aria-role="button">重新加载</view>
      </view>

      <block wx:else>
        <view class="my-promotion-overview">
          <view class="my-promotion-overview-main">
            <view class="my-promotion-overview-copy">
              <text class="my-promotion-overview-label">已邀请人数</text>
              <block wx:if="{{loadState === 'ready'}}">
                <text class="my-promotion-overview-value">{{summary.invitedValue}}</text>
                <text class="my-promotion-overview-note">{{summary.note}}</text>
              </block>
              <block wx:else>
                <view class="sk my-promotion-sk-value"></view>
                <view class="sk sk-line my-promotion-sk-note"></view>
              </block>
            </view>
          </view>
        </view>

        <view class="my-promotion-section-heading">
          <text class="my-promotion-section-title">邀请记录</text>
          <text wx:if="{{loadState === 'ready'}}" class="my-promotion-section-count">{{visibleRecords.length}} 条记录</text>
          <view wx:else class="sk sk-inline my-promotion-sk-count"></view>
        </view>

        <view class="record-tabs" aria-label="邀请记录分类">
          <view wx:for="{{recordTabs}}" wx:key="id" class="record-tab {{item.isSelected ? 'is-selected' : ''}}" data-id="{{item.id}}" bindtap="handleRecordTab" aria-role="button">{{item.label}}</view>
        </view>

        <!-- 首次读到邀请记录前：记录行骨架（头像圆 + 两行文字），不先闪「暂无…」 -->
        <view wx:if="{{loadState !== 'ready'}}" class="records-card" aria-label="正在读取邀请记录">
          <view wx:for="{{[0, 1, 2]}}" wx:key="*this" class="record-item">
            <view class="sk sk-round my-promotion-sk-avatar"></view>
            <view class="record-copy">
              <view class="sk sk-line sk-short"></view>
              <view class="sk sk-line sk-mid"></view>
            </view>
          </view>
        </view>

        <scroll-view wx:else class="records-card my-promotion-records-card" scroll-y="{{true}}" enhanced="{{true}}" show-scrollbar="{{false}}" style="height: {{recordsHeight}}px; max-height: {{recordsHeight}}px;">
          <view wx:if="{{visibleRecords.length}}" class="record-list">
            <view class="record-group">
              <view wx:for="{{visibleRecords}}" wx:key="id" class="record-item" data-id="{{item.id}}" bindtap="handleRecordTap" aria-role="button" aria-label="查看{{item.name}}的绑定信息">
                <image class="my-promotion-record-avatar" src="{{UA.avatar(ui, item.avatarUrl)}}" mode="aspectFill" aria-hidden="true"></image>
                <view class="record-copy">
                  <view class="record-title-row">
                    <view class="my-promotion-record-name-row">
                      <text class="record-title">{{item.name}}</text>
                      <text class="vip-mark {{item.membershipActive ? '' : 'is-inactive'}}">VIP</text>
                    </view>
                  </view>
                  <text class="record-detail">{{item.stageLabel}} · {{item.sourceLabel}}</text>
                  <view class="record-meta"><text>{{item.attributedLabel}}</text><text class="record-status">{{item.statusLabel}}</text></view>
                </view>
              </view>
            </view>
          </view>
          <view wx:else class="records-empty">
            <text class="records-empty-title">{{activeTabId === 'member' ? '暂无已加入课程会员的用户' : '暂无未加入课程会员的用户'}}</text>
            <text class="records-empty-hint">通过你的邀请码或推广链接绑定后，会显示在这里。</text>
          </view>
        </scroll-view>
      </block>
    </view>
  </scroll-view>
</view>
<dev-reset-fab />
