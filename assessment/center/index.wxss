page { background: #F7FAFC; }

.assessment-page { height: 100vh; overflow: hidden; background: #F7FAFC; color: #24332d; }
.assessment-topbar { position: fixed; top: 0; left: 0; z-index: 20; width: 100%; box-sizing: border-box; background: #F7FAFC; }
.assessment-topbar-inner { position: relative; display: flex; align-items: center; box-sizing: content-box; padding: 0 36rpx 16rpx; }
.assessment-back { display: flex; flex: 0 0 auto; align-items: center; justify-content: center; width: 44rpx; height: 44rpx; margin-right: 10rpx; }
.assessment-back-icon { width: 20rpx; height: 20rpx; border-bottom: 3rpx solid #24332d; border-left: 3rpx solid #24332d; transform: rotate(45deg) scale(.72); }
.assessment-topbar-title { position: absolute; left: 50%; display: block; color: #24332d; font-size: 36rpx; font-weight: 700; letter-spacing: -1rpx; transform: translateX(-50%); white-space: nowrap; }
.assessment-scroll { height: 100vh; box-sizing: border-box; background: #F7FAFC; }
.assessment-shell { min-height: 100%; padding: 24rpx 32rpx 150rpx; box-sizing: border-box; }

.assessment-hero { position: relative; display: flex; min-height: 210rpx; overflow: hidden; padding: 22rpx 10rpx 14rpx; box-sizing: border-box; background: transparent; }
.assessment-hero-copy { position: relative; z-index: 2; min-width: 0; flex: 1; }
.assessment-hero-title { display: block; max-width: 390rpx; margin-top: 22rpx; color: #24332d; font-size: 34rpx; font-weight: 700; line-height: 1.28; }
.assessment-hero-subtitle { display: block; max-width: 390rpx; margin-top: 16rpx; color: #73827B; font-size: 22rpx; line-height: 1.45; }
.assessment-hero-visual { position: absolute; right: 14rpx; bottom: 10rpx; width: 218rpx; height: 210rpx; transform: rotate(4deg); }
.report-shadow { position: absolute; right: 14rpx; bottom: 14rpx; width: 164rpx; height: 34rpx; border-radius: 50%; background: rgba(86,139,184,.16); filter: blur(5rpx); }
.report-sheet { position: absolute; top: 18rpx; right: 38rpx; width: 132rpx; height: 168rpx; padding: 24rpx 16rpx; box-sizing: border-box; border: 3rpx solid rgba(91,137,210,.24); border-radius: 12rpx; background: rgba(255,255,255,.88); box-shadow: 0 12rpx 24rpx rgba(99,137,184,.18); transform: rotate(-9deg); }
.report-sheet-line { height: 7rpx; border-radius: 999rpx; background: #B9D4F4; }
.report-sheet-line-long { width: 78rpx; }
.report-sheet-line-short { width: 52rpx; margin-top: 10rpx; background: #D8E6F6; }
.report-mini-chart { display: flex; align-items: flex-end; justify-content: space-between; height: 58rpx; margin-top: 22rpx; padding: 0 9rpx 7rpx; border-bottom: 2rpx solid #D2E1F0; background: repeating-linear-gradient(to bottom, transparent 0, transparent 17rpx, #E9F1F8 18rpx, transparent 19rpx); }
.report-mini-bar { width: 13rpx; border-radius: 5rpx 5rpx 0 0; background: #8DB7ED; }
.report-mini-bar-one { height: 24rpx; }.report-mini-bar-two { height: 43rpx; background: #FDAD68; }.report-mini-bar-three { height: 34rpx; background: #9BCFB6; }
.report-sheet-check { position: absolute; right: 16rpx; bottom: 18rpx; width: 20rpx; height: 11rpx; border-bottom: 4rpx solid #6EB58B; border-left: 4rpx solid #6EB58B; transform: rotate(-45deg); }
.report-orbit { position: absolute; border: 5rpx solid rgba(101,167,233,.62); border-radius: 50%; transform: rotate(-20deg); }
.report-orbit-back { right: 2rpx; bottom: 22rpx; width: 190rpx; height: 42rpx; border-top-color: transparent; border-left-color: transparent; }
.report-orbit-front { right: 0; bottom: 40rpx; width: 190rpx; height: 48rpx; border-right-color: transparent; border-bottom-color: transparent; opacity: .65; }
.stats-section { margin-top: 28rpx; }
.stats-section-title { padding: 0 4rpx; }
.assessment-stats-row { display: flex; gap: 14rpx; margin-top: 18rpx; }
.assessment-stat { display: flex; flex: 1; min-width: 0; height: 132rpx; overflow: hidden; padding: 20rpx; box-sizing: border-box; align-items: center; border-radius: 40rpx; background: #fff; color: #35433C; }
.assessment-stat-icon { display: block; flex: 0 0 auto; width: 82rpx; height: 82rpx; filter: drop-shadow(0 4rpx 6rpx rgba(54, 78, 92, .14)); }
.assessment-stat-copy { display: flex; align-self: stretch; min-width: 0; flex: 1; margin-left: 18rpx; justify-content: center; flex-direction: column; }
.assessment-stat-value { display: block; margin-top: 4rpx; font-size: 32rpx; font-weight: 700; line-height: 1; }
.assessment-stat-value.orange { color: #FFB56C; }.assessment-stat-value.green { color: #69A47B; }.assessment-stat-value.purple { color: #978DFF; }
.assessment-stat-label { overflow: hidden; max-width: 100%; color: #7B8982; font-size: 19rpx; line-height: 1; text-overflow: ellipsis; white-space: nowrap; }
.assessment-section { margin-top: 38rpx; }
.assessment-section-heading { display: flex; align-items: flex-end; justify-content: space-between; padding: 0 4rpx; }
.assessment-section-heading-stacked { display: block; }
.assessment-section-title { display: block; color: #2F3F37; font-size: 27rpx; font-weight: 700; line-height: 1.3; }
.assessment-section-subtitle { display: block; margin-top: 9rpx; color: #9AA7A0; font-size: 20rpx; line-height: 1.35; }
.subject-list { display: flex; flex-wrap: wrap; justify-content: space-between; margin-top: 20rpx; }
.subject-card { position: relative; display: flex; width: calc((100% - 16rpx) / 2); min-height: 204rpx; margin-top: 16rpx; padding: 24rpx; box-sizing: border-box; align-items: stretch; border-radius: 40rpx; background: #fff; }
.subject-card:nth-child(-n + 2) { margin-top: 0; }
.subject-card-dot { position: absolute; top: 22rpx; right: 22rpx; width: 12rpx; height: 12rpx; border-radius: 50%; }
.subject-copy { display: flex; min-width: 0; flex: 1; flex-direction: column; }
.subject-title-row { display: flex; align-items: center; min-width: 0; }
.subject-title { min-width: 0; overflow: hidden; color: #33433A; font-size: 24rpx; font-weight: 650; line-height: 1.25; text-overflow: ellipsis; white-space: nowrap; }
.subject-subtitle { display: block; margin-top: 12rpx; overflow: hidden; color: #9AA7A0; font-size: 19rpx; line-height: 1.3; text-overflow: ellipsis; white-space: nowrap; }
.subject-footer { display: flex; align-items: center; justify-content: space-between; margin-top: auto; }
.subject-footer-meta { display: flex; min-width: 0; align-items: center; }
.subject-status { flex: 0 0 auto; padding: 7rpx 12rpx; border-radius: 999rpx; background: #F3F5F3; color: #98A49C; font-size: 17rpx; line-height: 1; }
.subject-status.in-progress { background: #FFF0E3; color: #E8863F; }
.subject-duration { overflow: hidden; min-width: 0; margin-left: 8rpx; color: #A4AEA7; font-size: 18rpx; line-height: 1; text-overflow: ellipsis; white-space: nowrap; }
.subject-action { display: flex; flex: 0 0 auto; width: 76rpx; height: 42rpx; align-items: center; justify-content: center; margin-left: 8rpx; border-radius: 999rpx; background: rgba(253,124,2,.11); color: #FD7C02; font-size: 18rpx; line-height: 1; }

.history-section { margin-top: 40rpx; }
.history-heading-copy { display: flex; min-width: 0; align-items: baseline; }
.history-count { margin-left: 12rpx; color: #9AA7A0; font-size: 20rpx; line-height: 1.3; }
.history-link { display: flex; align-items: center; color: #A0AAA3; font-size: 19rpx; line-height: 1; }
.history-link-arrow { display: block; width: 10rpx; height: 10rpx; margin-left: 8rpx; box-sizing: border-box; border-top: 2rpx solid #A0AAA3; border-right: 2rpx solid #A0AAA3; transform: rotate(45deg); }
.history-list { margin-top: 20rpx; }
.history-card { display: flex; align-items: center; min-height: 132rpx; margin-top: 14rpx; padding: 24rpx; box-sizing: border-box; border-radius: 40rpx; background: #fff; }
.history-card:first-child { margin-top: 0; }
.history-copy { min-width: 0; flex: 1; }
.history-subject, .history-detail, .history-date { display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.history-subject { color: #39483F; font-size: 23rpx; font-weight: 650; line-height: 1.2; }
.history-detail { margin-top: 8rpx; color: #9BA6A0; font-size: 18rpx; line-height: 1.2; }
.history-date { margin-top: 8rpx; color: #B2BCB5; font-size: 17rpx; line-height: 1.2; }
.history-result { display: flex; flex: 0 0 auto; align-items: center; margin-left: 10rpx; }
.history-result-arrow { width: 12rpx; height: 12rpx; box-sizing: border-box; border-top: 2rpx solid #B1BBB4; border-right: 2rpx solid #B1BBB4; transform: rotate(45deg); }
@media (max-width: 350px) {
  .assessment-shell { padding-right: 24rpx; padding-left: 24rpx; }
  .assessment-hero { padding-right: 0; padding-left: 0; }
  .assessment-hero-title { max-width: 340rpx; font-size: 31rpx; }
  .assessment-hero-visual { right: -18rpx; transform: scale(.86) rotate(4deg); transform-origin: right bottom; }
  .subject-action { width: 68rpx; }
}
