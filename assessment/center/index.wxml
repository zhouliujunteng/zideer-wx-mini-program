<view class="assessment-page">
  <view class="assessment-topbar">
    <view class="assessment-topbar-inner" style="height: {{navigationBarHeight}}px; padding-top: {{statusBarHeight}}px;">
      <view class="assessment-back" bindtap="handleBack" aria-label="返回我的"><view class="assessment-back-icon"></view></view>
      <text class="assessment-topbar-title" style="top: {{statusBarHeight}}px; height: {{navigationBarHeight}}px; line-height: {{navigationBarHeight}}px;">{{model.title}}</text>
    </view>
  </view>

  <scroll-view class="assessment-scroll" scroll-y style="padding-top: {{contentTop}}px;">
    <view class="assessment-shell">
      <view class="assessment-hero">
        <view class="assessment-hero-copy">
          <text class="assessment-hero-title">{{model.heroTitle}}</text>
          <text class="assessment-hero-subtitle">{{model.heroSubtitle}}</text>
        </view>
        <view class="assessment-hero-visual" aria-label="测评报告插画">
          <view class="report-shadow"></view>
          <view class="report-sheet">
            <view class="report-sheet-line report-sheet-line-long"></view>
            <view class="report-sheet-line report-sheet-line-short"></view>
            <view class="report-mini-chart">
              <view class="report-mini-bar report-mini-bar-one"></view>
              <view class="report-mini-bar report-mini-bar-two"></view>
              <view class="report-mini-bar report-mini-bar-three"></view>
            </view>
            <view class="report-sheet-check"></view>
          </view>
          <view class="report-orbit report-orbit-back"></view>
          <view class="report-orbit report-orbit-front"></view>
        </view>
      </view>

      <view class="assessment-section stats-section">
        <text class="assessment-section-title stats-section-title">{{model.statsTitle}}</text>
        <view class="assessment-stats-row">
          <view wx:for="{{model.stats}}" wx:key="label" class="assessment-stat {{item.tone}}">
            <image class="assessment-stat-icon" src="{{item.icon}}" mode="aspectFit"></image>
            <view class="assessment-stat-copy">
              <text class="assessment-stat-label">{{item.label}}</text>
              <text class="assessment-stat-value {{item.numberTone}}">{{item.value}}</text>
            </view>
          </view>
        </view>
      </view>

      <view class="assessment-section">
        <view class="assessment-section-heading assessment-section-heading-stacked">
          <text class="assessment-section-title">{{model.basicSection.title}}</text>
        </view>
        <view class="subject-list">
          <view wx:for="{{model.subjects}}" wx:key="key" class="subject-card {{item.disabled ? 'subject-card-disabled' : ''}}" data-type="subject" data-subject-key="{{item.key}}" bindtap="handleAction">
            <view class="subject-copy">
              <view class="subject-title-row">
                <text class="subject-title">{{item.name}}</text>
                <text class="subject-count" wx:if="{{item.readyCount}}">{{item.readyCount}} 个范围可测</text>
              </view>
              <text class="subject-subtitle">{{item.readyCount ? '点击开始摸底诊断' : '题库正在准备，敬请期待'}}</text>
              <view class="subject-footer">
                <view class="subject-footer-meta">
                  <text class="subject-status {{item.statusTone}}">{{item.displayStatus}}</text>
                </view>
                <text class="subject-action">{{item.actionLabel}}</text>
              </view>
            </view>
          </view>
        </view>
      </view>

      <view class="assessment-section history-section">
        <view class="assessment-section-heading">
          <view class="history-heading-copy">
            <text class="assessment-section-title">{{model.history.title}}</text>
            <text class="history-count">{{model.history.countLabel}}</text>
          </view>
          <view class="history-link" data-type="history" bindtap="handleAction"><text>{{model.history.actionLabel}}</text><view class="history-link-arrow"></view></view>
        </view>
        <view class="history-list">
          <view wx:for="{{model.history.records}}" wx:key="id" class="history-card" data-type="history" data-subject-key="{{item.subjectKey}}" bindtap="handleAction">
            <view class="history-copy">
              <text class="history-subject">{{item.subject}}</text>
              <text class="history-detail">{{item.detail}}</text>
              <text class="history-date">{{item.date}}</text>
            </view>
            <view class="history-result"><view class="history-result-arrow"></view></view>
          </view>
        </view>
      </view>

    </view>
  </scroll-view>
</view>
<dev-reset-fab />
