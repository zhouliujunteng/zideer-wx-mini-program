<wxs module="UA" src="../../utils/ui-asset.wxs" />
<view class="assessment-page">
  <view class="assessment-topbar">
    <view class="assessment-topbar-inner" style="height: {{navigationBarHeight}}px; padding-top: {{statusBarHeight}}px;">
      <view class="assessment-back" bindtap="handleBack" aria-label="返回我的"><view class="assessment-back-icon"></view></view>
      <text class="assessment-topbar-title" style="top: {{statusBarHeight}}px; height: {{navigationBarHeight}}px; line-height: {{navigationBarHeight}}px;">{{model.title}}</text>
    </view>
  </view>

  <scroll-view class="assessment-scroll" scroll-y style="padding-top: {{contentTop}}px;">
    <view class="assessment-shell">
      <view class="assessment-hero">
        <view class="assessment-hero-copy">
          <text class="assessment-hero-title">{{model.heroTitle}}</text>
          <text class="assessment-hero-subtitle">{{model.heroSubtitle}}</text>
        </view>
        <view class="assessment-hero-visual" aria-label="测评报告插画">
          <view class="report-shadow"></view>
          <view class="report-sheet">
            <view class="report-sheet-line report-sheet-line-long"></view>
            <view class="report-sheet-line report-sheet-line-short"></view>
            <view class="report-mini-chart">
              <view class="report-mini-bar report-mini-bar-one"></view>
              <view class="report-mini-bar report-mini-bar-two"></view>
              <view class="report-mini-bar report-mini-bar-three"></view>
            </view>
            <view class="report-sheet-check"></view>
          </view>
          <view class="report-orbit report-orbit-back"></view>
          <view class="report-orbit report-orbit-front"></view>
        </view>
      </view>

      <!-- 深度测评金币（2026-11-14）：一共可获得 / 已获得 / 未获得，下面是金币结算规则；免费版常驻一条次数与提现说明 -->
      <view wx:if="{{loaded && model.deep.reward}}" class="coin-card">
        <view class="deep-banner" bindtap="showRewardRule" aria-role="button" aria-label="深度测评奖励说明">
          <image class="deep-banner-art" src="{{UA.src(ui, '/assets/universe/deep-assessment-poster.png')}}" mode="aspectFill"></image>
          <view class="deep-banner-copy">
            <text class="deep-banner-title">{{model.deep.reward.headline}}</text>
            <text class="deep-banner-sub">{{model.deep.reward.totalText}}</text>
            <view class="deep-banner-tags">
              <text class="deep-banner-tag is-strong">{{model.deep.reward.leftText}}</text>
              <text class="deep-banner-tag">{{model.deep.reward.rateText}}</text>
            </view>
          </view>
        </view>
        <view class="coin-sums">
          <view class="coin-sum">
            <text class="coin-sum-label">一共可获得</text>
            <view class="coin-sum-value"><view class="coin-dot" aria-hidden="true"></view><text>{{model.deep.reward.totalCoins}}</text></view>
            <text class="coin-sum-yuan">≈ {{model.deep.reward.totalYuan}} 元</text>
          </view>
          <view class="coin-sum is-earned">
            <text class="coin-sum-label">已获得</text>
            <view class="coin-sum-value"><view class="coin-dot" aria-hidden="true"></view><text>{{model.deep.reward.earnedCoins}}</text></view>
            <text class="coin-sum-yuan">≈ {{model.deep.reward.earnedYuan}} 元</text>
          </view>
          <view class="coin-sum is-remaining">
            <text class="coin-sum-label">未获得</text>
            <view class="coin-sum-value"><view class="coin-dot" aria-hidden="true"></view><text>{{model.deep.reward.remainingCoins}}</text></view>
            <text class="coin-sum-yuan">≈ {{model.deep.reward.remainingYuan}} 元</text>
          </view>
        </view>
        <view class="coin-bar" aria-hidden="true"><view class="coin-bar-fill" style="width: {{model.deep.reward.percent}}%;"><view class="coin-bar-shine"></view></view></view>
        <text class="coin-bar-text">{{model.deep.reward.progressText}} · {{model.deep.progressText}}</text>
        <text wx:if="{{model.deep.reward.preview}}" class="coin-preview">预览数据：活动上线后以后台配置为准</text>
      </view>
      <view wx:if="{{loaded && model.deep.reward}}" class="rule-card">
        <text class="rule-title">金币结算规则</text>
        <view wx:for="{{model.deep.reward.rules}}" wx:key="*this" class="rule-row">
          <text class="rule-no">{{index + 1}}</text>
          <text class="rule-text">{{item}}</text>
        </view>
      </view>
      <view wx:if="{{loaded && model.deep.reward.free}}" class="deep-free" role="alert">
        <text class="deep-free-title">{{model.deep.reward.freeTitle}}</text>
        <text class="deep-free-text">{{model.deep.reward.freeNotice}}</text>
      </view>

      <view class="assessment-section stats-section">
        <text class="assessment-section-title stats-section-title">{{model.statsTitle}}</text>
        <view class="assessment-stats-row">
          <view wx:for="{{model.stats}}" wx:key="label" class="assessment-stat {{item.tone}}">
            <image class="assessment-stat-icon" src="{{UA.src(ui, item.icon)}}" mode="aspectFit"></image>
            <view class="assessment-stat-copy">
              <text class="assessment-stat-label">{{item.label}}</text>
              <text wx:if="{{loaded}}" class="assessment-stat-value {{item.numberTone}}">{{item.value}}</text>
              <view wx:else class="sk assessment-stat-value-sk"></view>
            </view>
          </view>
        </view>
      </view>

      <!-- 按目标测评（2026-10-10）：主入口，排在整科摸底前面 -->
      <view class="goal-entry" bindtap="openGoalDiagnosis" aria-role="button" aria-label="按目标测评">
        <view class="goal-entry-icon" aria-hidden="true"><view class="goal-entry-ring"><view class="goal-entry-dot"></view></view></view>
        <view class="goal-entry-copy">
          <view class="goal-entry-title-row"><text class="goal-entry-title">按目标测评</text><text class="goal-entry-badge">推荐</text></view>
          <text class="goal-entry-desc">围绕你的学习目标出题，做错的地方往前找原因，生成目标导图</text>
        </view>
        <view class="goal-entry-chevron" aria-hidden="true"></view>
      </view>

      <view class="assessment-section">
        <view class="assessment-section-heading assessment-section-heading-stacked">
          <text class="assessment-section-title">{{model.basicSection.title}}</text>
          <text wx:if="{{model.basicSection.subtitle}}" class="assessment-section-subtitle">{{model.basicSection.subtitle}}</text>
          <text wx:if="{{loaded && model.deep.reward}}" class="deep-left">{{model.deep.reward.leftText}} · {{model.deep.reward.perTestText}}</text>
        </view>
        <!-- 第一次读取失败：给出重试，不显示空列表 -->
        <view wx:if="{{!loaded && loadFailed}}" class="assessment-load-failed">
          <text class="assessment-load-failed-text">测评中心暂时没有加载出来</text>
          <view class="assessment-load-failed-action" bindtap="retryLoad">重新加载</view>
        </view>
        <view wx:elif="{{!loaded}}" class="subject-list">
          <view wx:for="{{[1, 2, 3, 4]}}" wx:key="*this" class="subject-card">
            <view class="subject-copy">
              <view class="sk sk-line sk-mid"></view>
              <view class="sk sk-line subject-subtitle-sk"></view>
              <view class="subject-footer"><view class="sk subject-status-sk"></view><view class="sk subject-action-sk"></view></view>
            </view>
          </view>
        </view>
        <view wx:else class="module-list">
          <!-- 每个学科一个模块：没测的是灰的，进行中橙色，完成的点亮；模块上写完成能得多少金币 / 已获得多少 -->
          <view wx:for="{{model.subjects}}" wx:key="key" class="module is-{{item.state}} {{item.locked ? 'is-locked' : ''}}" data-type="subject" data-subject-key="{{item.key}}" bindtap="handleAction" aria-role="button" aria-label="{{item.name}}深度测评，{{item.stateLabel}}">
            <view class="module-head">
              <view class="module-mark"><text>{{item.mark}}</text><view wx:if="{{item.state === 'done'}}" class="module-check" aria-hidden="true"><view class="module-check-tick"></view></view></view>
              <view class="module-title-box">
                <text class="module-name">{{item.name}}</text>
                <text class="module-state">{{item.stateLabel}}{{item.roundsLabel ? ' · ' + item.roundsLabel : ''}}</text>
              </view>
            </view>
            <view wx:if="{{item.coinText}}" class="module-coin is-{{item.coinTone}}"><view class="coin-dot" aria-hidden="true"></view><text>{{item.coinText}}</text></view>
            <text wx:else class="module-note">{{item.state === 'unready' ? '题库正在准备' : item.state === 'done' ? '可查看报告或再测一次' : '一科一张完整的卷'}}</text>
            <view class="module-action">{{item.locked ? '次数已用完' : item.moduleAction}}</view>
          </view>
        </view>
      </view>

      <view class="assessment-section history-section">
        <view class="assessment-section-heading">
          <view class="history-heading-copy">
            <text class="assessment-section-title">{{model.history.title}}</text>
            <text wx:if="{{loaded}}" class="history-count">{{model.history.countLabel}}</text>
            <view wx:elif="{{!loadFailed}}" class="sk sk-inline history-count-sk"></view>
          </view>
          <view class="history-link" data-type="history" bindtap="handleAction"><text>{{model.history.actionLabel}}</text><view class="history-link-arrow"></view></view>
        </view>
        <view wx:if="{{!loaded && !loadFailed}}" class="history-list">
          <view wx:for="{{[1, 2]}}" wx:key="*this" class="history-card">
            <view class="history-copy"><view class="sk sk-line sk-short"></view><view class="sk sk-line sk-mid"></view></view>
          </view>
        </view>
        <text wx:elif="{{loaded && !model.history.records.length}}" class="history-empty">完成一轮测评后，结论会记录在这里。</text>
        <view wx:elif="{{loaded}}" class="history-list">
          <view wx:for="{{model.history.records}}" wx:key="id" class="history-card" data-type="record" data-attempt-id="{{item.id}}" bindtap="handleAction">
            <view class="history-copy">
              <view class="history-subject-row">
                <text class="history-subject">{{item.subject}}</text>
                <text wx:if="{{item.deltaLabel}}" class="history-delta {{item.deltaTone}}">{{item.deltaLabel}}</text>
              </view>
              <text class="history-detail">{{item.detail}}</text>
              <text class="history-date">{{item.date}}</text>
            </view>
            <view class="history-result"><view class="history-result-arrow"></view></view>
          </view>
        </view>
      </view>

    </view>
  </scroll-view>
</view>
<dev-reset-fab />
