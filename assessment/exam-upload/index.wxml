<view class="screen assessment-exam-upload"><view class="assessment-exam-upload__inner">
  <view class="skeleton assessment-exam-upload__skeleton" wx:if="{{loading}}"></view>
  <block wx:else>
    <view class="assessment-exam-upload__heading"><text class="assessment-exam-upload__eyebrow">可选补充</text><text class="assessment-exam-upload__title">上传试卷照片</text><text class="assessment-exam-upload__copy">按实际页序上传清晰的整页照片，最多 10 页。原图以私有资产保存，识别结果会在下一步确认。</text></view>
    <view class="surface assessment-exam-upload__form"><text class="assessment-exam-upload__form-title">试卷信息</text><picker range="{{recordOptions}}" value="{{recordIndex}}" bindchange="chooseRecord"><view class="assessment-exam-upload__field"><text>{{recordOptions[recordIndex]}}</text><text>›</text></view></picker><input class="assessment-exam-upload__input" value="{{form.examName}}" placeholder="试卷名称，例如：八年级上学期期中" data-key="examName" bindinput="updateForm"/><picker mode="date" value="{{form.examDate}}" bindchange="chooseDate"><view class="assessment-exam-upload__field"><text>{{form.examDate || '选择考试日期'}}</text><text>›</text></view></picker></view>
    <view class="assessment-exam-upload__section"><view class="assessment-exam-upload__section-head"><text class="section-title">试卷页序</text><text class="assessment-exam-upload__count">{{pages.length}} / 10</text></view><view class="assessment-exam-upload__empty surface" wx:if="{{!pages.length}}"><text>还没有添加试卷页面</text></view><view class="assessment-exam-upload__pages"><view class="surface assessment-exam-upload__page" wx:for="{{pages}}" wx:key="id"><image wx:if="{{item.localPath}}" class="assessment-exam-upload__thumb" src="{{item.localPath}}" mode="aspectFill"/><view wx:else class="assessment-exam-upload__thumb assessment-exam-upload__thumb--saved"><text>{{item.label}}</text></view><view class="assessment-exam-upload__page-main"><text class="assessment-exam-upload__page-title">{{item.label}}</text><text class="assessment-exam-upload__page-meta">{{item.localPath ? item.sizeLabel : '已保存到私有文件库'}}</text></view><view class="assessment-exam-upload__tools"><button class="assessment-exam-upload__tool pressable" disabled="{{index === 0}}" data-index="{{index}}" data-direction="-1" bindtap="movePage">上移</button><button class="assessment-exam-upload__tool pressable" disabled="{{index === pages.length - 1}}" data-index="{{index}}" data-direction="1" bindtap="movePage">下移</button><button class="assessment-exam-upload__tool assessment-exam-upload__tool--danger pressable" data-index="{{index}}" bindtap="removePage">删除</button></view></view></view></view>
    <view class="assessment-exam-upload__sources"><button class="assessment-exam-upload__source pressable" bindtap="chooseFromCamera">拍照添加</button><button class="assessment-exam-upload__source pressable" bindtap="chooseFromAlbum">从相册选择</button></view>
    <button class="assessment-exam-upload__save pressable" loading="{{uploading || saving}}" disabled="{{uploading || saving}}" bindtap="uploadAndSave">上传并保存</button><button class="assessment-exam-upload__skip pressable" bindtap="continueToAnalysis">暂不上传，进入分析</button>
  </block>
</view></view>
