.assessment-exam-upload { min-height: 100vh; padding: 0 28rpx calc(env(safe-area-inset-bottom) + 44rpx); }.assessment-exam-upload__inner { padding-top: 48rpx; }.assessment-exam-upload__heading { padding: 0 8rpx; }.assessment-exam-upload__eyebrow { display: block; color: var(--accent-deep); font-size: 22rpx; font-weight: 700; }.assessment-exam-upload__title { display: block; margin-top: 12rpx; font-size: 38rpx; font-weight: 700; line-height: 1.3; }.assessment-exam-upload__copy { display: block; margin-top: 12rpx; color: var(--muted); font-size: 22rpx; line-height: 1.55; }.assessment-exam-upload__form { margin-top: 34rpx; padding: 28rpx 24rpx; }.assessment-exam-upload__form-title { display: block; font-size: 28rpx; font-weight: 700; }.assessment-exam-upload__field, .assessment-exam-upload__input { display: flex; width: 100%; min-height: 84rpx; align-items: center; justify-content: space-between; margin-top: 18rpx; padding: 0 18rpx; border: 1rpx solid var(--line-strong); border-radius: 12rpx; background: var(--surface); color: var(--ink); font-size: 24rpx; }.assessment-exam-upload__section { margin-top: 36rpx; }.assessment-exam-upload__section-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 16rpx; }.assessment-exam-upload__count { color: var(--muted); font-size: 22rpx; }.assessment-exam-upload__empty { padding: 38rpx 24rpx; color: var(--muted); font-size: 24rpx; text-align: center; }.assessment-exam-upload__pages { display: flex; flex-direction: column; gap: 14rpx; }.assessment-exam-upload__page { display: flex; min-height: 138rpx; align-items: center; padding: 16rpx; }.assessment-exam-upload__thumb { width: 106rpx; height: 106rpx; flex: none; border-radius: 8rpx; background: var(--line); }.assessment-exam-upload__thumb--saved { display: flex; align-items: center; justify-content: center; padding: 12rpx; background: #eef1e8; color: #58713e; font-size: 20rpx; text-align: center; }.assessment-exam-upload__page-main { min-width: 0; flex: 1; margin-left: 18rpx; }.assessment-exam-upload__page-title, .assessment-exam-upload__page-meta { display: block; }.assessment-exam-upload__page-title { font-size: 25rpx; font-weight: 700; }.assessment-exam-upload__page-meta { margin-top: 8rpx; color: var(--muted); font-size: 21rpx; }.assessment-exam-upload__tools { display: flex; flex-direction: column; gap: 4rpx; margin-left: 12rpx; }.assessment-exam-upload__tool { min-height: 38rpx; padding: 0 8rpx; color: var(--accent-deep); font-size: 19rpx; line-height: 38rpx; }.assessment-exam-upload__tool[disabled] { color: var(--line-strong); }.assessment-exam-upload__tool--danger { color: #b94e40; }.assessment-exam-upload__sources { display: flex; gap: 16rpx; margin-top: 22rpx; }.assessment-exam-upload__source { display: flex; min-height: 82rpx; flex: 1; align-items: center; justify-content: center; border: 1rpx solid var(--line-strong); border-radius: 14rpx; background: var(--surface); color: var(--ink); font-size: 24rpx; font-weight: 600; }.assessment-exam-upload__save, .assessment-exam-upload__skip { display: flex; width: 100%; min-height: 86rpx; align-items: center; justify-content: center; border-radius: 18rpx; font-size: 26rpx; font-weight: 700; }.assessment-exam-upload__save { margin-top: 32rpx; background: var(--accent); color: var(--surface); }.assessment-exam-upload__skip { margin-top: 20rpx; border: 1rpx solid var(--line-strong); background: var(--surface); color: var(--ink); }.assessment-exam-upload__skeleton { height: 680rpx; border-radius: 24rpx; }
