/* 自动生成，请勿手改：index.wxss 在平板、电脑大屏（窗口宽 ≥ 450px）下的样式。
   rpx 按 1rpx = 0.6px 换算，固定定位元素收进居中栏；改完源文件后运行 node scripts/build-large-screen-styles.mjs */
@media (min-width: 450px) {
.sk{border-radius:7px;background:linear-gradient(90deg, #ECEEEB 25%, #F5F6F4 37%, #ECEEEB 63%);background-size:400% 100%}
.sk-line{height:16px}
.sk-line + .sk-line{margin-top:8px}
.sk-short{width:40%}
.sk-mid{width:64%}
.sk-round{border-radius:50%}
.sk-card{height:96px;border-radius:14px}
.sk-card + .sk-card{margin-top:12px}
page{background:#FAFAFA}
.report-page{height:100vh;background:#FAFAFA}
.report-ambient{top:0;right:max(0px, 50% - var(--lg-col) / 2);left:max(0px, 50% - var(--lg-col) / 2);height:336px;background:linear-gradient(180deg, rgba(250, 250, 250, 0) 0%, rgba(250, 250, 250, .36) 48%, #FAFAFA 100%), linear-gradient(105deg, #FBE5E5 0%, #FCE8E8 52%, #FAE5E4 100%)}
.report-topbar{top:0;right:max(0px, 50% - var(--lg-col) / 2);left:max(0px, 50% - var(--lg-col) / 2);background:linear-gradient(180deg, rgba(250, 250, 250, 0) 0%, rgba(250, 250, 250, .36) 48%, #FAFAFA 100%), linear-gradient(105deg, #FBE5E5 0%, #FCE8E8 52%, #FAE5E4 100%);background-repeat:no-repeat;background-position:top left;background-size:100% 336px, 100% 336px}
.report-topbar-inner{box-sizing:content-box;padding:0 19px 9px}
.report-back{width:32px;height:32px;flex:0 0 32px;border-radius:50%}
.report-back:active{background:#F0F1EF}
.back-chevron{width:13px;height:13px;border-bottom:2px solid #4B5650;border-left:2px solid #4B5650}
.report-topbar-title{left:50%;max-width:calc(100% - 138px);font-size:20px;font-weight:700;letter-spacing:-1px}
.report-share-button{border-radius:50%;background:rgba(255, 255, 255, .7)}
.report-share-button image{width:20px;height:20px}
.report-scroll{height:100vh;box-sizing:border-box}
.report-shell{padding:10px 16px calc(132px + env(safe-area-inset-bottom))}
.report-state-card{margin-top:24px;padding:33px 21px;flex-direction:column;border-radius:20px;background:#FFFFFF}
.report-state-title{font-size:18px;font-weight:700}
.report-state-copy{margin-top:8px;font-size:13px;line-height:1.6}
.report-state-action{margin-top:18px;padding:0 28px;height:45px;border-radius:599px;background:rgba(253, 124, 2, .14);font-size:15px;font-weight:650;line-height:45px}
.report-student-row{min-width:0;min-height:55px;margin:0 4px 9px}
.report-student-avatar{width:55px;height:55px;margin-right:14px;flex:0 0 55px;box-sizing:border-box;border:2px solid rgba(255, 255, 255, .78);border-radius:50%;background:rgba(255, 255, 255, .94)}
.report-student-name{min-width:0;font-size:22px;font-weight:500;line-height:1.25}
.report-cover{padding:9px 20px 18px;border-radius:20px;background:#FFFFFF}
.cover-main-row{min-width:0;gap:4px}
.cover-score-column{min-width:0;min-height:180px;flex:0 0 37%;flex-direction:column}
.cover-main-row.no-radar .cover-score-column{min-height:0;flex:1 1 auto;padding:15px 0 10px}
.cover-score-wrap{margin-top:5px;gap:4px}
.cover-score{font-size:46px;font-weight:700;letter-spacing:-2px;line-height:.95}
.cover-score-slash{font-size:17px;font-weight:500}
.cover-score-total{font-size:18px;font-weight:600}
.cover-score-label{font-size:12px;font-weight:600}
.cover-insight-list{max-width:100%;margin-top:8px;flex-direction:column;gap:7px}
.cover-insight-pill{max-width:100%;padding:5px 7px;box-sizing:border-box;border-radius:599px;font-size:9px;line-height:1.25}
.cover-insight-pill.strength{background:#FFF2EF}
.cover-insight-pill.priority{background:#F7F0F1}
.cover-radar-column{min-width:0;flex:1}
.cover-radar-canvas{width:100%;height:180px}
.radar-accessible-data{width:1px;height:1px}
.cover-meta-pill{min-width:0;min-height:28px;margin-top:4px;padding:0 11px;box-sizing:border-box;border-radius:599px;background:#F0F1F2;font-size:10px;line-height:1.3}
.cover-meta-copy{min-width:0}
.cover-advice{width:calc(100% - 16px);height:45px;margin:-6px auto 0;padding:10px 13px 4px;box-sizing:border-box;gap:7px;border-radius:0 0 14px 14px;background:linear-gradient(112deg, #FF7779 0%, #FA666A 54%, #F45B60 100%)}
.cover-advice-label{flex:0 0 auto;font-size:13px;font-weight:700;line-height:1.3}
.cover-advice-copy{min-width:0;flex:1;font-size:13px;line-height:1.35}
.report-card-shell{margin-top:26px}
.report-section-heading{height:44px;margin:0 0 7px}
.section-title-icon{top:-12px;right:4px;width:90px;height:72px}
.mastery-heading-icon{width:91px;height:79px;top:-17px;right:7px}
.weak-heading-icon{width:96px;height:74px;top:-13px;right:1px}
.path-heading-icon{width:93px;height:79px;top:-17px;right:2px}
.section-title-pill{width:max-content;min-width:0;max-width:100%;min-height:37px;margin:0;padding:0 16px;box-sizing:border-box;border-radius:20px 8px 20px 4px;background:linear-gradient(105deg, #F66D66 0%, #F04F4F 100%);box-shadow:0 1px 4px rgba(190, 67, 49, .14)}
.section-title{min-width:0;font-size:17px;font-weight:700;line-height:1.25}
.weak-section-title{font-size:16px}
.report-white-card{padding:18px 16px;border-radius:24px;background:#FFFFFF}
.summary-cell{min-width:0;flex:1;flex-direction:column;padding:9px 0 7px}
.summary-value{font-size:20px;font-weight:700;line-height:1.2}
.summary-label{font-size:10px}
.summary-cell-divider{width:1px;height:33px;margin:auto 3px;flex:0 0 1px;border-radius:599px;background:#D9DDE2}
.weak-list{flex-direction:column}
.weak-item{padding:12px 0;border-bottom:0.5px solid #F0F1F2}
.weak-item:last-child{border-bottom:0}
.weak-title-row{flex-wrap:wrap;gap:4px}
.weak-title{font-size:15px;font-weight:700;line-height:1.4}
.weak-category{font-size:10px}
.weak-reason{margin-top:5px;font-size:12px;line-height:1.5}
.weak-more{padding:2px 0 10px;font-size:11px;line-height:1.5}
.weak-empty{padding:2px 0 12px;font-size:13px;line-height:1.5}
.pending-box{padding:12px;border-radius:15px;background:#F7F8F6}
.pending-top{font-size:13px;font-weight:700}
.pending-mark{width:9px;height:9px;margin-right:6px;border:1px solid #ACB4AD;border-radius:50%}
.pending-description{margin-top:5px;font-size:11px;line-height:1.5}
.pending-tags{flex-wrap:wrap;gap:6px;margin-top:10px}
.pending-tag{padding:4px 8px;border-radius:599px;background:#FFFFFF;font-size:10px}
.pending-tag.is-more{background:transparent}
.path-estimate{flex-wrap:wrap;gap:6px;padding:12px 13px;border-radius:12px;background:#FFF4E9}
.estimate-label{font-size:11px}
.estimate-value{font-size:14px;font-weight:700}
.path-timeline{margin-top:17px}
.path-stage{gap:10px}
.stage-rail{width:30px;flex:0 0 30px;flex-direction:column}
.stage-index{width:27px;height:27px;border-radius:50%;background:linear-gradient(135deg, #FF9392 0%, #EA5965 100%);font-size:10px;font-weight:700}
.stage-line{min-height:50px;flex:1;border-left:1px dashed #F0C7C8}
.stage-copy{min-width:0;flex:1;padding:1px 0 20px}
.path-stage:last-child .stage-copy{padding-bottom:2px}
.stage-heading{flex-wrap:wrap;gap:4px}
.stage-phase{font-size:14px;font-weight:700}
.stage-duration{font-size:10px}
.stage-focus{margin-top:6px;font-size:12px;font-weight:600;line-height:1.45}
.stage-detail{margin-top:5px;font-size:11px;line-height:1.5}
.compare-score-row{gap:10px;padding:2px 0 13px;border-bottom:0.5px solid #F0F1F2}
.compare-score-cell{min-width:0;flex-direction:column}
.compare-caption{font-size:11px;line-height:1.4}
.compare-score{margin-top:3px;font-size:31px;font-weight:700;letter-spacing:-2px;line-height:1}
.compare-arrow{width:9px;height:9px;margin:20px 4px 0 0;flex:0 0 auto;border-top:1px solid #C9CDD3;border-right:1px solid #C9CDD3}
.compare-delta{margin-left:auto;padding:4px 10px;flex:0 0 auto;border-radius:599px;font-size:13px;font-weight:700;line-height:1.3}
.compare-delta.up, .compare-topic-state.up{background:#EAF6F3}
.compare-delta.down, .compare-topic-state.down{background:#F7F0F1}
.compare-delta.flat{background:#F0F1F2}
.compare-line{gap:9px;padding-top:12px}
.compare-line-label{flex:0 0 auto;font-size:12px;line-height:1.4}
.compare-band-flow{min-width:0;flex-wrap:wrap;gap:6px}
.compare-band{flex:0 0 auto;padding:3px 8px;border-radius:599px;background:#F0F1F2;font-size:11px;font-weight:650;line-height:1.3}
.compare-band.solid{background:#EAF6F3}
.compare-band.steady{background:#EEF3FB}
.compare-band.weak{background:#FFF4E3}
.compare-band.rebuild{background:#FDF0EF}
.compare-band-arrow{font-size:13px;font-weight:700}
.compare-band-same{font-size:11px}
.compare-topic-head{padding-bottom:3px}
.compare-topic-summary{min-width:0;font-size:12px;font-weight:600;line-height:1.45}
.compare-topic{gap:9px;padding:9px 0;border-top:0.5px solid #F5F6F5}
.compare-topic-name{min-width:0;font-size:13px;font-weight:600;line-height:1.4}
.compare-topic-state{flex:0 0 auto;padding:3px 8px;border-radius:599px;font-size:11px;font-weight:650;line-height:1.3}
.compare-more{padding-top:4px;font-size:11px;line-height:1.5}
.compare-note{margin-top:12px;font-size:10px;line-height:1.58}
.compare-history-card{padding-top:6px;padding-bottom:6px}
.compare-history-row{gap:9px;padding:12px 0;border-bottom:0.5px solid #F0F1F2}
.compare-history-row:last-child{border-bottom:0}
.compare-history-copy{min-width:0;flex:1;flex-direction:column}
.compare-history-title{font-size:14px;font-weight:700;line-height:1.4}
.compare-history-date{margin-top:2px;font-size:10px;line-height:1.3}
.compare-history-score{flex:0 0 auto;font-size:14px;font-weight:700}
.compare-history-chevron{width:7px;height:7px;flex:0 0 auto;border-top:1px solid #C9CDD3;border-right:1px solid #C9CDD3}
.review-card{padding-top:7px;padding-bottom:7px}
.review-item{border-bottom:0.5px solid #F0F1F2}
.review-item:last-child{border-bottom:0}
.review-head{gap:10px;padding:13px 0}
.review-title{flex:1;min-width:0;font-size:13px;line-height:1.5}
.review-result{flex:0 0 auto;font-size:12px;font-weight:650}
.review-body{padding:0 0 14px}
.review-option{margin-top:6px;padding:8px 10px;border-radius:8px;background:#F7F8F6;font-size:13px;line-height:1.45}
.review-option.is-answer{background:#EAF6F3}
.review-option.is-wrong{background:#FDF0EF}
.review-line{margin-top:8px;font-size:13px;line-height:1.6}
.review-key{font-weight:650}
.review-figure{height:0;margin:3px auto 9px;border:0.5px solid #EEF1EE;border-radius:10px;background:#F4F6F4;box-sizing:border-box}
.review-option-figure{margin:8px 0 0;border-radius:8px;background:#fff}
.review-figure-image{top:0;left:0;width:100%;height:100%}
.review-figure-failed{top:0;left:0;width:100%;height:100%;padding:0 14px;box-sizing:border-box;font-size:12px;line-height:1.5}
.report-knowledge-link{width:max-content;min-height:37px;margin:16px 4px 0;gap:7px;font-size:13px;font-weight:600}
.link-chevron{width:7px;height:7px;border-top:1px solid #E57822;border-right:1px solid #E57822}
.report-method-note{margin:11px 4px 0;font-size:10px;line-height:1.58}
.report-actionbar{right:max(0px, 50% - var(--lg-col) / 2);bottom:0;left:max(0px, 50% - var(--lg-col) / 2);padding:10px 16px calc(13px + env(safe-area-inset-bottom));background:rgba(250, 250, 250, .96)}
.report-action-row{width:100%;gap:12px}
.report-action{min-width:0;height:57px;flex:1;box-sizing:border-box;border-radius:599px;font-size:16px;font-weight:650;line-height:1}
.action-later{background:#FFFFFF}
.action-continue{background:rgba(253, 124, 2, .14)}
.report-share-mask{top:0;right:max(0px, 50% - var(--lg-col) / 2);bottom:0;left:max(0px, 50% - var(--lg-col) / 2);background:rgba(25, 31, 28, .72);box-shadow:0 0 0 100vmax rgba(25, 31, 28, .72)}
.report-share-preview-stage{top:-11px;right:0;bottom:270px;left:0;box-sizing:border-box;padding:0 16px}
.report-share-preview-scroll{width:100%;height:100%}
.report-share-long-image{width:100%;height:auto;margin:0 auto;border-radius:24px}
.report-share-preview-end{width:100%}
.report-share-loading{height:100%;font-size:15px}
.report-share-sheet{right:0;bottom:0;left:0;padding:14px 22px calc(21px + env(safe-area-inset-bottom));box-sizing:border-box;border-radius:20px 20px 0 0;background:#FFFFFF;box-shadow:0 -11px 34px rgba(11, 16, 14, .2)}
.report-share-sheet-header{height:30px}
.report-share-sheet-title{font-size:15px;font-weight:750;line-height:1.2}
.report-share-actions{gap:15px;margin:14px auto 0}
.report-share-action{flex:0 0 76px;flex-direction:column;font-size:13px;line-height:1.2}
.report-share-action-icon{width:48px;height:48px;margin-bottom:9px;border-radius:50%;background:#F1F2F1}
.report-share-action-icon image{width:72%;height:72%}
.report-share-action-friend .report-share-action-icon, .report-share-action-timeline .report-share-action-icon{background:transparent}
.report-share-action-friend .report-share-action-icon image, .report-share-action-timeline .report-share-action-icon image{width:100%;height:100%}
.report-share-native-button{top:0;left:0;width:100%;height:100%;padding:0;border:0;border-radius:0;background:transparent}
.report-share-native-button::after{border:0}
.report-share-cancel{height:32px;margin-top:36px;font-size:14px;line-height:32px}
.report-share-export-canvas{top:-9999px;left:calc(max(0px, 50% - var(--lg-col) / 2) + -9999px)}
.report-name-sk{width:108px;height:21px}
.report-cover-sk{padding-top:18px}
.report-score-sk{width:90px;height:42px;margin:9px 0 10px;border-radius:9px}
.report-radar-sk{width:132px;height:132px;margin:24px auto 0}
.cover-meta-sk{height:28px;margin-top:4px;border-radius:599px}
.report-pill-sk{width:114px;height:37px;border-radius:20px 8px 20px 4px}
.report-card-sk{height:90px;border-radius:24px}
.report-card-sk.tall{height:180px}
.timing-row{padding:14px 0;border-bottom:0.5px solid #edf0ed}
.timing-row-head{gap:9px;font-size:15px}
.timing-value{flex-shrink:0;font-weight:600}
.timing-caption{margin-top:6px;font-size:13px;line-height:1.6}
.timing-notice{margin-top:14px;font-size:13px;line-height:1.7}
}
