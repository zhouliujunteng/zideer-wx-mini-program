.assessment-ocr { min-height: 100vh; padding: 0 28rpx calc(env(safe-area-inset-bottom) + 44rpx); }.assessment-ocr__inner { padding-top: 48rpx; }.assessment-ocr__heading { padding: 0 8rpx; }.assessment-ocr__eyebrow { display: block; color: var(--accent-deep); font-size: 22rpx; font-weight: 700; }.assessment-ocr__title { display: block; margin-top: 12rpx; font-size: 38rpx; font-weight: 700; line-height: 1.3; }.assessment-ocr__copy { display: block; margin-top: 12rpx; color: var(--muted); font-size: 22rpx; }.assessment-ocr__notice { margin-top: 34rpx; padding: 28rpx 24rpx; }.assessment-ocr__notice-title { display: block; font-size: 27rpx; font-weight: 700; }.assessment-ocr__notice-copy { display: block; margin-top: 12rpx; color: var(--muted); font-size: 22rpx; line-height: 1.6; }.assessment-ocr__section { margin-top: 36rpx; }.assessment-ocr__editor { display: block; box-sizing: border-box; width: 100%; min-height: 480rpx; margin-top: 18rpx; padding: 22rpx; color: var(--ink); font-family: monospace; font-size: 21rpx; line-height: 1.55; }.assessment-ocr__save, .assessment-ocr__secondary, .assessment-ocr__skip { display: flex; width: 100%; min-height: 86rpx; align-items: center; justify-content: center; border-radius: 18rpx; font-size: 26rpx; font-weight: 700; }.assessment-ocr__save { margin-top: 32rpx; background: var(--accent); color: var(--surface); }.assessment-ocr__secondary, .assessment-ocr__skip { border: 1rpx solid var(--line-strong); background: var(--surface); color: var(--ink); }.assessment-ocr__secondary { margin-top: 20rpx; }.assessment-ocr__skip { margin-top: 14rpx; }.assessment-ocr__skeleton { height: 620rpx; border-radius: 24rpx; }
