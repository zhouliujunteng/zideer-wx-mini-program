.assessment-score { min-height: 100vh; padding: 0 28rpx calc(env(safe-area-inset-bottom) + 44rpx); }.assessment-score__inner { padding-top: 48rpx; }.assessment-score__heading { padding: 0 8rpx; }.assessment-score__eyebrow { display: block; color: var(--accent-deep); font-size: 22rpx; font-weight: 700; }.assessment-score__title { display: block; margin-top: 12rpx; font-size: 38rpx; font-weight: 700; line-height: 1.3; }.assessment-score__copy { display: block; margin-top: 12rpx; color: var(--muted); font-size: 22rpx; line-height: 1.55; }.assessment-score__list { margin-top: 36rpx; }.assessment-score__list-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 16rpx; }.assessment-score__new { min-height: 56rpx; padding: 0 8rpx; color: var(--accent-deep); font-size: 23rpx; font-weight: 700; }.assessment-score__items { overflow: hidden; padding: 0 24rpx; }.assessment-score__item { display: flex; width: 100%; min-height: 96rpx; align-items: center; justify-content: space-between; border-bottom: 1rpx solid var(--line); text-align: left; }.assessment-score__item:last-child { border-bottom: 0; }.assessment-score__item-title, .assessment-score__item-meta { display: block; max-width: 390rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }.assessment-score__item-title { font-size: 25rpx; font-weight: 600; }.assessment-score__item-meta { margin-top: 6rpx; color: var(--muted); font-size: 21rpx; }.assessment-score__item-score { margin-left: 18rpx; font-size: 24rpx; font-weight: 700; }.assessment-score__form { margin-top: 32rpx; padding: 28rpx 24rpx; }.assessment-score__form-title { display: block; font-size: 28rpx; font-weight: 700; }.assessment-score__input, .assessment-score__date { display: flex; width: 100%; min-height: 84rpx; align-items: center; margin-top: 18rpx; padding: 0 18rpx; border: 1rpx solid var(--line-strong); border-radius: 12rpx; background: var(--surface); color: var(--ink); font-size: 24rpx; }.assessment-score__date { justify-content: space-between; }.assessment-score__numbers { display: flex; align-items: center; gap: 12rpx; }.assessment-score__numbers .assessment-score__input { width: auto; flex: 1; }.assessment-score__slash { margin-top: 18rpx; color: var(--muted); }.assessment-score__save, .assessment-score__skip { display: flex; width: 100%; min-height: 86rpx; align-items: center; justify-content: center; border-radius: 18rpx; font-size: 26rpx; font-weight: 700; }.assessment-score__save { margin-top: 28rpx; background: var(--accent); color: var(--surface); }.assessment-score__skip { margin-top: 20rpx; border: 1rpx solid var(--line-strong); background: var(--surface); color: var(--ink); }.assessment-score__skeleton { height: 520rpx; border-radius: 24rpx; }
