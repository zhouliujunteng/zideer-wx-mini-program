<view class="screen assessment-score"><view class="assessment-score__inner">
  <view class="skeleton assessment-score__skeleton" wx:if="{{loading}}"></view>
  <block wx:else>
    <view class="assessment-score__heading"><text class="assessment-score__eyebrow">可选补充</text><text class="assessment-score__title">添加最近一次成绩</text><text class="assessment-score__copy">最近成绩会作为诊断和预测的辅助证据，可以稍后再补充。</text></view>
    <view class="assessment-score__list" wx:if="{{scores.length}}"><view class="assessment-score__list-head"><text class="section-title">已记录成绩</text><button class="assessment-score__new pressable" bindtap="newScore">添加</button></view><view class="surface assessment-score__items"><button class="assessment-score__item pressable" wx:for="{{scores}}" wx:key="id" data-id="{{item.id}}" bindtap="editScore"><view><text class="assessment-score__item-title">{{item.examName}}</text><text class="assessment-score__item-meta">{{item.examDate}}{{item.rankText ? ' · ' + item.rankText : ''}}</text></view><text class="assessment-score__item-score">{{item.score}} / {{item.fullScore}}</text></button></view></view>
<view class="assessment-score__form surface"><text class="assessment-score__form-title">{{form.id ? '修改成绩' : '添加成绩'}}</text><input class="assessment-score__input" value="{{form.examName}}" placeholder="考试名称，例如：八年级上学期期中" data-key="examName" bindinput="updateForm"/><picker mode="date" value="{{form.examDate}}" bindchange="chooseDate"><view class="assessment-score__date"><text>{{form.examDate || '选择考试日期'}}</text><text>›</text></view></picker><view class="assessment-score__numbers"><input class="assessment-score__input assessment-score__number" type="digit" value="{{form.score}}" placeholder="得分" data-key="score" bindinput="updateForm"/><text class="assessment-score__slash">/</text><input class="assessment-score__input assessment-score__number" type="digit" value="{{form.fullScore}}" placeholder="满分" data-key="fullScore" bindinput="updateForm"/></view><input class="assessment-score__input" value="{{form.rankText}}" placeholder="可选：排名或班级名次" data-key="rankText" bindinput="updateForm"/><button class="assessment-score__save pressable" loading="{{saving}}" disabled="{{saving}}" bindtap="saveScore">保存成绩</button></view>
    <button class="assessment-score__skip pressable" bindtap="continueToAnalysis">继续上传试卷</button>
  </block>
</view></view>
