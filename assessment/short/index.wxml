<wxs module="QF" src="../../utils/question-figure.wxs" />
<view class="short-page">
  <view class="short-topbar">
    <view class="short-topbar-inner" style="height: {{navigationBarHeight}}px; padding-top: {{statusBarHeight}}px;">
      <view class="short-back" bindtap="handleBack" aria-label="返回上一页"><view class="short-back-icon"></view></view>
      <text class="short-topbar-title" style="top: {{statusBarHeight}}px; height: {{navigationBarHeight}}px; line-height: {{navigationBarHeight}}px;">学科摸底诊断</text>
    </view>
  </view>

  <scroll-view class="short-scroll" scroll-y style="padding-top: {{contentTop}}px;">
    <view class="short-shell">

      <!-- 读取测评期间画骨架：题目页画进度条与选项，列表页保留固定说明、只画范围行 -->
      <block wx:if="{{loading && skeleton === 'attempt'}}">
        <view class="short-question-progress">
          <view class="short-question-progress-topline"><view class="sk short-count-sk"></view></view>
          <view class="sk short-progress-sk"></view>
          <view class="sk sk-line sk-mid short-progress-meta-sk"></view>
        </view>
        <view class="short-question-card">
          <view class="sk sk-line"></view>
          <view class="sk sk-line sk-mid"></view>
          <view class="short-option-list"><view wx:for="{{[1, 2, 3, 4]}}" wx:key="*this" class="sk short-option-sk"></view></view>
        </view>
      </block>
      <view wx:elif="{{loading}}" class="short-card">
        <text class="short-card-title">了解我的知识点掌握情况</text>
        <text class="short-card-copy">每个考试范围的首次诊断免费。题量较多的范围分成几轮，每轮约 30 分钟，可以分次完成；每轮结束都会给出当前的掌握报告。</text>
        <view class="short-entry-list">
          <view wx:for="{{[1, 2, 3]}}" wx:key="*this" class="short-entry">
            <view class="short-entry-copy"><view class="sk sk-line sk-mid"></view><view class="sk sk-line short-entry-detail-sk"></view></view>
            <view class="sk short-entry-action-sk"></view>
          </view>
        </view>
      </view>
      <view wx:elif="{{failed}}" class="short-card short-state-card">
        <text class="short-state-text">{{error || '测评暂时不可用'}}</text>
        <button class="short-inline-action" bindtap="loadPage">重新加载</button>
      </view>

      <block wx:else>
        <view wx:if="{{error}}" class="short-error-card" role="alert">
          <text class="short-error-text">{{error}}</text>
          <view wx:if="{{attempt}}" class="short-error-action" bindtap="loadPage">重新读取已保存答案</view>
        </view>

        <block wx:if="{{attempt}}">
          <view class="short-question-progress">
            <view class="short-question-progress-topline">
              <view class="short-question-count"><text class="short-question-current">{{currentNumber}}</text><text class="short-question-slash"> / </text><text class="short-question-total">{{attempt.totalQuestions}}</text></view>
              <view wx:if="{{countdown}}" class="short-countdown"><view class="short-countdown-dot"></view><text>{{countdownOver ? '本轮建议时间已到，可继续作答' : '剩余 ' + countdown}}</text></view>
            </view>
            <view class="short-progress-segments">
              <view wx:for="{{segments}}" wx:key="id" class="short-progress-segment {{item.segmentClass}}"></view>
            </view>
            <view class="short-progress-meta"><text>{{attempt.scope.name}}</text><text wx:if="{{roundLabel}}">{{roundLabel}}</text><text>本轮已答 {{attempt.answeredCount}} / {{attempt.totalQuestions}} 题</text></view>
          </view>

          <view wx:if="{{attempt.current}}" class="short-question-card">
            <view class="short-question-heading">
              <view class="short-question-pills">
                <view class="short-question-type-pill type-single">单选题</view>
                <view wx:if="{{revisiting}}" class="short-question-type-pill is-saved">{{savedAnswer ? '已作答 · ' + savedAnswer : '已跳过'}}</view>
              </view>
              <text class="short-question-title">{{attempt.current.prompt}}</text>
            </view>
            <block wx:if="{{attempt.current.figures.length}}">
              <view wx:for="{{attempt.current.figures}}" wx:for-item="figure" wx:key="url" class="short-figure" style="{{QF.box(figure, 1)}}">
                <view wx:if="{{QF.failed(failedFigures, figure.url)}}" class="short-figure-failed" bindtap="retryFigures" role="button" aria-label="配图没加载出来，点这里重新加载"><text>配图没加载出来，点这里重新加载</text></view>
                <image wx:else class="short-figure-image" src="{{figure.url}}" mode="aspectFit" data-url="{{figure.url}}" data-group="current" bindtap="previewFigure" binderror="figureFailed" aria-label="{{figure.alt || '题目配图'}}"></image>
              </view>
              <text class="short-figure-tip">点图片可以放大查看</text>
            </block>
            <view class="short-option-list">
              <view wx:for="{{optionList}}" wx:key="value" class="short-option {{item.isSelected ? 'is-selected' : ''}}" data-value="{{item.value}}" bindtap="select">
                <view class="short-option-copy {{item.figures.length ? 'has-figure' : ''}}">
                  <text class="short-option-key">{{item.key}}</text>
                  <view class="short-option-body">
                    <text wx:if="{{item.label}}" class="short-option-label">{{item.label}}</text>
                    <!-- 选项配图：点图照常选中这一项，右下角「放大」单独看大图 -->
                    <view wx:for="{{item.figures}}" wx:for-item="figure" wx:key="url" class="short-figure short-option-figure" style="{{QF.box(figure, 0.5)}}">
                      <view wx:if="{{QF.failed(failedFigures, figure.url)}}" class="short-figure-failed" catchtap="retryFigures" role="button" aria-label="配图没加载出来，点这里重新加载"><text>配图没加载出来，点这里重新加载</text></view>
                      <block wx:else>
                        <image class="short-figure-image" src="{{figure.url}}" mode="aspectFit" data-url="{{figure.url}}" binderror="figureFailed" aria-label="{{figure.alt || '选项' + item.value + '配图'}}"></image>
                        <view class="short-figure-zoom" data-url="{{figure.url}}" data-group="current" catchtap="previewFigure" role="button" aria-label="放大查看选项{{item.value}}配图">放大</view>
                      </block>
                    </view>
                  </view>
                </view>
                <view class="short-option-mark"><view wx:if="{{item.isSelected}}" class="short-option-mark-icon"></view></view>
              </view>
            </view>
            <text wx:if="{{revisiting && savedAnswer}}" class="short-question-hint">这道题已经答过，可以重新选择。改了答案点「保存修改，继续」，以最后一次保存的为准。</text>
            <text wx:elif="{{revisiting}}" class="short-question-hint">这道题之前跳过了，现在可以作答；仍然不会就点「下一题」，按未答对计入。</text>
            <text wx:else class="short-question-hint">提交本题后会保存答案，本轮提交前都可以点「上一题」回来修改。暂时不会可以跳过，跳过的题按未答对计入。</text>
          </view>

          <view wx:else class="short-complete-card">
            <view class="short-complete-mark"><view class="short-complete-check"></view></view>
            <text class="short-complete-title">本轮题目已完成</text>
            <text class="short-complete-subtitle">提交前可以点「上一题」检查、修改答案。提交本轮后，可查看知识点掌握状态、综合掌握度和每道题的解析。</text>
          </view>
        </block>

        <block wx:else>
          <view class="short-card">
            <text class="short-card-title">了解我的知识点掌握情况</text>
            <text class="short-card-copy">每个考试范围的首次诊断免费。题量较多的范围分成几轮，每轮约 30 分钟，可以分次完成；每轮结束都会给出当前的掌握报告。</text>
            <view class="short-entry-list">
              <view class="short-entry" wx:for="{{scopes}}" wx:key="id" data-id="{{item.id}}" data-mode="{{item.mode}}" data-attempt-id="{{item.attemptId}}" bindtap="start">
                <view class="short-entry-copy">
                  <text class="short-entry-name">{{item.name}}</text>
                  <text class="short-entry-detail">{{item.detail}}<text wx:if="{{item.deltaLabel}}" class="short-entry-delta {{item.deltaTone}}"> · {{item.deltaLabel}}</text></text>
                </view>
                <text wx:if="{{item.retakeLabel}}" class="short-entry-retake" data-id="{{item.id}}" catchtap="retake" aria-role="button">{{item.retakeLabel}}</text>
                <text class="short-entry-action {{item.mode === 'unavailable' ? 'is-disabled' : ''}}">{{item.actionLabel}} ›</text>
              </view>
              <text wx:if="{{!scopes.length}}" class="short-card-copy">当前年级、学期的诊断题库正在准备。开放后会显示在这里。</text>
            </view>
          </view>
          <view class="short-card" wx:if="{{records.length}}">
            <text class="short-card-title">我的测评记录</text>
            <view class="short-entry-list">
              <view class="short-entry" wx:for="{{records}}" wx:key="id" data-id="{{item.id}}" data-status="{{item.status}}" bindtap="resume">
                <text class="short-entry-name">{{item.name}}</text>
                <text wx:if="{{item.deltaLabel}}" class="short-entry-delta-pill {{item.deltaTone}}">{{item.deltaLabel}}</text>
                <text class="short-entry-action">{{item.statusLabel}} ›</text>
              </view>
            </view>
          </view>
        </block>
      </block>

    </view>
  </scroll-view>

  <view wx:if="{{!loading && !failed && attempt && attempt.current}}" class="short-actionbar">
    <!-- 上一题：从第 2 题起展开，翻回已答过的题可以重新选择 -->
    <view class="short-action-row has-previous {{position > 0 ? 'has-back' : ''}}">
      <view class="short-back-slot"><button class="short-prev-action" bindtap="previous" disabled="{{busy || position < 1}}">上一题</button></view>
      <view class="short-prev-slot"><button class="short-prev-action" data-skip="yes" bindtap="next" disabled="{{busy}}">暂时不会</button></view>
      <view class="short-next-slot"><button class="short-next-action" bindtap="next" loading="{{busy}}" disabled="{{busy}}">{{revisiting ? (answer === savedAnswer ? '下一题' : '保存修改，继续') : '提交本题，继续'}}</button></view>
    </view>
  </view>
  <view wx:elif="{{!loading && !failed && attempt && !attempt.current}}" class="short-actionbar">
    <view class="short-action-row {{position > 0 ? 'has-previous' : ''}}">
      <view class="short-prev-slot"><button class="short-prev-action" bindtap="previous" disabled="{{busy || position < 1}}">上一题</button></view>
      <view class="short-next-slot"><button class="short-next-action" bindtap="submit" loading="{{busy}}" disabled="{{busy || !attempt.answeredCount}}">提交本轮，生成报告</button></view>
    </view>
  </view>
</view>
<dev-reset-fab />
