/* 自动生成，请勿手改：index.wxss 在平板、电脑大屏（窗口宽 ≥ 450px）下的样式。
   rpx 按 1rpx = 0.6px 换算，固定定位元素收进居中栏；改完源文件后运行 node scripts/build-large-screen-styles.mjs */
@media (min-width: 450px) {
.sk{border-radius:7px}
.sk-line{height:16px}
.sk-line + .sk-line{margin-top:8px}
.sk-short{width:40%}
.sk-mid{width:64%}
.sk-round{border-radius:50%}
.sk-card{height:96px;border-radius:14px}
.sk-card + .sk-card{margin-top:12px}
.short-page{height:100vh}
.short-topbar{top:0;left:max(0px, 50% - var(--lg-col) / 2);width:min(100%, var(--lg-col))}
.short-topbar-inner{padding:0 21px 9px}
.short-back{flex:0 0 auto;width:26px;height:26px;margin-right:6px}
.short-back-icon{width:12px;height:12px;border-bottom:1px solid #24332d;border-left:1px solid #24332d;transform:rotate(45deg) scale(.72)}
.short-topbar-title{left:50%;font-size:21px;font-weight:700;letter-spacing:-1px;transform:translateX(-50%)}
.short-scroll{height:100vh}
.short-shell{min-height:100%;padding:14px 21px 138px}
.short-card{margin-bottom:14px;padding:19px 16px 20px;border-radius:18px}
.short-card-title{font-size:18px;font-weight:700;line-height:1.4}
.short-card-copy{margin-top:8px;font-size:12px;line-height:1.6}
.short-state-card{text-align:center}
.short-state-text{font-size:14px;line-height:1.6}
.short-inline-action{margin:15px auto 0;padding:0 26px;height:43px;border:0;border-radius:599px;font-size:15px;font-weight:650;line-height:43px}
.short-inline-action::after{border:0}
.short-error-card{margin-bottom:14px;padding:13px 15px;border-radius:12px}
.short-error-text{font-size:13px;line-height:1.6}
.short-error-action{margin-top:6px;font-size:13px;font-weight:650;text-decoration:underline;text-underline-offset:2px}
.short-question-progress{margin-bottom:18px}
.short-question-progress-topline{min-height:32px}
.short-question-count{line-height:1}
.short-question-current, .short-question-slash, .short-question-total{font-size:22px;font-weight:700}
.short-question-slash{margin:0 1px}
.short-countdown{flex:0 0 auto;font-size:12px;line-height:22px}
.short-countdown-dot{width:7px;height:7px;margin-right:6px;border-radius:50%}
.short-progress-segments{width:calc(100% + 43px);height:12px;margin:13px -22px 0;padding:0 21px;column-gap:6px}
.short-progress-segment{min-width:0;height:9px;flex:1 1 0;border-radius:599px}
.short-progress-segment.is-current{flex-grow:2.4}
.short-progress-segment.is-upcoming{flex:0 0 9px}
.short-progress-meta{margin-top:9px;font-size:12px;line-height:1.4}
.short-question-card{padding:19px 16px 20px;border-radius:18px}
.short-question-heading{flex-direction:column}
.short-question-type-pill{height:24px;padding:0 9px;border-radius:6px;font-size:12px;font-weight:650;line-height:24px}
.short-question-pills{flex-wrap:wrap;gap:7px}
.short-question-title{margin-top:16px;font-size:18px;font-weight:700;line-height:1.45}
.short-option-list{margin-top:20px}
.short-option{min-height:55px;margin-top:9px;padding:10px 12px 10px 13px;border:1px solid #F0F2EE;border-radius:10px}
.short-option:first-child{margin-top:0}
.short-option:active{transform:scale(.99)}
.short-option.is-selected{border-color:rgba(253, 124, 2, .72)}
.short-option-copy{min-width:0;flex:1;padding-right:9px}
.short-option-key{flex:0 0 auto;margin-right:4px;font-size:13px;line-height:1.35}
.short-option-body{min-width:0;flex:1;flex-direction:column}
.short-option-label{min-width:0;font-size:14px;font-weight:600;line-height:1.4}
.short-option-mark{flex:0 0 auto;width:20px;height:20px;border:1px solid #D8DED9;border-radius:50%}
.short-option.is-selected .short-option-mark{border-color:#FD7C02}
.short-option-mark-icon{width:9px;height:9px;border-radius:50%}
.short-figure{height:0;margin:15px auto 0;border:0.5px solid #EEF1EE;border-radius:10px}
.short-figure-image{top:0;left:0;width:100%;height:100%}
.short-figure-failed{top:0;left:0;width:100%;height:100%;padding:0 14px;font-size:12px;line-height:1.5;text-align:center}
.short-figure-tip{margin-top:7px;font-size:11px;line-height:1.5;text-align:center}
.short-option-figure{margin:8px 0 0;border-radius:8px}
.short-option-figure .short-figure-zoom{right:6px;bottom:6px;height:24px;padding:0 9px;border-radius:599px;font-size:11px;line-height:24px}
.short-question-hint{margin-top:14px;font-size:11px;line-height:1.6}
.short-complete-card{padding:22px 16px 16px;border-radius:18px;flex-direction:column;text-align:center;margin-bottom:14px}
.short-complete-mark{width:67px;height:67px;border-radius:50%}
.short-complete-check{width:19px;height:32px;border-right:4px solid #72B783;border-bottom:4px solid #72B783;transform:rotate(45deg) translate(-4px, -4px)}
.short-complete-title{margin-top:15px;font-size:18px;font-weight:700;line-height:1.25}
.short-complete-subtitle{margin-top:7px;font-size:12px;line-height:1.55}
.short-entry-list{margin-top:6px}
.short-entry{gap:10px;padding:15px 0;border-bottom:0.5px solid #F0F2EE}
.short-entry:last-child{border-bottom:0}
.short-entry-name{flex:0 1 auto;min-width:0;font-size:15px;font-weight:600;line-height:1.5}
.short-entry-action{flex:0 0 auto;font-size:13px;font-weight:650}
.short-entry-copy{min-width:0;flex:1;flex-direction:column}
.short-entry-detail{margin-top:3px;font-size:12px;line-height:1.4}
.short-entry-delta-pill{flex:0 0 auto;margin-right:auto;padding:2px 7px;border-radius:599px;font-size:11px;font-weight:650;line-height:1.4}
.short-entry-retake{flex:0 0 auto;padding:4px 10px;border:0.5px solid #FD7C02;border-radius:599px;font-size:13px;font-weight:650;line-height:1.3}
.short-actionbar{right:max(0px, 50% - var(--lg-col) / 2);bottom:0;left:max(0px, 50% - var(--lg-col) / 2);padding:10px 16px calc(13px + env(safe-area-inset-bottom))}
.short-action-row{width:100%;gap:12px}
.short-prev-slot, .short-next-slot{width:0;min-width:0}
.short-prev-slot{flex:0 0 0}
.short-action-row.has-previous .short-prev-slot, .short-action-row.has-previous .short-next-slot{flex:1 1 0;flex-basis:0}
.short-next-slot{flex:1 1 0}
.short-back-slot{flex:0 0 0;width:0;min-width:0;margin-right:-12px}
.short-action-row.has-back .short-back-slot{flex-basis:93px;margin-right:0}
.short-prev-action, .short-next-action{width:100%;max-width:100%;min-width:0;height:57px;border-radius:599px;font-size:16px;font-weight:650;line-height:57px}
.short-prev-action{margin:0;padding:0;border:0}
.short-next-action{margin:0;padding:0;border:0}
.short-prev-action::after, .short-next-action::after{border:0}
.short-count-sk{width:72px;height:26px}
.short-progress-sk{height:12px;margin-top:13px;border-radius:599px}
.short-progress-meta-sk{height:13px;margin-top:10px}
.short-option-sk{height:55px;margin-top:9px;border-radius:10px}
.short-entry-detail-sk{width:88%;height:12px}
.short-entry-action-sk{flex:none;width:57px;height:15px}
}
