<view class="screen deep-assessment">
  <view class="deep-assessment__inner">
    <view class="state-panel" wx:if="{{loading}}">
      <view class="skeleton deep-assessment__skeleton"></view>
    </view>

    <block wx:else>
      <view class="deep-assessment__head">
        <text class="deep-assessment__eyebrow">深度测评</text>
        <text class="deep-assessment__title">{{template.title}}</text>
        <text class="deep-assessment__copy">答案会自动保存，提交后不能修改。</text>
      </view>

      <view class="deep-assessment__questions">
        <view class="deep-question surface" wx:for="{{questions}}" wx:key="id">
          <text class="deep-question__number">{{index + 1}}</text>
          <text class="deep-question__prompt">{{item.prompt}}</text>
          <view class="deep-question__options" wx:if="{{item.optionValues.length}}">
            <button class="deep-question__option pressable {{item.answerText === option.value ? 'is-selected' : ''}}" wx:for="{{item.optionValues}}" wx:for-item="option" wx:key="value" data-id="{{item.id}}" data-value="{{option.value}}" bindtap="chooseAnswer">{{option.label}}</button>
          </view>
          <textarea wx:else class="deep-question__input" value="{{item.answerText}}" data-id="{{item.id}}" placeholder="输入你的答案" auto-height maxlength="2000" bindinput="inputAnswer" bindblur="blurAnswer" />
          <text class="deep-question__saving" wx:if="{{savingId === item.id}}">正在保存</text>
        </view>
      </view>

      <button class="deep-assessment__submit pressable" loading="{{submitting}}" disabled="{{submitting}}" bindtap="submitAssessment">提交深度测评</button>
    </block>
  </view>
</view>
