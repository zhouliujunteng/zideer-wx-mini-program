<view class="screen assessment-analysis"><view class="assessment-analysis__inner">
  <view class="skeleton assessment-analysis__skeleton" wx:if="{{loading}}"></view>
  <block wx:else>
    <view class="assessment-analysis__heading"><text class="assessment-analysis__eyebrow">测评已提交</text><text class="assessment-analysis__title">{{analysisReady ? '诊断结果已生成' : '正在准备分析结果'}}</text><text class="assessment-analysis__copy">{{attempt.subjectName}} · {{attempt.templateTitle}}</text></view>
    <view class="assessment-analysis__status surface"><view class="assessment-analysis__status-mark">{{canViewReport ? '✓' : '…'}}</view><text class="assessment-analysis__status-title">{{statusLabel}}</text><text class="assessment-analysis__status-copy" wx:if="{{canViewReport}}">诊断报告已完成，可以查看学科薄弱项与学习建议。</text><text class="assessment-analysis__status-copy" wx:else>诊断、图谱映射和分数预测将在后端分析服务配置后依次生成。测评答案已安全保存。</text></view>
    <view class="assessment-analysis__steps surface"><view class="assessment-analysis__step"><text>基础问卷</text><text class="assessment-analysis__step-done">已完成</text></view><view class="assessment-analysis__step"><text>学习诊断</text><text class="{{analysisReady ? 'assessment-analysis__step-done' : ''}}">{{analysisReady ? '已完成' : '处理中'}}</text></view><view class="assessment-analysis__step"><text>知识图谱映射</text><text class="{{analysisReady ? 'assessment-analysis__step-done' : ''}}">{{analysisReady ? '已完成' : '处理中'}}</text></view><view class="assessment-analysis__step"><text>分数预测</text><text class="{{analysisReady ? 'assessment-analysis__step-done' : ''}}">{{analysisReady ? '已完成' : '处理中'}}</text></view></view>
    <button class="assessment-analysis__action pressable" bindtap="goHistory">{{canViewReport ? '查看诊断报告' : '返回测评中心'}}</button><button class="assessment-analysis__secondary pressable" bindtap="openSupplement">补充成绩或试卷</button>
  </block>
</view></view>
