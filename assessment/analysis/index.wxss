.assessment-analysis { min-height: 100vh; padding: 0 28rpx calc(env(safe-area-inset-bottom) + 44rpx); }
.assessment-analysis__inner { padding-top: 48rpx; }.assessment-analysis__heading { padding: 0 8rpx; }.assessment-analysis__eyebrow { display: block; color: var(--accent-deep); font-size: 22rpx; font-weight: 700; }.assessment-analysis__title { display: block; margin-top: 12rpx; font-size: 38rpx; font-weight: 700; line-height: 1.3; }.assessment-analysis__copy { display: block; margin-top: 12rpx; color: var(--muted); font-size: 22rpx; }
.assessment-analysis__status { margin-top: 40rpx; padding: 38rpx 28rpx; text-align: center; }.assessment-analysis__status-mark { display: flex; width: 76rpx; height: 76rpx; align-items: center; justify-content: center; margin: 0 auto; border-radius: 38rpx; background: var(--yellow-soft); color: var(--yellow); font-size: 34rpx; font-weight: 700; }.assessment-analysis__status-title { display: block; margin-top: 20rpx; font-size: 29rpx; font-weight: 700; }.assessment-analysis__status-copy { display: block; margin-top: 12rpx; color: var(--muted); font-size: 22rpx; line-height: 1.6; }
.assessment-analysis__steps { overflow: hidden; margin-top: 24rpx; padding: 0 24rpx; }.assessment-analysis__step { display: flex; min-height: 90rpx; align-items: center; justify-content: space-between; border-bottom: 1rpx solid var(--line); color: var(--muted); font-size: 24rpx; }.assessment-analysis__step:last-child { border-bottom: 0; }.assessment-analysis__step-done { color: var(--green); font-weight: 700; }.assessment-analysis__action { display: flex; width: 100%; min-height: 88rpx; align-items: center; justify-content: center; margin-top: 42rpx; border-radius: 20rpx; background: var(--accent); color: var(--surface); font-size: 27rpx; font-weight: 700; }.assessment-analysis__skeleton { height: 500rpx; border-radius: 24rpx; }
