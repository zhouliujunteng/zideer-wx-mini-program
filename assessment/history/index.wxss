.assessment-history-page { min-height: 100vh; padding: 0 28rpx calc(env(safe-area-inset-bottom) + 44rpx); }.assessment-history-page__inner { padding-top: 48rpx; }.assessment-history-page__heading { padding: 0 8rpx; }.assessment-history-page__eyebrow { display: block; color: var(--accent-deep); font-size: 22rpx; font-weight: 700; }.assessment-history-page__title { display: block; margin-top: 12rpx; font-size: 38rpx; font-weight: 700; }.assessment-history-page__list { overflow: hidden; margin-top: 40rpx; padding: 0 24rpx; }.assessment-history-page__item { display: flex; width: 100%; min-height: 112rpx; align-items: center; justify-content: space-between; border-bottom: 1rpx solid var(--line); text-align: left; }.assessment-history-page__item:last-child { border-bottom: 0; }.assessment-history-page__copy { min-width: 0; flex: 1; }.assessment-history-page__title-text, .assessment-history-page__meta { display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }.assessment-history-page__title-text { font-size: 26rpx; font-weight: 600; }.assessment-history-page__meta { margin-top: 8rpx; color: var(--muted); font-size: 22rpx; }.assessment-history-page__action { flex: none; margin-left: 18rpx; color: var(--accent-deep); font-size: 22rpx; font-weight: 700; }.assessment-history-page__skeleton { height: 450rpx; border-radius: 24rpx; }
