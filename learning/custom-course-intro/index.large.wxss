/* 自动生成，请勿手改：index.wxss 在平板、电脑大屏（窗口宽 ≥ 450px）下的样式。
   rpx 按 1rpx = 0.6px 换算，固定定位元素收进居中栏；改完源文件后运行 node scripts/build-large-screen-styles.mjs */
@media (min-width: 450px) {
.sk{border-radius:7px}
.sk-line{height:16px}
.sk-line + .sk-line{margin-top:8px}
.sk-short{width:40%}
.sk-mid{width:64%}
.sk-round{border-radius:50%}
.sk-card{height:96px;border-radius:14px}
.sk-card + .sk-card{margin-top:12px}
.custom-intro-page{height:100vh}
.custom-intro-ambient{top:0;left:max(0px, 50% - var(--lg-col) / 2);width:min(100%, var(--lg-col));height:100%}
.custom-intro-ambient-ribbon{top:-84px;left:-258px;width:888px;height:432px;box-sizing:border-box;border:14px solid rgba(255, 255, 255, .72);border-top-color:transparent;border-right-color:transparent;border-radius:50%}
.custom-intro-topbar{top:0;left:max(0px, 50% - var(--lg-col) / 2);width:min(100%, var(--lg-col));box-sizing:border-box}
.custom-intro-topbar-inner{box-sizing:content-box;padding:0 19px 9px}
.custom-intro-back{width:32px;height:32px;border-radius:50%}
.custom-intro-back-icon{width:13px;height:13px;border-bottom:2px solid #24332D;border-left:2px solid #24332D}
.custom-intro-topbar-title{left:50%;font-size:21px;font-weight:700;letter-spacing:-1px}
.custom-intro-scroll{height:100vh;box-sizing:border-box}
.custom-intro-shell{min-height:100%;padding:0 19px calc(120px + env(safe-area-inset-bottom));box-sizing:border-box}
.custom-intro-hero{padding:14px 4px 4px}
.custom-intro-eyebrow{font-size:13px;font-weight:700;line-height:1.3}
.custom-intro-title{margin-top:9px;font-size:30px;font-weight:700;letter-spacing:-1px;line-height:1.25}
.custom-intro-lead{margin-top:12px;font-size:15px;line-height:1.7}
.custom-intro-course{margin-top:19px;padding:14px 16px;border:1px solid #fff;border-radius:19px}
.custom-intro-course-crown{width:38px;height:32px;margin-right:12px}
.custom-intro-course-copy{min-width:0}
.custom-intro-course-title{font-size:16px;font-weight:700;line-height:1.4}
.custom-intro-course-sub{margin-top:3px;font-size:13px;line-height:1.4}
.custom-intro-course-sk{height:14px;margin-top:7px}
.custom-intro-heading{margin-top:24px;padding:0 2px;font-size:18px;font-weight:700;line-height:1.2}
.custom-intro-card{margin-top:12px;padding:4px 16px;border-radius:19px}
.custom-intro-feature{gap:13px;padding:15px 0;border-bottom:1px solid #F0F3F0}
.custom-intro-feature:last-child{border-bottom:0}
.custom-intro-feature-index{width:33px;font-size:20px;font-weight:700;letter-spacing:-1px;line-height:1.2}
.custom-intro-feature-copy{min-width:0}
.custom-intro-feature-title{font-size:16px;font-weight:700;line-height:1.4}
.custom-intro-feature-text{margin-top:4px;font-size:14px;line-height:1.65}
.custom-intro-step{gap:13px}
.custom-intro-step-rail{width:26px;padding-top:14px}
.custom-intro-step-dot{width:26px;height:26px;border-radius:50%;font-size:13px;font-weight:700;line-height:1}
.custom-intro-step-line{width:1px;min-height:14px;margin:4px 0 -15px;border-radius:599px}
.custom-intro-step-copy{min-width:0;padding:14px 0}
.custom-intro-step-title{font-size:16px;font-weight:700;line-height:26px}
.custom-intro-step-text{margin-top:2px;font-size:14px;line-height:1.65}
.custom-intro-member{margin-top:19px;padding:16px;border:1px solid #fff;border-radius:19px}
.custom-intro-member-title{font-size:16px;font-weight:700;line-height:1.4}
.custom-intro-member-text{margin-top:4px;font-size:13px;line-height:1.65}
.custom-intro-bar{right:max(0px, 50% - var(--lg-col) / 2);bottom:0;left:max(0px, 50% - var(--lg-col) / 2);gap:12px;padding:10px 19px calc(10px + env(safe-area-inset-bottom));box-shadow:0 -5px 14px rgba(36, 51, 45, .06)}
.custom-intro-secondary{height:52px;padding:0 24px;border-radius:599px;font-size:16px;font-weight:650;line-height:52px}
.custom-intro-primary{min-width:0;height:52px;border-radius:599px;font-size:16px;font-weight:650;line-height:52px}
.custom-intro-secondary-sk{width:120px;height:52px;border-radius:599px}
.custom-intro-primary-sk{height:52px;border-radius:599px}
}
