/* 自动生成，请勿手改：index.wxss 在平板、电脑大屏（窗口宽 ≥ 450px）下的样式。
   rpx 按 1rpx = 0.6px 换算，固定定位元素收进居中栏；改完源文件后运行 node scripts/build-large-screen-styles.mjs */
@media (min-width: 450px) {
.surface{border-radius:14px}
.skeleton{border-radius:9px}
.state-panel{padding:72px 14px 24px}
.state-panel__mark{margin-bottom:14px;font-size:31px}
.state-panel__title{font-size:19px;font-weight:600}
.state-panel__copy{margin:13px 0 19px;font-size:15px;line-height:1.6}
.state-panel__action{border-radius:12px}
.state-panel__action::after{border:0}
.sk{border-radius:7px}
.sk-line{height:16px}
.sk-line + .sk-line{margin-top:8px}
.sk-short{width:40%}
.sk-mid{width:64%}
.sk-round{border-radius:50%}
.sk-card{height:96px;border-radius:14px}
.sk-card + .sk-card{margin-top:12px}
.hw-page{min-height:100vh}
.hw-topbar{top:0;left:max(0px, 50% - var(--lg-col) / 2);width:min(100%, var(--lg-col));box-sizing:border-box}
.hw-topbar-inner{box-sizing:content-box;padding:0 19px 9px}
.hw-topbar-title{left:50%;font-size:20px;font-weight:700;letter-spacing:-1px}
.hw-back{width:32px;height:32px;border-radius:50%}
.hw-back-icon{width:13px;height:13px;border-bottom:2px solid #24332D;border-left:2px solid #24332D}
.hw-shell{padding:0 19px calc(120px + env(safe-area-inset-bottom));box-sizing:border-box}
.hw-head{margin-top:7px;padding:0 2px}
.hw-course{font-size:20px;font-weight:750;line-height:1.3}
.hw-sub{margin-top:6px;font-size:14px;line-height:1.5}
.hw-card{margin-top:14px;padding:16px 15px;border-radius:16px}
.hw-card.is-wrong{box-shadow:inset 0 0 0 1px rgba(201, 79, 63, .22)}
.hw-card-head{gap:7px}
.hw-number{font-size:15px;font-weight:700}
.hw-type{padding:2px 8px;border-radius:599px;font-size:12px}
.hw-mark{margin-left:auto;font-size:13px;font-weight:650}
.hw-prompt{margin-top:10px;font-size:17px;line-height:1.6}
.hw-options{margin-top:12px}
.hw-options.is-judge{gap:10px}
.hw-options.is-judge .hw-option{margin-top:0}
.hw-option{margin-top:8px;padding:12px 13px;box-sizing:border-box;border-radius:12px}
.hw-option-letter{width:24px;height:24px;margin-right:10px;border-radius:50%;font-size:13px;font-weight:700;line-height:24px}
.hw-option-label{min-width:0;font-size:16px;line-height:24px}
.hw-option.is-selected{box-shadow:inset 0 0 0 1px #FD7C02}
.hw-option.is-right{box-shadow:inset 0 0 0 1px #FD7C02}
.hw-option.is-wrong{box-shadow:inset 0 0 0 1px rgba(201, 79, 63, .5)}
.hw-explain{margin-top:12px;padding:12px 13px;border-radius:12px}
.hw-explain-answer{font-size:14px;font-weight:700}
.hw-explain-text{margin-top:4px;font-size:15px;line-height:1.6}
.hw-result{margin-top:14px;padding:18px 16px;border-radius:16px}
.hw-result-score{font-size:36px;font-weight:800;letter-spacing:-2px}
.hw-result-copy{min-width:0;margin-left:15px}
.hw-result-title{font-size:16px;font-weight:700}
.hw-result-comment{margin-top:4px;font-size:13px;line-height:1.5}
.hw-button{min-width:156px;padding:0 24px;border-radius:599px;font-size:16px;font-weight:650;line-height:50px}
.hw-spinner{width:33px;height:33px;margin:0 auto 16px;box-sizing:border-box;border:3px solid #FFE4C4;border-top-color:#FD7C02;border-radius:50%}
.hw-bottom{right:max(0px, 50% - var(--lg-col) / 2);bottom:0;left:max(0px, 50% - var(--lg-col) / 2);padding:10px 16px calc(13px + env(safe-area-inset-bottom))}
.hw-submit{width:60%;margin:0 auto;border-radius:599px;font-size:17px;font-weight:650;line-height:57px}
.hw-submit.is-ready{box-shadow:0 6px 13px rgba(253, 124, 2, .24)}
.hw-sk-option{height:48px;margin-top:8px;border-radius:12px}
.hw-card .sk-line + .sk-line{margin-top:10px}
}
