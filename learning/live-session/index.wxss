.live-page { min-height: 100vh; padding: 48rpx 28rpx calc(env(safe-area-inset-bottom) + 48rpx); }.live-skeleton { height: 560rpx; }.live-head { padding: 0 8rpx; }.live-eyebrow { display: block; color: var(--accent-deep); font-size: 22rpx; font-weight: 700; }.live-title { display: block; margin-top: 12rpx; font-size: 42rpx; font-weight: 700; line-height: 1.3; }.live-status { display: inline-flex; margin-top: 16rpx; padding: 8rpx 14rpx; border-radius: 8rpx; background: var(--yellow-soft); color: var(--yellow); font-size: 20rpx; font-weight: 700; }.live-card { margin-top: 24rpx; padding: 28rpx; }.live-card__label, .live-card__value, .live-card__meta { display: block; }.live-card__label { color: var(--muted); font-size: 20rpx; }.live-card__value { margin-top: 10rpx; font-size: 28rpx; font-weight: 700; line-height: 1.45; }.live-card__meta { margin-top: 12rpx; color: var(--muted); font-size: 21rpx; line-height: 1.55; }.live-meeting-button { min-height: 72rpx; margin-top: 22rpx; color: var(--accent-deep); font-size: 23rpx; font-weight: 700; }.live-task-link { min-height: 84rpx; margin-top: 32rpx; padding: 0 10rpx; color: var(--accent-deep); font-size: 24rpx; }
