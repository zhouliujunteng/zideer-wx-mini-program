<view class="live-page"><view class="live-skeleton skeleton" wx:if="{{loading}}"></view><view class="state-panel" wx:elif="{{failed}}"><view class="state-panel__mark">!</view><text class="state-panel__title">场次详情暂时无法加载</text><button class="state-panel__action pressable" bindtap="loadPage">重新加载</button></view><view class="state-panel" wx:elif="{{!session}}"><view class="state-panel__mark">!</view><text class="state-panel__title">该场次暂不可查看</text><text class="state-panel__copy">场次可能已取消、调整，或当前身份无权查看。</text><button class="state-panel__action pressable" bindtap="openDailyTask">查看每日学习任务</button></view><block wx:else><view class="live-head"><text class="live-eyebrow">真人陪跑</text><text class="live-title">{{session.teacherName}}</text><text class="live-status">{{session.statusLabel}}</text></view><view class="live-card surface"><text class="live-card__label">服务时间</text><text class="live-card__value">{{session.timeLabel}}</text><text class="live-card__meta">结束于 {{session.endLabel}}</text></view><view class="live-card surface"><text class="live-card__label">服务信息</text><text class="live-card__value">{{session.serviceMode === 'parallel_coaching' ? '真人陪跑' : '真人服务'}}</text><text class="live-card__meta">{{session.attendanceLabel}}</text></view><view class="live-card surface"><text class="live-card__label">会议与支持</text><text class="live-card__meta">会议入口仅在服务时间内由平台开放；课程外仍可继续自主学习。</text><button class="live-meeting-button pressable" bindtap="showMeetingState">查看会议状态</button></view><button class="live-task-link pressable" bindtap="openDailyTask">返回每日学习任务</button></block></view>
