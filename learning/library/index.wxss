.library-page { padding: 32rpx; color: #252b25; }
.library-search { box-sizing: border-box; width: 100%; height: 88rpx; padding: 0 24rpx; border: 1px solid #d8dedb; border-radius: 12rpx; background: #fff; font-size: 28rpx; }
.library-state { padding: 80rpx 16rpx; text-align: center; font-size: 28rpx; color: #626a66; line-height: 1.7; }
.library-state text { display: block; }
.library-retry { margin-top: 32rpx; font-size: 28rpx; background: #267348; color: #fff; border-radius: 12rpx; }
.library-list { margin-top: 24rpx; }
.library-course { display: flex; align-items: center; gap: 24rpx; min-height: 144rpx; padding: 24rpx; margin-bottom: 20rpx; background: #fff; border: 1px solid #e2e6e3; border-radius: 12rpx; box-sizing: border-box; }
.library-course-main { flex: 1; min-width: 0; }
.library-course-meta { display: block; margin-bottom: 12rpx; font-size: 24rpx; color: #626a66; }
.library-course-title { display: block; font-size: 32rpx; line-height: 1.5; word-break: break-all; }
.library-course-icon { width: 44rpx; height: 44rpx; flex-shrink: 0; }
