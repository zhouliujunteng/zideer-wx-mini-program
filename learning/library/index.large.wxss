/* 自动生成，请勿手改：index.wxss 在平板、电脑大屏（窗口宽 ≥ 450px）下的样式。
   rpx 按 1rpx = 0.6px 换算，固定定位元素收进居中栏；改完源文件后运行 node scripts/build-large-screen-styles.mjs */
@media (min-width: 450px) {
.sk{border-radius:7px}
.sk-line{height:16px}
.sk-line + .sk-line{margin-top:8px}
.sk-short{width:40%}
.sk-mid{width:64%}
.sk-round{border-radius:50%}
.sk-card{height:96px;border-radius:14px}
.sk-card + .sk-card{margin-top:12px}
.task-all-link{font-size:13px}
.task-all-icon{flex:0 0 7px;width:7px;height:7px;margin-left:7px;box-sizing:border-box;border-top:1px solid #a6afa9;border-right:1px solid #a6afa9;transform:rotate(45deg)}
.more-courses-grid{flex-wrap:wrap;margin-top:16px;gap:21px 13px}
.more-course-card{width:calc((100% - 13px) / 2);min-width:0}
.more-course-cover{height:126px;border-radius:14px}
.more-course-cover-image{width:100%;height:100%}
.more-course-cover-mark{font-size:20px;font-weight:700;letter-spacing:2px}
.more-course-info{margin-top:8px;gap:6px}
.more-course-copy{flex:1;min-width:0}
.more-course-title{font-size:15px;font-weight:700;line-height:1.4;-webkit-box-orient:vertical;-webkit-line-clamp:3}
.more-course-subtitle{margin-top:3px;font-size:11px;line-height:1.35}
.more-course-price{flex:0 0 auto;font-size:14px;font-weight:700;line-height:1.2}
.more-course-tag{top:8px;right:8px;padding:2px 8px;border-radius:599px;font-size:12px;font-weight:600;line-height:16px;letter-spacing:0;box-shadow:0 1px 4px rgba(36, 51, 45, .12)}
.more-course-series{right:0;bottom:0;left:0;padding:12px 9px 4px;font-size:11px;font-weight:600;line-height:1.35;-webkit-box-orient:vertical;-webkit-line-clamp:2}
.course-search{height:49px;box-sizing:border-box;padding:0 13px;border:0;border-radius:15px}
.course-search:focus-within{border:1px solid rgba(253, 124, 2, .42)}
.course-search-icon{flex:0 0 16px;width:16px;height:16px;margin-right:8px}
.course-search-input{min-width:0;flex:1;height:49px;font-size:15px;line-height:49px}
.course-search-clear{flex:0 0 24px;width:24px;height:24px;border-radius:50%;font-size:16px;font-weight:300;line-height:1}
.more-course-card{width:calc((100% - 2 * 13px) / 3)}
.more-course-cover{height:auto}
.more-course-cover-image{left:0;top:0}
}
@media (min-width: 450px) and (min-width: 900px) {
.more-course-card{width:calc((100% - 3 * 13px) / 4)}
}
@media (min-width: 450px) {
.member-courses-page{height:100vh}
.member-courses-topbar{top:0;left:max(0px, 50% - var(--lg-col) / 2);width:min(100%, var(--lg-col));box-sizing:border-box}
.member-courses-topbar-inner{box-sizing:content-box;padding:0 21px 9px}
.member-courses-topbar-title{left:50%;font-size:21px;font-weight:700;letter-spacing:-1px;transform:translateX(-50%)}
.member-courses-back{flex:0 0 auto;width:26px;height:26px;margin-right:6px;border-radius:50%}
.member-courses-back-icon{width:12px;height:12px;box-sizing:border-box;border-bottom:1px solid #425148;border-left:1px solid #425148;transform:rotate(45deg) scale(.72)}
.member-courses-scroll{width:100%;height:100vh;box-sizing:border-box}
.member-courses-shell{min-height:100%;padding:4px 21px calc(108px + env(safe-area-inset-bottom));box-sizing:border-box}
.member-courses-search-region{right:max(0px, 50% - var(--lg-col) / 2);left:max(0px, 50% - var(--lg-col) / 2);box-sizing:border-box}
.member-courses-search-region.is-hidden{transform:translateY(calc(-100% - 9px))}
.member-courses-search-region .course-search{margin:16px 21px 10px}
.series-tabs{width:100%;margin-top:4px}
.series-tab-list{padding:2px 0;gap:8px}
.series-tab{flex:0 0 auto;max-width:216px;height:34px;padding:0 14px;box-sizing:border-box;border-radius:599px;font-size:13px}
.series-tab.is-active{font-weight:600}
.series-tab-count{flex:0 0 auto;margin-left:4px;font-size:12px}
.member-courses-grid{grid-template-columns:repeat(2, minmax(0, 1fr));column-gap:13px;row-gap:20px;margin-top:15px}
.member-course-card{min-width:0}
.member-course-cover{height:130px;border-radius:14px}
.member-course-cover-image{width:100%;height:100%}
.member-course-info{min-width:0;padding:8px 1px 0}
.member-course-name{-webkit-box-orient:vertical;-webkit-line-clamp:3;font-size:15px;font-weight:700;line-height:1.3}
.member-course-subtitle{margin-top:4px;font-size:11px;line-height:1.3}
.member-course-price{margin-top:7px;font-size:13px;font-weight:700;line-height:1.2}
.member-courses-empty{min-height:252px;flex-direction:column}
.member-courses-empty-icon{width:46px;height:46px}
.member-courses-empty-title{margin-top:14px;font-size:15px;font-weight:650}
.member-courses-empty-subtitle{margin-top:6px;font-size:12px}
.member-courses-action{margin-top:16px;padding:9px 24px;border-radius:599px;font-size:15px}
.member-course-sk-cover{height:130px;border-radius:14px}
}
