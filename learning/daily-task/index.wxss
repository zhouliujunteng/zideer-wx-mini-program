.daily-page { min-height:100vh; padding:52rpx 28rpx calc(env(safe-area-inset-bottom) + 48rpx); }.daily-skeleton { height:460rpx; }.daily-head { padding:0 8rpx; }.daily-eyebrow { display:block; color:var(--accent-deep); font-size:22rpx; font-weight:700; }.daily-title { display:block; margin-top:12rpx; max-width:100%; font-size:39rpx; font-weight:700; line-height:1.32; overflow-wrap:anywhere; }.daily-plan-link { min-height:58rpx; margin-top:16rpx; color:var(--accent-deep); font-size:23rpx; }.daily-empty { margin-top:34rpx; padding:30rpx; color:var(--muted); font-size:23rpx; line-height:1.55; }.daily-list { overflow:hidden; margin-top:30rpx; padding:0 24rpx; }.daily-task { display:flex; align-items:flex-start; gap:18rpx; padding:28rpx 0; border-bottom:1rpx solid var(--line); }.daily-task:last-child { border-bottom:0; }.daily-task__sequence { display:flex; width:42rpx; height:42rpx; align-items:center; justify-content:center; flex:none; border-radius:50%; background:var(--accent-soft); color:var(--accent-deep); font-size:20rpx; font-weight:700; }.daily-task__copy { min-width:0; flex:1; }.daily-task__title { display:block; font-size:26rpx; font-weight:700; line-height:1.35; overflow-wrap:anywhere; }.daily-task__meta { display:block; margin-top:9rpx; color:var(--muted); font-size:21rpx; line-height:1.5; }.daily-note { display:block; margin:24rpx 8rpx; color:var(--muted); font-size:21rpx; line-height:1.55; }
