.outline-page{padding:32rpx 28rpx calc(40rpx + env(safe-area-inset-bottom));background:#f5f6f8;min-height:100vh;color:#273142}.eyebrow,.heading,.hint,.label,.section-title{display:block}.eyebrow{font-size:22rpx;color:#8560b6}.heading{font-size:44rpx;font-weight:600;margin:22rpx 0 14rpx}.hint{font-size:25rpx;line-height:1.7;color:#728093;white-space:normal}.chapter{padding:26rpx;margin:24rpx 0;border-radius:24rpx;background:#fff}.label{font-size:24rpx;color:#728093;margin:22rpx 0 12rpx}.chapter input{font-size:32rpx;min-height:70rpx;border-bottom:1rpx solid #edf0f3}.chapter textarea{font-size:27rpx;line-height:1.7;width:100%;min-height:90rpx;padding:14rpx;background:#f7f8fa;border-radius:12rpx;box-sizing:border-box}.chapter-head{display:flex;align-items:center;justify-content:space-between;color:#728093;font-size:24rpx;margin-bottom:16rpx}.chapter-tools{display:flex;gap:8rpx}.chapter-tools button{font-size:23rpx;padding:0 14rpx;line-height:64rpx;min-width:64rpx;background:#f5f6f8}.chapter-tools button::after,.mode::after,.cancel::after{border:0}.section-title{font-size:32rpx;font-weight:600;margin:36rpx 0 20rpx}.mode{display:block;text-align:left;background:#fff;border:2rpx solid #e3e6ed;border-radius:22rpx;padding:24rpx;line-height:1.7;margin:16rpx 0;font-size:31rpx}.mode--selected{background:#f6f0ff;border-color:#9875cc}.actions{display:flex;gap:16rpx;margin-top:28rpx}.actions button{flex:1;margin:0;font-size:27rpx}.primary-action,.secondary-action{border-radius:18rpx;min-height:88rpx;font-size:28rpx}.primary-action{background:#8051c8;color:white}.secondary-action{background:white;color:#604491;border:1rpx solid #e1d6f0}.error{display:block;color:#b94c4c;font-size:25rpx;line-height:1.7;margin:20rpx 0}.cancel{background:transparent;color:#7b8695;font-size:25rpx;margin-top:20rpx}
.chapter-config{border-top:1rpx solid #edf0f3;margin-top:26rpx}.config-choice{padding:20rpx;background:#f7f8fa;border-radius:12rpx;font-size:27rpx}.question-option{display:inline-flex;align-items:center;min-height:88rpx;margin-right:20rpx;font-size:26rpx}.config-switch{display:flex;align-items:center;justify-content:space-between;font-size:27rpx;margin-top:24rpx}
