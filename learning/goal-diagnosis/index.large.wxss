/* 自动生成，请勿手改：index.wxss 在平板、电脑大屏（窗口宽 ≥ 450px）下的样式。
   rpx 按 1rpx = 0.6px 换算，固定定位元素收进居中栏；改完源文件后运行 node scripts/build-large-screen-styles.mjs */
@media (min-width: 450px) {
.sk{border-radius:7px}
.sk-line{height:16px}
.sk-line + .sk-line{margin-top:8px}
.sk-short{width:40%}
.sk-mid{width:64%}
.sk-round{border-radius:50%}
.sk-card{height:96px;border-radius:14px}
.sk-card + .sk-card{margin-top:12px}
.pref-page{height:100vh}
.pref-ambient{inset:0}
.pref-topbar{top:0;left:max(0px, 50% - var(--lg-col) / 2);right:max(0px, 50% - var(--lg-col) / 2)}
.pref-topbar-inner{box-sizing:content-box}
.pref-back{width:44px;height:44px}
.pref-back-icon{width:9px;height:9px;border-bottom:1.8px solid #24332D;border-left:1.8px solid #24332D}
.pref-topbar-title{left:50%}
.pref-scroll{height:100vh;box-sizing:border-box}
.pref-shell{box-sizing:border-box;max-width:680px;margin:0 auto}
.pref-heading{margin:0 2px 18px}
.pref-subtitle{margin-top:8px}
.pref-card{margin-bottom:14px;border-radius:22px;box-shadow:0 3px 14px rgba(56,75,64,.025)}
.pref-optional{margin-left:8px}
.pref-options{margin-top:14px}
.pref-chip{box-sizing:border-box;min-height:38px;border:1px solid transparent;border-radius:999px}
.pref-chip.is-selected{border-color:#FFD8B3}
.pref-note{box-sizing:border-box;width:100%;height:104px;margin-top:12px}
.pref-preview{box-shadow:none;border:1px solid #FFE7CF}
.pref-preview-line{margin-top:12px}
.pref-preview-text{margin-top:3px}
.pref-preview-empty{margin-top:10px}
.pref-read-notice{margin-bottom:14px;border-radius:16px}
.pref-read-notice-copy{min-width:0}
.pref-read-retry{border-radius:999px}
.pref-options-sk{margin-top:16px}
.pref-chip-sk{height:38px;border-radius:999px}
.pref-footer{left:max(0px, 50% - var(--lg-col) / 2);right:max(0px, 50% - var(--lg-col) / 2);bottom:0;box-sizing:border-box;box-shadow:0 -6px 20px rgba(32, 54, 46, .05)}
.pref-save-error{margin-bottom:10px;border-radius:14px}
.pref-save{width:100%;max-width:644px;min-height:48px;margin:0 auto;border-radius:999px}
.pref-save::after{border:none}
.bean-loader{height:40px;margin-bottom:12px}
.bean-loader view{width:14px;height:14px;border-radius:50%}
.bean-loader.is-small{height:28px;margin-bottom:6px}
.bean-loader.is-small view{width:10px;height:10px}
.gm-goal-ring{width:16px;height:16px;box-sizing:border-box;border:2px solid #FD7C02;border-radius:50%}
.gm-goal-ring-dot{width:6px;height:6px;border-radius:50%}
.gm-goal-ring.is-big{width:46px;height:46px;border-width:4px}
.gm-goal-ring.is-big .gm-goal-ring-dot{width:16px;height:16px}
.gm-state-chip{border-radius:999px}
.gm-goal-text{margin-top:10px}
.gm-goal-tags{margin-top:12px}
.gm-tag{border-radius:999px}
.gm-tag-link{margin-left:auto}
.gm-sk-gap{margin-top:12px}
.gm-sk-map{height:300px;border-radius:16px}
.gm-hero-icon{margin-bottom:14px}
.gm-state-copy{margin-top:8px}
.gm-primary-inline{margin-top:18px;border-radius:999px}
.gm-ghost-btn{margin-top:16px;border-radius:999px}
.gm-steps{margin-top:16px}
.gm-step-no{width:24px;height:24px;border-radius:50%}
.gm-step-copy{min-width:0}
.gm-step-desc{margin-top:2px}
.gm-intro-foot{margin-top:10px;border-top:1px solid #F0F1EF}
.gm-planning-lines{margin-top:18px}
.gm-planning-lines .sk{margin-top:10px}
.gm-progress{margin:2px 2px 12px}
.gm-progress-dot{width:18px;height:6px;border-radius:3px}
.gm-progress-text{min-width:0}
.gm-path-sep{width:5px;height:5px;border-top:1.2px solid #C5CCC7;border-right:1.2px solid #C5CCC7}
.gm-dig{margin-top:10px;border-radius:12px}
.gm-dig-icon{width:10px;height:10px;box-sizing:border-box;border-left:2px solid #FD7C02;border-bottom:2px solid #FD7C02}
.gm-prompt{margin-top:14px}
.gm-figures{margin-top:12px}
.gm-figure-frame{width:100%;max-width:420px;margin:0 auto 8px}
.gm-figure-box{height:0;margin:0 auto;border-radius:12px}
.gm-figure{top:0;left:0;width:100%;height:100%}
.gm-options{margin-top:16px}
.gm-option{margin-top:10px;border:1.5px solid #EEF0ED;border-radius:16px}
.gm-option.is-selected{border-color:#FD7C02}
.gm-option-letter{width:24px;height:24px;border-radius:50%}
.gm-option-body{min-width:0}
.gm-option-figure-frame{width:100%;max-width:240px;margin-top:6px}
.gm-option-figure-frame .gm-figure-box{border-radius:8px}
.gm-sk-option{height:50px;margin-top:10px;border-radius:16px}
.gm-pause{margin:4px auto 0}
.gm-answer-row{max-width:644px;margin:0 auto}
.gm-dont-know{width:104px;min-height:48px;margin:0;border-radius:999px;border:1px solid #E3E7E3}
.gm-dont-know::after{border:none}
.gm-secondary{width:100%;max-width:644px;min-height:48px;margin:0 auto;border-radius:999px}
.gm-secondary::after{border:none}
.gm-summary{margin-bottom:14px}
.gm-summary-item{min-width:0;border-radius:18px;box-shadow:0 3px 14px rgba(56,75,64,.025)}
.gm-summary-label{margin-top:4px}
.gm-paused-note{margin-bottom:14px;border-radius:14px}
.gm-list-sub{margin-top:4px}
.gm-root-row{margin-top:12px;border-radius:14px}
.gm-root-mark{width:8px;height:8px;border-radius:50%;box-shadow:0 0 0 4px rgba(210,69,31,.14)}
.gm-root-label{min-width:0}
.gm-path-steps{margin-top:8px}
.gm-path-step + .gm-path-step::before{left:11px;top:-9px;height:18px;border-left:2px dotted #FFC48A}
.gm-path-step-no{width:24px;height:24px;border-radius:50%}
.gm-path-step-label{min-width:0}
.gm-list-foot{margin-top:8px;border-top:1px solid #F0F1EF}
.gm-card-dot{width:6px;height:6px;border-radius:50%}
}
