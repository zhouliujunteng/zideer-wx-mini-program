/* 自动生成，请勿手改：index.wxss 在平板、电脑大屏（窗口宽 ≥ 450px）下的样式。
   rpx 按 1rpx = 0.6px 换算，固定定位元素收进居中栏；改完源文件后运行 node scripts/build-large-screen-styles.mjs */
@media (min-width: 450px) {
.surface{border-radius:14px}
.skeleton{border-radius:9px}
.state-panel{padding:72px 14px 24px}
.state-panel__mark{margin-bottom:14px;font-size:31px}
.state-panel__title{font-size:19px;font-weight:600}
.state-panel__copy{margin:13px 0 19px;font-size:15px;line-height:1.6}
.state-panel__action{border-radius:12px}
.state-panel__action::after{border:0}
.sk{border-radius:7px}
.sk-line{height:16px}
.sk-line + .sk-line{margin-top:8px}
.sk-short{width:40%}
.sk-mid{width:64%}
.sk-round{border-radius:50%}
.sk-card{height:96px;border-radius:14px}
.sk-card + .sk-card{margin-top:12px}
.qr-page{min-height:100vh}
.qr-topbar{top:0;left:max(0px, 50% - var(--lg-col) / 2);width:min(100%, var(--lg-col));box-sizing:border-box}
.qr-topbar-inner{box-sizing:content-box;padding:0 19px 9px}
.qr-topbar-title{left:50%;font-size:20px;font-weight:700;letter-spacing:-1px}
.qr-back{width:32px;height:32px;border-radius:50%}
.qr-back-icon{width:13px;height:13px;border-bottom:2px solid #24332D;border-left:2px solid #24332D}
.qr-shell{padding:0 19px calc(120px + env(safe-area-inset-bottom));box-sizing:border-box}
.qr-head{margin-top:7px;padding:0 2px}
.qr-head .sk-line + .sk-line{margin-top:10px}
.qr-round{padding:2px 9px;border-radius:599px;font-size:13px;font-weight:650}
.qr-title{margin-top:8px;font-size:22px;font-weight:780;line-height:1.3}
.qr-sub{margin-top:6px;font-size:15px;line-height:1.55}
.qr-card{margin-top:14px;padding:16px 15px;border-radius:16px}
.qr-card .sk-line + .sk-line{margin-top:10px}
.qr-card-title{font-size:16px;font-weight:720}
.qr-result{margin-top:12px}
.qr-result-title{font-size:14px;font-weight:680}
.qr-chips{gap:7px;margin-top:7px}
.qr-chip{padding:4px 10px;border-radius:599px;font-size:13px;line-height:1.4}
.qr-plan-head{margin-top:24px;padding:0 2px}
.qr-plan-title{font-size:19px;font-weight:760}
.qr-plan-summary{margin-top:4px;font-size:15px;line-height:1.55}
.qr-lesson-no{width:31px;height:31px;margin-right:12px;border-radius:50%;font-size:15px;font-weight:760;line-height:31px}
.qr-lesson-body{min-width:0}
.qr-lesson-title{font-size:16px;font-weight:700;line-height:1.4}
.qr-lesson-focus{margin-top:4px;font-size:14px;line-height:1.6}
.qr-lesson-tag{margin-left:7px;padding:2px 7px;border-radius:599px;font-size:12px}
.qr-credits{margin-top:13px;padding:0 2px;font-size:13px;line-height:1.6}
.qr-error{margin-top:14px;padding:13px 14px;border-radius:13px;font-size:15px;line-height:1.55}
.qr-error .qr-button{margin-top:9px}
.qr-button{margin-top:14px;min-width:132px;padding:0 21px;border-radius:599px;font-size:15px;font-weight:650;line-height:45px}
.qr-spinner{width:28px;height:28px;margin-top:14px;box-sizing:border-box;border:3px solid #FFE4C4;border-top-color:#FD7C02;border-radius:50%}
.qr-bottom{right:max(0px, 50% - var(--lg-col) / 2);bottom:0;left:max(0px, 50% - var(--lg-col) / 2);padding:10px 16px calc(13px + env(safe-area-inset-bottom))}
.qr-submit{width:80%;margin:0 auto;border-radius:599px;box-shadow:0 6px 13px rgba(253, 124, 2, .24);font-size:17px;font-weight:650;line-height:57px}
}
