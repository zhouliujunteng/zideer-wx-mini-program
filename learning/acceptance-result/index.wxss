.acceptance-page { min-height: 100vh; padding: 48rpx 28rpx calc(env(safe-area-inset-bottom) + 48rpx); }.acceptance-skeleton { height: 580rpx; }.acceptance-head { padding: 0 8rpx; }.acceptance-eyebrow { display: block; color: var(--accent-deep); font-size: 22rpx; font-weight: 700; }.acceptance-title { display: block; margin-top: 12rpx; font-size: 42rpx; font-weight: 700; }.acceptance-meta { display: block; margin-top: 12rpx; color: var(--muted); font-size: 21rpx; }.acceptance-status { margin-top: 34rpx; padding: 28rpx 26rpx; }.acceptance-status__label { display: block; color: var(--muted); font-size: 20rpx; }.acceptance-status__value { display: block; margin-top: 10rpx; color: var(--accent-deep); font-size: 29rpx; font-weight: 700; }.acceptance-status__value--pass { color: var(--green); }.acceptance-status__copy { display: block; margin-top: 12rpx; color: var(--muted); font-size: 21rpx; line-height: 1.55; }.acceptance-section { margin-top: 38rpx; }.acceptance-section__title { display: block; margin: 0 8rpx 16rpx; font-size: 24rpx; font-weight: 700; }.acceptance-panel { padding: 26rpx; color: var(--ink-soft); font-size: 23rpx; line-height: 1.7; }.acceptance-panel__label { display: block; margin-top: 22rpx; color: var(--muted); font-size: 20rpx; }.review-label { display: block; margin-bottom: 10rpx; color: var(--accent-deep); font-size: 24rpx; font-weight: 700; }.audio-summary { padding: 26rpx; }.audio-summary__title { display: block; font-size: 25rpx; font-weight: 700; }.audio-summary__copy { display: block; margin-top: 10rpx; color: var(--muted); font-size: 21rpx; line-height: 1.55; }.audio-summary__action { min-height: 56rpx; margin-top: 14rpx; padding: 0; color: var(--accent-deep); font-size: 22rpx; }.acceptance-actions { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.25fr); gap: 16rpx; margin-top: 44rpx; }.secondary-action, .primary-action { min-height: 88rpx; padding: 0 16rpx; border-radius: 8rpx; font-size: 23rpx; }.secondary-action { border: 1rpx solid var(--line); background: var(--surface); color: var(--ink); }.primary-action { background: var(--accent); color: #fff; }
