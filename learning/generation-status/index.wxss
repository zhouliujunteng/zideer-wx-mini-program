.generation-page {
  --accent: #267348;
  --accent-deep: #1d5d3b;
  --green: #267348;
  --muted: #626a66;
  --line: #d8dedb;
  --surface: #ffffff;
  --ink: #22322b;
  min-height: 100vh;
  box-sizing: border-box;
  padding: 48rpx 28rpx calc(env(safe-area-inset-bottom) + 48rpx);
}
.generation-skeleton { height: 560rpx; background: #e7ece9; border-radius: 12rpx; }
.generation-head { padding: 0 8rpx; }
.generation-head__eyebrow { display: block; color: var(--accent-deep); font-size: 22rpx; font-weight: 700; }
.generation-head__title { display: block; margin-top: 12rpx; font-size: 42rpx; font-weight: 700; line-height: 1.4; overflow-wrap: anywhere; }
.generation-head__meta { display: block; margin-top: 12rpx; color: var(--muted); font-size: 21rpx; }
.generation-state { margin-top: 36rpx; padding: 30rpx 8rpx; border-top: 1rpx solid var(--line); border-bottom: 1rpx solid var(--line); }
.generation-state__indicator { width: 16rpx; height: 16rpx; border-radius: 50%; background: var(--accent); }
.generation-state--ready .generation-state__indicator { background: var(--green); }
.generation-state--error .generation-state__indicator { background: #D6574B; }
.generation-state__title { display: block; margin-top: 18rpx; font-size: 30rpx; font-weight: 700; }
.generation-state__copy { display: block; margin-top: 12rpx; color: var(--muted); font-size: 26rpx; line-height: 1.6; }
.generation-info { margin-top: 22rpx; padding: 28rpx 8rpx; }
.generation-info__label, .generation-info__value, .generation-info__note { display: block; }
.generation-info__label { color: var(--muted); font-size: 24rpx; }
.generation-info__value { margin-top: 8rpx; font-size: 26rpx; font-weight: 700; }
.generation-info__note { margin-top: 16rpx; color: var(--muted); font-size: 24rpx; line-height: 1.6; }
.generation-actions { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16rpx; margin-top: 40rpx; }
.generation-quote { border-top: 1rpx solid var(--line); }
.secondary-action, .primary-action { display: flex; align-items: center; justify-content: center; width: 100%; min-height: 88rpx; margin: 0; padding: 16rpx 12rpx; box-sizing: border-box; border-radius: 8rpx; font-size: 28rpx; line-height: 1.5; }
.secondary-action::after, .primary-action::after { border: 0; }
.secondary-action { border: 1rpx solid var(--line); background: var(--surface); color: var(--ink); }
.primary-action { background: var(--accent); color: #fff; }
.primary-action--disabled { background: #D9DCE0; color: #777C83; }
.state-panel { padding: 80rpx 16rpx; text-align: center; }
.state-panel__mark { margin-bottom: 24rpx; color: #b43d35; font-size: 40rpx; font-weight: 700; }
.state-panel__title, .state-panel__copy { display: block; }
.state-panel__title { font-size: 32rpx; font-weight: 600; }
.state-panel__copy { margin-top: 20rpx; color: var(--muted); font-size: 26rpx; line-height: 1.7; }
.state-panel__action { margin-top: 32rpx; background: var(--accent); color: #fff; font-size: 28rpx; border-radius: 8rpx; }
.generation-background-note { display: block; font-size: 26rpx; color: #67736c; line-height: 1.7; padding: 12rpx 0; }
.secondary-action--disabled { background: #f1f3f2; color: #87918b; }
