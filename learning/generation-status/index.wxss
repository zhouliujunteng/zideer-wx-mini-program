.generation-page { min-height: 100vh; padding: 48rpx 28rpx calc(env(safe-area-inset-bottom) + 48rpx); }
.generation-skeleton { height: 560rpx; }
.generation-head { padding: 0 8rpx; }
.generation-head__eyebrow { display: block; color: var(--accent-deep); font-size: 22rpx; font-weight: 700; }
.generation-head__title { display: block; margin-top: 12rpx; font-size: 42rpx; font-weight: 700; line-height: 1.3; }
.generation-head__meta { display: block; margin-top: 12rpx; color: var(--muted); font-size: 21rpx; }
.generation-state { margin-top: 36rpx; padding: 30rpx; }
.generation-state__indicator { width: 16rpx; height: 16rpx; border-radius: 50%; background: var(--accent); }
.generation-state--ready .generation-state__indicator { background: var(--green); }
.generation-state--error .generation-state__indicator { background: #D6574B; }
.generation-state__title { display: block; margin-top: 18rpx; font-size: 30rpx; font-weight: 700; }
.generation-state__copy { display: block; margin-top: 12rpx; color: var(--muted); font-size: 22rpx; line-height: 1.6; }
.generation-info { margin-top: 22rpx; padding: 28rpx; }
.generation-info__label, .generation-info__value, .generation-info__note { display: block; }
.generation-info__label { color: var(--muted); font-size: 20rpx; }
.generation-info__value { margin-top: 8rpx; font-size: 26rpx; font-weight: 700; }
.generation-info__note { margin-top: 16rpx; color: var(--muted); font-size: 20rpx; line-height: 1.5; }
.generation-actions { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16rpx; margin-top: 40rpx; }
.secondary-action, .primary-action { min-height: 88rpx; padding: 0 12rpx; border-radius: 8rpx; font-size: 23rpx; }
.secondary-action { border: 1rpx solid var(--line); background: var(--surface); color: var(--ink); }
.primary-action { background: var(--accent); color: #fff; }
.primary-action--disabled { background: #D9DCE0; color: #777C83; }
