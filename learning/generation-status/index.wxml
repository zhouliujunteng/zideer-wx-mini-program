<view class="generation-page">
  <view class="generation-skeleton skeleton" wx:if="{{loading}}"></view>
  <view class="state-panel" wx:elif="{{failed}}"><view class="state-panel__mark">!</view><text class="state-panel__title">课程进度暂时无法加载</text><text class="state-panel__copy">请确认网络和登录状态后重新读取。</text><button class="state-panel__action pressable" bindtap="loadPage">重新加载</button></view>
  <view class="state-panel" wx:elif="{{!result}}"><view class="state-panel__mark">!</view><text class="state-panel__title">未找到课程任务</text><text class="state-panel__copy">该任务可能已被重新规划，或当前身份无权查看。</text><button class="state-panel__action pressable" bindtap="goBack">返回学习页</button></view>
  <block wx:else>
    <view class="generation-head"><text class="generation-head__eyebrow">课程生成</text><text class="generation-head__title">{{result.taskTitle}}</text><text class="generation-head__meta">{{result.subject}}</text></view>
    <view class="generation-state surface generation-state--{{result.tone}}"><view class="generation-state__indicator"></view><text class="generation-state__title">{{result.title}}</text><text class="generation-state__copy">{{result.copy}}</text></view>
    <view class="generation-info surface"><view><text class="generation-info__label">{{result.canRetryGeneration ? '上次报价与退回记录' : '课程积分'}}</text><text class="generation-info__value">{{result.credits}}</text></view><text class="generation-info__note">{{result.settlementNote}}</text></view>
    <view class="generation-info generation-quote" wx:if="{{result.canStartGeneration && quote}}">
      <text class="generation-info__label">本次报价</text>
      <text class="generation-info__value">本节结算上限 {{quote.frozenTargetDisplay}} 积分</text>
      <text class="generation-info__note">确认后冻结 {{quote.frozenTargetDisplay}} 积分，先生成可编辑大纲，确认模式后生成课程。课程可用后按实际用量结算并退回差额。</text>
    </view>
    <text class="generation-info__note" wx:if="{{outlineError}}">{{outlineError}}</text>
    <view class="generation-actions">
      <button class="secondary-action pressable" bindtap="loadPage" disabled="{{starting || quoting}}">刷新状态</button>
      <button class="primary-action pressable" wx:if="{{result.canLaunch}}" bindtap="startCourse">{{result.launchLabel}}</button>
      <button class="primary-action pressable" wx:if="{{result.canStartAcceptance}}" bindtap="startAcceptance">开始复述</button>
      <button class="secondary-action secondary-action--disabled" wx:elif="{{result.canLaunch}}" disabled="true">完成课程后解锁复述</button>
      <button class="primary-action pressable" wx:elif="{{outlineReady}}" bindtap="editOutline">编辑大纲并选择模式</button>
      <block wx:elif="{{result.canStartGeneration}}">
        <button class="primary-action pressable" wx:if="{{quote}}" bindtap="startGeneration" loading="{{starting}}" disabled="{{starting}}">{{starting ? '正在冻结积分' : '确认冻结并获取大纲'}}</button>
        <button class="primary-action pressable" wx:else bindtap="requestQuote" loading="{{quoting}}" disabled="{{quoting}}">{{quoting ? '正在获取报价' : (result.canRetryGeneration ? '重新报价并生成' : '获取课程报价')}}</button>
      </block>
      <text class="generation-background-note" wx:elif="{{result.canPoll}}">课程仍在生成，离开此页不会中断。稍后可从学习任务查看。</text>
      <button class="primary-action pressable" wx:else bindtap="goBack">返回学习页</button>
    </view>
  </block>
</view>
<dev-reset-fab />
