@import "../../styles/skeleton.wxss";
@import "../../styles/card-back.wxss";

page {
  background: #FFF9F2;
}

.fs-page {
  height: 100vh;
  overflow: hidden;
  background: linear-gradient(180deg, #FFEFE6 0%, #FFF9F2 240rpx, #FFFFFF 70%);
  color: #24332d;
}

.fs-topbar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 20;
  display: flex;
  align-items: center;
  box-sizing: content-box;
  padding-left: 28rpx;
}

.fs-round-button {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  border: 1rpx solid rgba(0, 0, 0, 0.08);
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.92);
}

.fs-back-icon {
  width: 16rpx;
  height: 16rpx;
  margin-left: 6rpx;
  border-bottom: 4rpx solid #24332D;
  border-left: 4rpx solid #24332D;
  transform: rotate(45deg);
}

.fs-topbar-title {
  position: absolute;
  left: 50%;
  font-size: 34rpx;
  font-weight: 700;
  transform: translateX(-50%);
}

.fs-scroll {
  height: 100vh;
  box-sizing: border-box;
}

.fs-shell {
  padding: 20rpx 36rpx calc(80rpx + env(safe-area-inset-bottom));
}

.fs-sk-hero {
  height: 460rpx;
  border-radius: 36rpx;
}

.fs-sk-row {
  height: 120rpx;
  margin: 24rpx 0;
  border-radius: 28rpx;
}

/* ---------- 深色展台 ---------- */

.fs-hero {
  position: relative;
  overflow: hidden;
  padding: 40rpx 36rpx 36rpx;
  border-radius: 36rpx;
  background: linear-gradient(150deg, #2B2F38 0%, #23262E 55%, #3E0B12 130%);
  box-shadow: 0 24rpx 50rpx rgba(36, 40, 47, 0.25);
  color: #FFFFFF;
}

.fs-hero-glow {
  position: absolute;
  top: -120rpx;
  left: -80rpx;
  width: 420rpx;
  height: 420rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(253, 124, 2, 0.42), rgba(253, 124, 2, 0) 70%);
  pointer-events: none;
}

.fs-hero-top {
  position: relative;
  display: flex;
  align-items: center;
  gap: 30rpx;
}

/* 三颗斜放的橙色菱形碎片，轻轻上下浮 */
.fs-gems {
  position: relative;
  flex: none;
  width: 150rpx;
  height: 140rpx;
}

.fs-gem {
  position: absolute;
  border-radius: 10rpx;
  background: linear-gradient(135deg, #FFF1DC 0%, #FFB45E 45%, #FD7C02 100%);
  box-shadow: 0 0 30rpx rgba(253, 124, 2, 0.55), inset 0 0 0 3rpx rgba(255, 255, 255, 0.35);
  animation: fs-float 3.2s ease-in-out infinite;
}

.fs-gem-a { left: 40rpx; top: 22rpx; width: 70rpx; height: 70rpx; transform: rotate(45deg); }
.fs-gem-b { left: 0; top: 70rpx; width: 40rpx; height: 40rpx; transform: rotate(30deg); animation-delay: -1.1s; }
.fs-gem-c { left: 108rpx; top: 84rpx; width: 34rpx; height: 34rpx; transform: rotate(60deg); animation-delay: -2.1s; }

@keyframes fs-float {
  0%, 100% { margin-top: 0; }
  50% { margin-top: -10rpx; }
}

.fs-hero-copy {
  display: flex;
  flex-direction: column;
}

.fs-hero-label {
  color: rgba(255, 255, 255, 0.65);
  font-size: 26rpx;
}

.fs-hero-count {
  font-size: 96rpx;
  font-weight: 800;
  line-height: 1.05;
  letter-spacing: 2rpx;
}

.fs-progress {
  position: relative;
  height: 16rpx;
  margin-top: 30rpx;
  overflow: hidden;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.12);
}

.fs-progress-bar {
  height: 100%;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #FFB45E, #FD7C02);
  box-shadow: 0 0 16rpx rgba(253, 124, 2, 0.6);
  transition: width 500ms ease;
}

.fs-progress-text {
  display: block;
  margin-top: 14rpx;
  color: rgba(255, 255, 255, 0.72);
  font-size: 24rpx;
}

.fs-exchange {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 18rpx;
  height: 96rpx;
  margin-top: 32rpx;
  border-radius: 24rpx;
  background: #FD7C02;
  font-size: 32rpx;
  font-weight: 800;
  box-shadow: 0 16rpx 36rpx rgba(253, 124, 2, 0.35);
}

.fs-exchange:active {
  transform: scale(0.98);
}

.fs-exchange-cost {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(0, 0, 0, 0.18);
  font-size: 24rpx;
}

.fs-mini-gem {
  width: 16rpx;
  height: 16rpx;
  border-radius: 3rpx;
  background: #FFF1DC;
  transform: rotate(45deg);
}

.fs-exchange-off {
  background: rgba(255, 255, 255, 0.14);
  color: rgba(255, 255, 255, 0.5);
  box-shadow: none;
}

/* ---------- 通用次数 ---------- */

.fs-bonus {
  display: flex;
  align-items: center;
  gap: 22rpx;
  margin-top: 24rpx;
  padding: 26rpx 28rpx;
  border-radius: 28rpx;
  background: #FFFFFF;
  box-shadow: 0 10rpx 28rpx rgba(36, 51, 45, 0.08);
}

.fs-bonus:active {
  opacity: 0.85;
}

.fs-ticket-mini {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 64rpx;
  height: 84rpx;
  border-radius: 12rpx;
  background: linear-gradient(160deg, #FFB45E, #FD7C02);
  color: #FFFFFF;
  font-size: 28rpx;
  font-weight: 800;
  transform: rotate(-6deg);
}

.fs-bonus-copy {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  min-width: 0;
}

.fs-bonus-title {
  font-size: 30rpx;
  font-weight: 800;
}

.fs-bonus-sub {
  color: #8a928e;
  font-size: 24rpx;
}

.fs-bonus-go {
  color: #FD7C02;
  font-size: 26rpx;
  font-weight: 700;
}

/* ---------- 碎片怎么来 ---------- */

.fs-howto {
  margin-top: 40rpx;
}

.fs-howto-title {
  display: block;
  margin-bottom: 20rpx;
  font-size: 34rpx;
  font-weight: 800;
}

.fs-step {
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
  padding: 22rpx 0;
  border-bottom: 1rpx solid rgba(36, 51, 45, 0.06);
}

.fs-step-no {
  flex: none;
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: rgba(253, 124, 2, 0.12);
  color: #FD7C02;
  font-size: 24rpx;
  font-weight: 800;
  line-height: 44rpx;
  text-align: center;
}

.fs-step-text {
  flex: 1;
  color: #4b5563;
  font-size: 28rpx;
  line-height: 1.6;
}

.fs-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 200rpx;
  text-align: center;
}

.fs-state-title {
  font-size: 32rpx;
  font-weight: 700;
}

.fs-state-copy {
  margin-top: 14rpx;
  color: #8a928e;
  font-size: 26rpx;
}

.fs-state-action {
  margin-top: 36rpx;
  padding: 18rpx 48rpx;
  border-radius: 999rpx;
  background: #FD7C02;
  color: #FFFFFF;
  font-size: 28rpx;
  font-weight: 700;
}

/* ---------- 兑换动画 ---------- */

.fs-fx {
  position: fixed;
  inset: 0;
  z-index: 900;
}

.fs-fx-mask {
  position: absolute;
  inset: 0;
  background: rgba(20, 22, 28, 0);
  backdrop-filter: blur(0);
  -webkit-backdrop-filter: blur(0);
  transition: background 380ms ease, backdrop-filter 380ms ease, -webkit-backdrop-filter 380ms ease;
}

.fs-fx-mask-on {
  background: rgba(20, 22, 28, 0.72);
  backdrop-filter: blur(18px);
  -webkit-backdrop-filter: blur(18px);
}

.fs-shard {
  position: absolute;
  z-index: 2;
  width: 14px;
  height: 14px;
  border-radius: 3px;
  background: linear-gradient(135deg, #FFF1DC, #FD7C02);
  box-shadow: 0 0 12px rgba(253, 124, 2, 0.8);
}

.fs-fx-card {
  position: absolute;
  z-index: 3;
  transform-style: preserve-3d;
  transition: transform 420ms cubic-bezier(0.3, 1.4, 0.5, 1), opacity 260ms ease;
}

.fs-fx-card.fs-hidden {
  opacity: 0;
  transform: perspective(1200px) scale(0.2);
}

.fs-fx-card.fs-forge {
  opacity: 1;
  transform: perspective(1200px) scale(1);
  animation: fs-forge-shake 420ms ease-in-out 120ms;
}

.fs-fx-card.fs-flip,
.fs-fx-card.fs-done {
  opacity: 1;
  transform: perspective(1200px) scale(1);
}

@keyframes fs-forge-shake {
  0%, 100% { margin-left: 0; }
  25% { margin-left: -8rpx; }
  50% { margin-left: 8rpx; }
  75% { margin-left: -5rpx; }
}

.fs-fx-flip {
  position: relative;
  width: 100%;
  height: 100%;
  transform-style: preserve-3d;
  transition: transform 460ms cubic-bezier(0.3, 1.18, 0.5, 1);
}

.fs-fx-backside {
  transform: rotateY(180deg);
}

.fs-fx-side {
  position: absolute;
  inset: 0;
  border-radius: 24rpx;
  overflow: hidden;
  backface-visibility: hidden;
  -webkit-backface-visibility: hidden;
  box-shadow: 0 0 60rpx rgba(253, 124, 2, 0.45), 0 30rpx 60rpx rgba(0, 0, 0, 0.35);
}

/* 正面：一张橙色的「通用抽卡」券 */
.fs-ticket {
  position: absolute;
  inset: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: radial-gradient(circle at 50% 35%, #FFD3A0 0%, #FD7C02 62%, #E06600 100%);
  color: #FFFFFF;
}

.fs-ticket-frame {
  position: absolute;
  inset: 20rpx;
  border: 3rpx dashed rgba(255, 255, 255, 0.6);
  border-radius: 18rpx;
}

.fs-ticket-kicker {
  font-size: 32rpx;
  font-weight: 700;
  letter-spacing: 6rpx;
}

.fs-ticket-plus {
  margin: 6rpx 0;
  font-size: 140rpx;
  font-weight: 900;
  line-height: 1;
  text-shadow: 0 8rpx 24rpx rgba(150, 60, 0, 0.35);
}

.fs-ticket-sub {
  color: rgba(255, 255, 255, 0.85);
  font-size: 24rpx;
}

.fs-fx-info {
  position: absolute;
  left: 0;
  right: 0;
  bottom: calc(env(safe-area-inset-bottom) + 120rpx);
  z-index: 4;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 0 48rpx;
  opacity: 0;
  transform: translateY(24rpx);
  transition: opacity 280ms ease, transform 320ms ease;
  pointer-events: none;
}

.fs-fx-info-on {
  opacity: 1;
  transform: translateY(0);
  pointer-events: auto;
}

.fs-fx-title {
  color: #FFFFFF;
  font-size: 40rpx;
  font-weight: 800;
}

.fs-fx-sub {
  margin-top: 12rpx;
  color: rgba(255, 255, 255, 0.7);
  font-size: 26rpx;
}

.fs-fx-actions {
  display: flex;
  gap: 20rpx;
  width: 100%;
  margin-top: 40rpx;
}

.fs-fx-btn {
  flex: 1;
  height: 92rpx;
  border-radius: 24rpx;
  background: #FD7C02;
  color: #FFFFFF;
  font-size: 30rpx;
  font-weight: 800;
  line-height: 92rpx;
  text-align: center;
}

.fs-fx-btn-ghost {
  background: rgba(255, 255, 255, 0.14);
}

.fs-confetti {
  position: absolute;
  inset: 0;
  z-index: 5;
  width: 100%;
  height: 100%;
  pointer-events: none;
}

@media (min-width: 450px) {
  .fs-fx-info {
    left: 50%;
    right: auto;
    width: var(--lg-col, 450px);
    box-sizing: border-box;
    transform: translate(-50%, 24rpx);
  }

  .fs-fx-info-on {
    transform: translate(-50%, 0);
  }
}

@import "./index.large.wxss"; /* 平板、电脑大屏样式：由 scripts/build-large-screen-styles.mjs 生成，改完本文件后重跑；这一行须留在文件末尾 */
