@import "../../styles/skeleton.wxss";

/* 版式整套取自 pages/diagnosis-room/index.wxss（学生的诊断室），类名与数值一致，
   复述验收和诊断室长一个样；诊断室改了这些规则，这里要跟着改（tests/agent-acceptance-page.test.js 盯着几条关键的）。
   acc- 开头的是验收页独有的：顶栏下的课程名、开始前的说明、骨架、对话结束后的结论卡片。 */
page { height: 100%; overflow: hidden; background: #F9FAFF; }

.agent-page { position: fixed; top: 0; right: 0; bottom: 0; left: 0; width: 100%; height: auto; overflow: hidden; background: #F9FAFF; color: #222A25; }
.agent-ambient { position: fixed; top: 0; right: 0; bottom: 0; left: 0; z-index: 0; overflow: hidden; pointer-events: none; background: radial-gradient(125% 48% at 0% 0%, rgba(204, 237, 255, .92) 0%, rgba(225, 241, 255, .62) 34%, rgba(249, 250, 255, 0) 73%), radial-gradient(112% 52% at 100% 0%, rgba(228, 219, 255, .9) 0%, rgba(239, 234, 255, .58) 38%, rgba(250, 249, 255, 0) 76%), linear-gradient(180deg, #F7FBFF 0%, #FBFAFF 54%, #FAFAFC 100%); }
.agent-topbar { position: fixed; top: 0; left: 0; z-index: 20; width: 100%; box-sizing: border-box; background: transparent; }
.agent-topbar-inner { position: relative; display: flex; align-items: center; box-sizing: content-box; padding: 0 36rpx 16rpx; }
.agent-back-button { display: flex; flex: 0 0 auto; align-items: center; justify-content: center; width: 44rpx; height: 44rpx; margin-right: 10rpx; }
.agent-back-button:active { opacity: .65; }
.agent-back-icon { width: 20rpx; height: 20rpx; border-bottom: 3rpx solid #24332D; border-left: 3rpx solid #24332D; transform: rotate(45deg) scale(.72); }
/* 顶栏标题与诊断室同一个字号；下面一行小字是这门课的名字 */
.acc-topbar-heading { position: absolute; left: 50%; display: flex; max-width: 56%; flex-direction: column; align-items: center; justify-content: center; transform: translateX(-50%); }
.acc-topbar-title { max-width: 100%; overflow: hidden; color: #24332D; font-size: 36rpx; font-weight: 700; letter-spacing: -1rpx; line-height: 1.2; text-overflow: ellipsis; white-space: nowrap; }
.acc-topbar-sub { max-width: 100%; margin-top: 2rpx; overflow: hidden; color: #9AA29B; font-size: 20rpx; line-height: 1.3; text-overflow: ellipsis; white-space: nowrap; }

/* 读不到时的说明与按钮：与诊断室「请从老师的邀请进入」同一套 */
.agent-entry-gate { display: flex; min-height: 100%; padding: 0 64rpx; box-sizing: border-box; flex-direction: column; align-items: center; justify-content: center; text-align: center; }
.agent-entry-gate-title { color: #1F2420; font-size: 36rpx; font-weight: 700; }
.agent-entry-gate-copy { margin-top: 18rpx; color: #6B736D; font-size: 28rpx; line-height: 1.6; }
.agent-entry-gate-button { display: flex; min-width: 280rpx; height: 88rpx; margin-top: 48rpx; padding: 0 48rpx; box-sizing: border-box; align-items: center; justify-content: center; border-radius: 44rpx; background: #FD7C02; color: #FFFFFF; font-size: 30rpx; font-weight: 650; }
.agent-entry-gate-button:active { opacity: .8; }
.agent-entry-gate-button.is-busy { opacity: .6; pointer-events: none; }
.acc-gate { position: relative; z-index: 1; }

/* 开始前：诊断室欢迎页的头像 + 标题，下面是验收怎么做 */
.acc-welcome { position: relative; z-index: 1; display: flex; height: 100%; padding-right: 48rpx; padding-left: 48rpx; box-sizing: border-box; flex-direction: column; align-items: center; overflow-y: auto; }
.agent-welcome-avatar { display: flex; align-items: center; justify-content: center; width: 250rpx; height: 250rpx; margin-bottom: 14rpx; }
.agent-welcome-avatar-shape { position: relative; width: 208rpx; height: 124rpx; border-radius: 999rpx; background: #0A0A0C; }
.agent-welcome-eye { position: absolute; top: 40rpx; width: 21rpx; height: 44rpx; border-radius: 999rpx; background: #FFF; transform-origin: center; animation: agent-avatar-blink 2.967s linear infinite; }
.agent-welcome-eye-left { left: 79rpx; }
.agent-welcome-eye-right { left: 132rpx; animation-delay: .12s; }
.acc-welcome::-webkit-scrollbar { display: none; width: 0; height: 0; color: transparent; }
.acc-welcome > .agent-welcome-avatar { margin-top: calc(26rpx + 30px); }
.acc-welcome > .agent-entry-gate-button { flex: none; margin-bottom: 80rpx; }
.agent-welcome-title { max-width: 650rpx; margin: 0 30rpx; color: #222A25; font-size: 34rpx; font-weight: 700; line-height: 1.4; text-align: center; }
.acc-welcome-copy { max-width: 600rpx; margin-top: 16rpx; color: #6B736D; font-size: 26rpx; line-height: 1.65; text-align: center; }
.acc-steps { width: 100%; max-width: 600rpx; margin-top: 36rpx; padding: 10rpx 28rpx; box-sizing: border-box; border: 1rpx solid #ECEFEC; border-radius: 26rpx; background: rgba(255, 255, 255, .86); }
.acc-step { display: flex; align-items: center; padding: 18rpx 0; color: #35443A; font-size: 25rpx; line-height: 1.5; }
.acc-step + .acc-step { border-top: 1rpx solid #F0F2F0; }
.acc-step-mark { display: flex; flex: none; align-items: center; justify-content: center; width: 36rpx; height: 36rpx; margin-right: 18rpx; border-radius: 50%; background: #FFF0DF; color: #B25A00; font-size: 22rpx; font-weight: 700; }

/* 对话记录 */
.diagnosis-room-scroll { position: absolute; top: 0; right: 0; bottom: 0; left: 0; z-index: 1; width: auto; height: auto; box-sizing: border-box; background: transparent; }
.diagnosis-room-shell { padding: 26rpx 30rpx 0; box-sizing: border-box; }
.agent-message { display: flex; align-items: flex-start; width: 100%; margin-bottom: 28rpx; }
.agent-message-user { justify-content: flex-end; }
.agent-message-column { min-width: 0; max-width: 88%; }
.agent-message-user .agent-message-column { display: flex; flex-direction: column; align-items: flex-end; max-width: 84%; }
.agent-message-bubble { padding: 18rpx 24rpx; box-sizing: border-box; border-radius: 26rpx 26rpx 26rpx 8rpx; background: #FFFFFF; color: #2F3B33; }
.agent-message-assistant .agent-message-bubble { min-height: 64rpx; background: #FFFFFF; }
.agent-message-user .agent-message-bubble { padding: 16rpx 24rpx; border-radius: 28rpx 28rpx 8rpx 28rpx; background: #DCEEFF; color: #222A25; }
.agent-message-text { display: block; font-size: 27rpx; line-height: 1.62; word-break: break-word; }
.diagnosis-room-bottom { height: 16rpx; }
.agent-message-assistant, .agent-message-user { animation: agent-card-enter .38s cubic-bezier(.2, .8, .2, 1) both; }
.agent-typing { display: flex; align-items: center; }
.agent-typing-label { margin-left: 16rpx; color: #9AA29B; font-size: 24rpx; }
.typing-dots { display: flex; align-items: center; height: 24rpx; }
.typing-dots view { width: 10rpx; height: 10rpx; margin: 0 4rpx; border-radius: 50%; background: #B9C2BA; animation: agent-dot-breathe 1s ease-in-out infinite; }
.typing-dots view:nth-child(2) { animation-delay: .14s; }
.typing-dots view:nth-child(3) { animation-delay: .28s; }
@keyframes agent-card-enter { from { opacity: 0; transform: translate3d(0, 18rpx, 0) scale(.985); } to { opacity: 1; transform: translate3d(0, 0, 0) scale(1); } }
@keyframes agent-dot-breathe { 0%, 100% { opacity: .35; transform: translateY(0); } 50% { opacity: 1; transform: translateY(-5rpx); } }
@keyframes agent-avatar-blink { 0%, 45%, 100% { transform: scaleY(1); } 48%, 52% { transform: scaleY(.16); } }

/* 对话结束后的结论：位置同诊断室「诊断已结束」，按结果上色 */
.acc-result { margin: 24rpx auto 8rpx; padding: 28rpx 30rpx; max-width: 600rpx; box-sizing: border-box; border-radius: 26rpx; background: #F2F4F2; text-align: center; animation: agent-card-enter .38s cubic-bezier(.2, .8, .2, 1) both; }
.acc-result.is-pending { background: #FFF1E3; }
.acc-result.is-passed { background: #E8F5EC; }
.acc-result-title { display: block; color: #35433B; font-size: 28rpx; font-weight: 700; }
.acc-result.is-pending .acc-result-title { color: #B25A00; }
.acc-result.is-passed .acc-result-title { color: #2F7A4F; }
.acc-result-copy { display: block; margin-top: 10rpx; color: #6F7972; font-size: 23rpx; line-height: 1.6; }
.acc-result-topics { margin-top: 20rpx; }
.acc-result-topics-title { display: block; color: #8A948D; font-size: 21rpx; }
.acc-topic-list { display: flex; flex-wrap: wrap; justify-content: center; margin-top: 6rpx; }
.acc-topic { margin: 8rpx 6rpx 0; padding: 8rpx 18rpx; border-radius: 999rpx; background: rgba(255, 255, 255, .86); color: #35443A; font-size: 23rpx; }
.acc-result-points { margin-top: 20rpx; text-align: left; }
.acc-result-point { display: block; margin-top: 10rpx; padding: 14rpx 20rpx; border-radius: 18rpx; background: rgba(255, 255, 255, .86); color: #35443A; font-size: 24rpx; line-height: 1.55; }
.acc-result-point.is-wrong { color: #B4532A; }
.acc-result-button { display: inline-flex; margin: 28rpx 0 0; }
.acc-result-link { display: block; width: fit-content; margin: 18rpx auto 0; padding: 6rpx 12rpx; color: #FD7C02; font-size: 24rpx; font-weight: 600; }
.acc-result-link:active { opacity: .7; }

/* 第一次读到验收状态前的气泡骨架（和诊断室回放骨架同一个形状） */
.acc-skeleton { position: relative; z-index: 1; display: flex; padding-right: 30rpx; padding-left: 30rpx; box-sizing: border-box; flex-direction: column; }
.acc-skeleton-bubble { width: 64%; height: 112rpx; margin-top: 28rpx; border-radius: 26rpx; }
.acc-skeleton-bubble.is-user { align-self: flex-end; width: 42%; height: 72rpx; }
.acc-skeleton-bubble.is-short { width: 50%; height: 88rpx; }

/* 输入框整套取自 pages/diagnosis-room/index.wxss，类名与数值一致，保证和诊断室长一个样 */
.agent-composer { position: fixed; right: 0; bottom: 52px; left: 0; z-index: 25; padding: 16rpx 28rpx 18rpx; box-sizing: border-box; background: #FFFFFF; transition: bottom .22s cubic-bezier(.2, .72, .2, 1); will-change: bottom; }
.agent-composer::after { position: absolute; right: 0; bottom: -4px; left: 0; height: 4px; background: #FFFFFF; content: ''; pointer-events: none; }
.agent-composer-bar { display: flex; align-items: center; min-height: 104rpx; padding: 6rpx 18rpx; box-sizing: border-box; border: 1rpx solid #ECEFEC; border-radius: 30rpx; background: #FFF; box-shadow: 0 8rpx 24rpx rgba(39, 52, 43, .06); }
.agent-composer-bar.is-input-active { border-color: #E4E8E4; box-shadow: 0 8rpx 24rpx rgba(39, 52, 43, .09); }
.agent-composer-bar.is-voice-active { border-color: rgba(253, 124, 2, .52); background: #FFF9F2; }
.agent-input { min-width: 0; flex: 1; height: 84rpx; margin: 0 14rpx; color: #2D3931; font-size: 29rpx; line-height: 84rpx; }
.agent-input-placeholder { color: #B5BCB6; }
/* 验收页的打字框是多行 textarea（诊断室还是单行）：一行时外框高度与单行一样（42 + 上下各 21 = 84rpx），
   写长了按行数（--lines，最多 5 行，见 index.js handleLineChange）往上长；左右按钮贴底，和最后一行对齐 */
.acc-answer-input { width: auto; height: calc(var(--lines, 1) * 42rpx); margin: 21rpx 14rpx; padding: 0; line-height: 42rpx; word-break: break-all; }
.agent-composer-bar.is-multiline { align-items: flex-end; }
.agent-composer-bar.is-multiline .agent-voice-button, .agent-composer-bar.is-multiline .agent-send-button { margin-bottom: 11rpx; }
.agent-voice-button, .agent-send-button { display: flex; flex: 0 0 auto; align-items: center; justify-content: center; width: 62rpx; height: 62rpx; border-radius: 50%; }
.agent-voice-button { background: transparent; }
.agent-voice-button.is-collapsing { width: 0; margin-left: 0; margin-right: 0; opacity: 0; transform: translateX(-24rpx); pointer-events: none; }
.agent-voice-button { overflow: hidden; transition: width .18s ease, margin-left .18s ease, opacity .18s ease, transform .18s ease; }
.agent-voice-icon { display: block; width: 50rpx; height: 50rpx; }
.agent-voice-speak-button { display: flex; flex: 1; align-items: center; justify-content: center; height: 84rpx; margin: 0 14rpx; color: #35443A; font-size: 29rpx; font-weight: 600; line-height: 1; }
.agent-voice-speak-button:active { opacity: .7; }
/* 等它问下一个问题时「按住说话」暂时灰着（按下去会提示稍等） */
.agent-voice-speak-button.is-waiting { color: #B5BCB6; }
.agent-send-button { background: #EEF1EE; }
.agent-send-button.is-enabled, .agent-send-button.is-sending { background: #FD7C02; }
.agent-send-icon { display: block; width: 32rpx; height: 32rpx; }
.agent-composer-note-background { position: fixed; right: 0; bottom: 0; left: 0; z-index: 24; min-height: 48px; padding-bottom: env(safe-area-inset-bottom); box-sizing: border-box; background: #FFFFFF; pointer-events: none; }
.agent-composer-note { position: fixed; right: 0; bottom: 0; left: 0; z-index: 26; display: flex; align-items: flex-start; justify-content: center; min-height: 48px; padding: 9px 28rpx calc(6px + env(safe-area-inset-bottom)); box-sizing: border-box; color: #A7B0A9; font-size: 18rpx; line-height: 18px; text-align: center; white-space: nowrap; background: transparent; pointer-events: none; transform: translateY(5px); }

/* 按住说话时的全屏提示与电平条 */
.voice-demo-status { position: fixed; top: 0; right: 0; bottom: 0; left: 0; z-index: 27; display: flex; flex-direction: column; align-items: center; justify-content: flex-end; box-sizing: border-box; padding: 0 34rpx calc(112rpx + env(safe-area-inset-bottom)); background: linear-gradient(180deg, rgba(255, 255, 255, 0) 34%, rgba(218, 242, 255, .05) 48%, rgba(96, 185, 251, .52) 68%, rgba(54, 158, 247, .9) 84%, rgba(22, 136, 241, .98) 100%); color: #FFF; pointer-events: none; }
.voice-demo-status.is-canceling { background: linear-gradient(180deg, rgba(255, 255, 255, 0) 34%, rgba(255, 245, 245, .08) 48%, rgba(255, 226, 226, .58) 68%, rgba(255, 216, 216, .9) 84%, rgba(255, 214, 214, .98) 100%); color: #FF3030; }
.voice-demo-label { color: rgba(255, 255, 255, .86); font-size: 28rpx; font-weight: 500; line-height: 1.4; text-shadow: 0 2rpx 8rpx rgba(20, 102, 190, .16); }
.voice-demo-status.is-canceling .voice-demo-label { color: #FF3030; text-shadow: none; }
.voice-demo-wave { display: flex; align-items: center; justify-content: center; width: 82%; height: 76rpx; margin-top: 58rpx; }
/* 高度是行内传入的 rpx 设计值（--bar-height，默认 4），在这里换算，大屏下才会跟着固定比例（见 utils/screen.js） */
.voice-demo-bar { flex: 1 1 0; min-width: 3rpx; max-width: 8rpx; height: calc(var(--bar-height, 4) * 1000rpx / 1000); margin: 0 2rpx; border-radius: 999rpx; background: rgba(255, 255, 255, .92); box-shadow: 0 0 8rpx rgba(255, 255, 255, .14); transition: height 70ms linear, opacity 70ms linear; }
.voice-demo-status.is-canceling .voice-demo-bar { background: #FF4242; box-shadow: 0 0 8rpx rgba(255, 65, 65, .12); }
.voice-demo-status.is-canceling .voice-demo-bar:nth-child(3n) { background: #FF9A9A; }

/* 平板（2026-11-08 用户反馈「复述验收跟平板屏幕适配」）：默认大屏模式把页面收进 450px 居中栏，背景、对话、输入框都挤在中间一条。
   这一页让背景、顶栏、底部输入区铺满整个窗口，对话和输入框限宽 760px 居中，一行字不会拉得太长。
   选择器带上 .agent-page：文件末尾生成的大屏样式会重写同名规则，要比它更具体才盖得住。 */
@media (min-width: 450px) {
  page { --lg-col: 100vw; }
  .agent-page .diagnosis-room-shell,
  .agent-page .acc-skeleton,
  .agent-page .agent-composer-bar { width: 100%; max-width: 760px; margin-right: auto; margin-left: auto; }
}

@import "./index.large.wxss"; /* 平板、电脑大屏样式：由 scripts/build-large-screen-styles.mjs 生成，改完本文件后重跑；这一行须留在文件末尾 */
