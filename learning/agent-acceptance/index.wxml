<wxs module="UA" src="../../utils/ui-asset.wxs" />
<!-- 第三关「当小老师」（2026-11-17，docs/当小老师记录.md）：上面是教室（两三个同学坐成一排，头上气泡、身前课桌、名牌和星星），
     中间是黑板（这节课要讲的几件事），底下「按住 讲给同学听」。平板横排：教室在左、黑板在右（index.wxss 末尾）。
     人物、课桌、教室都是后端素材（ui_asset 的 peer-class/*），同学的表情由 utils/peer-class-view.js 按规则换。 -->
<view class="pc-page" style="padding-top: {{contentTop}}px;">
  <view class="pc-topbar">
    <view class="pc-topbar-inner" style="height: {{navigationBarHeight}}px; padding-top: {{statusBarHeight}}px;">
      <view class="pc-back-button" bindtap="handleBack" aria-role="button" aria-label="返回">
        <view class="pc-back-icon" aria-hidden="true"></view>
      </view>
      <view class="pc-topbar-heading" style="top: {{statusBarHeight}}px; height: {{navigationBarHeight}}px;">
        <text class="pc-topbar-title">当小老师</text>
        <text wx:if="{{course.title}}" class="pc-topbar-sub">{{course.title}}</text>
      </view>
    </view>
  </view>

  <view wx:if="{{!loaded && !loadFailed}}" class="pc-skeleton" aria-hidden="true">
    <view class="sk pc-skeleton-stage"></view>
    <view class="pc-skeleton-side">
      <view class="sk pc-skeleton-board"></view>
      <view class="sk sk-line sk-mid pc-skeleton-hint"></view>
    </view>
  </view>

  <view wx:elif="{{loadFailed}}" class="pc-gate">
    <text class="pc-gate-title">课堂暂时没有打开</text>
    <text class="pc-gate-copy">{{errorMessage}}</text>
    <view class="pc-primary" bindtap="retry" aria-role="button" aria-label="重新读取">重新读取</view>
  </view>

  <block wx:else>
    <view class="pc-body">
      <!-- 教室 -->
      <view class="pc-stage">
        <image class="pc-stage-bg" src="{{UA.src(ui, '/assets/peer-class/classroom.jpg')}}" mode="aspectFill" aria-hidden="true"></image>
        <view class="pc-stage-tools">
          <view wx:if="{{state === 'class' || playing}}" class="pc-tool {{autoRead ? 'is-on' : ''}}" bindtap="toggleAutoRead" aria-role="switch" aria-checked="{{autoRead}}" aria-label="自动朗读同学们的话">
            <view class="pc-speaker-icon" aria-hidden="true"><view class="pc-speaker-wave"></view></view>
            <text>{{autoRead ? '朗读开' : '朗读关'}}</text>
          </view>
          <view wx:if="{{records.length}}" class="pc-tool" bindtap="openRecords" aria-role="button" aria-label="看课堂记录">
            <text>课堂记录</text>
          </view>
        </view>
        <view class="pc-row is-{{peers.length}} {{voiceRecognizing ? 'is-listening' : ''}} {{result.kind === 'pending' || result.kind === 'passed' ? 'is-cheer' : ''}}">
          <view wx:for="{{peers}}" wx:key="id" class="pc-peer is-{{item.mood}} {{item.speaking ? 'is-speaking' : ''}} {{item.asking ? 'is-asking' : ''}} {{item.thinking ? 'is-thinking' : ''}}">
            <view class="pc-bubble-slot">
              <view wx:if="{{item.thinking}}" class="pc-bubble is-thinking" aria-label="{{item.name}}在记笔记">
                <view class="pc-dot"></view><view class="pc-dot"></view><view class="pc-dot"></view>
              </view>
              <view wx:elif="{{item.bubble}}" class="pc-bubble {{item.bubbleOld ? 'is-old' : ''}}" bindtap="openRecords" aria-label="{{item.name}}：{{item.bubble}}">
                <text class="pc-bubble-text">{{item.bubble}}</text>
                <view wx:if="{{item.speaking}}" class="pc-speaker-icon pc-bubble-speaker" aria-hidden="true"><view class="pc-speaker-wave"></view></view>
              </view>
            </view>
            <view class="pc-figure {{item.sprite ? 'is-anim' : ''}}">
              <view class="pc-halo" aria-hidden="true"></view>
              <image class="pc-person" src="{{UA.src(ui, item.art)}}" mode="aspectFit" aria-label="{{item.name}}"></image>
              <!-- 帧动画：换动作时重新建这一块，动画从第一帧播起 -->
              <view wx:if="{{item.sprite}}" wx:for="{{[item.action]}}" wx:for-item="act" wx:key="*this" class="pc-sprite {{item.once ? 'is-once' : ''}}" style="background-image: url({{UA.src(ui, item.sprite)}});" aria-hidden="true"></view>
              <view wx:if="{{item.sparkle}}" class="pc-sparks" aria-hidden="true">
                <text class="pc-spark">✦</text><text class="pc-spark is-b">✦</text><text class="pc-spark is-c">✦</text>
              </view>
              <view class="pc-desk">
                <image class="pc-desk-art" src="{{UA.src(ui, '/assets/peer-class/desk.png')}}" mode="scaleToFill" aria-hidden="true"></image>
                <view class="pc-nameplate">
                  <text class="pc-name">{{item.name}}</text>
                  <view wx:if="{{item.starIcons.length}}" class="pc-stars">
                    <image wx:for="{{item.starIcons}}" wx:for-item="lit" wx:key="index" class="pc-star" src="{{UA.src(ui, lit ? '/assets/quest/rating-star.svg' : '/assets/quest/rating-star-empty.svg')}}" mode="aspectFit"></image>
                    <text wx:if="{{item.starText}}" class="pc-star-text">{{item.starText}}</text>
                  </view>
                </view>
              </view>
            </view>
          </view>
        </view>
      </view>

      <!-- 黑板、结论、提示 -->
      <view class="pc-side">
        <scroll-view class="pc-side-scroll" scroll-y enhanced show-scrollbar="{{false}}">
          <view class="pc-side-inner">
            <view wx:if="{{state === 'learning'}}" class="pc-card">
              <text class="pc-card-title">学完这节课再来当小老师</text>
              <text class="pc-card-copy">已学完 {{acceptance.learning.completed || 0}} / {{acceptance.learning.total || 0}} 部分。全部学完后，把学到的讲给同学们听。</text>
              <view class="pc-primary" bindtap="continueLearning" aria-role="button" aria-label="继续学习">继续学习</view>
            </view>

            <view wx:elif="{{state === 'intro'}}" class="pc-card">
              <text class="pc-card-title">今天你来当小老师</text>
              <text class="pc-card-copy">同学们没学过这节课，等着听你讲。黑板上写着要讲的几件事，按住说话，用自己的话讲给他们听。</text>
              <view class="pc-steps">
                <view class="pc-step"><text class="pc-step-mark">1</text><text>合上课程，凭记忆从黑板第一件事讲起</text></view>
                <view class="pc-step"><text class="pc-step-mark">2</text><text>讲完一段松手，同学们会说学到了什么，还会举手提问</text></view>
                <view class="pc-step"><text class="pc-step-mark">3</text><text>讲清黑板上一半的事就过关，老师看过后知识点进入学习宇宙</text></view>
              </view>
              <view class="pc-primary {{sending ? 'is-busy' : ''}}" bindtap="start" aria-role="button" aria-label="开始上课">{{sending ? '同学们正在坐好…' : '开始上课'}}</view>
            </view>

            <view wx:if="{{result}}" class="pc-result is-{{result.kind}}" aria-live="polite">
              <text class="pc-result-title">{{result.title}}</text>
              <text wx:if="{{result.copy}}" class="pc-result-copy">{{result.copy}}</text>
              <view wx:if="{{result.unclear.length}}" class="pc-result-list">
                <text wx:for="{{result.unclear}}" wx:key="*this" class="pc-result-item">{{item}}</text>
              </view>
              <view wx:if="{{result.misconceptions.length}}" class="pc-result-list">
                <text class="pc-result-sub">{{result.misconceptions.length > 1 ? '有几个地方同学们记混了' : '有个地方同学们记混了'}}</text>
                <text wx:for="{{result.misconceptions}}" wx:key="*this" class="pc-result-item is-mixed">{{item}}</text>
              </view>
              <view wx:if="{{result.peerStars.length}}" class="pc-result-peers">
                <view wx:for="{{result.peerStars}}" wx:key="id" class="pc-result-peer">
                  <text>{{item.name}}</text>
                  <image class="pc-star" src="{{UA.src(ui, '/assets/quest/rating-star.svg')}}" mode="aspectFit" aria-hidden="true"></image>
                  <text>{{item.stars}}</text>
                </view>
              </view>
              <view wx:if="{{result.topics.length}}" class="pc-result-topics">
                <text class="pc-result-sub">{{result.topicsTitle}}</text>
                <view class="pc-topic-list"><text wx:for="{{result.topics}}" wx:key="name" class="pc-topic">{{item.name}}</text></view>
              </view>
              <view wx:if="{{state === 'passed'}}" class="pc-link" bindtap="openUniverse" aria-role="link" aria-label="去宇宙看看">去宇宙看看</view>
              <view wx:elif="{{state === 'pending'}}" class="pc-link" bindtap="continueLearning" aria-role="link" aria-label="回课程看看">回课程看看</view>
              <block wx:elif="{{state === 'retry'}}">
                <view class="pc-primary {{sending ? 'is-busy' : ''}}" bindtap="restart" aria-role="button" aria-label="再给同学讲一次">{{sending ? '同学们正在坐好…' : '再给同学讲一次'}}</view>
                <view class="pc-link" bindtap="continueLearning" aria-role="link" aria-label="回课程看看">回课程看看</view>
              </block>
            </view>

            <view wx:if="{{board}}" class="pc-board">
              <view class="pc-board-head">
                <text class="pc-board-title">黑板 · 这节课要讲的</text>
                <text class="pc-board-count">已讲 {{board.done}}/{{board.total}}</text>
              </view>
              <view wx:for="{{board.items}}" wx:key="id" class="pc-board-item is-{{item.state}}">
                <view class="pc-mark" aria-hidden="true"><view class="pc-mark-inner"></view></view>
                <text class="pc-board-topic">{{item.topic}}</text>
                <text wx:if="{{item.state === 'half'}}" class="pc-board-tag">讲了一半</text>
              </view>
              <text wx:if="{{state === 'class'}}" class="pc-board-rounds">还能讲 {{board.roundsLeft}} 段</text>
            </view>
          </view>
        </scroll-view>
        <!-- 悄悄提示（2026-11-17）：轮到小老师讲、半天没开口时弹出——先给怎么开头，再给大概的提示 -->
        <view wx:if="{{hintCard && state === 'class'}}" class="pc-help" aria-live="polite">
          <view class="pc-help-head">
            <view class="pc-help-badge" aria-hidden="true">?</view>
            <text class="pc-help-title">悄悄提示</text>
            <view class="pc-help-action" bindtap="readHint" aria-role="button" aria-label="把提示读给我听">
              <view class="pc-speaker-icon" aria-hidden="true"><view class="pc-speaker-wave"></view></view>
              <text>读给我听</text>
            </view>
            <view class="pc-help-action" bindtap="closeHint" aria-role="button" aria-label="收起提示">收起</view>
          </view>
          <text class="pc-help-reassure">{{hintCard.reassure}}</text>
          <text class="pc-help-label">讲「{{hintCard.topic}}」，可以这样开头</text>
          <view class="pc-help-starters">
            <text wx:for="{{hintCard.starters}}" wx:key="*this" class="pc-help-starter">{{item}}</text>
          </view>
          <view wx:if="{{hintCard.cue}}" class="pc-help-cue">
            <text class="pc-help-label">大概可以这样说</text>
            <text class="pc-help-cue-text">{{hintCard.cue}}</text>
          </view>
          <view wx:elif="{{hintCard.canMore}}" class="pc-help-more" bindtap="moreHint" aria-role="button" aria-label="再给点提示">还是想不起来？再给点提示</view>
        </view>
        <view wx:elif="{{hint}}" class="pc-hint-row" aria-live="polite">
          <view class="pc-hint-line">
            <view class="pc-hint"><view class="pc-hint-dot" aria-hidden="true"></view><text>{{hint}}</text></view>
            <view wx:if="{{hintReady}}" class="pc-hint-help" bindtap="openHint" aria-role="button" aria-label="不知道怎么讲，看看提示">怎么讲？</view>
          </view>
          <text wx:if="{{sending && lastSaid}}" class="pc-said">你刚讲：{{lastSaid}}</text>
        </view>
      </view>
    </view>

    <!-- 底部：默认「按住 讲给同学听」，左边切键盘打字，右边「下课」（讲过一段才能点） -->
    <view wx:if="{{state === 'class'}}" class="pc-footer" style="padding-bottom: {{keyboardHeight > 0 ? keyboardHeight + 8 : footerBottom}}px;">
      <view class="pc-footer-inner">
        <view wx:if="{{voiceMode}}" class="pc-round-button" catchtap="handleKeyboardButtonTap" aria-role="button" aria-label="切换到键盘输入">
          <image class="pc-round-icon" src="{{UA.src(ui, '../../assets/keyboard-icon.svg')}}" mode="aspectFit" aria-hidden="true"></image>
        </view>
        <view wx:else class="pc-round-button" catchtap="handleVoiceButtonTap" aria-role="button" aria-label="切换到按住说话">
          <image class="pc-round-icon" src="{{UA.src(ui, '../../assets/agent-voice.svg')}}" mode="aspectFit" aria-hidden="true"></image>
        </view>
        <view
          wx:if="{{voiceMode}}"
          class="pc-speak {{sending ? 'is-waiting' : ''}} {{voiceRecognizing ? 'is-active' : ''}}"
          catchtouchstart="handleSpeakTouchStart"
          catchtouchmove="handleSpeakTouchMove"
          catchtouchend="handleSpeakTouchEnd"
          catchtouchcancel="handleSpeakTouchEnd"
          aria-role="button"
          aria-label="按住 讲给同学听"
        >
          <image class="pc-speak-icon" src="{{UA.src(ui, '/assets/quest/mic.svg')}}" mode="aspectFit" aria-hidden="true"></image>
          <text>按住 讲给同学听</text>
        </view>
        <view wx:else class="pc-type-box {{inputLines > 1 ? 'is-multiline' : ''}}">
          <!-- 回车换行、不发送（2026-11-15 用户反馈：手机、平板键盘没有 Shift），发送点右边的发送按钮 -->
          <textarea
            class="pc-type-input"
            style="--lines: {{inputLines}};"
            value="{{draft}}"
            placeholder="用自己的话讲给同学们听…"
            placeholder-class="pc-type-placeholder"
            maxlength="1000"
            fixed="{{true}}"
            auto-height="{{false}}"
            disable-default-padding="{{true}}"
            adjust-position="{{false}}"
            cursor-spacing="24"
            show-confirm-bar="{{false}}"
            bindinput="handleInput"
            bindlinechange="handleLineChange"
            bindkeyboardheightchange="handleKeyboardHeightChange"
            bindblur="handleInputBlur"
            disabled="{{sending}}"
          />
          <view class="pc-send {{draft && !sending ? 'is-enabled' : ''}}" catchtap="handleSend" aria-role="button" aria-label="讲给同学听">
            <image class="pc-send-icon" src="{{UA.src(ui, '../../assets/agent-send.svg')}}" mode="aspectFit" aria-hidden="true"></image>
          </view>
        </view>
        <view class="pc-finish {{peerClass.rounds && !sending ? '' : 'is-disabled'}}" bindtap="handleFinishTap" aria-role="button" aria-label="下课">下课</view>
      </view>
    </view>
  </block>
</view>

<!-- 预先取同学们的帧动画图：取好了才播（1px、看不见） -->
<view class="pc-preload" aria-hidden="true">
  <image wx:for="{{spriteList}}" wx:key="*this" class="pc-preload-image" src="{{UA.src(ui, item)}}" webp="{{true}}" data-key="{{item}}" bindload="handleSpriteLoad"></image>
</view>

<!-- 按住说话时：底部一块橙色提示 + 电平条，上移取消 -->
<view wx:if="{{voiceRecognizing}}" class="pc-voice {{voiceCancel ? 'is-canceling' : ''}}" aria-live="polite">
  <text class="pc-voice-label">{{voiceCancel ? '松手取消' : (voiceRemaining ? '还能说 ' + voiceRemaining + ' 秒，松手讲给同学们' : '同学们在听，松手发送，上移取消')}}</text>
  <view class="pc-voice-wave {{voiceSoundActive ? 'is-speaking' : 'is-silent'}}">
    <view wx:for="{{voiceBars}}" wx:key="id" class="pc-voice-bar" style="--bar-height: {{item.height}}; opacity: {{item.opacity}};"></view>
  </view>
  <text class="pc-voice-note">松手后录音将上传用于转成文字，识别后不保留录音</text>
</view>

<!-- 课堂记录：孩子讲的和同学们说的，不全堆在教室里，点「课堂记录」或气泡打开 -->
<view wx:if="{{recordOpen}}" class="pc-sheet-mask" bindtap="closeRecords">
  <view class="pc-sheet" catchtap="noop">
    <view class="pc-sheet-head">
      <text class="pc-sheet-title">课堂记录</text>
      <view class="pc-sheet-close" bindtap="closeRecords" aria-role="button" aria-label="关闭课堂记录">关闭</view>
    </view>
    <scroll-view class="pc-sheet-list" scroll-y enhanced show-scrollbar="{{false}}">
      <view wx:for="{{records}}" wx:key="id" class="pc-record {{item.learner ? 'is-learner' : ''}}">
        <text class="pc-record-name">{{item.name}}</text>
        <text class="pc-record-text" user-select="true">{{item.text}}</text>
      </view>
    </scroll-view>
  </view>
</view>
<checkin-celebration notice="{{checkinNotice}}" close-label="看看同学们" bind:close="closeCheckinNotice" />
<dev-reset-fab />
