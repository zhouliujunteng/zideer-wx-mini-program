/* 自动生成，请勿手改：index.wxss 在平板、电脑大屏（窗口宽 ≥ 450px）下的样式。
   rpx 按 1rpx = 0.6px 换算，固定定位元素收进居中栏；改完源文件后运行 node scripts/build-large-screen-styles.mjs */
@media (min-width: 450px) {
.sk{border-radius:7px}
.sk-line{height:16px}
.sk-line + .sk-line{margin-top:8px}
.sk-short{width:40%}
.sk-mid{width:64%}
.sk-round{border-radius:50%}
.sk-card{height:96px;border-radius:14px}
.sk-card + .sk-card{margin-top:12px}
page{height:100%}
.pc-page{top:0;right:max(0px, 50% - var(--lg-col) / 2);bottom:0;left:max(0px, 50% - var(--lg-col) / 2);flex-direction:column;box-sizing:border-box;box-shadow:0 0 0 100vmax #FBF5EC}
.pc-topbar{top:0;left:max(0px, 50% - var(--lg-col) / 2);width:min(100%, var(--lg-col));box-sizing:border-box}
.pc-topbar-inner{box-sizing:content-box;padding:0 21px 9px}
.pc-back-button{flex:0 0 auto;width:26px;height:26px;margin-right:6px}
.pc-back-icon{width:12px;height:12px;border-bottom:1px solid #3A2E25;border-left:1px solid #3A2E25;transform:rotate(45deg) scale(.72)}
.pc-topbar-heading{left:50%;max-width:56%;flex-direction:column;transform:translateX(-50%)}
.pc-topbar-title{max-width:100%;font-size:21px;font-weight:700;line-height:1.2}
.pc-topbar-sub{max-width:100%;margin-top:1px;font-size:12px;line-height:1.3}
.pc-skeleton{flex:1;flex-direction:column;min-height:0}
.pc-skeleton-stage{flex:none;height:324px;border-radius:0}
.pc-skeleton-side{padding:14px 16px}
.pc-skeleton-board{height:216px;border-radius:16px}
.pc-skeleton-hint{margin:16px auto 0}
.pc-gate{flex:1;flex-direction:column;padding:0 38px}
.pc-gate-title{font-size:20px;font-weight:700}
.pc-gate-copy{margin-top:10px;font-size:16px;line-height:1.6}
.pc-body{flex:1;flex-direction:column;min-height:0}
.pc-stage{flex:0 1 324px;min-height:0}
.pc-stage-bg{top:0;right:0;bottom:0;left:0;width:100%;height:100%}
.pc-stage-tools{top:9px;right:12px}
.pc-tool{height:31px;margin-left:7px;padding:0 12px;border:1px solid #EBDCC8;border-radius:15px;font-size:13px}
.pc-tool.is-on{border-color:#F6C493}
.pc-tool .pc-speaker-icon{margin-right:4px}
.pc-row{right:0;bottom:0;left:0;padding:0 4px}
.pc-peer{flex:0 0 33.33%;flex-direction:column;min-width:0}
.pc-row.is-2 .pc-peer{flex-basis:40%}
.pc-bubble-slot{width:100%;height:103px}
.pc-bubble{right:4px;bottom:8px;left:4px;padding:7px 9px;box-sizing:border-box;border:1px solid #F1D2B0;border-radius:13px}
.pc-bubble::after{bottom:-8px;left:50%;width:10px;height:10px;margin-left:-6px;border-right:1px solid #F1D2B0;border-bottom:1px solid #F1D2B0;transform:rotate(45deg)}
.pc-bubble-text{font-size:13px;line-height:1.45;-webkit-box-orient:vertical;-webkit-line-clamp:4}
.pc-peer.is-speaking .pc-bubble{border-color:#FD7C02;padding-right:26px}
.pc-peer.is-speaking .pc-bubble::after{border-color:#FD7C02}
.pc-bubble .pc-bubble-speaker{right:7px;bottom:7px}
.pc-speaker-icon{flex:none;width:14px;height:13px}
.pc-speaker-icon::before{top:3px;left:0;width:4px;height:6px;border-radius:1px}
.pc-speaker-icon::after{top:0.5px;left:2px;border-top:6px solid transparent;border-right:6px solid #FD7C02;border-bottom:6px solid transparent}
.pc-speaker-wave{top:1px;left:9px;width:5px;height:9px;box-sizing:border-box;border:1px solid #FD7C02;border-left:0;border-radius:0 9px 9px 0}
.pc-tool:not(.is-on) .pc-speaker-icon::after{border-right-color:#B9A994}
.pc-tool:not(.is-on) .pc-speaker-wave{border-color:#B9A994}
.pc-figure{width:141px;height:159px}
.pc-person{top:0;left:4px;width:132px;height:132px}
.pc-halo{top:2px;left:10px;width:120px;height:120px;box-sizing:border-box;border:3px solid #FDB56A;border-radius:50%;transform:scale(.85)}
.pc-peer.is-speaking .pc-halo{transform:scale(1)}
.pc-peer.is-speaking .pc-person{transform:translateY(-3px)}
.pc-desk{bottom:0;left:0;width:141px;height:54px}
.pc-desk-art{width:141px;height:54px}
.pc-nameplate{top:20px;left:50%;height:26px;padding:0 8px;box-sizing:border-box;border-radius:7px;transform:translateX(-50%);box-shadow:0 1px 3px rgba(120, 80, 30, .18)}
.pc-name{font-size:13px;font-weight:700}
.pc-stars{margin-left:4px}
.pc-star{width:13px;height:13px}
.pc-star-text{margin-left:2px;font-size:12px;font-weight:600}
.pc-side{flex:1 1 0;flex-direction:column;min-height:0}
.pc-side-scroll{flex:1;height:0;min-height:0}
.pc-side-inner{padding:14px 16px 12px;box-sizing:border-box}
.pc-board{padding:14px 16px 13px;box-sizing:border-box;border:8px solid #D29A5C;border-radius:16px;box-shadow:0 3px 10px rgba(120, 80, 30, .16)}
.pc-board-head{padding-bottom:7px;border-bottom:1px dashed rgba(244, 241, 230, .35)}
.pc-board-title{font-size:18px;font-weight:700;letter-spacing:1px}
.pc-board-count{flex:none;margin-left:9px;font-size:15px;font-weight:600}
.pc-board-item{padding:8px 0}
.pc-board-topic{flex:1;min-width:0;font-size:18px;line-height:1.4}
.pc-board-tag{flex:none;margin-left:7px;padding:1px 7px;border:1px dashed rgba(244, 241, 230, .6);border-radius:599px;font-size:12px}
.pc-board-rounds{margin-top:4px;font-size:12px}
.pc-mark{flex:none;width:24px;height:24px;margin-right:12px;box-sizing:border-box;border:2px solid rgba(244, 241, 230, .5);border-radius:50%}
.pc-board-item.is-half .pc-mark{border-style:dashed;border-color:#F4F1E6}
.pc-board-item.is-half .pc-mark-inner{top:0;bottom:0;left:0;width:50%}
.pc-board-item.is-done .pc-mark{border-color:#F4F1E6}
.pc-board-item.is-done .pc-mark-inner{top:3px;left:6px;width:5px;height:10px;border-right:2px solid #F4F1E6;border-bottom:2px solid #F4F1E6;transform:rotate(45deg)}
.pc-card{margin-bottom:14px;padding:19px 18px;box-sizing:border-box;border:1px solid #F0E2CF;border-radius:16px}
.pc-card-title{font-size:19px;font-weight:700}
.pc-card-copy{margin-top:7px;font-size:15px;line-height:1.65}
.pc-steps{margin-top:12px}
.pc-step{padding:8px 0;font-size:15px;line-height:1.5}
.pc-step + .pc-step{border-top:1px solid #F5ECE0}
.pc-step-mark{flex:none;width:21px;height:21px;margin-right:10px;border-radius:50%;font-size:13px;font-weight:700}
.pc-primary{min-width:180px;height:52px;margin:16px auto 0;padding:0 28px;box-sizing:border-box;width:fit-content;border-radius:26px;font-size:18px;font-weight:650}
.pc-link{width:fit-content;margin:10px auto 0;padding:3px 7px;font-size:15px;font-weight:600}
.pc-result{margin-bottom:14px;padding:18px;box-sizing:border-box;border:1px solid #F0E2CF;border-radius:16px}
.pc-result.is-pending{border-color:#FFD9B0}
.pc-result.is-passed{border-color:#CDE8D5}
.pc-result-title{font-size:19px;font-weight:700}
.pc-result-copy{margin-top:6px;font-size:14px;line-height:1.6}
.pc-result-list{margin-top:9px}
.pc-result-sub{margin-top:4px;font-size:13px}
.pc-result-item{margin-top:6px;padding:8px 12px;border-radius:10px;font-size:15px;line-height:1.55}
.pc-result-peers{flex-wrap:wrap;margin-top:10px}
.pc-result-peer{margin:3px 7px;padding:4px 10px;border-radius:599px;font-size:13px}
.pc-result-peer .pc-star{margin:0 2px 0 4px}
.pc-result-topics{margin-top:9px}
.pc-topic-list{flex-wrap:wrap;margin-top:3px}
.pc-topic{margin:4px 3px 0;padding:4px 10px;border-radius:599px;font-size:13px}
.pc-hint-row{flex:none;flex-direction:column;padding:2px 16px 10px}
.pc-hint{max-width:100%;padding:7px 16px;box-sizing:border-box;border-radius:599px;font-size:15px;font-weight:600}
.pc-hint-dot{flex:none;width:8px;height:8px;margin-right:7px;border-radius:50%}
.pc-hint-line{max-width:100%}
.pc-hint-help{flex:none;margin-left:7px;padding:7px 13px;border:1px solid #F2C28E;border-radius:599px;font-size:14px;font-weight:600}
.pc-help{flex:none;margin:2px 16px 10px;padding:12px 14px 13px;box-sizing:border-box;border:1px solid #F5D3A8;border-radius:14px;box-shadow:0 3px 10px rgba(196, 106, 18, .12)}
@keyframes pc-help-in{from{opacity:0;transform:translateY(9px)}to{opacity:1;transform:none}}
.pc-help-badge{flex:none;width:21px;height:21px;margin-right:6px;border-radius:50%;font-size:14px;font-weight:700}
.pc-help-title{flex:1;min-width:0;font-size:16px;font-weight:700}
.pc-help-action{flex:none;height:28px;margin-left:6px;padding:0 9px;border-radius:14px;font-size:13px}
.pc-help-action .pc-speaker-icon{margin-right:3px}
.pc-help-reassure{margin-top:6px;font-size:14px;line-height:1.5}
.pc-help-label{margin-top:8px;font-size:13px;font-weight:600}
.pc-help-starters{flex-wrap:wrap;margin-top:2px}
.pc-help-starter{margin:4px 7px 0 0;padding:6px 10px;border-radius:9px;font-size:15px;line-height:1.4}
.pc-help-cue{margin-top:2px}
.pc-help-cue-text{margin-top:3px;font-size:16px;font-weight:600;line-height:1.5}
.pc-help-more{margin-top:8px;font-size:14px;font-weight:600}
.pc-said{max-width:100%;margin-top:6px;font-size:13px}
.pc-footer{flex:none;padding:12px 16px 0;box-sizing:border-box;border-radius:19px 19px 0 0;box-shadow:0 -4px 14px rgba(120, 80, 30, .07)}
.pc-round-button{flex:none;width:55px;height:55px;box-sizing:border-box;border:1px solid #EADFD2;border-radius:50%}
.pc-round-icon{width:27px;height:27px}
.pc-speak{flex:1;min-width:0;height:60px;margin:0 12px;border-radius:30px;font-size:19px;font-weight:700;letter-spacing:1px}
.pc-speak-icon{flex:none;width:26px;height:26px;margin-right:8px}
.pc-type-box{flex:1;min-width:0;min-height:55px;margin:0 9px;padding:0 6px 0 13px;box-sizing:border-box;border:1px solid #EADFD2;border-radius:18px}
.pc-type-input{flex:1;width:auto;min-width:0;height:calc(var(--lines, 1) * 25px);margin:15px 6px 15px 0;padding:0;font-size:17px;line-height:25px}
.pc-send{flex:none;width:38px;height:38px;border-radius:50%}
.pc-type-box.is-multiline .pc-send{margin-bottom:8px}
.pc-send-icon{width:19px;height:19px}
.pc-finish{flex:none;height:50px;padding:0 18px;box-sizing:border-box;border:1px solid #FD7C02;border-radius:25px;font-size:18px;font-weight:700}
.pc-finish.is-disabled{border-color:#E6DCCF}
.pc-voice{right:max(0px, 50% - var(--lg-col) / 2);bottom:0;left:max(0px, 50% - var(--lg-col) / 2);flex-direction:column;padding:24px 20px calc(90px + env(safe-area-inset-bottom));box-sizing:border-box;border-radius:24px 24px 0 0}
.pc-voice-label{font-size:17px;font-weight:600;line-height:1.4}
.pc-voice-wave{width:82%;height:45px;margin-top:16px}
.pc-voice-bar{flex:1 1 0;min-width:1px;max-width:4px;height:calc(var(--bar-height, 4) * 600px / 1000);margin:0 1px;border-radius:599px}
.pc-voice-note{margin-top:14px;font-size:12px}
.pc-sheet-mask{top:0;right:max(0px, 50% - var(--lg-col) / 2);bottom:0;left:max(0px, 50% - var(--lg-col) / 2);flex-direction:column;box-shadow:0 0 0 100vmax rgba(40, 28, 16, .42)}
.pc-sheet{flex-direction:column;max-height:74%;padding:15px 18px calc(14px + env(safe-area-inset-bottom));box-sizing:border-box;border-radius:21px 21px 0 0}
.pc-sheet-head{flex:none;padding-bottom:9px}
.pc-sheet-title{font-size:18px;font-weight:700}
.pc-sheet-close{padding:4px 9px;font-size:15px}
.pc-sheet-list{flex:1;height:540px;max-height:60vh}
.pc-record{margin-bottom:10px;padding:9px 13px;border-radius:13px}
.pc-record-name{font-size:12px;font-weight:600}
.pc-record-text{margin-top:2px;font-size:15px;line-height:1.6}
@keyframes pc-bubble-in{from{opacity:0;transform:translate3d(0, 7px, 0) scale(.96)}to{opacity:1;transform:translate3d(0, 0, 0) scale(1)}}
@keyframes pc-sheet-up{from{transform:translate3d(0, 24px, 0);opacity:.4}to{transform:translate3d(0, 0, 0);opacity:1}}
.pc-page .pc-body, .pc-page .pc-skeleton{flex-direction:row}
.pc-page .pc-stage, .pc-page .pc-skeleton-stage{flex:1 1 auto;height:auto}
.pc-page .pc-side, .pc-page .pc-skeleton-side{flex:0 0 40%;max-width:460px;min-width:300px}
.pc-page .pc-side-inner{padding:20px 20px 12px}
.pc-page .pc-row{padding:0 16px}
.pc-page .pc-bubble-slot{height:132px}
.pc-page .pc-bubble{right:6px;left:6px;padding:9px 12px;border-radius:14px}
.pc-page .pc-peer.is-speaking .pc-bubble{padding-right:28px}
.pc-page .pc-bubble-text{font-size:15px}
.pc-page .pc-figure{width:236px;height:266px}
.pc-page .pc-person{left:8px;width:220px;height:220px}
.pc-page .pc-halo{top:4px;left:18px;width:200px;height:200px;border-width:4px}
.pc-page .pc-desk, .pc-page .pc-desk-art{width:236px;height:90px}
.pc-page .pc-nameplate{top:34px;height:34px;padding:0 12px;border-radius:8px}
.pc-page .pc-name{font-size:16px}
.pc-page .pc-star{width:16px;height:16px}
.pc-page .pc-star-text{font-size:14px}
.pc-page .pc-footer-inner{max-width:860px;margin:0 auto}
.pc-page .pc-hint-row{padding:4px 20px 14px}
.pc-page .pc-help{margin:4px 20px 14px}
}
