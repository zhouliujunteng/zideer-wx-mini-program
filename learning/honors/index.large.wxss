/* 自动生成，请勿手改：index.wxss 在平板、电脑大屏（窗口宽 ≥ 450px）下的样式。
   rpx 按 1rpx = 0.6px 换算，固定定位元素收进居中栏；改完源文件后运行 node scripts/build-large-screen-styles.mjs */
@media (min-width: 450px) {
.sk{border-radius:7px}
.sk-line{height:16px}
.sk-line + .sk-line{margin-top:8px}
.sk-short{width:40%}
.sk-mid{width:64%}
.sk-round{border-radius:50%}
.sk-card{height:96px;border-radius:14px}
.sk-card + .sk-card{margin-top:12px}
.hn-page{height:100vh;font-size:16px;line-height:1.5}
.hn-ambient{top:0;left:0;right:0;height:336px}
.hn-topbar{top:0;left:max(0px, 50% - var(--lg-col) / 2);right:max(0px, 50% - var(--lg-col) / 2);box-sizing:content-box;padding-left:12px}
.hn-back{width:44px;height:44px}
.hn-back-icon{width:10px;height:10px;border-bottom:2px solid #1F2421;border-left:2px solid #1F2421}
.hn-scroll{height:100vh;box-sizing:border-box}
.hn-shell{padding:4px 24px calc(43px + env(safe-area-inset-bottom))}
.hn-title{font-size:36px;font-weight:500;letter-spacing:0.5px;line-height:1.3}
.hn-sub{margin-top:4px;font-size:15px}
.hn-sub-num{font-weight:700}
.hn-sk-sub{width:192px;height:18px;margin-top:9px}
.hn-sk-head{width:120px;height:20px;margin:43px 0 21px}
.hn-sk-row.is-wrap{row-gap:28px}
.hn-sk-item{gap:12px;width:33.33%}
.hn-sk-art{width:100px;height:100px;border-radius:24px}
.hn-sk-name{width:72px;height:16px}
.hn-error{gap:14px;margin-top:96px;padding:28px;border-radius:19px}
.hn-error-retry{padding:9px 28px;border-radius:599px;font-weight:600}
.hn-head{margin:43px 0 16px}
.hn-head-title{font-size:16px;font-weight:600}
.hn-head-sub{font-size:13px}
.hn-grid{row-gap:26px}
.hn-item{width:33.33%}
.hn-art-wrap{width:110px;height:110px}
.hn-art-wrap.is-cup{width:122px;height:122px}
.hn-art{width:100%;height:100%}
.hn-item.is-earned .hn-art{filter:drop-shadow(0 6px 8px rgba(70, 50, 10, .2))}
.hn-item.is-locked .hn-art{filter:grayscale(1) contrast(.55) brightness(1.32)}
.hn-glint{top:14%;right:16%;width:18px;height:18px}
.hn-glint.glint-1{top:46%;right:auto;left:12%}
.hn-glint.glint-2{top:20%;right:auto;left:20%}
.hn-new{top:2px;right:0;min-width:26px;height:21px;padding:0 6px;border-radius:6px;font-size:12px;font-weight:700;line-height:21px;box-sizing:border-box}
.hn-name{margin-top:8px;max-width:132px;font-size:15px}
.hn-level{margin-top:1px;font-size:13px;font-weight:600}
.hn-bar{width:67px;height:3px;margin-top:7px;border-radius:3px}
.hn-bar.is-wide{width:100%;height:6px;margin-top:0;border-radius:6px}
.hn-bar-fill{height:100%;border-radius:inherit}
.hn-progress{margin-top:3px;font-size:12px}
.hn-foot{margin-top:52px;font-size:13px}
.hn-detail{top:0;right:max(0px, 50% - var(--lg-col) / 2);bottom:0;left:max(0px, 50% - var(--lg-col) / 2);box-shadow:0 0 0 100vmax #FFFFFF}
.hn-detail-glow{top:0;left:0;right:0;height:540px}
.hn-detail-scroll{height:100vh;box-sizing:border-box}
.hn-detail-body{padding:0 33px calc(33px + env(safe-area-inset-bottom))}
.hn-detail-stage{width:336px;height:336px;margin-top:4px}
.hn-detail-shine{width:336px;height:336px}
.hn-detail-art{width:268px;height:268px}
.hn-detail-art.is-locked{filter:grayscale(1) contrast(.55) brightness(1.32)}
.hn-detail-title{margin-top:4px;font-size:33px;font-weight:400;letter-spacing:1px}
.hn-detail-pill{margin-top:9px;padding:3px 15px;border-radius:599px;font-size:14px;font-weight:600}
.hn-detail-note{margin-top:16px;font-size:16px}
.hn-detail-date{margin-top:12px;font-size:14px}
.hn-ladder{width:100%;margin-top:33px;padding:19px 7px;border-radius:19px;box-sizing:border-box}
.hn-step{min-width:0}
.hn-step-art{width:62px;height:62px;filter:grayscale(1) contrast(.55) brightness(1.32)}
.hn-step.is-reached .hn-step-art{filter:none}
.hn-step-dot{width:38px;height:38px;border-radius:50%}
.hn-step.is-reached .hn-step-dot{box-shadow:0 3px 8px rgba(194, 138, 28, .3)}
.hn-step-dot-text{font-size:15px;font-weight:700}
.hn-step-label{margin-top:7px;font-size:14px;font-weight:600}
.hn-step-target{font-size:13px}
.hn-detail-status{gap:9px;width:100%;margin-top:24px}
.hn-detail-status-text{font-size:14px}
.hn-detail-button{width:100%;height:57px;margin-top:33px;border-radius:12px;font-size:18px;font-weight:600;line-height:57px}
@keyframes hn-rise{from{opacity:0;transform:translateY(16px)}to{opacity:1;transform:translateY(0)}}
@keyframes hn-float{0%, 100%{transform:translateY(0)}50%{transform:translateY(-5px)}}
}
