@import "../../styles/skeleton.wxss";
/* 我的荣誉第二版（2026-11-13 用户要求：统一格式、要精致、要能动，参照小米汽车「我的勋章」）：
   浅色干净的底，图自己是主角（GPT 生图的金属奖杯 / 勋章）；没拿到的是压灰的同一张图；详情整页，能随手机转动。 */
page { background: #FAFAF8; }
.hn-page { position: relative; height: 100vh; overflow: hidden; color: #1F2421; background: #FAFAF8; font-size: 28rpx; line-height: 1.5; }
.hn-ambient { position: absolute; top: 0; left: 0; right: 0; height: 560rpx; pointer-events: none; background: radial-gradient(ellipse at 88% 0, rgba(240, 205, 150, .55), rgba(240, 205, 150, 0) 68%), linear-gradient(180deg, #F8EBD6 0, #FAFAF8 100%); }

/* 顶栏：只有返回 */
.hn-topbar { position: fixed; top: 0; left: 0; right: 0; z-index: 20; box-sizing: content-box; display: flex; align-items: center; padding-left: 12px; }
.hn-back { width: 44px; height: 44px; display: flex; align-items: center; justify-content: center; }
.hn-back:active { opacity: .6; }
.hn-back-icon { width: 10px; height: 10px; border-bottom: 2px solid #1F2421; border-left: 2px solid #1F2421; transform: rotate(45deg); }
.hn-scroll { position: relative; height: 100vh; box-sizing: border-box; }
.hn-shell { padding: 8rpx 40rpx calc(72rpx + env(safe-area-inset-bottom)); }
.hn-title { display: block; font-size: 60rpx; font-weight: 500; letter-spacing: 1rpx; line-height: 1.3; }
.hn-sub { margin-top: 8rpx; color: #6E746F; font-size: 26rpx; }
.hn-sub-num { color: #C28A1C; font-weight: 700; }

/* 骨架 */
.hn-sk-sub { width: 320rpx; height: 30rpx; margin-top: 16rpx; }
.hn-sk-head { width: 200rpx; height: 34rpx; margin: 72rpx 0 36rpx; }
.hn-sk-row { display: flex; }
.hn-sk-row.is-wrap { flex-wrap: wrap; row-gap: 48rpx; }
.hn-sk-item { display: flex; flex-direction: column; align-items: center; gap: 20rpx; width: 33.33%; }
.hn-sk-art { width: 168rpx; height: 168rpx; border-radius: 40rpx; }
.hn-sk-name { width: 120rpx; height: 28rpx; }

.hn-error { display: flex; flex-direction: column; align-items: center; gap: 24rpx; margin-top: 160rpx; padding: 48rpx; border-radius: 32rpx; background: #FFFFFF; }
.hn-error-text { color: #6E746F; text-align: center; }
.hn-error-retry { padding: 16rpx 48rpx; border-radius: 999rpx; background: #1F2421; color: #FFFFFF; font-weight: 600; }

/* 分组标题 */
.hn-head { display: flex; align-items: baseline; justify-content: space-between; margin: 72rpx 0 28rpx; }
.hn-head-title { font-size: 28rpx; font-weight: 600; }
.hn-head-sub { color: #9A9F9A; font-size: 22rpx; }

/* 网格：一行三样 */
.hn-grid { display: flex; flex-wrap: wrap; row-gap: 44rpx; }
.hn-item { display: flex; flex-direction: column; align-items: center; width: 33.33%; animation: hn-rise .5s cubic-bezier(.2, .9, .3, 1) both; }
.hn-item:active .hn-art-wrap { transform: scale(.94); }
.hn-art-wrap { position: relative; width: 184rpx; height: 184rpx; transition: transform .15s ease; }
.hn-art-wrap.is-cup { width: 204rpx; height: 204rpx; }
.hn-art { width: 100%; height: 100%; }
.hn-item.is-earned .hn-art { filter: drop-shadow(0 10rpx 14rpx rgba(70, 50, 10, .2)); }
.hn-item.is-earned .hn-art-wrap.is-cup .hn-art { animation: hn-float 4.6s ease-in-out infinite; }
/* 没拿到：同一张图压成浅灰的浮雕 */
.hn-item.is-locked .hn-art { filter: grayscale(1) contrast(.55) brightness(1.32); opacity: .55; }
/* 拿到的：一颗四角星一闪一闪 */
.hn-glint { position: absolute; top: 14%; right: 16%; width: 30rpx; height: 30rpx; pointer-events: none; background: radial-gradient(ellipse at center, #FFFFFF 0, rgba(255, 255, 255, 0) 70%); clip-path: polygon(50% 0, 60% 40%, 100% 50%, 60% 60%, 50% 100%, 40% 60%, 0 50%, 40% 40%); animation: hn-glint 3.6s ease-in-out infinite; opacity: 0; }
.hn-glint.glint-1 { top: 46%; right: auto; left: 12%; animation-delay: 1.2s; }
.hn-glint.glint-2 { top: 20%; right: auto; left: 20%; animation-delay: 2.3s; }
.hn-new { position: absolute; top: 4rpx; right: 0; min-width: 44rpx; height: 36rpx; padding: 0 10rpx; border-radius: 10rpx; background: #D9A441; color: #FFFFFF; font-size: 20rpx; font-weight: 700; line-height: 36rpx; text-align: center; box-sizing: border-box; }
.hn-name { margin-top: 14rpx; max-width: 220rpx; font-size: 26rpx; text-align: center; }
.hn-item.is-locked .hn-name { color: #8B908B; }
.hn-level { margin-top: 2rpx; font-size: 22rpx; font-weight: 600; color: #A9ADA9; }
.hn-level.lv-1 { color: #A8683A; }
.hn-level.lv-2 { color: #6F7C8C; }
.hn-level.lv-3 { color: #C28A1C; }
.hn-level.lv-4 { color: #6C5CE7; }
.hn-bar { width: 112rpx; height: 6rpx; margin-top: 12rpx; border-radius: 6rpx; background: #E9E9E4; overflow: hidden; }
.hn-bar.is-wide { width: 100%; height: 10rpx; margin-top: 0; border-radius: 10rpx; }
.hn-bar-fill { height: 100%; border-radius: inherit; background: linear-gradient(90deg, #E8B95B, #C28A1C); }
.hn-progress { margin-top: 6rpx; color: #9A9F9A; font-size: 20rpx; }
.hn-foot { margin-top: 88rpx; color: #B4B8B3; font-size: 22rpx; text-align: center; }

/* 详情：整页 */
.hn-detail { position: fixed; top: 0; right: 0; bottom: 0; left: 0; z-index: 40; background: #FFFFFF; animation: hn-detail-in .28s cubic-bezier(.2, .9, .3, 1) both; }
.hn-detail-glow { position: absolute; top: 0; left: 0; right: 0; height: 900rpx; pointer-events: none; background: radial-gradient(ellipse at 50% 38%, rgba(225, 228, 232, .7), rgba(225, 228, 232, 0) 62%); }
.hn-detail-glow.is-earned { background: radial-gradient(ellipse at 50% 38%, rgba(246, 222, 170, .75), rgba(246, 222, 170, 0) 62%); }
.hn-topbar.is-detail { z-index: 42; }
.hn-detail-scroll { position: relative; height: 100vh; box-sizing: border-box; }
.hn-detail-body { display: flex; flex-direction: column; align-items: center; padding: 0 56rpx calc(56rpx + env(safe-area-inset-bottom)); }
.hn-detail-stage { display: flex; align-items: center; justify-content: center; width: 560rpx; height: 560rpx; margin-top: 8rpx; }
.hn-detail-shine { width: 560rpx; height: 560rpx; }
.hn-detail-art { width: 448rpx; height: 448rpx; }
.hn-detail-art.is-locked { filter: grayscale(1) contrast(.55) brightness(1.32); opacity: .6; }
.hn-detail-title { margin-top: 8rpx; font-size: 56rpx; font-weight: 400; letter-spacing: 2rpx; animation: hn-rise .45s ease .15s both; }
.hn-detail-pill { margin-top: 16rpx; padding: 6rpx 26rpx; border-radius: 999rpx; background: #F1F1EE; color: #8B908B; font-size: 24rpx; font-weight: 600; animation: hn-rise .45s ease .2s both; }
.hn-detail-pill.lv-1 { background: #F6E9DF; color: #A8683A; }
.hn-detail-pill.lv-2 { background: #EBEEF2; color: #5F6C7B; }
.hn-detail-pill.lv-3 { background: #FBF0D5; color: #B07A10; }
.hn-detail-pill.lv-4 { background: #ECE9FD; color: #6C5CE7; }
.hn-detail-pill.kind-medal.lv-1, .hn-detail-pill.kind-medal.lv-2, .hn-detail-pill.kind-medal.lv-3 { background: #FBF0D5; color: #B07A10; }
.hn-detail-note { margin-top: 28rpx; color: #5B615C; font-size: 28rpx; text-align: center; animation: hn-rise .45s ease .25s both; }
.hn-detail-date { margin-top: 20rpx; color: #A9ADA9; font-size: 24rpx; animation: hn-rise .45s ease .3s both; }

/* 每一级 */
.hn-ladder { display: flex; justify-content: space-between; width: 100%; margin-top: 56rpx; padding: 32rpx 12rpx; border-radius: 32rpx; background: #F7F7F4; box-sizing: border-box; animation: hn-rise .45s ease .35s both; }
.hn-step { flex: 1; display: flex; flex-direction: column; align-items: center; min-width: 0; opacity: .5; }
.hn-step.is-reached { opacity: 1; }
.hn-step-art { width: 104rpx; height: 104rpx; filter: grayscale(1) contrast(.55) brightness(1.32); }
.hn-step.is-reached .hn-step-art { filter: none; }
.hn-step.is-current .hn-step-art { transform: scale(1.18); }
.hn-step-dot { display: flex; align-items: center; justify-content: center; width: 64rpx; height: 64rpx; border-radius: 50%; background: #E4E4DF; }
.hn-step.is-reached .hn-step-dot { background: linear-gradient(145deg, #F1CE7E, #C28A1C); box-shadow: 0 6rpx 14rpx rgba(194, 138, 28, .3); }
.hn-step.is-current .hn-step-dot { transform: scale(1.16); }
.hn-step-dot-text { color: #FFFFFF; font-size: 26rpx; font-weight: 700; }
.hn-step-label { margin-top: 12rpx; font-size: 24rpx; font-weight: 600; }
.hn-step-target { color: #8B908B; font-size: 22rpx; }

.hn-detail-status { display: flex; flex-direction: column; align-items: center; gap: 16rpx; width: 100%; margin-top: 40rpx; animation: hn-rise .45s ease .4s both; }
.hn-detail-status-text { color: #6E746F; font-size: 24rpx; text-align: center; }
.hn-detail-button { width: 100%; height: 96rpx; margin-top: 56rpx; border-radius: 20rpx; background: #1F2421; color: #FFFFFF; font-size: 30rpx; font-weight: 600; line-height: 96rpx; text-align: center; animation: hn-rise .45s ease .45s both; }
.hn-detail-button:active { opacity: .8; }

@keyframes hn-rise { from { opacity: 0; transform: translateY(28rpx); } to { opacity: 1; transform: translateY(0); } }
@keyframes hn-float { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-8rpx); } }
@keyframes hn-glint { 0%, 70%, 100% { opacity: 0; transform: scale(.3) rotate(0deg); } 80% { opacity: 1; transform: scale(1.15) rotate(40deg); } 90% { opacity: 0; transform: scale(.4) rotate(80deg); } }
@keyframes hn-detail-in { from { opacity: 0; transform: translateX(12%); } to { opacity: 1; transform: translateX(0); } }

/* 大屏：一行多放几样 */
@media (min-width: 500px) {
  page { --lg-col: 720px; }
}

@import "./index.large.wxss"; /* 平板、电脑大屏样式：由 scripts/build-large-screen-styles.mjs 生成，改完本文件后重跑；这一行须留在文件末尾 */
