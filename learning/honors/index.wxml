<wxs module="UA" src="../../utils/ui-asset.wxs" />
<!-- 我的荣誉第二版（2026-11-13）：统一的奖杯（3 座各 4 级）+ 勋章（9 枚分 4 组），不跟课程内容走；点任意一样打开详情，能随手机转动。 -->
<view class="hn-page">
  <view class="hn-ambient" aria-hidden="true"></view>
  <view class="hn-topbar" style="padding-top: {{statusBarHeight}}px; height: {{navigationBarHeight}}px;">
    <view class="hn-back" bindtap="handleBack" role="button" aria-label="返回上一页"><view class="hn-back-icon"></view></view>
  </view>

  <scroll-view class="hn-scroll" scroll-y show-scrollbar="{{false}}" style="padding-top: {{contentTop}}px;">
    <view class="hn-shell">
      <text class="hn-title">我的荣誉</text>

      <!-- 骨架 -->
      <block wx:if="{{!loaded && !loadFailed}}">
        <view class="sk sk-line sk-short hn-sk-sub"></view>
        <view class="sk sk-line sk-short hn-sk-head"></view>
        <view class="hn-sk-row"><view wx:for="{{skeletonCups}}" wx:key="*this" class="hn-sk-item"><view class="sk hn-sk-art"></view><view class="sk sk-line hn-sk-name"></view></view></view>
        <view class="sk sk-line sk-short hn-sk-head"></view>
        <view class="hn-sk-row is-wrap"><view wx:for="{{skeletonMedals}}" wx:key="*this" class="hn-sk-item"><view class="sk hn-sk-art"></view><view class="sk sk-line hn-sk-name"></view></view></view>
      </block>

      <view wx:elif="{{!loaded}}" class="hn-error" role="alert">
        <text class="hn-error-text">{{loadError}}</text>
        <view class="hn-error-retry" bindtap="retry" role="button">重新读取</view>
      </view>

      <block wx:else>
        <view class="hn-sub">
          <text wx:if="{{view.summary.earned}}">已获得 <text class="hn-sub-num">{{view.summary.earned}}</text> 项荣誉，共 {{view.summary.total}} 项</text>
          <text wx:else>学起来，第一项荣誉很快就到</text>
        </view>

        <!-- 奖杯：3 座，每座 4 级 -->
        <view class="hn-head">
          <text class="hn-head-title">奖杯（{{view.cupsEarned}}/{{view.cups.length}}）</text>
          <text class="hn-head-sub">铜、银、金、钻石，越学越高</text>
        </view>
        <view class="hn-grid">
          <view wx:for="{{view.cups}}" wx:key="id" class="hn-item {{item.earned ? 'is-earned' : 'is-locked'}}" style="animation-delay: {{index * 70}}ms;" data-id="{{item.id}}" bindtap="openHonor" role="button" aria-label="{{item.title}}{{item.earned ? '，' + item.levelLabel : '，未获得'}}">
            <view class="hn-art-wrap is-cup">
              <image class="hn-art" src="{{UA.src(ui, item.art)}}" mode="aspectFit"></image>
              <view wx:if="{{item.earned}}" class="hn-glint glint-{{index % 3}}" aria-hidden="true"></view>
              <text wx:if="{{item.isNew}}" class="hn-new">新</text>
            </view>
            <text class="hn-name">{{item.title}}</text>
            <text class="hn-level lv-{{item.level}}">{{item.earned ? item.levelLabel : '未获得'}}</text>
            <view wx:if="{{item.progress}}" class="hn-bar"><view class="hn-bar-fill" style="width: {{item.percent}}%;"></view></view>
            <text wx:if="{{item.progress}}" class="hn-progress">{{item.progress}}</text>
          </view>
        </view>

        <!-- 勋章：按组 -->
        <block wx:for="{{view.groups}}" wx:for-item="group" wx:for-index="groupIndex" wx:key="key">
          <view class="hn-head">
            <text class="hn-head-title">{{group.label}}勋章（{{group.earned}}/{{group.total}}）</text>
          </view>
          <view class="hn-grid">
            <view wx:for="{{group.medals}}" wx:key="id" class="hn-item {{item.earned ? 'is-earned' : 'is-locked'}}" style="animation-delay: {{(groupIndex + 1) * 90 + index * 70}}ms;" data-id="{{item.id}}" bindtap="openHonor" role="button" aria-label="{{item.name}}{{item.earned ? '，已获得' : '，未获得'}}">
              <view class="hn-art-wrap">
                <image class="hn-art" src="{{UA.src(ui, item.art)}}" mode="aspectFit"></image>
                <view wx:if="{{item.earned}}" class="hn-glint glint-{{(groupIndex + index) % 3}}" aria-hidden="true"></view>
                <text wx:if="{{item.isNew}}" class="hn-new">新</text>
              </view>
              <text class="hn-name">{{item.name}}</text>
              <view wx:if="{{item.progress}}" class="hn-bar"><view class="hn-bar-fill" style="width: {{item.percent}}%;"></view></view>
              <text wx:if="{{item.progress}}" class="hn-progress">{{item.progress}}</text>
            </view>
          </view>
        </block>
        <view class="hn-foot">荣誉只能靠学习挣来，不能抽、不能买</view>
      </block>
    </view>
  </scroll-view>
</view>

<!-- 详情：整页。拿到的能随手机转动、反光（honor-shine），没拿到的是灰的；下面是每一级。 -->
<view wx:if="{{detail}}" class="hn-detail" catchtouchmove="noop">
  <view class="hn-detail-glow {{detail.earned ? 'is-earned' : ''}}" aria-hidden="true"></view>
  <view class="hn-topbar is-detail" style="padding-top: {{statusBarHeight}}px; height: {{navigationBarHeight}}px;">
    <view class="hn-back" bindtap="closeHonor" role="button" aria-label="返回"><view class="hn-back-icon"></view></view>
  </view>
  <scroll-view class="hn-detail-scroll" scroll-y show-scrollbar="{{false}}" style="padding-top: {{contentTop}}px;">
    <view class="hn-detail-body">
      <view class="hn-detail-stage">
        <honor-shine wx:if="{{detail.earned}}" class="hn-detail-shine" src="{{UA.src(ui, detail.art)}}" />
        <image wx:else class="hn-detail-art is-locked" src="{{UA.src(ui, detail.art)}}" mode="aspectFit"></image>
      </view>
      <text class="hn-detail-title">{{detail.title}}</text>
      <text class="hn-detail-pill {{detail.earned ? 'lv-' + detail.level : ''}} kind-{{detail.kind}}">{{detail.pill}}</text>
      <text class="hn-detail-note">{{detail.note}}</text>
      <text wx:if="{{detail.date}}" class="hn-detail-date">{{detail.date}} 已获得</text>

      <view wx:if="{{detail.ladder.length}}" class="hn-ladder kind-{{detail.kind}}">
        <view wx:for="{{detail.ladder}}" wx:key="id" class="hn-step {{item.reached ? 'is-reached' : ''}} {{item.current ? 'is-current' : ''}}">
          <image wx:if="{{item.art}}" class="hn-step-art" src="{{UA.src(ui, item.art)}}" mode="aspectFit"></image>
          <view wx:else class="hn-step-dot"><text class="hn-step-dot-text">{{index + 1}}</text></view>
          <text class="hn-step-label">{{item.label}}</text>
          <text class="hn-step-target">{{item.target}}</text>
        </view>
      </view>

      <view class="hn-detail-status">
        <view wx:if="{{detail.progress}}" class="hn-bar is-wide"><view class="hn-bar-fill" style="width: {{detail.percent}}%;"></view></view>
        <text class="hn-detail-status-text">{{detail.nextStep}}</text>
      </view>
      <view class="hn-detail-button" bindtap="closeHonor" role="button">知道了</view>
    </view>
  </scroll-view>
</view>
<dev-reset-fab />
