/* 自动生成，请勿手改：index.wxss 在平板、电脑大屏（窗口宽 ≥ 450px）下的样式。
   rpx 按 1rpx = 0.6px 换算，固定定位元素收进居中栏；改完源文件后运行 node scripts/build-large-screen-styles.mjs */
@media (min-width: 450px) {
.sk{border-radius:7px;background:linear-gradient(90deg, #ECEEEB 25%, #F5F6F4 37%, #ECEEEB 63%);background-size:400% 100%}
.sk-line{height:16px}
.sk-line + .sk-line{margin-top:8px}
.sk-short{width:40%}
.sk-mid{width:64%}
.sk-round{border-radius:50%}
.sk-card{height:96px;border-radius:14px}
.sk-card + .sk-card{margin-top:12px}
.ac-face{box-sizing:border-box;width:100%;height:100%;padding:0 4px 4px;border-radius:9px;background:var(--ac-color, #FD7C02)}
.ac-face-tag{height:24px;font-size:13px;font-weight:700;line-height:24px}
.ac-face-art{min-height:0;border-radius:6px;background:#FFF8EE}
.ac-face-image{width:100%;height:100%}
.ac-face-placeholder{inset:0;background:linear-gradient(160deg, rgba(255, 255, 255, 0.92), rgba(255, 255, 255, 0.55)), var(--ac-color, #FD7C02)}
.ac-face-placeholder-title{font-size:18px;font-weight:800;letter-spacing:1px}
.ac-face-placeholder-no{margin-top:3px;font-size:13px;font-weight:700}
.ac-badge{top:-8px;right:-8px;min-width:21px;height:21px;padding:0 4px;box-sizing:border-box;border:1px solid #FFFFFF;border-radius:599px;background:#F04438;font-size:12px;font-weight:700;line-height:18px}
.ac-lock{width:10px;height:13px}
.ac-lock::before{left:1px;top:0;width:7px;height:7px;box-sizing:border-box;border:1px solid currentColor;border-bottom:none;border-radius:4px 4px 0 0}
.ac-lock::after{left:0;bottom:0;width:10px;height:7px;border-radius:1px;background:currentColor}
page{background:#FFF9F2}
.ac-page{height:100vh;background:linear-gradient(180deg, #FFEFE6 0%, #FFF9F2 144px, #FFFFFF 70%)}
.ac-topbar{top:0;left:max(0px, 50% - var(--lg-col) / 2);right:max(0px, 50% - var(--lg-col) / 2);box-sizing:content-box;padding-left:16px}
.ac-round-button{box-sizing:border-box;border:0.5px solid rgba(0, 0, 0, 0.08);border-radius:50%;background:rgba(255, 255, 255, 0.92);font-size:16px;font-weight:700}
.ac-back-icon{width:9px;height:9px;margin-left:3px;border-bottom:2px solid #24332D;border-left:2px solid #24332D}
.ac-topbar-title{left:50%;font-size:20px;font-weight:700}
.ac-scroll{height:100vh;box-sizing:border-box}
.ac-shell{padding:12px 21px calc(48px + env(safe-area-inset-bottom))}
.ac-summary{gap:12px;font-size:15px}
.ac-summary-main{gap:3px}
.ac-summary-num{font-size:20px;font-weight:800}
.ac-summary-bonus{font-size:14px;font-weight:700}
.ac-fragment-chip{gap:6px;padding:8px 13px 8px 14px;border-radius:599px;background:#24282F;box-shadow:0 6px 14px rgba(36, 40, 47, 0.18)}
.ac-gem{width:14px;height:14px;border-radius:3px;background:linear-gradient(135deg, #FFE7C2, #FD7C02);box-shadow:0 0 6px rgba(253, 124, 2, 0.6)}
.ac-fragment-count{font-size:18px;font-weight:800}
.ac-fragment-label{font-size:14px}
.ac-chevron{font-size:18px}
.ac-series{margin-top:26px}
.ac-section-head{gap:12px;margin-bottom:14px}
.ac-section-title{font-size:22px;font-weight:800}
.ac-section-line{height:1px;border-radius:1px;background:linear-gradient(90deg, rgba(36, 51, 45, 0.1), rgba(36, 51, 45, 0))}
.ac-series-draw{gap:3px;padding:7px 15px;border-radius:599px;background:#FD7C02;font-size:15px;font-weight:800;box-shadow:0 6px 13px rgba(253, 124, 2, 0.3)}
.ac-series-draw-count{font-size:14px}
.ac-series-draw-off{background:#ECEEEB;box-shadow:none}
.ac-series-task{gap:9px;margin:-4px 0 14px;padding:8px 12px;border-radius:9px;background:rgba(253, 124, 2, 0.08)}
.ac-series-task-text{min-width:0;font-size:14px}
.ac-series-task-today{font-size:14px;font-weight:700}
.ac-section-subtitle{margin:-8px 0 14px;font-size:14px}
.ac-grid{grid-template-columns:repeat(3, minmax(0, 1fr));gap:16px 14px}
.ac-card{width:100%;border-radius:9px;box-shadow:0 6px 14px rgba(36, 51, 45, 0.1)}
.ac-count{margin-top:8px;font-size:15px;font-weight:600}
.ac-sk-summary{width:156px}
.ac-sk-card{width:100%;border-radius:9px}
.ac-sk-count{width:36px;margin-top:8px}
.ac-state{padding-top:120px}
.ac-state-title{font-size:19px;font-weight:700}
.ac-state-copy{margin-top:8px;font-size:15px}
.ac-state-action{margin-top:21px;padding:10px 28px;border-radius:599px;background:#FD7C02;font-size:16px;font-weight:700}
.ac-rules-mask{top:0;right:max(0px, 50% - var(--lg-col) / 2);bottom:0;left:max(0px, 50% - var(--lg-col) / 2);background:rgba(20, 24, 30, 0.45);box-shadow:0 0 0 100vmax rgba(20, 24, 30, 0.45)}
.ac-rules{width:360px;padding:28px 26px 21px;box-sizing:border-box;border-radius:19px;background:#FFFFFF}
.ac-rules-title{margin-bottom:14px;font-size:20px;font-weight:800}
.ac-rules-line{margin-top:8px;font-size:16px;line-height:1.6}
.ac-rules-ok{margin-top:21px;height:50px;border-radius:12px;background:#FD7C02;font-size:18px;font-weight:700;line-height:50px}
.ac-grid{grid-template-columns:repeat(4, minmax(0, 1fr))}
}
