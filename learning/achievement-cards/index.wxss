@import "../../styles/skeleton.wxss";
@import "../../styles/achievement-card.wxss";

page {
  background: #FFF9F2;
}

.ac-page {
  height: 100vh;
  overflow: hidden;
  background: linear-gradient(180deg, #FFEFE6 0%, #FFF9F2 240rpx, #FFFFFF 70%);
  color: #24332d;
}

.ac-topbar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 20;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-sizing: content-box;
  padding-left: 28rpx;
}

.ac-round-button {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  border: 1rpx solid rgba(0, 0, 0, 0.08);
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.92);
  color: #6b7280;
  font-size: 28rpx;
  font-weight: 700;
}

.ac-round-button:active {
  opacity: 0.7;
}

.ac-back-icon {
  width: 16rpx;
  height: 16rpx;
  margin-left: 6rpx;
  border-bottom: 4rpx solid #24332D;
  border-left: 4rpx solid #24332D;
  transform: rotate(45deg);
}

.ac-topbar-title {
  position: absolute;
  left: 50%;
  color: #24332d;
  font-size: 34rpx;
  font-weight: 700;
  transform: translateX(-50%);
}

.ac-scroll {
  height: 100vh;
  box-sizing: border-box;
}

.ac-shell {
  padding: 20rpx 36rpx calc(80rpx + env(safe-area-inset-bottom));
}

.ac-summary {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  color: #7d8580;
  font-size: 26rpx;
}

.ac-summary-main {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.ac-summary-num {
  color: #24332d;
  font-size: 34rpx;
  font-weight: 800;
}

.ac-summary-bonus {
  color: #FD7C02;
  font-size: 24rpx;
  font-weight: 700;
}

/* 碎片商店入口：深色胶囊 + 橙色菱形碎片 */
.ac-fragment-chip {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 14rpx 22rpx 14rpx 24rpx;
  border-radius: 999rpx;
  background: #24282F;
  color: #FFFFFF;
  box-shadow: 0 10rpx 24rpx rgba(36, 40, 47, 0.18);
}

.ac-fragment-chip:active {
  transform: scale(0.97);
}

.ac-gem {
  width: 24rpx;
  height: 24rpx;
  border-radius: 5rpx;
  background: linear-gradient(135deg, #FFE7C2, #FD7C02);
  box-shadow: 0 0 10rpx rgba(253, 124, 2, 0.6);
  transform: rotate(45deg);
}

.ac-fragment-count {
  font-size: 30rpx;
  font-weight: 800;
}

.ac-fragment-label {
  color: rgba(255, 255, 255, 0.75);
  font-size: 24rpx;
}

.ac-chevron {
  color: rgba(255, 255, 255, 0.5);
  font-size: 30rpx;
}

.ac-series {
  margin-top: 44rpx;
}

.ac-section-head {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 24rpx;
}

.ac-section-title {
  flex: none;
  color: #111613;
  font-size: 38rpx;
  font-weight: 800;
}

.ac-section-line {
  flex: 1;
  height: 3rpx;
  border-radius: 2rpx;
  background: linear-gradient(90deg, rgba(36, 51, 45, 0.1), rgba(36, 51, 45, 0));
}

/* 系列标题右边的「抽卡 ×N」 */
.ac-series-draw {
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 12rpx 26rpx;
  border-radius: 999rpx;
  background: #FD7C02;
  color: #FFFFFF;
  font-size: 26rpx;
  font-weight: 800;
  box-shadow: 0 10rpx 22rpx rgba(253, 124, 2, 0.3);
}

.ac-series-draw:active {
  transform: scale(0.96);
}

.ac-series-draw-count {
  font-size: 24rpx;
}

.ac-series-draw-off {
  background: #ECEEEB;
  color: #9aa29e;
  box-shadow: none;
}

.ac-series-task {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin: -6rpx 0 24rpx;
  padding: 14rpx 20rpx;
  border-radius: 16rpx;
  background: rgba(253, 124, 2, 0.08);
}

.ac-series-task-text {
  flex: 1;
  min-width: 0;
  color: #8a5a2b;
  font-size: 24rpx;
}

.ac-series-task-today {
  flex: none;
  color: #FD7C02;
  font-size: 24rpx;
  font-weight: 700;
}

.ac-section-subtitle {
  display: block;
  margin: -12rpx 0 24rpx;
  color: #9aa29e;
  font-size: 24rpx;
}

.ac-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 28rpx 24rpx;
}

.ac-cell {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.ac-cell:active .ac-card {
  transform: scale(0.96);
}

.ac-card {
  position: relative;
  width: 100%;
  aspect-ratio: 5 / 7;
  border-radius: 16rpx;
  box-shadow: 0 10rpx 24rpx rgba(36, 51, 45, 0.1);
  transition: transform 160ms ease, opacity 120ms ease;
}

/* 浮层打开时，格子里这张让出来（看起来就是它飞出去了） */
.ac-card-away {
  opacity: 0;
}

.ac-count {
  margin-top: 14rpx;
  color: #4b5563;
  font-size: 26rpx;
  font-weight: 600;
}

.ac-sk-summary {
  width: 260rpx;
}

.ac-sk-card {
  width: 100%;
  aspect-ratio: 5 / 7;
  border-radius: 16rpx;
}

.ac-sk-count {
  width: 60rpx;
  margin-top: 14rpx;
}

.ac-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 200rpx;
  text-align: center;
}

.ac-state-title {
  color: #24332d;
  font-size: 32rpx;
  font-weight: 700;
}

.ac-state-copy {
  margin-top: 14rpx;
  color: #8a928e;
  font-size: 26rpx;
}

.ac-state-action {
  margin-top: 36rpx;
  padding: 18rpx 48rpx;
  border-radius: 999rpx;
  background: #FD7C02;
  color: #FFFFFF;
  font-size: 28rpx;
  font-weight: 700;
}

.ac-rules-mask {
  position: fixed;
  inset: 0;
  z-index: 950;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(20, 24, 30, 0.45);
}

.ac-rules {
  width: 600rpx;
  padding: 48rpx 44rpx 36rpx;
  box-sizing: border-box;
  border-radius: 32rpx;
  background: #FFFFFF;
}

.ac-rules-title {
  display: block;
  margin-bottom: 24rpx;
  color: #24332d;
  font-size: 34rpx;
  font-weight: 800;
  text-align: center;
}

.ac-rules-line {
  display: block;
  margin-top: 14rpx;
  color: #4b5563;
  font-size: 28rpx;
  line-height: 1.6;
}

.ac-rules-ok {
  margin-top: 36rpx;
  height: 84rpx;
  border-radius: 20rpx;
  background: #FD7C02;
  color: #FFFFFF;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 84rpx;
  text-align: center;
}

@media (min-width: 450px) {
  .ac-grid {
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }
}

@import "./index.large.wxss"; /* 平板、电脑大屏样式：由 scripts/build-large-screen-styles.mjs 生成，改完本文件后重跑；这一行须留在文件末尾 */
