/* 自动生成，请勿手改：index.wxss 在平板、电脑大屏（窗口宽 ≥ 450px）下的样式。
   rpx 按 1rpx = 0.6px 换算，固定定位元素收进居中栏；改完源文件后运行 node scripts/build-large-screen-styles.mjs */
@media (min-width: 450px) {
.sk{border-radius:7px}
.sk-line{height:16px}
.sk-line + .sk-line{margin-top:8px}
.sk-short{width:40%}
.sk-mid{width:64%}
.sk-round{border-radius:50%}
.sk-card{height:96px;border-radius:14px}
.sk-card + .sk-card{margin-top:12px}
.checkin-page{height:100vh}
.checkin-stage{width:100%;border-radius:0 0 26px 26px}
.checkin-topbar{top:0;left:max(0px, 50% - var(--lg-col) / 2);width:min(100%, var(--lg-col));box-sizing:border-box}
.corner-pixel-grid{top:0;left:0;width:100%;height:100%;transform:translate(-4px, -4px)}
.corner-pixel{left:calc(var(--pixel-x) * 600px / 1000);bottom:calc(var(--pixel-bottom) * 600px / 1000);width:21px;height:21px;border-radius:3px}
.checkin-topbar-inner{box-sizing:content-box;padding:0 19px 9px}
.checkin-topbar-title{left:50%;font-size:20px;font-weight:700;letter-spacing:-1px;transform:translateX(-50%)}
.checkin-back{flex:0 0 auto;width:32px;height:32px;border-radius:50%}
.checkin-back-icon{width:13px;height:13px;border-bottom:2px solid #24332D;border-left:2px solid #24332D;transform:rotate(45deg) scale(.7)}
.checkin-share-button{box-sizing:border-box;border:0.5px solid rgba(255,255,255,.85);border-radius:50%}
.share-glyph-svg{width:20px;height:20px}
.checkin-scroll{width:100%;height:100vh;box-sizing:border-box}
.checkin-shell{padding:0 16px calc(114px + env(safe-area-inset-bottom));box-sizing:border-box}
.checkin-hero{right:0;bottom:0;left:0;height:195px;padding:27px 30px 20px;box-sizing:border-box}
.hero-frost{top:15px;right:0;width:147px;height:147px;border-radius:50%}
.hero-coins{margin-top:9px;padding:4px 10px 4px 6px;border-radius:599px;font-size:13px;font-weight:700;line-height:1.2}
.hero-coins-icon{width:19px;height:19px;margin-right:4px}
.hero-copy{max-width:52%}
.hero-label{font-size:15px;font-weight:700;line-height:1.2}
.hero-number-row{margin-top:6px}
.hero-number{font-family:"Arial Rounded MT Bold", "SF Pro Rounded", "Avenir Next Rounded", -apple-system, BlinkMacSystemFont, "Helvetica Neue", sans-serif;font-size:69px;font-weight:900;letter-spacing:-3px;line-height:.9;font-variant-numeric:tabular-nums}
.hero-number-unit{margin:0 0 6px 7px;font-size:16px;font-weight:700}
.hero-state{margin-top:10px;font-size:16px;font-weight:700;line-height:1.25}
.hero-spark-svg{top:15px;right:0;width:147px;height:147px;transform:rotate(-3deg)}
.calendar-month-header{margin-top:14px;padding:0 4px}
.calendar-month-label{font-size:21px;font-weight:800;letter-spacing:-1px;line-height:1.2}
.calendar-month-actions{gap:10px}
.calendar-month-button{width:32px;height:32px;border-radius:50%}
.calendar-month-button::before{width:10px;height:10px;border-top:2px solid #6F7A73;border-right:2px solid #6F7A73;transform:rotate(45deg)}
.calendar-month-button-prev::before{transform:rotate(-135deg)}
.checkin-stat-grid{grid-template-columns:repeat(2, minmax(0, 1fr));gap:8px;margin-top:10px}
.checkin-stat-card{min-width:0;min-height:67px;padding:10px 9px;box-sizing:border-box;border-radius:16px}
.checkin-stat-icon{flex:0 0 24px;width:24px;height:24px;border-radius:50%;font-size:13px;font-weight:800}
.checkin-stat-icon-week{font-size:0}
.checkin-stat-icon-svg{width:14px;height:14px}
.checkin-stat-copy{min-width:0;margin-left:7px}
.checkin-stat-value{font-family:"Arial Rounded MT Bold", "SF Pro Rounded", "Avenir Next Rounded", -apple-system, BlinkMacSystemFont, "Helvetica Neue", sans-serif;font-size:22px;font-weight:800;line-height:1.05;font-variant-numeric:tabular-nums}
.checkin-stat-label{margin-top:4px;font-size:12px;line-height:1.2}
.today-task-card{margin-top:14px;padding:2px 16px;box-sizing:border-box;border-radius:16px}
.today-task-row{height:52px}
.today-task-label{min-width:0;font-size:15px;font-weight:700}
.today-task-end{flex:0 0 auto;margin-left:auto;padding-left:9px}
.today-task-coins{flex:0 0 auto;padding:3px 8px;border-radius:599px;font-size:12px;font-weight:700;line-height:1.25}
.today-task-right{flex:0 0 auto;padding-left:9px;font-size:13px;font-weight:650}
.today-task-done{flex:0 0 auto;width:8px;height:15px;margin-left:13px;margin-right:6px;margin-top:-4px;border-right:3px solid #FD7C02;border-bottom:3px solid #FD7C02;transform:rotate(45deg)}
.streak-props{margin-top:15px}
.streak-props-cards{gap:26px;padding-left:2px}
.prop-card{flex-direction:column}
.prop-card-art{width:100px;height:100px}
.prop-card-image{width:100px;height:100px}
.prop-card-count{top:1px;right:8px;min-width:25px;height:25px;padding:0 6px;box-sizing:border-box;border:2px solid #FAFAFA;border-radius:599px;font-size:13px;font-weight:800;line-height:20px;font-variant-numeric:tabular-nums}
.prop-card-label{margin-top:2px;font-size:14px;font-weight:700;line-height:1.2}
.prop-card-lit.prop-card-freeze .prop-card-image{filter:drop-shadow(0 6px 8px rgba(47, 128, 216, .32))}
.prop-card-lit.prop-card-revive .prop-card-image{filter:drop-shadow(0 6px 8px rgba(224, 80, 124, .32))}
.prop-card-off .prop-card-image{filter:grayscale(1)}
.calendar-card-wrap{height:calc(var(--calendar-height) * 600px / 1000);margin-top:10px;border-radius:20px}
.calendar-card{padding:15px 9px 14px;box-sizing:border-box;border-radius:20px}
.calendar-weekday-row, .calendar-grid{grid-template-columns:repeat(7, minmax(0, 1fr))}
.calendar-weekday-row{margin-top:0}
.calendar-weekday{font-size:12px;line-height:1.2}
.calendar-grid{row-gap:6px;margin-top:10px}
.calendar-cell{height:49px;min-width:0}
.calendar-day-mark{flex-shrink:0;width:40px;height:40px;box-sizing:border-box;border-radius:50%;font-size:14px;line-height:1}
.calendar-day-number{width:40px}
.calendar-day-mark-today{font-weight:700}
.calendar-day-mark-kept{font-weight:800}
.calendar-legend{gap:14px;margin-top:9px;padding:0 7px;font-size:12px}
.calendar-legend-dot{width:10px;height:10px;margin-right:4px;border-radius:50%}
@keyframes calendar-slide-next{from{opacity:.35;transform:translateX(31px)}to{opacity:1;transform:translateX(0)}}
@keyframes calendar-slide-prev{from{opacity:.35;transform:translateX(-32px)}to{opacity:1;transform:translateX(0)}}
.checkin-actionbar{right:max(0px, 50% - var(--lg-col) / 2);bottom:0;left:max(0px, 50% - var(--lg-col) / 2);padding:10px 16px calc(13px + env(safe-area-inset-bottom))}
.checkin-primary-button{width:42%;height:57px;margin:0 auto;box-sizing:border-box;border-radius:599px;font-size:16px;font-weight:650;line-height:57px}
.success-mask{top:0;right:max(0px, 50% - var(--lg-col) / 2);bottom:0;left:max(0px, 50% - var(--lg-col) / 2);box-shadow:0 0 0 100vmax rgba(37,43,39,.34)}
.success-sheet{width:100%;padding:9px 18px calc(16px + env(safe-area-inset-bottom));box-sizing:border-box;border-radius:21px 21px 0 0}
.success-sheet-handle{width:40px;height:4px;margin:0 auto 14px;border-radius:599px}
.success-sheet-icon{width:33px;height:33px;border-radius:10px;font-size:17px}
.success-sheet-copy{min-width:0;margin-left:8px}
.success-sheet-title{font-size:17px;font-weight:750;line-height:1.2}
.success-sheet-subtitle{margin-top:3px;font-size:11px;line-height:1.2}
.success-sheet-close{margin-left:auto;padding:4px 4px 4px 10px;font-size:22px;line-height:1}
.share-preview{min-height:124px;margin-top:14px;padding:13px 14px;box-sizing:border-box;border-radius:16px}
.share-preview-copy{min-width:0}
.share-preview-small{font-size:10px;line-height:1.2}
.share-preview-title{margin-top:9px;font-size:13px;line-height:1.2}
.share-preview-days{margin-top:1px;font-size:38px;font-weight:800;line-height:1}
.share-preview-subtitle{margin-top:7px;font-size:10px;line-height:1.2}
.share-preview-qr{grid-template-columns:repeat(7, 7px);grid-template-rows:repeat(7, 7px);gap:1px;padding:6px;border-radius:7px}
.qr-cell{width:7px;height:7px}
.share-copy-line{margin-top:12px;font-size:13px;font-weight:650}
.share-actions{margin-top:14px}
.share-action{min-width:0;flex-direction:column;font-size:10px;line-height:1.2}
.share-native-button{top:0;left:0;width:100%;height:100%;padding:0;border:0;border-radius:0}
.share-native-button::after{border:0}
.share-action-icon{width:34px;height:34px;margin-bottom:5px;border-radius:50%;font-size:16px;font-weight:700}
.share-action-svg{width:72%;height:72%}
.share-action-save .share-action-svg{width:48%;height:48%}
.success-sheet-done{height:45px;margin-top:15px;border-radius:599px;font-size:14px;font-weight:700;line-height:45px}
.share-mask{top:0;right:max(0px, 50% - var(--lg-col) / 2);bottom:0;left:max(0px, 50% - var(--lg-col) / 2);box-shadow:0 0 0 100vmax rgba(25, 31, 28, .72)}
.share-poster-stage{top:0;right:0;bottom:219px;left:0;padding:25px 16px 12px;box-sizing:border-box}
.share-poster-card{flex:0 0 auto}
.share-poster-canvas{top:0;left:0;flex:0 0 auto}
.share-poster-export-canvas{top:-9999px;left:-9999px;width:1px;height:1px}
.share-sheet{right:0;bottom:0;left:0;padding:14px 22px calc(21px + env(safe-area-inset-bottom));box-sizing:border-box;border-radius:20px 20px 0 0}
.share-sheet-header{height:30px}
.share-sheet-title{font-size:15px;font-weight:750;line-height:1.2}
.share-sheet-close{top:7px;right:16px;padding:4px;font-size:22px;line-height:1}
.share-actions-compact{gap:15px;margin:14px auto 0}
.share-actions-compact .share-action{flex:0 0 76px;font-size:13px}
.share-actions-compact .share-action-icon{width:48px;height:48px;margin-bottom:9px}
.share-actions-compact .share-action-friend .share-action-svg, .share-actions-compact .share-action-timeline .share-action-svg{width:100%;height:100%}
.share-sheet-cancel{height:32px;margin-top:36px;font-size:14px;line-height:32px}
.card-mask{top:0;right:max(0px, 50% - var(--lg-col) / 2);bottom:0;left:max(0px, 50% - var(--lg-col) / 2);box-shadow:0 0 0 100vmax rgba(25, 31, 28, .5)}
.card-sheet{width:100%;padding:9px 20px calc(18px + env(safe-area-inset-bottom));box-sizing:border-box;border-radius:21px 21px 0 0}
.card-sheet-hero{margin-top:4px}
.card-sheet-icon-wrap{width:62px;height:62px;border-radius:18px;box-shadow:0 6px 14px rgba(47, 128, 216, .16)}
.card-sheet-revive .card-sheet-icon-wrap{box-shadow:0 6px 14px rgba(210, 63, 108, .16)}
.card-sheet-icon{width:46px;height:46px}
.card-sheet-copy{margin-left:13px}
.card-sheet-title{font-size:20px;font-weight:800}
.card-sheet-count{margin-top:3px;font-size:13px}
.card-sheet-desc{margin-top:13px;font-size:15px;line-height:1.5}
.card-sheet-plan{margin-top:12px;padding:13px 14px;border-radius:14px}
.card-sheet-plan-title{font-size:14px;font-weight:750}
.card-sheet-days{flex-wrap:wrap;gap:7px;margin-top:8px}
.card-sheet-day{min-width:57px;padding:7px 9px;flex-direction:column;box-sizing:border-box;border-radius:10px}
.card-sheet-day-date{font-size:15px;font-weight:800;line-height:1.2}
.card-sheet-day-week{margin-top:1px;font-size:11px}
.card-sheet-note{margin-top:8px;font-size:12px;line-height:1.45}
.card-sheet-reason{margin-top:12px;padding:12px 14px;border-radius:14px;font-size:14px;line-height:1.45}
.card-sheet-how{margin-top:12px}
.card-sheet-how-title{font-size:14px;font-weight:750}
.card-sheet-how-item{margin-top:4px;font-size:13px;line-height:1.45}
.card-sheet-actions{gap:8px;margin-top:18px}
.card-sheet-confirm{height:52px;border-radius:599px;font-size:16px;font-weight:750}
.card-sheet-cancel{height:43px;font-size:15px}
.card-effect{top:0;right:max(0px, 50% - var(--lg-col) / 2);bottom:0;left:max(0px, 50% - var(--lg-col) / 2)}
.card-effect-particle{top:-24px;width:13px;height:13px;border-radius:50%;box-shadow:0 0 7px rgba(124, 192, 245, .9)}
.card-effect-revive .card-effect-particle{top:auto;bottom:-24px;box-shadow:0 0 8px rgba(255, 110, 150, .9)}
.card-effect-particle-0{left:6%}
.card-effect-particle-1{left:14%;width:8px;height:8px}
.card-effect-particle-2{left:23%}
.card-effect-particle-3{left:31%;width:9px;height:9px}
.card-effect-particle-4{left:40%}
.card-effect-particle-5{left:48%;width:15px;height:15px}
.card-effect-particle-6{left:57%;width:8px;height:8px}
.card-effect-particle-7{left:65%}
.card-effect-particle-8{left:73%;width:10px;height:10px}
.card-effect-particle-9{left:81%}
.card-effect-particle-10{left:88%;width:8px;height:8px}
.card-effect-particle-11{left:95%}
@keyframes effect-snow{0%{opacity:0;transform:translate3d(0, 0, 0)}15%{opacity:1}100%{opacity:0;transform:translate3d(18px, 110vh, 0)}}
@keyframes effect-spark{0%{opacity:0;transform:translate3d(0, 0, 0) scale(.6)}20%{opacity:1}100%{opacity:0;transform:translate3d(-12px, -90vh, 0) scale(1.2)}}
.checkin-state{flex-direction:column;padding-left:28px;padding-right:28px}
.checkin-state-title{margin-top:120px;font-size:18px;font-weight:600}
.checkin-state-copy{margin-top:9px;font-size:15px;line-height:1.5}
.checkin-state-action{margin-top:19px;padding:9px 28px;border-radius:599px;font-size:15px}
.checkin-sk-stage{width:100%;border-radius:0 0 26px 26px}
.checkin-sk-hero{right:0;bottom:0;left:0;height:195px;padding:27px 30px 20px;box-sizing:border-box}
.checkin-sk-label{width:96px}
.checkin-sk-number{width:120px;height:62px;margin:9px 0 10px}
.checkin-sk-track{height:9px;margin:10px 0 8px;border-radius:599px}
.checkin-sk-month{width:132px;height:26px}
.checkin-sk-icon{flex:0 0 24px;width:24px;height:24px}
.checkin-sk-copy{flex:1}
.checkin-sk-value{width:48px;height:24px;margin-bottom:6px}
.checkin-sk-calendar{height:360px;margin-top:10px;border-radius:20px}
.checkin-sk-prop{width:74px;height:88px;border-radius:13px}
}
