/* 自动生成，请勿手改：index.wxss 在平板、电脑大屏（窗口宽 ≥ 450px）下的样式。
   rpx 按 1rpx = 0.6px 换算，固定定位元素收进居中栏；改完源文件后运行 node scripts/build-large-screen-styles.mjs */
@media (min-width: 450px) {
.sk{border-radius:7px}
.sk-line{height:16px}
.sk-line + .sk-line{margin-top:8px}
.sk-short{width:40%}
.sk-mid{width:64%}
.sk-round{border-radius:50%}
.sk-card{height:96px;border-radius:14px}
.sk-card + .sk-card{margin-top:12px}
page{height:100%}
.agent-page{top:0;right:max(0px, 50% - var(--lg-col) / 2);bottom:0;left:max(0px, 50% - var(--lg-col) / 2);width:min(100%, var(--lg-col));height:auto;box-shadow:0 0 0 100vmax #F9FAFF}
.agent-ambient{top:0;right:max(0px, 50% - var(--lg-col) / 2);bottom:0;left:max(0px, 50% - var(--lg-col) / 2)}
.agent-topbar{top:0;left:max(0px, 50% - var(--lg-col) / 2);width:min(100%, var(--lg-col));box-sizing:border-box}
.agent-topbar-inner{box-sizing:content-box;padding:0 21px 9px}
.agent-back-button{width:26px;height:26px;margin-right:6px}
.agent-back-icon{width:12px;height:12px;border-bottom:1px solid #24332D;border-left:1px solid #24332D;transform:rotate(45deg) scale(.72)}
.acc-topbar-heading{left:50%;max-width:56%;transform:translateX(-50%)}
.acc-topbar-title{max-width:100%;font-size:21px;font-weight:700;letter-spacing:-1px;line-height:1.2;text-overflow:ellipsis}
.acc-topbar-sub{max-width:100%;margin-top:1px;font-size:12px;line-height:1.3;text-overflow:ellipsis}
.agent-entry-gate{min-height:100%;padding:0 38px;box-sizing:border-box;text-align:center}
.agent-entry-gate-title{font-size:21px;font-weight:700}
.agent-entry-gate-copy{margin-top:10px;font-size:16px;line-height:1.6}
.agent-entry-gate-button{min-width:168px;height:52px;margin-top:28px;padding:0 28px;box-sizing:border-box;border-radius:26px;font-size:18px;font-weight:650}
.acc-welcome{height:100%;padding-right:28px;padding-left:28px;box-sizing:border-box}
.agent-welcome-avatar{width:150px;height:150px;margin-bottom:8px}
.agent-welcome-avatar-shape{width:124px;height:74px;border-radius:599px}
.agent-welcome-eye{top:24px;width:12px;height:26px;border-radius:599px;transform-origin:center}
.agent-welcome-eye-left{left:47px}
.agent-welcome-eye-right{left:79px}
.acc-welcome::-webkit-scrollbar{width:0;height:0}
.acc-welcome > .agent-welcome-avatar{margin-top:calc(15px + 30px)}
.acc-welcome > .agent-entry-gate-button{margin-bottom:48px}
.agent-welcome-title{max-width:390px;margin:0 18px;font-size:20px;font-weight:700;line-height:1.4;text-align:center}
.acc-welcome-copy{max-width:360px;margin-top:9px;font-size:15px;line-height:1.65;text-align:center}
.acc-steps{width:100%;max-width:360px;margin-top:21px;padding:6px 16px;box-sizing:border-box;border:0.5px solid #ECEFEC;border-radius:15px}
.acc-step{padding:10px 0;font-size:15px;line-height:1.5}
.acc-step + .acc-step{border-top:0.5px solid #F0F2F0}
.acc-step-mark{width:21px;height:21px;margin-right:10px;border-radius:50%;font-size:13px;font-weight:700}
.diagnosis-room-scroll{top:0;right:0;bottom:0;left:0;width:auto;height:auto;box-sizing:border-box}
.diagnosis-room-shell{padding:15px 18px 0;box-sizing:border-box}
.agent-message{width:100%;margin-bottom:16px}
.agent-message-column{min-width:0;max-width:88%}
.agent-message-user .agent-message-column{max-width:84%}
.agent-message-bubble{padding:10px 14px;box-sizing:border-box;border-radius:15px 15px 15px 4px}
.agent-message-assistant .agent-message-bubble{min-height:38px}
.agent-message-user .agent-message-bubble{padding:9px 14px;border-radius:16px 16px 4px 16px}
.agent-message-text{font-size:16px;line-height:1.62}
.diagnosis-room-bottom{height:9px}
.agent-typing-label{margin-left:9px;font-size:14px}
.typing-dots{height:14px}
.typing-dots view{width:6px;height:6px;margin:0 2px;border-radius:50%}
@keyframes agent-card-enter{from{opacity:0;transform:translate3d(0, 10px, 0) scale(.985)}to{opacity:1;transform:translate3d(0, 0, 0) scale(1)}}
@keyframes agent-dot-breathe{0%, 100%{opacity:.35;transform:translateY(0)}50%{opacity:1;transform:translateY(-3px)}}
.acc-result{margin:14px auto 4px;padding:16px 18px;max-width:360px;box-sizing:border-box;border-radius:15px;text-align:center}
.acc-result-title{font-size:16px;font-weight:700}
.acc-result-copy{margin-top:6px;font-size:13px;line-height:1.6}
.acc-result-topics{margin-top:12px}
.acc-result-topics-title{font-size:12px}
.acc-topic-list{margin-top:3px}
.acc-topic{margin:4px 3px 0;padding:4px 10px;border-radius:599px;font-size:13px}
.acc-result-points{margin-top:12px;text-align:left}
.acc-result-point{margin-top:6px;padding:8px 12px;border-radius:10px;font-size:14px;line-height:1.55}
.acc-result-button{margin:16px 0 0}
.acc-result-link{width:fit-content;margin:10px auto 0;padding:3px 7px;font-size:14px;font-weight:600}
.acc-skeleton{padding-right:18px;padding-left:18px;box-sizing:border-box}
.acc-skeleton-bubble{width:64%;height:67px;margin-top:16px;border-radius:15px}
.acc-skeleton-bubble.is-user{width:42%;height:43px}
.acc-skeleton-bubble.is-short{width:50%;height:52px}
.agent-composer{right:max(0px, 50% - var(--lg-col) / 2);bottom:52px;left:max(0px, 50% - var(--lg-col) / 2);padding:9px 16px 10px;box-sizing:border-box}
.agent-composer::after{right:0;bottom:-4px;left:0;height:4px}
.agent-composer-bar{min-height:62px;padding:3px 10px;box-sizing:border-box;border:0.5px solid #ECEFEC;border-radius:18px;box-shadow:0 4px 14px rgba(39, 52, 43, .06)}
.agent-composer-bar.is-input-active{border-color:#E4E8E4;box-shadow:0 4px 14px rgba(39, 52, 43, .09)}
.agent-composer-bar.is-voice-active{border-color:rgba(253, 124, 2, .52)}
.agent-input{min-width:0;height:50px;margin:0 8px;font-size:17px;line-height:50px}
.agent-voice-button, .agent-send-button{width:37px;height:37px;border-radius:50%}
.agent-voice-button.is-collapsing{width:0;margin-left:0;margin-right:0;transform:translateX(-15px)}
.agent-voice-icon{width:30px;height:30px}
.agent-voice-speak-button{height:50px;margin:0 8px;font-size:17px;font-weight:600;line-height:1}
.agent-send-icon{width:19px;height:19px}
.agent-composer-note-background{right:max(0px, 50% - var(--lg-col) / 2);bottom:0;left:max(0px, 50% - var(--lg-col) / 2);min-height:48px;padding-bottom:env(safe-area-inset-bottom);box-sizing:border-box}
.agent-composer-note{right:max(0px, 50% - var(--lg-col) / 2);bottom:0;left:max(0px, 50% - var(--lg-col) / 2);min-height:48px;padding:9px 16px calc(6px + env(safe-area-inset-bottom));box-sizing:border-box;font-size:10px;line-height:18px;text-align:center;transform:translateY(5px)}
.voice-demo-status{top:0;right:max(0px, 50% - var(--lg-col) / 2);bottom:0;left:max(0px, 50% - var(--lg-col) / 2);box-sizing:border-box;padding:0 20px calc(67px + env(safe-area-inset-bottom))}
.voice-demo-label{font-size:16px;font-weight:500;line-height:1.4;text-shadow:0 1px 4px rgba(20, 102, 190, .16)}
.voice-demo-status.is-canceling .voice-demo-label{text-shadow:none}
.voice-demo-wave{width:82%;height:45px;margin-top:34px}
.voice-demo-bar{min-width:1px;max-width:4px;height:calc(var(--bar-height, 4) * 600px / 1000);margin:0 1px;border-radius:599px;box-shadow:0 0 4px rgba(255, 255, 255, .14)}
.voice-demo-status.is-canceling .voice-demo-bar{box-shadow:0 0 4px rgba(255, 65, 65, .12)}
.agent-composer-note.rev-skip{text-decoration:underline}
.rev-choices{gap:10px;margin:3px 0 6px 16px}
.rev-choice{padding:8px 18px;border-radius:599px;font-size:15px;font-weight:600}
.rev-choice.is-secondary{font-weight:500}
}
