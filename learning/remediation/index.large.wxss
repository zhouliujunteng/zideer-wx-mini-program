/* 自动生成，请勿手改：index.wxss 在平板、电脑大屏（窗口宽 ≥ 450px）下的样式。
   rpx 按 1rpx = 0.6px 换算，固定定位元素收进居中栏；改完源文件后运行 node scripts/build-large-screen-styles.mjs */
@media (min-width: 450px) {
.surface{border-radius:14px}
.skeleton{border-radius:9px}
.state-panel{padding:72px 14px 24px}
.state-panel__mark{margin-bottom:14px;font-size:31px}
.state-panel__title{font-size:19px;font-weight:600}
.state-panel__copy{margin:13px 0 19px;font-size:15px;line-height:1.6}
.state-panel__action{border-radius:12px}
.state-panel__action::after{border:0}
.sk{border-radius:7px}
.sk-line{height:16px}
.sk-line + .sk-line{margin-top:8px}
.sk-short{width:40%}
.sk-mid{width:64%}
.sk-round{border-radius:50%}
.sk-card{height:96px;border-radius:14px}
.sk-card + .sk-card{margin-top:12px}
.remediation-page{min-height:100vh;padding:28px 16px calc(env(safe-area-inset-bottom) + 28px)}
.remediation-head{padding:0 4px}
.remediation-head__eyebrow{font-size:13px;font-weight:700}
.remediation-head__title{margin-top:7px;font-size:25px;font-weight:700;line-height:1.3}
.remediation-head__meta{margin-top:7px;font-size:12px}
.remediation-status{margin-top:20px;padding:16px}
.remediation-status__label{font-size:12px}
.remediation-status__value{margin-top:6px;font-size:17px;font-weight:700}
.remediation-status__copy{margin-top:7px;font-size:12px}
.remediation-section{margin-top:21px}
.remediation-section__title{margin:0 4px 9px;font-size:14px;font-weight:700}
.remediation-panel{padding:15px;font-size:13px;line-height:1.7}
.remediation-actions{grid-template-columns:repeat(2, minmax(0, 1fr));gap:9px;margin-top:26px}
.secondary-action, .primary-action{min-height:52px;padding:0 7px;border-radius:4px;font-size:13px}
.secondary-action{border:0.5px solid var(--line)}
.rem-sk-eyebrow{width:108px;height:13px}
.rem-sk-title{width:60%;height:31px;margin-top:8px}
.rem-sk-meta{margin-top:8px;height:13px}
.rem-sk-value{width:44%;height:21px;margin:8px 0}
.rem-sk-section{width:132px;margin:0 4px 9px}
}
