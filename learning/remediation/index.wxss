.remediation-page { min-height: 100vh; padding: 48rpx 28rpx calc(env(safe-area-inset-bottom) + 48rpx); }
.remediation-skeleton { height: 560rpx; }
.remediation-head { padding: 0 8rpx; }
.remediation-head__eyebrow { display: block; color: var(--accent-deep); font-size: 22rpx; font-weight: 700; }
.remediation-head__title { display: block; margin-top: 12rpx; font-size: 42rpx; font-weight: 700; line-height: 1.3; }
.remediation-head__meta { display: block; margin-top: 12rpx; color: var(--muted); font-size: 21rpx; }
.remediation-status { margin-top: 34rpx; padding: 28rpx; }
.remediation-status__label { display: block; color: var(--muted); font-size: 20rpx; }
.remediation-status__value { display: block; margin-top: 10rpx; color: var(--accent-deep); font-size: 29rpx; font-weight: 700; }
.remediation-status__copy { display: block; margin-top: 12rpx; color: var(--muted); font-size: 21rpx; }
.remediation-section { margin-top: 36rpx; }
.remediation-section__title { display: block; margin: 0 8rpx 16rpx; font-size: 24rpx; font-weight: 700; }
.remediation-panel { padding: 26rpx; color: var(--ink-soft); font-size: 23rpx; line-height: 1.7; }
.remediation-actions { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16rpx; margin-top: 44rpx; }
.secondary-action, .primary-action { min-height: 88rpx; padding: 0 12rpx; border-radius: 8rpx; font-size: 23rpx; }
.secondary-action { border: 1rpx solid var(--line); background: var(--surface); color: var(--ink); }
.primary-action { background: var(--accent); color: #fff; }
.primary-action--disabled { background: #D9DCE0; color: #777C83; }
