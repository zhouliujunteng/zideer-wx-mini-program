.schedule-page { min-height: 100vh; padding: 48rpx 28rpx calc(env(safe-area-inset-bottom) + 48rpx); }.schedule-skeleton { height: 560rpx; }.schedule-head { padding: 0 8rpx; }.schedule-eyebrow { display: block; color: var(--accent-deep); font-size: 22rpx; font-weight: 700; }.schedule-title { display: block; margin-top: 12rpx; font-size: 42rpx; font-weight: 700; line-height: 1.3; }.schedule-copy { display: block; margin-top: 12rpx; color: var(--muted); font-size: 22rpx; line-height: 1.55; }.schedule-list { overflow: hidden; margin-top: 34rpx; padding: 0 24rpx; }.session-row { display: flex; width: 100%; align-items: center; gap: 18rpx; padding: 28rpx 0; text-align: left; border-bottom: 1rpx solid var(--line); }.session-row:last-child { border-bottom: 0; }.session-time { width: 166rpx; flex: none; }.session-time__main, .session-time__duration, .session-copy__title, .session-copy__meta { display: block; }.session-time__main { font-size: 23rpx; font-weight: 700; line-height: 1.4; }.session-time__duration, .session-copy__meta { margin-top: 8rpx; color: var(--muted); font-size: 20rpx; line-height: 1.4; }.session-copy { min-width: 0; flex: 1; }.session-copy__title { font-size: 27rpx; font-weight: 700; }.session-arrow { color: var(--muted); font-size: 38rpx; }.schedule-empty { margin-top: 34rpx; padding: 32rpx; }.schedule-empty__title, .schedule-empty__copy { display: block; }.schedule-empty__title { font-size: 27rpx; font-weight: 700; }.schedule-empty__copy { margin-top: 12rpx; color: var(--muted); font-size: 22rpx; line-height: 1.55; }.schedule-empty__action { min-height: 72rpx; margin-top: 24rpx; color: var(--accent-deep); font-size: 23rpx; }.assignment-list { margin-top: 38rpx; }.assignment-title { display: block; margin: 0 8rpx 16rpx; font-size: 26rpx; font-weight: 700; }.assignment-row { display: flex; justify-content: space-between; gap: 24rpx; margin-top: 12rpx; padding: 24rpx; font-size: 23rpx; }.assignment-row text:last-child { color: var(--muted); text-align: right; }
