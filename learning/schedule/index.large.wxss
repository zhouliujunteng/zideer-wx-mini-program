/* 自动生成，请勿手改：index.wxss 在平板、电脑大屏（窗口宽 ≥ 450px）下的样式。
   rpx 按 1rpx = 0.6px 换算，固定定位元素收进居中栏；改完源文件后运行 node scripts/build-large-screen-styles.mjs */
@media (min-width: 450px) {
.surface{border-radius:14px}
.skeleton{border-radius:9px}
.state-panel{padding:72px 14px 24px}
.state-panel__mark{margin-bottom:14px;font-size:31px}
.state-panel__title{font-size:19px;font-weight:600}
.state-panel__copy{margin:13px 0 19px;font-size:15px;line-height:1.6}
.state-panel__action{border-radius:12px}
.state-panel__action::after{border:0}
.sk{border-radius:7px}
.sk-line{height:16px}
.sk-line + .sk-line{margin-top:8px}
.sk-short{width:40%}
.sk-mid{width:64%}
.sk-round{border-radius:50%}
.sk-card{height:96px;border-radius:14px}
.sk-card + .sk-card{margin-top:12px}
.schedule-page{min-height:100vh;padding:28px 16px calc(env(safe-area-inset-bottom) + 28px)}
.schedule-head{padding:0 4px}
.schedule-eyebrow{font-size:13px;font-weight:700}
.schedule-title{margin-top:7px;font-size:25px;font-weight:700;line-height:1.3}
.schedule-copy{margin-top:7px;font-size:13px;line-height:1.55}
.schedule-list{margin-top:20px;padding:0 14px}
.session-row{width:100%;gap:10px;padding:16px 0;border-bottom:0.5px solid var(--line)}
.session-row:last-child{border-bottom:0}
.session-time{width:99px}
.session-time__main{font-size:13px;font-weight:700;line-height:1.4}
.session-time__duration, .session-copy__meta{margin-top:4px;font-size:12px;line-height:1.4}
.session-copy{min-width:0}
.session-copy__title{font-size:16px;font-weight:700}
.session-arrow{font-size:22px}
.schedule-empty{margin-top:20px;padding:19px}
.schedule-empty__title{font-size:16px;font-weight:700}
.schedule-empty__copy{margin-top:7px;font-size:13px;line-height:1.55}
.schedule-empty__action{min-height:43px;margin-top:14px;font-size:13px}
.assignment-list{margin-top:22px}
.assignment-title{margin:0 4px 9px;font-size:15px;font-weight:700}
.assignment-row{gap:14px;margin-top:7px;padding:14px;font-size:13px}
}
