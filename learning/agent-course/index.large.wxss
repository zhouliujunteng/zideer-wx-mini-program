/* 自动生成，请勿手改：index.wxss 在平板、电脑大屏（窗口宽 ≥ 450px）下的样式。
   rpx 按 1rpx = 0.6px 换算，固定定位元素收进居中栏；改完源文件后运行 node scripts/build-large-screen-styles.mjs */
@media (min-width: 450px) {
.surface{border-radius:14px}
.skeleton{border-radius:9px}
.state-panel{padding:72px 14px 24px}
.state-panel__mark{margin-bottom:14px;font-size:31px}
.state-panel__title{font-size:19px;font-weight:600}
.state-panel__copy{margin:13px 0 19px;font-size:15px;line-height:1.6}
.state-panel__action{border-radius:12px}
.state-panel__action::after{border:0}
.sk{border-radius:7px}
.sk-line{height:16px}
.sk-line + .sk-line{margin-top:8px}
.sk-short{width:40%}
.sk-mid{width:64%}
.sk-round{border-radius:50%}
.sk-card{height:96px;border-radius:14px}
.sk-card + .sk-card{margin-top:12px}
.course-display-page{height:100vh}
.course-display-topbar{top:0;left:max(0px, 50% - var(--lg-col) / 2);width:min(100%, var(--lg-col));box-sizing:border-box}
.course-display-topbar-inner{box-sizing:content-box;padding:0 19px 9px}
.course-display-topbar-title{left:50%;font-size:20px;font-weight:700;letter-spacing:-1px}
.course-display-back{flex:0 0 auto;width:32px;height:32px;border-radius:50%}
.course-display-back-icon{width:13px;height:13px;border-bottom:2px solid #24332D;border-left:2px solid #24332D}
.course-refresh-loading{left:50%;padding:7px 10px;box-sizing:border-box;border-radius:599px;font-size:10px;line-height:1}
.course-refresh-spinner{width:12px;height:12px;margin-right:4px;box-sizing:border-box;border:1px solid #FFE4C4;border-top-color:#FD7C02;border-radius:50%}
.course-display-scroll{width:100%;height:100vh;box-sizing:border-box}
.course-display-shell{min-height:100%;padding:0 19px 138px;box-sizing:border-box}
.course-overview-card{min-width:0;margin-top:12px;padding:12px 13px 14px;box-sizing:border-box;flex-direction:column;border-radius:16px}
.course-cover-thumb{width:100%;height:243px;border-radius:12px}
.course-overview-copy{min-width:0;margin-top:13px;padding:0 1px;box-sizing:border-box;flex-direction:column}
.course-title{font-size:18px;font-weight:750;letter-spacing:-1px;line-height:1.25;-webkit-box-orient:vertical;-webkit-line-clamp:2}
.course-subtitle{margin-top:4px;font-size:12px;line-height:1.35}
.course-pill-row{min-width:0;margin-top:8px;gap:4px}
.course-pill{max-width:32%;padding:4px 7px;border-radius:599px;font-size:10px;line-height:1.2}
.course-mini-progress{width:auto;max-width:100%;margin-top:13px}
.course-mini-progress-head{font-size:10px;line-height:1.25}
.course-mini-progress-head text:last-child{font-weight:700}
.course-mini-progress-track{height:10px;margin-top:4px;border-radius:599px}
.course-mini-progress-fill{height:100%;border-radius:inherit}
.course-review-section, .course-pages-section{margin-top:19px}
.course-section-head{padding:0 2px}
.course-section-title{font-size:16px;font-weight:700;line-height:1.3}
.course-section-meta{font-size:12px}
.course-review-card{min-height:88px;margin-top:9px;padding:14px;box-sizing:border-box;border-radius:16px}
.course-review-tile{flex:0 0 52px;width:52px;height:52px;border-radius:15px}
.course-review-card.is-talk .course-review-tile, .course-review-card.is-passed .course-review-tile{box-shadow:0 6px 14px rgba(253, 124, 2, .26)}
.course-review-copy{min-width:0;flex:1;margin-left:13px}
.course-review-title{font-size:16px;font-weight:700;line-height:1.3}
.course-review-text{margin-top:4px;font-size:12px;line-height:1.45;-webkit-box-orient:vertical;-webkit-line-clamp:2}
.course-review-ring{flex:0 0 auto;width:48px;height:48px;margin-left:10px;border-radius:50%}
.course-review-ring__inner{width:37px;height:37px;border-radius:50%}
.course-review-ring__inner text{font-size:11px;font-weight:700}
.course-review-cta{flex:0 0 auto;margin-left:10px;padding:0 15px;border-radius:599px;font-size:14px;font-weight:650;line-height:36px}
.course-review-cta.is-primary{box-shadow:0 4px 10px rgba(253, 124, 2, .24)}
.review-glyph{box-sizing:border-box}
.review-glyph--lock{flex-direction:column}
.review-glyph__shackle{width:15px;height:10px;box-sizing:border-box;border:3px solid #B4AEA5;border-bottom:0;border-radius:8px 8px 0 0}
.review-glyph__body{width:22px;height:16px;border-radius:4px}
.review-glyph__body::after{top:5px;left:9px;width:3px;height:6px;border-radius:1px}
.review-glyph--talk{width:27px;height:20px;border-radius:8px}
.review-glyph--talk::after{bottom:-5px;left:4px;width:0;height:0;border-top:6px solid #FFFFFF;border-right:6px solid transparent}
.review-glyph__dot{width:3px;height:3px;margin:0 1px;border-radius:50%}
.review-glyph--clock{width:25px;height:25px;border:3px solid #FD7C02;border-radius:50%}
.review-glyph--clock::before{bottom:50%;left:50%;width:2px;height:7px;margin-left:-2px;border-radius:1px}
.review-glyph--clock::after{top:50%;left:50%;width:6px;height:2px;margin-top:-2px;margin-left:-2px;border-radius:1px}
.review-glyph--check{width:20px;height:10px;margin-top:-5px;border-bottom:3px solid #FFFFFF;border-left:3px solid #FFFFFF;border-radius:1px}
.course-test-finish{min-height:52px;margin-top:9px;padding:0 14px;box-sizing:border-box;border:1px dashed rgba(253, 124, 2, .55);border-radius:16px}
.course-test-finish__tag{margin-right:7px;padding:3px 7px;border-radius:599px;font-size:12px;font-weight:650;line-height:1}
.course-test-finish__label{font-size:15px;font-weight:650}
.course-steps{margin-top:9px;padding:3px 14px;border-radius:16px}
.course-step__rail{flex:0 0 28px;flex-direction:column}
.course-step__line{flex:1;width:1px;min-height:7px;border-radius:1px}
.course-step__line--top{flex:0 0 14px;min-height:0}
.course-step__node{flex:0 0 auto;width:28px;height:28px;box-sizing:border-box;border-radius:50%;font-size:12px;font-weight:700}
.course-steps.is-ready .course-step.learn-in_progress .course-step__node, .course-steps.is-ready .course-step.is-next .course-step__node{border:2px solid #FD7C02}
.course-step__check{width:10px;height:5px;margin-top:-3px;border-bottom:2px solid #FFFFFF;border-left:2px solid #FFFFFF}
.course-step__main{flex:1;min-width:0;margin-left:12px}
.course-step + .course-step .course-step__main{border-top:0.5px solid #F3F1EE}
.course-step__body{flex:1;min-width:0;padding:15px 0 14px}
.course-step__title{font-size:15px;font-weight:650;line-height:1.4;-webkit-box-orient:vertical;-webkit-line-clamp:2}
.course-step__meta{margin-top:6px}
.course-step__type{padding:2px 7px;border-radius:4px;font-size:11px;line-height:1.4}
.course-step__state{flex:0 0 auto;min-height:28px;margin-top:14px;margin-left:9px}
.course-step__label{font-size:12px}
.course-step.learn-in_progress .course-step__label{padding:3px 8px;border-radius:599px;font-weight:650}
.course-step.is-next.learn-not_started .course-step__label{font-weight:650}
.course-step__chevron{width:7px;height:7px;margin-left:6px;border-top:1px solid #C4C9C5;border-right:1px solid #C4C9C5}
.course-page-spinner{width:12px;height:12px;box-sizing:border-box;border:1px solid #FFE0BF;border-top-color:#FD7C02;border-radius:50%}
.course-pages-note{margin:8px 2px 0;font-size:12px;line-height:1.5}
.course-stale{margin-top:12px;font-size:12px}
.course-bottom-bar{right:max(0px, 50% - var(--lg-col) / 2);bottom:0;left:max(0px, 50% - var(--lg-col) / 2);padding:10px 16px calc(13px + env(safe-area-inset-bottom))}
.course-bottom-inner{width:100%}
.course-primary-button{flex:0 0 52%;height:57px;box-sizing:border-box;border:0;border-radius:599px;font-size:16px;font-weight:650;line-height:57px}
.cd-sk-title{width:80%;height:21px}
.cd-sk-subtitle{width:40%;height:13px;margin-top:7px}
.cd-sk-pill{width:57px;height:19px;border-radius:599px}
.cd-sk-track{height:10px;margin-top:6px;border-radius:599px}
.cd-sk-gap{margin-top:7px}
.course-cover-thumb.sk{border-radius:12px}
.course-primary-button.sk{border-radius:599px}
.course-mini-progress .sk-line{height:12px}
.primary-action, .secondary-action{width:100%;min-height:52px;margin:0;border-radius:599px;font-size:16px}
.primary-action::after, .secondary-action::after{border:0}
.primary-action{font-weight:600}
.secondary-action{margin-top:10px;border:0.5px solid #E9EEE9}
}
