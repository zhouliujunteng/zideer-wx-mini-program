.agent-course-page {
  --brand: #FD7C02;
  --brand-soft: #FFF0DF;
  --ink: #2F3B33;
  --muted: #7A847D;
  --line: #E9EEE9;
  min-height: 100vh;
  box-sizing: border-box;
  padding: 40rpx 32rpx calc(env(safe-area-inset-bottom) + 48rpx);
  background: #F7F9F7;
  color: var(--ink);
}
.agent-course-skeleton { height: 520rpx; border-radius: 28rpx; background: #E9EEE9; }
.agent-course-head { padding: 0 8rpx; }
.agent-course-eyebrow { display: block; color: #B25A00; font-size: 22rpx; font-weight: 600; }
.agent-course-title { display: block; margin-top: 10rpx; font-size: 40rpx; font-weight: 700; line-height: 1.4; overflow-wrap: anywhere; }

.agent-course-progress { display: flex; align-items: center; margin-top: 32rpx; padding: 32rpx 28rpx; border: 1rpx solid var(--line); border-radius: 28rpx; background: #FFFFFF; }
.agent-course-ring { display: flex; flex: 0 0 auto; align-items: center; justify-content: center; width: 168rpx; height: 168rpx; border-radius: 50%; transition: background 0.4s ease; }
.agent-course-ring__inner { display: flex; align-items: center; justify-content: center; width: 132rpx; height: 132rpx; border-radius: 50%; background: #FFFFFF; }
.agent-course-ring__value { font-size: 40rpx; font-weight: 700; }
.agent-course-ring__unit { margin-left: 2rpx; font-size: 22rpx; font-weight: 600; }
.agent-course-progress__copy { flex: 1; min-width: 0; margin-left: 28rpx; }
.agent-course-status { display: flex; align-items: center; font-size: 28rpx; font-weight: 700; }
.agent-course-status__dot { width: 14rpx; height: 14rpx; margin-right: 12rpx; border-radius: 50%; background: #3F9A64; }
.agent-course-progress--generating .agent-course-status__dot { background: var(--brand); }
.agent-course-progress--partial .agent-course-status__dot { background: #E0A000; }
.agent-course-progress--failed .agent-course-status__dot { background: #D6574B; }
.agent-course-status__dot.is-live { animation: agent-course-pulse 1.4s ease-in-out infinite; }
.agent-course-summary { display: block; margin-top: 10rpx; font-size: 25rpx; line-height: 1.6; }
.agent-course-note { display: block; margin-top: 10rpx; color: var(--muted); font-size: 22rpx; line-height: 1.6; }

.agent-course-pages { margin-top: 24rpx; border: 1rpx solid var(--line); border-radius: 28rpx; background: #FFFFFF; overflow: hidden; }
.agent-course-page-row { display: flex; align-items: center; padding: 24rpx 28rpx; border-top: 1rpx solid var(--line); }
.agent-course-page-row:first-child { border-top: 0; }
.agent-course-page-row__index { display: flex; flex: 0 0 auto; align-items: center; justify-content: center; width: 48rpx; height: 48rpx; border-radius: 50%; background: #F1F4F1; color: var(--muted); font-size: 22rpx; font-weight: 600; }
.agent-course-page-row.is-done .agent-course-page-row__index { background: #E3F3E9; color: #2F7A4F; }
.agent-course-page-row.is-generating .agent-course-page-row__index { background: var(--brand-soft); color: #B25A00; }
.agent-course-page-row.is-failed .agent-course-page-row__index { background: #FBE7E5; color: #B43D35; }
.agent-course-page-row__body { flex: 1; min-width: 0; margin-left: 20rpx; }
.agent-course-page-row__title { display: block; overflow: hidden; font-size: 26rpx; white-space: nowrap; text-overflow: ellipsis; }
.agent-course-page-row__type { display: block; margin-top: 4rpx; color: var(--muted); font-size: 21rpx; }
.agent-course-page-row__state { display: flex; flex: 0 0 auto; align-items: center; margin-left: 16rpx; color: var(--muted); font-size: 22rpx; }
.agent-course-page-row.is-done .agent-course-page-row__state { color: #2F7A4F; }
.agent-course-page-row.is-generating .agent-course-page-row__state { color: #B25A00; }
.agent-course-page-row.is-failed .agent-course-page-row__state { color: #B43D35; }
.agent-course-spinner { width: 22rpx; height: 22rpx; margin-right: 10rpx; border: 3rpx solid rgba(253, 124, 2, 0.25); border-top-color: var(--brand); border-radius: 50%; animation: agent-course-spin 0.9s linear infinite; }

.agent-course-stale { display: block; margin-top: 20rpx; color: var(--muted); font-size: 22rpx; text-align: center; }
.agent-course-actions { display: flex; flex-direction: column; gap: 18rpx; margin-top: 36rpx; }
.primary-action, .secondary-action { display: flex; align-items: center; justify-content: center; width: 100%; min-height: 88rpx; margin: 0; border-radius: 999rpx; font-size: 28rpx; }
.primary-action::after, .secondary-action::after { border: 0; }
.primary-action { background: var(--brand); color: #FFFFFF; font-weight: 600; }
.primary-action--disabled, .primary-action[disabled] { background: #E4E8E4 !important; color: #8A938C !important; }
.secondary-action { border: 1rpx solid var(--line); background: #FFFFFF; color: var(--ink); }

.state-panel { padding: 80rpx 16rpx; text-align: center; }
.state-panel__mark { margin-bottom: 24rpx; color: #B43D35; font-size: 40rpx; font-weight: 700; }
.state-panel__title, .state-panel__copy { display: block; }
.state-panel__title { font-size: 32rpx; font-weight: 600; }
.state-panel__copy { margin: 20rpx 0 36rpx; color: var(--muted); font-size: 26rpx; line-height: 1.7; }
.state-panel .secondary-action { margin-top: 18rpx; }

@keyframes agent-course-spin { to { transform: rotate(360deg); } }
@keyframes agent-course-pulse { 0%, 100% { opacity: 1; } 50% { opacity: 0.35; } }
