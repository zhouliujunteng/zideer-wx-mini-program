.topic-page { min-height: 100vh; padding: 0 28rpx calc(env(safe-area-inset-bottom) + 44rpx); }.topic-page__inner { padding-top: 54rpx; }.topic-page__head { padding: 0 8rpx; }.topic-page__eyebrow { display: block; color: var(--accent-deep); font-size: 22rpx; font-weight: 700; }.topic-page__title { display: block; margin-top: 12rpx; font-size: 42rpx; font-weight: 700; line-height: 1.28; }.topic-page__status { display: block; margin-top: 12rpx; color: var(--muted); font-size: 23rpx; }.topic-page__status--mastered { color: var(--green); }.topic-page__status--learning { color: var(--accent-deep); }.topic-page__status--weak { color: var(--yellow); }.topic-page__details { margin-top: 42rpx; padding: 0 26rpx; }.topic-page__row { display: flex; min-height: 108rpx; align-items: center; justify-content: space-between; gap: 24rpx; border-bottom: 1rpx solid var(--line); font-size: 24rpx; line-height: 1.5; }.topic-page__row:last-child { border-bottom: 0; }.topic-page__row text:first-child { flex: none; color: var(--muted); }.topic-page__row text:last-child { min-width: 0; text-align: right; }.topic-page__candidate { margin: 28rpx 8rpx; }.topic-page__candidate-copy { display: block; margin-bottom: 16rpx; color: var(--muted); font-size: 22rpx; line-height: 1.55; }.topic-page__candidate-action { width: 100%; min-height: 88rpx; border-radius: 12rpx; background: var(--ink); color: var(--surface); font-size: 28rpx; font-weight: 700; }.topic-page__candidate-action[disabled] { background: var(--line-strong); }.topic-page__skeleton { height: 360rpx; border-radius: 18rpx; }
