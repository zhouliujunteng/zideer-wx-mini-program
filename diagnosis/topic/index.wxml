<view class="screen topic-page"><view class="topic-page__inner"><view class="skeleton topic-page__skeleton" wx:if="{{loading}}"></view><view class="state-panel" wx:elif="{{failed}}"><view class="state-panel__mark">!</view><text class="state-panel__title">知识点详情没有加载出来</text><text class="state-panel__copy">请返回知识图谱重新选择知识点。</text></view><block wx:else><view class="topic-page__head"><text class="topic-page__eyebrow">知识点</text><text class="topic-page__title">{{topic.label}}</text><text class="topic-page__status topic-page__status--{{topic.status}}">{{topic.statusLabel}}</text></view><view class="topic-page__details surface"><view class="topic-page__row"><text>掌握依据</text><text>{{topic.evidence}}</text></view><view class="topic-page__row"><text>前置知识</text><text>{{topic.prerequisites}}</text></view><view class="topic-page__row"><text>图谱核心度</text><text>{{topic.contribution}}</text></view></view><view class="topic-page__candidate"><text class="topic-page__candidate-copy" wx:if="{{candidateStatus === 'profile_incomplete'}}">完善学习档案后，可将知识点加入候选。</text><text class="topic-page__candidate-copy" wx:elif="{{candidateStatus === 'unavailable'}}">候选状态暂时无法读取，请稍后重试。</text><button class="topic-page__candidate-action pressable" loading="{{candidateSubmitting}}" disabled="{{candidateStatus === 'loading' || candidateStatus === 'unavailable'}}" bindtap="toggleCandidate">{{candidateActive ? '移出候选' : '加入候选'}}</button></view></block></view></view>
