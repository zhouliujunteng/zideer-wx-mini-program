<view class="screen topic-page"><view class="topic-page__inner">
  <view class="skeleton topic-page__skeleton" wx:if="{{loading}}"></view>
  <view class="state-panel" wx:elif="{{failed}}"><view class="state-panel__mark">!</view><text class="state-panel__title">知识点详情没有加载出来</text><text class="state-panel__copy">请返回知识图谱重新选择知识点。</text></view>
  <block wx:else>
    <view class="topic-page__section surface"><text class="topic-page__section-title">诊断掌握状态</text><text class="topic-page__copy" wx:if="{{assessmentError}}">测评数据暂时无法读取，请重新进入此页重试。</text><block wx:else><text class="topic-page__copy">最近测评：{{assessmentStatus}}</text><text class="topic-page__copy" wx:if="{{!states.length}}">尚未测到此知识点。</text><view wx:for="{{states}}" wx:key="attemptId"><text class="topic-page__copy">{{item.scopeName || '诊断记录'}} · {{item.dateLabel}}</text><text class="topic-page__copy">{{item.stateLabel}} · 答对 {{item.rateLabel}}</text></view></block></view>
    <view class="topic-page__head"><text class="topic-page__eyebrow">{{topic.gradeLabel}} · {{topic.subjectName}}</text><text class="topic-page__title">{{topic.label}}</text><text class="topic-page__status">{{topic.volume}} · {{topic.unit}}</text></view>
    <view class="topic-page__section surface"><text class="topic-page__section-title">知识说明</text><text class="topic-page__copy">{{topic.description || '来源暂未提供说明'}}</text></view>
    <view class="topic-page__section surface"><text class="topic-page__section-title">掌握标准</text><text class="topic-page__copy">{{topic.masteryStandard || '来源暂未提供掌握标准'}}</text></view>
    <view class="topic-page__section surface"><text class="topic-page__section-title">前置知识</text><text class="topic-page__copy" wx:if="{{!topic.prerequisiteLinks.length}}">来源未列出前置知识</text><view wx:for="{{topic.prerequisiteLinks}}" wx:key="id" class="topic-page__link" data-id="{{item.id}}" bindtap="openRelatedTopic"><text>{{item.label}} · {{item.gradeLabel}} ›</text><text class="topic-page__link-reason">{{item.reason}}</text></view></view>
    <view class="topic-page__section surface"><text class="topic-page__section-title">后续知识</text><text class="topic-page__copy" wx:if="{{!topic.successorLinks.length}}">来源未列出后续知识</text><view wx:for="{{topic.successorLinks}}" wx:key="id" class="topic-page__link" data-id="{{item.id}}" bindtap="openRelatedTopic"><text>{{item.label}} · {{item.gradeLabel}} ›</text><text class="topic-page__link-reason">{{item.reason}}</text></view></view>
    <view class="topic-page__section surface" wx:if="{{topic.relatedLinks.length}}"><text class="topic-page__section-title">相关知识</text><view wx:for="{{topic.relatedLinks}}" wx:key="id" class="topic-page__link" data-id="{{item.id}}" bindtap="openRelatedTopic"><text>{{item.label}} · {{item.gradeLabel}} ›</text><text class="topic-page__link-reason">{{item.reason}}</text></view></view>
    <view class="topic-page__section surface"><text class="topic-page__section-title">我的掌握证据</text><text class="topic-page__copy">{{topic.evidence}}</text><view wx:for="{{topic.evidenceRecords}}" wx:key="id" class="topic-page__copy"><text>{{item.summary}}</text></view></view>
    <view class="topic-page__candidate"><text class="topic-page__candidate-copy" wx:if="{{candidateStatus === 'profile_incomplete'}}">完善学习档案后，可将知识点加入候选。</text><text class="topic-page__candidate-copy" wx:elif="{{candidateStatus === 'unavailable'}}">候选状态暂时无法读取，请稍后重试。</text><button class="topic-page__candidate-action pressable" loading="{{candidateSubmitting}}" disabled="{{candidateStatus === 'loading' || candidateStatus === 'unavailable'}}" bindtap="toggleCandidate">{{candidateActive ? '移出候选' : '加入候选'}}</button></view>
  </block>
</view></view>
<dev-reset-fab />
