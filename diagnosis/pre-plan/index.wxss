.pre-plan { min-height: 100vh; padding: 0 28rpx calc(env(safe-area-inset-bottom) + 44rpx); }.pre-plan__inner { padding-top: 54rpx; }.pre-plan__head { padding: 0 8rpx; }.pre-plan__eyebrow { display: block; color: var(--accent-deep); font-size: 22rpx; font-weight: 700; }.pre-plan__title { display: block; margin-top: 12rpx; font-size: 42rpx; font-weight: 700; }.pre-plan__copy { display: block; margin-top: 14rpx; color: var(--muted); font-size: 23rpx; line-height: 1.55; }.pre-plan__empty { margin-top: 42rpx; padding: 30rpx 26rpx; }.pre-plan__empty-title { display: block; font-size: 28rpx; font-weight: 700; }.pre-plan__empty-copy { display: block; margin-top: 12rpx; color: var(--muted); font-size: 22rpx; line-height: 1.6; }.pre-plan__list { margin-top: 42rpx; padding: 0 26rpx; }.pre-plan__item { display: flex; min-height: 110rpx; align-items: center; justify-content: space-between; gap: 20rpx; border-bottom: 1rpx solid var(--line); }.pre-plan__item:last-child { border-bottom: 0; }.pre-plan__topic, .pre-plan__reason { display: block; }.pre-plan__topic { font-size: 26rpx; font-weight: 700; }.pre-plan__reason { margin-top: 8rpx; color: var(--muted); font-size: 21rpx; line-height: 1.45; }.pre-plan__quote { flex: none; color: var(--muted); font-size: 21rpx; }.pre-plan__notice { display: block; margin: 26rpx 8rpx 0; color: var(--muted); font-size: 21rpx; line-height: 1.55; }.pre-plan__action { width: 100%; min-height: 78rpx; margin-top: 26rpx; border: 1rpx solid var(--line-strong); border-radius: 8rpx; background: var(--surface); font-size: 25rpx; font-weight: 700; }.pre-plan__action--primary { margin-top: 34rpx; border-color: var(--accent-deep); background: var(--accent-deep); color: #fff; }.pre-plan__skeleton { height: 420rpx; border-radius: 18rpx; }
