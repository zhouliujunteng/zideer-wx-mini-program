/* 自动生成，请勿手改：index.wxss 在平板、电脑大屏（窗口宽 ≥ 450px）下的样式。
   rpx 按 1rpx = 0.6px 换算，固定定位元素收进居中栏；改完源文件后运行 node scripts/build-large-screen-styles.mjs */
@media (min-width: 450px) {
.surface{border-radius:14px}
.skeleton{border-radius:9px}
.state-panel{padding:72px 14px 24px}
.state-panel__mark{margin-bottom:14px;font-size:31px}
.state-panel__title{font-size:19px;font-weight:600}
.state-panel__copy{margin:13px 0 19px;font-size:15px;line-height:1.6}
.state-panel__action{border-radius:12px}
.state-panel__action::after{border:0}
.sk{border-radius:7px}
.sk-line{height:16px}
.sk-line + .sk-line{margin-top:8px}
.sk-short{width:40%}
.sk-mid{width:64%}
.sk-round{border-radius:50%}
.sk-card{height:96px;border-radius:14px}
.sk-card + .sk-card{margin-top:12px}
.pre-plan{min-height:100vh;padding:0 16px calc(env(safe-area-inset-bottom) + 26px)}
.pre-plan__inner{padding-top:32px}
.pre-plan__head{padding:0 4px}
.pre-plan__eyebrow{font-size:13px;font-weight:700}
.pre-plan__title{margin-top:7px;font-size:25px;font-weight:700}
.pre-plan__copy{margin-top:8px;font-size:13px;line-height:1.55}
.pre-plan__empty{margin-top:25px;padding:18px 15px}
.pre-plan__empty-title{font-size:16px;font-weight:700}
.pre-plan__empty-copy{margin-top:7px;font-size:13px;line-height:1.6}
.pre-plan__list{margin-top:25px;padding:0 15px}
.pre-plan__item{min-height:66px;gap:12px;border-bottom:0.5px solid var(--line)}
.pre-plan__item:last-child{border-bottom:0}
.pre-plan__topic{font-size:15px;font-weight:700}
.pre-plan__reason{margin-top:4px;font-size:12px;line-height:1.45}
.pre-plan__quote{font-size:12px}
.pre-plan__notice{margin:15px 4px 0;font-size:12px;line-height:1.55}
.pre-plan__action{width:100%;min-height:46px;margin-top:15px;border:0.5px solid var(--line-strong);border-radius:4px;font-size:15px;font-weight:700}
.pre-plan__action--primary{margin-top:20px;border-color:var(--accent-deep)}
.pre-plan__reason-sk{width:84%;height:12px}
}
