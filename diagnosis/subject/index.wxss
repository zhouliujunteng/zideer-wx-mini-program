.subject-diagnosis { min-height: 100vh; padding: 0 28rpx calc(env(safe-area-inset-bottom) + 44rpx); }.subject-diagnosis__inner { padding-top: 54rpx; }.subject-diagnosis__head { padding: 0 8rpx; }.subject-diagnosis__eyebrow { display: block; color: var(--accent-deep); font-size: 22rpx; font-weight: 700; }.subject-diagnosis__title { display: block; margin-top: 12rpx; font-size: 42rpx; font-weight: 700; }.subject-diagnosis__empty { margin-top: 42rpx; padding: 30rpx 26rpx; color: var(--muted); font-size: 24rpx; line-height: 1.55; }.subject-section { margin-top: 40rpx; }.subject-list { margin-top: 16rpx; padding: 0 24rpx; }.subject-list__row { display: flex; min-height: 94rpx; align-items: center; justify-content: space-between; gap: 22rpx; border-bottom: 1rpx solid var(--line); font-size: 24rpx; }.subject-list__row:last-child { border-bottom: 0; }.subject-list__row text:last-child { color: var(--muted); font-size: 21rpx; text-align: right; }.subject-diagnosis__skeleton { height: 420rpx; border-radius: 18rpx; }
