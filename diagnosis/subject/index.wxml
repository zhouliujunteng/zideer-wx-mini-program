<view class="screen subject-diagnosis"><view class="subject-diagnosis__inner"><view class="skeleton subject-diagnosis__skeleton" wx:if="{{loading}}"></view><view class="state-panel" wx:elif="{{failed}}"><view class="state-panel__mark">!</view><text class="state-panel__title">学科诊断没有加载出来</text><button class="state-panel__action pressable" bindtap="loadPage">重新加载</button></view><block wx:else><view class="subject-diagnosis__head"><text class="subject-diagnosis__eyebrow">学科诊断</text><text class="subject-diagnosis__title">{{subjectName}}</text></view><view class="subject-diagnosis__empty surface" wx:if="{{!weakTopics.length && !errorTypes.length && !domains.length}}"><text>当前没有足够的已生成诊断数据。</text></view><view class="subject-section" wx:if="{{domains.length}}"><text class="section-title">领域分布</text><view class="subject-list surface"><view class="subject-list__row" wx:for="{{domains}}" wx:key="index"><text>{{item.name || item.domain || '未命名领域'}}</text><text>{{item.score || item.value || '待评估'}}</text></view></view></view><view class="subject-section" wx:if="{{errorTypes.length}}"><text class="section-title">错误类型</text><view class="subject-list surface"><view class="subject-list__row" wx:for="{{errorTypes}}" wx:key="index"><text>{{item.name || item.type || item}}</text><text wx:if="{{item.count}}">{{item.count}} 次</text></view></view></view><view class="subject-section" wx:if="{{weakTopics.length}}"><text class="section-title">薄弱知识点</text><view class="subject-list surface"><view class="subject-list__row" wx:for="{{weakTopics}}" wx:key="index"><text>{{item.name}}</text><text>{{item.reason || '待补齐'}}</text></view></view></view></block></view></view>
