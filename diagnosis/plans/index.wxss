.plans-page { min-height: 100vh; padding: 0 28rpx calc(env(safe-area-inset-bottom) + 44rpx); }.plans-page__inner { padding-top: 54rpx; }.plans-page__head { padding: 0 8rpx; }.plans-page__eyebrow { display: block; color: var(--accent-deep); font-size: 22rpx; font-weight: 700; }.plans-page__title-row { display: flex; align-items: center; justify-content: space-between; gap: 22rpx; margin-top: 12rpx; }.plans-page__title { display: block; min-width: 0; font-size: 42rpx; font-weight: 700; }.plans-page__create { flex: none; min-height: 62rpx; padding: 0 20rpx; border-radius: 8rpx; background: var(--accent-deep); color: #fff; font-size: 22rpx; font-weight: 700; }.plans-empty { margin-top: 42rpx; padding: 30rpx 26rpx; }.plans-empty__title { display: block; font-size: 28rpx; font-weight: 700; }.plans-empty__copy { display: block; margin-top: 12rpx; color: var(--muted); font-size: 22rpx; line-height: 1.6; }.plans-empty__action { width: 100%; min-height: 78rpx; margin-top: 26rpx; border-radius: 8rpx; background: var(--accent-deep); color: #fff; font-size: 25rpx; font-weight: 700; }.plan-card { display: flex; width: 100%; min-height: 126rpx; align-items: center; justify-content: space-between; margin-top: 18rpx; padding: 0 26rpx; text-align: left; }.plan-card__name, .plan-card__meta { display: block; }.plan-card__name { font-size: 27rpx; font-weight: 700; }.plan-card__meta { margin-top: 9rpx; color: var(--muted); font-size: 21rpx; }.plan-card__side { display: flex; align-items: center; gap: 14rpx; color: var(--muted); font-size: 22rpx; }.plans-page__skeleton { height: 360rpx; border-radius: 18rpx; }
