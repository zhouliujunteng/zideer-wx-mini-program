<view class="screen plans-page"><view class="plans-page__inner"><view class="skeleton plans-page__skeleton" wx:if="{{loading}}"></view><view class="state-panel" wx:elif="{{failed}}"><view class="state-panel__mark">!</view><text class="state-panel__title">学习计划没有加载出来</text><button class="state-panel__action pressable" bindtap="loadPage">重新加载</button></view><block wx:else><view class="plans-page__head"><text class="plans-page__eyebrow">学习路径</text><view class="plans-page__title-row"><text class="plans-page__title">学习计划</text><button class="plans-page__create pressable" bindtap="createPlan">生成计划</button></view></view><view class="plans-empty surface" wx:if="{{!plans.length}}"><text class="plans-empty__title">还没有学习计划</text><text class="plans-empty__copy">完成诊断后，系统会结合薄弱知识点和你的学习约束生成计划。</text><button class="plans-empty__action pressable" bindtap="createPlan">开始规划</button></view><view class="plans-list" wx:else><button class="plan-card surface pressable" wx:for="{{plans}}" wx:key="id" data-id="{{item.id}}" bindtap="openPlan"><view><text class="plan-card__name">{{item.name}}</text><text class="plan-card__meta">{{item.statusLabel}} · {{item.itemCount}} 个学习任务</text></view><view class="plan-card__side"><text wx:if="{{item.plannedCredits !== null}}">{{item.plannedCredits}} 积分</text><text>›</text></view></button></view></block></view></view>
