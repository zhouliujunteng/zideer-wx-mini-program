/* 自动生成，请勿手改：index.wxss 在平板、电脑大屏（窗口宽 ≥ 450px）下的样式。
   rpx 按 1rpx = 0.6px 换算，固定定位元素收进居中栏；改完源文件后运行 node scripts/build-large-screen-styles.mjs */
@media (min-width: 450px) {
.surface{border-radius:14px}
.skeleton{border-radius:9px}
.state-panel{padding:72px 14px 24px}
.state-panel__mark{margin-bottom:14px;font-size:31px}
.state-panel__title{font-size:19px;font-weight:600}
.state-panel__copy{margin:13px 0 19px;font-size:15px;line-height:1.6}
.state-panel__action{border-radius:12px}
.state-panel__action::after{border:0}
.sk{border-radius:7px}
.sk-line{height:16px}
.sk-line + .sk-line{margin-top:8px}
.sk-short{width:40%}
.sk-mid{width:64%}
.sk-round{border-radius:50%}
.sk-card{height:96px;border-radius:14px}
.sk-card + .sk-card{margin-top:12px}
.diagnosis-report{min-height:100vh;padding:0 16px calc(env(safe-area-inset-bottom) + 26px)}
.diagnosis-report__inner{padding-top:32px}
.diagnosis-report__head{padding:0 4px}
.diagnosis-report__eyebrow{font-size:13px;font-weight:700}
.diagnosis-report__title{margin-top:7px;font-size:25px;font-weight:700}
.diagnosis-empty{margin-top:25px;padding:18px 15px}
.diagnosis-empty__title{font-size:16px;font-weight:700}
.diagnosis-empty__copy{margin-top:7px;font-size:13px;line-height:1.6}
.diagnosis-empty__action{width:100%;min-height:45px;margin-top:15px;font-size:15px;font-weight:700}
.report-summary{margin-top:22px;padding:16px 15px}
.report-summary__status{font-size:13px;font-weight:700}
.report-summary__copy{margin-top:8px;font-size:16px;line-height:1.6}
.report-summary__meta{margin-top:10px;font-size:12px}
.report-section{margin-top:24px}
.report-weak{margin-top:9px;padding:0 14px}
.report-weak__row, .report-prediction__row{min-height:56px;border-bottom:0.5px solid var(--line);font-size:15px}
.report-weak__row:last-child, .report-prediction__row:last-child{border-bottom:0}
.report-weak__meta, .report-no-prediction{font-size:12px}
.report-prediction{margin-top:9px;padding:0 14px}
.report-sk-gap{margin-top:12px !important}
.report-list-sk{height:114px;margin-top:9px}
}
