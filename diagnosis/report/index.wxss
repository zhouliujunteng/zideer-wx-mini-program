.diagnosis-report { min-height: 100vh; padding: 0 28rpx calc(env(safe-area-inset-bottom) + 44rpx); }.diagnosis-report__inner { padding-top: 54rpx; }.diagnosis-report__head { padding: 0 8rpx; }.diagnosis-report__eyebrow { display: block; color: var(--accent-deep); font-size: 22rpx; font-weight: 700; }.diagnosis-report__title { display: block; margin-top: 12rpx; font-size: 42rpx; font-weight: 700; }.diagnosis-empty { margin-top: 42rpx; padding: 30rpx 26rpx; }.diagnosis-empty__title { display: block; font-size: 28rpx; font-weight: 700; }.diagnosis-empty__copy { display: block; margin-top: 12rpx; color: var(--muted); font-size: 22rpx; line-height: 1.6; }.diagnosis-empty__action { width: 100%; min-height: 76rpx; margin-top: 26rpx; background: var(--accent-deep); color: #fff; font-size: 25rpx; font-weight: 700; }.report-summary { margin-top: 38rpx; padding: 28rpx 26rpx; }.report-summary__status { display: block; color: var(--accent-deep); font-size: 22rpx; font-weight: 700; }.report-summary__copy { display: block; margin-top: 14rpx; font-size: 27rpx; line-height: 1.6; }.report-summary__meta { display: block; margin-top: 18rpx; color: var(--muted); font-size: 21rpx; }.report-section { margin-top: 40rpx; }.report-weak { margin-top: 16rpx; padding: 0 24rpx; }.report-weak__row, .report-prediction__row { display: flex; min-height: 94rpx; align-items: center; justify-content: space-between; border-bottom: 1rpx solid var(--line); font-size: 25rpx; }.report-weak__row:last-child, .report-prediction__row:last-child { border-bottom: 0; }.report-weak__meta, .report-no-prediction { color: var(--muted); font-size: 21rpx; }.report-prediction { margin-top: 16rpx; padding: 0 24rpx; }.diagnosis-report__skeleton { height: 460rpx; border-radius: 18rpx; }
