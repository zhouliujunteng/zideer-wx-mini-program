.plan-detail { min-height: 100vh; padding: 0 28rpx calc(env(safe-area-inset-bottom) + 44rpx); }.plan-detail__inner { padding-top: 54rpx; }.plan-detail__head { padding: 0 8rpx; }.plan-detail__eyebrow { display: block; color: var(--accent-deep); font-size: 22rpx; font-weight: 700; }.plan-detail__title { display: block; margin-top: 12rpx; font-size: 42rpx; font-weight: 700; line-height: 1.28; }.plan-detail__copy { display: block; margin-top: 14rpx; color: var(--muted); font-size: 23rpx; line-height: 1.55; }.plan-detail__empty { margin-top: 42rpx; padding: 30rpx 26rpx; color: var(--muted); font-size: 24rpx; line-height: 1.55; }.plan-detail__list { margin-top: 42rpx; padding: 0 26rpx; }.plan-detail__item { display: flex; min-height: 108rpx; align-items: center; gap: 20rpx; border-bottom: 1rpx solid var(--line); }.plan-detail__item:last-child { border-bottom: 0; }.plan-detail__seq { display: flex; width: 42rpx; height: 42rpx; align-items: center; justify-content: center; flex: none; border-radius: 21rpx; background: var(--accent-soft); color: var(--accent-deep); font-size: 20rpx; font-weight: 700; }.plan-detail__topic, .plan-detail__meta { display: block; }.plan-detail__topic { font-size: 25rpx; font-weight: 700; }.plan-detail__meta { margin-top: 8rpx; color: var(--muted); font-size: 21rpx; }.plan-detail__skeleton { height: 400rpx; border-radius: 18rpx; }
