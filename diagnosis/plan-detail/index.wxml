<view class="screen plan-detail">
  <view class="plan-detail__inner">
    <view class="skeleton plan-detail__skeleton" wx:if="{{loading}}"></view>
    <view class="state-panel" wx:elif="{{failed}}">
      <view class="state-panel__mark">!</view>
      <text class="state-panel__title">计划详情没有加载出来</text>
      <button class="state-panel__action pressable" bindtap="loadPlan">重新加载</button>
    </view>
    <block wx:else>
      <view class="plan-detail__head">
        <text class="plan-detail__eyebrow">学习计划</text>
        <text class="plan-detail__title">{{plan.name}}</text>
        <text class="plan-detail__copy" wx:if="{{plan.goalSnapshot.description}}">{{plan.goalSnapshot.description}}</text>
      </view>
      <view class="plan-detail__empty surface" wx:if="{{!plan.items.length}}"><text>计划暂时没有学习任务。</text></view>
      <view class="plan-detail__list surface" wx:else>
        <navigator class="plan-detail__item" wx:for="{{plan.items}}" wx:key="id" url="{{item.generationUrl}}" hover-class="plan-detail__item--pressed">
          <text class="plan-detail__seq">{{item.sequenceNo}}</text>
          <view class="plan-detail__body">
            <text class="plan-detail__topic">{{item.topicName}}</text>
            <text class="plan-detail__meta">{{item.taskStatusLabel}}<text wx:if="{{item.estimatedCredits !== null}}"> · 预计 {{item.estimatedCreditsDisplay}} 积分</text></text>
          </view>
          <text class="plan-detail__arrow" aria-hidden="true">›</text>
        </navigator>
      </view>
    </block>
  </view>
</view>
<dev-reset-fab />
