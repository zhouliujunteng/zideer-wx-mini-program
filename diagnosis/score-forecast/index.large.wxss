/* 自动生成，请勿手改：index.wxss 在平板、电脑大屏（窗口宽 ≥ 450px）下的样式。
   rpx 按 1rpx = 0.6px 换算，固定定位元素收进居中栏；改完源文件后运行 node scripts/build-large-screen-styles.mjs */
@media (min-width: 450px) {
.surface{border-radius:14px}
.skeleton{border-radius:9px}
.state-panel{padding:72px 14px 24px}
.state-panel__mark{margin-bottom:14px;font-size:31px}
.state-panel__title{font-size:19px;font-weight:600}
.state-panel__copy{margin:13px 0 19px;font-size:15px;line-height:1.6}
.state-panel__action{border-radius:12px}
.state-panel__action::after{border:0}
.sk{border-radius:7px}
.sk-line{height:16px}
.sk-line + .sk-line{margin-top:8px}
.sk-short{width:40%}
.sk-mid{width:64%}
.sk-round{border-radius:50%}
.sk-card{height:96px;border-radius:14px}
.sk-card + .sk-card{margin-top:12px}
.score-forecast{min-height:100vh;padding:0 16px calc(env(safe-area-inset-bottom) + 26px)}
.score-forecast__inner{padding-top:32px}
.score-forecast__head{padding:0 4px}
.score-forecast__eyebrow{font-size:13px;font-weight:700}
.score-forecast__title{margin-top:7px;font-size:25px;font-weight:700}
.score-forecast__copy{margin-top:8px;font-size:13px;line-height:1.55}
.forecast-empty{margin-top:25px;padding:18px 15px;font-size:14px;line-height:1.55}
.forecast-card{margin-top:10px;padding:16px 15px}
.forecast-card__subject{font-size:16px;font-weight:700}
.forecast-card__range{margin-top:9px;font-size:24px;font-weight:700}
.forecast-card__meta, .forecast-card__limit{margin-top:7px;font-size:13px;line-height:1.5}
.forecast-range-sk{width:52%;height:26px;margin-top:9px}
.forecast-meta-sk{margin-top:9px}
.forecast-topic-row{padding:12px 0;border-top:0.5px solid #eee}
}
