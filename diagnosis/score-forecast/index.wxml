<view class="screen score-forecast"><view class="score-forecast__inner"><view class="skeleton score-forecast__skeleton" wx:if="{{loading}}"></view><view class="state-panel" wx:elif="{{failed}}"><view class="state-panel__mark">!</view><text class="state-panel__title">预测没有加载出来</text><button class="state-panel__action pressable" bindtap="loadPage">重新加载</button></view><block wx:else><view class="score-forecast__head"><text class="score-forecast__eyebrow">区间预测</text><text class="score-forecast__title">期末分预测</text><text class="score-forecast__copy">预测反映当前证据范围，不代表实际考试结果。</text></view><view class="forecast-empty surface" wx:if="{{!predictions.length}}"><text>当前数据不足，暂不输出伪精确分数。</text></view><view class="forecast-list" wx:else><view class="forecast-card surface" wx:for="{{predictions}}" wx:key="id"><text class="forecast-card__subject">{{item.subjectName}}</text><text class="forecast-card__range">{{item.scoreRange}}</text><text class="forecast-card__meta" wx:if="{{item.confidencePercent !== null}}">置信度 {{item.confidencePercent}}%</text><text class="forecast-card__limit" wx:if="{{item.limitation}}">{{item.limitation}}</text></view></view></block></view></view>
