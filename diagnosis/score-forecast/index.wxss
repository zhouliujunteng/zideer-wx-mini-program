.score-forecast { min-height: 100vh; padding: 0 28rpx calc(env(safe-area-inset-bottom) + 44rpx); }.score-forecast__inner { padding-top: 54rpx; }.score-forecast__head { padding: 0 8rpx; }.score-forecast__eyebrow { display: block; color: var(--accent-deep); font-size: 22rpx; font-weight: 700; }.score-forecast__title { display: block; margin-top: 12rpx; font-size: 42rpx; font-weight: 700; }.score-forecast__copy { display: block; margin-top: 14rpx; color: var(--muted); font-size: 23rpx; line-height: 1.55; }.forecast-empty { margin-top: 42rpx; padding: 30rpx 26rpx; color: var(--muted); font-size: 24rpx; line-height: 1.55; }.forecast-card { margin-top: 18rpx; padding: 28rpx 26rpx; }.forecast-card__subject { display: block; font-size: 27rpx; font-weight: 700; }.forecast-card__range { display: block; margin-top: 16rpx; color: var(--accent-deep); font-size: 40rpx; font-weight: 700; }.forecast-card__meta, .forecast-card__limit { display: block; margin-top: 12rpx; color: var(--muted); font-size: 22rpx; line-height: 1.5; }.score-forecast__skeleton { height: 420rpx; border-radius: 18rpx; }
