@import "../../styles/account-form.wxss";
@import "../../styles/skeleton.wxss";
.score-forecast { min-height: 100vh; padding: 0 28rpx calc(env(safe-area-inset-bottom) + 44rpx); }.score-forecast__inner { padding-top: 54rpx; }.score-forecast__head { padding: 0 8rpx; }.score-forecast__eyebrow { display: block; color: var(--accent-deep); font-size: 22rpx; font-weight: 700; }.score-forecast__title { display: block; margin-top: 12rpx; font-size: 42rpx; font-weight: 700; }.score-forecast__copy { display: block; margin-top: 14rpx; color: var(--muted); font-size: 23rpx; line-height: 1.55; }.forecast-empty { margin-top: 42rpx; padding: 30rpx 26rpx; color: var(--muted); font-size: 24rpx; line-height: 1.55; }.forecast-card { margin-top: 18rpx; padding: 28rpx 26rpx; }.forecast-card__subject { display: block; font-size: 27rpx; font-weight: 700; }.forecast-card__range { display: block; margin-top: 16rpx; color: var(--accent-deep); font-size: 40rpx; font-weight: 700; }.forecast-card__meta, .forecast-card__limit { display: block; margin-top: 12rpx; color: var(--muted); font-size: 22rpx; line-height: 1.5; }
/* 第一次读到报告前的骨架：与报告卡同形 */
.forecast-range-sk { width: 52%; height: 44rpx; margin-top: 16rpx; }
.forecast-meta-sk { margin-top: 16rpx; }
.forecast-topic-row { padding: 20rpx 0; border-top: 1rpx solid #eee; }

@import "./index.large.wxss"; /* 平板、电脑大屏样式：由 scripts/build-large-screen-styles.mjs 生成，改完本文件后重跑；这一行须留在文件末尾 */
