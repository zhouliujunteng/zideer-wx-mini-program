@import "../../styles/skeleton.wxss";
/* 安卓网页付款等待页：与订单状态页（commerce/payment-result）同一套——氛围光、自定义顶栏、白色大圆角卡片、品牌橙 #FD7C02。 */
page { background: #FAFAFA; }

.webpay-page { position: relative; height: 100vh; overflow: hidden; background: #FAFAFA; color: #24332D; }
.webpay-ambient { position: fixed; top: 0; left: 0; z-index: 0; width: 100%; height: 100%; pointer-events: none; background: radial-gradient(125% 42% at 100% 0, rgba(201, 232, 255, .72) 0%, rgba(215, 239, 255, .4) 40%, rgba(250, 250, 250, 0) 76%), #FAFAFA; }
.webpay-topbar { position: fixed; top: 0; left: 0; z-index: 20; width: 100%; box-sizing: border-box; background: transparent; }
.webpay-topbar-inner { position: relative; display: flex; align-items: center; box-sizing: content-box; padding: 0 32rpx 16rpx; }
.webpay-back { display: flex; flex: 0 0 auto; align-items: center; justify-content: center; width: 54rpx; height: 54rpx; border-radius: 50%; }
.webpay-back:active { background: #F0F2EF; }
.webpay-back-icon { width: 22rpx; height: 22rpx; border-bottom: 4rpx solid #24332D; border-left: 4rpx solid #24332D; transform: rotate(45deg) scale(.7); }
.webpay-topbar-title { position: absolute; left: 50%; display: block; color: #24332D; font-size: 36rpx; font-weight: 700; letter-spacing: -1rpx; transform: translateX(-50%); white-space: nowrap; }
.webpay-scroll { position: absolute; right: 0; bottom: 0; left: 0; z-index: 1; box-sizing: border-box; background: transparent; }
.webpay-shell { min-height: 100%; padding: 0 32rpx calc(200rpx + env(safe-area-inset-bottom)); box-sizing: border-box; }

/* 结果：浅暖色圆底 + 品牌橙对勾 / 感叹号 */
.webpay-hero { display: flex; flex-direction: column; align-items: center; padding: 64rpx 24rpx 8rpx; text-align: center; }
.webpay-mark { display: flex; align-items: center; justify-content: center; width: 144rpx; height: 144rpx; border-radius: 50%; background: #FFF3D8; }
.webpay-mark.is-paid { animation: webpay-mark-pop .42s .08s cubic-bezier(.22, .8, .24, 1) both; }
.webpay-check { width: 30rpx; height: 56rpx; margin-top: -14rpx; box-sizing: border-box; border-right: 10rpx solid #FD7C02; border-bottom: 10rpx solid #FD7C02; border-radius: 0 0 6rpx 0; transform: rotate(45deg); }
.webpay-mark-text { color: #FD7C02; font-size: 68rpx; font-weight: 700; line-height: 1; }
.webpay-title { display: block; margin-top: 32rpx; color: #24332D; font-size: 36rpx; font-weight: 700; line-height: 1.25; }
.webpay-subtitle { display: block; max-width: 560rpx; margin-top: 14rpx; color: #7D8981; font-size: 24rpx; line-height: 1.6; }
.webpay-retry { margin-top: 32rpx; padding: 0 48rpx; height: 72rpx; border-radius: 999rpx; background: #F0F2EF; color: #4A514C; font-size: 25rpx; font-weight: 650; line-height: 72rpx; }
.webpay-retry:active { opacity: .7; }

.webpay-card { margin-top: 24rpx; padding: 32rpx 30rpx; border-radius: 32rpx; background: #fff; }
.webpay-amount { display: block; color: #FD7C02; font-size: 56rpx; font-weight: 700; line-height: 1.2; }
.webpay-product { display: block; margin-top: 8rpx; color: #24332D; font-size: 28rpx; font-weight: 600; line-height: 1.4; }
.webpay-waiting { display: flex; align-items: center; gap: 12rpx; margin-top: 24rpx; padding-top: 22rpx; border-top: 2rpx solid #F0F3F0; color: #7E8A82; font-size: 24rpx; line-height: 1.4; }
.webpay-dot { flex: 0 0 auto; width: 14rpx; height: 14rpx; border-radius: 50%; background: #FD7C02; animation: webpay-pulse 1.4s ease-in-out infinite; }

/* 服务号推送了付款链接：浅橙底卡片 */
.webpay-push { background: #FFF6EC; }
.webpay-push-text { display: block; color: #4A514C; font-size: 26rpx; line-height: 1.6; }
.webpay-push-action { display: inline-block; margin-top: 18rpx; padding: 0 28rpx; height: 64rpx; border-radius: 999rpx; background: rgba(253, 124, 2, .12); color: #FD7C02; font-size: 24rpx; font-weight: 650; line-height: 64rpx; }
.webpay-push-action:active { opacity: .7; }

.webpay-card-title { display: block; margin-bottom: 12rpx; color: #24332D; font-size: 28rpx; font-weight: 700; }
.webpay-step { display: flex; align-items: flex-start; gap: 16rpx; padding: 12rpx 0; }
.webpay-step-no { flex: 0 0 auto; width: 40rpx; height: 40rpx; border-radius: 50%; background: rgba(253, 124, 2, .12); color: #FD7C02; font-size: 22rpx; font-weight: 700; line-height: 40rpx; text-align: center; }
.webpay-step-text { flex: 1; min-width: 0; color: #4A514C; font-size: 26rpx; line-height: 40rpx; }
.webpay-link { margin-top: 18rpx; padding: 20rpx 22rpx; border-radius: 20rpx; background: #F6F7F5; }
.webpay-link-text { display: block; color: #4A514C; font-size: 22rpx; line-height: 1.5; word-break: break-all; }
.webpay-note { display: block; margin-top: 16rpx; color: #98A49C; font-size: 22rpx; line-height: 1.6; }
.webpay-refresh { display: flex; justify-content: center; margin-top: 24rpx; padding: 14rpx 0; color: #98A49C; font-size: 24rpx; line-height: 1.2; }
.webpay-refresh:active { opacity: .6; }

/* 与星标/小程序链接教程一致：白色步骤卡、橙色操作重点、CSS 微信示意图。 */
.payguide-intro { padding: 28rpx 8rpx 24rpx; }
.payguide-eyebrow { display: block; color: #B95800; font-size: 22rpx; font-weight: 650; letter-spacing: 2rpx; }
.payguide-title { display: block; margin-top: 14rpx; color: #24332D; font-size: 46rpx; font-weight: 750; line-height: 1.35; white-space: pre-line; }
.payguide-subtitle { display: block; margin-top: 18rpx; color: #6B766F; font-size: 26rpx; line-height: 1.65; }
.payguide-delivery { display: flex; align-items: center; gap: 14rpx; padding: 20rpx 24rpx; border-radius: 20rpx; background: #FFF1E3; color: #9D4C08; font-size: 23rpx; line-height: 1.55; }
.payguide-delivery-dot { flex: 0 0 12rpx; height: 12rpx; border-radius: 50%; background: #FD7C02; }
.payguide-sk-delivery { height: 76rpx; border-radius: 20rpx; }
.payguide-step { margin-top: 24rpx; padding: 30rpx 26rpx 26rpx; background: #FFF; border-radius: 32rpx; }
.payguide-step-head { display: flex; align-items: flex-start; gap: 18rpx; }
.payguide-number { flex: 0 0 46rpx; height: 46rpx; border-radius: 50%; background: #FFF1E3; color: #C25A02; font-size: 26rpx; font-weight: 700; line-height: 46rpx; text-align: center; }
.payguide-step-copy { flex: 1; min-width: 0; }
.payguide-step-title { display: block; color: #24332D; font-size: 29rpx; font-weight: 700; line-height: 1.55; }
.payguide-hint { display: block; margin-top: 8rpx; color: #6B766F; font-size: 24rpx; line-height: 1.65; }
.payguide-figure { margin-top: 24rpx; overflow: hidden; border: 2rpx solid #EEF0ED; border-radius: 22rpx; background: #F4F5F4; }
.payguide-mock-head { display: flex; justify-content: space-between; align-items: center; padding: 20rpx 24rpx; border-bottom: 2rpx solid #E7EAE7; color: #3B4941; font-size: 24rpx; font-weight: 650; }
.payguide-mock-tools { font-size: 28rpx; }
.payguide-mock-row { position: relative; display: flex; align-items: center; gap: 16rpx; margin: 14rpx; padding: 18rpx 14rpx; border-radius: 14rpx; }
.payguide-mock-row.is-muted { padding-top: 8rpx; padding-bottom: 8rpx; opacity: .55; }
.payguide-mock-row.is-highlight { background: #FFF7ED; box-shadow: inset 0 0 0 2rpx #FD7C02; }
.payguide-avatar { flex: 0 0 64rpx; height: 64rpx; display: flex; align-items: center; justify-content: center; border-radius: 15rpx; background: #EAA24A; color: #FFF; }
.payguide-avatar image { display: block; width: 64rpx; height: 64rpx; border-radius: 15rpx; }
.payguide-logo-skeleton { width: 64rpx; height: 64rpx; border-radius: 15rpx; }
.payguide-avatar.is-gray { background: #D9E1DC; }
.payguide-lines { flex: 1; }
.payguide-lines view { width: 42%; height: 12rpx; background: #DAE0DC; border-radius: 6rpx; }
.payguide-lines view + view { width: 72%; margin-top: 14rpx; height: 9rpx; }
.payguide-mock-copy { flex: 1; min-width: 0; }
.payguide-mock-name { display: block; font-size: 25rpx; font-weight: 600; }
.payguide-mock-detail { display: block; margin-top: 6rpx; color: #6B766F; font-size: 20rpx; line-height: 1.5; }
.payguide-tap-label { position: absolute; right: 14rpx; top: -14rpx; padding: 4rpx 14rpx; border-radius: 999rpx; background: #FD7C02; color: #FFF; font-size: 19rpx; }
.payguide-caption { display: block; padding: 8rpx 20rpx 18rpx; color: #7D877F; font-size: 19rpx; line-height: 1.5; text-align: center; }
.payguide-message { margin: 20rpx; padding: 24rpx 22rpx 0; border-radius: 16rpx; background: #FFF; }
.payguide-message-title { display: block; margin-bottom: 20rpx; font-size: 26rpx; font-weight: 600; }
.payguide-message-row { display: flex; justify-content: space-between; gap: 16rpx; padding-bottom: 14rpx; color: #6B766F; font-size: 21rpx; line-height: 1.5; }
.payguide-message-link { position: relative; display: flex; justify-content: space-between; margin-top: 8rpx; padding: 18rpx 0; border-top: 2rpx solid #EEF0ED; color: #C25A02; font-size: 23rpx; font-weight: 600; }
.payguide-tap-ring { position: absolute; right: 42rpx; bottom: 12rpx; width: 36rpx; height: 36rpx; border: 3rpx solid #FD7C02; border-radius: 50%; background: rgba(253,124,2,.1); box-shadow: 0 0 0 8rpx rgba(253,124,2,.1); }
.payguide-figure.is-payment { padding: 24rpx 24rpx 0; background: #181B19; border-color: #181B19; color: #FFF; }
.payguide-payment-brand { display: block; color: #C6CCC8; font-size: 20rpx; }
.payguide-payment-title { display: block; margin-top: 20rpx; font-size: 28rpx; font-weight: 600; }
.payguide-payment-summary { display: flex; flex-direction: column; gap: 10rpx; margin-top: 18rpx; padding: 20rpx; border-radius: 14rpx; background: #282D29; color: #C6CCC8; font-size: 21rpx; }
.payguide-payment-button { position: relative; margin: 20rpx 0; padding: 16rpx; border-radius: 999rpx; background: #FD7C02; color: #FFF; font-size: 23rpx; font-weight: 600; text-align: center; }
.payguide-payment-button .payguide-tap-ring { border-color: #FFF; box-shadow: 0 0 0 8rpx rgba(255,255,255,.2); }
.is-payment .payguide-caption { color: #ABB5AD; }
.payguide-help { padding: 30rpx 10rpx 0; }
.payguide-help-title { display: block; font-size: 27rpx; font-weight: 650; }
.payguide-help-actions { display: flex; gap: 16rpx; margin-top: 20rpx; align-items: center; flex-wrap: wrap; }
.payguide-secondary, .payguide-text-button, .payguide-reopen { margin: 0; padding: 18rpx 24rpx; border-radius: 999rpx; color: #9D4C08; background: #FFF1E3; font-size: 24rpx; line-height: 1.5; }
.payguide-text-button, .payguide-reopen { color: #6B766F; background: transparent; }
.payguide-reopen { margin: 24rpx auto 0; }
.payguide-secondary::after, .payguide-text-button::after, .payguide-reopen::after { border: 0; }

/* 底部操作栏：主按钮品牌橙渐变胶囊 */
.webpay-bar { position: fixed; right: 0; bottom: 0; left: 0; z-index: 18; display: flex; align-items: center; gap: 20rpx; padding: 18rpx 32rpx calc(18rpx + env(safe-area-inset-bottom)); background: rgba(255, 255, 255, .96); box-shadow: 0 -8rpx 24rpx rgba(36, 51, 45, .06); }
.webpay-button { flex: 1; min-width: 0; height: 88rpx; margin: 0; padding: 0; border: 0; border-radius: 999rpx; font-size: 28rpx; font-weight: 650; line-height: 88rpx; }
.webpay-button::after { border: 0; }
.webpay-button:active { opacity: .82; }
.webpay-button.is-primary { background: linear-gradient(90deg, #FF9F43 0%, #FD7C02 100%); color: #fff; }

@keyframes webpay-mark-pop { from { opacity: 0; transform: scale(.6); } to { opacity: 1; transform: scale(1); } }
@keyframes webpay-pulse { 0%, 100% { opacity: .35; } 50% { opacity: 1; } }

/* 首次加载骨架 */
.webpay-sk-amount { width: 220rpx; height: 64rpx; }
.webpay-sk-product { width: 280rpx; margin-top: 14rpx; }
.webpay-sk-link { width: 100%; height: 72rpx; margin-top: 18rpx; border-radius: 20rpx; }
.webpay-sk-button { flex: 1; height: 88rpx; border-radius: 999rpx; }

@import "./index.large.wxss"; /* 平板、电脑大屏样式：由 scripts/build-large-screen-styles.mjs 生成，改完本文件后重跑；这一行须留在文件末尾 */
