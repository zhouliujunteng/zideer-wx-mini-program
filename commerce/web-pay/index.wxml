<wxs module="UA" src="../../utils/ui-asset.wxs" />
<!-- 安卓付款先展示公众号通知教程，随后保留订单等待、重发与复制链接。 -->
<view class="webpay-page">
  <view class="webpay-ambient" aria-hidden="true"></view>
  <view class="webpay-topbar">
    <view class="webpay-topbar-inner" style="height: {{navigationBarHeight}}px; padding-top: {{statusBarHeight}}px;">
      <view class="webpay-back" bindtap="handleBack" aria-label="返回" aria-role="button"><view class="webpay-back-icon"></view></view>
      <text class="webpay-topbar-title" style="top: {{statusBarHeight}}px; height: {{navigationBarHeight}}px; line-height: {{navigationBarHeight}}px;">完成付款</text>
    </view>
  </view>

  <scroll-view class="webpay-scroll" scroll-y show-scrollbar="{{false}}" scroll-into-view="{{guideVisible ? 'payguide-start' : 'webpay-order-start'}}" style="top: {{contentTop}}px;">
    <view class="webpay-shell">
      <view class="webpay-hero" wx:if="{{failed}}">
        <!-- 换不到链接 -->
        <view class="webpay-mark"><text class="webpay-mark-text">!</text></view>
        <text class="webpay-title">暂时无法付款</text>
        <text class="webpay-subtitle">{{errorText}}</text>
        <view class="webpay-retry" bindtap="prepare" aria-role="button">重试</view>
      </view>

      <view class="webpay-hero" wx:elif="{{paid}}">
        <!-- 已付款 -->
        <view class="webpay-mark is-paid"><view class="webpay-check" aria-hidden="true"></view></view>
        <text class="webpay-title">付款成功</text>
        <text class="webpay-subtitle">{{kind === 'membership' ? '会员已开通，现在就可以使用。' : '课程积分已发放到账户。'}}</text>
      </view>

      <view class="webpay-hero" wx:elif="{{closed}}">
        <!-- 订单已关闭 -->
        <view class="webpay-mark"><text class="webpay-mark-text">!</text></view>
        <text class="webpay-title">这笔订单已关闭</text>
        <text class="webpay-subtitle">如果已经付过款，请联系客服处理；没有付款可以返回重新下单。</text>
      </view>

      <block wx:else>
        <view wx:if="{{guideVisible}}" class="payguide" id="payguide-start">
          <view class="payguide-intro">
            <text class="payguide-eyebrow">公众号付款指南</text>
            <text class="payguide-title">去微信通知里，
完成这笔付款</text>
            <text class="payguide-subtitle">跟着下面 3 步操作。付好后回到小程序，付款结果会自动更新。</text>
          </view>
          <view class="payguide-delivery" wx:if="{{loaded}}">
            <view class="payguide-delivery-dot"></view>
            <text wx:if="{{push === 'sent'}}">付款通知已发送，按下面步骤查看</text>
            <text wx:elif="{{push === 'not_following'}}">请先关注「{{mpName || '知鹿学习'}}」公众号，再重新发送</text>
            <text wx:else>暂未确认通知送达，可在下方重新发送</text>
          </view>
          <view wx:else class="sk payguide-sk-delivery"></view>

          <view class="payguide-step">
            <view class="payguide-step-head"><text class="payguide-number">1</text><view class="payguide-step-copy"><text class="payguide-step-title">回到微信，找到公众号通知</text><text class="payguide-hint">点右上角圆圈收起小程序，在微信消息列表找「服务号」或「{{mpName || '知鹿学习'}}」。</text></view></view>
            <view class="payguide-figure" aria-hidden="true">
              <view class="payguide-mock-head"><text>微信</text><text class="payguide-mock-tools">＋</text></view>
              <view class="payguide-mock-row is-muted"><view class="payguide-avatar is-gray"></view><view class="payguide-lines"><view></view><view></view></view></view>
              <view class="payguide-mock-row is-highlight"><view class="payguide-avatar"><image wx:if="{{UA.src(ui, '/assets/brand/wechat-official-account.jpg')}}" src="{{UA.src(ui, '/assets/brand/wechat-official-account.jpg')}}" mode="aspectFit" aria-hidden="true"></image><view wx:else class="sk payguide-logo-skeleton"></view></view><view class="payguide-mock-copy"><text class="payguide-mock-name">{{mpName || '知鹿学习'}}</text><text class="payguide-mock-detail">订单创建成功通知</text></view><text class="payguide-tap-label">点这里</text></view>
              <text class="payguide-caption">入口示意 · 微信版本不同，通知位置可能不同</text>
            </view>
          </view>

          <view class="payguide-step">
            <view class="payguide-step-head"><text class="payguide-number">2</text><view class="payguide-step-copy"><text class="payguide-step-title">打开「订单创建成功通知」</text><text class="payguide-hint">找到「{{mpName || '知鹿学习'}}」发来的本次订单通知。</text></view></view>
            <view class="payguide-figure is-notice" aria-hidden="true">
              <view class="payguide-mock-head"><text>{{mpName || '知鹿学习'}}</text><text class="payguide-mock-tools">···</text></view>
              <view class="payguide-message">
                <text class="payguide-message-title">订单创建成功通知</text>
                <view class="payguide-message-row"><text>商品</text><text>你选购的会员</text></view>
                <view class="payguide-message-row"><text>订单金额</text><text>核对本次付款金额</text></view>
                <view class="payguide-message-link"><text>查看详情</text><text>›</text><view class="payguide-tap-ring"></view></view>
              </view>
              <text class="payguide-caption">通知示意 · 点「查看详情」或通知卡片</text>
            </view>
          </view>

          <view class="payguide-step">
            <view class="payguide-step-head"><text class="payguide-number">3</text><view class="payguide-step-copy"><text class="payguide-step-title">进入付款网页，完成微信支付</text><text class="payguide-hint">核对商品、金额和到账账号，再点「微信支付」。</text></view></view>
            <view class="payguide-figure is-payment" aria-hidden="true">
              <text class="payguide-payment-brand">知鹿学习 · 订单付款</text>
              <text class="payguide-payment-title">确认付款</text>
              <view class="payguide-payment-summary"><text>商品与付款金额</text><text>请确认到账账号</text></view>
              <view class="payguide-payment-button">微信支付<view class="payguide-tap-ring"></view></view>
              <text class="payguide-caption">付款页示意 · 付款后返回小程序即可</text>
            </view>
          </view>
          <view class="payguide-help" wx:if="{{loaded}}">
            <text class="payguide-help-title">没有找到通知？</text>
            <text class="payguide-hint">先确认已关注「{{mpName || '知鹿学习'}}」公众号。重新发送仍未收到时，也可以复制链接付款。</text>
            <view class="payguide-help-actions">
              <button class="payguide-secondary" bindtap="resend" disabled="{{resending}}">{{resending ? '正在发送…' : push === 'not_following' ? '我已关注，重新发送' : '重新发送通知'}}</button>
              <button class="payguide-text-button" bindtap="dismissGuide">复制链接付款</button>
            </view>
          </view>
        </view>
        <block wx:else>
        <view class="webpay-card" id="webpay-order-start">
          <block wx:if="{{loaded}}">
            <text class="webpay-amount">¥{{order.amount}}</text>
            <text class="webpay-product">{{order.title}}</text>
          </block>
          <block wx:else>
            <view class="sk webpay-sk-amount"></view>
            <view class="sk sk-line webpay-sk-product"></view>
          </block>
          <view class="webpay-waiting">
            <view class="webpay-dot"></view>
            <text>{{loaded ? '等待付款，付好后这里会自动更新' : '正在生成付款链接'}}</text>
          </view>
        </view>

        <view class="webpay-card webpay-push" wx:if="{{loaded && push === 'sent'}}">
          <text class="webpay-card-title">付款链接已发到公众号</text>
          <text class="webpay-push-text">打开微信里「{{mpName || '知鹿学习'}}」公众号的消息「订单创建成功通知」，点开就能用微信支付。</text>
          <view class="webpay-push-action" bindtap="resend" aria-role="button">{{resending ? '正在发送…' : '没收到？重新发送'}}</view>
        </view>
        <view class="webpay-card webpay-push" wx:elif="{{loaded && push === 'not_following'}}">
          <text class="webpay-card-title">关注公众号，付款链接直接发给你</text>
          <text class="webpay-push-text">在微信里搜索公众号「{{mpName || '知鹿学习'}}」并关注，再点下面的按钮。</text>
          <view class="webpay-push-action" bindtap="resend" aria-role="button">{{resending ? '正在发送…' : '我已关注，重新发送'}}</view>
        </view>

        <view class="webpay-card">
          <text class="webpay-card-title">{{push === 'sent' || push === 'not_following' ? '也可以自己复制链接' : '付款步骤'}}</text>
          <view class="webpay-step"><text class="webpay-step-no">1</text><text class="webpay-step-text">点下方「复制付款链接」</text></view>
          <view class="webpay-step"><text class="webpay-step-no">2</text><text class="webpay-step-text">发到微信「文件传输助手」再点开（也可以粘贴到手机浏览器打开）</text></view>
          <view class="webpay-step"><text class="webpay-step-no">3</text><text class="webpay-step-text">点「微信支付」完成付款</text></view>
          <view class="webpay-step"><text class="webpay-step-no">4</text><text class="webpay-step-text">回到这里，付款结果会自动更新</text></view>
          <view class="webpay-link" wx:if="{{loaded}}">
            <text user-select="{{true}}" class="webpay-link-text">{{link}}</text>
          </view>
          <view class="sk sk-line webpay-sk-link" wx:else></view>
          <text class="webpay-note">链接 24 小时内有效，只能为这笔订单付款。</text>
        </view>

        <button class="payguide-reopen" bindtap="showGuide">查看公众号付款教程</button>
        <view wx:if="{{loaded}}" class="webpay-refresh" bindtap="checkNow" aria-role="button">
          <text>{{checking ? '正在查询…' : slow ? '还没收到付款结果，点此刷新' : '已付款？点此刷新'}}</text>
        </view>
        </block>
      </block>
    </view>
  </scroll-view>

  <view class="webpay-bar">
    <button wx:if="{{paid}}" class="webpay-button is-primary" bindtap="finish">完成</button>
    <button wx:elif="{{failed || closed}}" class="webpay-button is-primary" bindtap="handleBack">返回</button>
    <button wx:elif="{{guideVisible}}" class="webpay-button is-primary" bindtap="dismissGuide">我知道了</button>
    <view wx:elif="{{!loaded}}" class="sk webpay-sk-button"></view>
    <button wx:else class="webpay-button is-primary" bindtap="copyLink">{{copied ? '再次复制付款链接' : '复制付款链接'}}</button>
  </view>
</view>
<dev-reset-fab />
