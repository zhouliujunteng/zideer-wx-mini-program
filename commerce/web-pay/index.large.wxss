/* 自动生成，请勿手改：index.wxss 在平板、电脑大屏（窗口宽 ≥ 450px）下的样式。
   rpx 按 1rpx = 0.6px 换算，固定定位元素收进居中栏；改完源文件后运行 node scripts/build-large-screen-styles.mjs */
@media (min-width: 450px) {
.sk{border-radius:7px}
.sk-line{height:16px}
.sk-line + .sk-line{margin-top:8px}
.sk-short{width:40%}
.sk-mid{width:64%}
.sk-round{border-radius:50%}
.sk-card{height:96px;border-radius:14px}
.sk-card + .sk-card{margin-top:12px}
.webpay-page{height:100vh}
.webpay-ambient{top:0;left:max(0px, 50% - var(--lg-col) / 2);width:min(100%, var(--lg-col));height:100%}
.webpay-topbar{top:0;left:max(0px, 50% - var(--lg-col) / 2);width:min(100%, var(--lg-col));box-sizing:border-box}
.webpay-topbar-inner{box-sizing:content-box;padding:0 19px 9px}
.webpay-back{flex:0 0 auto;width:32px;height:32px;border-radius:50%}
.webpay-back-icon{width:13px;height:13px;border-bottom:2px solid #24332D;border-left:2px solid #24332D}
.webpay-topbar-title{left:50%;font-size:21px;font-weight:700;letter-spacing:-1px}
.webpay-scroll{right:0;bottom:0;left:0;box-sizing:border-box}
.webpay-shell{min-height:100%;padding:0 19px calc(120px + env(safe-area-inset-bottom));box-sizing:border-box}
.webpay-hero{flex-direction:column;padding:38px 14px 4px}
.webpay-mark{width:86px;height:86px;border-radius:50%}
.webpay-check{width:18px;height:33px;margin-top:-9px;box-sizing:border-box;border-right:6px solid #FD7C02;border-bottom:6px solid #FD7C02;border-radius:0 0 3px 0}
.webpay-mark-text{font-size:40px;font-weight:700;line-height:1}
.webpay-title{margin-top:19px;font-size:21px;font-weight:700;line-height:1.25}
.webpay-subtitle{max-width:336px;margin-top:8px;font-size:14px;line-height:1.6}
.webpay-retry{margin-top:19px;padding:0 28px;height:43px;border-radius:599px;font-size:15px;font-weight:650;line-height:43px}
.webpay-card{margin-top:14px;padding:19px 18px;border-radius:19px}
.webpay-amount{font-size:33px;font-weight:700;line-height:1.2}
.webpay-product{margin-top:4px;font-size:16px;font-weight:600;line-height:1.4}
.webpay-waiting{gap:7px;margin-top:14px;padding-top:13px;border-top:1px solid #F0F3F0;font-size:14px;line-height:1.4}
.webpay-dot{flex:0 0 auto;width:8px;height:8px;border-radius:50%}
.webpay-push-text{font-size:15px;line-height:1.6}
.webpay-push-action{margin-top:10px;padding:0 16px;height:38px;border-radius:599px;font-size:14px;font-weight:650;line-height:38px}
.webpay-card-title{margin-bottom:7px;font-size:16px;font-weight:700}
.webpay-step{gap:9px;padding:7px 0}
.webpay-step-no{flex:0 0 auto;width:24px;height:24px;border-radius:50%;font-size:13px;font-weight:700;line-height:24px}
.webpay-step-text{flex:1;min-width:0;font-size:15px;line-height:24px}
.webpay-link{margin-top:10px;padding:12px 13px;border-radius:12px}
.webpay-link-text{font-size:13px;line-height:1.5}
.webpay-note{margin-top:9px;font-size:13px;line-height:1.6}
.webpay-refresh{margin-top:14px;padding:8px 0;font-size:14px;line-height:1.2}
.payguide-intro{padding:16px 4px 14px}
.payguide-eyebrow{font-size:13px;font-weight:650;letter-spacing:1px}
.payguide-title{margin-top:8px;font-size:27px;font-weight:750;line-height:1.35}
.payguide-subtitle{margin-top:10px;font-size:15px;line-height:1.65}
.payguide-delivery{gap:8px;padding:12px 14px;border-radius:12px;font-size:13px;line-height:1.55}
.payguide-delivery-dot{flex:0 0 7px;height:7px;border-radius:50%}
.payguide-sk-delivery{height:45px;border-radius:12px}
.payguide-step{margin-top:14px;padding:18px 15px 15px;border-radius:19px}
.payguide-step-head{gap:10px}
.payguide-number{flex:0 0 27px;height:27px;border-radius:50%;font-size:15px;font-weight:700;line-height:27px}
.payguide-step-copy{flex:1;min-width:0}
.payguide-step-title{font-size:17px;font-weight:700;line-height:1.55}
.payguide-hint{margin-top:4px;font-size:14px;line-height:1.65}
.payguide-figure{margin-top:14px;border:1px solid #EEF0ED;border-radius:13px}
.payguide-mock-head{padding:12px 14px;border-bottom:1px solid #E7EAE7;font-size:14px;font-weight:650}
.payguide-mock-tools{font-size:16px}
.payguide-mock-row{gap:9px;margin:8px;padding:10px 8px;border-radius:8px}
.payguide-mock-row.is-muted{padding-top:4px;padding-bottom:4px}
.payguide-mock-row.is-highlight{box-shadow:inset 0 0 0 1px #FD7C02}
.payguide-avatar{flex:0 0 38px;height:38px;border-radius:9px}
.payguide-avatar image{width:38px;height:38px;border-radius:9px}
.payguide-logo-skeleton{width:38px;height:38px;border-radius:9px}
.payguide-lines{flex:1}
.payguide-lines view{width:42%;height:7px;border-radius:3px}
.payguide-lines view + view{width:72%;margin-top:8px;height:5px}
.payguide-mock-copy{flex:1;min-width:0}
.payguide-mock-name{font-size:15px;font-weight:600}
.payguide-mock-detail{margin-top:3px;font-size:12px;line-height:1.5}
.payguide-tap-label{right:8px;top:-9px;padding:2px 8px;border-radius:599px;font-size:11px}
.payguide-caption{padding:4px 12px 10px;font-size:11px;line-height:1.5}
.payguide-message{margin:12px;padding:14px 13px 0;border-radius:9px}
.payguide-message-title{margin-bottom:12px;font-size:15px;font-weight:600}
.payguide-message-row{gap:9px;padding-bottom:8px;font-size:12px;line-height:1.5}
.payguide-message-link{margin-top:4px;padding:10px 0;border-top:1px solid #EEF0ED;font-size:13px;font-weight:600}
.payguide-tap-ring{right:25px;bottom:7px;width:21px;height:21px;border:1px solid #FD7C02;border-radius:50%;box-shadow:0 0 0 4px rgba(253,124,2,.1)}
.payguide-figure.is-payment{padding:14px 14px 0;border-color:#181B19}
.payguide-payment-brand{font-size:12px}
.payguide-payment-title{margin-top:12px;font-size:16px;font-weight:600}
.payguide-payment-summary{flex-direction:column;gap:6px;margin-top:10px;padding:12px;border-radius:8px;font-size:12px}
.payguide-payment-button{margin:12px 0;padding:9px;border-radius:599px;font-size:13px;font-weight:600}
.payguide-payment-button .payguide-tap-ring{border-color:#FFF;box-shadow:0 0 0 4px rgba(255,255,255,.2)}
.payguide-help{padding:18px 6px 0}
.payguide-help-title{font-size:16px;font-weight:650}
.payguide-help-actions{gap:9px;margin-top:12px;flex-wrap:wrap}
.payguide-secondary, .payguide-text-button, .payguide-reopen{margin:0;padding:10px 14px;border-radius:599px;font-size:14px;line-height:1.5}
.payguide-reopen{margin:14px auto 0}
.payguide-secondary::after, .payguide-text-button::after, .payguide-reopen::after{border:0}
.webpay-bar{right:max(0px, 50% - var(--lg-col) / 2);bottom:0;left:max(0px, 50% - var(--lg-col) / 2);gap:12px;padding:10px 19px calc(10px + env(safe-area-inset-bottom));box-shadow:0 -5px 14px rgba(36, 51, 45, .06)}
.webpay-button{flex:1;min-width:0;height:52px;margin:0;padding:0;border:0;border-radius:599px;font-size:16px;font-weight:650;line-height:52px}
.webpay-button::after{border:0}
.webpay-sk-amount{width:132px;height:38px}
.webpay-sk-product{width:168px;margin-top:8px}
.webpay-sk-link{width:100%;height:43px;margin-top:10px;border-radius:12px}
.webpay-sk-button{flex:1;height:52px;border-radius:599px}
}
