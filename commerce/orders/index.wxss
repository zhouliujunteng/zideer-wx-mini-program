.orders-page { min-height: 100vh; padding: 48rpx 28rpx calc(env(safe-area-inset-bottom) + 48rpx); }.orders-head { padding: 0 8rpx; }.orders-eyebrow { display: block; color: var(--accent-deep); font-size: 22rpx; font-weight: 700; }.orders-title { display: block; margin-top: 12rpx; font-size: 42rpx; font-weight: 700; }.orders-tabs { display: flex; gap: 16rpx; margin: 32rpx 0 22rpx; }.orders-tab { flex: 1; min-height: 64rpx; border: 1rpx solid var(--line); border-radius: 6rpx; background: var(--surface); color: var(--muted); font-size: 23rpx; }.orders-tab.is-active { border-color: var(--ink); color: var(--ink); font-weight: 700; }.order-list { display: grid; gap: 18rpx; }.order-card { display: block; width: 100%; padding: 26rpx; text-align: left; }.order-card__head, .order-card__foot { display: flex; align-items: center; justify-content: space-between; gap: 18rpx; }.order-card__head { font-size: 27rpx; font-weight: 700; }.order-card__status { color: var(--accent-deep); font-size: 22rpx; }.order-card__student { display: block; margin-top: 14rpx; color: var(--muted); font-size: 22rpx; }.order-card__foot { margin-top: 22rpx; color: var(--ink-soft); font-size: 22rpx; }.order-card__foot text:last-child { color: var(--ink); font-size: 29rpx; font-weight: 700; }.order-empty { margin-top: 28rpx; padding: 32rpx; color: var(--muted); font-size: 24rpx; }
