@import "../../styles/skeleton.wxss";
/* 订单记录：整页照设计师「结算明细」（package-promotion/pages/settlement-records，正式版 agent/settlement-records）——
   顶栏、#EEF1EF 底的筛选页签（选中白色、外侧反圆角）、白色 40rpx 列表卡、按月分组；
   条目照课程积分明细（M34，commerce/entitlements 的 record-*）：标题 + 金额 / 说明 / 时间 + 状态标签。 */
page { background: #FAFAFA; }

.orders-page { position: relative; height: 100vh; overflow: hidden; background: #FAFAFA; color: #24332D; }
.orders-topbar { position: fixed; top: 0; right: 0; left: 0; z-index: 20; box-sizing: border-box; background: #FAFAFA; }
.orders-topbar-inner { position: relative; display: flex; align-items: center; box-sizing: content-box; padding: 0 32rpx 8rpx; }
.orders-back { display: flex; flex: 0 0 auto; align-items: center; justify-content: center; width: 54rpx; height: 54rpx; border-radius: 50%; }
.orders-back:active { background: #F0F2EF; }
.orders-back-icon { width: 22rpx; height: 22rpx; border-bottom: 4rpx solid #24332D; border-left: 4rpx solid #24332D; transform: rotate(45deg) scale(.7); }
.orders-topbar-title { position: absolute; left: 50%; display: block; color: #24332D; font-size: 36rpx; font-weight: 700; letter-spacing: -1rpx; transform: translateX(-50%); white-space: nowrap; }
.orders-shell { height: 100vh; padding: 0 32rpx; box-sizing: border-box; }

.orders-state { padding: 120rpx 24rpx 40rpx; text-align: center; }
.orders-state-title { display: block; color: #24332D; font-size: 32rpx; font-weight: 600; }
.orders-state-copy { display: block; margin: 22rpx 0 32rpx; color: #7D877F; font-size: 25rpx; line-height: 1.6; }
.orders-state-action { display: inline-flex; height: 76rpx; align-items: center; padding: 0 44rpx; border-radius: 999rpx; background: #FD7C02; color: #FFFFFF; font-size: 26rpx; font-weight: 600; }
.orders-state-action:active { opacity: .78; }

.orders-module { margin-top: 2rpx; overflow: hidden; border-radius: 40rpx; background: #FFFFFF; }
.orders-tabs { display: flex; width: 100%; height: 76rpx; align-items: flex-end; border-radius: 26rpx 26rpx 0 0; background: #EEF1EF; overflow: visible; }
.orders-tab { position: relative; display: flex; height: 76rpx; flex: 1; align-items: center; justify-content: center; color: #89948D; font-size: 24rpx; line-height: 1; text-align: center; }
.orders-tab.is-selected { z-index: 2; border-radius: 26rpx 26rpx 0 0; background: #FFFFFF; color: #4A514C; font-weight: 650; }
/* 选中页签底部用遮罩补齐外侧圆角，与结算明细、课程积分页一致。 */
.orders-tab.is-selected::before, .orders-tab.is-selected::after { position: absolute; bottom: 0; width: 32rpx; height: 32rpx; background: inherit; content: ''; pointer-events: none; -webkit-mask-image: radial-gradient(100% 100% at center, transparent 49%, #000 51%); mask-image: radial-gradient(100% 100% at center, transparent 49%, #000 51%); -webkit-mask-size: 200% 200%; mask-size: 200% 200%; }
.orders-tab.is-selected::before { left: -32rpx; -webkit-mask-position: 100% 100%; mask-position: 100% 100%; }
.orders-tab.is-selected::after { right: -32rpx; -webkit-mask-position: 0 100%; mask-position: 0 100%; }
.orders-tab:first-child.is-selected::before { display: none; }
.orders-tab:last-child.is-selected::after { display: none; }

.orders-list-card, .orders-sk-card { padding: 8rpx 24rpx; box-sizing: border-box; border-radius: 0 0 40rpx 40rpx; background: #FFFFFF; }
.order-group { display: block; }
.order-month { display: flex; align-items: center; padding: 18rpx 0 8rpx; color: #A1AAA4; font-size: 22rpx; font-weight: 500; line-height: 1; }
.order-item { display: flex; min-height: 146rpx; }
.order-item:active { opacity: .6; }
.order-copy { min-width: 0; flex: 1; padding: 30rpx 0 24rpx; border-bottom: 2rpx solid #F0F3F0; }
.order-group .order-item:last-child .order-copy, .orders-sk-card .order-item:last-child .order-copy { border-bottom: 0; }
.order-title-row, .order-meta { display: flex; align-items: center; justify-content: space-between; }
.order-title { min-width: 0; overflow: hidden; color: #24332D; font-size: 26rpx; font-weight: 600; line-height: 1.2; text-overflow: ellipsis; white-space: nowrap; }
.order-amount { flex: 0 0 auto; margin-left: 16rpx; color: #24332D; font-size: 30rpx; font-weight: 500; line-height: 1; }
.order-amount.closed { color: #A0AAA3; }
.order-detail { display: block; margin-top: 12rpx; overflow: hidden; color: #98A39B; font-size: 21rpx; line-height: 1.2; text-overflow: ellipsis; white-space: nowrap; }
.order-meta { margin-top: 13rpx; color: #98A39B; font-size: 19rpx; line-height: 1; }
.order-status { padding: 6rpx 12rpx; border-radius: 999rpx; background: #F1F3F1; color: #7E8982; font-size: 18rpx; }
.order-status.pending { background: #FFF0E2; color: #E78435; }
.order-status.paid { background: #E8F6EF; color: #2E9A66; }
.order-status.refunded { background: #EAF3FF; color: #4C8AD6; }
.orders-empty { display: flex; min-height: 280rpx; align-items: center; justify-content: center; flex-direction: column; color: #8C9991; }
.orders-empty text:first-child { color: #4E6157; font-size: 28rpx; font-weight: 650; }
.orders-empty text:last-child { margin-top: 14rpx; font-size: 20rpx; }

/* 首次加载骨架：与列表卡同样的内边距，月份行 + 订单行（标题、金额、说明、时间、状态） */
.orders-sk-month { width: 120rpx; height: 22rpx; margin: 18rpx 0 8rpx; }
.order-title-row .orders-sk-title { width: 46%; margin-top: 0; }
.order-title-row .orders-sk-amount { width: 96rpx; margin-top: 0; }
.order-copy .orders-sk-detail { width: 58%; height: 20rpx; margin-top: 14rpx; }
.order-meta .orders-sk-time { width: 150rpx; height: 18rpx; margin-top: 0; }
.orders-sk-status { width: 76rpx; height: 30rpx; border-radius: 999rpx; }

@media (max-width: 350px) {
  .orders-shell { padding-right: 28rpx; padding-left: 28rpx; }
  .orders-tab { font-size: 22rpx; }
}

@import "./index.large.wxss"; /* 平板、电脑大屏样式：由 scripts/build-large-screen-styles.mjs 生成，改完本文件后重跑；这一行须留在文件末尾 */
