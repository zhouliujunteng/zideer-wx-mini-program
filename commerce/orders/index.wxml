<view class="orders-page"><view class="orders-head"><text class="orders-eyebrow">购买记录</text><text class="orders-title">订单</text></view><view class="orders-tabs"><button class="orders-tab {{status === 'all' ? 'is-active' : ''}}" data-status="all" bindtap="chooseStatus">全部</button><button class="orders-tab {{status === '待支付' ? 'is-active' : ''}}" data-status="待支付" bindtap="chooseStatus">待支付</button><button class="orders-tab {{status === '已支付' ? 'is-active' : ''}}" data-status="已支付" bindtap="chooseStatus">已支付</button></view><view class="commerce-skeleton skeleton" wx:if="{{loading}}"></view><view class="state-panel" wx:elif="{{failed}}"><view class="state-panel__mark">!</view><text class="state-panel__title">订单暂时无法加载</text><button class="state-panel__action pressable" bindtap="loadPage">重新加载</button></view><view class="order-empty surface" wx:elif="{{!orders.length}}">暂时没有订单记录</view><view class="order-list" wx:else><button class="order-card surface pressable" wx:for="{{orders}}" wx:key="id" wx:if="{{status === 'all' || status === item.status}}" data-id="{{item.id}}" bindtap="openOrder"><view class="order-card__head"><text>{{item.title}}</text><text class="order-card__status">{{item.statusLabel}}</text></view><text class="order-card__student">受益学生：{{item.beneficiaryName}}</text><view class="order-card__foot"><text>{{item.order_no || '订单处理中'}}</text><text>¥{{item.amountDisplay}}</text></view></button></view></view>
