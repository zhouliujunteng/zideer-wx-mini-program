<view class="request-page">
  <view class="commerce-skeleton skeleton" wx:if="{{loading}}"></view>
  <block wx:else>
    <view class="request-head"><text class="request-eyebrow">课程积分</text><text class="request-title">申请推广伙伴</text></view>
    <view class="request-card surface" wx:if="{{attribution}}"><text class="request-label">已建立推广归因</text><text class="request-name">{{attribution.promoter.display_name || '推广伙伴'}}</text><text class="request-copy">当前账户已具备购买资格。</text></view>
    <view class="request-card surface" wx:elif="{{request && request.status === 'pending'}}"><text class="request-label">申请状态</text><text class="request-name">{{request.statusLabel}}</text><text class="request-copy">提交于 {{request.submitted_at || ''}}</text><button class="request-secondary pressable" loading="{{submitting}}" bindtap="cancel">撤回申请</button></view>
    <view class="request-card surface" wx:else><view class="field"><text class="field-label">联系方式</text><input class="field-input" value="{{form.contact}}" placeholder="手机号或微信号" bindinput="updateContact" /></view><view class="field"><text class="field-label">所在地区</text><input class="field-input" value="{{form.region}}" placeholder="例如：广东深圳" bindinput="updateRegion" /></view><view class="field"><text class="field-label">方便联系时间</text><input class="field-input" value="{{form.availableTime}}" placeholder="例如：工作日 19:00 后" bindinput="updateAvailableTime" /></view><button class="request-primary pressable" loading="{{submitting}}" bindtap="submit">提交申请</button></view>
  </block>
</view>
