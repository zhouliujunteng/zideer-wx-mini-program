@import "../../styles/account-form.wxss";
@import "../../styles/skeleton.wxss";
.request-page { min-height: 100vh; padding: 48rpx 28rpx calc(env(safe-area-inset-bottom) + 48rpx); }.request-head { padding: 0 8rpx; }.request-eyebrow { display: block; color: var(--accent-deep); font-size: 22rpx; font-weight: 700; }.request-title { display: block; margin-top: 12rpx; font-size: 42rpx; font-weight: 700; }.request-card { margin-top: 34rpx; padding: 30rpx; }.request-label, .request-name, .request-copy { display: block; }.request-label { color: var(--accent-deep); font-size: 22rpx; font-weight: 700; }.request-name { margin-top: 12rpx; font-size: 32rpx; font-weight: 700; }.request-copy { margin-top: 16rpx; color: var(--ink-soft); font-size: 24rpx; line-height: 1.7; }.field + .field { margin-top: 28rpx; }.field-label { display: block; color: var(--ink-soft); font-size: 23rpx; }.field-input { box-sizing: border-box; width: 100%; height: 82rpx; margin-top: 14rpx; padding: 0 20rpx; border: 1rpx solid var(--line); border-radius: 6rpx; background: #fff; font-size: 26rpx; }.request-primary, .request-secondary { width: 100%; min-height: 88rpx; margin-top: 34rpx; border-radius: 6rpx; font-size: 27rpx; }.request-primary { background: var(--ink); color: #fff; }.request-secondary { border: 1rpx solid var(--line); background: #fff; color: var(--ink); }
/* 首次加载骨架 */
.request-sk-title { width: 48%; height: 40rpx; margin: 16rpx 0 24rpx; }.request-sk-button { height: 88rpx; margin-top: 34rpx; border-radius: 6rpx; }

@import "./index.large.wxss"; /* 平板、电脑大屏样式：由 scripts/build-large-screen-styles.mjs 生成，改完本文件后重跑；这一行须留在文件末尾 */
