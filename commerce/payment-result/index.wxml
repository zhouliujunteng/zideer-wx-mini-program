<view class="result-page"><view class="commerce-skeleton skeleton" wx:if="{{loading}}"></view><block wx:else><view class="result-icon">{{order && order.status === '已支付' ? '✓' : '!'}}</view><text class="result-title">{{order && order.status === '已支付' ? '支付已完成' : '订单正在等待支付结果'}}</text><text class="result-copy">{{order && order.status === '已支付' ? '课程积分已由服务端支付回调发放。' : '支付回调可能需要一点时间，刷新后会读取服务端最新订单状态。'}}</text><view class="result-card surface"><view wx:if="{{orderNo}}"><text>订单编号</text><text>{{orderNo}}</text></view><view><text>订单金额</text><text>¥{{amount}}</text></view><view wx:if="{{order}}"><text>当前状态</text><text>{{order.statusLabel}}</text></view></view><button class="result-primary pressable" wx:if="{{order && order.status !== '已支付'}}" loading="{{paying}}" disabled="{{paying}}" bindtap="continuePayment">{{paying ? '正在发起支付' : '继续支付'}}</button><button class="result-primary pressable" bindtap="goOrder">查看订单详情</button><button class="result-secondary pressable" bindtap="goCredits">查看课程积分</button><button class="result-secondary pressable" bindtap="goProducts">返回商城</button></block></view>
