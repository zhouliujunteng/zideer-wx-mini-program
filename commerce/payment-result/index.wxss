.result-page { min-height:100vh; padding:112rpx 28rpx calc(env(safe-area-inset-bottom) + 48rpx); text-align:center; }.result-icon { display:flex; align-items:center; justify-content:center; width:88rpx; height:88rpx; margin:0 auto; border-radius:50%; background:#FFF3CF; color:#9E7100; font-size:46rpx; font-weight:700; }.result-title { display:block; margin-top:28rpx; font-size:38rpx; font-weight:700; }.result-copy { display:block; margin:16rpx auto 0; max-width:590rpx; color:var(--muted); font-size:23rpx; line-height:1.65; }.result-card { margin-top:38rpx; padding:0 26rpx; text-align:left; }.result-card view { display:flex; justify-content:space-between; gap:20rpx; padding:27rpx 0; border-bottom:1rpx solid var(--line); color:var(--ink-soft); font-size:23rpx; }.result-card view:last-child { border-bottom:0; }.result-card text:last-child { color:var(--ink); text-align:right; overflow-wrap:anywhere; }.result-primary,.result-secondary { width:100%; min-height:88rpx; border-radius:8rpx; font-size:27rpx; font-weight:700; }.result-primary { margin-top:42rpx; background:var(--ink); color:#fff; }.result-secondary { margin-top:18rpx; background:#fff; color:var(--ink); border:1rpx solid var(--line); }
