.commerce-page { min-height: 100vh; padding: 52rpx 28rpx calc(env(safe-area-inset-bottom) + 48rpx); }.commerce-head { padding: 0 8rpx; }.commerce-eyebrow { display: block; color: var(--accent-deep); font-size: 22rpx; font-weight: 700; }.commerce-title-row { display: flex; align-items: center; justify-content: space-between; gap: 24rpx; margin-top: 12rpx; }.commerce-title { display: block; font-size: 42rpx; font-weight: 700; }.commerce-link { min-height: 60rpx; color: var(--accent-deep); font-size: 23rpx; }.commerce-copy { display: block; margin-top: 12rpx; color: var(--muted); font-size: 22rpx; line-height: 1.55; }.commerce-skeleton { height: 260rpx; margin-top: 42rpx; }.product-list { margin-top: 34rpx; }.product-card { width: 100%; padding: 28rpx; margin-top: 18rpx; text-align: left; }.product-card__top { display: flex; align-items: baseline; justify-content: space-between; gap: 18rpx; }.product-card__name { min-width: 0; font-size: 29rpx; font-weight: 700; overflow-wrap: anywhere; }.product-card__amount { flex: none; color: var(--accent-deep); font-size: 31rpx; font-weight: 700; }.product-card__copy { display: block; margin-top: 14rpx; color: var(--ink-soft); font-size: 22rpx; line-height: 1.55; }.product-card__facts { display: flex; flex-wrap: wrap; gap: 12rpx 20rpx; margin-top: 22rpx; color: var(--green); font-size: 22rpx; font-weight: 600; }
