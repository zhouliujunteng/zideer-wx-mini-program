/* 自动生成，请勿手改：index.wxss 在平板、电脑大屏（窗口宽 ≥ 450px）下的样式。
   rpx 按 1rpx = 0.6px 换算，固定定位元素收进居中栏；改完源文件后运行 node scripts/build-large-screen-styles.mjs */
@media (min-width: 450px) {
.sk{border-radius:7px}
.sk-line{height:16px}
.sk-line + .sk-line{margin-top:8px}
.sk-short{width:40%}
.sk-mid{width:64%}
.sk-round{border-radius:50%}
.sk-card{height:96px;border-radius:14px}
.sk-card + .sk-card{margin-top:12px}
.packs-page{height:100vh}
.packs-ambient{top:0;left:max(0px, 50% - var(--lg-col) / 2);width:min(100%, var(--lg-col));height:100%}
.packs-ambient-ribbon{top:-84px;left:-258px;width:888px;height:432px;box-sizing:border-box;border:14px solid rgba(255, 255, 255, .72);border-top-color:transparent;border-right-color:transparent;border-radius:50%}
.packs-topbar{top:0;left:max(0px, 50% - var(--lg-col) / 2);width:min(100%, var(--lg-col));box-sizing:border-box}
.packs-topbar-inner{box-sizing:content-box;padding:0 19px 9px}
.packs-back{width:32px;height:32px;border-radius:50%}
.packs-back-icon{width:13px;height:13px;border-bottom:2px solid #24332D;border-left:2px solid #24332D}
.packs-topbar-title{left:50%;font-size:21px;font-weight:700;letter-spacing:-1px}
.packs-scroll{height:100vh;box-sizing:border-box}
.packs-shell{min-height:100%;padding:0 19px calc(28px + env(safe-area-inset-bottom));box-sizing:border-box}
.packs-shell.has-buy-bar{padding-bottom:calc(120px + env(safe-area-inset-bottom))}
.packs-overview{padding:4px 4px 4px}
.packs-overview-copy{min-width:0}
.balance-eyebrow{font-size:17px;font-weight:700;line-height:1.25}
.balance-value{margin-top:8px;font-size:52px;font-weight:500;letter-spacing:-2px;line-height:.95}
.balance-links{padding-top:9px;font-size:12px;line-height:1.2}
.balance-frozen{margin-right:14px}
.balance-link{padding:3px 0}
.balance-link-icon{width:7px;height:7px;margin-left:2px;border-top:1px solid #AAB4AD;border-right:1px solid #AAB4AD}
.balance-icon{width:105px;height:108px;margin:-3px 2px 0 9px}
.member-strip{margin-top:14px;padding:9px 14px;border:1px solid #fff;border-radius:16px}
.member-strip-crown{width:28px;height:24px;margin-right:8px}
.member-strip-copy{min-width:0;font-size:14px;font-weight:600;line-height:1.3}
.member-strip-action{margin-left:7px;font-size:13px}
.packs-heading{margin-top:22px;padding:0 2px;font-size:18px;font-weight:700;line-height:1.2}
.packs-grid{grid-template-columns:repeat(2, minmax(0, 1fr));gap:12px;margin-top:12px}
.pack-card{min-width:0;min-height:141px;padding:15px 14px 13px;box-sizing:border-box;border:1px solid transparent;border-radius:19px}
.pack-card.is-selected{border-color:#FD7C02}
.pack-check{top:0;right:0;width:31px;height:25px;border-radius:0 15px 0 13px}
.pack-check-mark{width:10px;height:5px;margin-top:-3px;box-sizing:border-box;border-bottom:2px solid #fff;border-left:2px solid #fff}
.pack-credits-value{font-size:28px;font-weight:700;letter-spacing:-1px;line-height:1.1}
.pack-credits-unit{margin-left:3px;font-size:13px}
.pack-name{margin-top:3px;font-size:13px;line-height:1.35}
.pack-price-row{margin-top:10px}
.pack-yuan{margin-right:1px;font-size:13px;font-weight:600}
.pack-price{font-size:22px;font-weight:700;line-height:1.1}
.pack-list-price{margin-left:6px;font-size:12px}
.pack-foot{gap:4px 7px;margin-top:7px}
.pack-member-tag{padding:2px 7px;border-radius:599px;font-size:11px;line-height:1.4}
.pack-course{font-size:11px;line-height:1.4}
.packs-rules{margin-top:12px;padding:2px 15px;border-radius:19px}
.packs-rules-intro{padding:13px 0 10px;border-bottom:1px solid #F0F3F0;font-size:13px;line-height:1.6}
.packs-rule{gap:14px;padding:14px 0;border-bottom:1px solid #F0F3F0;font-size:13px;line-height:1.5}
.packs-rule:last-child{border-bottom:0}
.packs-rule-value{max-width:64%}
.packs-note{margin:10px 3px 0;font-size:12px;line-height:1.6}
.packs-state{margin-top:19px;padding:38px 21px 33px;border-radius:19px}
.packs-state-title{font-size:17px;font-weight:650;line-height:1.4}
.packs-state-copy{margin-top:7px;font-size:13px;line-height:1.6}
.packs-state-action{margin-top:16px;padding:0 28px;height:43px;border-radius:599px;font-size:15px;font-weight:650;line-height:43px}
.packs-state-link{margin-top:13px;font-size:13px;line-height:1.4}
.buy-bar{right:max(0px, 50% - var(--lg-col) / 2);bottom:0;left:max(0px, 50% - var(--lg-col) / 2);gap:14px;padding:10px 19px calc(10px + env(safe-area-inset-bottom));box-shadow:0 -5px 14px rgba(36, 51, 45, .06)}
.buy-bar-copy{min-width:0}
.buy-bar-label{margin-right:6px;font-size:13px}
.buy-bar-yuan{font-size:14px;font-weight:600}
.buy-bar-amount{margin-left:1px;font-size:26px;font-weight:700;line-height:1.1}
.buy-bar-sub{margin-top:2px;font-size:12px}
.buy-button{height:52px;padding:0 33px;border-radius:599px;font-size:16px;font-weight:650;line-height:52px}
.balance-value-skeleton{width:120px;height:48px;margin-top:8px}
.pack-sk-credits{width:90px;height:30px}
.pack-card .pack-sk-name{height:13px;margin-top:9px}
.pack-sk-price{width:72px;height:24px;margin-top:15px}
.pack-sk-rule{width:132px;height:14px}
}
