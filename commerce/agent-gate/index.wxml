<view class="gate-page"><view class="gate-head"><text class="gate-eyebrow">课程积分</text><text class="gate-title">购买资格</text></view><view class="gate-card surface" wx:if="{{!loaded && !failed}}"><view class="sk sk-line sk-short"></view><view class="sk gate-sk-title"></view><view class="sk sk-line"></view><view class="sk sk-line sk-mid"></view><view class="sk gate-sk-button"></view></view><view class="state-panel" wx:elif="{{!loaded}}"><view class="state-panel__mark">!</view><text class="state-panel__title">购买资格暂时无法加载</text><button class="state-panel__action pressable" bindtap="loadPage">重新加载</button></view><block wx:elif="{{eligibility}}"><view class="gate-card surface" wx:if="{{eligibility.eligible}}"><text class="gate-card__label">当前邀请人</text><text class="gate-card__title">{{eligibility.promoter.name}}</text><text class="gate-card__copy">已有推荐人，可以购买积分包。</text><view class="gate-fact" wx:if="{{eligibility.attribution.sourceLabel}}"><text>归因来源</text><text>{{eligibility.attribution.sourceLabel}}</text></view><button wx:if="{{paymentOpen}}" class="gate-primary pressable" bindtap="goProducts">进入课程积分商城</button></view><view class="gate-card surface" wx:else><text class="gate-card__label">暂未获得购买资格</text><text class="gate-card__title">需要先有推荐人</text><text class="gate-card__copy">在积分包页填写邀请人的邀请码即可购买；没有邀请码也可以申请分配推广伙伴，服务团队处理后即可购买。</text><button class="gate-primary pressable" bindtap="openAssignmentRequest">申请分配推广伙伴</button></view></block></view>
<dev-reset-fab />
