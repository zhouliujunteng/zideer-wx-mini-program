<view class="gate-page"><view class="commerce-skeleton skeleton" wx:if="{{loading}}"></view><view class="state-panel" wx:elif="{{failed}}"><view class="state-panel__mark">!</view><text class="state-panel__title">购买资格暂时无法加载</text><button class="state-panel__action pressable" bindtap="loadPage">重新加载</button></view><block wx:elif="{{eligibility}}"><view class="gate-head"><text class="gate-eyebrow">课程积分</text><text class="gate-title">购买资格</text></view><view class="gate-card surface" wx:if="{{eligibility.eligible}}"><text class="gate-card__label">当前邀请人</text><text class="gate-card__title">{{eligibility.promoter.name}}</text><text class="gate-card__copy">已建立有效推广归因，可以购买课程积分。</text><view class="gate-fact" wx:if="{{eligibility.attribution.source_type}}"><text>归因来源</text><text>{{eligibility.attribution.source_type}}</text></view><button class="gate-primary pressable" bindtap="goProducts">进入课程积分商城</button></view><view class="gate-card surface" wx:else><text class="gate-card__label">暂未获得购买资格</text><text class="gate-card__title">需要先建立推广归因</text><text class="gate-card__copy">可提交推广伙伴分配申请。提交后由服务团队处理，建立有效归因后即可购买。</text><button class="gate-primary pressable" bindtap="openAssignmentRequest">申请分配推广伙伴</button></view></block></view>
