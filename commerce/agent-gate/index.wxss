.gate-page { min-height: 100vh; padding: 48rpx 28rpx calc(env(safe-area-inset-bottom) + 48rpx); }.gate-head { padding: 0 8rpx; }.gate-eyebrow { display: block; color: var(--accent-deep); font-size: 22rpx; font-weight: 700; }.gate-title { display: block; margin-top: 12rpx; font-size: 42rpx; font-weight: 700; }.gate-card { margin-top: 34rpx; padding: 30rpx; }.gate-card__label, .gate-card__title, .gate-card__copy { display: block; }.gate-card__label { color: var(--accent-deep); font-size: 22rpx; font-weight: 700; }.gate-card__title { margin-top: 12rpx; font-size: 32rpx; font-weight: 700; }.gate-card__copy { margin-top: 16rpx; color: var(--ink-soft); font-size: 24rpx; line-height: 1.7; }.gate-fact { display: flex; justify-content: space-between; gap: 20rpx; margin-top: 28rpx; padding-top: 22rpx; border-top: 1rpx solid var(--line); color: var(--muted); font-size: 22rpx; }.gate-primary { width: 100%; min-height: 88rpx; margin-top: 32rpx; border-radius: 6rpx; background: var(--ink); color: #fff; font-size: 27rpx; }
