/* 自动生成，请勿手改：index.wxss 在平板、电脑大屏（窗口宽 ≥ 450px）下的样式。
   rpx 按 1rpx = 0.6px 换算，固定定位元素收进居中栏；改完源文件后运行 node scripts/build-large-screen-styles.mjs */
@media (min-width: 450px) {
.surface{border-radius:14px}
.skeleton{border-radius:9px}
.state-panel{padding:72px 14px 24px}
.state-panel__mark{margin-bottom:14px;font-size:31px}
.state-panel__title{font-size:19px;font-weight:600}
.state-panel__copy{margin:13px 0 19px;font-size:15px;line-height:1.6}
.state-panel__action{border-radius:12px}
.state-panel__action::after{border:0}
.sk{border-radius:7px}
.sk-line{height:16px}
.sk-line + .sk-line{margin-top:8px}
.sk-short{width:40%}
.sk-mid{width:64%}
.sk-round{border-radius:50%}
.sk-card{height:96px;border-radius:14px}
.sk-card + .sk-card{margin-top:12px}
.gate-page{min-height:100vh;padding:28px 16px calc(env(safe-area-inset-bottom) + 28px)}
.gate-head{padding:0 4px}
.gate-eyebrow{font-size:13px;font-weight:700}
.gate-title{margin-top:7px;font-size:25px;font-weight:700}
.gate-card{margin-top:20px;padding:18px}
.gate-card__label{font-size:13px;font-weight:700}
.gate-card__title{margin-top:7px;font-size:19px;font-weight:700}
.gate-card__copy{margin-top:9px;font-size:14px;line-height:1.7}
.gate-fact{gap:12px;margin-top:16px;padding-top:13px;border-top:0.5px solid var(--line);font-size:13px}
.gate-primary{width:100%;min-height:52px;margin-top:19px;border-radius:3px;font-size:16px}
.gate-sk-title{width:48%;height:24px;margin:9px 0 14px}
.gate-sk-button{height:52px;margin-top:19px;border-radius:3px}
}
