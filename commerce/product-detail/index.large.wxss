/* 自动生成，请勿手改：index.wxss 在平板、电脑大屏（窗口宽 ≥ 450px）下的样式。
   rpx 按 1rpx = 0.6px 换算，固定定位元素收进居中栏；改完源文件后运行 node scripts/build-large-screen-styles.mjs */
@media (min-width: 450px) {
.surface{border-radius:14px}
.skeleton{border-radius:9px}
.state-panel{padding:72px 14px 24px}
.state-panel__mark{margin-bottom:14px;font-size:31px}
.state-panel__title{font-size:19px;font-weight:600}
.state-panel__copy{margin:13px 0 19px;font-size:15px;line-height:1.6}
.state-panel__action{border-radius:12px}
.state-panel__action::after{border:0}
.sk{border-radius:7px}
.sk-line{height:16px}
.sk-line + .sk-line{margin-top:8px}
.sk-short{width:40%}
.sk-mid{width:64%}
.sk-round{border-radius:50%}
.sk-card{height:96px;border-radius:14px}
.sk-card + .sk-card{margin-top:12px}
.detail-page{min-height:100vh;padding:31px 16px calc(env(safe-area-inset-bottom) + 28px)}
.commerce-skeleton{height:192px}
.detail-head{padding:0 4px}
.detail-eyebrow{font-size:13px;font-weight:700}
.detail-title{margin-top:7px;font-size:25px;font-weight:700}
.detail-description{margin-top:8px;font-size:13px;line-height:1.6}
.price-panel{margin-top:20px;padding:18px;font-size:13px}
.price-panel__amount{margin-top:6px;font-size:30px;font-weight:700}
.price-panel__credits{margin-top:6px;font-weight:600}
.detail-section{margin-top:12px;padding:0 15px}
.detail-row{gap:14px;padding:15px 0;border-bottom:0.5px solid var(--line);font-size:13px;line-height:1.5}
.detail-row:last-child{border-bottom:0}
.detail-row text:last-child{max-width:62%}
.detail-notice{margin:13px 4px;font-size:12px;line-height:1.55}
.detail-action{width:100%;min-height:55px;margin-top:10px;border-radius:4px;font-size:16px;font-weight:700}
.price-panel__member{margin-top:4px;font-size:13px}
.detail-sk-title{width:56%;height:26px;margin-top:9px}
.detail-head .detail-sk-description{margin-top:10px}
.price-sk-amount{width:120px;height:32px;margin-top:8px}
.price-panel .price-sk-credits{margin-top:8px}
.detail-sk-value{width:120px}
}
