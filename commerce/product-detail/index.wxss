.detail-page { min-height: 100vh; padding: 52rpx 28rpx calc(env(safe-area-inset-bottom) + 48rpx); }.commerce-skeleton { height: 320rpx; }.detail-head { padding: 0 8rpx; }.detail-eyebrow { display:block; color: var(--accent-deep); font-size:22rpx; font-weight:700; }.detail-title { display:block; margin-top:12rpx; font-size:42rpx; font-weight:700; overflow-wrap:anywhere; }.detail-description { display:block; margin-top:14rpx; color:var(--muted); font-size:23rpx; line-height:1.6; }.price-panel { display:flex; flex-direction:column; margin-top:34rpx; padding:30rpx; color:var(--ink-soft); font-size:23rpx; }.price-panel__amount { margin-top:10rpx; color:var(--accent-deep); font-size:50rpx; font-weight:700; }.price-panel__credits { margin-top:10rpx; color:var(--green); font-weight:600; }.detail-section { margin-top:20rpx; padding:0 26rpx; }.detail-row { display:flex; align-items:flex-start; justify-content:space-between; gap:24rpx; padding:26rpx 0; border-bottom:1rpx solid var(--line); color:var(--ink-soft); font-size:23rpx; line-height:1.5; }.detail-row:last-child { border-bottom:0; }.detail-row text:last-child { max-width:62%; color:var(--ink); text-align:right; overflow-wrap:anywhere; }.detail-notice { display:block; margin:22rpx 8rpx; color:var(--muted); font-size:21rpx; line-height:1.55; }.detail-action { width:100%; min-height:92rpx; margin-top:18rpx; border-radius:8rpx; background:var(--ink); color:#fff; font-size:28rpx; font-weight:700; }
