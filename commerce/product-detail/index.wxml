<view class="detail-page">
  <view class="state-panel" wx:if="{{failed && !loaded}}"><view class="state-panel__mark">!</view><text class="state-panel__title">商品暂时没有加载出来</text><button class="state-panel__action pressable" bindtap="loadPage">重新加载</button></view>
  <block wx:else>
    <view class="detail-head"><text class="detail-eyebrow">课程积分商品</text><block wx:if="{{loaded}}"><text class="detail-title">{{product.name}}</text><text class="detail-description">{{product.description}}</text></block><block wx:else><view class="sk detail-sk-title"></view><view class="sk sk-line sk-mid detail-sk-description"></view></block></view>
    <view class="price-panel surface" wx:if="{{loaded}}"><text>本次购买</text><text class="price-panel__amount">¥{{product.payableAmount}}</text><text wx:if="{{product.memberPriceApplied}}" class="price-panel__member">会员价，原价 ¥{{product.amount}}</text><text wx:elif="{{product.memberAmount}}" class="price-panel__member">会员价 ¥{{product.memberAmount}}，开通会员后可享</text><text class="price-panel__credits">发放 {{product.credits}} 课程积分</text></view>
    <view class="price-panel surface" wx:else><text>本次购买</text><view class="sk price-sk-amount"></view><view class="sk sk-line sk-short price-sk-credits"></view></view>
    <view class="detail-section surface"><view class="detail-row"><text>预计课程数</text><text wx:if="{{loaded}}">{{estimatedCourseText}}</text><view wx:else class="sk sk-line detail-sk-value"></view></view><view class="detail-row"><text>有效期</text><text wx:if="{{loaded}}">{{validityText}}</text><view wx:else class="sk sk-line detail-sk-value"></view></view><view class="detail-row"><text>教师服务</text><text wx:if="{{loaded}}">{{serviceText}}</text><view wx:else class="sk sk-line detail-sk-value"></view></view><view class="detail-row"><text>退款规则</text><text wx:if="{{loaded}}">{{refundText}}</text><view wx:else class="sk sk-line detail-sk-value"></view></view></view>
    <text class="detail-notice">课程数量仅为购买前估算。课程积分按实际课程内容生成消耗结算。</text>
    <button class="detail-action pressable" wx:if="{{loaded}}" bindtap="goConfirm">确认商品</button>
  </block>
</view>
<dev-reset-fab />
