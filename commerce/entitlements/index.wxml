<view class="credit-page">
  <view class="credit-head"><text class="credit-eyebrow">课程积分</text><text class="credit-title">我的积分</text></view>
  <view class="commerce-skeleton skeleton" wx:if="{{loading}}"></view>
  <view class="state-panel" wx:elif="{{failed}}"><view class="state-panel__mark">!</view><text class="state-panel__title">积分账户暂时没有加载出来</text><button class="state-panel__action pressable" bindtap="loadPage">重新加载</button></view>
  <block wx:elif="{{account}}"><view class="credit-balance surface"><text class="credit-balance__label">可用课程积分</text><text class="credit-balance__value">{{account.available}}</text><view class="credit-balance__facts"><text>冻结 {{account.frozen}}</text><text>已用 {{account.consumed}}</text><text>到期 {{account.expired}}</text></view></view><view class="credit-section"><text class="credit-section__title">积分批次</text><view class="credit-empty surface" wx:if="{{!batches.length}}">暂时没有课程积分批次</view><view class="credit-list surface" wx:else><view class="credit-row" wx:for="{{batches}}" wx:key="id"><view><text>{{item.sourceLabel}}</text><text class="credit-row__meta">{{item.batch_no}}</text></view><text>{{item.remainingCreditsDisplay}}</text></view></view></view><view class="credit-section"><text class="credit-section__title">最近流水</text><view class="credit-empty surface" wx:if="{{!ledger.length}}">暂时没有积分流水</view><view class="credit-list surface" wx:else><view class="credit-row" wx:for="{{ledger}}" wx:key="id"><view><text>{{item.businessLabel}}</text><text class="credit-row__meta">{{item.occurred_at || '待处理'}}</text></view><text>{{item.creditsDisplay}}</text></view></view></view></block>
</view>
