.credit-page { min-height: 100vh; padding: 52rpx 28rpx calc(env(safe-area-inset-bottom) + 48rpx); }.credit-head { padding: 0 8rpx; }.credit-eyebrow { display: block; color: var(--accent-deep); font-size: 22rpx; font-weight: 700; }.credit-title { display: block; margin-top: 12rpx; font-size: 42rpx; font-weight: 700; }.credit-balance { margin-top: 34rpx; padding: 30rpx; }.credit-balance__label, .credit-balance__value { display: block; }.credit-balance__label { color: var(--muted); font-size: 23rpx; }.credit-balance__value { margin-top: 12rpx; font-size: 64rpx; font-weight: 700; line-height: 1; }.credit-balance__facts { display: flex; flex-wrap: wrap; gap: 12rpx 24rpx; margin-top: 26rpx; color: var(--ink-soft); font-size: 22rpx; }.credit-section { margin-top: 42rpx; }.credit-section__title { display: block; margin-bottom: 18rpx; font-size: 28rpx; font-weight: 700; }.credit-empty { padding: 28rpx; color: var(--muted); font-size: 23rpx; }.credit-list { overflow: hidden; padding: 0 26rpx; }.credit-row { display: flex; min-height: 104rpx; align-items: center; justify-content: space-between; gap: 20rpx; border-bottom: 1rpx solid var(--line); font-size: 24rpx; }.credit-row:last-child { border-bottom: 0; }.credit-row__meta { display: block; max-width: 440rpx; margin-top: 7rpx; color: var(--muted); font-size: 20rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
