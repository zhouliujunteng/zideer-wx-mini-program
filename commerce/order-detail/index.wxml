<view class="detail-page"><view class="commerce-skeleton skeleton" wx:if="{{loading}}"></view><view class="state-panel" wx:elif="{{failed}}"><view class="state-panel__mark">!</view><text class="state-panel__title">订单详情暂时无法加载</text><button class="state-panel__action pressable" bindtap="loadPage">重新加载</button></view><block wx:elif="{{order}}"><view class="detail-head"><text class="detail-eyebrow">订单详情</text><text class="detail-title">{{order.title}}</text><text class="detail-status">{{order.statusLabel}}</text></view><view class="detail-card surface"><view><text>订单编号</text><text>{{order.order_no || order.id}}</text></view><view><text>受益学生</text><text>{{order.beneficiaryName}}</text></view><view><text>订单金额</text><text>¥{{order.amountDisplay}}</text></view><view><text>创建时间</text><text>{{order.created_at}}</text></view><view wx:if="{{order.fulfilled_at}}"><text>支付完成</text><text>{{order.fulfilled_at}}</text></view></view><view class="detail-section" wx:if="{{order.batches.length}}"><text class="detail-section__title">课程积分发放</text><view class="detail-card surface" wx:for="{{order.batches}}" wx:key="id"><view><text>发放积分</text><text>{{item.original_credits}}</text></view><view><text>剩余积分</text><text>{{item.remaining_credits}}</text></view></view></view><view class="detail-section" wx:if="{{order.payment}}"><text class="detail-section__title">支付信息</text><view class="detail-card surface"><view><text>支付状态</text><text>{{order.payment.status}}</text></view><view><text>实付金额</text><text>¥{{order.payment.grand_total_value}}</text></view></view></view><button class="detail-primary pressable" wx:if="{{order.status === '已支付'}}" bindtap="goCredits">查看课程积分</button><button class="detail-primary pressable" wx:else bindtap="goProducts">返回商城</button></block></view>
