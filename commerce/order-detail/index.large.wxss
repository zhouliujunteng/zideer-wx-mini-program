/* 自动生成，请勿手改：index.wxss 在平板、电脑大屏（窗口宽 ≥ 450px）下的样式。
   rpx 按 1rpx = 0.6px 换算，固定定位元素收进居中栏；改完源文件后运行 node scripts/build-large-screen-styles.mjs */
@media (min-width: 450px) {
.sk{border-radius:7px}
.sk-line{height:16px}
.sk-line + .sk-line{margin-top:8px}
.sk-short{width:40%}
.sk-mid{width:64%}
.sk-round{border-radius:50%}
.sk-card{height:96px;border-radius:14px}
.sk-card + .sk-card{margin-top:12px}
.detail-page{height:100vh}
.detail-ambient{top:0;left:max(0px, 50% - var(--lg-col) / 2);width:min(100%, var(--lg-col));height:100%}
.detail-ambient-ribbon{top:-84px;left:-258px;width:888px;height:432px;box-sizing:border-box;border:14px solid rgba(255, 255, 255, .72);border-top-color:transparent;border-right-color:transparent;border-radius:50%}
.detail-topbar{top:0;left:max(0px, 50% - var(--lg-col) / 2);width:min(100%, var(--lg-col));box-sizing:border-box}
.detail-topbar-inner{box-sizing:content-box;padding:0 19px 9px}
.detail-back{width:32px;height:32px;border-radius:50%}
.detail-back-icon{width:13px;height:13px;border-bottom:2px solid #24332D;border-left:2px solid #24332D}
.detail-topbar-title{left:50%;font-size:21px;font-weight:700;letter-spacing:-1px}
.detail-scroll{height:100vh;box-sizing:border-box}
.detail-shell{min-height:100%;padding:0 19px calc(28px + env(safe-area-inset-bottom));box-sizing:border-box}
.detail-shell.has-bar{padding-bottom:calc(120px + env(safe-area-inset-bottom))}
.detail-overview{padding:4px 4px 9px}
.detail-overview-copy{min-width:0}
.detail-eyebrow{font-size:17px;font-weight:700;line-height:1.25}
.detail-amount{margin-top:8px;font-size:52px;font-weight:500;letter-spacing:-2px;line-height:.95}
.detail-yuan{margin-right:2px;font-size:24px;font-weight:600;letter-spacing:0}
.detail-overview-meta{margin-top:12px;font-size:12px;line-height:1.2}
.detail-kind{margin-left:8px}
.detail-icon{width:105px;height:108px;margin:-3px 2px 0 9px}
.detail-status{padding:3px 8px;border-radius:599px;font-size:12px;font-weight:600}
.detail-section{margin-top:22px}
.detail-heading{padding:0 2px;font-size:18px;font-weight:700;line-height:1.2}
.detail-card{margin-top:13px;padding:3px 14px;border-radius:21px}
.detail-row{gap:13px;padding:15px 0;border-bottom:1px solid #F0F3F0;font-size:14px;line-height:1.4}
.detail-row:last-child{border-bottom:0}
.detail-row-value{min-width:0}
.detail-copy{margin-left:8px;padding:2px 8px;border-radius:599px;font-size:12px}
.detail-row-value .detail-price{font-size:18px;font-weight:700}
.detail-batch{gap:10px;padding:15px 0;border-bottom:1px solid #F0F3F0}
.detail-batch:last-child{border-bottom:0}
.detail-batch-copy{min-width:0}
.detail-batch-title{font-size:15px;font-weight:600;line-height:1.4}
.detail-batch-meta{margin-top:4px;font-size:12px;line-height:1.3}
.detail-batch-remaining{font-size:14px;font-weight:650}
.detail-state{padding:72px 14px 24px}
.detail-state-title{font-size:19px;font-weight:600}
.detail-state-copy{margin:13px 0 19px;font-size:15px;line-height:1.6}
.detail-state-action{height:45px;padding:0 26px;border-radius:599px;font-size:15px;font-weight:600}
.detail-bar{right:max(0px, 50% - var(--lg-col) / 2);bottom:0;left:max(0px, 50% - var(--lg-col) / 2);padding:10px 19px calc(10px + env(safe-area-inset-bottom));box-shadow:0 -5px 14px rgba(36, 51, 45, .06)}
.detail-button{width:100%;height:52px;margin:0;padding:0;border:0;border-radius:599px;font-size:16px;font-weight:650;line-height:52px}
.detail-button::after{border:0}
.link-pay{padding:8px 0 0;font-size:13px}
.detail-sk-eyebrow{width:144px;height:16px}
.detail-sk-amount{width:132px;height:48px;margin-top:9px}
.detail-sk-status{width:57px;height:19px;border-radius:599px}
.detail-sk-icon{width:96px;height:96px;margin:0 7px 0 9px;border-radius:24px}
.detail-row .detail-sk-value{width:120px;margin-top:0}
}
