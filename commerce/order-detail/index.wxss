.detail-page { min-height: 100vh; padding: 48rpx 28rpx calc(env(safe-area-inset-bottom) + 48rpx); }.detail-head { padding: 0 8rpx; }.detail-eyebrow { display: block; color: var(--accent-deep); font-size: 22rpx; font-weight: 700; }.detail-title { display: block; margin-top: 12rpx; font-size: 40rpx; font-weight: 700; }.detail-status { display: block; margin-top: 14rpx; color: var(--accent-deep); font-size: 23rpx; }.detail-card { margin-top: 30rpx; padding: 4rpx 28rpx; }.detail-card view { display: flex; min-height: 92rpx; align-items: center; justify-content: space-between; gap: 24rpx; border-bottom: 1rpx solid var(--line); color: var(--muted); font-size: 23rpx; }.detail-card view:last-child { border-bottom: 0; }.detail-card view text:last-child { max-width: 440rpx; color: var(--ink); text-align: right; word-break: break-all; }.detail-section { margin-top: 38rpx; }.detail-section__title { display: block; margin-bottom: -12rpx; padding-left: 8rpx; font-size: 28rpx; font-weight: 700; }.detail-primary { width: 100%; min-height: 92rpx; margin-top: 44rpx; border-radius: 6rpx; background: var(--ink); color: #fff; font-size: 27rpx; }
