<!-- 确认订单（PRD M30）：与积分包页同一套样式；按钮与下单、支付流程不变。 -->
<view class="confirm-page">
  <view class="confirm-ambient" aria-hidden="true"></view>
  <view class="confirm-topbar">
    <view class="confirm-topbar-inner" style="height: {{navigationBarHeight}}px; padding-top: {{statusBarHeight}}px;">
      <view class="confirm-back" bindtap="handleBack" aria-label="返回" aria-role="button"><view class="confirm-back-icon"></view></view>
      <text class="confirm-topbar-title" style="top: {{statusBarHeight}}px; height: {{navigationBarHeight}}px; line-height: {{navigationBarHeight}}px;">确认订单</text>
    </view>
  </view>

  <scroll-view class="confirm-scroll" scroll-y show-scrollbar="{{false}}" style="padding-top: {{contentTop}}px;">
    <view class="confirm-shell">
      <view class="confirm-state" wx:if="{{failed && !loaded}}">
        <text class="confirm-state-title">订单暂时无法确认</text>
        <view class="confirm-state-action" bindtap="loadPage" aria-role="button">重新加载</view>
      </view>
      <block wx:else>
        <view class="confirm-pack">
          <view class="confirm-pack-copy">
            <view wx:if="{{loaded}}" class="confirm-credits"><text class="confirm-credits-value">{{product.credits}}</text><text class="confirm-credits-unit">课程积分</text></view>
            <view wx:else class="sk confirm-sk-credits"></view>
            <text wx:if="{{loaded}}" class="confirm-title">{{product.name}}</text>
            <view wx:else class="sk sk-line sk-mid confirm-sk-title"></view>
          </view>
          <view wx:if="{{loaded}}" class="confirm-pack-price"><text class="confirm-yuan">¥</text><text>{{prices.price}}</text></view>
        </view>

        <view class="confirm-card">
          <view class="confirm-row"><text>受益学生</text><text wx:if="{{loaded}}">{{beneficiary.name}}</text><view wx:else class="sk sk-line confirm-sk-value"></view></view>
          <view class="confirm-row"><text>课程积分</text><text wx:if="{{loaded}}">{{product.credits}}</text><view wx:else class="sk sk-line confirm-sk-value"></view></view>
          <block wx:if="{{loaded && product.memberPriceApplied}}">
            <view class="confirm-row"><text>原价</text><text>¥{{prices.listPrice}}</text></view>
            <view class="confirm-row"><text>会员优惠</text><text class="confirm-saved">{{prices.savedText}}</text></view>
          </block>
          <view class="confirm-row"><text>应付金额</text><text wx:if="{{loaded}}" class="confirm-price">¥{{prices.price}}</text><view wx:else class="sk sk-line confirm-sk-value"></view></view>
        </view>
        <text class="confirm-notice">提交后由服务端再次校验积分包状态、购买资格和订单金额；支付完成前不会发放积分。</text>
      </block>
    </view>
  </scroll-view>

  <view wx:if="{{!(failed && !loaded)}}" class="confirm-bar">
    <view class="confirm-bar-copy">
      <text class="confirm-bar-label">应付</text>
      <block wx:if="{{loaded}}"><text class="confirm-bar-yuan">¥</text><text class="confirm-bar-amount">{{prices.price}}</text></block>
      <view wx:else class="sk confirm-sk-amount"></view>
    </view>
    <button wx:if="{{loaded}}" class="confirm-button pressable" loading="{{submitting}}" disabled="{{submitting}}" bindtap="createOrder">{{submitting ? '正在创建订单' : '立即支付'}}</button>
    <view wx:else class="sk confirm-sk-button"></view>
  </view>
</view>
<dev-reset-fab />
