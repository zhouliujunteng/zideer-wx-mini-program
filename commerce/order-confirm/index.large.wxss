/* 自动生成，请勿手改：index.wxss 在平板、电脑大屏（窗口宽 ≥ 450px）下的样式。
   rpx 按 1rpx = 0.6px 换算，固定定位元素收进居中栏；改完源文件后运行 node scripts/build-large-screen-styles.mjs */
@media (min-width: 450px) {
.sk{border-radius:7px}
.sk-line{height:16px}
.sk-line + .sk-line{margin-top:8px}
.sk-short{width:40%}
.sk-mid{width:64%}
.sk-round{border-radius:50%}
.sk-card{height:96px;border-radius:14px}
.sk-card + .sk-card{margin-top:12px}
.confirm-page{height:100vh}
.confirm-ambient{top:0;left:max(0px, 50% - var(--lg-col) / 2);width:min(100%, var(--lg-col));height:100%}
.confirm-topbar{top:0;left:max(0px, 50% - var(--lg-col) / 2);width:min(100%, var(--lg-col));box-sizing:border-box}
.confirm-topbar-inner{box-sizing:content-box;padding:0 19px 9px}
.confirm-back{width:32px;height:32px;border-radius:50%}
.confirm-back-icon{width:13px;height:13px;border-bottom:2px solid #24332D;border-left:2px solid #24332D}
.confirm-topbar-title{left:50%;font-size:21px;font-weight:700;letter-spacing:-1px}
.confirm-scroll{height:100vh;box-sizing:border-box}
.confirm-shell{min-height:100%;padding:0 19px calc(120px + env(safe-area-inset-bottom));box-sizing:border-box}
.confirm-pack{gap:14px;margin-top:7px;padding:18px 16px;border:1px solid #FD7C02;border-radius:19px}
.confirm-pack-copy{min-width:0}
.confirm-credits-value{font-size:33px;font-weight:700;letter-spacing:-1px;line-height:1.05}
.confirm-credits-unit{margin-left:4px;font-size:13px}
.confirm-title{margin-top:4px;font-size:13px;line-height:1.4}
.confirm-pack-price{font-size:26px;font-weight:700}
.confirm-yuan{margin-right:1px;font-size:14px;font-weight:600}
.confirm-card{margin-top:14px;padding:2px 15px;border-radius:19px}
.confirm-row{gap:13px;padding:15px 0;border-bottom:1px solid #F0F3F0;font-size:14px;line-height:1.4}
.confirm-row:last-child{border-bottom:0}
.confirm-row text.confirm-price{font-size:19px;font-weight:700}
.confirm-notice{margin:10px 3px 0;font-size:12px;line-height:1.6}
.confirm-state{margin-top:19px;padding:38px 21px 33px;border-radius:19px}
.confirm-state-title{font-size:17px;font-weight:650}
.confirm-state-action{margin-top:16px;padding:0 28px;height:43px;border-radius:599px;font-size:15px;font-weight:650;line-height:43px}
.confirm-bar{right:max(0px, 50% - var(--lg-col) / 2);bottom:0;left:max(0px, 50% - var(--lg-col) / 2);gap:14px;padding:10px 19px calc(10px + env(safe-area-inset-bottom));box-shadow:0 -5px 14px rgba(36, 51, 45, .06)}
.confirm-bar-copy{min-width:0}
.confirm-bar-label{margin-right:6px;font-size:13px}
.confirm-bar-yuan{font-size:14px;font-weight:600}
.confirm-bar-amount{margin-left:1px;font-size:26px;font-weight:700;line-height:1.1}
.confirm-button{height:52px;margin:0;padding:0 33px;border-radius:599px;font-size:16px;font-weight:650;line-height:52px}
.confirm-button::after{border:0}
.confirm-sk-credits{width:120px;height:33px}
.confirm-sk-title{height:13px;margin-top:8px}
.confirm-sk-value{width:96px}
.confirm-sk-amount{width:84px;height:26px}
.confirm-sk-button{width:138px;height:52px;border-radius:599px}
}
