.confirm-page { min-height:100vh; padding:52rpx 28rpx calc(env(safe-area-inset-bottom) + 48rpx); }.commerce-skeleton { height:300rpx; }.confirm-head { padding:0 8rpx; }.confirm-eyebrow { display:block; color:var(--accent-deep); font-size:22rpx; font-weight:700; }.confirm-title { display:block; margin-top:12rpx; font-size:38rpx; font-weight:700; overflow-wrap:anywhere; }.confirm-card { margin-top:34rpx; padding:0 26rpx; }.confirm-row { display:flex; justify-content:space-between; gap:22rpx; padding:29rpx 0; border-bottom:1rpx solid var(--line); color:var(--ink-soft); font-size:24rpx; }.confirm-row:last-child { border-bottom:0; }.confirm-row text:last-child { color:var(--ink); text-align:right; overflow-wrap:anywhere; }.confirm-price { color:var(--accent-deep) !important; font-size:31rpx; font-weight:700; }.confirm-notice { display:block; margin:22rpx 8rpx; color:var(--muted); font-size:21rpx; line-height:1.55; }.confirm-button { width:100%; min-height:92rpx; margin-top:26rpx; border-radius:8rpx; background:var(--ink); color:#fff; font-size:28rpx; font-weight:700; }
