@import "../../styles/skeleton.wxss";
/* 我的代理身份：照「关于知鹿」（account/about）的顶栏、小节标题与白色大圆角行卡片，氛围光换成主题橙。 */
page { background: #FAFAFA; }

.ai-page { position: relative; height: 100vh; overflow: hidden; background: #FAFAFA; color: #24332D; }
.ai-ambient { position: fixed; top: 0; left: 0; z-index: 0; width: 100%; height: 100%; pointer-events: none; background: radial-gradient(125% 52% at 100% 0, rgba(255, 222, 190, .84) 0%, rgba(255, 236, 218, .48) 40%, rgba(250, 250, 250, 0) 76%), #FAFAFA; }
.ai-topbar { position: fixed; top: 0; left: 0; z-index: 20; width: 100%; box-sizing: border-box; background: transparent; }
.ai-topbar-inner { position: relative; display: flex; align-items: center; box-sizing: content-box; padding: 0 32rpx 16rpx; }
.ai-back { display: flex; flex: 0 0 auto; align-items: center; justify-content: center; width: 54rpx; height: 54rpx; border-radius: 50%; }
.ai-back:active { background: #F0F2EF; }
.ai-back-icon { width: 22rpx; height: 22rpx; border-bottom: 4rpx solid #24332D; border-left: 4rpx solid #24332D; transform: rotate(45deg) scale(.7); }
.ai-topbar-title { position: absolute; left: 50%; display: block; color: #24332D; font-size: 36rpx; font-weight: 700; letter-spacing: -1rpx; transform: translateX(-50%); white-space: nowrap; }
.ai-scroll { position: relative; z-index: 1; height: 100vh; box-sizing: border-box; background: transparent; }
.ai-shell { min-height: 100%; padding: 0 32rpx calc(48rpx + env(safe-area-inset-bottom)); box-sizing: border-box; }

.ai-section { margin-top: 38rpx; }
.ai-section:first-child { margin-top: 20rpx; }
.ai-heading { padding: 0 4rpx; color: #24332D; font-size: 30rpx; font-weight: 700; line-height: 1.2; }
.ai-card { margin-top: 22rpx; padding: 6rpx 24rpx; border-radius: 36rpx; background: #fff; }

.ai-row { display: flex; align-items: center; justify-content: space-between; gap: 22rpx; min-height: 44rpx; padding: 28rpx 0; border-bottom: 2rpx solid #F0F3F0; font-size: 24rpx; line-height: 1.4; }
.ai-row:last-child { border-bottom: 0; }
.ai-row-label { flex: 0 0 auto; color: #7E8A82; }
.ai-row-value { display: flex; min-width: 0; align-items: center; justify-content: flex-end; gap: 14rpx; color: #24332D; text-align: right; overflow-wrap: anywhere; }
.ai-muted { color: #7E8A82; }
.ai-id { flex: 0 0 auto; color: #8A958D; font-size: 22rpx; }
.ai-member-name { min-width: 0; overflow: hidden; color: #24332D; font-size: 26rpx; font-weight: 600; text-overflow: ellipsis; white-space: nowrap; }

.ai-role { display: flex; min-width: 0; align-items: center; }
.ai-role-pill { display: inline-flex; align-items: center; height: 48rpx; padding: 0 20rpx; box-sizing: border-box; border-radius: 999rpx; background: rgba(253, 124, 2, 0.10); color: #FD7C02; font-size: 25rpx; font-weight: 700; line-height: 1; white-space: nowrap; }
.ai-role-pill-team_leader { background: #FD7C02; color: #fff; }

.ai-help-copy { display: flex; min-width: 0; flex-direction: column; gap: 8rpx; }
.ai-help-title { color: #24332D; font-size: 26rpx; font-weight: 600; }
.ai-help-sub { color: #7E8A82; font-size: 22rpx; }
.ai-copy { flex: 0 0 auto; padding: 8rpx 20rpx; border-radius: 999rpx; background: #FD7C02; color: #fff; font-size: 22rpx; font-weight: 600; }
.ai-row:active .ai-copy { opacity: .7; }

.ai-state { display: flex; flex-direction: column; align-items: center; gap: 22rpx; padding: 40rpx 24rpx; text-align: center; }
.ai-card.ai-state { padding: 40rpx 24rpx; }
.ai-state-text { color: #7E8A82; font-size: 24rpx; line-height: 1.5; }
.ai-state-button { padding: 14rpx 40rpx; border-radius: 999rpx; background: #FD7C02; color: #fff; font-size: 24rpx; font-weight: 600; }
.ai-state-button:active { opacity: .7; }

/* 平板：照「关于知鹿」放宽到阅读栏 760px（LARGE_SCREEN_READING_COLUMN，utils/screen.js） */
@media (min-width: 450px) {
  page { --lg-col: 760px; }
}

@import "./index.large.wxss"; /* 平板、电脑大屏样式：由 scripts/build-large-screen-styles.mjs 生成，改完本文件后重跑；这一行须留在文件末尾 */
