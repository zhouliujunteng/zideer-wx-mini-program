/* 自动生成，请勿手改：index.wxss 在平板、电脑大屏（窗口宽 ≥ 450px）下的样式。
   rpx 按 1rpx = 0.6px 换算，固定定位元素收进居中栏；改完源文件后运行 node scripts/build-large-screen-styles.mjs */
@media (min-width: 450px) {
.surface{border-radius:14px}
.skeleton{border-radius:9px}
.state-panel{padding:72px 14px 24px}
.state-panel__mark{margin-bottom:14px;font-size:31px}
.state-panel__title{font-size:19px;font-weight:600}
.state-panel__copy{margin:13px 0 19px;font-size:15px;line-height:1.6}
.state-panel__action{border-radius:12px}
.state-panel__action::after{border:0}
.sk{border-radius:7px}
.sk-line{height:16px}
.sk-line + .sk-line{margin-top:8px}
.sk-short{width:40%}
.sk-mid{width:64%}
.sk-round{border-radius:50%}
.sk-card{height:96px;border-radius:14px}
.sk-card + .sk-card{margin-top:12px}
.service-contact{min-height:100vh;padding:28px 16px calc(env(safe-area-inset-bottom) + 28px)}
.page-head{padding:0 4px}
.page-head__title{font-size:25px;font-weight:700}
.page-head__copy{margin-top:7px;font-size:14px}
.service-list{margin-top:16px}
.service-row{width:100%;min-height:70px;margin-top:9px;padding:12px 14px}
.service-row__icon{width:34px;height:34px;border-radius:9px}
.service-row__icon image{width:18px;height:18px}
.service-row__copy{min-width:0;margin-left:10px}
.service-row__title{font-size:15px;font-weight:600}
.service-row__meta{margin-top:4px;font-size:12px}
.service-row__arrow{margin-left:7px;font-size:20px}
.service-row__icon-sk{width:34px;height:34px;border-radius:9px}
}
