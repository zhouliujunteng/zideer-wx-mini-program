.guardian-page { min-height: 100vh; padding: 48rpx 28rpx calc(env(safe-area-inset-bottom) + 48rpx); }.guardian-skeleton { height: 560rpx; }.guardian-head { padding: 0 8rpx; }.guardian-eyebrow { display: block; color: var(--accent-deep); font-size: 22rpx; font-weight: 700; }.guardian-title { display: block; margin-top: 12rpx; font-size: 42rpx; font-weight: 700; }.guardian-empty { margin-top: 40rpx; padding: 30rpx 26rpx; }.guardian-empty__title { display: block; font-size: 28rpx; font-weight: 700; }.guardian-empty__copy { display: block; margin-top: 12rpx; color: var(--muted); font-size: 23rpx; line-height: 1.6; }.child-switcher { display: flex; width: 100%; min-height: 120rpx; align-items: center; margin-top: 38rpx; padding: 20rpx 22rpx; text-align: left; }.child-avatar { display: flex; width: 64rpx; height: 64rpx; flex: none; align-items: center; justify-content: center; border-radius: 32rpx; background: var(--accent-soft); color: var(--accent-deep); font-size: 25rpx; font-weight: 700; }.child-copy { min-width: 0; flex: 1; margin-left: 18rpx; }.child-label, .child-name { display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }.child-label { color: var(--muted); font-size: 20rpx; }.child-name { margin-top: 7rpx; font-size: 26rpx; font-weight: 700; }.child-switcher__action { margin-left: 12rpx; color: var(--accent-deep); font-size: 21rpx; white-space: nowrap; }.guardian-section { margin-top: 40rpx; }.summary-card { width: 100%; padding: 28rpx 26rpx; text-align: left; }.summary-card__status { display: block; color: var(--accent-deep); font-size: 22rpx; font-weight: 700; }.summary-card__copy { display: -webkit-box; margin-top: 14rpx; overflow: hidden; font-size: 26rpx; line-height: 1.55; -webkit-box-orient: vertical; -webkit-line-clamp: 3; }.summary-card__meta { display: block; margin-top: 16rpx; color: var(--muted); font-size: 21rpx; }.guardian-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16rpx; margin-top: 16rpx; }.metric-card { min-width: 0; min-height: 184rpx; padding: 24rpx 20rpx; text-align: left; }.metric-card__label, .metric-card__value, .metric-card__meta { display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }.metric-card__label, .metric-card__meta { color: var(--muted); font-size: 20rpx; }.metric-card__value { margin-top: 14rpx; font-size: 25rpx; font-weight: 700; }.metric-card__meta { margin-top: 12rpx; }.plan-row { display: flex; width: 100%; min-height: 102rpx; align-items: center; padding: 20rpx 24rpx; text-align: left; }.plan-row__copy { min-width: 0; flex: 1; }.plan-row__title, .plan-row__meta { display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }.plan-row__title { font-size: 25rpx; font-weight: 700; }.plan-row__meta { margin-top: 8rpx; color: var(--muted); font-size: 20rpx; }.plan-row__arrow { margin-left: 20rpx; color: var(--muted); font-size: 34rpx; }.quick-list { padding: 0 24rpx; }.quick-row { display: flex; width: 100%; min-height: 94rpx; align-items: center; justify-content: space-between; border-bottom: 1rpx solid var(--line); font-size: 25rpx; text-align: left; }.quick-row:last-child { border-bottom: 0; }
