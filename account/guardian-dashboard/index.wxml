<view class="guardian-page">
  <view class="guardian-skeleton skeleton" wx:if="{{loading}}"></view>
  <view class="state-panel" wx:elif="{{failed}}"><view class="state-panel__mark">!</view><text class="state-panel__title">家长看板暂时无法加载</text><text class="state-panel__copy">网络恢复后可以重新读取孩子的学习摘要。</text><button class="state-panel__action pressable" bindtap="loadPage">重新加载</button></view>
  <block wx:else>
    <view class="guardian-head"><text class="guardian-eyebrow">家庭学习</text><text class="guardian-title">学生看板</text></view>
    <view class="guardian-empty surface" wx:if="{{!current}}"><text class="guardian-empty__title">暂未绑定有效学生</text><text class="guardian-empty__copy">绑定生效后，孩子的诊断、预测、计划与积分摘要会显示在这里。</text></view>
    <block wx:else>
      <button class="child-switcher surface pressable" bindtap="chooseChild"><view class="child-avatar">{{current.initial}}</view><view class="child-copy"><text class="child-label">当前学生</text><text class="child-name">{{current.name}} · {{current.gradeLabel}}</text></view><text class="child-switcher__action">{{children.length > 1 ? '切换' : '已绑定'}} ›</text></button>
      <view class="guardian-section"><view class="section-head"><text class="section-title">学习诊断</text><button class="section-link pressable" data-target="report" bindtap="openPage">查看报告</button></view><button class="summary-card surface pressable" data-target="report" bindtap="openPage"><text class="summary-card__status">{{current.reportStatus}}</text><text class="summary-card__copy">{{current.reportSummary}}</text><text class="summary-card__meta" wx:if="{{current.reportDate}}">{{current.reportDate}}</text></button></view>
      <view class="guardian-grid"><button class="metric-card surface pressable" data-target="forecast" bindtap="openPage"><text class="metric-card__label">最新预测</text><text class="metric-card__value">{{current.predictionLabel}}</text><text class="metric-card__meta">{{current.predictionMeta}}</text></button><button class="metric-card surface pressable" data-target="credits" bindtap="openPage"><text class="metric-card__label">课程积分</text><text class="metric-card__value">{{current.credits}}</text><text class="metric-card__meta">冻结 {{current.frozenCredits}}</text></button></view>
      <view class="guardian-section"><view class="section-head"><text class="section-title">当前计划</text><button class="section-link pressable" data-target="plans" bindtap="openPage">计划中心</button></view><button class="plan-row surface pressable" data-target="plans" bindtap="openPage"><view class="plan-row__copy"><text class="plan-row__title">{{current.planLabel}}</text><text class="plan-row__meta">{{current.planMeta}}</text></view><text class="plan-row__arrow">›</text></button></view>
      <view class="guardian-section"><view class="section-head"><text class="section-title">快捷操作</text></view><view class="quick-list surface"><button class="quick-row pressable" data-target="learningFeed" bindtap="openPage"><text>孩子学习动态</text><text>›</text></button><button class="quick-row pressable" data-target="topicReports" bindtap="openPage"><text>知识点学习报告</text><text>›</text></button><button class="quick-row pressable" data-target="assessment" bindtap="openPage"><text>测评中心</text><text>›</text></button><button class="quick-row pressable" data-target="orders" bindtap="openPage"><text>订单与代付记录</text><text>›</text></button></view></view>
    </block>
  </block>
</view>
