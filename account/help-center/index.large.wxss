/* 自动生成，请勿手改：index.wxss 在平板、电脑大屏（窗口宽 ≥ 450px）下的样式。
   rpx 按 1rpx = 0.6px 换算，固定定位元素收进居中栏；改完源文件后运行 node scripts/build-large-screen-styles.mjs */
@media (min-width: 450px) {
.sk{border-radius:7px;background:linear-gradient(90deg, #ECEEEB 25%, #F5F6F4 37%, #ECEEEB 63%);background-size:400% 100%}
.sk-line{height:16px}
.sk-line + .sk-line{margin-top:8px}
.sk-short{width:40%}
.sk-mid{width:64%}
.sk-round{border-radius:50%}
.sk-card{height:96px;border-radius:14px}
.sk-card + .sk-card{margin-top:12px}
page{background:#FAFAFA}
.hc-page{height:100vh;background:#FAFAFA}
.hc-ambient{top:0;left:max(0px, 50% - var(--lg-col) / 2);width:min(100%, var(--lg-col));height:100%;background:radial-gradient(120% 46% at 100% 0, rgba(255, 214, 170, .7) 0%, rgba(255, 233, 210, .4) 42%, rgba(250, 250, 250, 0) 76%), #FAFAFA}
.hc-topbar{top:0;left:max(0px, 50% - var(--lg-col) / 2);width:min(100%, var(--lg-col));box-sizing:border-box;background:transparent}
.hc-topbar.is-solid{background:rgba(250, 250, 250, .94);box-shadow:0 1px 0 rgba(36, 51, 45, .05)}
.hc-topbar-inner{box-sizing:content-box;padding:0 19px 9px}
.hc-back{flex:0 0 auto;width:32px;height:32px;border-radius:50%}
.hc-back-pressed{background:rgba(36, 51, 45, .08)}
.hc-back-icon{width:13px;height:13px;border-bottom:2px solid #24332D;border-left:2px solid #24332D}
.hc-topbar-title{left:50%;font-size:21px;font-weight:700;letter-spacing:-1px}
.hc-scroll{height:100vh;box-sizing:border-box;background:transparent}
.hc-shell{min-height:100%;padding:0 19px calc(33px + env(safe-area-inset-bottom));box-sizing:border-box}
.hc-hero{padding-bottom:24px;background:linear-gradient(180deg, #FECFA1 0, #FFF9EF 228px, #FFFAF3 396px, #FFFAF3 100%)}
.hc-hero-cap{top:0;left:0;width:100%;background:#FECFA1}
.hc-hero-art-wrap{left:0;width:450px;height:348px}
.hc-hero-art{top:0;left:0;width:450px;height:348px}
.hc-hero-art-fade{top:294px;left:0;width:100%;height:54px;background:linear-gradient(180deg, rgba(255, 250, 243, 0), #FFFAF3)}
.hc-hero::after{right:0;bottom:0;left:0;height:36px;background:linear-gradient(180deg, rgba(250, 250, 250, 0), #FAFAFA)}
.hc-hero-copy{flex-direction:column;padding:36px 0 7px}
.hc-hero-title{font-size:28px;font-weight:750;line-height:1.3;letter-spacing:0.5px}
.hc-hero-subtitle{margin-top:8px;font-size:15px;line-height:1.6}
.hc-search{gap:9px;box-sizing:border-box;width:72%;height:52px;margin-top:20px;padding:0 7px 0 16px;border-radius:599px;background:#FFF;box-shadow:0 6px 18px rgba(181, 98, 20, .08), inset 0 0 0 1px rgba(253, 124, 2, 0)}
.hc-search.is-focused{box-shadow:0 6px 18px rgba(181, 98, 20, .12), inset 0 0 0 1px #FD7C02}
.hc-search-icon{flex:0 0 18px;width:18px;height:18px}
.hc-search-icon::before{top:0;left:0;width:13px;height:13px;box-sizing:border-box;border:2px solid #FD7C02;border-radius:50%}
.hc-search-icon::after{right:0.5px;bottom:1px;width:2px;height:6px;border-radius:1px;background:#FD7C02}
.hc-search-input{flex:1;min-width:0;height:55px;font-size:16px}
.hc-search-placeholder{font-size:15px}
.hc-search-clear{flex:0 0 38px;width:38px;height:38px;border-radius:50%}
.hc-search-clear-pressed{background:#F2F4F2}
.hc-search-clear-icon{width:19px;height:19px;border-radius:50%;background:#C9D0CB}
.hc-search-clear-icon::before, .hc-search-clear-icon::after{top:9px;left:4px;width:9px;height:1px;border-radius:1px;background:#FFF}
.hc-hot{width:74%;margin-top:15px}
.hc-hot-label{font-size:13px}
.hc-hot-list{flex-wrap:wrap;gap:7px;margin-top:8px}
.hc-hot-chip{padding:6px 14px;border-radius:599px;background:rgba(255, 255, 255, .86);font-size:14px;line-height:1.5;box-shadow:inset 0 0 0 1px #EEE6DD}
.hc-card-pressed{box-shadow:0 1px 4px rgba(36, 51, 45, .04)}
.hc-row-pressed{background:#FAF7F3}
.hc-section{margin-top:26px}
.hc-section-head{gap:9px;padding:0 2px}
.hc-section-title{padding:0 2px;font-size:18px;font-weight:700;line-height:1.3}
.hc-section-head .hc-section-title{padding:0}
.hc-section-note{font-size:13px}
.hc-guide-grid{grid-template-columns:repeat(2, minmax(0, 1fr));gap:10px;margin-top:13px}
.hc-guide-card{flex-direction:column;min-height:136px;padding:15px 14px 14px;box-sizing:border-box;border-radius:19px;background:#FFF;box-shadow:0 3px 14px rgba(56, 75, 64, .04)}
.hc-guide-title{padding-right:4px;font-size:16px;font-weight:650;line-height:1.45}
.hc-guide-meta{margin-top:3px;font-size:12px}
.hc-guide-art{right:3px;bottom:2px;width:79px;height:79px}
.hc-guide-card .sk.hc-guide-art{right:13px;bottom:13px;width:57px;height:57px;border-radius:16px}
.card-tone-orange{background:linear-gradient(150deg, #FFFFFF 52%, #FFF1E2 100%)}
.card-tone-blue{background:linear-gradient(150deg, #FFFFFF 52%, #EAF3FF 100%)}
.card-tone-green{background:linear-gradient(150deg, #FFFFFF 52%, #E7F6EE 100%)}
.card-tone-purple{background:linear-gradient(150deg, #FFFFFF 52%, #F1ECFF 100%)}
.card-tone-pink{background:linear-gradient(150deg, #FFFFFF 52%, #FFEEF1 100%)}
.card-tone-teal{background:linear-gradient(150deg, #FFFFFF 52%, #E4F6F5 100%)}
.tone-orange{background:#FFF1E3}
.tone-blue{background:#E8F2FF}
.tone-green{background:#E5F5EC}
.tone-purple{background:#F0EBFF}
.tone-pink{background:#FFEDF0}
.tone-teal{background:#E2F5F4}
.hc-results{padding-top:15px}
.hc-results-count{padding:0 4px;font-size:13px}
.hc-result-section{margin-top:15px}
.hc-guide-rows{margin-top:10px;border-radius:19px;background:#FFF}
.hc-guide-row{gap:12px;padding:14px;border-bottom:1px solid #F2F4F1}
.hc-guide-row:last-child{border-bottom:0}
.hc-guide-row-art{flex:0 0 48px;width:48px;height:48px}
.sk.hc-guide-row-art{flex-basis:38px;width:38px;height:38px;border-radius:12px}
.hc-guide-row-copy{flex:1;min-width:0}
.hc-guide-row-title{font-size:16px;font-weight:650;line-height:1.45}
.hc-guide-row-meta{margin-top:2px;font-size:12px}
.is-hit{font-weight:700}
.hc-chevron{flex:0 0 auto;width:8px;height:8px;margin-right:3px;border-top:1px solid #B4BCB6;border-right:1px solid #B4BCB6}
.hc-tabs{width:100%;margin-top:12px}
.hc-tabs-track{gap:8px;padding:2px 2px 4px}
.hc-tab{flex:0 0 auto;padding:7px 15px;border-radius:599px;background:#FFF;font-size:14px;line-height:1.5}
.hc-tab.is-active{background:#24332D;font-weight:650}
.hc-faq-list{margin-top:10px}
.hc-faq{margin-top:8px;border-radius:16px;background:#FFF}
.hc-faq:first-child{margin-top:0}
.hc-faq.is-open{box-shadow:0 6px 16px rgba(56, 75, 64, .06), inset 0 0 0 1px #FFE2C6}
.hc-faq-head{gap:10px;min-height:62px;padding:13px 15px;box-sizing:border-box}
.hc-faq-head-pressed{background:#FBF8F4}
.hc-faq-mark{flex:0 0 24px;height:24px;border-radius:7px;background:#FFF1E3;font-size:13px;font-weight:800;line-height:24px}
.hc-faq-head-copy{flex:1;min-width:0}
.hc-faq-title{font-size:16px;font-weight:600;line-height:1.5}
.hc-faq-category{margin-top:2px;font-size:12px}
.hc-faq-chevron{flex:0 0 auto;width:8px;height:8px;margin:0 3px 3px 0;border-right:1px solid #B4BCB6;border-bottom:1px solid #B4BCB6}
.hc-faq.is-open .hc-faq-chevron{margin-bottom:-4px;border-color:#FD7C02}
.hc-faq-body{padding:2px 18px 16px 50px}
.hc-faq-paragraph{margin-top:8px;font-size:15px;line-height:1.75}
.hc-faq-paragraph:first-child{margin-top:0}
.hc-faq-actions{flex-wrap:wrap;gap:9px;margin-top:13px}
.hc-faq-guide{gap:6px;padding:7px 14px;border-radius:599px;background:#FD7C02;font-size:13px;font-weight:650;line-height:1.5}
.hc-play-icon{width:0;height:0;border-top:5px solid transparent;border-bottom:5px solid transparent;border-left:8px solid #FFF}
.hc-faq-unsolved{padding:7px 4px;font-size:13px;line-height:1.5}
.hc-empty{flex-direction:column;margin-top:24px;padding:33px 24px 28px;border-radius:21px;background:#FFF}
.hc-empty-art{width:72px;height:72px}
.hc-empty-lens{top:6px;left:6px;width:45px;height:45px;box-sizing:border-box;border:6px solid #FFD3A8;border-radius:50%}
.hc-empty-handle{right:10px;bottom:8px;width:7px;height:24px;border-radius:3px;background:#FFB36B}
.hc-empty-title{margin-top:13px;font-size:16px;font-weight:650;line-height:1.5}
.hc-empty-copy{margin-top:7px;font-size:14px;line-height:1.7}
.hc-empty-action{margin-top:18px;padding:12px 28px;border-radius:599px;background:#FD7C02;font-size:15px;font-weight:650}
.hc-contact-card{margin-top:12px;padding:2px 0;border-radius:19px;background:#FFF}
.hc-contact-row{gap:12px;padding:15px 15px;border-bottom:1px solid #F2F4F1}
.hc-contact-row:last-child{border-bottom:0}
.hc-contact-icon{flex:0 0 38px;width:38px;height:38px;border-radius:12px}
.hc-contact-pen{width:15px;height:18px;box-sizing:border-box;border:2px solid #E06A00;border-radius:3px}
.hc-contact-pen::after{width:7px;height:2px;margin:3px auto 0;border-radius:1px;background:#E06A00;box-shadow:0 4px 0 #E06A00}
.hc-contact-image{width:24px;height:24px}
.hc-contact-copy{flex:1;min-width:0}
.hc-contact-title{font-size:16px;font-weight:650;line-height:1.45}
.hc-contact-hint{margin-top:2px;font-size:13px}
@keyframes hc-rise{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:translateY(0)}}
@keyframes hc-unfold{from{opacity:0;transform:translateY(-6px)}to{opacity:1;transform:translateY(0)}}
@keyframes hc-search-sway{0%, 100%{transform:translate(0, 0)}50%{transform:translate(4px, -4px)}}
.hc-hero .hc-hero-art-wrap{left:50%}
.hc-page .hc-hero{background:linear-gradient(180deg, #FECFA1 0, #FECFA1 var(--hero-art-top, 0px), #FFF9EF calc(var(--hero-art-top, 0px) + 130px), #FFFAF3 calc(var(--hero-art-top, 0px) + 396px), #FFFAF3 100%)}
.hc-hero-copy .hc-search{max-width:324px}
}
