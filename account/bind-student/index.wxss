@import "../../styles/account-form.wxss";
@import "../../styles/skeleton.wxss";

.bind-student-page { min-height: 100vh; padding: 48rpx 28rpx calc(env(safe-area-inset-bottom) + 48rpx); }.bind-student-head { padding: 0 8rpx; }.bind-student-eyebrow { display: block; color: var(--accent-deep); font-size: 22rpx; font-weight: 700; }.bind-student-title { display: block; margin-top: 12rpx; font-size: 42rpx; font-weight: 700; }.bind-form { margin-top: 54rpx; padding: 30rpx; }.bind-form__label { display: block; color: var(--muted); font-size: 22rpx; }.bind-form__input { width: 100%; height: 104rpx; margin-top: 16rpx; border-bottom: 1rpx solid var(--line-strong); font-family: "SF Mono", Menlo, monospace; font-size: 44rpx; font-weight: 700; letter-spacing: 8rpx; }.bind-form__placeholder { color: #B9BDC3; font-family: "PingFang SC", "Helvetica Neue", Arial, sans-serif; font-size: 29rpx; font-weight: 400; letter-spacing: 0; }.bind-form__identity { display: flex; justify-content: space-between; margin-top: 26rpx; color: var(--muted); font-size: 23rpx; }.bind-form__identity text:last-child { color: var(--ink-soft); font-weight: 700; }.bind-submit { display: flex; width: 100%; min-height: 88rpx; align-items: center; justify-content: center; margin-top: 26rpx; border-radius: 44rpx; background: var(--accent); color: var(--surface); font-size: 27rpx; font-weight: 700; }.bind-submit[disabled] { opacity: .55; }
/* 实名认证前的提示卡与首次读取骨架 */
.bind-gate { margin-top: 54rpx; padding: 36rpx 30rpx 30rpx; }
.bind-gate__title { display: block; color: var(--ink); font-size: 31rpx; font-weight: 700; }
.bind-gate__detail { display: block; margin-top: 14rpx; color: var(--muted); font-size: 24rpx; line-height: 1.6; }
.bind-gate .bind-submit { margin-top: 32rpx; }
.bind-form__input-sk { height: 88rpx; margin-top: 24rpx; }
.bind-form__identity-sk { margin-top: 26rpx; }

/* 服务商账号：已绑定 / 上限（2026-10-11） */
.bind-provider { display: flex; align-items: center; justify-content: space-between; margin-top: 54rpx; padding: 26rpx 30rpx; }
.bind-provider__title { color: var(--accent-deep); font-size: 25rpx; font-weight: 700; }
.bind-provider__count { color: var(--ink-soft); font-size: 25rpx; }
.bind-provider + .bind-form { margin-top: 24rpx; }

/* 「我的孩子没有微信」入口 */
.bind-web-child { display: flex; align-items: center; margin-top: 40rpx; padding: 30rpx; }
.bind-web-child__text { flex: 1; min-width: 0; }
.bind-web-child__title { display: block; color: var(--ink); font-size: 28rpx; font-weight: 700; }
.bind-web-child__hint { display: block; margin-top: 8rpx; color: var(--muted); font-size: 23rpx; }
.bind-web-child__arrow { margin-left: 16rpx; color: var(--muted); font-size: 36rpx; }

@import "./index.large.wxss"; /* 平板、电脑大屏样式：由 scripts/build-large-screen-styles.mjs 生成，改完本文件后重跑；这一行须留在文件末尾 */
