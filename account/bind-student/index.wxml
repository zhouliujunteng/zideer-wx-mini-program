<view class="bind-student-page"><view class="bind-student-head"><text class="bind-student-eyebrow">家庭关系</text><text class="bind-student-title">绑定学生</text></view><view class="bind-form surface"><text class="bind-form__label">学生动态码</text><input class="bind-form__input" type="number" maxlength="8" value="{{code}}" placeholder="输入 8 位数字" placeholder-class="bind-form__placeholder" bindinput="onCodeInput"/><view class="bind-form__identity"><text>绑定身份</text><text>监护人</text></view></view><button class="bind-submit pressable" bindtap="submit" loading="{{submitting}}" disabled="{{submitting}}">确认绑定</button></view>
