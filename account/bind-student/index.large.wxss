/* 自动生成，请勿手改：index.wxss 在平板、电脑大屏（窗口宽 ≥ 450px）下的样式。
   rpx 按 1rpx = 0.6px 换算，固定定位元素收进居中栏；改完源文件后运行 node scripts/build-large-screen-styles.mjs */
@media (min-width: 450px) {
.surface{border-radius:14px}
.skeleton{border-radius:9px}
.state-panel{padding:72px 14px 24px}
.state-panel__mark{margin-bottom:14px;font-size:31px}
.state-panel__title{font-size:19px;font-weight:600}
.state-panel__copy{margin:13px 0 19px;font-size:15px;line-height:1.6}
.state-panel__action{border-radius:12px}
.state-panel__action::after{border:0}
.sk{border-radius:7px}
.sk-line{height:16px}
.sk-line + .sk-line{margin-top:8px}
.sk-short{width:40%}
.sk-mid{width:64%}
.sk-round{border-radius:50%}
.sk-card{height:96px;border-radius:14px}
.sk-card + .sk-card{margin-top:12px}
.bind-student-page{min-height:100vh;padding:28px 16px calc(env(safe-area-inset-bottom) + 28px)}
.bind-student-head{padding:0 4px}
.bind-student-eyebrow{font-size:13px;font-weight:700}
.bind-student-title{margin-top:7px;font-size:25px;font-weight:700}
.bind-form{margin-top:32px;padding:18px}
.bind-form__label{font-size:13px}
.bind-form__input{width:100%;height:62px;margin-top:9px;border-bottom:0.5px solid var(--line-strong);font-family:"SF Mono", Menlo, monospace;font-size:26px;font-weight:700;letter-spacing:4px}
.bind-form__placeholder{font-family:"PingFang SC", "Helvetica Neue", Arial, sans-serif;font-size:17px;font-weight:400;letter-spacing:0}
.bind-form__identity{margin-top:15px;font-size:13px}
.bind-form__identity text:last-child{font-weight:700}
.bind-submit{width:100%;min-height:52px;margin-top:15px;border-radius:26px;font-size:16px;font-weight:700}
.bind-gate{margin-top:32px;padding:21px 18px 18px}
.bind-gate__title{font-size:18px;font-weight:700}
.bind-gate__detail{margin-top:8px;font-size:14px;line-height:1.6}
.bind-gate .bind-submit{margin-top:19px}
.bind-form__input-sk{height:52px;margin-top:14px}
.bind-form__identity-sk{margin-top:15px}
.bind-provider{margin-top:32px;padding:15px 18px}
.bind-provider__title{font-size:15px;font-weight:700}
.bind-provider__count{font-size:15px}
.bind-provider + .bind-form{margin-top:14px}
.bind-web-child{margin-top:24px;padding:18px}
.bind-web-child__text{min-width:0}
.bind-web-child__title{font-size:16px;font-weight:700}
.bind-web-child__hint{margin-top:4px;font-size:13px}
.bind-web-child__arrow{margin-left:9px;font-size:21px}
}
