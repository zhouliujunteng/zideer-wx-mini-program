<wxs module="UA" src="../../utils/ui-asset.wxs" />
<!-- 关于知鹿：小程序图标 + 备案号 + 两份协议；全是固定内容，没有要等后端的数据位。样式照订单详情那一系。 -->
<view class="about-page">
  <view class="about-ambient" aria-hidden="true"></view>
  <view class="about-topbar">
    <view class="about-topbar-inner" style="height: {{navigationBarHeight}}px; padding-top: {{statusBarHeight}}px;">
      <view class="about-back" bindtap="handleBack" aria-label="返回" aria-role="button"><view class="about-back-icon"></view></view>
      <text class="about-topbar-title" style="top: {{statusBarHeight}}px; height: {{navigationBarHeight}}px; line-height: {{navigationBarHeight}}px;">关于知鹿</text>
    </view>
  </view>

  <scroll-view class="about-scroll" scroll-y show-scrollbar="{{false}}" style="padding-top: {{contentTop}}px;">
    <view class="about-shell">
      <view class="about-brand">
        <image class="about-brand-logo" src="{{UA.src(ui, '/assets/brand/app-icon.png')}}" mode="aspectFit" aria-label="知鹿学习 iDeer"></image>
        <text class="about-brand-name">知鹿学习</text>
        <text class="about-brand-slogan">让每个孩子学在自己的节奏里</text>
      </view>

      <view class="about-section">
        <view class="about-heading">备案信息</view>
        <view class="about-card">
          <view class="about-row" bindtap="copyFilingNumber" aria-role="button" aria-label="复制小程序备案号">
            <text class="about-row-label">小程序备案号</text>
            <view class="about-row-value"><text>{{filingNumber}}</text><text class="about-copy">复制</text></view>
          </view>
        </view>
      </view>

      <view class="about-section">
        <view class="about-heading">协议与隐私</view>
        <view class="about-card">
          <view class="about-row about-link" bindtap="openUserAgreement" aria-role="button">
            <text class="about-link-title">《知鹿用户协议》</text>
            <view class="about-chevron" aria-hidden="true"></view>
          </view>
          <view class="about-row about-link" bindtap="openPrivacyContract" aria-role="button">
            <text class="about-link-title">《隐私保护指引》</text>
            <view class="about-chevron" aria-hidden="true"></view>
          </view>
        </view>
      </view>
    </view>
  </scroll-view>
</view>
<dev-reset-fab />
