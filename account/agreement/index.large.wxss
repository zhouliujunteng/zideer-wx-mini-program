/* 自动生成，请勿手改：index.wxss 在平板、电脑大屏（窗口宽 ≥ 450px）下的样式。
   rpx 按 1rpx = 0.6px 换算，固定定位元素收进居中栏；改完源文件后运行 node scripts/build-large-screen-styles.mjs */
@media (min-width: 450px) {
.doc-page{height:100vh}
.doc-topbar{top:0;left:max(0px, 50% - var(--lg-col) / 2);width:min(100%, var(--lg-col))}
.doc-topbar-inner{padding:0 19px 9px}
.doc-back{width:32px;height:32px;border-radius:50%}
.doc-back-icon{width:13px;height:13px;border-bottom:2px solid #24332D;border-left:2px solid #24332D}
.doc-topbar-title{left:50%;font-size:21px;font-weight:700;letter-spacing:-1px}
.doc-scroll{height:100vh}
.doc-shell{min-height:100%;padding:7px 19px calc(28px + env(safe-area-inset-bottom))}
.doc-title{padding:0 2px;font-size:21px;font-weight:700;line-height:1.4}
.doc-meta{margin-top:8px;padding:0 2px;font-size:13px;line-height:1.6}
.doc-card{margin-top:16px;padding:19px 16px 4px;border-radius:21px}
.doc-section{margin-bottom:4px}
.doc-heading{margin-bottom:7px;font-size:16px;font-weight:700;line-height:1.6}
.doc-paragraph{margin-bottom:14px;font-size:16px;line-height:1.75}
}
