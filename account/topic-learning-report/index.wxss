.report-page { min-height: 100vh; padding: 48rpx 28rpx calc(env(safe-area-inset-bottom) + 48rpx); }.report-skeleton { height: 640rpx; }.report-head { padding: 0 8rpx; }.report-eyebrow { display: block; color: var(--accent-deep); font-size: 22rpx; font-weight: 700; }.report-title { display: block; margin-top: 12rpx; font-size: 42rpx; font-weight: 700; }.student-switcher { display: flex; width: 100%; min-height: 120rpx; align-items: center; margin-top: 38rpx; padding: 20rpx 22rpx; text-align: left; }.student-avatar { display: flex; width: 64rpx; height: 64rpx; align-items: center; justify-content: center; flex: none; border-radius: 32rpx; background: var(--accent-soft); color: var(--accent-deep); font-size: 25rpx; font-weight: 700; }.student-copy { min-width: 0; flex: 1; margin-left: 18rpx; }.student-label, .student-name { display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }.student-label { color: var(--muted); font-size: 20rpx; }.student-name { margin-top: 7rpx; font-size: 26rpx; font-weight: 700; }.student-action { margin-left: 12rpx; color: var(--accent-deep); font-size: 21rpx; white-space: nowrap; }.report-empty { margin-top: 34rpx; padding: 30rpx 26rpx; }.report-empty__title { display: block; font-size: 28rpx; font-weight: 700; }.report-empty__copy { display: block; margin-top: 12rpx; color: var(--muted); font-size: 22rpx; line-height: 1.6; }.report-tabs { display: flex; width: calc(100% + 56rpx); margin: 30rpx -28rpx 0; white-space: nowrap; }.report-tab { display: inline-flex; min-width: 210rpx; min-height: 104rpx; flex-direction: column; justify-content: center; margin-left: 18rpx; padding: 16rpx 20rpx; border: 1rpx solid var(--line); border-radius: 8rpx; background: var(--surface); color: var(--muted); text-align: left; }.report-tab:last-child { margin-right: 18rpx; }.report-tab text:first-child { color: var(--ink); font-size: 23rpx; font-weight: 700; }.report-tab text:last-child { overflow: hidden; margin-top: 7rpx; font-size: 19rpx; text-overflow: ellipsis; }.report-tab--active { border-color: var(--accent); background: var(--accent-soft); }.report-card { margin-top: 18rpx; padding: 28rpx 26rpx; }.report-card__top { display: flex; min-width: 0; align-items: flex-start; justify-content: space-between; gap: 16rpx; }.report-card__label, .report-card__no { display: block; }.report-card__label { color: var(--muted); font-size: 20rpx; }.report-card__no { margin-top: 8rpx; font-size: 27rpx; font-weight: 700; }.status-pill { flex: none; max-width: 230rpx; padding: 8rpx 12rpx; border-radius: 6rpx; background: var(--yellow-soft); color: var(--ink-soft); font-size: 19rpx; }.status-pill--pass { background: var(--green-soft); color: var(--green); }.report-meta { display: flex; flex-wrap: wrap; gap: 10rpx 20rpx; margin-top: 20rpx; color: var(--muted); font-size: 20rpx; }.report-section { margin-top: 38rpx; }.report-section__title { display: block; margin: 0 8rpx 16rpx; font-size: 24rpx; font-weight: 700; }.report-panel { padding: 26rpx; color: var(--ink-soft); font-size: 23rpx; line-height: 1.7; }.report-panel__label { display: block; color: var(--muted); font-size: 20rpx; }.report-panel__label--gap { margin-top: 22rpx; }.review-status { display: block; margin-bottom: 10rpx; color: var(--accent-deep); font-size: 24rpx; font-weight: 700; }.audio-list { overflow: hidden; padding: 0 24rpx; }.audio-row { display: flex; min-height: 108rpx; align-items: center; border-bottom: 1rpx solid var(--line); }.audio-row:last-child { border-bottom: 0; }.audio-row__index { display: flex; width: 44rpx; height: 44rpx; align-items: center; justify-content: center; flex: none; border-radius: 22rpx; background: var(--accent-soft); color: var(--accent-deep); font-size: 20rpx; font-weight: 700; }.audio-row__copy { min-width: 0; flex: 1; margin-left: 15rpx; }.audio-row__title, .audio-row__meta { display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }.audio-row__title { font-size: 22rpx; font-weight: 600; }.audio-row__meta { margin-top: 5rpx; color: var(--muted); font-size: 18rpx; }.audio-row__action { min-width: 76rpx; margin-left: 10rpx; padding: 0; color: var(--accent-deep); font-size: 21rpx; }.audio-row__disabled { margin-left: 10rpx; color: var(--muted); font-size: 20rpx; }.audio-empty { padding: 30rpx 0; color: var(--muted); font-size: 21rpx; }
