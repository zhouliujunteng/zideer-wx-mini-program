@import "../../styles/skeleton.wxss";
/* 收货地址：照「我的微信二维码」（account/wechat-qr）的顶栏与白色大圆角卡片。 */
page { background: #FAFAFA; }

.sa-page { position: relative; height: 100vh; overflow: hidden; background: #FAFAFA; color: #24332D; }
.sa-ambient { position: fixed; top: 0; left: 0; z-index: 0; width: 100%; height: 100%; pointer-events: none; background: radial-gradient(125% 52% at 100% 0, rgba(255, 222, 190, .84) 0%, rgba(255, 236, 218, .48) 40%, rgba(250, 250, 250, 0) 76%), #FAFAFA; }
.sa-topbar { position: fixed; top: 0; left: 0; z-index: 20; width: 100%; box-sizing: border-box; background: transparent; }
.sa-topbar-inner { position: relative; display: flex; align-items: center; box-sizing: content-box; padding: 0 32rpx 16rpx; }
.sa-back { display: flex; flex: 0 0 auto; align-items: center; justify-content: center; width: 54rpx; height: 54rpx; border-radius: 50%; }
.sa-back:active { background: #F0F2EF; }
.sa-back-icon { width: 22rpx; height: 22rpx; border-bottom: 4rpx solid #24332D; border-left: 4rpx solid #24332D; transform: rotate(45deg) scale(.7); }
.sa-topbar-title { position: absolute; left: 50%; display: block; color: #24332D; font-size: 36rpx; font-weight: 700; letter-spacing: -1rpx; transform: translateX(-50%); white-space: nowrap; }
.sa-scroll { position: relative; z-index: 1; height: 100vh; box-sizing: border-box; background: transparent; }
.sa-shell { min-height: 100%; padding: 0 32rpx calc(48rpx + env(safe-area-inset-bottom)); box-sizing: border-box; }

.sa-card { margin-top: 22rpx; padding: 28rpx; border-radius: 36rpx; background: #fff; }
.sa-shell > .sa-card:first-child { margin-top: 20rpx; }
.sa-intro-title { display: block; color: #24332D; font-size: 30rpx; font-weight: 700; line-height: 1.4; }
.sa-intro-copy { display: block; margin-top: 14rpx; color: #7E8A82; font-size: 24rpx; line-height: 1.6; }
.sa-notice { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; margin-top: 22rpx; padding: 22rpx 28rpx; border-radius: 28rpx; background: #FFF4E8; color: #8A5A1E; font-size: 24rpx; line-height: 1.5; }
.sa-notice-action { flex: 0 0 auto; color: #FD7C02; font-weight: 600; }

.sa-field { padding-bottom: 26rpx; margin-bottom: 26rpx; border-bottom: 1rpx solid #F0F2EF; }
.sa-field.is-last { padding-bottom: 0; margin-bottom: 0; border-bottom: 0; }
.sa-label { display: block; margin-bottom: 14rpx; color: #7E8A82; font-size: 24rpx; }
.sa-input { display: block; width: 100%; min-height: 56rpx; box-sizing: border-box; color: #24332D; font-size: 30rpx; line-height: 56rpx; }
.sa-picker { height: 56rpx; }
.sa-textarea { min-height: 112rpx; line-height: 1.5; }
.sa-placeholder { color: #B0B8B2; }
.sa-input-sk { height: 44rpx; margin-top: 14rpx; border-radius: 12rpx; }

.sa-button { margin-top: 40rpx; height: 92rpx; border-radius: 999rpx; background: #FD7C02; color: #fff; font-size: 30rpx; font-weight: 600; line-height: 92rpx; text-align: center; }
.sa-button:active { opacity: .7; }
.sa-button.is-disabled { opacity: .45; }

@import "./index.large.wxss"; /* 平板、电脑大屏样式：由 scripts/build-large-screen-styles.mjs 生成，改完本文件后重跑；这一行须留在文件末尾 */
