.family-page { min-height: 100vh; padding: 48rpx 28rpx calc(env(safe-area-inset-bottom) + 48rpx); }.family-head { padding: 0 8rpx; }.family-eyebrow { display: block; color: var(--accent-deep); font-size: 22rpx; font-weight: 700; }.family-title { display: block; margin-top: 12rpx; font-size: 42rpx; font-weight: 700; }.family-actions { display: flex; min-height: 132rpx; align-items: stretch; margin-top: 32rpx; }.family-action { display: flex; min-width: 0; flex: 1; flex-direction: column; justify-content: center; padding: 18rpx 22rpx; text-align: left; }.family-action__label { color: var(--muted); font-size: 20rpx; }.family-action__title { margin-top: 10rpx; font-size: 27rpx; font-weight: 700; }.family-actions__line { width: 1rpx; margin: 22rpx 0; background: var(--line); }.family-section { margin-top: 40rpx; }.family-section__head { display: flex; align-items: center; justify-content: space-between; margin: 0 8rpx 16rpx; }.family-section__title { color: var(--ink-soft); font-size: 23rpx; font-weight: 700; }.family-section__action { min-height: 52rpx; color: var(--accent-deep); font-size: 22rpx; }.family-card { display: flex; width: 100%; min-height: 112rpx; align-items: center; margin-top: 14rpx; padding: 20rpx 22rpx; text-align: left; }.family-avatar { display: flex; width: 58rpx; height: 58rpx; align-items: center; justify-content: center; border-radius: 29rpx; background: var(--accent-soft); color: var(--accent-deep); font-size: 22rpx; font-weight: 700; }.family-copy { min-width: 0; flex: 1; margin-left: 18rpx; }.family-name, .family-meta { display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }.family-name { font-size: 26rpx; font-weight: 700; }.family-meta { margin-top: 8rpx; color: var(--muted); font-size: 20rpx; }.family-status { color: var(--green); font-size: 21rpx; font-weight: 700; }.family-empty { padding: 28rpx; color: var(--muted); font-size: 23rpx; }
