/* 操作指南：页面框架照帮助与反馈；示意屏是一部竖屏手机（照付款指南、小程序链接教程的橙色描边 + 点按波纹）。
   点按动画一轮 2.2 秒：手指从右下滑入 → 按下（目标缩小、波纹扩散）→ 松开淡出，循环播放。 */
@import "../../styles/skeleton.wxss";

page { background: #FAFAFA; }

.hg-page { position: relative; height: 100vh; overflow: hidden; background: #FAFAFA; color: #24332D; }
.hg-ambient { position: fixed; top: 0; left: 0; z-index: 0; width: 100%; height: 100%; pointer-events: none; background: radial-gradient(120% 40% at 100% 0, rgba(255, 214, 170, .66) 0%, rgba(255, 233, 210, .36) 42%, rgba(250, 250, 250, 0) 76%), #FAFAFA; }
.hg-topbar { position: fixed; top: 0; left: 0; z-index: 20; width: 100%; box-sizing: border-box; background: transparent; transition: background-color .2s ease, box-shadow .2s ease; }
.hg-topbar.is-solid { background: rgba(250, 250, 250, .94); -webkit-backdrop-filter: blur(12px); backdrop-filter: blur(12px); box-shadow: 0 2rpx 0 rgba(36, 51, 45, .05); }
.hg-topbar-inner { position: relative; display: flex; align-items: center; box-sizing: content-box; padding: 0 32rpx 16rpx; }
.hg-back { display: flex; flex: 0 0 auto; align-items: center; justify-content: center; width: 54rpx; height: 54rpx; border-radius: 50%; }
.hg-back-pressed { background: rgba(36, 51, 45, .08); }
.hg-back-icon { width: 22rpx; height: 22rpx; border-bottom: 4rpx solid #24332D; border-left: 4rpx solid #24332D; transform: rotate(45deg) scale(.7); }
.hg-topbar-title { position: absolute; left: 50%; display: block; color: #24332D; font-size: 36rpx; font-weight: 700; letter-spacing: -1rpx; transform: translateX(-50%); white-space: nowrap; }
.hg-scroll { position: relative; z-index: 1; height: 100vh; box-sizing: border-box; background: transparent; }
.hg-shell { min-height: 100%; padding: 0 32rpx calc(176rpx + env(safe-area-inset-bottom)); box-sizing: border-box; }

/* 指南头 */
.hg-hero { padding: 24rpx 4rpx 8rpx; animation: hg-rise .36s ease both; }
.hg-hero-art { display: block; width: 150rpx; height: 150rpx; margin-left: -10rpx; }
.sk.hg-hero-art { width: 112rpx; height: 112rpx; margin: 18rpx 0 20rpx; border-radius: 32rpx; }
.hg-hero-title { display: block; margin-top: 8rpx; color: #24332D; font-size: 44rpx; font-weight: 750; line-height: 1.3; }
.hg-hero-summary { display: block; margin-top: 14rpx; color: #6B766F; font-size: 26rpx; line-height: 1.65; }
.hg-hero-meta { display: flex; align-items: center; gap: 12rpx; margin-top: 22rpx; padding: 16rpx 22rpx; border-radius: 20rpx; background: #FFF1E3; color: #9D4C08; font-size: 23rpx; line-height: 1.5; }
.hg-hero-dot { flex: 0 0 14rpx; width: 14rpx; height: 14rpx; border-radius: 50%; background: #FD7C02; box-shadow: 0 0 0 6rpx rgba(253, 124, 2, .18); animation: hg-breathe 2.2s ease-in-out infinite; }

.tone-orange { background: #FFF1E3; color: #E06A00; }
.tone-blue { background: #E8F2FF; color: #2F74CF; }
.tone-green { background: #E5F5EC; color: #2B8C5B; }
.tone-purple { background: #F0EBFF; color: #6F52CC; }
.tone-pink { background: #FFEDF0; color: #CF4C66; }
.tone-teal { background: #E2F5F4; color: #1F8A84; }

/* 步骤卡 */
.hg-step { margin-top: 26rpx; padding: 30rpx 26rpx 26rpx; border-radius: 32rpx; background: #FFF; box-shadow: 0 6rpx 24rpx rgba(56, 75, 64, .035); animation: hg-rise .42s ease both; }
.hg-step-head { display: flex; align-items: flex-start; gap: 18rpx; }
.hg-step-no { flex: 0 0 46rpx; height: 46rpx; border-radius: 50%; background: #FFF1E3; color: #C25A02; font-size: 26rpx; font-weight: 700; line-height: 46rpx; text-align: center; }
.hg-step-copy { flex: 1; min-width: 0; }
.hg-step-title { display: block; color: #24332D; font-size: 29rpx; font-weight: 700; line-height: 1.55; }
.hg-step-hint { display: block; margin-top: 8rpx; color: #6B766F; font-size: 24rpx; line-height: 1.65; }

/* 示意屏：竖屏手机。机身 384×776rpx（约 1:2），屏幕里自上而下是灵动岛 / 状态栏、顶栏、内容、底栏、底部横条 */
.hg-figure { margin-top: 24rpx; }
.hg-stage { display: flex; justify-content: center; padding: 34rpx 0 32rpx; border-radius: 26rpx; background: linear-gradient(180deg, #FFF5EA 0%, #F5F3EF 100%); }
.hg-phone { position: relative; width: 384rpx; height: 776rpx; box-sizing: border-box; padding: 10rpx; border-radius: 60rpx; background: #1F2823; box-shadow: 0 24rpx 48rpx rgba(36, 51, 45, .22), inset 0 0 0 2rpx #3A453F; }
.hg-phone-screen { position: relative; display: flex; flex-direction: column; height: 100%; overflow: hidden; border-radius: 50rpx; background: #F5F6F5; }
.hg-phone-island { position: absolute; top: 14rpx; left: 50%; z-index: 7; width: 104rpx; height: 30rpx; border-radius: 999rpx; background: #1F2823; transform: translateX(-50%); }
.hg-phone-status { display: flex; flex: none; align-items: center; justify-content: space-between; height: 58rpx; padding: 0 34rpx 0 40rpx; color: #24332D; font-size: 19rpx; font-weight: 700; }
.hg-phone-battery { width: 30rpx; height: 14rpx; box-sizing: border-box; border: 2rpx solid #24332D; border-radius: 4rpx; }
.hg-phone-nav { position: relative; display: flex; flex: none; align-items: center; justify-content: space-between; height: 60rpx; padding: 0 16rpx; }
.hg-phone-back { width: 14rpx; height: 14rpx; margin-left: 8rpx; border-bottom: 3rpx solid #24332D; border-left: 3rpx solid #24332D; transform: rotate(45deg); }
.hg-phone-back.is-hidden { visibility: hidden; }
.hg-phone-title { position: absolute; left: 50%; max-width: 168rpx; overflow: hidden; color: #24332D; font-size: 21rpx; font-weight: 700; text-overflow: ellipsis; transform: translateX(-50%); white-space: nowrap; }
.hg-phone-tools { display: flex; align-items: center; gap: 8rpx; }
.hg-flame { position: relative; display: flex; align-items: center; gap: 6rpx; height: 34rpx; padding: 0 12rpx 0 10rpx; box-sizing: border-box; border-radius: 999rpx; background: rgba(255, 255, 255, .9); color: #E06A00; font-size: 18rpx; font-weight: 700; }
.hg-flame-icon { width: 14rpx; height: 14rpx; margin: 4rpx 2rpx 0; border-radius: 0 50% 50% 50%; background: linear-gradient(135deg, #FFB347, #FD5E02); transform: rotate(-135deg); }
.hg-capsule { position: relative; display: flex; align-items: center; justify-content: space-around; width: 84rpx; height: 34rpx; box-sizing: border-box; padding: 0 8rpx; border: 2rpx solid #DADFDB; border-radius: 999rpx; background: rgba(255, 255, 255, .8); }
.hg-capsule-dots { display: flex; gap: 3rpx; }
.hg-capsule-dots view { width: 5rpx; height: 5rpx; border-radius: 50%; background: #24332D; }
.hg-capsule-line { width: 2rpx; height: 16rpx; background: #DADFDB; }
.hg-capsule-close { width: 13rpx; height: 13rpx; box-sizing: border-box; border: 2rpx solid #24332D; border-radius: 50%; }
.hg-phone-body { flex: 1; min-height: 0; overflow: hidden; padding: 14rpx 16rpx 12rpx; }
/* 内容下面补几张淡色卡片，屏幕不至于空着一大块 */
.hg-phone-filler { margin-top: 6rpx; opacity: .5; }
.hgb-filler-card { height: 100rpx; margin-top: 12rpx; border-radius: 16rpx; background: #FFF; }
.hgb-filler-card.is-short { height: 64rpx; }
.hg-phone-home { position: relative; flex: none; height: 24rpx; }
.hg-phone-home::after { position: absolute; bottom: 8rpx; left: 50%; width: 120rpx; height: 7rpx; border-radius: 999rpx; background: #24332D; content: ''; transform: translateX(-50%); }
.hg-tabbar + .hg-phone-home { background: #FFF; }
.hg-caption { display: block; padding: 14rpx 12rpx 0; color: #7D877F; font-size: 20rpx; line-height: 1.5; text-align: center; }

/* 要点的位置：橙色描边 + 按下动画；里面的 .hg-tap 是手指落点 */
.is-hot { position: relative; z-index: 2; box-shadow: inset 0 0 0 3rpx #FD7C02; animation: hg-press 2.2s ease-in-out infinite; }
.hgb-tile.is-hot, .hgb-grid-item.is-hot, .hgb-pair-item.is-hot, .hgb-code-value.is-hot, .hg-flame.is-hot, .hg-capsule.is-hot, .hgb-menu-row.is-hot, .hgb-list-row.is-hot, .hgb-chip.is-hot, .hgb-input.is-hot, .hgb-card.is-hot, .hg-tab.is-hot { background-color: #FFF7ED; }
.hg-tap { position: absolute; top: 64%; right: 13%; z-index: 3; width: 0; height: 0; pointer-events: none; }
/* 小按钮上落在图标那一侧，不盖住数字：胶囊落在「···」，火苗落在火苗上，底栏、标签落在正中 */
.hg-capsule .hg-tap { top: 50%; right: 72%; }
.hg-flame .hg-tap { top: 50%; right: 70%; }
.hg-tab .hg-tap, .hgb-chip .hg-tap, .hgb-grid-item .hg-tap { top: 58%; right: 50%; }
.hg-tap-ring { position: absolute; top: -28rpx; left: -28rpx; width: 56rpx; height: 56rpx; box-sizing: border-box; border: 3rpx solid #FD7C02; border-radius: 50%; opacity: 0; animation: hg-ring 2.2s ease-out infinite; }
.hg-tap-ring.is-late { animation-delay: .22s; }
.hg-tap-dot { position: absolute; top: -15rpx; left: -15rpx; width: 30rpx; height: 30rpx; border-radius: 50%; background: rgba(253, 124, 2, .88); box-shadow: 0 0 0 7rpx rgba(253, 124, 2, .2), 0 6rpx 14rpx rgba(181, 88, 0, .3); opacity: 0; animation: hg-finger 2.2s ease-in-out infinite; }
.hg-tag { position: absolute; top: -20rpx; right: 10rpx; z-index: 4; padding: 2rpx 12rpx; border-radius: 999rpx; background: #FD7C02; color: #FFF; font-size: 17rpx; font-weight: 600; line-height: 1.6; white-space: nowrap; animation: hg-bob 2.2s ease-in-out infinite; }
.hg-tag.is-left { right: auto; left: 10rpx; }

/* 示意屏里的各种块 */
.hgb-heading { display: block; margin: 16rpx 4rpx 10rpx; color: #24332D; font-size: 20rpx; font-weight: 700; }
.hgb-profile { display: flex; align-items: center; gap: 16rpx; padding: 10rpx 6rpx 6rpx; }
.hgb-avatar { width: 64rpx; height: 64rpx; border-radius: 50%; background: linear-gradient(135deg, #FFD7AE, #FFB36B); }
.hgb-profile-lines { flex: 1; }
.hgb-profile-name { display: block; color: #24332D; font-size: 22rpx; font-weight: 700; }
.hgb-line { width: 100%; height: 10rpx; margin-top: 10rpx; border-radius: 5rpx; background: #E1E5E2; }
.hgb-line.is-mid { width: 68%; }
.hgb-line.is-short { width: 40%; }
.hgb-lines { padding: 8rpx 6rpx; }

.hgb-tiles { display: flex; gap: 12rpx; margin-top: 14rpx; }
.hgb-tile { display: flex; flex: 1; align-items: center; gap: 10rpx; min-width: 0; padding: 14rpx; border-radius: 16rpx; background: #FFF; }
.hgb-tile-icon { flex: 0 0 34rpx; height: 34rpx; border-radius: 10rpx; background: #FFE3C4; }
.hgb-tile-copy { min-width: 0; }
.hgb-tile-label { display: block; color: #6B766F; font-size: 17rpx; }
.hgb-tile-value { display: block; color: #24332D; font-size: 22rpx; font-weight: 700; }

.hgb-grid-wrap, .hgb-menu-wrap, .hgb-list-wrap, .hgb-input-wrap { margin-top: 6rpx; }
.hgb-grid { display: flex; justify-content: space-between; padding: 14rpx 6rpx; border-radius: 16rpx; background: #FFF; }
.hgb-grid-item { display: flex; flex: 1; flex-direction: column; align-items: center; gap: 8rpx; padding: 8rpx 0; border-radius: 14rpx; }
.hgb-grid-icon { width: 40rpx; height: 40rpx; border-radius: 12rpx; background: #FFEBD6; }
.hgb-grid-label { color: #3B4941; font-size: 17rpx; white-space: nowrap; }

.hgb-menu { overflow: visible; border-radius: 16rpx; background: #FFF; }
.hgb-menu-row { display: flex; align-items: center; gap: 10rpx; padding: 14rpx 16rpx; border-bottom: 2rpx solid #F2F4F1; border-radius: 12rpx; }
.hgb-menu-row:last-child { border-bottom: 0; }
.hgb-menu-row.is-muted { opacity: .5; }
.hgb-menu-copy { flex: 1; min-width: 0; }
.hgb-menu-label { display: block; color: #24332D; font-size: 20rpx; font-weight: 600; }
.hgb-menu-hint { display: block; margin-top: 2rpx; color: #8A958D; font-size: 16rpx; }
.hgb-menu-value { color: #6B766F; font-size: 18rpx; }
.hgb-chevron { width: 10rpx; height: 10rpx; border-top: 2rpx solid #B4BCB6; border-right: 2rpx solid #B4BCB6; transform: rotate(45deg); }

.hgb-chips { display: flex; gap: 10rpx; margin-top: 12rpx; }
.hgb-chip { flex: 1; min-width: 0; padding: 10rpx 6rpx; border-radius: 999rpx; background: #FFF; color: #5D6A62; font-size: 18rpx; text-align: center; white-space: nowrap; }
.hgb-chip.is-active { background: #24332D; color: #FFF; font-weight: 650; }
.hgb-chip.is-active.is-hot { background: #FFF7ED; color: #C25A02; }

.hgb-list-row { display: flex; align-items: center; gap: 14rpx; margin-top: 10rpx; padding: 14rpx; border-radius: 16rpx; background: #FFF; }
.hgb-list-thumb { display: flex; flex: 0 0 60rpx; align-items: center; justify-content: center; height: 60rpx; border-radius: 14rpx; background: #FFE9D2; color: #E06A00; font-size: 22rpx; font-weight: 700; }
.hgb-list-copy { flex: 1; min-width: 0; }
.hgb-list-title { display: block; overflow: hidden; color: #24332D; font-size: 20rpx; font-weight: 650; text-overflow: ellipsis; white-space: nowrap; }
.hgb-list-meta { display: block; margin-top: 4rpx; color: #8A958D; font-size: 16rpx; }
.hgb-list-badge { flex: 0 0 auto; padding: 2rpx 12rpx; border-radius: 999rpx; background: #FFF1E3; color: #C25A02; font-size: 16rpx; }

.hgb-card { margin-top: 14rpx; padding: 18rpx; border-radius: 18rpx; background: #FFF; }
.hgb-card-title { display: block; color: #24332D; font-size: 21rpx; font-weight: 700; }
.hgb-card-text { display: block; margin-top: 6rpx; color: #6B766F; font-size: 17rpx; line-height: 1.55; }
.tone-card-orange { background: linear-gradient(135deg, #FFF3E6, #FFE4C8); }
.tone-card-dark { background: #24332D; }
.tone-card-dark .hgb-card-title { color: #FFF; }
.tone-card-dark .hgb-card-text { color: #C6CCC8; }
.hgb-card-button { position: relative; display: inline-block; margin-top: 14rpx; padding: 8rpx 22rpx; border-radius: 999rpx; background: #FD7C02; color: #FFF; font-size: 18rpx; font-weight: 650; }
.hgb-card-button.is-hot { box-shadow: 0 0 0 3rpx #FFF, 0 0 0 6rpx #FD7C02; }

.hgb-input { position: relative; display: flex; align-items: center; height: 64rpx; padding: 0 18rpx; border-radius: 16rpx; background: #FFF; }
.hgb-input-placeholder { color: #A7B0AA; font-size: 19rpx; }
.hgb-input-value { color: #24332D; font-size: 21rpx; font-weight: 650; letter-spacing: 2rpx; }
.hgb-caret { width: 2rpx; height: 26rpx; margin-left: 4rpx; background: #FD7C02; animation: hg-caret 1s steps(1) infinite; }
.hgb-button { position: relative; margin-top: 14rpx; padding: 14rpx; border-radius: 999rpx; background: #FD7C02; color: #FFF; font-size: 20rpx; font-weight: 650; text-align: center; }
.hgb-button.is-secondary { background: #FFF; color: #3B4941; }
.hgb-button.is-hot { box-shadow: 0 0 0 3rpx #FFF, 0 0 0 6rpx #FD7C02; }

.hgb-code { display: flex; flex-direction: column; align-items: center; margin-top: 14rpx; padding: 20rpx 18rpx; border-radius: 18rpx; background: #FFF; }
.hgb-code-label { color: #6B766F; font-size: 17rpx; }
.hgb-code-value { position: relative; margin-top: 8rpx; padding: 0 16rpx; border-radius: 12rpx; color: #24332D; font-size: 36rpx; font-weight: 750; letter-spacing: 8rpx; }
.hgb-code-button { position: relative; margin-top: 12rpx; padding: 6rpx 24rpx; border-radius: 999rpx; background: #FFF1E3; color: #C25A02; font-size: 18rpx; font-weight: 650; }

.hgb-pair { display: flex; gap: 12rpx; margin-top: 14rpx; }
.hgb-pair-item { position: relative; display: flex; flex: 1; flex-direction: column; min-width: 0; padding: 18rpx 16rpx; border-radius: 18rpx; background: #FFF; }
.hgb-pair-kicker { color: #8A958D; font-size: 16rpx; }
.hgb-pair-title { margin-top: 6rpx; color: #24332D; font-size: 22rpx; font-weight: 700; }
.hgb-pair-text { margin-top: 4rpx; color: #6B766F; font-size: 16rpx; }
.hgb-note { display: block; margin-top: 12rpx; padding: 0 6rpx; color: #7D877F; font-size: 17rpx; line-height: 1.55; }

/* 示意底栏 */
.hg-tabbar { display: flex; padding: 10rpx 6rpx 14rpx; border-top: 2rpx solid #E7EAE7; background: #FFF; }
.hg-tab { display: flex; flex: 1; flex-direction: column; align-items: center; gap: 4rpx; padding: 6rpx 0; border-radius: 14rpx; color: #8A958D; font-size: 16rpx; }
.hg-tab-icon { width: 30rpx; height: 30rpx; border-radius: 9rpx; background: #DDE2DE; }
.hg-tab.is-active { color: #FD7C02; font-weight: 650; }
.hg-tab.is-active .hg-tab-icon { background: #FD7C02; }

/* 示意弹窗 */
.hg-modal-mask { position: absolute; top: 0; right: 0; bottom: 0; left: 0; z-index: 5; display: flex; align-items: center; justify-content: center; background: rgba(20, 28, 24, .42); }
.hg-modal { width: 76%; overflow: visible; border-radius: 22rpx; background: #FFF; text-align: center; }
.hg-modal-title { display: block; padding: 26rpx 22rpx 0; color: #24332D; font-size: 22rpx; font-weight: 700; }
.hg-modal-text { display: block; padding: 10rpx 24rpx 0; color: #6B766F; font-size: 18rpx; line-height: 1.55; }
.hg-modal-actions { display: flex; margin-top: 22rpx; border-top: 2rpx solid #EEF0ED; }
.hg-modal-button { position: relative; flex: 1; padding: 16rpx 0; color: #3B4941; font-size: 20rpx; }
.hg-modal-button + .hg-modal-button { border-left: 2rpx solid #EEF0ED; }
.hg-modal-button.is-confirm { color: #E06A00; font-weight: 700; }

/* 小提示、相关问题 */
.hg-tips { margin-top: 30rpx; padding: 28rpx 26rpx; border-radius: 28rpx; background: #FFF; }
.hg-tips-title { display: block; color: #24332D; font-size: 27rpx; font-weight: 700; }
.hg-tip { display: flex; gap: 14rpx; margin-top: 14rpx; color: #56645B; font-size: 24rpx; line-height: 1.7; }
.hg-tip-dot { flex: 0 0 10rpx; height: 10rpx; margin-top: 15rpx; border-radius: 50%; background: #FFB36B; }
.hg-related { margin-top: 36rpx; }
.hg-related-title { display: block; padding: 0 6rpx; color: #24332D; font-size: 29rpx; font-weight: 700; }
.hg-faq { margin-top: 14rpx; border-radius: 26rpx; background: #FFF; overflow: hidden; }
.hg-faq-head { display: flex; align-items: center; gap: 16rpx; padding: 26rpx; }
.hg-faq-head-pressed { background: #FBF8F4; }
.hg-faq-title { flex: 1; min-width: 0; color: #24332D; font-size: 26rpx; font-weight: 600; line-height: 1.5; }
.hg-faq-chevron { width: 14rpx; height: 14rpx; margin: 0 6rpx 6rpx 0; border-right: 3rpx solid #B4BCB6; border-bottom: 3rpx solid #B4BCB6; transform: rotate(45deg); transition: transform .22s ease; }
.hg-faq.is-open .hg-faq-chevron { margin-bottom: -6rpx; border-color: #FD7C02; transform: rotate(-135deg); }
.hg-faq-body { padding: 0 28rpx 26rpx; animation: hg-unfold .24s ease both; }
.hg-faq-paragraph { display: block; margin-top: 12rpx; color: #56645B; font-size: 24rpx; line-height: 1.75; }
.hg-faq-paragraph:first-child { margin-top: 0; }

/* 找不到指南 */
.hg-missing { display: flex; flex-direction: column; align-items: center; margin-top: 80rpx; padding: 56rpx 40rpx; border-radius: 36rpx; background: #FFF; text-align: center; }
.hg-missing-title { color: #24332D; font-size: 30rpx; font-weight: 700; }
.hg-missing-copy { margin-top: 12rpx; color: #7E8A82; font-size: 24rpx; line-height: 1.7; }
.hg-missing-action { margin-top: 30rpx; padding: 20rpx 48rpx; border-radius: 999rpx; background: #FD7C02; color: #FFF; font-size: 26rpx; font-weight: 650; }

/* 底部操作栏 */
.hg-bar { position: fixed; right: 0; bottom: 0; left: 0; z-index: 18; display: flex; align-items: center; gap: 20rpx; padding: 18rpx 32rpx calc(18rpx + env(safe-area-inset-bottom)); background: rgba(255, 255, 255, .96); box-shadow: 0 -8rpx 24rpx rgba(36, 51, 45, .06); }
.hg-bar-secondary, .hg-bar-primary { height: 88rpx; border-radius: 999rpx; font-size: 28rpx; font-weight: 650; line-height: 88rpx; text-align: center; transition: transform .12s ease, opacity .12s ease; }
.hg-bar-secondary { flex: 0 0 200rpx; background: #FFF1E3; color: #9D4C08; }
.hg-bar-primary { flex: 1; min-width: 0; overflow: hidden; background: linear-gradient(90deg, #FF9F43 0%, #FD7C02 100%); color: #FFF; text-overflow: ellipsis; white-space: nowrap; }
.hg-button-pressed { opacity: .82; transform: scale(.98); }

@keyframes hg-rise { from { opacity: 0; transform: translateY(18rpx); } to { opacity: 1; transform: translateY(0); } }
@keyframes hg-unfold { from { opacity: 0; transform: translateY(-10rpx); } to { opacity: 1; transform: translateY(0); } }
@keyframes hg-press { 0%, 34%, 56%, 100% { transform: scale(1); } 44% { transform: scale(.95); } }
@keyframes hg-ring { 0%, 40% { opacity: 0; transform: scale(.3); } 44% { opacity: 1; transform: scale(.45); } 100% { opacity: 0; transform: scale(1.7); } }
@keyframes hg-finger { 0% { opacity: 0; transform: translate(36rpx, 40rpx) scale(1.25); } 24% { opacity: .95; transform: translate(0, 0) scale(1.15); } 44% { opacity: 1; transform: translate(0, 0) scale(.78); } 60% { opacity: 1; transform: translate(0, 0) scale(1); } 84%, 100% { opacity: 0; transform: translate(0, 0) scale(1); } }
@keyframes hg-bob { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-5rpx); } }
@keyframes hg-breathe { 0%, 100% { box-shadow: 0 0 0 4rpx rgba(253, 124, 2, .18); } 50% { box-shadow: 0 0 0 10rpx rgba(253, 124, 2, .08); } }
@keyframes hg-caret { 0%, 49% { opacity: 1; } 50%, 100% { opacity: 0; } }

/* 分享按钮：胶囊左边的白色圆钮，照测评报告页（位置由页面按胶囊坐标给出） */
.hg-share-button { position: fixed; z-index: 21; display: flex; align-items: center; justify-content: center; border-radius: 50%; background: rgba(255, 255, 255, .78); box-shadow: 0 4rpx 14rpx rgba(36, 51, 45, .06); }
.hg-share-button image { display: block; width: 20px; height: 20px; }
.hg-share-button-pressed { opacity: .65; transform: scale(.94); }

/* 分享面板：上面是好友收到的卡片预览，下面是操作 */
.hg-share-mask { position: fixed; top: 0; right: 0; bottom: 0; left: 0; z-index: 50; display: flex; flex-direction: column; justify-content: flex-end; overflow: hidden; background: rgba(25, 31, 28, .72); -webkit-backdrop-filter: blur(8px); backdrop-filter: blur(8px); animation: hg-mask-in .3s ease-out both; }
.hg-share-preview { display: flex; flex: 1; flex-direction: column; align-items: center; justify-content: center; padding: 0 0 36rpx; }
.hg-share-card { width: 470rpx; padding: 22rpx 22rpx 14rpx; box-sizing: border-box; border-radius: 18rpx; background: #FFFFFF; box-shadow: 0 18rpx 48rpx rgba(0, 0, 0, .22); animation: hg-card-pop .42s cubic-bezier(.22, .75, .3, 1) both; }
.hg-share-card-head { display: flex; align-items: center; gap: 10rpx; color: #7D877F; font-size: 21rpx; }
.hg-share-card-logo { display: block; width: 32rpx; height: 32rpx; border-radius: 50%; }
.hg-share-card-title { display: block; margin-top: 12rpx; color: #24332D; font-size: 26rpx; font-weight: 600; line-height: 1.45; }
.hg-share-card-cover { display: block; width: 100%; height: 340rpx; margin-top: 14rpx; border-radius: 8rpx; }
.hg-share-card-foot { display: flex; align-items: center; gap: 8rpx; margin-top: 14rpx; padding-top: 12rpx; border-top: 2rpx solid #F0F2F0; color: #9AA49D; font-size: 19rpx; }
.hg-share-card-mark { width: 20rpx; height: 20rpx; box-sizing: border-box; border: 3rpx solid #6467F0; border-radius: 50%; }
.hg-share-preview-note { margin-top: 20rpx; color: rgba(255, 255, 255, .78); font-size: 22rpx; }
.hg-share-sheet { padding: 24rpx 38rpx calc(36rpx + env(safe-area-inset-bottom)); box-sizing: border-box; border-radius: 34rpx 34rpx 0 0; background: #FFFFFF; box-shadow: 0 -18rpx 58rpx rgba(11, 16, 14, .2); animation: hg-sheet-in .4s cubic-bezier(.22, .75, .3, 1) both; }
.hg-share-sheet-header { display: flex; height: 50rpx; align-items: center; justify-content: center; }
.hg-share-sheet-title { color: #303A34; font-size: 26rpx; font-weight: 700; line-height: 1.2; }
.hg-share-actions { display: flex; justify-content: center; gap: 64rpx; margin: 28rpx auto 0; }
.hg-share-action { position: relative; display: flex; flex: 0 0 128rpx; align-items: center; flex-direction: column; color: #59655E; font-size: 22rpx; line-height: 1.2; }
.hg-share-action:active { opacity: .68; }
.hg-share-action-icon { display: flex; width: 88rpx; height: 88rpx; align-items: center; justify-content: center; margin-bottom: 16rpx; border-radius: 50%; background: #F1F2F1; color: #3B4941; }
.hg-share-action-icon.is-wechat { background: transparent; }
.hg-share-action-icon image { display: block; width: 100%; height: 100%; }
.hg-share-native-button { position: absolute; top: 0; left: 0; z-index: 2; width: 100%; height: 100%; padding: 0; border: 0; border-radius: 0; background: transparent; opacity: 0; }
.hg-share-native-button::after { border: 0; }
.hg-share-cancel { display: flex; height: 54rpx; margin-top: 48rpx; align-items: center; justify-content: center; color: #77817B; font-size: 24rpx; line-height: 54rpx; }
/* 链接图标：两个扣在一起的圆角框，照小程序链接页 */
.hg-link-glyph { position: relative; width: 40rpx; height: 40rpx; transform: rotate(-45deg); }
.hg-link-glyph::before, .hg-link-glyph::after { position: absolute; top: 12rpx; width: 22rpx; height: 16rpx; box-sizing: border-box; border: 4rpx solid #3B4941; border-radius: 8rpx; content: ''; }
.hg-link-glyph::before { left: 1rpx; }
.hg-link-glyph::after { right: 1rpx; }

/* 复制链接提示：指向真实胶囊的「···」 */
.hg-copy-hint-layer { position: fixed; top: 0; right: 0; bottom: 0; left: 0; z-index: 40; background: rgba(25, 31, 28, .28); animation: hg-mask-in .24s ease-out both; }
.hg-copy-pointer { position: fixed; display: flex; flex-direction: column; align-items: flex-end; transform: translateX(-80%); animation: hg-pointer-bob 1.4s ease-in-out infinite; }
.hg-copy-pointer-arrow { width: 0; height: 0; margin-right: 18%; border-right: 12rpx solid transparent; border-bottom: 14rpx solid #FD7C02; border-left: 12rpx solid transparent; }
.hg-copy-pointer-bubble { display: flex; flex-direction: column; padding: 14rpx 22rpx; border-radius: 20rpx; background: #FD7C02; color: #FFFFFF; box-shadow: 0 8rpx 20rpx rgba(253, 124, 2, .3); }
.hg-copy-pointer-title { font-size: 23rpx; font-weight: 650; line-height: 1.4; white-space: nowrap; }
.hg-copy-pointer-copy { margin-top: 4rpx; color: rgba(255, 255, 255, .86); font-size: 19rpx; line-height: 1.4; white-space: nowrap; }

@keyframes hg-mask-in { from { opacity: 0; } to { opacity: 1; } }
@keyframes hg-sheet-in { from { transform: translateY(100%); } to { transform: translateY(0); } }
@keyframes hg-card-pop { from { opacity: 0; transform: translateY(24rpx) scale(.96); } to { opacity: 1; transform: translateY(0) scale(1); } }
@keyframes hg-pointer-bob { 0%, 100% { margin-top: 0; } 50% { margin-top: 8rpx; } }

@import "./index.large.wxss"; /* 平板、电脑大屏样式：由 scripts/build-large-screen-styles.mjs 生成，改完本文件后重跑；这一行须留在文件末尾 */
