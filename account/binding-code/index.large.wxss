/* 自动生成，请勿手改：index.wxss 在平板、电脑大屏（窗口宽 ≥ 450px）下的样式。
   rpx 按 1rpx = 0.6px 换算，固定定位元素收进居中栏；改完源文件后运行 node scripts/build-large-screen-styles.mjs */
@media (min-width: 450px) {
.surface{border-radius:14px}
.skeleton{border-radius:9px}
.state-panel{padding:72px 14px 24px}
.state-panel__mark{margin-bottom:14px;font-size:31px}
.state-panel__title{font-size:19px;font-weight:600}
.state-panel__copy{margin:13px 0 19px;font-size:15px;line-height:1.6}
.state-panel__action{border-radius:12px}
.state-panel__action::after{border:0}
.sk{border-radius:7px}
.sk-line{height:16px}
.sk-line + .sk-line{margin-top:8px}
.sk-short{width:40%}
.sk-mid{width:64%}
.sk-round{border-radius:50%}
.sk-card{height:96px;border-radius:14px}
.sk-card + .sk-card{margin-top:12px}
.binding-code-page{min-height:100vh;padding:28px 16px calc(env(safe-area-inset-bottom) + 28px)}
.binding-code-head{padding:0 4px}
.binding-code-eyebrow{font-size:13px;font-weight:700}
.binding-code-title{margin-top:7px;font-size:25px;font-weight:700}
.code-card{margin-top:32px;padding:25px 19px 18px}
.code-card__label{font-size:13px}
.code-card__value{margin-top:16px;font-family:"SF Mono", Menlo, monospace;font-size:36px;font-weight:700;letter-spacing:6px;line-height:1.2}
.code-card__footer{margin-top:20px;padding-top:14px;border-top:0.5px solid var(--line)}
.code-card__timer{font-size:15px;font-weight:700}
.code-card__hint{font-size:13px}
.code-refresh{width:100%;min-height:52px;margin-top:15px;border-radius:26px;font-size:16px;font-weight:700}
.code-card__value-skeleton{width:216px;height:43px;margin:16px auto 0}
.code-card__timer-skeleton{width:57px}
}
