@import "../../styles/account-form.wxss";
@import "../../styles/skeleton.wxss";

.binding-code-page { min-height: 100vh; padding: 48rpx 28rpx calc(env(safe-area-inset-bottom) + 48rpx); }.binding-code-head { padding: 0 8rpx; }.binding-code-eyebrow { display: block; color: var(--accent-deep); font-size: 22rpx; font-weight: 700; }.binding-code-title { display: block; margin-top: 12rpx; font-size: 42rpx; font-weight: 700; }.code-card { margin-top: 54rpx; padding: 42rpx 32rpx 30rpx; text-align: center; }.code-card__label { display: block; color: var(--muted); font-size: 22rpx; }.code-card__value { display: block; margin-top: 28rpx; font-family: "SF Mono", Menlo, monospace; font-size: 60rpx; font-weight: 700; letter-spacing: 10rpx; line-height: 1.2; }.code-card__footer { display: flex; justify-content: space-between; margin-top: 34rpx; padding-top: 24rpx; border-top: 1rpx solid var(--line); }.code-card__timer { color: var(--accent-deep); font-size: 25rpx; font-weight: 700; }.code-card__timer--expired { color: var(--muted); }.code-card__hint { color: var(--muted); font-size: 23rpx; }.code-refresh { display: flex; width: 100%; min-height: 88rpx; align-items: center; justify-content: center; margin-top: 26rpx; border-radius: 44rpx; background: var(--accent); color: var(--surface); font-size: 27rpx; font-weight: 700; }

/* 首次生成前的骨架：动态码数字位与倒计时位 */
.code-card__value-skeleton { width: 360rpx; height: 72rpx; margin: 28rpx auto 0; }
.code-card__timer-skeleton { width: 96rpx; }

@import "./index.large.wxss"; /* 平板、电脑大屏样式：由 scripts/build-large-screen-styles.mjs 生成，改完本文件后重跑；这一行须留在文件末尾 */
