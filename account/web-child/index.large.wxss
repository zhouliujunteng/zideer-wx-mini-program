/* 自动生成，请勿手改：index.wxss 在平板、电脑大屏（窗口宽 ≥ 450px）下的样式。
   rpx 按 1rpx = 0.6px 换算，固定定位元素收进居中栏；改完源文件后运行 node scripts/build-large-screen-styles.mjs */
@media (min-width: 450px) {
.surface{border-radius:14px}
.skeleton{border-radius:9px}
.state-panel{padding:72px 14px 24px}
.state-panel__mark{margin-bottom:14px;font-size:31px}
.state-panel__title{font-size:19px;font-weight:600}
.state-panel__copy{margin:13px 0 19px;font-size:15px;line-height:1.6}
.state-panel__action{border-radius:12px}
.state-panel__action::after{border:0}
.sk{border-radius:7px}
.sk-line{height:16px}
.sk-line + .sk-line{margin-top:8px}
.sk-short{width:40%}
.sk-mid{width:64%}
.sk-round{border-radius:50%}
.sk-card{height:96px;border-radius:14px}
.sk-card + .sk-card{margin-top:12px}
.wc-page{min-height:100vh;padding:28px 16px calc(env(safe-area-inset-bottom) + 28px)}
.wc-head{padding:0 4px}
.wc-eyebrow{font-size:13px;font-weight:700}
.wc-title{margin-top:7px;font-size:25px;font-weight:700}
.wc-intro{margin-top:9px;font-size:14px;line-height:1.6}
.wc-section-head{margin:28px 4px 0}
.wc-section-title{font-size:16px;font-weight:700}
.wc-section-count{font-size:13px}
.wc-card, .wc-empty, .wc-created, .wc-form, .wc-gate{margin-top:12px;padding:18px}
.wc-empty{font-size:14px}
.wc-sk-gap{margin-top:12px}
.wc-card__top{margin-bottom:7px}
.wc-card__name{min-width:0}
.wc-card__nickname{font-size:18px;font-weight:700}
.wc-card__grade{margin-left:8px;font-size:13px}
.wc-badge{padding:3px 9px;border-radius:599px;font-size:12px;font-weight:700}
.wc-created__title{margin-bottom:7px;font-size:18px;font-weight:700}
.wc-created__row{padding:7px 0;font-size:14px}
.wc-created__row text:last-child{font-weight:600}
.wc-mono{font-family:"SF Mono", Menlo, monospace;letter-spacing:1px}
.wc-locked-hint{margin-top:4px;font-size:13px;line-height:1.6}
.wc-card__actions{gap:21px;margin-top:9px}
.wc-link{font-size:15px;font-weight:700}
.wc-link--muted{font-weight:400}
.wc-password{margin-top:10px}
.wc-password__actions{gap:21px;margin-top:9px}
.wc-form__title{font-size:16px;font-weight:700}
.wc-form__title--gap{margin-top:21px}
.wc-field{min-height:57px;border-bottom:0.5px solid var(--line-strong);font-size:16px}
.wc-label{width:114px;font-size:15px}
.wc-input{height:52px;font-size:16px}
.wc-password .wc-input{width:100%;border-bottom:0.5px solid var(--line-strong)}
.wc-note{margin-top:14px;font-size:13px;line-height:1.6}
.wc-gate__title{font-size:18px;font-weight:700}
.wc-gate__detail{margin-top:7px;font-size:14px;line-height:1.6}
.wc-submit{width:100%;min-height:52px;margin-top:18px;border-radius:26px;font-size:16px;font-weight:700}
.wc-cancel{margin-top:14px}
}
