.identity-status-page { min-height: 100vh; padding: 48rpx 28rpx calc(env(safe-area-inset-bottom) + 48rpx); }.identity-status-head { padding: 0 8rpx; }.identity-status-eyebrow { display: block; color: var(--accent-deep); font-size: 22rpx; font-weight: 700; }.identity-status-title { display: block; margin-top: 12rpx; font-size: 42rpx; font-weight: 700; }.identity-status-skeleton { height: 280rpx; margin-top: 54rpx; }.identity-status-card { margin-top: 54rpx; padding: 32rpx; }.identity-status-card__label, .identity-status-card__detail, .identity-status-card__expiry { display: block; }.identity-status-card__label { color: var(--muted); font-size: 22rpx; }.identity-status-card__status { display: block; margin-top: 18rpx; font-size: 31rpx; font-weight: 700; }.identity-status-card__status--verified { color: var(--green); }.identity-status-card__status--pending { color: var(--yellow); }.identity-status-card__status--rejected, .identity-status-card__status--expired { color: var(--accent-deep); }.identity-status-card__detail { margin-top: 14rpx; color: var(--ink-soft); font-size: 24rpx; line-height: 1.55; }.identity-status-card__expiry { margin-top: 10rpx; color: var(--muted); font-size: 22rpx; }.identity-status-section, .identity-submit-section { margin-top: 42rpx; }.identity-status-section__title { display: block; margin: 0 8rpx 16rpx; color: var(--ink-soft); font-size: 23rpx; font-weight: 700; }.identity-role-list { overflow: hidden; }.identity-role-row, .identity-login-entry { display: flex; min-height: 96rpx; align-items: center; justify-content: space-between; padding: 20rpx 24rpx; }.identity-role-row + .identity-role-row { border-top: 1rpx solid var(--line); }.identity-role-row text:first-child { font-size: 26rpx; font-weight: 700; }.identity-role-row text:last-child { color: var(--muted); font-size: 21rpx; }.identity-status-empty { padding: 28rpx; color: var(--muted); font-size: 23rpx; }.identity-submit-form { padding: 26rpx 28rpx; }.identity-submit-form__label { display: block; color: var(--muted); font-size: 22rpx; }.identity-submit-form__label--next { margin-top: 28rpx; }.identity-submit-form__input { width: 100%; height: 82rpx; margin-top: 8rpx; border-bottom: 1rpx solid var(--line-strong); font-size: 27rpx; }.identity-submit-form__placeholder { color: #9A9FA6; }.identity-submit-result { display: flex; justify-content: space-between; margin-top: 16rpx; padding: 22rpx 26rpx; color: var(--ink-soft); font-size: 23rpx; }.identity-submit-button { display: flex; width: 100%; min-height: 88rpx; align-items: center; justify-content: center; margin-top: 20rpx; border-radius: 44rpx; background: var(--accent); color: var(--surface); font-size: 27rpx; font-weight: 700; }.identity-submit-button[disabled] { opacity: .55; }.identity-login-entry { width: 100%; margin-top: 24rpx; text-align: left; }.identity-login-entry__label, .identity-login-entry__title { display: block; }.identity-login-entry__label { color: var(--muted); font-size: 20rpx; }.identity-login-entry__title { margin-top: 8rpx; font-size: 26rpx; font-weight: 700; }.identity-login-entry > text { color: var(--muted); font-size: 32rpx; }
