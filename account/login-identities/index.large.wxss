/* 自动生成，请勿手改：index.wxss 在平板、电脑大屏（窗口宽 ≥ 450px）下的样式。
   rpx 按 1rpx = 0.6px 换算，固定定位元素收进居中栏；改完源文件后运行 node scripts/build-large-screen-styles.mjs */
@media (min-width: 450px) {
.sk{border-radius:7px}
.sk-line{height:16px}
.sk-line + .sk-line{margin-top:8px}
.sk-short{width:40%}
.sk-mid{width:64%}
.sk-round{border-radius:50%}
.sk-card{height:96px;border-radius:14px}
.sk-card + .sk-card{margin-top:12px}
.account-page{height:100vh}
.account-topbar{top:0;left:max(0px, 50% - var(--lg-col) / 2);width:min(100%, var(--lg-col));box-sizing:border-box}
.account-topbar-inner{box-sizing:content-box;padding:0 21px 9px}
.account-back{width:26px;height:26px;margin-right:6px}
.account-back-icon{width:12px;height:12px;border-bottom:1px solid #24332D;border-left:1px solid #24332D}
.account-topbar-title{left:50%;font-size:21px;font-weight:700;letter-spacing:-1px}
.account-scroll{height:100vh;box-sizing:border-box}
.account-shell{min-height:100%;padding:18px 21px calc(45px + env(safe-area-inset-bottom));box-sizing:border-box}
.account-profile{min-height:92px;margin-bottom:15px;padding:14px 19px;box-sizing:border-box;border-radius:24px}
.account-avatar{width:63px;height:63px;border-radius:50%;font-size:25px;font-weight:700;line-height:1}
.account-profile-copy{min-width:0;margin-left:13px}
.account-profile-id-row{min-width:0;margin-top:7px}
.account-profile-id-label{font-size:13px;line-height:1.2}
.account-profile-id{font-size:17px;font-weight:650;line-height:1.2;letter-spacing:0.5px}
.account-profile-copy-action{width:16px;height:16px;margin-left:7px}
.account-profile-copy-icon{width:13px;height:14px}
.account-profile-copy-icon::before, .account-profile-copy-icon::after{width:9px;height:10px;border:1px solid #7F8A82;border-radius:2px}
.account-profile-copy-icon::before{top:0;left:0}
.account-profile-copy-icon::after{top:3px;left:3px}
.account-section{margin-top:15px}
.account-section:first-of-type{margin-top:0}
.account-section-title{margin:0 2px 10px;font-size:16px;font-weight:700;line-height:1.3}
.account-card{border-radius:24px;box-shadow:0 3px 16px rgba(56, 75, 64, .025)}
.contact-row{min-height:74px;padding:0 19px;box-sizing:border-box}
.contact-row:not(.is-last)::after, .device-row:not(.is-last)::after, .management-row:not(.is-last)::after{right:19px;bottom:0;left:19px;height:0.5px}
.contact-label{font-size:17px;font-weight:650}
.contact-value-wrap{min-width:0;margin-left:12px}
.contact-value{font-size:16px;line-height:1.2}
.account-note{padding:18px 19px 20px;font-size:13px;line-height:1.6}
.real-name-section{margin-top:22px}
.real-name-card{padding:19px}
.real-name-copy{min-width:0}
.real-name-status{font-size:17px;font-weight:700;line-height:1.25}
.real-name-time{margin-top:8px;font-size:15px;line-height:1.25}
.real-name-name{margin-left:12px;font-size:16px;line-height:1.2}
.real-name-action-button{min-width:67px;height:30px;margin-left:12px;padding:0 10px;box-sizing:border-box;border-radius:599px;font-size:13px;line-height:1}
.device-row{min-height:75px;padding:0 19px;box-sizing:border-box}
.device-copy{min-width:0;margin-left:0}
.management-copy{min-width:0;margin-left:0}
.device-label, .management-label{font-size:16px;font-weight:650;line-height:1.3}
.device-detail, .management-detail{margin-top:7px;font-size:12px;line-height:1.2}
.device-status{margin-left:9px;font-size:13px;line-height:1.2}
.device-status.success{min-height:25px;padding:0 8px;box-sizing:border-box;border-radius:599px;font-size:12px}
.device-status.muted{min-height:25px;padding:0 8px;box-sizing:border-box;border-radius:599px;font-size:12px}
.management-section{margin-top:22px}
.management-row{min-height:75px;padding:0 19px;box-sizing:border-box}
.management-chevron{width:9px;height:9px;margin-left:9px;border-top:1px solid #C0C8C2;border-right:1px solid #C0C8C2}
.account-state{padding:96px 28px;font-size:15px}
.account-state-title{font-size:18px;font-weight:600}
.account-state-copy{margin-top:7px}
.account-state-action{margin-top:19px;padding:9px 28px;border-radius:599px;font-size:15px}
.account-email-sheet-handle{width:43px;height:4px;margin:0 auto 16px;border-radius:599px}
.account-email-sheet-title{font-size:19px;font-weight:700;line-height:1.2}
.account-email-sheet-close{width:31px;height:31px;margin-top:-5px;border-radius:50%;font-size:22px;font-weight:300;line-height:1}
.account-email-primary{width:144px;height:57px;margin:14px auto 0;border-radius:599px;font-size:16px;font-weight:650;line-height:57px}
.real-name-verify-layer{top:0;right:max(0px, 50% - var(--lg-col) / 2);bottom:0;left:max(0px, 50% - var(--lg-col) / 2);box-shadow:0 0 0 100vmax rgba(28, 38, 32, .28)}
.real-name-verify-sheet{right:0;bottom:0;left:0;height:62vh;padding:9px 16px calc(14px + env(safe-area-inset-bottom));box-sizing:border-box;border-radius:24px 24px 0 0}
.real-name-verify-subtitle{margin-top:15px;font-size:14px;line-height:1.4}
.real-name-verify-label{margin-top:14px;font-size:13px;line-height:1.3}
.real-name-verify-picker{height:55px;margin-top:7px;border-radius:599px}
.real-name-verify-picker-content{height:55px;padding:0 16px;box-sizing:border-box;font-size:16px;line-height:1}
.real-name-verify-picker-content text{min-width:0}
.real-name-verify-picker-chevron{width:8px;height:8px;border-top:1px solid #A1AAA4;border-right:1px solid #A1AAA4}
.real-name-verify-input{width:100%;height:55px;margin-top:7px;padding:0 16px;box-sizing:border-box;border-radius:599px;font-size:16px;line-height:55px}
.real-name-verify-submit{margin-top:18px}
.real-name-verify-error{margin-top:12px;font-size:13px;line-height:1.4}
.role-section{margin-top:22px}
.account-role-label{font-size:17px;font-weight:700;line-height:1.25}
.account-avatar-sk{width:63px;height:63px}
.account-sk-status{width:96px}
.account-sk-label{width:57px}
.account-sk-value{width:120px;margin-top:0 !important}
}
