.identity-page { min-height: 100vh; padding: 48rpx 28rpx calc(env(safe-area-inset-bottom) + 48rpx); }.identity-skeleton { height: 540rpx; }.identity-head { padding: 0 8rpx; }.identity-eyebrow { display: block; color: var(--accent-deep); font-size: 22rpx; font-weight: 700; }.identity-title { display: block; margin-top: 12rpx; font-size: 42rpx; font-weight: 700; }.principal-card { margin-top: 38rpx; padding: 28rpx 26rpx; }.principal-card__label, .principal-card__meta { display: block; color: var(--muted); font-size: 21rpx; }.principal-card__no { display: block; margin-top: 12rpx; overflow-wrap: anywhere; font-size: 28rpx; font-weight: 700; }.principal-card__meta { margin-top: 14rpx; }.identity-section { margin-top: 40rpx; }.identity-section__title { display: block; margin: 0 8rpx 16rpx; color: var(--ink-soft); font-size: 23rpx; font-weight: 700; }.verification-card { padding: 26rpx; }.verification-card__status { display: block; color: var(--accent-deep); font-size: 25rpx; font-weight: 700; }.verification-card__copy { display: block; margin-top: 10rpx; color: var(--muted); font-size: 22rpx; line-height: 1.55; }.identity-list, .role-list { padding: 0 24rpx; }.identity-row, .role-row { display: flex; min-height: 100rpx; align-items: center; justify-content: space-between; border-bottom: 1rpx solid var(--line); }.identity-row:last-child, .role-row:last-child { border-bottom: 0; }.identity-row__copy { min-width: 0; flex: 1; }.identity-row__title, .identity-row__meta { display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }.identity-row__title { font-size: 25rpx; font-weight: 700; }.identity-row__meta { margin-top: 8rpx; color: var(--muted); font-size: 20rpx; }.identity-row__status, .role-row text:last-child { margin-left: 16rpx; color: var(--green); font-size: 21rpx; white-space: nowrap; }.identity-row__status--disabled { color: var(--muted); }.role-row { font-size: 25rpx; }.identity-empty { padding: 28rpx; }.identity-empty__title { display: block; font-size: 28rpx; font-weight: 700; }.identity-empty__copy { display: block; margin-top: 10rpx; color: var(--muted); font-size: 22rpx; line-height: 1.55; }
