/* 样式取自 UI 设计仓库 JiahaoTang-Alvin/zhilu-miniprogram 提交 d9627f0 的 M63 身份与登录页，
   去掉了邮箱绑定弹层、实名认证表单弹层和演示用状态切换菜单的样式（这些功能未移植）。 */
page { background: #FAFAFA; }
.account-page { height: 100vh; overflow: hidden; background: #FAFAFA; color: #27332D; }
.account-topbar { position: fixed; top: 0; left: 0; z-index: 20; width: 100%; box-sizing: border-box; background: #FAFAFA; }
.account-topbar-inner { position: relative; display: flex; align-items: center; box-sizing: content-box; padding: 0 36rpx 16rpx; }
.account-back { display: flex; flex: 0 0 auto; align-items: center; justify-content: center; width: 44rpx; height: 44rpx; margin-right: 10rpx; }
.account-back:active { opacity: .65; }
.account-back-icon { width: 20rpx; height: 20rpx; border-bottom: 3rpx solid #24332D; border-left: 3rpx solid #24332D; transform: rotate(45deg) scale(.72); }
.account-topbar-title { position: absolute; left: 50%; display: block; color: #24332D; font-size: 36rpx; font-weight: 700; letter-spacing: -1rpx; transform: translateX(-50%); white-space: nowrap; }
.account-scroll { height: 100vh; box-sizing: border-box; background: #FAFAFA; }
.account-shell { min-height: 100%; padding: 30rpx 36rpx calc(76rpx + env(safe-area-inset-bottom)); box-sizing: border-box; }
.account-profile { display: flex; align-items: center; min-height: 154rpx; margin-bottom: 26rpx; padding: 24rpx 32rpx; box-sizing: border-box; border-radius: 40rpx; background: #fff; }
.account-avatar { display: flex; flex: 0 0 auto; width: 106rpx; height: 106rpx; align-items: center; justify-content: center; border-radius: 50%; background: #D8E7D9; color: #1D5945; font-size: 42rpx; font-weight: 700; line-height: 1; }
.account-avatar-image { object-fit: cover; }
.account-profile-copy { min-width: 0; margin-left: 22rpx; }
.account-profile-id-row { display: flex; align-items: center; min-width: 0; margin-top: 12rpx; }
.account-profile-id-label { display: block; color: #8A958D; font-size: 23rpx; line-height: 1.2; }
.account-profile-id { overflow: hidden; color: #27362F; font-size: 29rpx; font-weight: 650; line-height: 1.2; letter-spacing: .4rpx; text-overflow: ellipsis; white-space: nowrap; }
.account-profile-copy-action { display: flex; flex: 0 0 auto; align-items: center; justify-content: center; width: 28rpx; height: 28rpx; margin-left: 12rpx; }
.account-profile-copy-action:active { opacity: .6; }
.account-profile-copy-icon { position: relative; width: 22rpx; height: 24rpx; }
.account-profile-copy-icon::before, .account-profile-copy-icon::after { position: absolute; width: 15rpx; height: 18rpx; border: 2rpx solid #7F8A82; border-radius: 4rpx; content: ''; }
.account-profile-copy-icon::before { top: 0; left: 0; }
.account-profile-copy-icon::after { top: 5rpx; left: 5rpx; background: #FAFAFA; }
.account-section { margin-top: 26rpx; }
.account-section:first-of-type { margin-top: 0; }
.account-section-title { display: block; margin: 0 4rpx 18rpx; color: #2F3F37; font-size: 27rpx; font-weight: 700; line-height: 1.3; }
.account-card { overflow: hidden; border-radius: 40rpx; background: #fff; box-shadow: 0 6rpx 28rpx rgba(56, 75, 64, .025); }
.contact-row { position: relative; display: flex; align-items: center; justify-content: space-between; min-height: 124rpx; padding: 0 32rpx; box-sizing: border-box; }
.contact-row:not(.is-last)::after, .device-row:not(.is-last)::after, .management-row:not(.is-last)::after { position: absolute; right: 32rpx; bottom: 0; left: 32rpx; height: 1rpx; background: #F0F2EF; content: ''; }
.contact-label { color: #27362F; font-size: 29rpx; font-weight: 650; }
.contact-value-wrap { display: flex; align-items: center; min-width: 0; margin-left: 20rpx; }
.contact-value { color: #6C887B; font-size: 27rpx; line-height: 1.2; }
.contact-value.action { color: #66877A; }
.contact-action-button { display: flex; align-items: center; justify-content: center; min-width: 104rpx; height: 48rpx; padding: 0 18rpx; box-sizing: border-box; border-radius: 999rpx; background: rgba(253, 124, 2, .12); color: #FD7C02; font-size: 22rpx; line-height: 1; }
.contact-action-button:active { background: rgba(253, 124, 2, .18); }
.account-note { display: block; padding: 30rpx 32rpx 34rpx; color: #949E97; font-size: 23rpx; line-height: 1.6; }
.real-name-section { margin-top: 38rpx; }
.real-name-card { display: flex; align-items: center; justify-content: space-between; padding: 32rpx; }
.real-name-copy { min-width: 0; }
.real-name-status { display: block; font-size: 29rpx; font-weight: 700; line-height: 1.25; }
.real-name-status.success { color: #4B9C61; }
.real-name-status.pending { color: #D7922F; }
.real-name-status.failed { color: #D86C55; }
.real-name-status.muted { color: #8A958D; }
.real-name-time { display: block; margin-top: 14rpx; color: #89958D; font-size: 25rpx; line-height: 1.25; }
.real-name-name { flex: 0 0 auto; margin-left: 20rpx; color: #7B877F; font-size: 27rpx; line-height: 1.2; }
.real-name-action-button { display: flex; flex: 0 0 auto; min-width: 112rpx; height: 50rpx; margin-left: 20rpx; padding: 0 18rpx; align-items: center; justify-content: center; box-sizing: border-box; border-radius: 999rpx; background: rgba(253, 124, 2, .12); color: #FD7C02; font-size: 22rpx; line-height: 1; }
.real-name-action-button:active { background: rgba(253, 124, 2, .18); }
.device-row { position: relative; display: flex; align-items: center; min-height: 126rpx; padding: 0 32rpx; box-sizing: border-box; }
.device-copy { min-width: 0; flex: 1; margin-left: 0; }
.management-copy { min-width: 0; flex: 1; margin-left: 0; }
.device-label, .device-detail, .management-label, .management-detail { display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.device-label, .management-label { color: #34423A; font-size: 27rpx; font-weight: 650; line-height: 1.3; }
.device-detail, .management-detail { margin-top: 12rpx; color: #9CA59F; font-size: 21rpx; line-height: 1.2; }
.device-status { flex: 0 0 auto; margin-left: 16rpx; font-size: 23rpx; line-height: 1.2; white-space: nowrap; }
.device-status.success { display: inline-flex; align-items: center; justify-content: center; min-height: 42rpx; padding: 0 14rpx; box-sizing: border-box; border-radius: 999rpx; background: #E7F4EA; color: #4B9C61; font-size: 21rpx; }
.device-status.muted { display: inline-flex; align-items: center; justify-content: center; min-height: 42rpx; padding: 0 14rpx; box-sizing: border-box; border-radius: 999rpx; background: #EFF1EF; color: #8A958D; font-size: 21rpx; }
.management-section { margin-top: 38rpx; }
.management-row { position: relative; display: flex; align-items: center; min-height: 126rpx; padding: 0 32rpx; box-sizing: border-box; }
.management-chevron { flex: 0 0 auto; width: 15rpx; height: 15rpx; margin-left: 16rpx; border-top: 3rpx solid #C0C8C2; border-right: 3rpx solid #C0C8C2; transform: rotate(45deg); }
.contact-row:active, .management-row:active { background: #FCFDFC; }
@media (max-width: 350px) {
  .account-shell { padding-right: 28rpx; padding-left: 28rpx; }
  .account-avatar { width: 96rpx; height: 96rpx; font-size: 38rpx; }
  .contact-row, .device-row, .management-row { padding-right: 26rpx; padding-left: 26rpx; }
  .device-detail, .management-detail { font-size: 19rpx; }
}

/* 正式小程序补充：加载与失败状态、登录方式状态色。 */
.account-state { display: flex; flex-direction: column; align-items: center; padding: 160rpx 48rpx; color: #8A948F; font-size: 26rpx; text-align: center; }
.account-state-title { color: #24332D; font-size: 30rpx; font-weight: 600; }
.account-state-copy { margin-top: 12rpx; }
.account-state-action { margin-top: 32rpx; padding: 16rpx 48rpx; border-radius: 999rpx; background: #FD7C02; color: #FFFFFF; font-size: 26rpx; }

/* 实名认证弹层：取自设计仓库 M63 的 real-name-verify-* 与共用弹层样式（2026-09-19 同步）。 */
.account-email-sheet-handle { width: 72rpx; height: 8rpx; margin: 0 auto 28rpx; border-radius: 999rpx; background: #DCE2DD; }
.account-email-sheet-header { display: flex; align-items: center; justify-content: space-between; }
.account-email-sheet-title { color: #24332D; font-size: 32rpx; font-weight: 700; line-height: 1.2; }
.account-email-sheet-close { display: flex; align-items: center; justify-content: center; width: 52rpx; height: 52rpx; margin-top: -8rpx; border-radius: 50%; background: #E9EDE9; color: #829087; font-size: 38rpx; font-weight: 300; line-height: 1; }
.account-email-primary { display: flex; align-items: center; justify-content: center; width: 240rpx; height: 96rpx; margin: 24rpx auto 0; border-radius: 999rpx; background: rgba(253, 124, 2, .14); color: #FD7C02; font-size: 28rpx; font-weight: 650; line-height: 96rpx; transition: transform .24s cubic-bezier(.22, .8, .24, 1); }
.account-email-primary:active { opacity: .78; }
.real-name-verify-layer { position: fixed; top: 0; right: 0; bottom: 0; left: 0; z-index: 70; background: rgba(28, 38, 32, .28); animation: real-name-status-fade-in .18s ease-out; }
.real-name-verify-layer.is-closing { animation: account-email-sheet-fade-out .28s ease-in forwards; }
.real-name-verify-layer.is-closing .real-name-verify-sheet { animation: account-email-sheet-down .28s cubic-bezier(.55, .1, .7, .2) forwards; }
.real-name-verify-sheet { position: absolute; right: 0; bottom: 0; left: 0; height: 62vh; padding: 16rpx 28rpx calc(24rpx + env(safe-area-inset-bottom)); box-sizing: border-box; border-radius: 40rpx 40rpx 0 0; background: #F4F5F3; animation: account-email-sheet-up .28s cubic-bezier(.22, .8, .24, 1); }
.real-name-verify-subtitle { display: block; margin-top: 26rpx; color: #6F7D74; font-size: 24rpx; line-height: 1.4; }
.real-name-verify-label { display: block; margin-top: 24rpx; color: #6F7D74; font-size: 23rpx; line-height: 1.3; }
.real-name-verify-picker { display: block; height: 92rpx; margin-top: 12rpx; border-radius: 999rpx; background: #FFFFFF; }
.real-name-verify-picker-content { display: flex; height: 92rpx; align-items: center; justify-content: space-between; padding: 0 28rpx; box-sizing: border-box; color: #24332D; font-size: 28rpx; line-height: 1; }
.real-name-verify-picker-content text { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.real-name-verify-picker-chevron { width: 14rpx; height: 14rpx; border-top: 3rpx solid #A1AAA4; border-right: 3rpx solid #A1AAA4; transform: rotate(45deg); }
.real-name-verify-input { display: block; width: 100%; height: 92rpx; margin-top: 12rpx; padding: 0 28rpx; box-sizing: border-box; border-radius: 999rpx; background: #FFFFFF; color: #24332D; font-size: 28rpx; line-height: 92rpx; }
.real-name-verify-placeholder { color: #B4BCB6; }
.real-name-verify-submit { margin-top: 30rpx; }
@keyframes account-email-sheet-fade-out { from { opacity: 1; } to { opacity: 0; } }
@keyframes account-email-sheet-up { from { transform: translateY(100%); } to { transform: translateY(0); } }
@keyframes account-email-sheet-down { from { transform: translateY(0); } to { transform: translateY(100%); } }
@keyframes real-name-status-fade-in { from { opacity: 0; } to { opacity: 1; } }
/* 正式小程序补充：核验失败提示与提交中状态。 */
.real-name-verify-error { display: block; margin-top: 20rpx; color: #D9534F; font-size: 23rpx; line-height: 1.4; text-align: center; }
.real-name-verify-submit.is-submitting { opacity: .55; }
.real-name-verify-sheet { transition: bottom .2s ease-out; }
