/* 自动生成，请勿手改：index.wxss 在平板、电脑大屏（窗口宽 ≥ 450px）下的样式。
   rpx 按 1rpx = 0.6px 换算，固定定位元素收进居中栏；改完源文件后运行 node scripts/build-large-screen-styles.mjs */
@media (min-width: 450px) {
.support-page{height:100vh}
.support-ambient{inset:0}
.support-topbar{top:0;left:max(0px, 50% - var(--lg-col) / 2);right:max(0px, 50% - var(--lg-col) / 2)}
.support-back{width:44px;height:44px}
.support-back-icon{width:9px;height:9px}
.support-topbar-title{left:50%}
.support-scroll{height:100vh}
.support-shell{max-width:680px}
.category-chip{min-width:0;height:44px}
.feedback-input{width:100%;height:126px}
.diagnostics-row{min-height:76px}
.diagnostics-copy{min-width:0}
.device-value{min-width:0}
.privacy-dot{width:5px;height:5px}
.submit{width:100%;min-height:48px}
.help-title{min-height:94px}
.chevron{width:7px;height:7px}
.step-number{width:22px;height:22px}
.success-mark{width:64px;height:64px}
.success-check{width:22px;height:12px}
}
@media (min-width: 450px) and (min-width: 760px) {
.support-shell{max-width:1000px}
.feedback-column{min-width:0}
.help-column{width:290px}
.feedback-input{height:172px}
}
