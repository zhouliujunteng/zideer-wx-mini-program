.feed-page { min-height: 100vh; padding: 48rpx 28rpx calc(env(safe-area-inset-bottom) + 48rpx); }.feed-skeleton { height: 480rpx; }.feed-head { padding: 0 8rpx; }.feed-eyebrow { display: block; color: var(--accent-deep); font-size: 22rpx; font-weight: 700; }.feed-title { display: block; margin-top: 12rpx; font-size: 42rpx; font-weight: 700; }.feed-student { display: flex; width: 100%; min-height: 120rpx; align-items: center; margin-top: 38rpx; padding: 20rpx 22rpx; text-align: left; }.feed-avatar { display: flex; width: 64rpx; height: 64rpx; align-items: center; justify-content: center; border-radius: 32rpx; background: var(--accent-soft); color: var(--accent-deep); font-size: 25rpx; font-weight: 700; }.feed-student__copy { min-width: 0; flex: 1; margin-left: 18rpx; }.feed-student__label, .feed-student__name { display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }.feed-student__label { color: var(--muted); font-size: 20rpx; }.feed-student__name { margin-top: 7rpx; font-size: 26rpx; font-weight: 700; }.feed-student__action { margin-left: 12rpx; color: var(--accent-deep); font-size: 21rpx; white-space: nowrap; }.feed-state { margin-top: 18rpx; padding: 28rpx 26rpx; }.feed-state__label, .feed-state__meta { display: block; color: var(--muted); font-size: 21rpx; }.feed-state__value { display: block; margin-top: 12rpx; color: var(--accent-deep); font-size: 30rpx; font-weight: 700; }.feed-state__meta { margin-top: 12rpx; }.feed-section { margin-top: 40rpx; }.feed-section__title { display: block; margin: 0 8rpx 16rpx; color: var(--ink-soft); font-size: 23rpx; font-weight: 700; }.feed-metrics { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 14rpx; }.feed-metric { min-width: 0; min-height: 138rpx; padding: 22rpx 18rpx; }.feed-metric text { display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }.feed-metric text:first-child { color: var(--muted); font-size: 20rpx; }.feed-metric text:last-child { margin-top: 16rpx; font-size: 24rpx; font-weight: 700; }.feed-empty { margin-top: 34rpx; padding: 30rpx 26rpx; }.feed-empty__title { display: block; font-size: 28rpx; font-weight: 700; }.feed-empty__copy { display: block; margin-top: 12rpx; color: var(--muted); font-size: 22rpx; line-height: 1.6; }
.feed-report { display: flex; width: 100%; min-height: 112rpx; align-items: center; justify-content: space-between; margin-top: 18rpx; padding: 22rpx 26rpx; text-align: left; }.feed-report__title, .feed-report__copy { display: block; }.feed-report__title { font-size: 25rpx; font-weight: 700; }.feed-report__copy { margin-top: 7rpx; color: var(--muted); font-size: 20rpx; }.feed-report__arrow { color: var(--muted); font-size: 36rpx; }
