/* 自动生成，请勿手改：index.wxss 在平板、电脑大屏（窗口宽 ≥ 450px）下的样式。
   rpx 按 1rpx = 0.6px 换算，固定定位元素收进居中栏；改完源文件后运行 node scripts/build-large-screen-styles.mjs */
@media (min-width: 450px) {
.sk{border-radius:7px}
.sk-line{height:16px}
.sk-line + .sk-line{margin-top:8px}
.sk-short{width:40%}
.sk-mid{width:64%}
.sk-round{border-radius:50%}
.sk-card{height:96px;border-radius:14px}
.sk-card + .sk-card{margin-top:12px}
.sh-page{min-height:100vh}
.sh-topbar{top:0;left:max(0px, 50% - var(--lg-col) / 2);width:min(100%, var(--lg-col))}
.sh-topbar-inner{padding:0 21px 4px}
.sh-back{width:26px;height:26px}
.sh-back-icon{width:13px;height:13px;border-bottom:1px solid #24332D;border-left:1px solid #24332D}
.sh-topbar-title{left:50%;font-size:21px;font-weight:700;letter-spacing:-1px}
.sh-content{padding:0 19px calc(36px + env(safe-area-inset-bottom))}
.sh-item{margin-bottom:12px;padding:15px 16px;border-radius:16px}
.sh-item .sk-line{margin-top:8px}
.sh-tool{padding:2px 9px;border-radius:599px;font-size:13px;font-weight:700}
.sh-status{margin-left:7px;padding:2px 8px;border-radius:599px;font-size:12px}
.sh-credits{margin-left:7px;font-size:12px}
.sh-time{margin-left:auto;font-size:12px}
.sh-stem{margin-top:8px;font-size:15px;line-height:1.6;-webkit-line-clamp:2}
.sh-footnote{margin-top:6px;font-size:12px}
.sh-state{margin-top:12px;padding:54px 21px;border-radius:16px}
.sh-state-title{font-size:17px;font-weight:700;line-height:1.3}
.sh-state-copy{margin-top:9px;font-size:13px;line-height:1.6}
.sh-state-action{height:43px;margin-top:18px;padding:0 26px;border-radius:599px;font-size:15px;font-weight:650}
}
