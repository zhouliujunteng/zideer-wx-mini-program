/* 金币页复用课程积分页的设计体系，叠加金币暖色氛围与图标规格 */
@import "../../commerce/entitlements/index.wxss";

.coin-page { background: #FAFAFA; }
.coin-ambient {
  background: radial-gradient(125% 52% at 100% 0, rgba(255, 224, 181, .86) 0%, rgba(255, 241, 211, .52) 40%, rgba(250, 250, 250, 0) 76%), #FAFAFA;
}
.coin-ambient-ribbon { opacity: .78; }
.coin-balance-icon { width: 220rpx; height: 184rpx; margin-top: 0; margin-right: -2rpx; transform: rotate(8deg); }
.coin-sheet-dot { background: #E8AC5A; }

/* 兑换现金：金币的主要用途，放在余额下方 */
.exchange-card { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; margin-top: 4rpx; padding: 28rpx 24rpx 28rpx 32rpx; border-radius: 36rpx; background: #fff; }
.exchange-copy { min-width: 0; flex: 1; }
.exchange-value-row { display: flex; align-items: baseline; gap: 12rpx; }
.exchange-value-label { color: #4A514C; font-size: 24rpx; font-weight: 600; }
.exchange-value { color: #FD7C02; font-size: 40rpx; font-weight: 700; line-height: 1.1; }
.exchange-value-skeleton { width: 120rpx; height: 40rpx; }
.exchange-rate { display: block; margin-top: 10rpx; color: #98A39B; font-size: 20rpx; line-height: 1.3; }
.exchange-action { flex: 0 0 auto; height: 72rpx; padding: 0 36rpx; border-radius: 999rpx; background: linear-gradient(90deg, #FF9F43 0%, #FD7C02 100%); color: #fff; font-size: 26rpx; font-weight: 650; line-height: 72rpx; }
.exchange-action:active, .exchange-submit:active { opacity: .86; }
.exchange-action.is-busy, .exchange-submit.is-busy { opacity: .6; }
.exchange-rate-skeleton { width: 320rpx; margin-top: 12rpx; }

/* 兑换弹层：复用使用规则弹层的外壳，高度按内容 */
.exchange-sheet { height: auto; }
.exchange-amount { display: flex; align-items: center; justify-content: space-between; gap: 24rpx; margin-top: 36rpx; padding: 28rpx 24rpx; border-radius: 32rpx; background: #FFF9F2; }
.exchange-amount-copy { display: flex; flex: 1; flex-direction: column; align-items: center; min-width: 0; }
.exchange-amount-value { color: #FD7C02; font-size: 64rpx; font-weight: 700; line-height: 1.1; }
.exchange-amount-coins { margin-top: 8rpx; color: #98A39B; font-size: 22rpx; }
.exchange-step { display: flex; flex: 0 0 auto; align-items: center; justify-content: center; width: 72rpx; height: 72rpx; border-radius: 50%; background: #fff; color: #FD7C02; font-size: 40rpx; font-weight: 500; line-height: 1; }
.exchange-step.is-disabled { color: #D5DBD6; }
.exchange-all { margin-top: 18rpx; color: #FD7C02; font-size: 24rpx; font-weight: 600; text-align: center; }
.exchange-rows { margin-top: 24rpx; }
.exchange-row { display: flex; align-items: center; justify-content: space-between; padding: 18rpx 4rpx; border-bottom: 2rpx solid #F0F3F0; color: #4A514C; font-size: 25rpx; }
.exchange-row text:last-child { color: #24332D; font-weight: 600; }
.exchange-note { display: block; margin-top: 22rpx; color: #98A39B; font-size: 21rpx; line-height: 1.5; }
.exchange-submit { height: 88rpx; margin-top: 28rpx; border-radius: 999rpx; background: linear-gradient(90deg, #FF9F43 0%, #FD7C02 100%); color: #fff; font-size: 28rpx; font-weight: 650; line-height: 88rpx; text-align: center; }

/* 金币服务入口 */
.service-card { margin-top: 22rpx; padding: 6rpx 24rpx; border-radius: 36rpx; background: #fff; }
.service-row { display: flex; align-items: center; justify-content: space-between; gap: 18rpx; padding: 26rpx 0; border-bottom: 2rpx solid #F0F3F0; }
.service-row:last-child { border-bottom: 0; }
.service-copy { min-width: 0; flex: 1; }
.service-title { display: block; color: #24332D; font-size: 26rpx; font-weight: 600; line-height: 1.4; }
.service-hint { display: block; margin-top: 8rpx; color: #98A39B; font-size: 19rpx; line-height: 1.3; }
.service-arrow { flex: 0 0 auto; color: #C2CAC3; font-size: 32rpx; line-height: 1; }

@media (max-width: 350px) {
  .coin-balance-icon { width: 180rpx; height: 156rpx; margin-right: 0; }
}

@import "./index.large.wxss"; /* 平板、电脑大屏样式：由 scripts/build-large-screen-styles.mjs 生成，改完本文件后重跑；这一行须留在文件末尾 */
