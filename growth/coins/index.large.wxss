/* 自动生成，请勿手改：index.wxss 在平板、电脑大屏（窗口宽 ≥ 450px）下的样式。
   rpx 按 1rpx = 0.6px 换算，固定定位元素收进居中栏；改完源文件后运行 node scripts/build-large-screen-styles.mjs */
@media (min-width: 450px) {
.sk{border-radius:7px}
.sk-line{height:16px}
.sk-line + .sk-line{margin-top:8px}
.sk-short{width:40%}
.sk-mid{width:64%}
.sk-round{border-radius:50%}
.sk-card{height:96px;border-radius:14px}
.sk-card + .sk-card{margin-top:12px}
.points-page{height:100vh}
.points-ambient{top:0;left:max(0px, 50% - var(--lg-col) / 2);width:min(100%, var(--lg-col));height:100%}
.points-ambient-ribbon{top:-84px;left:-258px;width:888px;height:432px;box-sizing:border-box;border:14px solid rgba(255, 255, 255, .72);border-top-color:transparent;border-right-color:transparent;border-radius:50%}
.points-ambient-ribbon::after{top:22px;right:22px;bottom:22px;left:22px;box-sizing:border-box;border:6px solid rgba(255, 255, 255, .38);border-top-color:transparent;border-right-color:transparent;border-radius:50%}
.points-topbar{top:0;left:max(0px, 50% - var(--lg-col) / 2);width:min(100%, var(--lg-col));box-sizing:border-box}
.points-topbar-inner{box-sizing:content-box;padding:0 19px 9px}
.points-back{width:32px;height:32px;border-radius:50%}
.points-back-icon{width:13px;height:13px;border-bottom:2px solid #24332D;border-left:2px solid #24332D}
.points-topbar-title{left:50%;font-size:21px;font-weight:700;letter-spacing:-1px}
.points-scroll{height:100vh;box-sizing:border-box}
.points-shell{min-height:100%;padding:0 19px calc(24px + env(safe-area-inset-bottom));box-sizing:border-box}
.points-state{min-height:192px}
.points-state text:first-child{font-size:16px;font-weight:650}
.points-state-action{margin-top:14px;padding:0 26px;height:43px;border-radius:599px;font-size:15px;font-weight:650;line-height:43px}
.points-overview{padding:4px 4px 14px}
.points-overview-main{min-height:0}
.points-overview-copy{min-width:0}
.balance-eyebrow{font-size:17px;font-weight:700;line-height:1.25}
.balance-value{margin-top:8px;font-size:57px;font-weight:500;letter-spacing:-2px;line-height:.95}
.balance-icon{width:120px;height:122px;margin:-3px 2px 0 9px}
.balance-family{margin-top:7px;font-size:13px;line-height:1.3}
.balance-debt{margin-top:8px;font-size:13px;font-weight:600;line-height:1.3}
.usage-rules{gap:0;padding:9px 0 0;font-size:12px;line-height:1.2}
.usage-rules-frozen{margin-right:14px}
.usage-rules-icon{width:7px;height:7px;margin-left:2px;border-top:1px solid #AAB4AD;border-right:1px solid #AAB4AD}
.points-section{margin-top:22px}
.section-heading{padding:0 2px;font-size:18px;font-weight:700;line-height:1.2}
.batches-card{margin-top:13px;padding:3px 14px;border-radius:21px}
.batch-row{gap:10px;padding:15px 0;border-bottom:1px solid #F0F3F0}
.batch-row:last-child{border-bottom:0}
.batch-copy{min-width:0}
.batch-title{font-size:15px;font-weight:600;line-height:1.4}
.batch-meta{margin-top:4px;font-size:11px;line-height:1.3}
.batch-remaining{font-size:14px;font-weight:650}
.records-section{margin-top:25px}
.record-tabs{width:100%;height:45px;margin-top:13px;border-radius:15px 15px 0 0}
.record-tab{height:45px;font-size:13px;line-height:1}
.record-tab.is-selected{border-radius:15px 15px 0 0;font-weight:650}
.record-tab.is-selected::before, .record-tab.is-selected::after{bottom:0;width:19px;height:19px}
.record-tab.is-selected::before{left:-20px}
.record-tab.is-selected::after{right:-20px}
.records-card{min-height:168px;margin-top:0;padding:4px 14px;box-sizing:border-box;border:0;border-radius:0 0 21px 21px}
.record-month{width:100%;box-sizing:border-box;padding:10px 0 4px;font-size:13px;font-weight:500;line-height:1}
.record-item{min-height:87px}
.record-copy{min-width:0;padding:18px 0 14px}
.record-title{min-width:0;font-size:15px;font-weight:600;line-height:1.2}
.record-amount{margin-left:9px;font-size:18px;font-weight:500;line-height:1}
.record-detail{margin-top:7px;font-size:12px;line-height:1.2}
.record-detail.muted{font-weight:400}
.record-meta{margin-top:7px;font-size:10px;line-height:1}
.record-status{padding:3px 7px;border-radius:599px;font-size:10px}
.records-empty{min-height:168px}
.records-empty text:first-child{font-size:16px;font-weight:650}
.records-empty text:last-child{margin-top:8px;font-size:12px}
.points-sheet-layer{top:0;right:max(0px, 50% - var(--lg-col) / 2);bottom:0;left:max(0px, 50% - var(--lg-col) / 2);box-shadow:0 0 0 100vmax rgba(28, 38, 32, .28)}
.points-usage-rules-sheet{right:0;bottom:0;left:0;height:62vh;padding:9px 16px calc(14px + env(safe-area-inset-bottom));box-sizing:border-box;border-radius:24px 24px 0 0}
.points-sheet-handle{width:43px;height:4px;margin:0 auto 16px;border-radius:599px}
.points-sheet-title{font-size:19px;font-weight:700;line-height:1.2}
.points-sheet-close{width:31px;height:31px;margin-top:-5px;border-radius:50%;font-size:22px;font-weight:300;line-height:1}
.points-sheet-scroll{height:calc(62vh - 85px);margin-top:16px}
.points-sheet-intro{font-size:14px;line-height:1.5}
.points-sheet-row{margin-top:14px;font-size:13px;line-height:1.55}
.points-sheet-dot{width:4px;height:4px;margin:7px 7px 0 0;border-radius:50%}
.points-title-skeleton{left:50%;width:144px;height:21px;margin-top:-11px}
.balance-value-skeleton{width:132px;height:50px;margin-top:8px}
.frozen-skeleton{width:28px;height:13px}
.records-sk-month{width:72px;height:13px}
.record-title-row .records-sk-title{width:46%;margin-top:0}
.record-title-row .records-sk-amount{width:43px;margin-top:0}
.records-sk-time{width:90px;height:10px}
.coin-balance-icon{width:132px;height:110px;margin-top:0;margin-right:-2px}
.exchange-card{gap:12px;margin-top:2px;padding:16px 14px 16px 19px;border-radius:21px}
.exchange-copy{min-width:0}
.exchange-value-row{gap:7px}
.exchange-value-label{font-size:14px;font-weight:600}
.exchange-value{font-size:24px;font-weight:700;line-height:1.1}
.exchange-value-skeleton{width:72px;height:24px}
.exchange-rate{margin-top:6px;font-size:12px;line-height:1.3}
.exchange-action{height:43px;padding:0 21px;border-radius:599px;font-size:15px;font-weight:650;line-height:43px}
.exchange-rate-skeleton{width:192px;margin-top:7px}
.exchange-sheet{height:auto}
.exchange-amount{gap:14px;margin-top:21px;padding:16px 14px;border-radius:19px}
.exchange-amount-copy{min-width:0}
.exchange-amount-value{font-size:38px;font-weight:700;line-height:1.1}
.exchange-amount-coins{margin-top:4px;font-size:13px}
.exchange-step{width:43px;height:43px;border-radius:50%;font-size:24px;font-weight:500;line-height:1}
.exchange-all{margin-top:10px;font-size:14px;font-weight:600}
.exchange-rows{margin-top:14px}
.exchange-row{padding:10px 2px;border-bottom:1px solid #F0F3F0;font-size:15px}
.exchange-row text:last-child{font-weight:600}
.exchange-note{margin-top:13px;font-size:12px;line-height:1.5}
.exchange-submit{height:52px;margin-top:16px;border-radius:599px;font-size:16px;font-weight:650;line-height:52px}
.service-card{margin-top:13px;padding:3px 14px;border-radius:21px}
.service-row{gap:10px;padding:15px 0;border-bottom:1px solid #F0F3F0}
.service-row:last-child{border-bottom:0}
.service-copy{min-width:0}
.service-title{font-size:15px;font-weight:600;line-height:1.4}
.service-hint{margin-top:4px;font-size:11px;line-height:1.3}
.service-arrow{font-size:19px;line-height:1}
}
