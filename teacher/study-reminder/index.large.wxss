/* 自动生成，请勿手改：index.wxss 在平板、电脑大屏（窗口宽 ≥ 450px）下的样式。
   rpx 按 1rpx = 0.6px 换算，固定定位元素收进居中栏；改完源文件后运行 node scripts/build-large-screen-styles.mjs */
@media (min-width: 450px) {
.sk{border-radius:7px}
.sk-line{height:16px}
.sk-line + .sk-line{margin-top:8px}
.sk-short{width:40%}
.sk-mid{width:64%}
.sk-round{border-radius:50%}
.sk-card{height:96px;border-radius:14px}
.sk-card + .sk-card{margin-top:12px}
page{height:100%}
.sr-root{width:100%;height:100vh}
.sr-ambient{top:0;left:max(0px, 50% - var(--lg-col) / 2);width:min(100%, var(--lg-col));height:312px}
.sr-topbar{top:0;left:max(0px, 50% - var(--lg-col) / 2);width:min(100%, var(--lg-col))}
.sr-topbar-inner{padding:0 19px 9px}
.sr-back{width:32px;height:32px;border-radius:50%}
.sr-back-icon{width:13px;height:13px;border-bottom:2px solid #FFFFFF;border-left:2px solid #FFFFFF}
.sr-topbar-title{left:50%;font-size:21px;font-weight:700;letter-spacing:-1px}
.sr-page{height:100vh}
.sr-hero{padding:13px 24px 34px}
.sr-hero-name{font-size:22px;font-weight:600;line-height:1.3}
.sr-hero-meta{margin-top:6px;font-size:13px;line-height:1.4}
.sr-hero-meta-sk{width:180px;height:15px;margin-top:8px;border-radius:6px}
.sr-panel{min-height:70vh;margin-top:-15px;padding:19px 16px calc(28px + env(safe-area-inset-bottom));border-radius:15px 15px 0 0}
.section-heading{margin:0 2px 12px;font-size:16px;font-weight:700;line-height:1.25}
.section-gap{margin-top:26px}
.section-caption{font-size:12px;font-weight:400}
.section-note{margin:10px 2px 0;font-size:12px;line-height:1.6}
.heading-action{padding:4px 13px;border-radius:599px;font-size:13px;font-weight:600}
.card{border-radius:16px}
.empty-card{padding:26px 16px}
.empty-title{font-size:15px;font-weight:600}
.empty-copy{margin-top:4px;font-size:13px;line-height:1.6}
.empty-retry{margin-top:12px;padding:7px 19px;border-radius:599px;font-size:13px;font-weight:600}
.task-card{margin-bottom:9px;padding:14px 15px}
.task-title{min-width:0;font-size:16px;font-weight:600;line-height:1.4}
.task-day{margin-left:9px;padding:2px 8px;border-radius:599px;font-size:12px}
.task-meta{margin-top:4px;font-size:12px;line-height:1.5}
.task-sk{margin-top:9px}
.notice{margin-top:2px;padding:12px 14px;border-radius:13px;font-size:13px;line-height:1.6}
.note-card{padding:16px 16px 14px}
.note-text{font-size:16px;line-height:1.75}
.note-meta{margin-top:9px;font-size:12px;line-height:1.5}
.note-card .sk-line{margin-bottom:10px}
.primary-button{height:55px;margin-top:15px;border-radius:599px;font-size:17px;font-weight:650}
.link-row{margin-top:21px;padding:7px;font-size:14px}
}
