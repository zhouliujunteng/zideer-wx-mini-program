/* 自动生成，请勿手改：index.wxss 在平板、电脑大屏（窗口宽 ≥ 450px）下的样式。
   rpx 按 1rpx = 0.6px 换算，固定定位元素收进居中栏；改完源文件后运行 node scripts/build-large-screen-styles.mjs */
@media (min-width: 450px) {
.sk{border-radius:7px}
.sk-line{height:16px}
.sk-line + .sk-line{margin-top:8px}
.sk-short{width:40%}
.sk-mid{width:64%}
.sk-round{border-radius:50%}
.sk-card{height:96px;border-radius:14px}
.sk-card + .sk-card{margin-top:12px}
page{height:100%}
.plan-root{width:100%;height:100vh}
.plan-ambient{top:0;left:max(0px, 50% - var(--lg-col) / 2);width:min(100%, var(--lg-col));height:312px}
.plan-topbar{top:0;left:max(0px, 50% - var(--lg-col) / 2);width:min(100%, var(--lg-col));box-sizing:border-box}
.plan-topbar-inner{box-sizing:content-box;padding:0 19px 9px}
.plan-back{flex:0 0 auto;width:32px;height:32px;border-radius:50%}
.plan-back-icon{width:13px;height:13px;border-bottom:2px solid #FFFFFF;border-left:2px solid #FFFFFF}
.plan-topbar-title{left:50%;font-size:21px;font-weight:700;letter-spacing:-1px}
.plan-page{height:100vh;box-sizing:border-box}
.plan-hero{padding:13px 24px 34px}
.plan-hero-name{font-size:22px;font-weight:600;line-height:1.3}
.plan-hero-meta{margin-top:6px;font-size:13px;line-height:1.4}
.plan-hero-meta-sk{width:180px;height:15px;margin-top:8px;border-radius:6px}
.plan-panel{min-height:70vh;margin-top:-15px;padding:19px 16px calc(28px + env(safe-area-inset-bottom));box-sizing:border-box;border-radius:15px 15px 0 0}
.section-heading{margin:0 2px 12px;font-size:16px;font-weight:700;line-height:1.25}
.section-gap{margin-top:26px}
.section-caption{font-size:12px;font-weight:400}
.section-note{margin:10px 2px 0;font-size:12px;line-height:1.6}
.heading-action{padding:4px 13px;border-radius:599px;font-size:13px;font-weight:600}
.minute-grid{grid-template-columns:repeat(3, 1fr);gap:9px}
.minute-chip{height:64px;flex-direction:column;box-sizing:border-box;border:1px solid transparent;border-radius:16px}
.minute-chip.is-selected{border-color:#FD7C02}
.minute-chip-label{font-size:16px;font-weight:650;line-height:1.2}
.minute-chip-note{margin-top:3px;font-size:11px;line-height:1}
.option-row{height:55px;padding:0 16px;box-sizing:border-box;border-radius:599px}
.option-row-text{min-width:0;font-size:16px}
.option-row-sk{width:156px}
.option-chevron{width:8px;height:8px;flex:0 0 8px;margin-left:9px;border-top:1px solid #A1AAA4;border-right:1px solid #A1AAA4}
.primary-button{height:55px;margin-top:18px;border-radius:599px;font-size:17px;font-weight:650}
.export-button{height:50px;margin-top:10px;box-sizing:border-box;border:1px solid #FD7C02;border-radius:599px;font-size:16px;font-weight:650}
.weekday-row{gap:7px}
.weekday-chip{width:48px;height:48px;flex:0 0 48px;box-sizing:border-box;border:1px solid transparent;border-radius:50%;font-size:16px;font-weight:600}
.weekday-chip.is-selected{border-color:#FD7C02}
.rest-list{flex-wrap:wrap;gap:8px}
.rest-chip{height:36px;padding:0 10px 0 14px;border-radius:599px;font-size:13px}
.rest-chip-close{margin-left:7px;font-size:16px;line-height:1}
.rest-empty{margin-top:0}
.schedule-notice{margin:10px 0 0}
.notice{margin-bottom:9px;padding:12px 14px;border-radius:13px;font-size:13px;line-height:1.6}
.card{box-sizing:border-box;border-radius:16px}
.empty-card{padding:26px 16px;flex-direction:column}
.empty-title{font-size:15px;font-weight:600}
.empty-copy{margin-top:4px;font-size:13px;line-height:1.6}
.empty-retry{margin-top:12px;padding:7px 19px;border-radius:599px;font-size:13px;font-weight:600}
.day-card{margin-bottom:10px;padding:15px 15px 6px}
.day-card.is-today{box-shadow:inset 0 0 0 1px rgba(253, 124, 2, .55)}
.day-heading{padding-bottom:7px}
.day-title{font-size:15px;font-weight:650}
.day-minutes{flex:none;margin-left:9px;font-size:12px}
.day-minutes.is-over{font-weight:600}
.task-sk{padding:14px 0 12px}
.task-row{padding:10px 0 9px;border-top:0.5px solid #F0F3F1}
.task-bar{width:4px;margin-right:10px;flex:0 0 4px;border-radius:599px}
.task-copy{min-width:0;flex:1}
.task-heading{gap:8px}
.task-title{min-width:0;font-size:15px;font-weight:600;line-height:1.4}
.task-state{flex:none;padding:2px 8px;border-radius:599px;font-size:11px}
.task-state-action{font-weight:600}
.task-state-warn{font-weight:600}
.task-meta{margin-top:3px;font-size:12px;line-height:1.45}
.task-actions{margin-top:8px;gap:7px}
.task-action{min-width:64px;height:31px;padding:0 9px;box-sizing:border-box;border:0.5px solid #B8C2BB;border-radius:599px;font-size:12px}
.task-action-danger{border-color:#E85F4D}
.clear-link{margin:15px auto 0;padding:7px 14px;font-size:13px}
.sheet-layer{top:0;right:max(0px, 50% - var(--lg-col) / 2);bottom:0;left:max(0px, 50% - var(--lg-col) / 2);box-shadow:0 0 0 100vmax rgba(28, 38, 32, .28)}
.sheet{right:0;bottom:0;left:0;height:75vh;max-height:75vh;padding:9px 16px calc(14px + env(safe-area-inset-bottom));box-sizing:border-box;flex-direction:column;border-radius:24px 24px 0 0}
.sheet-handle{width:43px;height:4px;margin:0 auto 16px;flex:0 0 4px;border-radius:599px}
.sheet-header{flex:0 0 auto}
.sheet-title{font-size:19px;font-weight:700;line-height:1.2}
.sheet-close{width:31px;height:31px;margin-top:-5px;border-radius:50%;font-size:22px;font-weight:300;line-height:1}
.sheet-scroll{min-height:0;margin-top:16px;flex:1}
.sheet-label{margin:0 2px 7px;font-size:13px;line-height:1.3}
.sheet-gap{margin-top:18px}
.course-option{margin-bottom:7px;padding:13px 14px;box-sizing:border-box;border:1px solid transparent;border-radius:15px}
.course-option.is-selected{border-color:#FD7C02}
.course-option-radio{width:18px;height:18px;margin-right:10px;flex:0 0 18px;box-sizing:border-box;border:1px solid #C4CCC6;border-radius:50%}
.course-option.is-selected .course-option-radio{border:5px solid #FD7C02}
.course-option-copy{min-width:0;flex:1}
.course-option-title{font-size:15px;font-weight:600;line-height:1.4}
.course-option-meta{margin-top:2px;font-size:12px;line-height:1.4}
.sheet-error{margin:9px 2px 0;font-size:13px}
.sheet-note{margin-bottom:4px}
.sheet-submit{margin-top:12px;flex:0 0 55px}
.progress-layer{top:0;right:max(0px, 50% - var(--lg-col) / 2);bottom:0;left:max(0px, 50% - var(--lg-col) / 2);padding:0 33px;box-sizing:border-box;box-shadow:0 0 0 100vmax rgba(28, 38, 32, .28)}
.progress-card{width:100%;padding:24px 21px 20px;box-sizing:border-box;border-radius:19px;box-shadow:0 14px 36px rgba(36, 51, 45, .16)}
.progress-title{font-size:19px;font-weight:700;line-height:1.25}
.progress-percent{font-size:18px;font-weight:700;font-variant-numeric:tabular-nums}
.progress-track{height:9px;margin-top:14px;border-radius:599px}
.progress-fill{height:100%;border-radius:599px}
.progress-steps{margin-top:15px}
.progress-step{padding:4px 0;font-size:14px;line-height:1.4}
.progress-step-dot{width:8px;height:8px;margin-right:10px;flex:0 0 8px;border-radius:50%}
.progress-step.is-active{font-weight:600}
.progress-step.is-active .progress-step-dot{box-shadow:0 0 0 3px rgba(253, 124, 2, .18)}
.progress-note{margin-top:12px;font-size:12px;line-height:1.6}
.plan-export-canvas{top:-9999px;left:calc(max(0px, 50% - var(--lg-col) / 2) + -9999px);width:10px;height:10px}
}
