@import "../../styles/skeleton.wxss";
/* 与老师端「我的学生详情」（设计稿 E06）同一套：蓝色渐变头部、#FAFAFA 面板、白色大圆角卡片、主题橙主按钮。 */
page { height: 100%; background: #FAFAFA; color: #24332D; }
.plan-root { position: relative; width: 100%; height: 100vh; overflow: hidden; background: #FAFAFA; }
.plan-ambient { position: fixed; top: 0; left: 0; z-index: 0; width: 100%; height: 520rpx; pointer-events: none; background: linear-gradient(180deg, #1E87FD 0%, #4BA5FF 74%, rgba(250, 250, 250, 0) 100%); }
.plan-topbar { position: fixed; top: 0; left: 0; z-index: 20; width: 100%; box-sizing: border-box; background: transparent; }
.plan-topbar-inner { position: relative; display: flex; align-items: center; box-sizing: content-box; padding: 0 32rpx 16rpx; }
.plan-back { display: flex; flex: 0 0 auto; align-items: center; justify-content: center; width: 54rpx; height: 54rpx; border-radius: 50%; }
.plan-back:active { background: rgba(255, 255, 255, .16); }
.plan-back-icon { width: 22rpx; height: 22rpx; border-bottom: 4rpx solid #FFFFFF; border-left: 4rpx solid #FFFFFF; transform: rotate(45deg) scale(.7); }
.plan-topbar-title { position: absolute; left: 50%; display: block; color: #FFFFFF; font-size: 36rpx; font-weight: 700; letter-spacing: -1rpx; transform: translateX(-50%); white-space: nowrap; }
.plan-page { position: relative; z-index: 1; height: 100vh; box-sizing: border-box; background: transparent; }
.plan-hero { padding: 22rpx 40rpx 58rpx; }
.plan-hero-name { display: block; color: #FFFFFF; font-size: 38rpx; font-weight: 600; line-height: 1.3; }
.plan-hero-meta { display: block; margin-top: 10rpx; color: rgba(255, 255, 255, .86); font-size: 23rpx; line-height: 1.4; }
.plan-hero-meta-sk { width: 300rpx; height: 26rpx; margin-top: 14rpx; border-radius: 10rpx; opacity: .5; }
.plan-panel { position: relative; min-height: 70vh; margin-top: -24rpx; padding: 32rpx 28rpx calc(48rpx + env(safe-area-inset-bottom)); box-sizing: border-box; border-radius: 26rpx 26rpx 0 0; background: #FAFAFA; }

.section-heading { display: flex; align-items: center; justify-content: space-between; margin: 0 4rpx 20rpx; color: #24332D; font-size: 28rpx; font-weight: 700; line-height: 1.25; }
.section-gap { margin-top: 44rpx; }
.section-caption { color: #9AA59E; font-size: 20rpx; font-weight: 400; }
.section-note { display: block; margin: 18rpx 4rpx 0; color: #939C96; font-size: 20rpx; line-height: 1.6; }
.heading-action { padding: 8rpx 22rpx; border-radius: 999rpx; background: #EAF3FF; color: #1E87FD; font-size: 22rpx; font-weight: 600; }
.heading-action:active { opacity: .72; }

/* 每天学习时长：3 列 × 2 行 */
.minute-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16rpx; }
.minute-chip { position: relative; display: flex; height: 108rpx; flex-direction: column; align-items: center; justify-content: center; box-sizing: border-box; border: 2rpx solid transparent; border-radius: 28rpx; background: #FFFFFF; color: #27332C; transition: border-color 160ms ease, background-color 160ms ease; }
.minute-chip:active { opacity: .78; }
.minute-chip.is-selected { border-color: #FD7C02; background: #FFF4EA; color: #D86A00; }
.minute-chip-label { font-size: 28rpx; font-weight: 650; line-height: 1.2; }
.minute-chip-note { margin-top: 6rpx; color: #9AA59E; font-size: 19rpx; line-height: 1; }
.minute-chip.is-selected .minute-chip-note { color: #E08A3A; }

.option-row { display: flex; height: 92rpx; padding: 0 28rpx; box-sizing: border-box; align-items: center; justify-content: space-between; border-radius: 999rpx; background: #FFFFFF; }
.option-row-text { min-width: 0; overflow: hidden; color: #24332D; font-size: 27rpx; text-overflow: ellipsis; white-space: nowrap; }
.option-row-sk { width: 260rpx; }
.option-chevron { width: 14rpx; height: 14rpx; flex: 0 0 14rpx; margin-left: 16rpx; border-top: 3rpx solid #A1AAA4; border-right: 3rpx solid #A1AAA4; transform: rotate(45deg); }

.primary-button { display: flex; height: 92rpx; margin-top: 30rpx; align-items: center; justify-content: center; border-radius: 999rpx; background: linear-gradient(90deg, #FF9F43 0%, #FD7C02 100%); color: #FFFFFF; font-size: 29rpx; font-weight: 650; }
.primary-button:active { opacity: .82; }
.primary-button.is-muted { opacity: .45; }
.primary-button.is-busy { opacity: .6; }
.export-button { display: flex; height: 84rpx; margin-top: 18rpx; align-items: center; justify-content: center; box-sizing: border-box; border: 2rpx solid #FD7C02; border-radius: 999rpx; background: #FFF4EA; color: #D86A00; font-size: 27rpx; font-weight: 650; }
.export-button:active { opacity: .78; }
.export-button.is-busy { opacity: .6; }

/* 每周学习日：7 个圆形开关；单独休息日：可点掉的胶囊 */
.weekday-row { display: flex; justify-content: space-between; gap: 12rpx; }
.weekday-chip { display: flex; width: 80rpx; height: 80rpx; flex: 0 0 80rpx; align-items: center; justify-content: center; box-sizing: border-box; border: 2rpx solid transparent; border-radius: 50%; background: #FFFFFF; color: #9AA59E; font-size: 27rpx; font-weight: 600; transition: border-color 160ms ease, background-color 160ms ease; }
.weekday-chip.is-selected { border-color: #FD7C02; background: #FFF4EA; color: #D86A00; }
.weekday-chip:active { opacity: .78; }
.rest-list { display: flex; flex-wrap: wrap; gap: 14rpx; }
.rest-chip { display: flex; height: 60rpx; padding: 0 18rpx 0 24rpx; align-items: center; border-radius: 999rpx; background: #FFFFFF; color: #24332D; font-size: 23rpx; }
.rest-chip:active { opacity: .72; }
.rest-chip-close { margin-left: 12rpx; color: #A0A9A3; font-size: 28rpx; line-height: 1; }
.rest-empty { margin-top: 0; }
.schedule-notice { margin: 18rpx 0 0; }
.notice { margin-bottom: 16rpx; padding: 20rpx 24rpx; border-radius: 22rpx; background: #EEF5FF; color: #3F6FA8; font-size: 22rpx; line-height: 1.6; }
.notice-warn { background: #FFF4EA; color: #B25A00; }

.card { box-sizing: border-box; border-radius: 28rpx; background: #FFFFFF; }
.empty-card { display: flex; padding: 44rpx 28rpx; flex-direction: column; align-items: center; text-align: center; }
.empty-title { color: #24332D; font-size: 25rpx; font-weight: 600; }
.empty-copy { margin-top: 8rpx; color: #89938C; font-size: 22rpx; line-height: 1.6; }
.empty-retry { margin-top: 20rpx; padding: 12rpx 32rpx; border-radius: 999rpx; background: #EAF3FF; color: #1E87FD; font-size: 23rpx; font-weight: 600; }

/* 按天的任务卡 */
.day-card { margin-bottom: 18rpx; padding: 26rpx 26rpx 10rpx; }
.day-card.is-today { box-shadow: inset 0 0 0 2rpx rgba(253, 124, 2, .55); }
.day-heading { display: flex; align-items: center; justify-content: space-between; padding-bottom: 12rpx; }
.day-title { color: #24332D; font-size: 26rpx; font-weight: 650; }
.day-minutes { flex: none; margin-left: 16rpx; color: #7E8A82; font-size: 21rpx; }
.day-minutes.is-over { color: #D86A00; font-weight: 600; }
.task-sk { padding: 24rpx 0 20rpx; }
.task-row { display: flex; padding: 18rpx 0 16rpx; border-top: 1rpx solid #F0F3F1; }
.task-bar { width: 8rpx; margin-right: 18rpx; flex: 0 0 8rpx; border-radius: 999rpx; background: #DCD8F3; }
.task-bar-passed { background: #BFE3CB; }
.task-bar-action { background: #FFC58E; }
.task-bar-warn { background: #F7B9A6; }
.task-copy { min-width: 0; flex: 1; }
.task-heading { display: flex; align-items: center; justify-content: space-between; gap: 14rpx; }
.task-title { min-width: 0; overflow: hidden; color: #27332C; font-size: 26rpx; font-weight: 600; line-height: 1.4; text-overflow: ellipsis; white-space: nowrap; }
.task-state { flex: none; padding: 4rpx 14rpx; border-radius: 999rpx; background: #F3F5F4; color: #7E8981; font-size: 19rpx; }
.task-state-passed { background: #E8F5EC; color: #2F7A4F; }
.task-state-action { background: #FFF1E3; color: #D86A00; font-weight: 600; }
.task-state-warn { background: #FDEDE8; color: #C4503A; font-weight: 600; }
.task-meta { display: block; margin-top: 6rpx; color: #929B95; font-size: 21rpx; line-height: 1.45; }
.task-actions { display: flex; margin-top: 14rpx; justify-content: flex-end; gap: 12rpx; }
.task-action { display: flex; min-width: 108rpx; height: 52rpx; padding: 0 16rpx; box-sizing: border-box; align-items: center; justify-content: center; border: 1rpx solid #B8C2BB; border-radius: 999rpx; background: #F7F8F7; color: #5F6C64; font-size: 20rpx; }
.task-action:active { opacity: .72; }
.task-action-danger { border-color: #E85F4D; background: #FFF0E8; color: #E85F4D; }
.clear-link { margin: 26rpx auto 0; padding: 12rpx 24rpx; color: #A0A9A3; font-size: 22rpx; text-align: center; }
.clear-link:active { opacity: .6; }

/* 添加任务：底部弹出 */
.sheet-layer { position: fixed; top: 0; right: 0; bottom: 0; left: 0; z-index: 60; background: rgba(28, 38, 32, .28); animation: plan-sheet-fade-in .24s ease-out; }
.sheet-layer.is-closing { animation: plan-sheet-fade-out .28s ease-in forwards; }
.sheet-layer.is-closing .sheet { animation: plan-sheet-down .28s cubic-bezier(.55, .1, .7, .2) forwards; }
.sheet { position: absolute; right: 0; bottom: 0; left: 0; display: flex; height: 75vh; max-height: 75vh; padding: 16rpx 28rpx calc(24rpx + env(safe-area-inset-bottom)); box-sizing: border-box; flex-direction: column; border-radius: 40rpx 40rpx 0 0; background: #F4F5F3; animation: plan-sheet-up .28s cubic-bezier(.22, .8, .24, 1); }
.sheet-handle { width: 72rpx; height: 8rpx; margin: 0 auto 28rpx; flex: 0 0 8rpx; border-radius: 999rpx; background: #DCE2DD; }
.sheet-header { display: flex; flex: 0 0 auto; align-items: center; justify-content: space-between; }
.sheet-title { color: #24332D; font-size: 32rpx; font-weight: 700; line-height: 1.2; }
.sheet-close { display: flex; width: 52rpx; height: 52rpx; margin-top: -8rpx; align-items: center; justify-content: center; border-radius: 50%; background: #F0F2EF; color: #829087; font-size: 38rpx; font-weight: 300; line-height: 1; }
.sheet-scroll { min-height: 0; margin-top: 28rpx; flex: 1; }
.sheet-label { display: block; margin: 0 4rpx 12rpx; color: #6F7D74; font-size: 23rpx; line-height: 1.3; }
.sheet-gap { margin-top: 30rpx; }
.course-option { display: flex; margin-bottom: 12rpx; padding: 22rpx 24rpx; align-items: center; box-sizing: border-box; border: 2rpx solid transparent; border-radius: 26rpx; background: #FFFFFF; }
.course-option.is-selected { border-color: #FD7C02; }
.course-option-radio { width: 30rpx; height: 30rpx; margin-right: 18rpx; flex: 0 0 30rpx; box-sizing: border-box; border: 3rpx solid #C4CCC6; border-radius: 50%; }
.course-option.is-selected .course-option-radio { border: 9rpx solid #FD7C02; }
.course-option-copy { min-width: 0; flex: 1; }
.course-option-title { display: block; overflow: hidden; color: #27332C; font-size: 25rpx; font-weight: 600; line-height: 1.4; text-overflow: ellipsis; white-space: nowrap; }
.course-option-meta { display: block; margin-top: 4rpx; color: #929B95; font-size: 20rpx; line-height: 1.4; }
.sheet-error { display: block; margin: 16rpx 4rpx 0; color: #D6574B; font-size: 22rpx; }
.sheet-note { margin-bottom: 8rpx; }
.sheet-submit { margin-top: 20rpx; flex: 0 0 92rpx; }
@keyframes plan-sheet-fade-in { from { opacity: 0; } to { opacity: 1; } }
@keyframes plan-sheet-fade-out { from { opacity: 1; } to { opacity: 0; } }
@keyframes plan-sheet-up { from { transform: translateY(100%); } to { transform: translateY(0); } }
@keyframes plan-sheet-down { from { transform: translateY(0); } to { transform: translateY(100%); } }

/* 自动排课进度：居中白卡 + 主题橙进度条，盖住整页 */
.progress-layer { position: fixed; top: 0; right: 0; bottom: 0; left: 0; z-index: 70; display: flex; padding: 0 56rpx; box-sizing: border-box; align-items: center; justify-content: center; background: rgba(28, 38, 32, .28); animation: plan-sheet-fade-in .2s ease-out; }
.progress-layer.is-closing { animation: plan-sheet-fade-out .22s ease-in forwards; }
.progress-card { width: 100%; padding: 40rpx 36rpx 34rpx; box-sizing: border-box; border-radius: 32rpx; background: #FFFFFF; box-shadow: 0 24rpx 60rpx rgba(36, 51, 45, .16); }
.progress-heading { display: flex; align-items: baseline; justify-content: space-between; }
.progress-title { color: #24332D; font-size: 32rpx; font-weight: 700; line-height: 1.25; }
.progress-percent { color: #FD7C02; font-size: 30rpx; font-weight: 700; font-variant-numeric: tabular-nums; }
.progress-track { height: 16rpx; margin-top: 24rpx; overflow: hidden; border-radius: 999rpx; background: #FFF1E3; }
.progress-fill { height: 100%; border-radius: 999rpx; background: linear-gradient(90deg, #FF9F43 0%, #FD7C02 100%); transition: width .3s linear; }
.progress-steps { margin-top: 26rpx; }
.progress-step { display: flex; padding: 8rpx 0; align-items: center; color: #A0A9A3; font-size: 24rpx; line-height: 1.4; }
.progress-step-dot { width: 14rpx; height: 14rpx; margin-right: 18rpx; flex: 0 0 14rpx; border-radius: 50%; background: #DCE2DD; }
.progress-step.is-active { color: #24332D; font-weight: 600; }
.progress-step.is-active .progress-step-dot { background: #FD7C02; box-shadow: 0 0 0 6rpx rgba(253, 124, 2, .18); }
.progress-step.is-done { color: #7E8A82; }
.progress-step.is-done .progress-step-dot { background: #FFC58E; }
.progress-note { display: block; margin-top: 20rpx; color: #939C96; font-size: 21rpx; line-height: 1.6; }

/* 导出排课图片用的 2d 画布：放在屏幕外，位图尺寸在 JS 里设 */
.plan-export-canvas { position: fixed; top: -9999px; left: -9999px; width: 10px; height: 10px; pointer-events: none; }

@media (max-width: 350px) {
  .plan-panel { padding-right: 24rpx; padding-left: 24rpx; }
  .minute-chip-label { font-size: 25rpx; }
}

@import "./index.large.wxss"; /* 平板、电脑大屏样式：由 scripts/build-large-screen-styles.mjs 生成，改完本文件后重跑；这一行须留在文件末尾 */
