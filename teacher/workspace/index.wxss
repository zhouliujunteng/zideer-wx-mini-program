@import "../../styles/skeleton.wxss";
/* 与老师端「我的学生详情」（设计稿 E06）同一套：蓝色渐变头部、#FAFAFA 面板、白色大圆角卡片、白色胶囊搜索框。 */
page { height: 100%; background: #FAFAFA; color: #24332D; }
.ws-root { position: relative; display: flex; width: 100%; height: 100vh; flex-direction: column; overflow: hidden; background: #FAFAFA; }
.ws-ambient { position: fixed; top: 0; left: 0; z-index: 0; width: 100%; height: 520rpx; pointer-events: none; background: linear-gradient(180deg, #1E87FD 0%, #4BA5FF 74%, rgba(250, 250, 250, 0) 100%); }
.ws-topbar { position: fixed; top: 0; left: 0; z-index: 20; width: 100%; box-sizing: border-box; background: transparent; }
.ws-topbar-inner { position: relative; display: flex; align-items: center; box-sizing: content-box; padding: 0 32rpx 16rpx; }
.ws-back { display: flex; flex: 0 0 auto; align-items: center; justify-content: center; width: 54rpx; height: 54rpx; border-radius: 50%; }
.ws-back:active { background: rgba(255, 255, 255, .16); }
.ws-back-icon { width: 22rpx; height: 22rpx; border-bottom: 4rpx solid #FFFFFF; border-left: 4rpx solid #FFFFFF; transform: rotate(45deg) scale(.7); }
.ws-topbar-title { position: absolute; left: 50%; display: block; color: #FFFFFF; font-size: 36rpx; font-weight: 700; letter-spacing: -1rpx; transform: translateX(-50%); white-space: nowrap; }

/* 头部：蓝底上的白色胶囊搜索框 */
.ws-header { position: relative; z-index: 1; flex: 0 0 auto; padding: 0 32rpx 56rpx; }
.ws-search { display: flex; height: 84rpx; margin-top: 18rpx; padding: 0 28rpx; box-sizing: border-box; align-items: center; border-radius: 999rpx; background: #FFFFFF; }
.ws-search-icon { display: block; width: 30rpx; height: 30rpx; margin-right: 14rpx; flex: 0 0 30rpx; }
.ws-search-input { min-width: 0; height: 84rpx; flex: 1; color: #24332D; font-size: 26rpx; line-height: 84rpx; }
.ws-search-placeholder { color: #A9B2AB; }
.ws-search-clear { display: flex; width: 40rpx; height: 40rpx; margin-left: 12rpx; flex: 0 0 40rpx; align-items: center; justify-content: center; border-radius: 50%; background: #F0F3F0; color: #8C9890; font-size: 28rpx; font-weight: 300; line-height: 1; }

/* 面板：圆角上沿压住蓝色头部，标题行固定，学生列表在面板内滚动 */
.ws-panel { position: relative; z-index: 2; display: flex; min-height: 0; margin-top: -24rpx; flex: 1; flex-direction: column; border-radius: 26rpx 26rpx 0 0; background: #FAFAFA; }
.ws-heading { display: flex; flex: 0 0 auto; align-items: center; justify-content: space-between; padding: 34rpx 32rpx 20rpx; color: #24332D; font-size: 28rpx; font-weight: 700; line-height: 1.25; }
.ws-heading-title { display: flex; align-items: baseline; gap: 12rpx; }
.section-caption { color: #9AA59E; font-size: 20rpx; font-weight: 400; }
.heading-action { padding: 10rpx 24rpx; border-radius: 999rpx; background: #EAF3FF; color: #1E87FD; font-size: 22rpx; font-weight: 600; }
.heading-action:active { opacity: .72; }
.ws-list { height: 0; flex: 1; }
.ws-list-inner { padding: 0 28rpx calc(48rpx + env(safe-area-inset-bottom)); }
.ws-state { padding: 34rpx 28rpx 0; }

.card { box-sizing: border-box; border: 0; border-radius: 28rpx; background: #FFFFFF; box-shadow: none; }
.student-row { display: flex; align-items: center; margin-bottom: 16rpx; padding: 24rpx 26rpx; }
.student-row:active { background: #F4F8FC; }
.student-avatar { display: block; width: 84rpx; height: 84rpx; flex: 0 0 84rpx; border-radius: 50%; background: #EAF3FF; }
.student-copy { min-width: 0; margin-left: 22rpx; flex: 1; }
.student-name, .student-meta { display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.student-name { color: #27332C; font-size: 28rpx; font-weight: 600; line-height: 1.35; }
.student-meta { margin-top: 6rpx; color: #929B95; font-size: 21rpx; line-height: 1.4; }
.student-date { flex: none; margin-left: 16rpx; color: #A0A9A3; font-size: 20rpx; }
.student-arrow { width: 14rpx; height: 14rpx; margin: 0 6rpx 0 18rpx; flex: 0 0 14rpx; border-top: 3rpx solid #B3BBB5; border-right: 3rpx solid #B3BBB5; transform: rotate(45deg); }
.section-note { display: block; margin-top: 8rpx; color: #939C96; font-size: 20rpx; line-height: 1.6; text-align: center; }

/* 分类：全部 / 没完成任务 */
.ws-tabs { display: flex; flex: 0 0 auto; gap: 14rpx; padding: 0 32rpx 20rpx; }
.ws-tab { display: flex; height: 60rpx; padding: 0 26rpx; align-items: center; border-radius: 999rpx; background: #FFFFFF; color: #6F7A73; font-size: 23rpx; font-weight: 600; }
.ws-tab.is-active { background: #1E87FD; color: #FFFFFF; }
.ws-tab:active { opacity: .78; }
.ws-tab-count { min-width: 32rpx; height: 32rpx; margin-left: 10rpx; padding: 0 8rpx; box-sizing: border-box; border-radius: 999rpx; background: #FD7C02; color: #FFFFFF; font-size: 19rpx; line-height: 32rpx; text-align: center; }
.behind-meta { color: #D86A00; }
.behind-warning { display: block; margin-bottom: 16rpx; padding: 18rpx 22rpx; border-radius: 22rpx; background: #FFF4EA; color: #B25A00; font-size: 21rpx; line-height: 1.6; }

/* 读取失败、非老师、空名单、搜索无结果 */
.empty-card { display: flex; padding: 56rpx 32rpx; flex-direction: column; align-items: center; text-align: center; }
.empty-title { color: #24332D; font-size: 27rpx; font-weight: 600; }
.empty-copy { margin-top: 12rpx; color: #89938C; font-size: 22rpx; line-height: 1.6; }
.empty-retry { margin-top: 24rpx; padding: 14rpx 36rpx; border-radius: 999rpx; background: #EAF3FF; color: #1E87FD; font-size: 23rpx; font-weight: 600; }
.empty-primary { display: flex; height: 76rpx; margin-top: 28rpx; padding: 0 52rpx; align-items: center; justify-content: center; border-radius: 999rpx; background: linear-gradient(90deg, #FF9F43 0%, #FD7C02 100%); color: #FFFFFF; font-size: 26rpx; font-weight: 600; }
.empty-retry:active, .empty-primary:active { opacity: .78; }

/* 首次读取前的骨架：与学生行同尺寸 */
.student-avatar-sk { width: 84rpx; height: 84rpx; flex: 0 0 84rpx; }
.student-meta-sk { margin-top: 14rpx; height: 22rpx; }

@import "./index.large.wxss"; /* 平板、电脑大屏样式：由 scripts/build-large-screen-styles.mjs 生成，改完本文件后重跑；这一行须留在文件末尾 */
