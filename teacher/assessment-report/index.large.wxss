/* 自动生成，请勿手改：index.wxss 在平板、电脑大屏（窗口宽 ≥ 450px）下的样式。
   rpx 按 1rpx = 0.6px 换算，固定定位元素收进居中栏；改完源文件后运行 node scripts/build-large-screen-styles.mjs */
@media (min-width: 450px) {
.surface{border-radius:14px}
.skeleton{border-radius:9px}
.state-panel{padding:72px 14px 24px}
.state-panel__mark{margin-bottom:14px;font-size:31px}
.state-panel__title{font-size:19px;font-weight:600}
.state-panel__copy{margin:13px 0 19px;font-size:15px;line-height:1.6}
.state-panel__action{border-radius:12px}
.state-panel__action::after{border:0}
.sk{border-radius:7px}
.sk-line{height:16px}
.sk-line + .sk-line{margin-top:8px}
.sk-short{width:40%}
.sk-mid{width:64%}
.sk-round{border-radius:50%}
.sk-card{height:96px;border-radius:14px}
.sk-card + .sk-card{margin-top:12px}
.ar-page{min-height:100vh;padding:24px 16px calc(env(safe-area-inset-bottom) + 28px)}
.ar-head{padding:21px 19px;border-radius:14px}
.ar-sk-title{width:70%;height:28px;margin-top:9px}
.ar-eyebrow{font-size:13px;font-weight:700}
.ar-title{margin-top:7px;font-size:20px;font-weight:700;line-height:1.4}
.ar-title-sm{font-size:16px;font-weight:650}
.ar-meta{margin-top:6px;font-size:13px}
.ar-notice{margin-top:6px;font-size:13px;line-height:1.6}
.ar-card{margin-top:12px;padding:16px}
.ar-label{font-size:13px}
.ar-score-row{margin-top:4px}
.ar-score{font-size:28px;font-weight:700}
.ar-band{margin-left:9px;font-size:15px;font-weight:600}
.ar-copy{margin-top:6px;font-size:14px;line-height:1.6}
.ar-section{margin-bottom:4px;font-size:16px;font-weight:650}
.ar-row{padding:9px 0;border-bottom:0.5px solid var(--line)}
.ar-row:last-child{border-bottom:0}
.ar-row-label{min-width:0;font-size:15px}
.ar-tier{font-size:12px}
.ar-row-value{margin-left:9px;font-size:13px}
.ar-review{border-bottom:0.5px solid var(--line)}
.ar-review:last-child{border-bottom:0}
.ar-review-head{padding:10px 0}
.ar-review-title{min-width:0;font-size:15px;line-height:1.5}
.ar-review-body{padding:0 0 12px}
.ar-option{margin-top:4px;padding:7px 9px;border-radius:7px;font-size:14px}
.ar-line{margin-top:7px;font-size:14px;line-height:1.6}
.ar-key{font-weight:600}
}
