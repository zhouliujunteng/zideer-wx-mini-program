@import "../../styles/skeleton.wxss";

/* 版式整套取自 pages/diagnosis-room/index.wxss（学生的诊断室），类名与数值一致，
   老师看到的和学生屏幕上一个样；对话页改了这些规则，这里要跟着改（tests/teacher-live-room-page.test.js 盯着几条关键的）。
   room- 开头的是老师端独有的：顶栏下的已读概况、名字旁的标签、未读、新消息按钮、骨架。 */
page { height: 100%; overflow: hidden; background: #F9FAFF; }

.agent-page { position: fixed; top: 0; right: 0; bottom: 0; left: 0; width: 100%; height: auto; overflow: hidden; background: #F9FAFF; color: #222A25; }
.agent-ambient { position: fixed; top: 0; right: 0; bottom: 0; left: 0; z-index: 0; overflow: hidden; pointer-events: none; background: radial-gradient(125% 48% at 0% 0%, rgba(204, 237, 255, .92) 0%, rgba(225, 241, 255, .62) 34%, rgba(249, 250, 255, 0) 73%), radial-gradient(112% 52% at 100% 0%, rgba(228, 219, 255, .9) 0%, rgba(239, 234, 255, .58) 38%, rgba(250, 249, 255, 0) 76%), linear-gradient(180deg, #F7FBFF 0%, #FBFAFF 54%, #FAFAFC 100%); }
.agent-topbar { position: fixed; top: 0; left: 0; z-index: 20; width: 100%; box-sizing: border-box; background: transparent; }
.agent-topbar-inner { position: relative; display: flex; align-items: center; box-sizing: content-box; padding: 0 36rpx 16rpx; }
.agent-back-button { display: flex; flex: 0 0 auto; align-items: center; justify-content: center; width: 44rpx; height: 44rpx; margin-right: 10rpx; }
.agent-back-button:active { opacity: .65; }
.agent-back-icon { width: 20rpx; height: 20rpx; border-bottom: 3rpx solid #24332D; border-left: 3rpx solid #24332D; transform: rotate(45deg) scale(.72); }
/* 顶栏标题与对话页同一个字号；下面多一行老师才需要的「学生读到哪了」 */
.room-topbar-heading { position: absolute; left: 50%; display: flex; max-width: 56%; flex-direction: column; align-items: center; justify-content: center; transform: translateX(-50%); }
.room-topbar-title { max-width: 100%; overflow: hidden; color: #24332D; font-size: 36rpx; font-weight: 700; letter-spacing: -1rpx; line-height: 1.2; text-overflow: ellipsis; white-space: nowrap; }
.room-topbar-summary { max-width: 100%; margin-top: 2rpx; overflow: hidden; color: #9AA29B; font-size: 20rpx; line-height: 1.3; text-overflow: ellipsis; white-space: nowrap; }

/* 记录列表：底部用 padding 给输入框让位（数值在 index.js 里算），所以外壳本身不再留 330rpx 的底 */
.diagnosis-room-scroll { position: absolute; top: 0; right: 0; bottom: 0; left: 0; z-index: 1; width: auto; height: auto; box-sizing: border-box; background: transparent; }
.diagnosis-room-shell { padding: 26rpx 30rpx 0; box-sizing: border-box; }
.agent-message { display: flex; align-items: flex-start; width: 100%; margin-bottom: 28rpx; }
.agent-message-user { justify-content: flex-end; }
.agent-message-column { min-width: 0; max-width: 88%; }
.agent-message-user .agent-message-column { display: flex; flex-direction: column; align-items: flex-end; max-width: 84%; }
.agent-message-bubble { padding: 18rpx 24rpx; box-sizing: border-box; border-radius: 26rpx 26rpx 26rpx 8rpx; background: #FFFFFF; color: #2F3B33; }
.agent-message-assistant .agent-message-bubble { min-height: 64rpx; background: #FFFFFF; }
.agent-message-user .agent-message-bubble { padding: 16rpx 24rpx; border-radius: 28rpx 28rpx 8rpx 28rpx; background: #DCEEFF; color: #222A25; }
.agent-message-text { display: block; font-size: 27rpx; line-height: 1.62; word-break: break-word; }
.diagnosis-room-bottom { height: 16rpx; }
.agent-message-activity { justify-content: flex-start; }
.agent-message-activity, .agent-message-assistant, .agent-message-user { animation: agent-card-enter .38s cubic-bezier(.2, .8, .2, 1) both; }
@keyframes agent-card-enter { from { opacity: 0; transform: translate3d(0, 18rpx, 0) scale(.985); } to { opacity: 1; transform: translate3d(0, 0, 0) scale(1); } }

.agent-activity-notice { display: flex; justify-content: center; width: 100%; }
.agent-activity-notice text { padding: 8rpx 22rpx; border-radius: 999rpx; background: #F1F3F1; color: #AAB2AB; font-size: 20rpx; }

/* 老师课前语音条：点一下播放/暂停 */
.agent-voice-row { display: flex; width: 100%; flex-direction: column; align-items: flex-start; }
.agent-voice-line { display: flex; max-width: 100%; align-items: center; }
.agent-activity-voice { display: flex; min-width: 200rpx; max-width: 420rpx; padding: 24rpx 28rpx; box-sizing: border-box; align-items: center; border-radius: 26rpx 26rpx 26rpx 8rpx; background: #FFFFFF; box-shadow: 0 8rpx 24rpx rgba(31, 36, 32, .06); }
.agent-activity-voice:active { opacity: .82; }
.agent-activity-voice-wave { display: flex; flex: none; height: 32rpx; margin-right: 18rpx; align-items: center; }
.agent-activity-voice-bar { width: 6rpx; margin-right: 6rpx; border-radius: 3rpx; background: #354B5D; }
.agent-activity-voice-bar:nth-child(1) { height: 14rpx; }
.agent-activity-voice-bar:nth-child(2) { height: 24rpx; }
.agent-activity-voice-bar:nth-child(3) { height: 32rpx; margin-right: 0; }
.agent-activity-voice.is-playing .agent-activity-voice-bar { animation: agent-voice-play .9s ease-in-out infinite; }
.agent-activity-voice.is-playing .agent-activity-voice-bar:nth-child(2) { animation-delay: .15s; }
.agent-activity-voice.is-playing .agent-activity-voice-bar:nth-child(3) { animation-delay: .3s; }
@keyframes agent-voice-play { 0%, 100% { transform: scaleY(.5); } 50% { transform: scaleY(1); } }
.agent-activity-voice-duration { flex: none; color: #354B5D; font-size: 26rpx; }

/* 还没人说话时的卡片：和学生等老师上线时同一张 */
.live-room-standby { display: flex; padding: 96rpx 48rpx 40rpx; flex-direction: column; align-items: center; text-align: center; }
.live-room-standby-avatar { position: relative; width: 132rpx; height: 132rpx; margin-bottom: 32rpx; border-radius: 50%; background: #ECEFEC; }
.live-room-standby-avatar::after { position: absolute; top: 50%; left: 50%; width: 132rpx; height: 132rpx; margin: -66rpx 0 0 -66rpx; border-radius: 50%; border: 2rpx solid rgba(253, 124, 2, .32); content: ''; animation: live-room-pulse 2.4s ease-out infinite; }
@keyframes live-room-pulse { 0% { opacity: .9; transform: scale(1); } 100% { opacity: 0; transform: scale(1.42); } }
.live-room-standby-title { color: #1F2420; font-size: 34rpx; font-weight: 700; }
.live-room-standby-hint { margin-top: 14rpx; color: #FD7C02; font-size: 26rpx; font-weight: 650; }

/* 老师方向的每条消息带小头像和名字，在气泡正上方（.agent-message 本身是横向 flex，这里改成纵向） */
.agent-message.is-live-stacked { flex-direction: column; align-items: flex-start; }
.live-msg-sender { display: flex; margin-bottom: 10rpx; padding-left: 4rpx; align-items: center; }
.live-msg-avatar { display: block; flex: none; width: 40rpx; height: 40rpx; margin-right: 12rpx; border-radius: 50%; background: #DDE2E0; }
.live-msg-avatar-placeholder { background: #DDE2E0; }
.live-msg-name { color: #7D8A82; font-size: 22rpx; }
.live-msg-meta { display: flex; margin-top: 10rpx; padding-left: 8rpx; align-items: center; }
.live-msg-time { color: #A4ADB5; font-size: 20rpx; }
.live-msg-read { margin-left: 12rpx; color: #A4ADB5; font-size: 20rpx; }

/* 会议结束后的说明 */
.live-room-closed { margin: 24rpx auto; padding: 24rpx 28rpx; max-width: 560rpx; box-sizing: border-box; border-radius: 24rpx; background: #F2F4F2; text-align: center; }
.live-room-closed-title { display: block; color: #35433B; font-size: 27rpx; font-weight: 700; }
.live-room-closed-copy { display: block; margin-top: 10rpx; color: #7D8A82; font-size: 23rpx; line-height: 1.6; }

/* 老师端独有：名字旁标出这句是谁发的（学生屏幕上没有），学生还没看到的标红，学生那句的时间靠右 */
.room-sender-tag { margin-left: 10rpx; padding: 2rpx 12rpx; border-radius: 999rpx; background: #EEF1EE; color: #7D8A82; font-size: 19rpx; line-height: 1.5; }
.room-sender-tag.is-teacher { background: #FD7C02; color: #FFFFFF; }
.room-sender-tag.is-ai { background: #FFF0DF; color: #B25A00; }
.live-msg-read.is-unread { color: #C24E3E; }
.live-msg-meta.is-right { padding-right: 8rpx; padding-left: 0; }
.room-blocked { position: relative; z-index: 1; }
.room-state-copy { margin-top: 14rpx; color: #7D8A82; font-size: 25rpx; line-height: 1.6; }

/* 输入框整套取自 pages/diagnosis-room/index.wxss，类名与数值一致，保证和对话页长一个样 */
.agent-composer { position: fixed; right: 0; bottom: 52px; left: 0; z-index: 25; padding: 16rpx 28rpx 18rpx; box-sizing: border-box; background: #FFFFFF; transition: bottom .22s cubic-bezier(.2, .72, .2, 1); will-change: bottom; }
.agent-composer::after { position: absolute; right: 0; bottom: -4px; left: 0; height: 4px; background: #FFFFFF; content: ''; pointer-events: none; }
.agent-composer-bar { display: flex; align-items: center; min-height: 104rpx; padding: 6rpx 18rpx; box-sizing: border-box; border: 1rpx solid #ECEFEC; border-radius: 30rpx; background: #FFF; box-shadow: 0 8rpx 24rpx rgba(39, 52, 43, .06); }
.agent-composer-bar.is-input-active { border-color: #E4E8E4; box-shadow: 0 8rpx 24rpx rgba(39, 52, 43, .09); }
.agent-composer-bar.is-voice-active { border-color: rgba(253, 124, 2, .52); background: #FFF9F2; }
.agent-input { min-width: 0; flex: 1; height: 84rpx; margin: 0 14rpx; color: #2D3931; font-size: 29rpx; line-height: 84rpx; }
.agent-input-placeholder { color: #B5BCB6; }
.agent-voice-button, .agent-send-button { display: flex; flex: 0 0 auto; align-items: center; justify-content: center; width: 62rpx; height: 62rpx; border-radius: 50%; }
.agent-voice-button { background: transparent; }
.agent-voice-button.is-collapsing { width: 0; margin-left: 0; margin-right: 0; opacity: 0; transform: translateX(-24rpx); pointer-events: none; }
.agent-voice-button { overflow: hidden; transition: width .18s ease, margin-left .18s ease, opacity .18s ease, transform .18s ease; }
.agent-voice-icon { display: block; width: 50rpx; height: 50rpx; }
.agent-voice-speak-button { display: flex; flex: 1; align-items: center; justify-content: center; height: 84rpx; margin: 0 14rpx; color: #35443A; font-size: 29rpx; font-weight: 600; line-height: 1; }
.agent-voice-speak-button:active { opacity: .7; }
.agent-send-button { background: #EEF1EE; }
.agent-send-button.is-enabled, .agent-send-button.is-sending { background: #FD7C02; }
.agent-send-icon { display: block; width: 32rpx; height: 32rpx; }
/* 发送中转圈：原来是方形「停止」图标，像能打断 AI，其实点了只是等这句发完（2026-10-06） */
.agent-sending-spinner { width: 26rpx; height: 26rpx; box-sizing: border-box; border: 4rpx solid rgba(255, 255, 255, .45); border-top-color: #FFF; border-radius: 50%; animation: agent-sending-spin .8s linear infinite; }
@keyframes agent-sending-spin { to { transform: rotate(360deg); } }
.agent-composer-note-background { position: fixed; right: 0; bottom: 0; left: 0; z-index: 24; min-height: 48px; padding-bottom: env(safe-area-inset-bottom); box-sizing: border-box; background: #FFFFFF; pointer-events: none; }
.agent-composer-note { position: fixed; right: 0; bottom: 0; left: 0; z-index: 26; display: flex; align-items: flex-start; justify-content: center; min-height: 48px; padding: 9px 28rpx calc(6px + env(safe-area-inset-bottom)); box-sizing: border-box; color: #A7B0A9; font-size: 18rpx; line-height: 18px; text-align: center; white-space: nowrap; background: transparent; pointer-events: none; transform: translateY(5px); }

/* 按住说话时的全屏提示与电平条 */
.voice-demo-status { position: fixed; top: 0; right: 0; bottom: 0; left: 0; z-index: 27; display: flex; flex-direction: column; align-items: center; justify-content: flex-end; box-sizing: border-box; padding: 0 34rpx calc(112rpx + env(safe-area-inset-bottom)); background: linear-gradient(180deg, rgba(255, 255, 255, 0) 34%, rgba(218, 242, 255, .05) 48%, rgba(96, 185, 251, .52) 68%, rgba(54, 158, 247, .9) 84%, rgba(22, 136, 241, .98) 100%); color: #FFF; pointer-events: none; }
.voice-demo-status.is-canceling { background: linear-gradient(180deg, rgba(255, 255, 255, 0) 34%, rgba(255, 245, 245, .08) 48%, rgba(255, 226, 226, .58) 68%, rgba(255, 216, 216, .9) 84%, rgba(255, 214, 214, .98) 100%); color: #FF3030; }
.voice-demo-label { color: rgba(255, 255, 255, .86); font-size: 28rpx; font-weight: 500; line-height: 1.4; text-shadow: 0 2rpx 8rpx rgba(20, 102, 190, .16); }
.voice-demo-status.is-canceling .voice-demo-label { color: #FF3030; text-shadow: none; }
.voice-demo-wave { display: flex; align-items: center; justify-content: center; width: 82%; height: 76rpx; margin-top: 58rpx; }
/* 高度是行内传入的 rpx 设计值（--bar-height，默认 4），在这里换算，大屏下才会跟着固定比例（见 utils/screen.js） */
.voice-demo-bar { flex: 1 1 0; min-width: 3rpx; max-width: 8rpx; height: calc(var(--bar-height, 4) * 1000rpx / 1000); margin: 0 2rpx; border-radius: 999rpx; background: rgba(255, 255, 255, .92); box-shadow: 0 0 8rpx rgba(255, 255, 255, .14); transition: height 70ms linear, opacity 70ms linear; }
.voice-demo-status.is-canceling .voice-demo-bar { background: #FF4242; box-shadow: 0 0 8rpx rgba(255, 65, 65, .12); }
.voice-demo-status.is-canceling .voice-demo-bar:nth-child(3n) { background: #FF9A9A; }

/* 回到底部：圆按钮整套取自 pages/diagnosis-room/index.wxss；翻上去期间来了新消息时展开成「N 条新消息」 */
.agent-scroll-bottom-button { position: fixed; left: 50%; z-index: 21; display: flex; align-items: center; justify-content: center; width: 64rpx; height: 64rpx; border: 1rpx solid #E5EAE5; border-radius: 50%; background: rgba(255, 255, 255, .97); box-shadow: 0 8rpx 22rpx rgba(39, 52, 43, .11); transform: translateX(-50%); animation: agent-scroll-bottom-enter .18s ease-out; }
.agent-scroll-bottom-button:active { background: #FFF8F0; transform: translateX(-50%) scale(.94); }
.agent-scroll-bottom-icon { width: 16rpx; height: 16rpx; border-right: 3rpx solid #7B877E; border-bottom: 3rpx solid #7B877E; transform: rotate(45deg) translate(-3rpx, -3rpx); }
@keyframes agent-scroll-bottom-enter { from { opacity: 0; transform: translate(-50%, 8rpx); } to { opacity: 1; transform: translate(-50%, 0); } }
/* 输入框高约 138rpx，按钮浮在它上方一点；--composer-bottom 是输入框离底边的距离（随安全区变） */
.room-jump { bottom: calc(var(--composer-bottom) + 160rpx); }
.room-jump.is-unseen { width: auto; padding: 0 26rpx 0 30rpx; border-color: #FFD9B4; border-radius: 32rpx; background: #FFF8F0; }
.room-jump.is-unseen .agent-scroll-bottom-icon { border-color: #FD7C02; }
.room-unseen-text { margin-right: 16rpx; color: #FD7C02; font-size: 24rpx; font-weight: 600; white-space: nowrap; }

/* 第一次读到会议记录前的气泡骨架（和对话页回放骨架同一个形状） */
.room-skeleton { position: relative; z-index: 1; display: flex; padding-right: 30rpx; padding-left: 30rpx; box-sizing: border-box; flex-direction: column; }
.room-skeleton-bubble { width: 64%; height: 112rpx; margin-top: 28rpx; border-radius: 26rpx; }
.room-skeleton-bubble.is-student { align-self: flex-end; width: 42%; height: 72rpx; }
.room-skeleton-bubble.is-short { width: 50%; height: 88rpx; }

/* 学生诊断室里的「课程安排」卡片、选择题卡片（会议记录里带的卡片数据，utils/room-card-record.js）：
   规则照抄 pages/diagnosis-room/index.wxss，老师看到的和学生屏幕上一样；选择题只读，不画选择框与确认键。 */
.agent-activity-question { width: 100%; box-sizing: border-box; padding: 16rpx; border-radius: 36rpx; background: linear-gradient(160deg, #FF8A1F 0%, #FD7C02 55%, #F27000 100%); box-shadow: 0 10rpx 26rpx rgba(253, 124, 2, .22); }
.agent-activity-question-title { display: block; padding: 8rpx 10rpx 16rpx; color: #FFFFFF; font-size: 27rpx; font-weight: 600; line-height: 1.55; }
.agent-activity-question-option { display: flex; align-items: center; box-sizing: border-box; width: 100%; min-height: 76rpx; margin-top: 12rpx; padding: 14rpx 22rpx; border: 1rpx solid rgba(255, 255, 255, .42); border-radius: 20rpx; background: rgba(255, 255, 255, .16); }
.agent-activity-question-title + .agent-activity-question-option { margin-top: 0; }
.agent-activity-question-option text { color: #FFFFFF; font-size: 25rpx; font-weight: 500; line-height: 1.45; text-shadow: 0 1rpx 2rpx rgba(160, 70, 0, .18); }
.agent-activity-question-option { transition: background .18s ease, border-color .18s ease; }
.agent-activity-question-option.is-confirm text { font-weight: 700; }
.agent-activity-question-hint { display: block; padding: 14rpx 10rpx 4rpx; color: rgba(255, 255, 255, .88); font-size: 21rpx; line-height: 1.5; }
.agent-activity-question.is-answered { border: 1rpx solid #F6DDBF; background: #FFF7EE; box-shadow: none; }
.agent-activity-question.is-answered .agent-activity-question-title { padding-bottom: 12rpx; color: #6B5A48; font-weight: 500; }
.agent-activity-question.is-answered .agent-activity-question-option { min-height: 64rpx; border-color: #F3CFA3; background: #FFFFFF; }
.agent-activity-question.is-answered .agent-activity-question-option text { color: #C45F00; font-weight: 600; }
.agent-activity-plan { width: 100%; box-sizing: border-box; padding: 26rpx 24rpx 14rpx; border-radius: 36rpx; background: #FFFFFF; box-shadow: 0 8rpx 24rpx rgba(36, 51, 45, .06); }
.agent-activity-plan-head { display: flex; align-items: center; justify-content: space-between; }
.agent-activity-plan-label { padding: 4rpx 14rpx; border-radius: 999rpx; background: #FFF0DF; color: #D86A00; font-size: 20rpx; font-weight: 600; }
.agent-activity-plan-count { color: #9AA59E; font-size: 21rpx; }
.agent-activity-plan-title { display: block; margin-top: 14rpx; color: #24332D; font-size: 29rpx; font-weight: 700; line-height: 1.4; }
.agent-activity-plan-findings { display: block; margin-top: 10rpx; color: #6F7D74; font-size: 23rpx; line-height: 1.6; }
.agent-activity-plan-lesson { margin-top: 10rpx; padding: 16rpx 20rpx; border-radius: 22rpx; background: #F6F8F7; }
.agent-activity-plan-lesson:last-child { margin-bottom: 10rpx; }
.agent-activity-plan-lesson-head { display: flex; align-items: baseline; }
.agent-activity-plan-number { flex: 0 0 auto; margin-right: 12rpx; color: #FD7C02; font-size: 23rpx; font-weight: 700; }
.agent-activity-plan-lesson-title { min-width: 0; flex: 1; color: #27332C; font-size: 25rpx; font-weight: 600; line-height: 1.45; }
.agent-activity-plan-point { display: block; margin-top: 8rpx; color: #4C8AD6; font-size: 22rpx; line-height: 1.5; }
.agent-activity-plan-outline { display: block; margin-top: 6rpx; color: #59675F; font-size: 23rpx; line-height: 1.6; }
.agent-activity-plan-pre { display: block; margin-top: 6rpx; color: #929B95; font-size: 21rpx; line-height: 1.5; }
.agent-activity-question.is-answered .agent-activity-question-hint { color: #A08A72; }
.agent-message-column > .agent-activity-plan + .live-msg-meta, .agent-message-column > .agent-activity-question + .live-msg-meta { margin-top: 8rpx; }

/* 目标导图入口：浮在消息列表右上角 */
.room-goal-entry { position: fixed; right: 16px; z-index: 25; display: flex; align-items: center; gap: 6px; padding: 6px 12px; border-radius: 999px; background: rgba(255, 255, 255, .94); box-shadow: 0 4px 14px rgba(36, 51, 45, .1); color: #C46A12; font-size: 12px; font-weight: 650; }
.room-goal-entry:active { opacity: .8; }
.room-goal-ring { width: 14px; height: 14px; box-sizing: border-box; border: 2px solid #FD7C02; border-radius: 50%; display: flex; align-items: center; justify-content: center; }
.room-goal-dot { width: 4px; height: 4px; border-radius: 50%; background: #FD7C02; }

@import "./index.large.wxss"; /* 平板、电脑大屏样式：由 scripts/build-large-screen-styles.mjs 生成，改完本文件后重跑；这一行须留在文件末尾 */
