/* 自动生成，请勿手改：index.wxss 在平板、电脑大屏（窗口宽 ≥ 450px）下的样式。
   rpx 按 1rpx = 0.6px 换算，固定定位元素收进居中栏；改完源文件后运行 node scripts/build-large-screen-styles.mjs */
@media (min-width: 450px) {
.sk{border-radius:7px}
.sk-line{height:16px}
.sk-line + .sk-line{margin-top:8px}
.sk-short{width:40%}
.sk-mid{width:64%}
.sk-round{border-radius:50%}
.sk-card{height:96px;border-radius:14px}
.sk-card + .sk-card{margin-top:12px}
page{height:100%}
.report-root{width:100%;height:100vh}
.report-ambient{top:0;left:max(0px, 50% - var(--lg-col) / 2);width:min(100%, var(--lg-col));height:312px}
.report-topbar{top:0;left:max(0px, 50% - var(--lg-col) / 2);width:min(100%, var(--lg-col))}
.report-topbar-inner{padding:0 19px 9px}
.report-back{width:32px;height:32px;border-radius:50%}
.report-back-icon{width:13px;height:13px;border-bottom:2px solid #FFFFFF;border-left:2px solid #FFFFFF}
.report-topbar-title{left:50%;font-size:21px;font-weight:700;letter-spacing:-1px}
.report-page{height:100vh}
.report-hero{padding:13px 24px 34px}
.report-hero-name{font-size:22px;font-weight:600;line-height:1.3}
.report-hero-meta{margin-top:6px;font-size:13px;line-height:1.4}
.report-hero-meta-sk{width:180px;height:15px;margin-top:8px;border-radius:6px}
.report-panel{min-height:70vh;margin-top:-15px;padding:19px 16px calc(28px + env(safe-area-inset-bottom));border-radius:15px 15px 0 0}
.card{border-radius:16px}
.create-button{height:36px;padding:0 15px;border-radius:599px;font-size:14px;font-weight:650}
.section-lead{margin:-4px 2px 13px;font-size:12px;line-height:1.6}
.section-heading{margin:0 2px 12px;font-size:16px;font-weight:700;line-height:1.25}
.section-gap{margin-top:26px}
.section-caption{font-size:12px;font-weight:400}
.section-note{margin:13px 2px 0;font-size:12px;line-height:1.6}
.empty-card{padding:26px 16px}
.empty-title{font-size:15px;font-weight:600}
.empty-copy{margin-top:4px;font-size:13px;line-height:1.6}
.empty-retry{margin-top:12px;padding:7px 19px;border-radius:599px;font-size:13px;font-weight:600}
.item-card{margin-bottom:10px;padding:15px 16px 14px}
.item-sk{padding:13px 0 2px}
.item-heading{gap:9px}
.item-time{font-size:16px;font-weight:650}
.item-state{padding:2px 9px;border-radius:599px;font-size:12px}
.item-state-busy{font-weight:600}
.item-state-failed{font-weight:600}
.item-meta{margin-top:3px;font-size:12px;line-height:1.45}
.item-progress{margin-top:10px}
.item-progress-bar{height:6px;border-radius:599px}
.item-progress-fill{top:0;bottom:0;left:-40%;width:40%;border-radius:599px}
.item-progress-text{margin-top:6px;font-size:12px;line-height:1.5}
.item-error{margin-top:8px;font-size:13px;line-height:1.55}
.item-chips{gap:6px;margin-top:9px}
.item-chip{padding:3px 9px;border-radius:599px;font-size:12px;line-height:1.4}
.item-note{margin-top:9px;padding:9px 12px 10px;border-radius:12px}
.item-note-head{gap:7px}
.item-note-label{font-size:12px;font-weight:650}
.item-note-copy{font-size:11px}
.item-note-text{margin-top:4px;font-size:13px;line-height:1.7}
.item-actions{margin-top:12px;gap:9px}
.item-action{min-width:79px;height:38px;padding:0 13px;border:1px solid #D5DCD7;border-radius:599px;font-size:14px;font-weight:600}
.item-action.is-primary{border-color:transparent}
.item-action.is-done{border-color:#F3D9BF}
.item-push{margin-top:7px;font-size:13px;line-height:1.55}
.item-action.is-quiet{min-width:0;margin-right:auto;border-color:transparent;font-weight:500}
}
