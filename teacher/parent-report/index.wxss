@import "../../styles/skeleton.wxss";
/* 与老师端「我的学生详情」「学习安排」（设计稿 E06）同一套：蓝色渐变头部、#FAFAFA 面板、白色大圆角卡片、主题橙主按钮。 */
page { height: 100%; background: #FAFAFA; color: #24332D; }
.report-root { position: relative; width: 100%; height: 100vh; overflow: hidden; background: #FAFAFA; }
.report-ambient { position: fixed; top: 0; left: 0; z-index: 0; width: 100%; height: 520rpx; pointer-events: none; background: linear-gradient(180deg, #1E87FD 0%, #4BA5FF 74%, rgba(250, 250, 250, 0) 100%); }
.report-topbar { position: fixed; top: 0; left: 0; z-index: 20; width: 100%; box-sizing: border-box; background: transparent; }
.report-topbar-inner { position: relative; display: flex; align-items: center; box-sizing: content-box; padding: 0 32rpx 16rpx; }
.report-back { display: flex; flex: 0 0 auto; align-items: center; justify-content: center; width: 54rpx; height: 54rpx; border-radius: 50%; }
.report-back:active { background: rgba(255, 255, 255, .16); }
.report-back-icon { width: 22rpx; height: 22rpx; border-bottom: 4rpx solid #FFFFFF; border-left: 4rpx solid #FFFFFF; transform: rotate(45deg) scale(.7); }
.report-topbar-title { position: absolute; left: 50%; display: block; color: #FFFFFF; font-size: 36rpx; font-weight: 700; letter-spacing: -1rpx; transform: translateX(-50%); white-space: nowrap; }
.report-page { position: relative; z-index: 1; height: 100vh; box-sizing: border-box; background: transparent; }
.report-hero { padding: 22rpx 40rpx 58rpx; }
.report-hero-name { display: block; color: #FFFFFF; font-size: 38rpx; font-weight: 600; line-height: 1.3; }
.report-hero-meta { display: block; margin-top: 10rpx; color: rgba(255, 255, 255, .86); font-size: 23rpx; line-height: 1.4; }
.report-hero-meta-sk { width: 300rpx; height: 26rpx; margin-top: 14rpx; border-radius: 10rpx; opacity: .5; }
.report-panel { position: relative; min-height: 70vh; margin-top: -24rpx; padding: 32rpx 28rpx calc(48rpx + env(safe-area-inset-bottom)); box-sizing: border-box; border-radius: 26rpx 26rpx 0 0; background: #FAFAFA; }

.card { box-sizing: border-box; border-radius: 28rpx; background: #FFFFFF; }

/* 生成新报告：标题右边的小胶囊按钮 */
.create-button { display: flex; height: 60rpx; padding: 0 26rpx; flex: none; align-items: center; justify-content: center; border-radius: 999rpx; background: linear-gradient(90deg, #FF9F43 0%, #FD7C02 100%); color: #FFFFFF; font-size: 24rpx; font-weight: 650; }
.create-button:active { opacity: .82; }
.create-button.is-muted { opacity: .45; }
.create-button.is-busy { opacity: .6; }
.section-lead { display: block; margin: -6rpx 4rpx 22rpx; color: #939C96; font-size: 21rpx; line-height: 1.6; }

.section-heading { display: flex; align-items: center; justify-content: space-between; margin: 0 4rpx 20rpx; color: #24332D; font-size: 28rpx; font-weight: 700; line-height: 1.25; }
.section-gap { margin-top: 44rpx; }
.section-caption { color: #9AA59E; font-size: 20rpx; font-weight: 400; }
.section-note { display: block; margin: 22rpx 4rpx 0; color: #939C96; font-size: 20rpx; line-height: 1.6; }

.empty-card { display: flex; padding: 44rpx 28rpx; flex-direction: column; align-items: center; text-align: center; }
.empty-title { color: #24332D; font-size: 25rpx; font-weight: 600; }
.empty-copy { margin-top: 8rpx; color: #89938C; font-size: 22rpx; line-height: 1.6; }
.empty-retry { margin-top: 20rpx; padding: 12rpx 32rpx; border-radius: 999rpx; background: #EAF3FF; color: #1E87FD; font-size: 23rpx; font-weight: 600; }

/* 每份报告 */
.item-card { margin-bottom: 18rpx; padding: 26rpx 28rpx 24rpx; }
.item-sk { padding: 22rpx 0 4rpx; }
.item-heading { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; }
.item-time { color: #24332D; font-size: 27rpx; font-weight: 650; }
.item-state { flex: none; padding: 4rpx 16rpx; border-radius: 999rpx; background: #F3F5F4; color: #7E8981; font-size: 20rpx; }
.item-state-ready { background: #E8F5EC; color: #2F7A4F; }
.item-state-busy { background: #FFF1E3; color: #D86A00; font-weight: 600; }
.item-state-failed { background: #FDEDE8; color: #C4503A; font-weight: 600; }
.item-meta { display: block; margin-top: 6rpx; color: #929B95; font-size: 21rpx; line-height: 1.45; }

.item-progress { margin-top: 18rpx; }
.item-progress-bar { position: relative; height: 10rpx; overflow: hidden; border-radius: 999rpx; background: #FFF1E3; }
.item-progress-fill { position: absolute; top: 0; bottom: 0; left: -40%; width: 40%; border-radius: 999rpx; background: linear-gradient(90deg, #FFB264, #FD7C02); animation: report-progress 1.4s ease-in-out infinite; }
@keyframes report-progress { from { left: -40%; } to { left: 100%; } }
.item-progress-text { display: block; margin-top: 10rpx; color: #B07A1A; font-size: 21rpx; line-height: 1.5; }
.item-error { display: block; margin-top: 14rpx; color: #C4503A; font-size: 22rpx; line-height: 1.55; }

.item-chips { display: flex; flex-wrap: wrap; gap: 10rpx; margin-top: 16rpx; }
.item-chip { padding: 6rpx 16rpx; border-radius: 999rpx; background: #F3F5F4; color: #5E6B63; font-size: 21rpx; line-height: 1.4; }
.item-chip.is-up { background: #E8F5EC; color: #2F7A4F; }
.item-note { margin-top: 16rpx; padding: 16rpx 20rpx 18rpx; border-radius: 20rpx; background: #FFF7EF; }
.item-note:active { opacity: .75; }
.item-note.is-student { background: #EEF5FF; }
.item-note-head { display: flex; align-items: center; justify-content: space-between; gap: 12rpx; }
.item-note-label { color: #C56204; font-size: 21rpx; font-weight: 650; }
.is-student .item-note-label { color: #2F6FBF; }
.item-note-copy { flex: none; color: #A3ABA5; font-size: 19rpx; }
.item-note-text { display: block; margin-top: 8rpx; color: #4B5650; font-size: 23rpx; line-height: 1.7; white-space: pre-wrap; }

.item-actions { display: flex; flex-wrap: wrap; margin-top: 20rpx; justify-content: flex-end; gap: 16rpx; }
.item-action { display: flex; min-width: 132rpx; height: 64rpx; padding: 0 22rpx; box-sizing: border-box; align-items: center; justify-content: center; border: 2rpx solid #D5DCD7; border-radius: 999rpx; background: #FFFFFF; color: #4B5650; font-size: 24rpx; font-weight: 600; }
.item-action:active { opacity: .72; }
.item-action.is-primary { border-color: transparent; background: linear-gradient(90deg, #FF9F43 0%, #FD7C02 100%); color: #FFFFFF; }
.item-action.is-busy { opacity: .6; }
.item-action.is-done { border-color: #F3D9BF; background: #FFF6EC; color: #C8740E; }
.item-push { display: block; margin-top: 12rpx; color: #8A948E; font-size: 22rpx; line-height: 1.55; text-align: right; }
.item-action.is-quiet { min-width: 0; margin-right: auto; border-color: transparent; background: transparent; color: #A3ABA5; font-weight: 500; }

@import "./index.large.wxss"; /* 平板、电脑大屏样式：由 scripts/build-large-screen-styles.mjs 生成，改完本文件后重跑；这一行须留在文件末尾 */
