/* 自动生成，请勿手改：index.wxss 在平板、电脑大屏（窗口宽 ≥ 450px）下的样式。
   rpx 按 1rpx = 0.6px 换算，固定定位元素收进居中栏；改完源文件后运行 node scripts/build-large-screen-styles.mjs */
@media (min-width: 450px) {
.sk{border-radius:7px}
.sk-line{height:16px}
.sk-line + .sk-line{margin-top:8px}
.sk-short{width:40%}
.sk-mid{width:64%}
.sk-round{border-radius:50%}
.sk-card{height:96px;border-radius:14px}
.sk-card + .sk-card{margin-top:12px}
page{height:100%}
.student-service-root{width:100%;height:100vh}
.student-service-ambient{top:0;left:max(0px, 50% - var(--lg-col) / 2);width:min(100%, var(--lg-col));height:372px}
.student-service-topbar{top:0;left:max(0px, 50% - var(--lg-col) / 2);width:min(100%, var(--lg-col));box-sizing:border-box}
.student-service-topbar-inner{box-sizing:content-box;padding:0 19px 9px}
.student-service-back{flex:0 0 auto;width:32px;height:32px;border-radius:50%}
.student-service-back-icon{width:13px;height:13px;border-bottom:2px solid #FFFFFF;border-left:2px solid #FFFFFF}
.student-service-topbar-title{left:50%;font-size:21px;font-weight:700;letter-spacing:-1px}
.student-service-page{height:100vh;box-sizing:border-box}
.student-service-hero{padding:15px 21px 34px}
.student-summary{min-height:87px;box-sizing:border-box}
.student-avatar{width:55px;height:55px;margin-right:14px;flex:0 0 55px;box-sizing:border-box;border:2px solid rgba(255, 255, 255, .78);border-radius:50%;font-size:20px;font-weight:650}
.student-copy{min-width:0;flex-direction:column}
.student-heading{min-width:0;gap:8px}
.student-name{min-width:0;font-size:22px;font-weight:500;line-height:1.25}
.student-role-badge{height:24px;padding:0 9px;flex:0 0 auto;box-sizing:border-box;border-radius:599px;font-size:11px;font-weight:400;line-height:1}
.student-meta{margin-top:5px;font-size:12px;line-height:1.4}
.student-service-panel{min-height:58vh;margin-top:-15px;padding-bottom:calc(24px + env(safe-area-inset-bottom));box-sizing:border-box;border-radius:15px 15px 0 0}
.student-service-tabs{width:100%;height:49px;border-radius:15px 15px 0 0}
.student-service-tab{height:44px;flex:1;border-radius:15px 15px 0 0;font-size:13px;line-height:1}
.student-service-tab.is-selected{height:58px;font-size:16px;font-weight:700}
.student-service-tab-icon{width:18px;height:18px;margin-right:5px;flex:0 0 18px}
.student-service-tab.is-selected .student-service-tab-icon{width:21px;height:21px;flex-basis:21px}
.student-service-tab::before, .student-service-tab::after{bottom:0;width:19px;height:19px}
.student-service-tab::before{left:-20px}
.student-service-tab::after{right:-20px}
.tab-content{padding:16px 16px 2px}
.tab-empty{min-height:0.5px}
@keyframes student-service-tab-enter-right{from{opacity:.72;transform:translateX(20px)}to{opacity:1;transform:translateX(0)}}
@keyframes student-service-tab-enter-left{from{opacity:.72;transform:translateX(-21px)}to{opacity:1;transform:translateX(0)}}
.section-heading{margin:0 2px 12px;font-size:16px;font-weight:700;line-height:1.25}
.section-caption{font-size:12px;font-weight:400}
.card{box-sizing:border-box;border:0;border-radius:16px;box-shadow:none}
.profile-card{padding:4px 16px}
.profile-row{min-height:56px;padding:12px 0;box-sizing:border-box;border-bottom:0.5px solid #F0F3F1}
.profile-row:first-child, .profile-row:last-child{min-height:43px;padding-top:4px;padding-bottom:4px}
.profile-row:last-child{border-bottom:0}
.field-label{font-size:13px;line-height:1.35}
.field-value{max-width:70%;font-size:15px;line-height:1.4}
.section-note{margin-top:12px;font-size:12px;line-height:1.6}
.profile-status-badge{flex:0 0 auto;padding:5px 9px;gap:4px;border:0;border-radius:599px;font-size:12px;font-weight:500;line-height:1.2}
.profile-status-dot{width:6px;height:6px;flex:0 0 6px;border-radius:50%}
.profile-notice{margin:8px 2px 0}
.appointment-launcher{width:100%;height:64px;padding:0 18px;box-sizing:border-box;border-radius:599px}
.appointment-launcher-icon{width:25px;height:25px;margin-right:10px;flex:0 0 25px}
.appointment-launcher-label{font-size:15px;font-weight:600}
.appointment-launcher-arrow{width:9px;height:9px;margin-left:auto;margin-right:1px;border-top:1px solid #9AA59E;border-right:1px solid #9AA59E}
.appointment-sheet-layer{top:0;right:max(0px, 50% - var(--lg-col) / 2);bottom:0;left:max(0px, 50% - var(--lg-col) / 2);box-shadow:0 0 0 100vmax rgba(28, 38, 32, .28)}
.appointment-sheet{right:0;bottom:0;left:0;height:75vh;max-height:75vh;padding:9px 16px calc(14px + env(safe-area-inset-bottom));box-sizing:border-box;flex-direction:column;border-radius:24px 24px 0 0}
.appointment-sheet-handle{width:43px;height:4px;margin:0 auto 16px;flex:0 0 4px;border-radius:599px}
.appointment-sheet-header{flex:0 0 auto}
.appointment-sheet-title{font-size:19px;font-weight:700;line-height:1.2}
.appointment-sheet-close{width:31px;height:31px;margin-top:-5px;border-radius:50%;font-size:22px;font-weight:300;line-height:1}
.appointment-sheet-scroll{min-height:0;margin-top:18px;flex:1}
.appointment-field{margin-top:13px}
.appointment-field:first-child{margin-top:0}
.appointment-field-label{margin:0 2px 7px;font-size:13px;line-height:1.3}
.appointment-option{width:100%;height:55px;border-radius:599px}
.appointment-option-content{width:100%;height:55px;padding:0 16px;box-sizing:border-box;font-size:16px;line-height:1}
.appointment-option-content text{min-width:0}
.appointment-option-chevron{width:8px;height:8px;flex:0 0 8px;margin-left:9px;border-top:1px solid #A1AAA4;border-right:1px solid #A1AAA4}
.appointment-note-input{padding:0 16px;box-sizing:border-box;font-size:16px;line-height:55px}
.duration-control{width:100%;height:55px;gap:7px}
.duration-value-input{min-width:0;height:55px;padding:0 16px;flex:1;box-sizing:border-box;border-radius:599px;font-size:16px;line-height:55px}
.duration-unit-picker{width:93px;height:55px;flex:0 0 93px;border-radius:599px}
.duration-unit-content{width:100%;height:55px;padding:0 16px;box-sizing:border-box;font-size:15px;line-height:1}
.appointment-notice{margin:10px 2px 4px}
.appointment-submit{width:144px;height:57px;min-height:57px;margin:14px auto 0;flex:0 0 57px;border-radius:599px;font-size:16px;line-height:57px}
.primary-button{height:49px;margin-top:15px;border-radius:599px;font-size:16px;font-weight:650}
.appointment-records{margin-top:22px}
.record-card-stack{margin-bottom:10px}
.record-card{margin-bottom:0;padding:15px 15px 13px;border:0;box-shadow:none}
.record-heading{gap:9px}
.record-title-group{min-width:0;flex:1;flex-direction:column}
.record-title{min-width:0;font-size:16px;font-weight:650;line-height:1.4}
.record-time{flex:0 0 auto;max-width:52%;font-size:13px;line-height:1.4}
.record-subtitle{margin-top:5px;font-size:12px;line-height:1.4}
.record-detail{margin-top:4px;font-size:11px;line-height:1.4}
.record-actions{margin-top:10px;gap:7px}
.record-action{min-width:64px;height:32px;padding:0 9px;box-sizing:border-box;border:0.5px solid #707B73;border-radius:599px;font-size:12px}
.record-action-soft{border-color:#4C8AD6}
.record-menu-cancel-action{min-width:64px;padding:0 9px;border:0.5px solid #E85F4D;font-weight:600}
.record-voice-peek{width:calc(100% - 21px);min-height:55px;margin:-14px auto 0;padding:20px 14px 0;box-sizing:border-box;border-radius:0 0 14px 14px}
.voice-state-dot{width:8px;height:8px;margin-right:8px;border-radius:50%}
.voice-state{font-size:12px}
.voice-action{margin-left:auto;font-size:13px;font-weight:650}
.empty-card{padding:26px 14px;font-size:13px}
.hero-name-sk{width:108px;height:26px;border-radius:7px}
.hero-meta-sk{width:192px;height:15px;margin-top:7px;border-radius:6px}
.profile-value-sk{width:132px;height:16px}
.preference-card{padding:4px 16px}
.preference-row{flex-direction:column;padding:13px 0;border-bottom:0.5px solid #F0F3F1}
.preference-row:last-child{border-bottom:0}
.preference-tags{flex-wrap:wrap;gap:7px;margin-top:8px}
.preference-tag{padding:4px 12px;border-radius:599px;font-size:13px;line-height:1.4}
.preference-note{margin-top:7px;font-size:14px;line-height:1.7}
.preference-missing{margin-top:7px;font-size:13px;line-height:1.6}
.record-sk-gap{margin-top:8px}
.student-service-tab .tab-dot{top:10px;right:15px;width:7px;height:7px;border-radius:50%}
.student-service-tab.is-selected .tab-dot{top:14px}
.section-badge{padding:2px 8px;border-radius:599px;font-size:12px;font-weight:600}
.empty-card{flex-direction:column}
.empty-title{font-size:15px;font-weight:600}
.empty-copy{margin-top:4px;font-size:13px;line-height:1.6}
.empty-retry{margin-top:12px;padding:7px 19px;border-radius:599px;font-size:13px;font-weight:600}
button.record-action{margin:0;padding:0 9px;line-height:31px;font-weight:400}
button.record-action::after{border:0}
.record-voice-peek{padding-bottom:3px}
.list-row{margin-bottom:9px;padding:15px}
.list-row.is-pending{box-shadow:inset 0 0 0 1px #FD7C02}
.list-copy{flex:1;min-width:0}
.list-title{font-size:15px;font-weight:600;line-height:1.4}
.list-meta{margin-top:4px;font-size:12px;line-height:1.4}
.list-status{flex:none;margin-left:12px;padding:3px 9px;border-radius:599px;font-size:12px}
.list-status-action{font-weight:600}
.learning-gap{margin-top:26px}
.study-plan-launcher{height:70px}
.study-plan-launcher + .study-plan-launcher{margin-top:10px}
.study-plan-launcher-copy{min-width:0;flex:1;flex-direction:column}
.study-plan-launcher-note{margin-top:3px;font-size:12px;line-height:1.3}
.course-filters{margin:-3px 0 10px;gap:7px;flex-wrap:wrap}
.course-filter{height:33px;padding:0 13px;gap:4px;border-radius:599px;font-size:13px}
.course-filter.is-active{font-weight:600}
.course-filter-count{font-size:12px}
.appointment-error{margin:10px 2px 0;font-size:13px}
.meeting-done-hint{margin-bottom:14px;padding:14px 12px 14px 16px;border-radius:16px}
.meeting-done-hint-copy{min-width:0;flex:1;flex-direction:column}
.meeting-done-hint-title{font-size:15px;font-weight:700;line-height:1.3}
.meeting-done-hint-text{margin-top:4px;font-size:13px;line-height:1.55}
.meeting-done-hint-close{width:28px;height:28px;margin-left:7px;flex:0 0 28px;border-radius:50%;font-size:20px;line-height:1}
.daily-block{margin-bottom:21px}
.daily-card{padding:15px 16px 16px}
.daily-state{gap:6px;font-size:13px;font-weight:600;line-height:1.3}
.daily-state-dot{width:8px;height:8px;flex:0 0 8px;border-radius:50%}
.daily-idle-copy{margin-top:7px;font-size:13px;line-height:1.6}
.daily-stats{margin:13px 0 2px;gap:7px}
.daily-stat{min-width:0;flex:1;flex-direction:column;padding:9px 10px;border-radius:12px}
.daily-stat-value{font-size:20px;font-weight:700;line-height:1.2}
.daily-stat-unit{margin-left:2px;font-size:11px;font-weight:500}
.daily-stat-label{margin-top:3px;font-size:12px;line-height:1.3}
.daily-stat-sk{width:100%;height:38px;border-radius:9px}
.daily-course{margin-top:10px;padding-top:10px;border-top:0.5px solid #F0F3F1}
.daily-course-head{gap:7px}
.daily-course-title{min-width:0;flex:1;font-size:15px;font-weight:600;line-height:1.45}
.daily-course-progress{flex:none;margin-top:2px;font-size:12px;line-height:1.4}
.daily-course-line{margin-top:3px;font-size:13px;line-height:1.55}
.daily-only-time{margin-top:10px}
.daily-tags{margin-top:7px;flex-wrap:wrap;gap:6px}
.daily-tag{padding:2px 8px;border-radius:599px;font-size:12px;line-height:1.5}
.daily-note{margin-top:13px;padding:9px 12px 10px;border-radius:12px}
.daily-note-head{gap:7px}
.daily-note-label{font-size:12px;font-weight:650}
.daily-note-copy{flex:none;font-size:11px}
.daily-note-text{margin-top:4px;font-size:13px;line-height:1.7}
.daily-note-meta{margin-top:6px;font-size:11px;line-height:1.5}
.daily-recent{margin-top:7px;font-size:12px;line-height:1.5}
.daily-actions{margin-top:12px;gap:9px}
.daily-hint{min-width:0;flex:1;font-size:11px;line-height:1.45}
.daily-generate{flex:none;height:36px;padding:0 15px;border-radius:599px;font-size:14px;font-weight:650}
.goal-map-link-row{gap:9px}
.goal-map-chevron{flex:none;margin-top:7px;width:7px;height:7px;border-top:1px solid #FD7C02;border-right:1px solid #FD7C02}
}
