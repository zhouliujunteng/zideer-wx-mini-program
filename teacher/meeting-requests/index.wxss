@import "../../styles/skeleton.wxss";
/* 与老师工作台同一套：蓝色渐变头部、#FAFAFA 面板、白色大圆角卡片、主题橙渐变主按钮。 */
page { height: 100%; background: #FAFAFA; color: #24332D; }
.mr-root { position: relative; display: flex; width: 100%; height: 100vh; flex-direction: column; overflow: hidden; background: #FAFAFA; }
.mr-ambient { position: fixed; top: 0; left: 0; z-index: 0; width: 100%; height: 560rpx; pointer-events: none; background: linear-gradient(180deg, #1E87FD 0%, #4BA5FF 74%, rgba(250, 250, 250, 0) 100%); }
.mr-topbar { position: fixed; top: 0; left: 0; z-index: 20; width: 100%; box-sizing: border-box; background: transparent; }
.mr-topbar-inner { position: relative; display: flex; align-items: center; box-sizing: content-box; padding: 0 32rpx 16rpx; }
.mr-back { display: flex; flex: 0 0 auto; align-items: center; justify-content: center; width: 54rpx; height: 54rpx; border-radius: 50%; }
.mr-back:active { background: rgba(255, 255, 255, .16); }
.mr-back-icon { width: 22rpx; height: 22rpx; border-bottom: 4rpx solid #FFFFFF; border-left: 4rpx solid #FFFFFF; transform: rotate(45deg) scale(.7); }
.mr-topbar-title { position: absolute; left: 50%; display: block; color: #FFFFFF; font-size: 36rpx; font-weight: 700; letter-spacing: -1rpx; transform: translateX(-50%); white-space: nowrap; }

/* 头部说明：白字压在蓝色渐变上 */
.mr-hero { position: relative; z-index: 1; flex: 0 0 auto; padding: 0 40rpx 62rpx; }
.mr-hero-title { display: block; margin-top: 26rpx; color: #FFFFFF; font-size: 38rpx; font-weight: 600; line-height: 1.3; }
.mr-hero-copy { display: block; margin-top: 12rpx; color: rgba(255, 255, 255, .86); font-size: 23rpx; line-height: 1.55; }

/* 面板：圆角上沿压住蓝色头部，列表在面板内滚动 */
.mr-panel { position: relative; z-index: 2; display: flex; min-height: 0; margin-top: -24rpx; flex: 1; flex-direction: column; border-radius: 26rpx 26rpx 0 0; background: #FAFAFA; }
.mr-panel > .empty-card { margin: 36rpx 28rpx 0; }
.mr-list { height: 0; flex: 1; }
.mr-list-inner { padding: 36rpx 28rpx calc(48rpx + env(safe-area-inset-bottom)); }
.section-heading { display: flex; align-items: baseline; gap: 12rpx; margin: 0 4rpx 20rpx; color: #24332D; font-size: 28rpx; font-weight: 700; line-height: 1.25; }
.mine-heading { margin-top: 40rpx; }
.section-caption { color: #9AA59E; font-size: 20rpx; font-weight: 400; }
.card { box-sizing: border-box; border: 0; border-radius: 28rpx; background: #FFFFFF; box-shadow: none; }

.request-card { margin-bottom: 18rpx; padding: 28rpx 28rpx 30rpx; }
.request-head { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; }
.request-name { min-width: 0; overflow: hidden; color: #27332C; font-size: 30rpx; font-weight: 600; line-height: 1.35; text-overflow: ellipsis; white-space: nowrap; }
.request-time { flex: none; color: #D86A00; font-size: 21rpx; }
.request-badge { flex: none; padding: 6rpx 16rpx; border-radius: 999rpx; background: #FFF4EA; color: #B25A00; font-size: 20rpx; font-weight: 600; }
.request-badge.is-done { background: #E8F5EC; color: #2F7A4F; }
.request-meta { display: block; margin-top: 8rpx; color: #6F7A73; font-size: 23rpx; line-height: 1.5; }
.request-note { margin-top: 18rpx; padding: 20rpx 22rpx; border-radius: 20rpx; background: #F5F7F6; }
.request-note-label { display: block; color: #939C96; font-size: 20rpx; line-height: 1.4; }
.request-note-text { display: block; margin-top: 8rpx; color: #24332D; font-size: 25rpx; line-height: 1.6; word-break: break-all; }
.request-action { display: flex; height: 88rpx; margin-top: 24rpx; align-items: center; justify-content: center; border-radius: 999rpx; background: linear-gradient(90deg, #FF9F43 0%, #FD7C02 100%); color: #FFFFFF; font-size: 27rpx; font-weight: 600; }
.request-action:active { opacity: .82; }
.request-action.is-disabled { opacity: .42; }
.request-next { display: block; margin-top: 18rpx; color: #1E87FD; font-size: 22rpx; }
.request-sk { margin-top: 18rpx; }

/* 读取失败、没有申请 */
.empty-card { display: flex; padding: 56rpx 32rpx; flex-direction: column; align-items: center; text-align: center; }
.empty-title { color: #24332D; font-size: 27rpx; font-weight: 600; }
.empty-copy { margin-top: 12rpx; color: #89938C; font-size: 22rpx; line-height: 1.6; }
.empty-retry { margin-top: 24rpx; padding: 14rpx 36rpx; border-radius: 999rpx; background: #EAF3FF; color: #1E87FD; font-size: 23rpx; font-weight: 600; }
.empty-retry:active { opacity: .78; }

@import "./index.large.wxss"; /* 平板、电脑大屏样式：由 scripts/build-large-screen-styles.mjs 生成，改完本文件后重跑；这一行须留在文件末尾 */
