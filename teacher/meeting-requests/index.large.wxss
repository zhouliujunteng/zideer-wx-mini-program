/* 自动生成，请勿手改：index.wxss 在平板、电脑大屏（窗口宽 ≥ 450px）下的样式。
   rpx 按 1rpx = 0.6px 换算，固定定位元素收进居中栏；改完源文件后运行 node scripts/build-large-screen-styles.mjs */
@media (min-width: 450px) {
.sk{border-radius:7px}
.sk-line{height:16px}
.sk-line + .sk-line{margin-top:8px}
.sk-short{width:40%}
.sk-mid{width:64%}
.sk-round{border-radius:50%}
.sk-card{height:96px;border-radius:14px}
.sk-card + .sk-card{margin-top:12px}
page{height:100%}
.mr-root{width:100%;height:100vh}
.mr-ambient{top:0;left:max(0px, 50% - var(--lg-col) / 2);width:min(100%, var(--lg-col));height:336px}
.mr-topbar{top:0;left:max(0px, 50% - var(--lg-col) / 2);width:min(100%, var(--lg-col))}
.mr-topbar-inner{padding:0 19px 9px}
.mr-back{width:32px;height:32px;border-radius:50%}
.mr-back-icon{width:13px;height:13px;border-bottom:2px solid #FFFFFF;border-left:2px solid #FFFFFF}
.mr-topbar-title{left:50%;font-size:21px;font-weight:700;letter-spacing:-1px}
.mr-hero{padding:0 24px 37px}
.mr-hero-title{margin-top:15px;font-size:22px;font-weight:600;line-height:1.3}
.mr-hero-copy{margin-top:7px;font-size:13px;line-height:1.55}
.mr-panel{min-height:0;margin-top:-15px;border-radius:15px 15px 0 0}
.mr-panel > .empty-card{margin:21px 16px 0}
.mr-list{height:0}
.mr-list-inner{padding:21px 16px calc(28px + env(safe-area-inset-bottom))}
.section-heading{gap:7px;margin:0 2px 12px;font-size:16px;font-weight:700;line-height:1.25}
.mine-heading{margin-top:24px}
.section-caption{font-size:12px;font-weight:400}
.card{border:0;border-radius:16px}
.request-card{margin-bottom:10px;padding:16px 16px 18px}
.request-head{gap:9px}
.request-name{min-width:0;font-size:18px;font-weight:600;line-height:1.35}
.request-time{font-size:12px}
.request-badge{padding:3px 9px;border-radius:599px;font-size:12px;font-weight:600}
.request-meta{margin-top:4px;font-size:13px;line-height:1.5}
.request-note{margin-top:10px;padding:12px 13px;border-radius:12px}
.request-note-label{font-size:12px;line-height:1.4}
.request-note-text{margin-top:4px;font-size:15px;line-height:1.6}
.request-action{height:52px;margin-top:14px;border-radius:599px;font-size:16px;font-weight:600}
.request-next{margin-top:10px;font-size:13px}
.request-sk{margin-top:10px}
.empty-card{padding:33px 19px}
.empty-title{font-size:16px;font-weight:600}
.empty-copy{margin-top:7px;font-size:13px;line-height:1.6}
.empty-retry{margin-top:14px;padding:8px 21px;border-radius:599px;font-size:13px;font-weight:600}
}
