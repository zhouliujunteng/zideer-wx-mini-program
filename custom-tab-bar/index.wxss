/* 仿原生底栏：高 49px（不含底部安全区）、图标 25px、文字 10px；颜色取 app.json tabBar。
   用 px 而不是 rpx：原生底栏在手机和 iPad 上都是固定大小，大屏下也铺满整个窗口宽度，
   所以不生成 .large.wxss（scripts/build-large-screen-styles.mjs 跳过本组件）。 */
.tabbar {
  position: fixed;
  z-index: 900;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  height: 49px;
  padding-bottom: env(safe-area-inset-bottom);
  background: #FAFAFA;
}

.tabbar-item {
  display: flex;
  min-width: 0;
  flex: 1;
  flex-direction: column;
  align-items: center;
  padding-top: 7px;
  box-sizing: border-box;
}

.tabbar-icon {
  display: block;
  width: 25px;
  height: 25px;
}

.tabbar-label {
  margin-top: 3px;
  color: #7B8078;
  font-size: 10px;
  line-height: 12px;
  white-space: nowrap;
}

.tabbar-item.is-active .tabbar-label {
  color: #FD7C02;
}
