/* finesse · register=h5 · morph=A.1-native-study-app · A=snow+coral+ink
 * B=system-700/400 · C=single-focus+grouped-rows+native-tabbar · D=tap-feedback-only
 * E=quiet-study-desk · SOUL=4 SPECTACLE=1 DENSITY=4 */

.tabbar-wrap {
  position: fixed;
  z-index: 100;
  right: 0;
  bottom: 0;
  left: 0;
  padding-bottom: env(safe-area-inset-bottom);
  border-top: 1rpx solid rgba(23, 25, 28, 0.07);
  background: rgba(254, 254, 252, 0.98);
}

.tabbar {
  display: flex;
  height: 112rpx;
  align-items: center;
}

.tabbar__item {
  display: flex;
  min-width: 0;
  height: 112rpx;
  align-items: center;
  justify-content: center;
  flex: 1;
  flex-direction: column;
}

.tabbar__item:active {
  opacity: 0.55;
}

.tabbar__icon-shell {
  display: flex;
  width: 48rpx;
  height: 48rpx;
  align-items: center;
  justify-content: center;
}

.tabbar__icon {
  width: 38rpx;
  height: 38rpx;
}

.tabbar__label {
  overflow: hidden;
  max-width: 122rpx;
  margin-top: 4rpx;
  color: #9A9FA6;
  font-size: 19rpx;
  line-height: 1.2;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.tabbar__item--active .tabbar__label {
  color: #17191C;
  font-weight: 700;
}

@media (prefers-reduced-motion: reduce) {
  .tabbar__item {
    transition-duration: 0.01ms !important;
  }
}
